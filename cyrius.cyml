[package]
name = "nidhi"
version = "${file:VERSION}"
description = "nidhi — Sample playback engine (Cyrius port): key/velocity zones, loop modes, time-stretching, SFZ/SF2 import"
license = "GPL-3.0-only"
repository = "https://github.com/MacCracken/nidhi"
language = "cyrius"
cyrius = "6.7.18"

[build]
entry = "programs/smoke.cyr"
output = "build/nidhi-smoke"

# [lib].modules is dependency-ordered. The dist bundle (dist/nidhi.cyr, built by
# `cyrius distlib`) is a plain concatenation, so any module may reference symbols
# from a module listed above it. Ported so far: error, f64_util, loop_mode.
# Full target order tracked in docs/port/01-PLAN.md.
[lib]
modules = [
    "src/error.cyr",
    "src/f64_util.cyr",
    "src/loop_mode.cyr",
    "src/envelope.cyr",
    "src/zone.cyr",
    "src/sample.cyr",
    "src/instrument.cyr",
    "src/capture.cyr",
    "src/stretch.cyr",
    "src/effect_chain.cyr",
    "src/io.cyr",
    "src/sf2.cyr",
    "src/sfz.cyr",
    "src/engine.cyr",
]

[deps]
# No `bayan` here since 2.2.1: shravan 2.9.2+ declares its own [deps.bayan] (the JSON-only
# bundle), and nidhi calls none of it. Listing the stdlib leaf made cyrius link the full
# bayan in its place, 850 KB more in every binary.
stdlib = ["string", "fmt", "alloc", "vec", "str", "syscalls", "io", "args", "assert", "bench", "tagged", "result", "fnptr", "math", "ganita", "hashmap", "thread"]

# nidhi uses naad fully for DSP (ADSR, filters, LFOs, effects, voice mgmt,
# interpolation, onset/normalize). naad transitively references hisab + goonj, and
# shravan references sankoch — declared here so the flat bundle resolves.
# Every tag below is both the newest upstream tag and the matched set for cyrius 6.7.18:
# naad, hisab and shravan pin exactly that toolchain. goonj 2.3.1 and sakshi 2.5.10
# arrive transitively; sankoch 2.8.9 and sakshi 2.5.10 are the copies the 6.7.18
# snapshot bundles.
[deps.naad]
git = "https://github.com/MacCracken/naad.git"
tag = "2.3.3"
modules = ["dist/naad.cyr"]

[deps.hisab]
git = "https://github.com/MacCracken/hisab.git"
tag = "3.4.1"
modules = ["dist/hisab.cyr"]

# Keep sankoch ABOVE shravan. Both define a global `detect_format`, deps are prepended
# in this order, and since cyrius 6.6.20 every call binds the LAST definition, so this
# order gives a direct caller shravan's. Decoding no longer depends on it: shravan 2.9.2+
# detects through its own `shravan_detect_format`, and with the order reversed every
# WAV/AIFF fixture still decodes the same. Before 2.9.2, reversed, `decode_file` refused
# every audio file. shravan keeps `detect_format` as a wrapper until its 3.0.
[deps.sankoch]
git = "https://github.com/MacCracken/sankoch.git"
tag = "2.8.9"
modules = ["dist/sankoch.cyr"]

[deps.shravan]
git = "https://github.com/MacCracken/shravan.git"
tag = "2.9.3"
modules = ["dist/shravan.cyr"]
