[package]
name = "nidhi"
version = "${file:VERSION}"
description = "nidhi — Sample playback engine (Cyrius port): key/velocity zones, loop modes, time-stretching, SFZ/SF2 import"
license = "GPL-3.0-only"
repository = "https://github.com/MacCracken/nidhi"
language = "cyrius"
cyrius = "6.6.20"

[build]
entry = "programs/smoke.cyr"
output = "build/nidhi-smoke"

# [lib].modules is dependency-ordered. The dist bundle (dist/nidhi.cyr, built by
# `cyrius distlib`) is a plain concatenation, so any module may reference symbols
# from a module listed above it. Ported so far: error, f64_util, loop_mode.
# Full target order tracked in docs/port/01-PLAN.md.
[lib]
modules = [
    "src/error.cyr",
    "src/f64_util.cyr",
    "src/loop_mode.cyr",
    "src/envelope.cyr",
    "src/zone.cyr",
    "src/sample.cyr",
    "src/instrument.cyr",
    "src/capture.cyr",
    "src/stretch.cyr",
    "src/effect_chain.cyr",
    "src/io.cyr",
    "src/sf2.cyr",
    "src/sfz.cyr",
    "src/engine.cyr",
]

[deps]
stdlib = ["string", "fmt", "alloc", "vec", "str", "syscalls", "io", "args", "assert", "bench", "tagged", "result", "fnptr", "math", "ganita", "hashmap", "bayan", "thread"]

# nidhi uses naad fully for DSP (ADSR, filters, LFOs, effects, voice mgmt,
# interpolation, onset/normalize). naad transitively references hisab + goonj, and
# shravan references sankoch — declared here so the flat bundle resolves.
# Every tag below is the matched set for cyrius 6.6.20: each pins exactly that
# toolchain, and the next tag of each needs 6.7.x. goonj 2.0.6 and sakshi 2.5.7
# arrive transitively; sankoch 2.8.1 is the copy the 6.6.20 snapshot bundles.
[deps.naad]
git = "https://github.com/MacCracken/naad.git"
tag = "2.2.5"
modules = ["dist/naad.cyr"]

[deps.hisab]
git = "https://github.com/MacCracken/hisab.git"
tag = "3.3.7"
modules = ["dist/hisab.cyr"]

# ORDER MATTERS: sankoch must stay ABOVE shravan. Both define a global
# `detect_format`, deps are prepended in this order, and since cyrius 6.6.20 every
# call binds the LAST definition. With sankoch last, shravan's decode_file gets
# sankoch's detector and refuses every audio file. sankoch never calls its own copy.
[deps.sankoch]
git = "https://github.com/MacCracken/sankoch.git"
tag = "2.8.1"
modules = ["dist/sankoch.cyr"]

[deps.shravan]
git = "https://github.com/MacCracken/shravan.git"
tag = "2.8.2"
modules = ["dist/shravan.cyr"]
