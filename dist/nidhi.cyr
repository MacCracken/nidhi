# loop_mode.cyr -- LoopMode tags
# Requires: (nothing)
#
# Ports the Rust fieldless `LoopMode` enum. Tag order == Rust declaration order;
# the #[default] variant is OneShot(0), so the zero value is a valid default.
#
#   0 LOOP_ONESHOT   -- play once, stop (default)
#   1 LOOP_FORWARD   -- start->end, jump to loop_start, repeat
#   2 LOOP_PINGPONG  -- forward then backward within the loop region
#   3 LOOP_REVERSE   -- play backwards
#   4 LOOP_SUSTAIN   -- loop while held, play through to end on release

var LOOP_ONESHOT  = 0;
var LOOP_FORWARD  = 1;
var LOOP_PINGPONG = 2;
var LOOP_REVERSE  = 3;
var LOOP_SUSTAIN  = 4;

# n_loop_mode_default -- the #[default] variant (OneShot).
#must_use
fn n_loop_mode_default() {
    return LOOP_ONESHOT;
}

# n_loop_mode_valid -- 1 if `m` is a defined LoopMode tag (0..=4), else 0.
#must_use
fn n_loop_mode_valid(m) {
    if (m < 0) { return 0; }
    if (m > 4) { return 0; }
    return 1;
}

# --- envelope.cyr ---

# envelope.cyr -- ADSR config + naad-backed amplitude envelope
# Requires: math (f64_*), f64_util (N_F32_EPSILON), naad (envelope_adsr_*,
#           naad_is_err, validate_sample_rate, ENV_STATE_RELEASE)
#
# "Use naad fully": nidhi's Rust std AmpEnvelope simply wrapped naad::envelope::Adsr;
# the no_std linear ADSR was only a fallback for when naad was absent. In Cyrius naad
# is always present, so AmpEnvelope IS a naad Adsr and the entire fallback (tick_no_std,
# EnvState, level/pos fields) collapses. What survives is NAdsrConfig -- the sample-based,
# SFZ-mappable per-zone envelope config -- plus a builder that converts it to a naad Adsr.
# Envelope stages map to naad's ENV_STATE_IDLE/ATTACK/DECAY/SUSTAIN/RELEASE.

# --- NAdsrConfig: all durations in samples (mirrors Rust AdsrConfig) ---
# Fields: attack_samples (i64), decay_samples (i64), sustain_level (f64 bits, 0..1),
# release_samples (i64).
#derive(accessors)
struct NAdsrConfig {
    attack_samples;
    decay_samples;
    sustain_level;
    release_samples;
}

# Default: attack=0, decay=0, sustain=1.0, release=441 (~10ms @ 44.1k).
#must_use
fn n_adsr_config_default() {
    var c = alloc(sizeof(NAdsrConfig));
    if (c == 0) { return 0; }
    NAdsrConfig_set_attack_samples(c, 0);
    NAdsrConfig_set_decay_samples(c, 0);
    NAdsrConfig_set_sustain_level(c, F64_ONE);
    NAdsrConfig_set_release_samples(c, 441);
    return c;
}

#must_use
fn n_adsr_config_new(attack_samples, decay_samples, sustain_level, release_samples) {
    var c = alloc(sizeof(NAdsrConfig));
    # 0 when the allocation is refused (2.3.0); n_adsr_config_from_seconds passes it on.
    if (c == 0) { return 0; }
    NAdsrConfig_set_attack_samples(c, attack_samples);
    NAdsrConfig_set_decay_samples(c, decay_samples);
    NAdsrConfig_set_sustain_level(c, sustain_level);
    NAdsrConfig_set_release_samples(c, release_samples);
    return c;
}

# from_seconds: samples = (secs * sample_rate), truncated toward zero, with
# max(0) on attack/decay and max(1) on release. sustain clamped to [0,1].
# All args are f64 bit patterns.
#
# Each count is saturated to u32 range BEFORE f64_to, as Rust's `as u32` does. f64_to itself
# saturates to i64 range only since cyrius 6.6.8; before that anything out of range cast to
# i64::MIN and collapsed to 0, so an "infinite" attack/release became INSTANTANEOUS. The clamp
# keeps both toolchains on the requested envelope. Operand order matters for NaN safety:
# f64_min(f64_max(x, lo), hi) propagates the clamp, the reverse does not.
#must_use
fn n_adsr_config_from_seconds(attack, decay, sustain, release, sample_rate) {
    var cap = f64_from(4294967295);
    var a = f64_to(f64_min(f64_max(f64_mul(attack, sample_rate), 0), cap));
    var d = f64_to(f64_min(f64_max(f64_mul(decay, sample_rate), 0), cap));
    var s = f64_min(f64_max(sustain, 0), F64_ONE);
    var r = f64_to(f64_min(f64_max(f64_mul(release, sample_rate), F64_ONE), cap));
    return n_adsr_config_new(a, d, s, r);
}

# is_default_sfz: true when the config is the SFZ "no explicit envelope" default
# (attack==0, decay==0, sustain~=1.0, release <= ~1ms). sample_rate is f64 bits.
#must_use
fn n_adsr_config_is_default_sfz(config, sample_rate) {
    if (NAdsrConfig_attack_samples(config) != 0) { return 0; }
    if (NAdsrConfig_decay_samples(config) != 0) { return 0; }
    if (f64_lt(f64_abs(f64_sub(NAdsrConfig_sustain_level(config), F64_ONE)), N_F32_EPSILON) == 0) {
        return 0;
    }
    # Saturate before f64_to: a non-finite or absurd sample_rate must not reach the compare
    # below as whatever the cast happens to give for it, which is i64::MAX since cyrius 6.6.8
    # and was a negative threshold, inverting this predicate, before.
    var tcap = f64_from(4294967295);
    var thresh = f64_to(f64_min(f64_max(f64_mul(sample_rate, f64_div(F64_ONE, f64_from(1000))), 0), tcap));
    if (NAdsrConfig_release_samples(config) > thresh) { return 0; }
    return 1;
}

# --- AmpEnvelope: a naad Adsr built from an NAdsrConfig ---
# n_amp_envelope_new(config, sample_rate) -> naad Adsr pointer. Mirrors the Rust std
# path: to_seconds -> Adsr::with_sample_rate(a.max0, d.max0, s.clamp01, r.max0, sr.max1)
# with a hardcoded-valid fallback (0,0,1.0,0.01,44100) if validation fails.
# sample_rate is an f64 bit pattern (Hz).
#must_use
fn n_amp_envelope_new(config, sample_rate) {
    # No config (0, or a code from a refused n_adsr_config_new) is no envelope.
    if (config <= 0) { return 0; }
    # to_seconds divides by the RAW sample_rate (matches Rust); ONLY the 5th arg is clamped max(.,1).
    var a = f64_max(f64_div(f64_from(NAdsrConfig_attack_samples(config)), sample_rate), 0);
    var d = f64_max(f64_div(f64_from(NAdsrConfig_decay_samples(config)), sample_rate), 0);
    var s = f64_min(f64_max(NAdsrConfig_sustain_level(config), 0), F64_ONE);
    var rel = f64_max(f64_div(f64_from(NAdsrConfig_release_samples(config)), sample_rate), 0);
    # The raw divide above is parity-faithful for every FINITE result, and tests/envelope.tcyr
    # pins that (4/0.5 = 8s). It overflows to +inf only for a denormal sample_rate -- most
    # plausibly a raw i64 44100 passed where an f64 bit pattern was expected, which reads as
    # 2.18e-319. naad accepts an infinite release (it rejects only release < 0), and the voice
    # then NEVER reaches IDLE: a hung note burning render cycles for the life of the engine.
    # Route the non-finite case into the existing fallback rather than clamping the input, so
    # parity holds everywhere the oracle produced a real number.
    if (n_is_finite(a) == 0) { a = 0; }
    if (n_is_finite(d) == 0) { d = 0; }
    if (n_is_finite(rel) == 0) { rel = 0; }
    var env = envelope_adsr_with_sample_rate(a, d, s, rel, f64_max(sample_rate, F64_ONE));
    if (naad_is_err(env) == 1) {
        # fallback: 0.0 attack, 0.0 decay, 1.0 sustain, 0.01s release, 44100 Hz -- always valid
        env = envelope_adsr_with_sample_rate(0, 0, F64_ONE, f64_div(F64_ONE, f64_from(100)), f64_from(44100));
    }
    return env;
}

# n_amp_envelope_rearm(env, config, sample_rate) -> 1 if re-armed, 0 if env was not usable.
#
# Re-points an EXISTING naad Adsr at a different zone's parameters, with no allocation.
#
# naad ships no `envelope_adsr_set_params`, which is what made this look upstream-gated -- but
# `struct Adsr` is `#derive(accessors)` (lib/naad.cyr:3863), so every parameter is a settable
# field and naad's own constructor sets them through exactly these generated accessors. Reading
# only for a named `*_set_params` and inferring absence was the mistake.
#
# The run-time state is reset too, to exactly what envelope_adsr_with_sample_rate leaves: IDLE,
# current 0, release start 0, stage 0. `envelope_adsr_gate_on` alone resets only state and
# stage_samples, and 2.1.1 to 2.2.1 relied on the first tick to overwrite current_value. A note_off
# BEFORE that tick (note on and off in one MIDI block) found the previous note's level still in
# current_value, and `envelope_adsr_gate_off` released from it: a full-level tail where the
# oracle's freshly built envelope, at 0, released silence. Fixed in 2.2.2.
#
# The parameter guards mirror n_amp_envelope_new exactly -- setters skip naad's constructor
# validation, so nidhi must not hand them a value the constructor would have rejected. That
# includes its fallback: the oracle rebuilt this envelope per note, so a rate naad refuses landed
# on (0, 0, 1.0, 0.01, 44100). Written straight through instead, +Inf made attack_time * sr
# NaN on every tick, and that NaN went into the mix.
fn n_amp_envelope_rearm(env, config, sample_rate) {
    if (env <= 0) { return 0; }
    var a = f64_max(f64_div(f64_from(NAdsrConfig_attack_samples(config)), sample_rate), 0);
    var d = f64_max(f64_div(f64_from(NAdsrConfig_decay_samples(config)), sample_rate), 0);
    var s = f64_min(f64_max(NAdsrConfig_sustain_level(config), 0), F64_ONE);
    var rel = f64_max(f64_div(f64_from(NAdsrConfig_release_samples(config)), sample_rate), 0);
    if (n_is_finite(a) == 0) { a = 0; }
    if (n_is_finite(d) == 0) { d = 0; }
    if (n_is_finite(rel) == 0) { rel = 0; }
    var esr = f64_max(sample_rate, F64_ONE);
    if (naad_is_err(validate_sample_rate(esr)) == 1) {
        a = 0;
        d = 0;
        s = F64_ONE;
        rel = f64_div(F64_ONE, f64_from(100));
        esr = f64_from(44100);
    }
    Adsr_set_attack_time(env, a);
    Adsr_set_decay_time(env, d);
    Adsr_set_sustain_level(env, s);
    Adsr_set_release_time(env, rel);
    Adsr_set_sample_rate(env, esr);
    Adsr_set_state(env, ENV_STATE_IDLE);
    Adsr_set_current_value(env, 0);
    Adsr_set_release_start_value(env, 0);
    Adsr_set_stage_samples(env, 0);
    return 1;
}

# Lifecycle wrappers over naad (thin -- keep nidhi's envelope vocabulary).
#inline
fn n_amp_envelope_trigger(env) { return envelope_adsr_gate_on(env); }

#inline
fn n_amp_envelope_release(env) { return envelope_adsr_gate_off(env); }

#inline
fn n_amp_envelope_tick(env) { return envelope_adsr_next_value(env); }

#inline
#must_use
fn n_amp_envelope_is_active(env) { return envelope_adsr_is_active(env); }

#must_use
fn n_amp_envelope_is_releasing(env) {
    if (envelope_adsr_state(env) == ENV_STATE_RELEASE) { return 1; }
    return 0;
}

# --- zone.cyr ---

# zone.cyr -- Zone config: key/velocity mapping, tuning, filter, envelope, LFO, bus
# Requires: math (f64_*), loop_mode (LOOP_*), envelope (NAdsrConfig ptrs stored in adsr/fileg)
#
# Ports rust-old/src/zone.rs. Every f32 -> f64 bit pattern. Option<AdsrConfig> (adsr, fileg)
# -> nullable NAdsrConfig pointer (0 == None). The builder setters mutate in place and return
# the zone pointer so calls chain (z = n_zone_with_x(z, ...)). Clamps are load-bearing.

# --- VelocityCurve (fieldless enum -> tag constants) ---
var VEL_CURVE_LINEAR  = 0;
var VEL_CURVE_CONVEX  = 1;
var VEL_CURVE_CONCAVE = 2;
var VEL_CURVE_SWITCH  = 3;

# n_velocity_curve_apply(curve, vel) -> gain in 0..1 (f64 bits). vel is raw MIDI 0..127.
# Linear: v; Convex: sqrt(v); Concave: v*v; Switch: 1.0 if vel>64 else 0.0 (raw vel, not v).
#
# The lower clamp is load-bearing, not defensive. Rust took `vel: u8`, so a negative
# velocity was unrepresentable; the Cyrius port widened it to i64 and f64_sqrt of a
# negative returns NaN -- which becomes a NaN amplitude, and a NaN sample latches the
# SVF for the voice's whole life. The UPPER bound is deliberately NOT clamped: u8
# legitimately spans 0..255 (gain up to 2.008) and n_zone_with_vel_range imposes no
# ceiling either, so clamping high would diverge from the oracle.
#must_use
fn n_velocity_curve_apply(curve, vel) {
    var vc = vel;
    if (vc < 0) { vc = 0; }
    if (curve == VEL_CURVE_SWITCH) {
        if (vc > 64) { return F64_ONE; }
        return 0;
    }
    var v = f64_div(f64_from(vc), f64_from(127));
    if (curve == VEL_CURVE_CONVEX) { return f64_sqrt(v); }
    if (curve == VEL_CURVE_CONCAVE) { return f64_mul(v, v); }
    return v;
}

# --- FilterMode (fieldless enum -> tag constants) ---
var FILTER_LOWPASS  = 0;
var FILTER_HIGHPASS = 1;
var FILTER_BANDPASS = 2;
var FILTER_NOTCH    = 3;

# --- Zone (34 fields: the oracle's 32 in rust-old/src/zone.rs order, then 2.2.2's two) ---
# seq_length / seq_position are SFZ's round-robin sequence (docs/adr/0012-round-robin-plays.md).
# Both default to 1, which is "not sequenced", so every zone the oracle could build behaves as it did.
#derive(accessors)
struct NZone {
    sample_id;
    key_lo;
    key_hi;
    vel_lo;
    vel_hi;
    root_note;
    tune_cents;
    volume_db;
    pan;
    loop_mode;
    loop_start;
    loop_end;
    crossfade_length;
    sample_offset;
    sample_end;
    filter_cutoff;
    filter_resonance;
    filter_type;
    filter_vel_track;
    group;
    choke_group;
    vel_curve;
    adsr;
    fileg;
    fileg_depth;
    pitchlfo_rate;
    pitchlfo_depth;
    fillfo_rate;
    fillfo_depth;
    fil_keytrack;
    time_stretch;
    output_bus;
    seq_length;
    seq_position;
}

# n_zone_new(sample_id) -> Zone with all Rust defaults.
#must_use
fn n_zone_new(sample_id) {
    var z = alloc(sizeof(NZone));
    if (z == 0) { return 0; }
    NZone_set_sample_id(z, sample_id);
    NZone_set_key_lo(z, 0);
    NZone_set_key_hi(z, 127);
    NZone_set_vel_lo(z, 1);
    NZone_set_vel_hi(z, 127);
    NZone_set_root_note(z, 60);
    NZone_set_tune_cents(z, 0);
    NZone_set_volume_db(z, 0);
    NZone_set_pan(z, 0);
    NZone_set_loop_mode(z, LOOP_ONESHOT);
    NZone_set_loop_start(z, 0);
    NZone_set_loop_end(z, 0);
    NZone_set_crossfade_length(z, 0);
    NZone_set_sample_offset(z, 0);
    NZone_set_sample_end(z, 0);
    NZone_set_filter_cutoff(z, 0);
    NZone_set_filter_resonance(z, f64_div(f64_from(707), f64_from(1000)));
    NZone_set_filter_type(z, FILTER_LOWPASS);
    NZone_set_filter_vel_track(z, 0);
    NZone_set_group(z, 0);
    NZone_set_choke_group(z, 0);
    NZone_set_vel_curve(z, VEL_CURVE_LINEAR);
    NZone_set_adsr(z, 0);
    NZone_set_fileg(z, 0);
    NZone_set_fileg_depth(z, 0);
    NZone_set_pitchlfo_rate(z, 0);
    NZone_set_pitchlfo_depth(z, 0);
    NZone_set_fillfo_rate(z, 0);
    NZone_set_fillfo_depth(z, 0);
    NZone_set_fil_keytrack(z, 0);
    NZone_set_time_stretch(z, 0);
    NZone_set_output_bus(z, 0);
    NZone_set_seq_length(z, 1);
    NZone_set_seq_position(z, 1);
    return z;
}

# --- Builder setters (mutate in place, return z; clamps replicate Rust exactly) ---

fn n_zone_with_key_range(z, lo, hi) {
    if (z <= 0) { return z; }
    NZone_set_key_lo(z, lo);
    NZone_set_key_hi(z, hi);
    return z;
}

fn n_zone_with_vel_range(z, lo, hi) {
    if (z <= 0) { return z; }
    NZone_set_vel_lo(z, lo);
    NZone_set_vel_hi(z, hi);
    return z;
}

fn n_zone_with_root_note(z, note) {
    if (z <= 0) { return z; }
    NZone_set_root_note(z, note);
    return z;
}

# tune_cents = clamp(cents, -12800, 12800)
fn n_zone_with_tune(z, cents) {
    if (z <= 0) { return z; }
    NZone_set_tune_cents(z, f64_min(f64_max(cents, f64_from(0 - 12800)), f64_from(12800)));
    return z;
}

# volume_db: no clamp here, as in the oracle. The engine clamps where it applies the value.
fn n_zone_with_volume(z, db) {
    if (z <= 0) { return z; }
    NZone_set_volume_db(z, db);
    return z;
}

# n_volume_db_clamp(db) -> db clamped to [-144, 24], applied by note_on (ADR 0004).
# The oracle stored volume unclamped and never applied it. Since 2.1.0 note_on does, so an
# unclamped NaN or +Inf (SFZ `volume=nan`, `volume=inf`, or a 400-digit number) put a non-finite
# value in every output sample. -144 dB is SFZ's floor. +24 dB is well past SFZ's +6 dB ceiling,
# so no level a caller means is cut. NaN takes the low bound, as ADR 0002 decides: silence.
#must_use
fn n_volume_db_clamp(db) {
    return f64_min(f64_max(db, f64_from(0 - 144)), f64_from(24));
}

# pan = clamp(pan, -1.0, 1.0)
fn n_zone_with_pan(z, pan) {
    if (z <= 0) { return z; }
    NZone_set_pan(z, f64_min(f64_max(pan, f64_neg(F64_ONE)), F64_ONE));
    return z;
}

fn n_zone_with_loop(z, mode, start, end) {
    if (z <= 0) { return z; }
    NZone_set_loop_mode(z, mode);
    NZone_set_loop_start(z, start);
    NZone_set_loop_end(z, end);
    return z;
}

fn n_zone_with_crossfade(z, length) {
    if (z <= 0) { return z; }
    NZone_set_crossfade_length(z, length);
    return z;
}

fn n_zone_with_sample_offset(z, offset) {
    if (z <= 0) { return z; }
    NZone_set_sample_offset(z, offset);
    return z;
}

fn n_zone_with_sample_end(z, end) {
    if (z <= 0) { return z; }
    NZone_set_sample_end(z, end);
    return z;
}

# filter_cutoff = max(cutoff, 0); filter_vel_track = clamp(vel_track, 0, 1)
fn n_zone_with_filter(z, cutoff, vel_track) {
    if (z <= 0) { return z; }
    NZone_set_filter_cutoff(z, f64_max(cutoff, 0));
    NZone_set_filter_vel_track(z, f64_min(f64_max(vel_track, 0), F64_ONE));
    return z;
}

# filter_resonance = max(q, 0.1)
fn n_zone_with_filter_resonance(z, q) {
    if (z <= 0) { return z; }
    NZone_set_filter_resonance(z, f64_max(q, f64_div(F64_ONE, f64_from(10))));
    return z;
}

fn n_zone_with_filter_type(z, mode) {
    if (z <= 0) { return z; }
    NZone_set_filter_type(z, mode);
    return z;
}

fn n_zone_with_group(z, group) {
    if (z <= 0) { return z; }
    NZone_set_group(z, group);
    return z;
}

fn n_zone_with_choke_group(z, group) {
    if (z <= 0) { return z; }
    NZone_set_choke_group(z, group);
    return z;
}

fn n_zone_with_velocity_curve(z, curve) {
    if (z <= 0) { return z; }
    NZone_set_vel_curve(z, curve);
    return z;
}

# adsr = Some(config): store the NAdsrConfig pointer
# COPIES the config. Rust's with_adsr took AdsrConfig BY VALUE; the port stored the caller's
# pointer, so one config handed to several zones made them share mutable state -- and a later
# n_engine_set_release_ms or a direct NAdsrConfig_set_* rewrote every one of them at once.
# Same class as the set_release_ms aliasing fixed in 2.0.2.
#
# A negative config is an error code, not a config. Stored as-is it reached note_on's `== 0`
# default test, failed it, and n_amp_envelope_rearm read the code as a pointer: a segfault on the
# first note. Every `config <= 0` is stored as 0 (none), so the engine default applies.
#
# Returns 0 when the copy cannot be allocated (2.3.0): storing 0 would silently drop the zone's
# envelope, and a builder chain passes the 0 on, so the caller sees the failure.
fn n_zone_with_adsr(z, config) {
    if (z <= 0) { return z; }
    if (config <= 0) { NZone_set_adsr(z, 0); return z; }
    var copy = n_adsr_config_new(
      NAdsrConfig_attack_samples(config), NAdsrConfig_decay_samples(config),
      NAdsrConfig_sustain_level(config), NAdsrConfig_release_samples(config));
    if (copy == 0) { return 0; }
    NZone_set_adsr(z, copy);
    return z;
}

# fileg = Some(config); fileg_depth = clamp(depth_cents, -4800, 4800)
# COPIES the config, for the same reason as n_zone_with_adsr above.
fn n_zone_with_filter_envelope(z, config, depth_cents) {
    if (z <= 0) { return z; }
    if (config > 0) {
        # 0 when the copy cannot be allocated, as n_zone_with_adsr.
        var copy = n_adsr_config_new(
          NAdsrConfig_attack_samples(config), NAdsrConfig_decay_samples(config),
          NAdsrConfig_sustain_level(config), NAdsrConfig_release_samples(config));
        if (copy == 0) { return 0; }
        NZone_set_fileg(z, copy);
    } else {
        # 0, never a negative code: see n_zone_with_adsr.
        NZone_set_fileg(z, 0);
    }
    NZone_set_fileg_depth(z, f64_min(f64_max(depth_cents, f64_from(0 - 4800)), f64_from(4800)));
    return z;
}

# pitchlfo_rate = max(rate, 0); pitchlfo_depth: no clamp
fn n_zone_with_pitch_lfo(z, rate_hz, depth_cents) {
    if (z <= 0) { return z; }
    NZone_set_pitchlfo_rate(z, f64_max(rate_hz, 0));
    NZone_set_pitchlfo_depth(z, depth_cents);
    return z;
}

# fillfo_rate = max(rate, 0); fillfo_depth: no clamp
fn n_zone_with_filter_lfo(z, rate_hz, depth_cents) {
    if (z <= 0) { return z; }
    NZone_set_fillfo_rate(z, f64_max(rate_hz, 0));
    NZone_set_fillfo_depth(z, depth_cents);
    return z;
}

# fil_keytrack = clamp(amount, 0, 1)
fn n_zone_with_key_tracking(z, amount) {
    if (z <= 0) { return z; }
    NZone_set_fil_keytrack(z, f64_min(f64_max(amount, 0), F64_ONE));
    return z;
}

# time_stretch = clamp(ratio, 0, 4)
fn n_zone_with_time_stretch(z, ratio) {
    if (z <= 0) { return z; }
    NZone_set_time_stretch(z, f64_min(f64_max(ratio, 0), f64_from(4)));
    return z;
}

fn n_zone_with_output_bus(z, bus) {
    if (z <= 0) { return z; }
    NZone_set_output_bus(z, bus);
    return z;
}

# seq_length, seq_position = clamp to [1, u32::MAX]. SFZ's round-robin: the zone sounds on the
# note-ons where (its sequence counter % seq_length) == seq_position - 1. The counter advances on
# every note-on the zone matches, whether or not it sounds (n_instrument_find_zone_rr). A
# seq_position past seq_length never sounds, as in SFZ.
fn n_zone_with_seq(z, length, position) {
    if (z <= 0) { return z; }
    var l = length;
    if (l < 1) { l = 1; }
    if (l > 4294967295) { l = 4294967295; }
    var p = position;
    if (p < 1) { p = 1; }
    if (p > 4294967295) { p = 4294967295; }
    NZone_set_seq_length(z, l);
    NZone_set_seq_position(z, p);
    return z;
}

# --- Behavioral methods ---

# matches(note, vel) -> 1 if note/vel fall within this zone's inclusive ranges.
#must_use
fn n_zone_matches(z, note, vel) {
    if (note < NZone_key_lo(z)) { return 0; }
    if (note > NZone_key_hi(z)) { return 0; }
    if (vel < NZone_vel_lo(z)) { return 0; }
    if (vel > NZone_vel_hi(z)) { return 0; }
    return 1;
}

# playback_ratio(note) -> resampling ratio (f64 bits). 1.0 at root, x2 per octave.
#   semitones = (note - root_note) + tune_cents / 100
#   ratio     = 2^(semitones / 12)
#must_use
fn n_zone_playback_ratio(z, note) {
    var semitones = f64_add(
      f64_sub(f64_from(note), f64_from(NZone_root_note(z))),
      f64_div(NZone_tune_cents(z), f64_from(100)));
    return f64_pow(f64_from(2), f64_div(semitones, f64_from(12)));
}

# --- sample.cyr ---

# sample.cyr -- Sample data, interpolation, onset detection, SampleBank
# Requires: alloc, vec (vec_new/push/get/set/len/truncate), math (f64_*), f64_util
#
# Ports rust-old/src/sample.rs. Sample buffers are stdlib vecs of f64 bit patterns
# (interleaved for stereo), matching how naad/shravan carry audio. SampleId is a bare
# i64 bank index (the Rust newtype wrapper is dropped). The SIMD cubic-hermite path is
# not ported (it was a bit-exact optimization of the scalar path). detect_onsets is
# nidhi's own energy-based REX slicer -- naad's detect_onsets is a different
# (spectral-flux) algorithm, so this is ported directly for feature parity.

# --- Sample ---
# Fields: data (vec of f64 bits, interleaved), channels (1 or 2), sample_rate (Hz),
# frames (samples per channel), name (Str ptr or 0), slices (vec of frame indices).
#derive(accessors)
struct NSample {
    data;
    channels;
    sample_rate;
    frames;
    name;
    slices;
}

#must_use
fn n_sample_from_mono(data, sample_rate) {
    if (data <= 0) { return 0; }
    var s = alloc(sizeof(NSample));
    if (s == 0) { return 0; }
    var slices = vec_new();
    if (slices == 0) { return 0; }
    NSample_set_data(s, data);
    NSample_set_channels(s, 1);
    NSample_set_sample_rate(s, sample_rate);
    NSample_set_frames(s, vec_len(data));
    NSample_set_name(s, 0);
    NSample_set_slices(s, slices);
    return s;
}

#must_use
fn n_sample_from_stereo(data, sample_rate) {
    if (data <= 0) { return 0; }
    var s = alloc(sizeof(NSample));
    if (s == 0) { return 0; }
    var slices = vec_new();
    if (slices == 0) { return 0; }
    NSample_set_data(s, data);
    NSample_set_channels(s, 2);
    NSample_set_sample_rate(s, sample_rate);
    NSample_set_frames(s, vec_len(data) / 2);
    NSample_set_name(s, 0);
    NSample_set_slices(s, slices);
    return s;
}

fn n_sample_with_name(s, name) {
    if (s <= 0) { return s; }
    NSample_set_name(s, name);
    return s;
}

fn n_sample_with_slices(s, slices) {
    if (s <= 0) { return s; }
    NSample_set_slices(s, slices);
    return s;
}

# --- Private frame readers (zero-pad out-of-range for the interpolator edges) ---
#
# Every element read is bounded by the data vec's LIVE length as well as by NSample_frames.
# frames is a snapshot taken at construction, and the oracle could rely on it because Sample's
# data/frames/channels were pub(crate); #derive(accessors) exports NSample_set_data,
# NSample_set_frames and NSample_set_channels, so a consumer can leave them disagreeing (swap in
# a shorter take, set channels on a mono buffer). The fast paths below then read past the
# buffer SILENTLY -- measured, a 10-element vec read at 60 returned 12345.0 from the next heap
# allocation -- and these helpers' vec_get ended the process. Both now read 0, the same
# zero-pad every other out-of-range tap gets. A consistent sample takes the same branches it
# always did: idx < frames already implies every element below is in range.

# read_mono_frame(idx) -> f64. Stereo folds to mono via (L+R)*0.5.
#must_use
fn n_sample_read_mono_frame(s, idx) {
    if (idx < 0) { return 0; }
    if (idx >= NSample_frames(s)) { return 0; }
    var data = NSample_data(s);
    var len = vec_len(data);
    var ch = NSample_channels(s);
    if (ch == 1) {
        if (idx >= len) { return 0; }
        return vec_get(data, idx);
    }
    var lo = idx * ch;
    if (lo < 0) { return 0; }
    if (lo + 1 >= len) { return 0; }
    var l = vec_get(data, lo);
    var r = vec_get(data, lo + 1);
    return f64_mul(f64_add(l, r), F64_HALF);
}

# read_stereo left/right lanes (mono duplicated to both). Zero-pad OOB.
#must_use
fn n_sample_read_stereo_l(s, idx) {
    if (idx < 0) { return 0; }
    if (idx >= NSample_frames(s)) { return 0; }
    var data = NSample_data(s);
    var len = vec_len(data);
    var ch = NSample_channels(s);
    if (ch == 1) {
        if (idx >= len) { return 0; }
        return vec_get(data, idx);
    }
    var lo = idx * ch;
    if (lo < 0) { return 0; }
    if (lo >= len) { return 0; }
    return vec_get(data, lo);
}

#must_use
fn n_sample_read_stereo_r(s, idx) {
    if (idx < 0) { return 0; }
    if (idx >= NSample_frames(s)) { return 0; }
    var data = NSample_data(s);
    var len = vec_len(data);
    var ch = NSample_channels(s);
    if (ch == 1) {
        if (idx >= len) { return 0; }
        return vec_get(data, idx);
    }
    var lo = idx * ch;
    if (lo < 0) { return 0; }
    if (lo + 1 >= len) { return 0; }
    return vec_get(data, lo + 1);
}

# --- Cubic Hermite (Catmull-Rom) interpolation -- the engine's correctness anchor ---
# a = -0.5*y0 + 1.5*y1 - 1.5*y2 + 0.5*y3
# b =  y0     - 2.5*y1 + 2.0*y2 - 0.5*y3
# c = -0.5*y0            + 0.5*y2
# return ((a*t + b)*t + c)*t + y1     (Horner)
#must_use
# The five coefficients are compile-time constants written as literal f64 bit patterns.
# They used to be rebuilt on EVERY call -- two f64 divides and three negations per
# interpolated sample, on the hottest path in the engine. The values are identical:
#   -0.5 = 0xBFE0000000000000   1.5 = 0x3FF8000000000000   -1.5 = 0xBFF8000000000000
#   -2.5 = 0xC004000000000000
fn n_cubic_hermite(y0, y1, y2, y3, t) {
    var neg_half = 0xBFE0000000000000;
    var c15 = 0x3FF8000000000000;
    var neg15 = 0xBFF8000000000000;
    var neg25 = 0xC004000000000000;
    var a = f64_add(f64_add(f64_add(f64_mul(neg_half, y0), f64_mul(c15, y1)),
        f64_mul(neg15, y2)), f64_mul(F64_HALF, y3));
    var b = f64_add(f64_add(f64_add(y0, f64_mul(neg25, y1)),
        f64_mul(F64_TWO, y2)), f64_mul(neg_half, y3));
    var c = f64_add(f64_mul(neg_half, y0), f64_mul(F64_HALF, y2));
    return f64_add(f64_mul(f64_add(f64_mul(f64_add(f64_mul(a, t), b), t), c), t), y1);
}

# read_cubic(position) -> f64. floor(position) (not trunc) for negative-edge padding.
#must_use
fn n_sample_read_cubic(s, position) {
    var frames = NSample_frames(s);
    if (frames == 0) { return 0; }
    # See the note in n_sample_read_stereo_interpolated.
    if (n_pos_in_range(position) == 0) { return 0; }
    var idx = f64_to(f64_floor(position));
    var frac = f64_sub(position, f64_from(idx));

    # Interior fast path. The four taps span idx-1 .. idx+2, so `idx-1 >= 0 && idx+2 < frames`
    # proves every one of them in range of the FRAMES the sample claims. The third test proves
    # them in range of the data vec it actually holds: the highest element touched is
    # (idx+2)*ch + ch-1, i.e. `(idx+3)*ch <= len` (len read straight from the vec header,
    # lib/vec.cyr {data, len, cap}). For a consistent sample it always holds; see the frame
    # readers above for the desync it closes. Measured cost, in-process best of 7: 0.3 ns of
    # 35 per mono read, 0.1 ns of 59 per stereo read.
    # With all three established, the per-tap helpers' bounds tests, accessor calls and vec_get's
    # own bounds test are redundant, so read the vec's buffer directly. These tests must stay
    # EXACTLY as written: an off-by-one here is a silent out-of-bounds read, not a crash.
    #
    # The mono Hermite is written out in place, the same expression tree as n_cubic_hermite and
    # therefore bit-identical (tests/sample.tcyr compares them bit for bit). A 5-argument call
    # is never inlined by cyrius, and this is the interpolation_cubic hot path: measured
    # 36.4 -> 35.3 ns per read, length test included (in-process best of 7, 3 runs). The stereo
    # fold-down keeps the call; nothing renders through it (the engine uses
    # n_sample_read_stereo_interpolated).
    var ch = NSample_channels(s);
    var data = NSample_data(s);
    if (idx - 1 >= 0) {
        if (idx + 2 < frames) {
            if ((idx + 3) * ch <= load64(data + 8)) {
                var base = load64(data);
                if (ch == 1) {
                    var p = base + (idx - 1) * 8;
                    var y0 = load64(p);
                    var y1 = load64(p + 8);
                    var y2 = load64(p + 16);
                    var y3 = load64(p + 24);
                    var a = f64_add(f64_add(f64_add(f64_mul(0xBFE0000000000000, y0), f64_mul(0x3FF8000000000000, y1)),
                        f64_mul(0xBFF8000000000000, y2)), f64_mul(F64_HALF, y3));
                    var b = f64_add(f64_add(f64_add(y0, f64_mul(0xC004000000000000, y1)),
                        f64_mul(F64_TWO, y2)), f64_mul(0xBFE0000000000000, y3));
                    var c = f64_add(f64_mul(0xBFE0000000000000, y0), f64_mul(F64_HALF, y2));
                    var mono = f64_add(f64_mul(f64_add(f64_mul(f64_add(f64_mul(a, frac), b), frac), c), frac), y1);
                    return mono;
                }
                if (ch == 2) {
                    var q = base + (idx - 1) * 16;
                    var m0 = f64_mul(f64_add(load64(q), load64(q + 8)), F64_HALF);
                    var m1 = f64_mul(f64_add(load64(q + 16), load64(q + 24)), F64_HALF);
                    var m2 = f64_mul(f64_add(load64(q + 32), load64(q + 40)), F64_HALF);
                    var m3 = f64_mul(f64_add(load64(q + 48), load64(q + 56)), F64_HALF);
                    return n_cubic_hermite(m0, m1, m2, m3, frac);
                }
            }
        }
    }

    # Edge path: keeps the zero-padding semantics for out-of-range taps.
    var e0 = n_sample_read_mono_frame(s, idx - 1);
    var e1 = n_sample_read_mono_frame(s, idx);
    var e2 = n_sample_read_mono_frame(s, idx + 1);
    var e3 = n_sample_read_mono_frame(s, idx + 2);
    return n_cubic_hermite(e0, e1, e2, e3, frac);
}

#inline
#must_use
fn n_sample_read_interpolated(s, position) {
    return n_sample_read_cubic(s, position);
}

# read_stereo_interpolated(position, out) -> writes out[0]=L, out[1]=R (f64 bits).
fn n_sample_read_stereo_interpolated(s, position, out) {
    if (NSample_frames(s) == 0) {
        store64(out, 0);
        store64(out + 8, 0);
        return 0;
    }
    # The guards below are integer tests on idx-1 and idx+2, so idx must be small enough that
    # neither WRAPS. Past 2^63 f64_to saturates, and at either end one of the two wraps, both
    # guards read as in-range, and the fast path loads from just before the buffer. So refuse
    # the position in f64 first: finite and absurd is silence, same as non-finite.
    if (n_pos_in_range(position) == 0) {
        store64(out, 0);
        store64(out + 8, 0);
        return 0;
    }
    var idx = f64_to(f64_floor(position));
    var frac = f64_sub(position, f64_from(idx));

    # Interior fast path -- see the note in n_sample_read_cubic, including the live-length
    # test. Eight per-tap helper calls, each with two bounds tests and three accessor calls,
    # collapse to eight raw loads, and both Hermite evaluations are written out in place (same
    # expression tree as n_cubic_hermite, bit-identical). This is the engine's render path:
    # measured 62.3 -> 58.8 ns per stereo read, 38.5 -> 37.6 for a mono sample, length test
    # included (in-process best of 7, 3 runs).
    var frames2 = NSample_frames(s);
    var ch = NSample_channels(s);
    var sdata = NSample_data(s);
    if (idx - 1 >= 0) {
        if (idx + 2 < frames2) {
            if ((idx + 3) * ch <= load64(sdata + 8)) {
                var base = load64(sdata);
                if (ch == 1) {
                    var p = base + (idx - 1) * 8;
                    var y0 = load64(p);
                    var y1 = load64(p + 8);
                    var y2 = load64(p + 16);
                    var y3 = load64(p + 24);
                    var a = f64_add(f64_add(f64_add(f64_mul(0xBFE0000000000000, y0), f64_mul(0x3FF8000000000000, y1)),
                        f64_mul(0xBFF8000000000000, y2)), f64_mul(F64_HALF, y3));
                    var b = f64_add(f64_add(f64_add(y0, f64_mul(0xC004000000000000, y1)),
                        f64_mul(F64_TWO, y2)), f64_mul(0xBFE0000000000000, y3));
                    var c = f64_add(f64_mul(0xBFE0000000000000, y0), f64_mul(F64_HALF, y2));
                    var mv = f64_add(f64_mul(f64_add(f64_mul(f64_add(f64_mul(a, frac), b), frac), c), frac), y1);
                    store64(out, mv);
                    store64(out + 8, mv);
                    return 0;
                }
                if (ch == 2) {
                    var q = base + (idx - 1) * 16;
                    var l0 = load64(q);
                    var l1 = load64(q + 16);
                    var l2 = load64(q + 32);
                    var l3 = load64(q + 48);
                    var a = f64_add(f64_add(f64_add(f64_mul(0xBFE0000000000000, l0), f64_mul(0x3FF8000000000000, l1)),
                        f64_mul(0xBFF8000000000000, l2)), f64_mul(F64_HALF, l3));
                    var b = f64_add(f64_add(f64_add(l0, f64_mul(0xC004000000000000, l1)),
                        f64_mul(F64_TWO, l2)), f64_mul(0xBFE0000000000000, l3));
                    var c = f64_add(f64_mul(0xBFE0000000000000, l0), f64_mul(F64_HALF, l2));
                    var lv = f64_add(f64_mul(f64_add(f64_mul(f64_add(f64_mul(a, frac), b), frac), c), frac), l1);
                    store64(out, lv);
                    var r0 = load64(q + 8);
                    var r1 = load64(q + 24);
                    var r2 = load64(q + 40);
                    var r3 = load64(q + 56);
                    a = f64_add(f64_add(f64_add(f64_mul(0xBFE0000000000000, r0), f64_mul(0x3FF8000000000000, r1)),
                        f64_mul(0xBFF8000000000000, r2)), f64_mul(F64_HALF, r3));
                    b = f64_add(f64_add(f64_add(r0, f64_mul(0xC004000000000000, r1)),
                        f64_mul(F64_TWO, r2)), f64_mul(0xBFE0000000000000, r3));
                    c = f64_add(f64_mul(0xBFE0000000000000, r0), f64_mul(F64_HALF, r2));
                    store64(out + 8, f64_add(f64_mul(f64_add(f64_mul(f64_add(f64_mul(a, frac), b), frac), c), frac), r1));
                    return 0;
                }
            }
        }
    }

    var left = n_cubic_hermite(
      n_sample_read_stereo_l(s, idx - 1), n_sample_read_stereo_l(s, idx),
      n_sample_read_stereo_l(s, idx + 1), n_sample_read_stereo_l(s, idx + 2), frac);
    var right = n_cubic_hermite(
      n_sample_read_stereo_r(s, idx - 1), n_sample_read_stereo_r(s, idx),
      n_sample_read_stereo_r(s, idx + 1), n_sample_read_stereo_r(s, idx + 2), frac);
    store64(out, left);
    store64(out + 8, right);
    return 0;
}

# --- detect_onsets: energy-based transient detection, rebuilds s.slices ---
# window = max(min(512, frames/2), 1); hop = max(window/2, 1) (guards vs infinite loop).
# Per-window MEAN energy (sum of squares / window), stereo mixed to mono via (L+R)*0.5.
# Onset when normalized positive energy jump (diff/max_energy) strictly exceeds the
# clamped [0.01,1.0] threshold AND >= min_slice_frames since the last slice.
fn n_sample_detect_onsets(s, threshold, min_slice_frames) {
    var slices = NSample_slices(s);
    vec_truncate(slices, 0);
    var frames = NSample_frames(s);
    if (frames < 2) { return 0; }
    var data = NSample_data(s);
    var ch = NSample_channels(s);

    var window = 512;
    var half_frames = frames / 2;
    if (half_frames < window) { window = half_frames; }
    if (window < 1) { window = 1; }
    var hop = window / 2;
    if (hop < 1) { hop = 1; }
    var thr = f64_min(f64_max(threshold, f64_div(F64_ONE, f64_from(100))), F64_ONE);

    var e_frames = vec_new();
    var e_vals = vec_new();
    var pos = 0;
    while (pos + window <= frames) {
        var energy = 0;
        var i = pos;
        var lim = pos + window;
        while (i < lim) {
            var sm = 0;
            if (ch == 1) {
                sm = vec_get(data, i);
            } else {
                sm = f64_mul(f64_add(vec_get(data, i * 2), vec_get(data, i * 2 + 1)), F64_HALF);
            }
            energy = f64_add(energy, f64_mul(sm, sm));
            i = i + 1;
        }
        vec_push(e_frames, pos);
        vec_push(e_vals, f64_div(energy, f64_from(window)));
        pos = pos + hop;
    }

    var n = vec_len(e_vals);
    if (n < 2) { return 0; }

    var max_e = 0;
    var k = 0;
    while (k < n) {
        var e = vec_get(e_vals, k);
        if (f64_gt(e, max_e) == 1) { max_e = e; }
        k = k + 1;
    }
    var eps = f64_div(F64_ONE, f64_from(10000000000));
    if (f64_lt(max_e, eps) == 1) { return 0; }

    var last_slice = 0;
    var idx = 1;
    while (idx < n) {
        var frame = vec_get(e_frames, idx);
        var energy2 = vec_get(e_vals, idx);
        var prev_energy = vec_get(e_vals, idx - 1);
        var diff = f64_div(f64_sub(energy2, prev_energy), max_e);
        if (f64_gt(diff, thr) == 1) {
            if (frame - last_slice >= min_slice_frames) {
                vec_push(slices, frame);
                last_slice = frame;
            }
        }
        idx = idx + 1;
    }
    return 0;
}

# --- SampleBank ---
#derive(accessors)
struct NSampleBank {
    samples;
}

#must_use
fn n_sample_bank_new() {
    var b = alloc(sizeof(NSampleBank));
    if (b == 0) { return 0; }
    var samples = vec_new();
    if (samples == 0) { return 0; }
    NSampleBank_set_samples(b, samples);
    return b;
}

# add(sample) -> id (= length BEFORE push), or NIDHI_ERR_INVALID_PARAMETER if `sample`
# is not a valid pointer. sample is a NSample pointer.
#
# The guard is the bank's trust boundary. n_load_wav returns NIDHI_ERR_IMPORT (-5) on
# failure, and a caller that forwards that straight in used to have it STORED as a
# sample: n_sample_bank_get would hand -5 back, engine.cyr's `== 0` guard would not
# fire, and NSample_frames(-5) is a wild load in the audio callback. Reject negatives
# and 0 here rather than trusting every call site to check first.
#must_use
fn n_sample_bank_add(bank, sample) {
    if (bank <= 0) { return NIDHI_ERR_INVALID_PARAMETER; }
    if (sample <= 0) { return NIDHI_ERR_INVALID_PARAMETER; }
    var samples = NSampleBank_samples(bank);
    var id = vec_len(samples);
    # vec_push_a reports a refused grow; vec_push would exit the host.
    if (vec_push_a(default_alloc(), samples, sample) < 0) { return NIDHI_ERR_PLAYBACK; }
    return id;
}

# get(id) -> NSample pointer, or 0 if out of range.
#must_use
fn n_sample_bank_get(bank, id) {
    var samples = NSampleBank_samples(bank);
    if (id < 0) { return 0; }
    if (id >= vec_len(samples)) { return 0; }
    return vec_get(samples, id);
}

#must_use
fn n_sample_bank_len(bank) {
    return vec_len(NSampleBank_samples(bank));
}

#must_use
fn n_sample_bank_is_empty(bank) {
    if (vec_len(NSampleBank_samples(bank)) == 0) { return 1; }
    return 0;
}

# --- instrument.cyr ---

# instrument.cyr -- Instrument: zone collection + round-robin voice selection
# Requires: alloc, vec, zone (n_zone_matches, NZone_group, NZone_sample_id)
#
# Ports rust-old/src/instrument.rs. zones and rr_counters are stdlib vecs. rr_counters is
# indexed BY GROUP NUMBER (length >= max_group+1); group 0 is ungrouped and uses no counter.
# The RR counter is a post-incremented u32 with 2^32 wrap. find_zone_rr returns a 0-based
# zone index, or -1 for None (Rust's Option<(usize,&Zone)>).

#derive(accessors)
struct NInstrument {
    name;
    zones;
    rr_counters;
    seq_counters;
}

#must_use
fn n_instrument_new(name) {
    var inst = alloc(sizeof(NInstrument));
    if (inst == 0) { return 0; }
    var zones = vec_new();
    var rr = vec_new();
    # One SFZ sequence counter per zone, parallel to `zones` (docs/adr/0012-round-robin-plays.md).
    var seq = vec_new();
    if (zones == 0) { return 0; }
    if (rr == 0) { return 0; }
    if (seq == 0) { return 0; }
    NInstrument_set_name(inst, name);
    NInstrument_set_zones(inst, zones);
    NInstrument_set_rr_counters(inst, rr);
    NInstrument_set_seq_counters(inst, seq);
    return inst;
}

# Round-robin groups are used as a DIRECT INDEX into rr_counters, so the group number
# doubles as an allocation size. Rust's Vec<u32> is 4 bytes per slot with no ceiling;
# Cyrius pushes 8-byte slots into a vec that dies at VEC_CAP_MAX (2^28). An SFZ region
# carrying `group=300000000` -- a perfectly valid u32 that rust-old accepts -- asks for
# ~4 GB and ends in `vec: capacity overflow` + exit(1) from a 47-byte file. Cap the
# group space instead; anything above it is treated as ungrouped.
var N_MAX_ZONE_GROUP = 4096;

# Sentinel returned by n_instrument_find_zone_rr when no zone matches.
var N_ZONE_NO_MATCH = (0 - 1);

# Grow rr_counters to at least `needed` length, zero-filled (Rust Vec::resize(n, 0)).
# NIDHI_ERR_PLAYBACK when the vec cannot grow (2.3.0; vec_push would have exited the host).
fn n_instrument_ensure_counters(inst, needed) {
    if (needed > N_MAX_ZONE_GROUP + 1) { return NIDHI_ERR_INVALID_PARAMETER; }
    var rr = NInstrument_rr_counters(inst);
    while (vec_len(rr) < needed) {
        if (vec_push_a(default_alloc(), rr, 0) < 0) { return NIDHI_ERR_PLAYBACK; }
    }
    return 0;
}

# A negative group is normalised to 0 (ungrouped). Rust's group is a u32, so the value is
# unrepresentable there; here n_zone_with_group takes any i64, `group > 0` skipped the sizing, and
# find_zone_rr then indexed rr_counters at -1 -- `vec: index < 0`, exit(1) of the host.
#
# -> 0, or NIDHI_ERR_INVALID_PARAMETER for a 0 / error-code instrument or zone, or
# NIDHI_ERR_PLAYBACK when a vec cannot grow (vec_push would have exited the host). The counter slot
# is pushed first, so a zone is never in `zones` without its sequence counter.
fn n_instrument_add_zone(inst, zone) {
    if (inst <= 0) { return NIDHI_ERR_INVALID_PARAMETER; }
    if (zone <= 0) { return NIDHI_ERR_INVALID_PARAMETER; }
    # The group's counter slot is sized first, so a refused grow leaves the instrument unchanged.
    var group = NZone_group(zone);
    if (group < 0) { NZone_set_group(zone, 0); }
    if (group > 0) {
        if (group > N_MAX_ZONE_GROUP) {
            NZone_set_group(zone, 0);
        } else {
            if (n_instrument_ensure_counters(inst, group + 1) < 0) { return NIDHI_ERR_PLAYBACK; }
        }
    }
    var zones = NInstrument_zones(inst);
    var seqc = NInstrument_seq_counters(inst);
    if (vec_push_a(default_alloc(), seqc, 0) < 0) { return NIDHI_ERR_PLAYBACK; }
    if (vec_push_a(default_alloc(), zones, zone) < 0) {
        vec_truncate(seqc, vec_len(seqc) - 1);
        return NIDHI_ERR_PLAYBACK;
    }
    return 0;
}

# find_zones(note, vel) -> vec of matching NZone pointers (in zone order).
#must_use
fn n_instrument_find_zones(inst, note, vel) {
    var zones = NInstrument_zones(inst);
    var out = vec_new();
    var n = vec_len(zones);
    var i = 0;
    while (i < n) {
        var z = vec_get(zones, i);
        if (n_zone_matches(z, note, vel) == 1) { vec_push(out, z); }
        i = i + 1;
    }
    return out;
}

# find_first_zone(note, vel) -> index of the FIRST matching zone, or -1 if none.
#
# The non-allocating counterpart to n_instrument_find_zones, for the note_on hot path.
# note_on used to call find_zones -- which allocates a vec holding EVERY match -- take
# element 0, then scan the zone list a second time comparing pointers to recover its index.
# Two O(Z) passes and ~1 KB of never-reclaimed heap per note-on, to answer a question one
# pass and no allocation can. find_zones stays as-is: it is public API and tests use it.
#
# NOT interchangeable with find_zone_rr: that one advances the round-robin counter and picks
# a group member, which would silently change zone selection for every grouped instrument.
#must_use
fn n_instrument_find_first_zone(inst, note, vel) {
    var zones = NInstrument_zones(inst);
    var n = vec_len(zones);
    var i = 0;
    while (i < n) {
        if (n_zone_matches(vec_get(zones, i), note, vel) == 1) { return i; }
        i = i + 1;
    }
    return N_ZONE_NO_MATCH;
}

# n_instrument_seq_ok(inst, i, z) -> 1 if zone `z` (index `i`) is on its SFZ sequence step, else 0.
# An unsequenced zone (seq_length 1) is always on step unless its seq_position is past 1, which
# SFZ never plays. A zone pushed straight into NInstrument_zones has no counter slot and reads 0.
#must_use
fn n_instrument_seq_ok(inst, i, z) {
    var len = NZone_seq_length(z);
    var pos = NZone_seq_position(z);
    if (len <= 1) {
        if (pos <= 1) { return 1; }
        return 0;
    }
    var sc = NInstrument_seq_counters(inst);
    var c = 0;
    if (i < vec_len(sc)) { c = vec_get(sc, i); }
    if (c % len == pos - 1) { return 1; }
    return 0;
}

# Advance the sequence counter of every sequenced zone matching (note, vel). SFZ advances a
# region's counter on every note-on it matches, whether or not it sounds, which is what keeps a
# set of N regions in lockstep. u32 wrap, as the group counters.
fn n_instrument_seq_advance(inst, note, vel) {
    var zones = NInstrument_zones(inst);
    var sc = NInstrument_seq_counters(inst);
    var n = vec_len(zones);
    if (vec_len(sc) < n) { n = vec_len(sc); }
    var i = 0;
    while (i < n) {
        var z = vec_get(zones, i);
        if (NZone_seq_length(z) > 1) {
            if (n_zone_matches(z, note, vel) == 1) { vec_set(sc, i, (vec_get(sc, i) + 1) & 0xFFFFFFFF); }
        }
        i = i + 1;
    }
    return 0;
}

# find_zone_rr(note, vel) -> 0-based zone index, or -1 if no zone matches.
# The RR group is the group of the FIRST matching zone; only same-group matches
# participate. Ungrouped (group 0) always returns the first match.
#
# Since 2.2.2 the candidates are first filtered by SFZ's sequence (seq_length / seq_position;
# docs/adr/0012-round-robin-plays.md): a zone off its step is not a match for this note-on. Every
# zone the oracle could build is unsequenced, so for those this is the oracle's function exactly.
# Afterwards every matching sequenced zone advances its counter, sounding or not.
#
# Two passes over the zones and no allocation. The oracle collected `matching` and then
# `group_matches` into Vecs, and the literal port did the same with two vec_new() per call --
# 304 never-reclaimed bytes per grouped call, 152 per ungrouped one, on a path driven by note-ons.
# Pass 1 finds the first match, its group, and how many matches share that group; pass 2 walks to
# the pick-th of them. Same counter arithmetic, so the same zone is picked on every call.
#
# A group outside 0..=N_MAX_ZONE_GROUP plays as ungrouped. add_zone caps it on the way in, but a
# zone is a shared pointer and can be re-grouped AFTER it was added (Rust's Instrument owns its
# zones, so it cannot), and then `vec_get(rr, group)` ran past the counters it had refused to
# grow -- `vec: index out of bounds`, exit(1).
#must_use
fn n_instrument_find_zone_rr(inst, note, vel) {
    var pick_idx = n_instrument_pick_zone(inst, note, vel);
    n_instrument_seq_advance(inst, note, vel);
    return pick_idx;
}

# The selection itself, before any sequence counter moves.
#must_use
fn n_instrument_pick_zone(inst, note, vel) {
    var zones = NInstrument_zones(inst);
    var n = vec_len(zones);
    var first_match = N_ZONE_NO_MATCH;
    var group = 0;
    var count = 0;
    var i = 0;
    while (i < n) {
        var z = vec_get(zones, i);
        if (n_zone_matches(z, note, vel) == 1) {
            if (n_instrument_seq_ok(inst, i, z) == 1) {
                if (first_match < 0) {
                    first_match = i;
                    group = NZone_group(z);
                    if (group == 0) { return first_match; }
                }
                if (NZone_group(z) == group) { count = count + 1; }
            }
        }
        i = i + 1;
    }
    if (first_match < 0) { return N_ZONE_NO_MATCH; }
    if (group < 0) { return first_match; }
    if (group > N_MAX_ZONE_GROUP) { return first_match; }

    # A zone re-grouped after add_zone can need a counter slot here; if it cannot be grown, the
    # zone plays as its first match rather than vec_get past the end.
    if (n_instrument_ensure_counters(inst, group + 1) < 0) { return first_match; }
    var rr = NInstrument_rr_counters(inst);
    var counter = vec_get(rr, group);
    # count >= 1: first_match itself is in the group.
    var pick = counter % count;
    vec_set(rr, group, (counter + 1) & 0xFFFFFFFF);
    var j = first_match;
    while (j < n) {
        var zj = vec_get(zones, j);
        if (n_zone_matches(zj, note, vel) == 1) {
            if (n_instrument_seq_ok(inst, j, zj) == 1) {
                if (NZone_group(zj) == group) {
                    if (pick == 0) { return j; }
                    pick = pick - 1;
                }
            }
        }
        j = j + 1;
    }
    return first_match;
}

#must_use
fn n_instrument_zone_count(inst) {
    return vec_len(NInstrument_zones(inst));
}

# --- capture.cyr ---

# capture.cyr -- sample recording, silence trim, normalization, loop detection
# Requires: alloc, vec, math, sample (NSample_*), naad (naad_normalize, naad_rms)
#
# Ports rust-old/src/capture.rs. "Use naad fully": normalize_peak -> guarded peak scale (1e-10 floor)
# (scale peak to 1.0 in place), normalize_rms -> naad_rms(buffer) + scale. trim_silence and
# detect_loop_points are nidhi-specific and ported directly.

# --- SampleRecorder ---
#derive(accessors)
struct NSampleRecorder {
    buffer;
    sample_rate;
    channels;
}

#must_use
fn n_recorder_new(sample_rate, channels) {
    var ch = channels;
    if (ch < 1) { ch = 1; }
    if (ch > 2) { ch = 2; }
    var r = alloc(sizeof(NSampleRecorder));
    if (r == 0) { return 0; }
    var buf = vec_new();
    if (buf == 0) { return 0; }
    NSampleRecorder_set_buffer(r, buf);
    NSampleRecorder_set_sample_rate(r, sample_rate);
    NSampleRecorder_set_channels(r, ch);
    return r;
}

# N_RECORDER_MAX_SAMPLES -- the most interleaved samples one take can hold: 2^28, VEC_CAP_MAX,
# which is also exactly ALLOC_MAX (2 GiB) of f64. That is 101.4 min mono / 50.7 min stereo at
# 44.1 kHz, 46.6 min stereo at 48 kHz, 23.3 min stereo at 96 kHz. On the bump allocator the
# buffer's abandoned grows add about as much again, so a full take costs ~4 GiB of heap.
var N_RECORDER_MAX_SAMPLES = 0x10000000;

# write(data) -> 0, or a negative code with NOTHING appended (a write is all or nothing):
#   NIDHI_ERR_INVALID_PARAMETER -- the take would pass N_RECORDER_MAX_SAMPLES, or `r` / `data`
#                                  is 0 or an error code.
#   NIDHI_ERR_PLAYBACK          -- the allocator refused to grow the buffer.
# Either way the samples already recorded are intact, and n_recorder_finish still works.
#
# This used to vec_push each sample, and vec_push ENDS THE PROCESS when it cannot grow: at
# VEC_CAP_MAX ("vec: capacity overflow"), or earlier when the heap runs out ("vec: alloc
# failed"). The oracle's Vec just kept growing, so a long take in the host (dhvani, shruti)
# killed it and lost the take. Measured under a 4 GB limit: stereo 48 kHz died at ~23 min.
# The buffer now grows here, once per write, by the same doubling vec_push used (so memory
# use is unchanged), and a refusal is a return code. Relies on the {data, len, cap} header
# lib/vec.cyr documents, as naad_vec_zeros does; tests/capture.tcyr pins it.
# #must_use since 2.3.0: an ignored refusal silently drops that block of audio from the take.
#must_use
fn n_recorder_write(r, data) {
    if (r <= 0) { return NIDHI_ERR_INVALID_PARAMETER; }
    if (data <= 0) { return NIDHI_ERR_INVALID_PARAMETER; }
    var buffer = NSampleRecorder_buffer(r);
    var n = vec_len(data);
    var len = vec_len(buffer);
    if (n > N_RECORDER_MAX_SAMPLES - len) { return NIDHI_ERR_INVALID_PARAMETER; }
    var need = len + n;
    var cap = vec_cap(buffer);
    if (need > cap) {
        var new_cap = cap;
        if (new_cap < 16) { new_cap = 16; }
        while (new_cap < need) { new_cap = new_cap * 2; }
        if (new_cap > N_RECORDER_MAX_SAMPLES) { new_cap = N_RECORDER_MAX_SAMPLES; }
        var grown = alloc(new_cap * 8);
        if (grown == 0) { return NIDHI_ERR_PLAYBACK; }
        var old = load64(buffer);
        var k = 0;
        while (k < len) {
            store64(grown + k * 8, load64(old + k * 8));
            k = k + 1;
        }
        store64(buffer, grown);
        store64(buffer + 16, new_cap);
    }
    # Read the source pointer only now: when `data` IS the buffer, the grow just moved it.
    var dst = load64(buffer) + len * 8;
    var src = load64(data);
    var i = 0;
    while (i < n) {
        store64(dst + i * 8, load64(src + i * 8));
        i = i + 1;
    }
    store64(buffer + 8, need);
    return 0;
}

#must_use
# n_recorder_new clamps channels to 1..2, but #derive(accessors) also generates a public
# NSampleRecorder_set_channels that bypasses it -- Rust kept the field private, so 0 was
# unrepresentable. A 0 here is an integer divide-by-zero, so treat it as mono.
fn n_recorder_frames(r) {
    var ch = NSampleRecorder_channels(r);
    if (ch < 1) { ch = 1; }
    return vec_len(NSampleRecorder_buffer(r)) / ch;
}

fn n_recorder_clear(r) {
    vec_truncate(NSampleRecorder_buffer(r), 0);
    return 0;
}

# finish() -> NSample owning the recorded buffer. CONSUMES the recording: the recorder
# is left with a fresh empty buffer, mirroring Rust's `fn finish(self)`.
#
# The hand-off is not cosmetic. Rust MOVED the buffer out; the port aliased it, so the
# returned Sample and the still-live recorder shared one vec while NSample_frames stayed
# a snapshot. finish() then clear() left the Sample claiming N frames over an empty vec
# -- `vec: index out of bounds`, exit(1), on the next read. The non-crashing shape is
# worse: clear() then a LONGER write() left the old Sample silently playing the NEW
# take's audio. It also stopped n_normalize_peak / n_trim_silence from rewriting the
# recorder's live buffer behind its back.
#
# -> the Sample, or 0 when an allocation is refused. In that case the recorder keeps the take:
# the fresh buffer and the Sample are both built BEFORE the hand-off, so a refusal loses nothing.
#must_use
fn n_recorder_finish(r) {
    var fresh = vec_new();
    if (fresh == 0) { return 0; }
    var buffer = NSampleRecorder_buffer(r);
    var sr = NSampleRecorder_sample_rate(r);
    var s = 0;
    if (NSampleRecorder_channels(r) == 2) { s = n_sample_from_stereo(buffer, sr); }
    else { s = n_sample_from_mono(buffer, sr); }
    if (s == 0) { return 0; }
    NSampleRecorder_set_buffer(r, fresh);
    return s;
}

#must_use
fn n_recorder_finish_processed(r, silence_threshold) {
    var sample = n_recorder_finish(r);
    if (sample == 0) { return 0; }
    n_trim_silence(sample, silence_threshold);
    n_normalize_peak(sample);
    return sample;
}

# --- trim_silence: remove leading + trailing silence (strict > threshold) ---
fn n_trim_silence(sample, threshold) {
    if (sample <= 0) { return 0; }
    var thr = f64_max(threshold, 0);
    var ch = NSample_channels(sample);
    var frames = NSample_frames(sample);
    if (frames == 0) { return 0; }
    var data = NSample_data(sample);

    # Both scans exit on the first hit. The flag-guarded form these replace kept walking
    # the whole buffer after finding its frame -- a port regression, since the oracle uses
    # .find() / .rev().find(), which short-circuit. Same result, O(silence) not O(buffer).
    var start = frames;
    var f = 0;
    while (f < frames) {
        var c = 0;
        var nonsilent = 0;
        while (c < ch) {
            if (f64_gt(f64_abs(vec_get(data, f * ch + c)), thr) == 1) { nonsilent = 1; }
            c = c + 1;
        }
        if (nonsilent == 1) {
            start = f;
            break;
        }
        f = f + 1;
    }

    var end = 0;
    var g = frames;
    while (g > 0) {
        g = g - 1;
        var c2 = 0;
        var ns2 = 0;
        while (c2 < ch) {
            if (f64_gt(f64_abs(vec_get(data, g * ch + c2)), thr) == 1) { ns2 = 1; }
            c2 = c2 + 1;
        }
        if (ns2 == 1) {
            end = g + 1;
            break;
        }
    }

    if (start >= end) {
        vec_truncate(data, 0);
        NSample_set_frames(sample, 0);
        return 0;
    }

    var sample_start = start * ch;
    var sample_end = end * ch;
    var nd = vec_new();
    var k = sample_start;
    while (k < sample_end) {
        vec_push(nd, vec_get(data, k));
        k = k + 1;
    }
    NSample_set_data(sample, nd);
    NSample_set_frames(sample, end - start);
    return 0;
}

# --- normalize_peak: scale so loudest |sample| -> 1.0, with a near-silence floor ---
#
# NOT naad_normalize. naad guards only `peak > 0`, which is too weak in two ways that
# both bite here. Rust (rust-old/src/capture.rs:116-125) scales only when peak > 1e-10:
#   (a) a peak of 1e-12 was being amplified x1e12 to full scale -- turning room tone
#       into a wall of noise where the oracle deliberately leaves the buffer alone;
#   (b) worse, a DENORMAL peak (4.94e-324) makes 1.0/peak overflow to +inf, writing
#       +/-inf straight into the sample data. That is a non-finite injection site inside
#       nidhi with no foreign decoder involved, and it reaches the SVF, which latches.
# The 1e-10 epsilon matches n_normalize_rms below, which has always had it.
fn n_normalize_peak(sample) {
    if (sample <= 0) { return 0; }
    var data = NSample_data(sample);
    var n = vec_len(data);
    if (n == 0) { return 0; }
    var peak = naad_peak(data);
    # A non-finite peak is a no-op, not a scale. One +inf sample makes the peak +inf and the gain
    # 1/inf = 0 -- a FINITE gain, so testing the gain would not catch it: every finite sample
    # became 0 and the inf became NaN (inf * 0). The take was erased and a NaN written into it,
    # measured. The oracle does the same; ADR 0002 (a NaN reaching the SVF latches the voice) is
    # why nidhi does not. Past this test, peak > 1e-10 bounds the gain below 1e10.
    if (n_is_finite(peak) == 0) { return 0; }
    var eps = f64_div(F64_ONE, f64_from(10000000000));
    if (f64_gt(peak, eps) == 1) {
        var gain = f64_div(F64_ONE, peak);
        var i = 0;
        while (i < n) {
            vec_set(data, i, f64_mul(vec_get(data, i), gain));
            i = i + 1;
        }
    }
    return 0;
}

# --- normalize_rms: scale to target RMS (naad_rms + manual gain) ---
fn n_normalize_rms(sample, target_rms) {
    if (sample <= 0) { return 0; }
    var data = NSample_data(sample);
    if (vec_len(data) == 0) { return 0; }
    var r = naad_rms(data);
    # Non-finite gain -> no-op. A NaN or +/-inf target_rms used to be written into EVERY sample:
    # measured, target NaN -> 100/100 samples NaN, target +inf -> 100/100 +inf. The oracle does
    # the same (gain = target / rms, unchecked); a non-finite parameter must not reach the audio
    # (ADR 0002). An rms of +inf (one inf sample) gives the finite gain 0 and the erase-plus-NaN
    # of n_normalize_peak, so it is refused first, for the same reason.
    if (n_is_finite(r) == 0) { return 0; }
    var eps = f64_div(F64_ONE, f64_from(10000000000));
    if (f64_gt(r, eps) == 1) {
        var gain = f64_div(target_rms, r);
        if (n_is_finite(gain) == 0) { return 0; }
        var n = vec_len(data);
        var i = 0;
        while (i < n) {
            vec_set(data, i, f64_mul(vec_get(data, i), gain));
            i = i + 1;
        }
    }
    return 0;
}

# n_loop_score_is_nan(x) -> 1 when the f64 bit pattern x is a NaN.
#must_use
fn n_loop_score_is_nan(x) {
    if ((x & 0x7FFFFFFFFFFFFFFF) > 0x7FF0000000000000) { return 1; }
    return 0;
}

# n_loop_top_insert -- insert (start, end, score) into the descending top-10 lists where a
# STABLE descending sort would put it: after the last kept entry that is not less than it.
# Past index 9 it is dropped. Returns 1 when kept, 0 when dropped. Three parallel vecs of at
# most 10, so this is O(10) per candidate.
fn n_loop_top_insert(top_s, top_e, top_sc, start, end, score) {
    var nt = vec_len(top_sc);
    var pos = nt;
    while (pos > 0) {
        if (f64_lt(vec_get(top_sc, pos - 1), score) == 1) {
            pos = pos - 1;
        } else {
            break;
        }
    }
    if (pos >= 10) { return 0; }
    vec_push(top_s, 0);
    vec_push(top_e, 0);
    vec_push(top_sc, 0);
    var m = nt;
    while (m > pos) {
        vec_set(top_s, m, vec_get(top_s, m - 1));
        vec_set(top_e, m, vec_get(top_e, m - 1));
        vec_set(top_sc, m, vec_get(top_sc, m - 1));
        m = m - 1;
    }
    vec_set(top_s, pos, start);
    vec_set(top_e, pos, end);
    vec_set(top_sc, pos, score);
    vec_truncate(top_s, 10);
    vec_truncate(top_e, 10);
    vec_truncate(top_sc, 10);
    return 1;
}

# --- detect_loop_points: zero-crossing + normalized cross-correlation ---
# Returns a vec of pair pointers (each alloc(16): start at +0, end at +8), best score first,
# at most 10. Empty if frames < min_loop_frames*2 or < 2 positive zero crossings.
#
# The length guard is `min_loop_frames > frames / 2`, the oracle's `frames < min * 2` without
# the multiply. That multiply overflowed for min >= 2^62 (2^63 wraps negative), the guard let
# it through, no pair could ever qualify, so the 100-candidate break never fired and every
# crossing pair was visited: measured, 3136 ms on 2 s of noise to return nothing. For min >= 0
# the two forms agree exactly (frames < 2m <=> m > floor(frames/2)).
#must_use
fn n_detect_loop_points(sample, min_loop_frames) {
    var out = vec_new();
    if (sample <= 0) { return out; }
    var frames = NSample_frames(sample);
    if (min_loop_frames > frames / 2) { return out; }
    var data = NSample_data(sample);
    var ch = NSample_channels(sample);
    var eps = f64_div(F64_ONE, f64_from(10000000000));

    # 1. downmix to mono (mean over channels)
    var mono = vec_new();
    var f = 0;
    while (f < frames) {
        var s = 0;
        var c = 0;
        while (c < ch) {
            s = f64_add(s, vec_get(data, f * ch + c));
            c = c + 1;
        }
        vec_push(mono, f64_div(s, f64_from(ch)));
        f = f + 1;
    }

    # 2. positive-going zero crossings: mono[i-1] <= 0 && mono[i] > 0
    var crossings = vec_new();
    var i = 1;
    var mlen = vec_len(mono);
    while (i < mlen) {
        if (f64_le(vec_get(mono, i - 1), 0) == 1) {
            if (f64_gt(vec_get(mono, i), 0) == 1) { vec_push(crossings, i); }
        }
        i = i + 1;
    }
    if (vec_len(crossings) < 2) { return out; }

    # 3. score candidate pairs, keeping only the 10 best.
    #
    # The oracle collects every candidate and stable-sorts them all (`sort_by`, O(n log n)). The
    # port's O(n^2) insertion sort over ALL of them was a regression, and n is large: the
    # 100-candidate break is checked once per OUTER pass, so on noise the first pass alone keeps
    # about one candidate per crossing (~frames/4). Measured, 1 s of noise took 1022 ms and 2 s
    # took 4087 ms -- quadratic, so a minute of cymbal would take an hour.
    #
    # Only the first 10 of the sorted order are returned, so keep exactly that prefix: each
    # candidate lands after the last kept entry whose score is NOT less than its own, which is
    # where a stable descending sort puts it (ties keep insertion order), and it falls off if
    # that is past index 9. Identical output, 111/111 cases against the full sort (tests pin it),
    # 2 s of noise 4193 -> 23 ms.
    #
    # NaN (only from an inf in the data: inf/inf) is not ordered against anything. In the full
    # insertion sort a NaN never moves left, and nothing moves left past it, so one parked at
    # index >= 10 kept every LATER candidate out of the top 10. `frozen` reproduces that.
    var compare_len = 64;
    if (frames / 4 < compare_len) { compare_len = frames / 4; }
    var top_s = vec_new();
    var top_e = vec_new();
    var top_sc = vec_new();
    var ncand = 0;
    var frozen = 0;
    var ncross = vec_len(crossings);
    var ci = 0;
    while (ci < ncross) {
        var start = vec_get(crossings, ci);
        var cj = ci + 1;
        while (cj < ncross) {
            var end = vec_get(crossings, cj);
            if (end - start >= min_loop_frames) {
                if (start + compare_len <= frames) {
                    if (end + compare_len <= frames) {
                        var dot = 0;
                        var na = 0;
                        var nb = 0;
                        var k = 0;
                        while (k < compare_len) {
                            var a = vec_get(mono, start + k);
                            var b = vec_get(mono, end + k);
                            dot = f64_add(dot, f64_mul(a, b));
                            na = f64_add(na, f64_mul(a, a));
                            nb = f64_add(nb, f64_mul(b, b));
                            k = k + 1;
                        }
                        var denom = f64_sqrt(f64_mul(na, nb));
                        var score = 0;
                        if (f64_gt(denom, eps) == 1) { score = f64_div(dot, denom); }
                        ncand = ncand + 1;
                        if (frozen == 0) {
                            if (n_loop_top_insert(top_s, top_e, top_sc, start, end, score) == 0) {
                                if (n_loop_score_is_nan(score) == 1) { frozen = 1; }
                            }
                        }
                    }
                }
            }
            cj = cj + 1;
        }
        # 100-candidate cap: checked once per OUTER iteration
        if (ncand > 100) { ci = ncross; } else { ci = ci + 1; }
    }

    # 4. the kept (start,end) pairs, best first
    var t = 0;
    while (t < vec_len(top_s)) {
        var pair = alloc(16);
        store64(pair, vec_get(top_s, t));
        store64(pair + 8, vec_get(top_e, t));
        vec_push(out, pair);
        t = t + 1;
    }
    return out;
}

# --- stretch.cyr ---

# stretch.cyr -- time-stretching (WSOLA / OLA), pitch-preserving
# Requires: alloc, vec, math (f64_*, f64_cos/ceil/round/floor), f64_util (n_is_finite)
#
# Ports rust-old/src/stretch.rs. Pure f64 array math, no naad dependency. Buffers are stdlib
# vecs of f64 bit patterns. StretchMode PhaseVocoder falls back to WSOLA (unimplemented in Rust too).

var SM_OLA           = 0;
var SM_WSOLA         = 1;
var SM_PHASE_VOCODER = 2;

# -inf as an f64 bit pattern: the oracle's seed for every best-correlation search.
var N_F64_NEG_INF = 0xFFF0000000000000;

# --- helpers ---

# n_dot(a, a_off, b, b_off, n) -- sum_{i<n} a[a_off+i]*b[b_off+i]  (f64).
# Raw-pointer dot product over n f64 elements, a and b given as byte addresses into a vec's
# buffer. The caller must already have proven both spans in range. This exists because the
# WSOLA correlation search evaluates ~88M element pairs for a one-second stretch, and
# vec_get's two bounds tests per element, times two operands, dominate that loop.
#must_use
fn n_dot_raw(pa, pb, n) {
    var sum = 0;
    var i = 0;
    while (i < n) {
        sum = f64_add(sum, f64_mul(load64(pa + i * 8), load64(pb + i * 8)));
        i = i + 1;
    }
    return sum;
}

fn n_dot(a, a_off, b, b_off, n) {
    var sum = 0;
    var i = 0;
    while (i < n) {
        sum = f64_add(sum, f64_mul(vec_get(a, a_off + i), vec_get(b, b_off + i)));
        i = i + 1;
    }
    return sum;
}

# cross_correlate(a, b, max_lag) -- signed lag maximizing the dot product of a vs b shifted by
# that lag. Negative lag shifts a forward; non-negative lag shifts b forward (lag 0 included).
#
# Seeded exactly as the oracle seeds it (stretch.rs: `best_lag = 0; best_corr =
# f64::NEG_INFINITY`), and a lag wins only on a strict `sum > best_corr`. The port used to seed
# from the FIRST lag it evaluated instead. For finite sums the two are the same, but not when that
# first sum is NaN or -inf: measured, a NaN at lag -1 returned -1 where the oracle returns -2, and
# all sums -inf returned -1 where the oracle returns 0.
#must_use
fn n_cross_correlate(a, b, max_lag) {
    var alen = vec_len(a);
    var blen = vec_len(b);
    if (alen == 0) { return 0; }
    if (blen == 0) { return 0; }
    var best_lag = 0;
    var best_corr = N_F64_NEG_INF;

    var max_neg = max_lag;
    if (alen - 1 < max_neg) { max_neg = alen - 1; }
    var lag = 1;
    while (lag <= max_neg) {
        var ol = alen - lag;
        if (blen < ol) { ol = blen; }
        if (ol > 0) {
            var sum = n_dot(a, lag, b, 0, ol);
            if (f64_gt(sum, best_corr) == 1) {
                best_corr = sum;
                best_lag = 0 - lag;
            }
        }
        lag = lag + 1;
    }

    var max_pos = max_lag;
    if (blen - 1 < max_pos) { max_pos = blen - 1; }
    var lag2 = 0;
    while (lag2 <= max_pos) {
        var ol2 = alen;
        if (blen - lag2 < ol2) { ol2 = blen - lag2; }
        if (ol2 > 0) {
            var sum2 = n_dot(a, 0, b, lag2, ol2);
            if (f64_gt(sum2, best_corr) == 1) {
                best_corr = sum2;
                best_lag = lag2;
            }
        }
        lag2 = lag2 + 1;
    }
    return best_lag;
}

# hann_window(size) -> vec of f64: 0.5*(1 - cos(2*PI*i/(size-1))). An empty vec for size <= 0,
# and 0 when the window cannot be allocated.
#
# Sized once (n_vec_zeros, below) and filled in place. It used to grow by vec_push, which leaves
# the outgrown buffers behind on the bump allocator: about 8 KB of dead heap per stretch at frame
# size 1024, and an exit on a refused grow. The values are computed exactly as before.
#must_use
fn n_hann_window(size) {
    if (size <= 0) { return vec_new(); }
    var w = n_vec_zeros(size);
    if (w == 0) { return 0; }
    var denom = size - 1;
    if (denom < 1) { denom = 1; }
    var denom_f = f64_from(denom);
    var i = 0;
    while (i < size) {
        var ang = f64_div(f64_mul(F64_TAU, f64_from(i)), denom_f);
        vec_set(w, i, f64_mul(F64_HALF, f64_sub(F64_ONE, f64_cos(ang))));
        i = i + 1;
    }
    return w;
}

# normalize_by_window_sum(output, window_sum) -- output[i] /= window_sum[i] where ws > 1e-6.
fn n_normalize_by_window_sum(output, window_sum) {
    var n = vec_len(output);
    if (vec_len(window_sum) < n) { n = vec_len(window_sum); }
    var thr = f64_div(F64_ONE, f64_from(1000000));
    var i = 0;
    while (i < n) {
        var ws = vec_get(window_sum, i);
        if (f64_gt(ws, thr) == 1) {
            vec_set(output, i, f64_div(vec_get(output, i), ws));
        }
        i = i + 1;
    }
    return 0;
}

# n_vec_zeros(n) -> a vec of n zeros sized ONCE, or 0 when n is outside [0, VEC_CAP_MAX] or the
# allocation is refused.
#
# Every stretch buffer used to be grown by vec_push from 16 slots. On a bump allocator that frees
# nothing, doubling leaves each smaller buffer behind: measured, a one-second x2 WSOLA allocated
# 4,210,528 bytes, 2.8 MB of it dead copies; sized once it is 1,444,168. Worse, vec_push ENDS THE
# PROCESS when a grow is refused, so a request n_stretch_fits accepts could still exit(1):
# measured under a 4 GB limit, OLA of 4096 frames x40000 died in the zero-fill, and sized once it
# returns all 163,840,000 samples. A refusal here is an empty result instead.
#
# Same shape as naad_vec_zeros: it relies on the {data, len, cap} header lib/vec.cyr documents,
# and tests/stretch.tcyr pins that the result is an ordinary vec (len n, cap n, still pushable).
# The n bound is what keeps `n * 8` from wrapping.
#must_use
fn n_vec_zeros(n) {
    if (n < 0) { return 0; }
    if (n > VEC_CAP_MAX) { return 0; }
    var v = vec_new();
    if (v == 0) { return 0; }
    if (n > vec_cap(v)) {
        var buf = alloc(n * 8);
        if (buf == 0) { return 0; }
        store64(v, buf);
        store64(v + 16, n);
    }
    var data = load64(v);
    var i = 0;
    while (i < n) {
        store64(data + i * 8, 0);
        i = i + 1;
    }
    store64(v + 8, n);
    return v;
}

# --- TimeStretcher ---
#derive(accessors)
struct NTimeStretcher {
    input;
    sample_rate;
    frame_size;
    overlap;
}

#must_use
fn n_stretcher_new(input, sample_rate) {
    var s = alloc(sizeof(NTimeStretcher));
    NTimeStretcher_set_input(s, input);
    NTimeStretcher_set_sample_rate(s, sample_rate);
    NTimeStretcher_set_frame_size(s, 1024);
    NTimeStretcher_set_overlap(s, F64_HALF);
    return s;
}

# A non-positive frame_size is rejected here rather than stored. The oracle took
# `size: usize`, so negatives were unrepresentable; the i64 port made them reachable and
# they do not merely misbehave -- they HANG. With frame_size = -1000, syn_hop is -500,
# out_pos marches negative, and the sole loop exit (out_pos + frame_size > out_len) is
# never true. Same everything-is-i64 domain loss as the velocity-curve clamp in zone.cyr.
fn n_stretcher_with_frame_size(s, size) {
    if (size <= 0) { return s; }
    NTimeStretcher_set_frame_size(s, size);
    return s;
}

# n_stretch_fits(input_len, frame_size, ratio) -> 1 when the stretched buffers can exist.
# Tested in f64 BEFORE any cast. f64_to has saturated since cyrius 6.6.8, so a length past 2^63
# arrives as i64::MAX and every push loop below runs until the process dies; it used to arrive
# as i64::MIN and skip them by accident. VEC_CAP_MAX is the most vec_push holds before it ends
# the process, so anything at or past it could never have succeeded. naad ADR-0004.
#must_use
fn n_stretch_fits(input_len, frame_size, ratio) {
    var need = f64_add(f64_mul(f64_from(input_len), ratio), f64_from(frame_size));
    return f64_lt(need, f64_from(VEC_CAP_MAX));
}

# stretch_short(ratio) -- linear-interpolation resample for input_len < frame_size.
# The output is sized once (see n_vec_zeros): a target_len outside [0, VEC_CAP_MAX], or a
# refused allocation, is an empty result. The callers' n_stretch_fits already bounds it; this
# function is public, so it does not rely on that.
#must_use
fn n_stretch_short(s, ratio) {
    var input = NTimeStretcher_input(s);
    var input_len = vec_len(input);
    var target_len = f64_to(n_round_half_away(f64_mul(f64_from(input_len), ratio)));
    if (target_len <= 0) { return vec_new(); }
    var out = n_vec_zeros(target_len);
    if (out == 0) { return vec_new(); }
    var i = 0;
    while (i < target_len) {
        var src = f64_div(f64_from(i), ratio);
        var idx = f64_to(f64_floor(src));
        var frac = f64_sub(src, f64_from(idx));
        var a = 0;
        if (idx >= 0) { if (idx < input_len) { a = vec_get(input, idx); } }
        var b = a;
        if (idx + 1 >= 0) { if (idx + 1 < input_len) { b = vec_get(input, idx + 1); } }
        vec_set(out, i, f64_add(a, f64_mul(f64_sub(b, a), frac)));
        i = i + 1;
    }
    return out;
}

# --- shared by n_stretch (WSOLA) and n_stretch_ola ---
# The two used to carry 49 identical lines: guard prologue, buffer setup, normalize-and-truncate
# epilogue. Every repair to that code had to land twice, and the 2.0.5 audit found the OLA copy's
# guards had never been tested. The frame loops stay separate: OLA carries none of WSOLA's
# prev/tolerance bookkeeping.

# Returned by n_stretch_prologue when the caller should run its frame loop. Never a valid vec
# pointer (heap addresses are far above it), and never 0, which a refused vec_new returns.
var N_STRETCH_RUN = 1;

# n_stretch_syn_hop(s) -- the synthesis hop, truncating, as the oracle computes it.
#must_use
fn n_stretch_syn_hop(s) {
    var fs = f64_from(NTimeStretcher_frame_size(s));
    return f64_to(f64_mul(fs, f64_sub(F64_ONE, NTimeStretcher_overlap(s))));
}

# n_stretch_prologue(s, ratio) -> N_STRETCH_RUN, or the finished result: an empty vec on invalid
# input, stretch_short's output, or a copy of the input when syn_hop is not positive.
#
# `syn_hop <= 0`, not the oracle's `== 0`. The oracle's overlap was private and always 0.5;
# #derive(accessors) exports NTimeStretcher_set_overlap. Past 1.0 the hop goes negative, out_pos
# marches below 0, `oi < out_len` still passes and vec_get(output, oi) ends the process:
# measured, overlap 1.5 -> `vec: index < 0`, exit 1. The oracle's `as usize` saturates a negative
# hop to 0, so the copy path IS the oracle's answer for it.
#must_use
fn n_stretch_prologue(s, ratio) {
    var input = NTimeStretcher_input(s);
    var input_len = vec_len(input);
    var frame_size = NTimeStretcher_frame_size(s);
    if (input_len == 0) { return vec_new(); }
    if (frame_size <= 0) { return vec_new(); }
    if (f64_le(ratio, 0) == 1) { return vec_new(); }
    if (n_is_finite(ratio) == 0) { return vec_new(); }
    if (n_stretch_fits(input_len, frame_size, ratio) == 0) { return vec_new(); }
    if (input_len < frame_size) { return n_stretch_short(s, ratio); }
    if (n_stretch_syn_hop(s) <= 0) {
        var out = vec_new();
        var c = 0;
        while (c < input_len) {
            vec_push(out, vec_get(input, c));
            c = c + 1;
        }
        return out;
    }
    return N_STRETCH_RUN;
}

# n_stretch_out_len(s, ratio) -- ceil(input_len * ratio) + frame_size. n_stretch_fits has
# already proven it below VEC_CAP_MAX, in f64, before this cast.
#must_use
fn n_stretch_out_len(s, ratio) {
    var input_len = vec_len(NTimeStretcher_input(s));
    var c = f64_to(f64_ceil(f64_mul(f64_from(input_len), ratio)));
    return c + NTimeStretcher_frame_size(s);
}

# n_stretch_epilogue(output, window_sum, input_len, ratio) -- normalize by the window sum, then
# truncate to round(input_len * ratio), half away from zero as Rust's .round() is.
#must_use
fn n_stretch_epilogue(output, window_sum, input_len, ratio) {
    n_normalize_by_window_sum(output, window_sum);
    var target_len = f64_to(n_round_half_away(f64_mul(f64_from(input_len), ratio)));
    var final_len = target_len;
    if (vec_len(output) < final_len) { final_len = vec_len(output); }
    vec_truncate(output, final_len);
    return output;
}

# The read position, frame_idx * ana_hop, is tested in f64 BEFORE f64_to (naad ADR-0004). With a
# hop of 1 (overlap 1 - 1/1024 through the setter) and ratio 1e-19, frame 1 reads at 1e19: f64_to
# saturates it to i64::MAX, `expected + tolerance` and `optimal + frame_size` wrap, both guards
# pass, and vec_get ends the process (measured: `vec: index out of bounds`, exit 1). Stopping at
# `pos >= input_len` changes nothing reachable without the setter: from there both loops already
# stop, because no frame starting at or past input_len fits inside it.

# stretch(ratio) -- WSOLA. ratio>1 = longer/slower; <1 = shorter/faster.
#must_use
fn n_stretch(s, ratio) {
    var pre = n_stretch_prologue(s, ratio);
    if (pre != N_STRETCH_RUN) { return pre; }
    var input = NTimeStretcher_input(s);
    var input_len = vec_len(input);
    var frame_size = NTimeStretcher_frame_size(s);
    var syn_hop = n_stretch_syn_hop(s);
    var ana_hop = f64_div(f64_from(syn_hop), ratio);
    var tolerance = frame_size / 4;
    var window = n_hann_window(frame_size);
    if (window == 0) { return vec_new(); }
    var out_len = n_stretch_out_len(s, ratio);
    var output = n_vec_zeros(out_len);
    if (output == 0) { return vec_new(); }
    var window_sum = n_vec_zeros(out_len);
    if (window_sum == 0) { return vec_new(); }

    # `prev` is an INDEX into `input`, not a copy of it. It used to be a fresh frame_size vec
    # built per frame -- but the frame is a pure slice of `input`, and the guard below
    # (optimal_input + frame_size > input_len) already proves the whole span is in range, so
    # the copy was allocating and memcpying frame_size f64s per frame for nothing. On a
    # bump allocator that is never reclaimed, ~2.8 MB per one-second stretch.
    var have_prev = 0;
    var prev_start = 0;
    var in_base = load64(input);
    var len_f = f64_from(input_len);
    var frame_idx = 0;
    var looping = 1;
    while (looping == 1) {
        var out_pos = frame_idx * syn_hop;
        var exp_f = f64_mul(f64_from(frame_idx), ana_hop);
        if (out_pos + frame_size > out_len) {
            looping = 0;
        } else {
            if (f64_ge(exp_f, len_f) == 1) {
                looping = 0;
            } else {
                var expected_input = f64_to(exp_f);
                var optimal_input = expected_input;
                if (optimal_input < 0) { optimal_input = 0; }
                if (have_prev == 1) {
                    var ss = expected_input - tolerance;
                    if (ss < 0) { ss = 0; }
                    var se = expected_input + tolerance;
                    var cap = input_len - frame_size;
                    if (se > cap) { se = cap; }
                    if (ss > se) {
                        optimal_input = expected_input;
                        if (optimal_input < 0) { optimal_input = 0; }
                    } else {
                        # Seeded as the oracle seeds it; see n_cross_correlate.
                        var best_pos = ss;
                        var best_corr = N_F64_NEG_INF;
                        var pos = ss;
                        while (pos <= se) {
                            var rem = input_len - pos;
                            var nn = frame_size;
                            if (rem < nn) { nn = rem; }
                            var corr = n_dot_raw(in_base + prev_start * 8, in_base + pos * 8, nn);
                            if (f64_gt(corr, best_corr) == 1) {
                                best_corr = corr;
                                best_pos = pos;
                            }
                            pos = pos + 1;
                        }
                        optimal_input = best_pos;
                    }
                }
                if (optimal_input + frame_size > input_len) {
                    looping = 0;
                } else {
                    var i = 0;
                    while (i < frame_size) {
                        var sv = vec_get(input, optimal_input + i);
                        var oi = out_pos + i;
                        if (oi < out_len) {
                            var wv = vec_get(window, i);
                            vec_set(output, oi, f64_add(vec_get(output, oi), f64_mul(sv, wv)));
                            vec_set(window_sum, oi, f64_add(vec_get(window_sum, oi), f64_mul(wv, wv)));
                        }
                        i = i + 1;
                    }
                    prev_start = optimal_input;
                    have_prev = 1;
                    frame_idx = frame_idx + 1;
                }
            }
        }
    }
    return n_stretch_epilogue(output, window_sum, input_len, ratio);
}

# stretch_ola(ratio) -- plain overlap-add (no correlation search; direct input position).
#must_use
fn n_stretch_ola(s, ratio) {
    var pre = n_stretch_prologue(s, ratio);
    if (pre != N_STRETCH_RUN) { return pre; }
    var input = NTimeStretcher_input(s);
    var input_len = vec_len(input);
    var frame_size = NTimeStretcher_frame_size(s);
    var syn_hop = n_stretch_syn_hop(s);
    var ana_hop = f64_div(f64_from(syn_hop), ratio);
    var window = n_hann_window(frame_size);
    if (window == 0) { return vec_new(); }
    var out_len = n_stretch_out_len(s, ratio);
    var output = n_vec_zeros(out_len);
    if (output == 0) { return vec_new(); }
    var window_sum = n_vec_zeros(out_len);
    if (window_sum == 0) { return vec_new(); }

    var len_f = f64_from(input_len);
    var frame_idx = 0;
    var looping = 1;
    while (looping == 1) {
        var out_pos = frame_idx * syn_hop;
        var pos_f = f64_mul(f64_from(frame_idx), ana_hop);
        if (out_pos + frame_size > out_len) {
            looping = 0;
        } else {
            if (f64_ge(pos_f, len_f) == 1) {
                looping = 0;
            } else {
                var input_pos = f64_to(pos_f);
                if (input_pos + frame_size > input_len) {
                    looping = 0;
                } else {
                    var i = 0;
                    while (i < frame_size) {
                        var oi = out_pos + i;
                        if (oi < out_len) {
                            var wv = vec_get(window, i);
                            var sv = vec_get(input, input_pos + i);
                            vec_set(output, oi, f64_add(vec_get(output, oi), f64_mul(sv, wv)));
                            vec_set(window_sum, oi, f64_add(vec_get(window_sum, oi), f64_mul(wv, wv)));
                        }
                        i = i + 1;
                    }
                    frame_idx = frame_idx + 1;
                }
            }
        }
    }
    return n_stretch_epilogue(output, window_sum, input_len, ratio);
}

# stretch_with_mode(ratio, mode) -- Ola -> OLA; Wsola/PhaseVocoder -> WSOLA.
#must_use
fn n_stretch_with_mode(s, ratio, mode) {
    if (mode == SM_OLA) { return n_stretch_ola(s, ratio); }
    return n_stretch(s, ratio);
}

# --- effect_chain.cyr ---

# effect_chain.cyr -- per-instrument serial effect chain (up to 5 naad effects)
# Requires: alloc, vec, math, naad (reverb_new/reverb_process_sample, comb_filter_new/
#           comb_filter_process_sample, effects_chorus_new/effects_chorus_process_sample,
#           dynamics_compressor_new/_process_sample, dynamics_limiter_new/_process_sample,
#           naad_is_err, delay_len_overflows)
#
# Ports rust-old/src/effect_chain.rs. "Use naad fully": slots hold real naad effect objects
# (the Rust no_std passthrough is dropped). Effects run SERIALLY with per-slot bypass + wet/dry
# mix. process_stereo runs L then R through the SAME stateful chain (source behavior, preserved).
#
# DIVERGENCE (2.2.2), deliberate -- see docs/adr/0011-effect-slots-get-the-parameters-meant.md.
# The oracle's reverb and chorus arguments did not mean what they said, and 2.0.0 to 2.2.1
# replicated them bug for bug:
#   * Reverb: (sr, 1.5, 0.3, 0.5, 0.6) against reverb_new(decay, damping, pre_delay_ms, mix,
#     sample_rate). The rate arrived in `decay` (clamped to 0.99) and 0.6 in `sample_rate`, so
#     every comb and all-pass was 1 sample long: a resonator, not a reverb.
#   * Chorus: 0.02 and 0.002, seconds, against millisecond parameters. The delay line was 1
#     sample long and read back the sample just written, so the chorus was an exact passthrough.

var FX_NONE       = 0;
var FX_REVERB     = 1;
var FX_DELAY      = 2;
var FX_CHORUS     = 3;
var FX_COMPRESSOR = 4;
var FX_LIMITER    = 5;
var N_FX_MAX_SLOTS = 5;

# --- EffectSlot ---
# Fields: effect_type (FX_* tag), bypass (0/1), mix (f64 bits, 0=dry 1=wet),
# state (naad effect pointer, or 0 for None/failed-construction).
#derive(accessors)
# `state_type` records what `state` was actually CONSTRUCTED as, and is what dispatch reads.
#
# Rust's EffectType was an enum whose variant CARRIED the state, so the tag and the payload
# could not disagree. #derive(accessors) generates a public NEffectSlot_set_effect_type, which
# re-opens exactly that: retagging a live FX_REVERB slot to FX_CHORUS used to hand a Reverb*
# to effects_chorus_process_sample -- a wild read inside the audio callback. Dispatching on
# state_type makes the tag non-load-bearing, and a mismatch is treated as an inconsistent slot
# and passed through untouched.
#derive(accessors)
struct NEffectSlot {
    effect_type;
    state_type;
    bypass;
    mix;
    state;
}

#must_use
fn n_effect_slot_new() {
    var s = alloc(sizeof(NEffectSlot));
    NEffectSlot_set_effect_type(s, FX_NONE);
    NEffectSlot_set_state_type(s, FX_NONE);
    NEffectSlot_set_bypass(s, 0);
    NEffectSlot_set_mix(s, F64_ONE);
    NEffectSlot_set_state(s, 0);
    return s;
}

# --- EffectChain ---
# `scratch` is a single reusable ReverbStereo, allocated once. naad's
# reverb_process_sample is a three-line alloc wrapper over reverb_process_core, and
# naad's own header says the hot path must call core with a reused scratch. Going
# through the wrapper cost 32 bytes per frame -- 1,411,200 B/s sustained, and NEVER
# reclaimed, because lib/alloc.cyr is a bump allocator with a no-op free. The four
# other effects were already alloc-free; reverb was the only leak in the chain.
#derive(accessors)
struct NEffectChain {
    slots;
    sample_rate;
    scratch;
}

#must_use
fn n_effect_chain_new(sample_rate) {
    var c = alloc(sizeof(NEffectChain));
    if (c == 0) { return 0; }
    var sc = alloc(sizeof(ReverbStereo));
    if (sc == 0) { return 0; }
    NEffectChain_set_slots(c, vec_new());
    NEffectChain_set_sample_rate(c, sample_rate);
    NEffectChain_set_scratch(c, sc);
    return c;
}

# create_state(effect_type) -> naad effect pointer, or 0 (None/failed). sample_rate f64 bits.
fn n_effect_chain_create_state(chain, effect_type) {
    var sr = NEffectChain_sample_rate(chain);
    if (effect_type == FX_REVERB) {
        # The oracle's five numbers, each in the slot whose range it fits (ADR 0011):
        # decay 0.6, damping 0.3, pre-delay 1.5 ms, mix 0.5, and the real sample rate.
        var st = reverb_new(f64_div(f64_from(6), f64_from(10)), f64_div(f64_from(3), f64_from(10)),
            f64_div(f64_from(3), f64_from(2)), F64_HALF, sr);
        if (naad_is_err(st) == 1) { return 0; }
        return st;
    }
    if (effect_type == FX_DELAY) {
        # (sr * 0.3) as usize. Tested in f64 BEFORE the cast: f64_to has saturated since
        # cyrius 6.6.8, so an absurd sr reaches delay_line_new as i64::MAX, past its floor-only
        # guard, and its push loop ends the process. A slot that cannot exist is None, like
        # the reverb and chorus branches above and below. naad ADR-0004.
        var delay_len = f64_mul(sr, f64_div(f64_from(3), f64_from(10)));
        if (delay_len_overflows(delay_len) == 1) { return 0; }
        return comb_filter_new(f64_to(delay_len), f64_div(f64_from(4), f64_from(10)));      # feedback 0.4
    }
    if (effect_type == FX_CHORUS) {
        # 3 voices, 20 ms base delay, 2 ms depth, 1.5 Hz, mix 0.5. The oracle passed 0.02 and
        # 0.002 (seconds) to these millisecond parameters (ADR 0011).
        var st2 = effects_chorus_new(3, f64_from(20), f64_from(2), f64_div(f64_from(3), f64_from(2)), F64_HALF, sr);
        if (naad_is_err(st2) == 1) { return 0; }
        return st2;
    }
    if (effect_type == FX_COMPRESSOR) {
        # (-20, 4, 0.01, 0.1, sr)
        return dynamics_compressor_new(f64_neg(f64_from(20)), f64_from(4),
            f64_div(F64_ONE, f64_from(100)), f64_div(F64_ONE, f64_from(10)), sr);
    }
    if (effect_type == FX_LIMITER) {
        # (-1.0, 0.05, sr)
        return dynamics_limiter_new(f64_neg(F64_ONE), f64_div(f64_from(5), f64_from(100)), sr);
    }
    return 0;
}

# add(effect_type) -> 1 on success, 0 if the chain is already full (MAX_SLOTS).
#must_use
fn n_effect_chain_add(chain, effect_type) {
    var slots = NEffectChain_slots(chain);
    if (vec_len(slots) >= N_FX_MAX_SLOTS) { return 0; }
    var slot = n_effect_slot_new();
    NEffectSlot_set_effect_type(slot, effect_type);
    NEffectSlot_set_state(slot, n_effect_chain_create_state(chain, effect_type));
    NEffectSlot_set_state_type(slot, effect_type);
    vec_push(slots, slot);
    return 1;
}

fn n_effect_chain_remove(chain, index) {
    var slots = NEffectChain_slots(chain);
    if (index >= 0) {
        if (index < vec_len(slots)) { vec_remove(slots, index); }
    }
    return 0;
}

fn n_effect_chain_clear(chain) {
    vec_truncate(NEffectChain_slots(chain), 0);
    return 0;
}

#must_use
fn n_effect_chain_len(chain) {
    return vec_len(NEffectChain_slots(chain));
}

#must_use
fn n_effect_chain_is_empty(chain) {
    if (vec_len(NEffectChain_slots(chain)) == 0) { return 1; }
    return 0;
}

# slot(index) -> EffectSlot pointer, or 0 if out of range.
#must_use
fn n_effect_chain_slot(chain, index) {
    var slots = NEffectChain_slots(chain);
    if (index < 0) { return 0; }
    if (index >= vec_len(slots)) { return 0; }
    return vec_get(slots, index);
}

# apply one effect to a sample -> wet value. Reverb returns a stereo pair; take the left (.0).
# `state <= 0`, not `== 0`: create_state returns 0 for None, but a naad constructor can
# also hand back a negative error code, and using that as a pointer is a wild read.
fn n_effect_apply(effect_type, state_type, state, input, scratch) {
    if (state <= 0) { return input; }
    # The tag was changed without rebuilding the state: the slot is inconsistent, so pass
    # through rather than reinterpreting one effect's struct as another's.
    if (effect_type != state_type) { return input; }
    if (effect_type == FX_REVERB) {
        reverb_process_core(state, input, scratch);
        return load64(scratch);
    }
    if (effect_type == FX_DELAY) { return comb_filter_process_sample(state, input); }
    if (effect_type == FX_CHORUS) { return effects_chorus_process_sample(state, input); }
    if (effect_type == FX_COMPRESSOR) { return dynamics_compressor_process_sample(state, input); }
    if (effect_type == FX_LIMITER) { return dynamics_limiter_process_sample(state, input); }
    return input;
}

# process_sample(input) -> output. Serial; skip bypassed/None slots; wet/dry blend per slot.
fn n_effect_chain_process_sample(chain, input) {
    var slots = NEffectChain_slots(chain);
    var n = vec_len(slots);
    var out = input;
    var i = 0;
    while (i < n) {
        var slot = vec_get(slots, i);
        var etype = NEffectSlot_effect_type(slot);
        if (NEffectSlot_bypass(slot) == 0) {
            if (etype != FX_NONE) {
                var wet = n_effect_apply(etype, NEffectSlot_state_type(slot), NEffectSlot_state(slot), out, NEffectChain_scratch(chain));
                var mix = NEffectSlot_mix(slot);
                out = f64_add(f64_mul(out, f64_sub(F64_ONE, mix)), f64_mul(wet, mix));
            }
        }
        i = i + 1;
    }
    return out;
}

# process_stereo(left, right, out2) -> out2[0]=L, out2[1]=R. L then R share the stateful chain.
fn n_effect_chain_process_stereo(chain, left, right, out2) {
    store64(out2, n_effect_chain_process_sample(chain, left));
    store64(out2 + 8, n_effect_chain_process_sample(chain, right));
    return 0;
}

# --- io.cyr ---

# io.cyr -- WAV loading + streaming (behind the Rust `io` feature; uses shravan)
# Requires: alloc, vec, string (strlen), str (str_from_buf), load8/load64/store64,
#           io (file_read_whole_into, xstat, STAT_MODE/STAT_SIZE), f64_util (n_vec_with_cap),
#           sample (n_sample_from_mono/stereo/with_name), error (NIDHI_ERR_IMPORT),
#           shravan (wav_decode, codec_open, decode_result_info/samples, fmtinfo_channels/
#           sample_rate, shravan_max_samples, shravan_init_constants)
#
# 2.1.0 dropped the shravan streaming shim (wav_stream_new/feed/flush, stream_evt_*,
# STREAM_EVT_*): NStreamReader now decodes once and serves chunks from a cursor. shravan's
# stream decoders have been genuinely incremental since 2.9.3, so going back to them is the
# roadmap item "NStreamReader can stream for real" -- not done here.
#
# Ports rust-old/src/io.rs. Samples are f64 bit patterns end-to-end (shravan decodes to f64), so
# the Rust Vec<f32> boundary conversions are no-ops here. All failures collapse to NIDHI_ERR_IMPORT.
# Success returns a positive Sample pointer; failure returns the negative NIDHI_ERR_IMPORT code.

# --- MANDATORY one-time dependency initialisation ---
#
# shravan's PCM scale constants (F64_RCP_128 / F64_RCP_32768 / F64_RCP_8388608 /
# F64_RCP_2147483648 and 13 siblings) are declared as plain `0` and are only assigned by
# shravan_init_constants(). nidhi never called it, and 0 as an f64 bit pattern is +0.0,
# so ALL 17 were silently +0.0. Two live consequences, not one:
#   * the little-endian converters MULTIPLY by F64_RCP_*, so every 8/16/24/32-bit integer
#     PCM file decoded to pure silence -- and integer PCM is the common case for WAV;
#   * the big-endian converters DIVIDE by them, so an AIFF returned a SUCCESSFUL Sample
#     whose every frame was +/-inf or NaN, which then latches the SVF for the voice's life.
# tests/io.tcyr never caught either because every fixture encodes PCM_F32, the one format
# that needs no scale constant.
#
# Called from every public entry point rather than exported as a "remember to call this",
# because a consumer cannot be expected to know a transitive dependency needs waking up.
# shravan_init_constants only assigns globals that are currently 0, so it is idempotent;
# the flag just keeps it off the hot path.
#
# Checked and clear: shravan is the ONLY dependency with this pattern. naad's _DB_LUT and
# hisab's _PERM_TABLE / _grad3 self-initialise behind their own guards; goonj has none.
var N_INIT_DONE = 0;

fn n_init() {
    if (N_INIT_DONE == 1) { return 0; }
    shravan_init_constants();
    N_INIT_DONE = 1;
    return 0;
}

# n_read_max() -> the largest regular file n_read_file accepts: the most audio bytes a one-shot
# decode can return. shravan refuses more than shravan_max_samples() samples (2^26 by default)
# and the widest sample is 8 bytes (64-bit float), so a bigger file cannot decode -- reading it
# would only mint never-freed heap first. Follows a consumer that raises the ceiling, clamped so
# that file_read_whole_into's max + 1 buffer stays inside ALLOC_MAX.
fn n_read_max() {
    var m = shravan_max_samples() * 8;
    if (m > ALLOC_MAX - 1) { m = ALLOC_MAX - 1; }
    return m;
}

# A file whose size stat cannot give (a pipe, a device, procfs, anything on Windows, whose xstat
# is not wired) is read under decode_file's old 256 MiB cap instead: every byte past what it turns
# out to need is never-freed heap, so /dev/zero costs what it did through decode_file (511 MB)
# rather than n_read_max()'s 1,023 MB.
var N_READ_UNSIZED_MAX = 268435456;

# n_read_file(path, out_len) -> heap byte buffer (or 0 on error); writes the byte count to
# out_len (0 on error).
#
# The stdlib's file_read_whole_into does the reading, which is what this loop was missing
# three ways:
#   * a failed read ended the loop as if it were end-of-file, so a read error mid-file returned
#     the bytes so far as the whole file -- and wav_decode clamps the data size to what is
#     present, so it decoded as a successful, shorter Sample. A directory (open succeeds, read
#     is -EISDIR) came back as a non-0 buffer of length 0;
#   * the first alloc was unchecked, and growth went all the way to 2 GiB -- 2,047 MB of heap
#     spent on /dev/zero before refusing it (511 MB now, see N_READ_UNSIZED_MAX);
#   * every call started at a 1 MB buffer, so loading a 244-byte WAV cost 1,049,832 B of
#     never-reclaimed heap.
# A regular file's stat size sizes the buffer at size + 1 (one spare byte, so reaching EOF does
# not trigger a doubling), and one larger than n_read_max() is refused before any of it is
# read. The size is only a starting capacity: a file that grows between the stat and the read
# still reads whole, up to max. Measured: the 244-byte WAV now costs 1,520 B per n_load_wav in
# all, and a 1.76 MB file's read buffers 1.76 MB instead of 3 MB.
#must_use
fn n_read_file(path, out_len) {
    store64(out_len, 0);
    var max = n_read_max();
    var hint = 0;
    var st[144];
    if (xstat(path, &st) == 0) {
        if ((load32(&st + STAT_MODE) & 0xF000) == 0x8000) { hint = load64(&st + STAT_SIZE); }
    }
    if (hint > max) { return 0; }
    if (hint <= 0) {
        if (max > N_READ_UNSIZED_MAX) { max = N_READ_UNSIZED_MAX; }
    }
    var rb[16];
    store64(&rb, 0);
    store64(&rb + 8, 0);
    if (hint > 0) {
        var b0 = alloc(hint + 2);
        if (b0 != 0) {
            store64(&rb, b0);
            store64(&rb + 8, hint + 1);
        }
    }
    var n = file_read_whole_into(&rb, path, max);
    if (n < 0) { return 0; }
    store64(out_len, n);
    return load64(&rb);
}

# n_file_stem(path cstr) -> a new Str of the basename without extension (Rust Path::file_stem).
# A leading '.' is NOT treated as an extension separator (".bashrc" -> ".bashrc").
#must_use
fn n_file_stem(path) {
    var len = strlen(path);
    var slash = 0 - 1;
    var i = 0;
    while (i < len) {
        if (load8(path + i) == 47) { slash = i; }
        i = i + 1;
    }
    var start = slash + 1;
    var dot = 0 - 1;
    var j = start;
    while (j < len) {
        if (load8(path + j) == 46) { dot = j; }
        j = j + 1;
    }
    var end = len;
    if (dot > start) { end = dot; }
    # A COPY, not str_new: str_new borrows, and this Str becomes the Sample's name. A caller
    # that builds each path in one reused buffer renamed every Sample it had already loaded
    # to the latest file. Rust's file_stem(..).to_string() owned its String. 0 on OOM.
    return str_from_buf(path + start, end - start);
}

# n_scrub_nonfinite(v) -- replace every non-finite sample in v with +0.0, in place.
#
# Trust boundary for foreign audio data, shared by every loader. A single non-finite frame is
# not a local glitch: it propagates through the SVF state and latches the voice to NaN for its
# whole life, and the mix buffer with it. O(n) once at load, zero cost per render. The stream
# reader skipped it, so a 64-bit float WAV holding NaN/Inf reached a consumer through
# n_stream_reader_* while n_load_wav of the same file was clean (shravan zeroes non-finite f32
# itself, but copies f64 samples raw).
#
# The test is n_is_finite's mask written inline over the raw buffer: the call plus vec_get/
# vec_set per sample made this 7.5 ms for 882K samples, against 1.5 ms now.
fn n_scrub_nonfinite(v) {
    var n = vec_len(v);
    var d = load64(v);
    var i = 0;
    while (i < n) {
        var p = d + i * 8;
        if ((load64(p) & 0x7FF0000000000000) == 0x7FF0000000000000) { store64(p, 0); }
        i = i + 1;
    }
    return 0;
}

# n_front_pair(samples, channels) -> a new interleaved stereo vec holding channels 1 and 2 of
# every whole frame of `samples` (channels > 2), or 0 when it cannot be allocated.
#
# Files with more than two channels load their front pair; see
# docs/adr/0010-multichannel-loads-front-pair.md. Channels 1 and 2 are front left and front
# right in WAV, Opus and AAC order (shravan emits ffmpeg's order) and in most AIFF layouts (AIFF's
# 4-channel L-C-R-S puts the centre second), and the remaining channels are dropped. They used to be handed to n_sample_from_stereo as they were, which read
# the N-channel interleave as stereo pairs: a 4-frame 3-channel file loaded as 6 "frames" of
# mixed-up channels, and the stream reader reported 4 frames while serving 6.
#must_use
fn n_front_pair(samples, channels) {
    var frames = vec_len(samples) / channels;
    var out = n_vec_with_cap(frames * 2);
    if (out == 0) { return 0; }
    var f = 0;
    while (f < frames) {
        vec_push(out, vec_get(samples, f * channels));
        vec_push(out, vec_get(samples, f * channels + 1));
        f = f + 1;
    }
    return out;
}

# Build a Sample from a decode_result: mono if channels==1, else stereo -- the front pair when
# there are more than two (docs/adr/0010-multichannel-loads-front-pair.md). NIDHI_ERR_IMPORT
# when the front-pair vec cannot be allocated.
#must_use
fn n_sample_from_decode(dr) {
    var info = decode_result_info(dr);
    var samples = decode_result_samples(dr);
    var channels = fmtinfo_channels(info);
    var sample_rate = fmtinfo_sample_rate(info);
    if (channels > 2) {
        samples = n_front_pair(samples, channels);
        if (samples == 0) { return NIDHI_ERR_IMPORT; }
    }
    n_scrub_nonfinite(samples);
    var smp = 0;
    if (channels == 1) { smp = n_sample_from_mono(samples, sample_rate); }
    else { smp = n_sample_from_stereo(samples, sample_rate); }
    # The constructors return 0 when an allocation is refused; this function's contract is a
    # Sample or a negative code.
    if (smp == 0) { return NIDHI_ERR_IMPORT; }
    return smp;
}

# load_wav_from_memory(data, len) -> Sample pointer, or NIDHI_ERR_IMPORT.
#must_use
fn n_load_wav_from_memory(data, len) {
    n_init();
    var dr = wav_decode(data, len);
    if (dr < 0) { return NIDHI_ERR_IMPORT; }
    return n_sample_from_decode(dr);
}

# load_wav(path) -> Sample pointer (named from the file stem), or NIDHI_ERR_IMPORT.
#
# Reads with n_read_file, then decodes from memory through codec_open -- the dispatch
# decode_file itself ends in, so every format it decoded still decodes (WAV, AIFF, FLAC, Ogg
# Vorbis/Opus, MP3, AAC, ALAC, MP4). decode_file's own read loop was the hazard: its growth
# alloc was unchecked, so n_load_wav("/dev/zero") -- or an SFZ `sample=` naming a device --
# SIGSEGV'd the host in memcpy(0, ..) under a 700 MB address-space limit, and without one spent
# 511 MB of never-freed heap before refusing it; every call also started at a 1 MB buffer.
# n_read_file checks every allocation, reports read errors, and caps a regular file at
# n_read_max() (512 MiB by default; decode_file's cap was 256 MiB for every input) and anything
# stat cannot size at decode_file's 256 MiB. Measured on /dev/zero: -5 under a 700 MB limit
# instead of exit 139, and 511 MB of heap without one, as before.
#must_use
fn n_load_wav(path) {
    n_init();
    var lenslot = alloc(8);
    if (lenslot == 0) { return NIDHI_ERR_IMPORT; }
    var data = n_read_file(path, lenslot);
    if (data == 0) { return NIDHI_ERR_IMPORT; }
    var dr = codec_open(data, load64(lenslot));
    if (dr < 0) { return NIDHI_ERR_IMPORT; }
    var sample = n_sample_from_decode(dr);
    if (sample <= 0) { return NIDHI_ERR_IMPORT; }
    var stem = n_file_stem(path);
    if (stem == 0) { return NIDHI_ERR_IMPORT; }
    return n_sample_with_name(sample, stem);
}

# --- StreamingWavReader ---
#
# 2.1.0: decodes the file ONCE. It used to decode twice -- n_stream_reader_open ran a full
# wav_decode purely to read the format header and threw the samples away, then read_chunk fed
# the entire file back through shravan's stream decoder to recover them. Measured 85.9 ms and
# 14.4 MB of never-reclaimed heap on a 10 s file BEFORE the first chunk was returned, which is
# the opposite of what a streaming reader is for. read_chunk also rebuilt `pending` into a
# fresh vec on every call, so read_all was two more full copies on top.
#
# The decoded buffer now lives on the reader and chunks are a cursor into it. That drops the
# shravan stream decoder, the pending buffer, and the file-data/offset bookkeeping entirely.
#
# NOTE: this is still not incremental -- open() holds the whole decoded file in memory. When
# it was written shravan's stream decoder was buffer-then-decode-once (the defect behind the
# 2.0.2 4 KB truncation bug); it has been incremental since shravan 2.9.3, which is the
# roadmap's "NStreamReader can stream for real". What this change bought is one decode
# instead of two and one copy instead of three, at strictly lower peak memory than before.
#
# `channels` is what the reader SERVES (1 or 2) and `src_channels` what the file has. A file
# with more than two channels is served as its front pair (docs/adr/0010-multichannel-loads-
# front-pair.md): channels, total_frames and every read_chunk agree on 2-channel frames, and
# read_all matches n_load_wav of the same file. The pair is picked per chunk rather than copied
# out at open, so open() costs no second buffer.
#derive(accessors)
struct NStreamReader {
    info;
    samples;
    channels;
    sample_rate;
    total_frames;
    frames_read;
    src_channels;
}

# open(path) -> NStreamReader pointer, or NIDHI_ERR_IMPORT.
#must_use
fn n_stream_reader_open(path) {
    n_init();
    var lenslot = alloc(8);
    if (lenslot == 0) { return NIDHI_ERR_IMPORT; }
    var file_data = n_read_file(path, lenslot);
    if (file_data == 0) { return NIDHI_ERR_IMPORT; }
    var dr = wav_decode(file_data, load64(lenslot));
    if (dr < 0) { return NIDHI_ERR_IMPORT; }
    var info = decode_result_info(dr);
    var samples = decode_result_samples(dr);
    n_scrub_nonfinite(samples);

    var src_ch = fmtinfo_channels(info);
    if (src_ch < 1) { src_ch = 1; }
    var ch = src_ch;
    if (ch > 2) { ch = 2; }

    # Frame count comes from the DECODED data, not from the header's declared total. The two
    # disagreeing is exactly the 2.0.2 bug where total_frames stayed correct while the reader
    # returned 1013 frames; deriving it from what actually decoded makes that unrepresentable.
    var r = alloc(sizeof(NStreamReader));
    if (r == 0) { return NIDHI_ERR_IMPORT; }
    NStreamReader_set_info(r, info);
    NStreamReader_set_samples(r, samples);
    NStreamReader_set_channels(r, ch);
    NStreamReader_set_src_channels(r, src_ch);
    NStreamReader_set_sample_rate(r, fmtinfo_sample_rate(info));
    NStreamReader_set_total_frames(r, vec_len(samples) / src_ch);
    NStreamReader_set_frames_read(r, 0);
    return r;
}

# read_chunk(chunk_frames) -> vec of interleaved f64 samples (empty when exhausted), or 0 when
# the chunk cannot be allocated.
#
# The chunk is sized up front and copied a sample (8 bytes) at a time -- the stdlib memcpy is a
# byte loop, 11.6 ms for this file. It was vec_push per sample from vec_new(), so a whole-file
# chunk paid the doubling chain: 16.78 MB of heap and 15.9 ms for a 10 s stereo file whose
# samples are 7.06 MB, now 7.06 MB and 1.7 ms (512-frame chunks: 15.6 ms -> 1.7 ms per file).
fn n_stream_reader_read_chunk(reader, chunk_frames) {
    if (chunk_frames <= 0) { return vec_new(); }
    var ch = NStreamReader_channels(reader);
    var src_ch = NStreamReader_src_channels(reader);
    var read = NStreamReader_frames_read(reader);
    var remaining = NStreamReader_total_frames(reader) - read;
    if (remaining <= 0) { return vec_new(); }
    var n = chunk_frames;
    if (n > remaining) { n = remaining; }

    var samples = NStreamReader_samples(reader);
    var count = n * ch;
    var out = n_vec_with_cap(count);
    if (out == 0) { return 0; }
    if (src_ch == ch) {
        var dst = load64(out);
        var src = load64(samples) + read * ch * 8;
        var i = 0;
        while (i < count) {
            store64(dst + i * 8, load64(src + i * 8));
            i = i + 1;
        }
        store64(out + 8, count);
    } else {
        var f = 0;
        while (f < n) {
            var at = (read + f) * src_ch;
            vec_push(out, vec_get(samples, at));
            vec_push(out, vec_get(samples, at + 1));
            f = f + 1;
        }
    }
    NStreamReader_set_frames_read(reader, read + n);
    return out;
}

# read_all() -> a Sample holding every remaining frame, or NIDHI_ERR_IMPORT when it cannot be
# allocated.
#
# A reader nothing has been read from, whose decoded buffer is exactly its frames (no trailing
# partial frame, no extra channels), hands that buffer over instead of copying it: read_all
# exhausts the reader, so nothing reads the buffer through it again -- the oracle's read_all
# consumed the reader outright (`fn read_all(mut self)`). Same samples, same length, 0 bytes
# instead of a whole-file copy.
fn n_stream_reader_read_all(reader) {
    var total = NStreamReader_total_frames(reader);
    var ch = NStreamReader_channels(reader);
    var samples = NStreamReader_samples(reader);
    var data = 0;
    var whole = 0;
    if (NStreamReader_frames_read(reader) == 0) {
        if (NStreamReader_src_channels(reader) == ch) {
            if (vec_len(samples) == total * ch) { whole = 1; }
        }
    }
    if (whole == 1) {
        data = samples;
        NStreamReader_set_frames_read(reader, total);
    } else {
        data = n_stream_reader_read_chunk(reader, total);
        if (data == 0) { return NIDHI_ERR_IMPORT; }
    }
    var smp = 0;
    if (ch == 1) { smp = n_sample_from_mono(data, NStreamReader_sample_rate(reader)); }
    else { smp = n_sample_from_stereo(data, NStreamReader_sample_rate(reader)); }
    if (smp == 0) { return NIDHI_ERR_IMPORT; }
    return smp;
}

# --- sf2.cyr ---

# sf2.cyr -- SF2 / SoundFont-2 RIFF binary parser
# Requires: alloc, vec, str (str_from_buf), math (f64_*), byte ops (load8),
#           f64_util (n_vec_with_cap), sample (n_sample_*),
#           zone (n_zone_*), instrument (n_instrument_*), loop_mode (LOOP_*)
#
# Ports rust-old/src/sf2.rs. ALL multi-byte integers are little-endian. Parses an in-memory byte
# buffer (data ptr + len) into (presets, instruments, SampleBank). Success -> Sf2Result pointer;
# failure -> a negative error code. Lenient on bad content (skips), strict on structural errors.
# Every read is bounds-checked (returns 0 past end) so hostile input never reads OOB.

# --- FourCC constants (bytes packed little-endian, byte0 in the low 8 bits) ---
# RIFF/SoundFont chunk fourccs. N_-prefixed because these sit in exactly the namespace a codec
# dependency grows into -- shravan already parses RIFF, and Cyrius is SILENT on a duplicate
# `var`, so a future `CC_RIFF` there would resolve last-definition-wins with no diagnostic.
var N_CC_RIFF = 0x46464952;
var N_CC_SFBK = 0x6B626673;
var N_CC_LIST = 0x5453494C;
var N_CC_SDTA = 0x61746473;
var N_CC_SMPL = 0x6C706D73;
var N_CC_PDTA = 0x61746470;
var N_CC_PHDR = 0x72646870;
var N_CC_PBAG = 0x67616270;
var N_CC_PGEN = 0x6E656770;
var N_CC_INST = 0x74736E69;
var N_CC_IBAG = 0x67616269;
var N_CC_IGEN = 0x6E656769;
var N_CC_SHDR = 0x72646873;

# --- bounds-checked little-endian byte readers (0 past end) ---
fn sf2_u8(data, len, off) {
    if (off < 0) { return 0; }
    if (off >= len) { return 0; }
    return load8(data + off);
}

fn sf2_u16(data, len, off) {
    if (off < 0) { return 0; }
    if (off + 2 > len) { return 0; }
    return load8(data + off) | (load8(data + off + 1) << 8);
}

fn sf2_u32(data, len, off) {
    if (off < 0) { return 0; }
    if (off + 4 > len) { return 0; }
    return load8(data + off) | (load8(data + off + 1) << 8) | (load8(data + off + 2) << 16) | (load8(data + off + 3) << 24);
}

# Unchecked 16-bit little-endian reads for the walk's generator loops, whose index is already
# below the table's count -- so p + 2 is inside the chunk by construction. The checked readers
# cost the lazy walk 2x on a generator-heavy file (39.6 ms -> 77.2 ms); these keep it level.
# sf2_le16s sign-extends with (v ^ 0x8000) - 0x8000, which is v - 0x10000 exactly when bit 15 is
# set: one expression, so #inline applies.
#inline
fn sf2_le16(p) { return load8(p) | (load8(p + 1) << 8); }
#inline
fn sf2_le16s(p) { return ((load8(p) | (load8(p + 1) << 8)) ^ 0x8000) - 0x8000; }

# fourcc packed LE (same as u32); compares against CC_* constants.
fn sf2_fourcc(data, len, off) {
    return sf2_u32(data, len, off);
}

# sf2_name(data, dlen, off, flen) -> an OWNED Str of a fixed-width name field, cut at the first
# NUL (or the field width, or end of data); 0 when it cannot be allocated.
#
# Owned because every name built here leaves sf2_parse. They used to be Strs pointing INTO the
# caller's file buffer, so a caller that reused that buffer -- read the next .sf2 into it, the
# thing ADR 001's never-free allocator pushes a long-lived host towards -- silently renamed every
# preset it had already loaded (fixed in 2.2.2). Rust's parser returned owned Strings (sf2.rs
# read_fixed_string -> String::from_utf8_lossy(..).into()). Built only for what is returned:
# emitted presets (whose instrument shares the Str) and converted samples.
#must_use
fn sf2_name(data, dlen, off, flen) {
    var slen = 0;
    var scanning = 1;
    while (scanning == 1) {
        if (slen >= flen) {
            scanning = 0;
        } else {
            var idx = off + slen;
            if (idx >= dlen) {
                scanning = 0;
            } else {
                if (load8(data + idx) == 0) { scanning = 0; } else { slen = slen + 1; }
            }
        }
    }
    return str_from_buf(data + off, slen);
}

# range-generator amount: lo = low byte, hi = high byte of the 16-bit amount.
#inline
fn sf2_amt_lo(amount) { return amount & 0xFF; }
#inline
fn sf2_amt_hi(amount) { return ((amount & 0xFFFF) >> 8) & 0xFF; }

# public preset descriptor + the 3-list parse result
#derive(accessors)
struct Sf2Preset { name; bank; preset_number; }
#derive(accessors)
struct Sf2Result { presets; instruments; bank; }

# preset key/vel range passed down to the instrument-bag resolver
#derive(accessors)
struct Sf2PRange { pk_lo; pk_hi; have_pk; pv_lo; pv_hi; have_pv; }

# --- record tables: read in place, by index ---
#
# The seven pdta record arrays are read straight from the chunk bytes: record i of a chunk with
# record size SIZE starts at i * SIZE, and count = chunk length / SIZE (floor, as before). The
# field readers below go through the bounds-checked sf2_u16/sf2_u32/sf2_u8 against the chunk's
# own length; the two generator loops, whose index is below the count, read with sf2_le16.
#
# They used to be copied out first, one heap struct per record plus a vec slot and a borrowed
# name Str: 6x the file size in never-freed heap even after 2.2.2 sized the vecs, and the copies
# were then only ever read. Nothing is allocated per record now; names are built for what is
# returned. Measured on a 42 MB SF2 whose igen chunk holds 10.5M records: 251.7 MB of heap and
# ~380 ms before, 2,664 B and 0.1 ms now, the same result. On a generator-heavy valid file
# (60,000 zones, 2.4M generator visits) 39 ms -> 34 ms; across a 14-file corpus the parse
# output is byte-identical.
#
# Field layout (SF2 2.04 section 7, all little-endian):
#   phdr 38: name[20] preset@20 bank@22 bag@24        pbag/ibag 4: gen@0 (mod@2 unused)
#   inst 22: name[20] bag@20                           pgen/igen 4: oper@0 amount(i16)@2
#   shdr 46: name[20] start@20 end@24 loop_start@28 loop_end@32 rate@36 pitch(u8)@40 type@44
var N_SF2_PHDR_SIZE = 38;
var N_SF2_BAG_SIZE = 4;
var N_SF2_GEN_SIZE = 4;
var N_SF2_INST_SIZE = 22;
var N_SF2_SHDR_SIZE = 46;

# 2^-15 = 1/32768 as an f64 bit pattern (the PCM16 scale).
var N_F64_2_NEG_15 = 0x3F00000000000000;

# pcm16_to_f32: 16-bit LE PCM -> vec of f64 in [-1,1). Divisor 32768. Empty on bad range;
# 0 when the vec cannot be allocated.
#
# Written straight into a vec sized from the range. It was vec_push per sample from vec_new()
# plus an f64_div each: measured on 1M samples, 22.7 ms and 16.78 MB of heap (the doubling
# chain's outgrown buffers are never freed), now 3.9 ms and 8.00 MB. The output is
# bit-identical: 32768 is 2^15, so x / 32768 and x * 2^-15 are both exact for every 16-bit x,
# and the range check above the loop replaces the per-sample bounds check it used to make.
#must_use
fn sf2_pcm16_to_f32(data, dlen, start_sample, end_sample) {
    var byte_start = start_sample * 2;
    var byte_end = end_sample * 2;
    if (byte_end > dlen) { return vec_new(); }
    if (byte_start > byte_end) { return vec_new(); }
    var num = (byte_end - byte_start) / 2;
    var out = n_vec_with_cap(num);
    if (out == 0) { return 0; }
    if (num == 0) { return out; }
    var dst = load64(out);
    var src = data + byte_start;
    var i = 0;
    while (i < num) {
        var s = load8(src + i * 2) | (load8(src + i * 2 + 1) << 8);
        if (s >= 0x8000) { s = s - 0x10000; }
        store64(dst + i * 8, f64_mul(f64_from(s), N_F64_2_NEG_15));
        i = i + 1;
    }
    store64(out + 8, num);
    return out;
}

# --- resolve context: shdr memo + zone budget ---
#
# preset -> pbag -> ibag is a triple loop over three attacker-declared u16 index fields
# costing 38/4/4 bytes per step, and NOTHING was shared between iterations: every
# (preset, pbag, ibag) triple re-converted the SAME shdr's PCM into a fresh f64 vec and
# pushed another Sample into the bank. Memory therefore grew as the CUBE of file size --
# measured 229 MB from a 5,674-byte file, and ~7.5 KB was enough to reach `vec: alloc
# failed` -> syscall(60,1), an unconditional exit(1) of the HOST process (dhvani/shruti),
# with no error return to catch.
#
# Both halves below are load-bearing. The memo alone is not enough: with the PCM removed
# entirely, ~656 bytes of NZone plus zone-vec growth per triple still reaches ~1 GB from a
# 20 KB file. The budget alone is not enough either -- 65536 zones each re-converting a
# multi-megabyte shdr is still fatal. The cap stays well under VEC_CAP_MAX (2^28).
#
# Inherited from rust-old (sf2.rs:423-545 has the identical un-memoized walk), not a port
# regression -- but Rust's OOM is an abort of a process that can be supervised, whereas
# here it takes the audio host down mid-render.
var N_SF2_MAX_ZONES = 65536;

# --- work budget: every bag and generator the walk visits costs one unit ---
#
# The zone budget bounds what the walk BUILDS, not what it READS. A preset bag that names no
# instrument, or an instrument bag with no sampleID, costs nothing against N_SF2_MAX_ZONES, and
# bag ranges may overlap and point backwards. pbag gen_index alternating 0 / 65535 makes every
# other bag rescan all 65,535 pgens: 2.1e9 generator visits, 14.4 s, from ONE preset in a
# 525 KB file, and each further 76-byte phdr pair adds another 14 s (a 1000-pair file is about
# 4 hours) -- a parse that never returns, on the host's loader thread. Inherited from the oracle
# (sf2.rs has the same un-budgeted walk).
#
# 2^24 is above anything a file inside the zone budget can legitimately need. SF2 defines 61
# generator operators and a zone lists each at most once, so a zone is one ibag plus <= 61
# generators: 65,536 zones read at most 65,536 x 62 units. On top of that every preset bag reads
# itself, its own <= 61 generators and at most one global instrument zone of 62; phdr bag
# indices are u16 and the spec requires them to increase, so a conforming file visits at most
# 65,536 preset bags: 65,536 x (62 + 124) = 12.2M < 16.8M. Measured: the two bomb shapes now
# return NIDHI_ERR_IMPORT in 0.19 s and 0.69 s, and the valid fixtures parse unchanged.
var N_SF2_MAX_WORK = 16777216;

# Per-parse walk state: the shdr memo, both budgets, the preset-range record, the sample data,
# the bank, the seven record tables (pointer, byte length, record count) and a spare instrument.
#
# prange is reset per preset bag, so ONE record per parse is enough. It was alloc(48) per
# preset-bag visit, ahead of the instrument check and outside the zone budget: presets whose
# bag ranges all overlap one 65,536-bag pbag chunk made 3.15 GB of never-freed heap from a
# 338 KB file, and a 376 KB file ran out and SIGSEGV'd storing through the 0 alloc returned
# (measured, exit 139).
#
# The spare instrument is the one a preset with no zones leaves behind: it is still empty, so the
# next preset reuses it instead of allocating another 504 bytes. A phdr chunk of zone-less presets
# cost 504 B of heap per 38-byte record (13x) before; now it costs one instrument in all.
#derive(accessors)
struct Sf2Ctx {
    memo;
    zones_left;
    work_left;
    prange;
    smpl_ptr;
    smpl_len;
    bank;
    phdr_ptr;
    phdr_len;
    phdr_n;
    pbag_ptr;
    pbag_len;
    pbag_n;
    pgen_ptr;
    pgen_len;
    pgen_n;
    inst_ptr;
    inst_len;
    inst_n;
    ibag_ptr;
    ibag_len;
    ibag_n;
    igen_ptr;
    igen_len;
    igen_n;
    shdr_ptr;
    shdr_len;
    shdr_n;
    spare_inst;
}

# --- record field readers (index i, already checked against the table's count) ---
fn sf2_phdr_preset(ctx, i) {
    return sf2_u16(Sf2Ctx_phdr_ptr(ctx), Sf2Ctx_phdr_len(ctx),
        i * N_SF2_PHDR_SIZE + 20);
}
fn sf2_phdr_bank(ctx, i) {
    return sf2_u16(Sf2Ctx_phdr_ptr(ctx), Sf2Ctx_phdr_len(ctx),
        i * N_SF2_PHDR_SIZE + 22);
}
fn sf2_phdr_bag(ctx, i) {
    return sf2_u16(Sf2Ctx_phdr_ptr(ctx), Sf2Ctx_phdr_len(ctx),
        i * N_SF2_PHDR_SIZE + 24);
}
fn sf2_pbag_gen(ctx, i) {
    return sf2_u16(Sf2Ctx_pbag_ptr(ctx), Sf2Ctx_pbag_len(ctx),
        i * N_SF2_BAG_SIZE);
}
fn sf2_inst_bag(ctx, i) {
    return sf2_u16(Sf2Ctx_inst_ptr(ctx), Sf2Ctx_inst_len(ctx),
        i * N_SF2_INST_SIZE + 20);
}
fn sf2_ibag_gen(ctx, i) {
    return sf2_u16(Sf2Ctx_ibag_ptr(ctx), Sf2Ctx_ibag_len(ctx),
        i * N_SF2_BAG_SIZE);
}
# shdr u32 field at byte offset `field` (20 start, 24 end, 28 loop_start, 32 loop_end, 36 rate)
fn sf2_shdr_u32(ctx, i, field) {
    return sf2_u32(Sf2Ctx_shdr_ptr(ctx), Sf2Ctx_shdr_len(ctx),
        i * N_SF2_SHDR_SIZE + field);
}
fn sf2_shdr_pitch(ctx, i) {
    return sf2_u8(Sf2Ctx_shdr_ptr(ctx), Sf2Ctx_shdr_len(ctx),
        i * N_SF2_SHDR_SIZE + 40);
}
fn sf2_shdr_type(ctx, i) {
    return sf2_u16(Sf2Ctx_shdr_ptr(ctx), Sf2Ctx_shdr_len(ctx),
        i * N_SF2_SHDR_SIZE + 44);
}

# sf2_spend(ctx) -> 1 while the walk is inside its work budget, 0 once it is spent.
fn sf2_spend(ctx) {
    var w = Sf2Ctx_work_left(ctx) - 1;
    Sf2Ctx_set_work_left(ctx, w);
    if (w < 0) { return 0; }
    return 1;
}

# resolve one instrument bag: read igens, apply preset-range clamp, build a zone, add to inst_obj.
# Returns NIDHI_ERR_IMPORT once a budget is exhausted or an allocation is refused, which unwinds
# the whole walk.
fn sf2_do_ibag(ctx, inst_obj, ib) {
    var prange = Sf2Ctx_prange(ctx);
    var igen_n = Sf2Ctx_igen_n(ctx);
    var igen_start = sf2_ibag_gen(ctx, ib);
    var igen_end = igen_n;
    if (ib + 1 < Sf2Ctx_ibag_n(ctx)) { igen_end = sf2_ibag_gen(ctx, ib + 1); }

    var sample_id = 0 - 1;
    var kr_lo = 0;
    var kr_hi = 127;
    var vr_lo = 0;
    var vr_hi = 127;
    var root_override = 0 - 1;
    var sample_modes = 0;

    var iglim = igen_end;
    if (igen_n < iglim) { iglim = igen_n; }
    var gp = Sf2Ctx_igen_ptr(ctx);
    var ig = igen_start;
    while (ig < iglim) {
        if (sf2_spend(ctx) == 0) { return NIDHI_ERR_IMPORT; }
        var at = gp + ig * N_SF2_GEN_SIZE;
        var ioper = sf2_le16(at);
        var iamt = sf2_le16s(at + 2);
        if (ioper == 53) { sample_id = iamt & 0xFFFF; }
        if (ioper == 43) { kr_lo = sf2_amt_lo(iamt); kr_hi = sf2_amt_hi(iamt); }
        if (ioper == 44) { vr_lo = sf2_amt_lo(iamt); vr_hi = sf2_amt_hi(iamt); }
        if (ioper == 58) { var k = iamt & 0xFF; if (k <= 127) { root_override = k; } }
        if (ioper == 54) { sample_modes = iamt & 0xFFFF; }
        ig = ig + 1;
    }

    if (sample_id < 0) { return 0; }
    var shdr_lim = Sf2Ctx_shdr_n(ctx) - 1;
    if (shdr_lim < 0) { shdr_lim = 0; }
    if (sample_id >= shdr_lim) { return 0; }
    if ((sf2_shdr_type(ctx, sample_id) & 0x8000) != 0) { return 0; }

    var root_key = sf2_shdr_pitch(ctx, sample_id);
    if (root_override >= 0) { root_key = root_override; }

    var lm = sample_modes & 3;
    var loop_mode = LOOP_ONESHOT;
    if (lm == 1) { loop_mode = LOOP_FORWARD; }
    if (lm == 2) { loop_mode = LOOP_FORWARD; }
    if (lm == 3) { loop_mode = LOOP_SUSTAIN; }

    var fk_lo = kr_lo;
    var fk_hi = kr_hi;
    if (Sf2PRange_have_pk(prange) == 1) {
        if (Sf2PRange_pk_lo(prange) > fk_lo) { fk_lo = Sf2PRange_pk_lo(prange); }
        if (Sf2PRange_pk_hi(prange) < fk_hi) { fk_hi = Sf2PRange_pk_hi(prange); }
    }
    var fv_lo = vr_lo;
    var fv_hi = vr_hi;
    if (Sf2PRange_have_pv(prange) == 1) {
        if (Sf2PRange_pv_lo(prange) > fv_lo) { fv_lo = Sf2PRange_pv_lo(prange); }
        if (Sf2PRange_pv_hi(prange) < fv_hi) { fv_hi = Sf2PRange_pv_hi(prange); }
    }

    if (Sf2Ctx_zones_left(ctx) <= 0) { return NIDHI_ERR_IMPORT; }
    Sf2Ctx_set_zones_left(ctx, Sf2Ctx_zones_left(ctx) - 1);

    # One conversion per shdr, not one per (preset, pbag, ibag) triple. Sharing a SampleId
    # between zones is safe: nothing mutates a Sample after n_sample_bank_add, and
    # NZone_sample_id is only ever read.
    var start = sf2_shdr_u32(ctx, sample_id, 20);
    var memo = Sf2Ctx_memo(ctx);
    var sid = 0 - 1;
    if (sample_id < vec_len(memo)) { sid = vec_get(memo, sample_id); }
    if (sid < 0) {
        var end = sf2_shdr_u32(ctx, sample_id, 24);
        var pcm = sf2_pcm16_to_f32(Sf2Ctx_smpl_ptr(ctx), Sf2Ctx_smpl_len(ctx), start, end);
        if (pcm == 0) { return NIDHI_ERR_IMPORT; }
        var shoff = sample_id * N_SF2_SHDR_SIZE;
        var sname = sf2_name(Sf2Ctx_shdr_ptr(ctx), Sf2Ctx_shdr_len(ctx), shoff, 20);
        if (sname == 0) { return NIDHI_ERR_IMPORT; }
        # The constructors answer 0 on a refused allocation and bank_add a negative code; until
        # 2.3.0 nothing here could fail, so a refused NSample went on to NSample_set_name(0, ..).
        var sample = n_sample_from_mono(pcm, sf2_shdr_u32(ctx, sample_id, 36));
        if (sample <= 0) { return NIDHI_ERR_IMPORT; }
        sample = n_sample_with_name(sample, sname);
        sid = n_sample_bank_add(Sf2Ctx_bank(ctx), sample);
        if (sid < 0) { return NIDHI_ERR_IMPORT; }
        if (sample_id < vec_len(memo)) { vec_set(memo, sample_id, sid); }
    }

    # A refused zone or a refused zone-vec grow used to vanish: n_zone_new's 0 passed through the
    # builders, n_instrument_add_zone answered NIDHI_ERR_INVALID_PARAMETER / NIDHI_ERR_PLAYBACK,
    # and that result was discarded -- so the parse "succeeded" with the zone missing (a preset
    # whose only zone was refused disappeared from the result). Now the whole parse fails.
    var zone = n_zone_new(sid);
    zone = n_zone_with_key_range(zone, fk_lo, fk_hi);
    zone = n_zone_with_vel_range(zone, fv_lo, fv_hi);
    zone = n_zone_with_root_note(zone, root_key);
    if (loop_mode != LOOP_ONESHOT) {
        var ls = sf2_shdr_u32(ctx, sample_id, 28) - start;
        if (ls < 0) { ls = 0; }
        var le = sf2_shdr_u32(ctx, sample_id, 32) - start;
        if (le < 0) { le = 0; }
        zone = n_zone_with_loop(zone, loop_mode, ls, le);
    }
    if (zone <= 0) { return NIDHI_ERR_IMPORT; }
    if (n_instrument_add_zone(inst_obj, zone) < 0) { return NIDHI_ERR_IMPORT; }
    return 0;
}

# resolve one preset bag: find the referenced instrument + preset ranges, walk its ibags.
fn sf2_do_pbag(ctx, inst_obj, bi) {
    var pgen_n = Sf2Ctx_pgen_n(ctx);
    var gen_start = sf2_pbag_gen(ctx, bi);
    var gen_end = pgen_n;
    if (bi + 1 < Sf2Ctx_pbag_n(ctx)) { gen_end = sf2_pbag_gen(ctx, bi + 1); }

    var inst_index = 0 - 1;
    var prange = Sf2Ctx_prange(ctx);
    Sf2PRange_set_have_pk(prange, 0);
    Sf2PRange_set_have_pv(prange, 0);

    var glim = gen_end;
    if (pgen_n < glim) { glim = pgen_n; }
    var gp = Sf2Ctx_pgen_ptr(ctx);
    var g = gen_start;
    while (g < glim) {
        if (sf2_spend(ctx) == 0) { return NIDHI_ERR_IMPORT; }
        var at = gp + g * N_SF2_GEN_SIZE;
        var oper = sf2_le16(at);
        var amt = sf2_le16s(at + 2);
        if (oper == 41) { inst_index = amt & 0xFFFF; }
        if (oper == 43) {
            Sf2PRange_set_pk_lo(prange, sf2_amt_lo(amt));
            Sf2PRange_set_pk_hi(prange, sf2_amt_hi(amt));
            Sf2PRange_set_have_pk(prange, 1);
        }
        if (oper == 44) {
            Sf2PRange_set_pv_lo(prange, sf2_amt_lo(amt));
            Sf2PRange_set_pv_hi(prange, sf2_amt_hi(amt));
            Sf2PRange_set_have_pv(prange, 1);
        }
        g = g + 1;
    }

    if (inst_index < 0) { return 0; }
    var inst_lim = Sf2Ctx_inst_n(ctx) - 1;
    if (inst_lim < 0) { inst_lim = 0; }
    if (inst_index >= inst_lim) { return 0; }

    var ibag_start = sf2_inst_bag(ctx, inst_index);
    var ibag_end = sf2_inst_bag(ctx, inst_index + 1);
    var ib = ibag_start;
    while (ib < ibag_end) {
        if (ib >= Sf2Ctx_ibag_n(ctx)) { return 0; }
        if (sf2_spend(ctx) == 0) { return NIDHI_ERR_IMPORT; }
        var ir = sf2_do_ibag(ctx, inst_obj, ib);
        if (ir < 0) { return ir; }
        ib = ib + 1;
    }
    return 0;
}

# resolve all presets -> instruments -> zones. Fills the presets/instruments vecs + bank.
fn sf2_resolve(ctx, presets, instruments) {
    var ph_lim = Sf2Ctx_phdr_n(ctx) - 1;
    if (ph_lim < 0) { ph_lim = 0; }
    var pi = 0;
    while (pi < ph_lim) {
        var bag_start = sf2_phdr_bag(ctx, pi);
        var bag_end = sf2_phdr_bag(ctx, pi + 1);
        # A refused instrument returned 0, and n_instrument_zone_count(0) below read through it.
        var inst_obj = Sf2Ctx_spare_inst(ctx);
        if (inst_obj == 0) {
            inst_obj = n_instrument_new(0);
            if (inst_obj <= 0) { return NIDHI_ERR_IMPORT; }
            Sf2Ctx_set_spare_inst(ctx, inst_obj);
        }

        var bi = bag_start;
        var looping = 1;
        while (looping == 1) {
            if (bi >= bag_end) {
                looping = 0;
            } else {
                if (bi >= Sf2Ctx_pbag_n(ctx)) {
                    looping = 0;
                } else {
                    if (sf2_spend(ctx) == 0) { return NIDHI_ERR_IMPORT; }
                    var pr = sf2_do_pbag(ctx, inst_obj, bi);
                    if (pr < 0) { return pr; }
                    bi = bi + 1;
                }
            }
        }

        if (n_instrument_zone_count(inst_obj) > 0) {
            # One owned name, shared by the preset and its instrument (both immutable).
            var phoff = pi * N_SF2_PHDR_SIZE;
            var pname = sf2_name(Sf2Ctx_phdr_ptr(ctx), Sf2Ctx_phdr_len(ctx), phoff, 20);
            if (pname == 0) { return NIDHI_ERR_IMPORT; }
            NInstrument_set_name(inst_obj, pname);
            var preset = alloc(sizeof(Sf2Preset));
            if (preset == 0) { return NIDHI_ERR_IMPORT; }
            Sf2Preset_set_name(preset, pname);
            Sf2Preset_set_bank(preset, sf2_phdr_bank(ctx, pi));
            Sf2Preset_set_preset_number(preset, sf2_phdr_preset(ctx, pi));
            if (vec_push_a(default_alloc(), presets, preset) < 0) { return NIDHI_ERR_IMPORT; }
            if (vec_push_a(default_alloc(), instruments, inst_obj) < 0) { return NIDHI_ERR_IMPORT; }
            # This instrument is the preset's now; the next preset needs a fresh one.
            Sf2Ctx_set_spare_inst(ctx, 0);
        }
        pi = pi + 1;
    }
    return 0;
}

# parse(data, len) -> Sf2Result pointer, or a negative error code.
# All failures return NIDHI_ERR_IMPORT.
#
# These were 15 raw negative literals (-1..-3, -6..-15). Three of them were bit-identical
# to real codes from a DIFFERENT taxonomy -- -1 = NIDHI_ERR_SAMPLE_NOT_FOUND, -2 =
# NIDHI_ERR_INVALID_ZONE, -3 = NIDHI_ERR_INVALID_PARAMETER -- so handing a WAV to the SF2
# importer reported "invalid parameter" and a truncated file reported "sample not found".
# -6 meanwhile covered three unrelated conditions. rust-old returns NidhiError::ImportError
# for all 19 corresponding sites: ONE variant, so one code. NIDHI_ERR_IMPORT (-5) is
# precisely the value this parser never used.
#must_use
fn sf2_parse(data, len) {
    if (len < 12) { return NIDHI_ERR_IMPORT; }
    if (sf2_fourcc(data, len, 0) != N_CC_RIFF) { return NIDHI_ERR_IMPORT; }
    if (sf2_fourcc(data, len, 8) != N_CC_SFBK) { return NIDHI_ERR_IMPORT; }

    var smpl_ptr = 0;
    var smpl_len = 0;
    var smpl_found = 0;
    var pdta_ptr = 0;
    var pdta_len = 0;
    var pdta_found = 0;

    # top-level chunk scan over data[12..]
    var off = 12;
    while (off + 8 <= len) {
        var cid = sf2_fourcc(data, len, off);
        var csize = sf2_u32(data, len, off + 4);
        var cdata_start = off + 8;
        var cdata_end = cdata_start + csize;
        if (cdata_end > len) { return NIDHI_ERR_IMPORT; }
        if (cid == N_CC_LIST) {
            if (csize >= 4) {
                var list_type = sf2_fourcc(data, len, cdata_start);
                if (list_type == N_CC_SDTA) {
                    var soff = cdata_start + 4;
                    var subscan = 1;
                    while (subscan == 1) {
                        if (soff + 8 > cdata_end) {
                            subscan = 0;
                        } else {
                            var sid = sf2_fourcc(data, len, soff);
                            var ssize = sf2_u32(data, len, soff + 4);
                            var sdstart = soff + 8;
                            var sdend = sdstart + ssize;
                            if (sdend > cdata_end) {
                                return NIDHI_ERR_IMPORT;
                            } else {
                                if (sid == N_CC_SMPL) {
                                    smpl_ptr = data + sdstart;
                                    smpl_len = ssize;
                                    smpl_found = 1;
                                }
                                soff = sdend + (ssize & 1);
                            }
                        }
                    }
                }
                if (list_type == N_CC_PDTA) {
                    pdta_ptr = data + cdata_start + 4;
                    pdta_len = csize - 4;
                    pdta_found = 1;
                }
            }
        }
        off = cdata_end + (csize & 1);
    }

    if (smpl_found == 0) { return NIDHI_ERR_IMPORT; }
    if (pdta_found == 0) { return NIDHI_ERR_IMPORT; }

    # pdta sub-chunk scan
    var phdr_ptr = 0; var phdr_len = 0; var phdr_found = 0;
    var pbag_ptr = 0; var pbag_len = 0; var pbag_found = 0;
    var pgen_ptr = 0; var pgen_len = 0; var pgen_found = 0;
    var inst_ptr = 0; var inst_len = 0; var inst_found = 0;
    var ibag_ptr = 0; var ibag_len = 0; var ibag_found = 0;
    var igen_ptr = 0; var igen_len = 0; var igen_found = 0;
    var shdr_ptr = 0; var shdr_len = 0; var shdr_found = 0;

    var poff = 0;
    while (poff + 8 <= pdta_len) {
        var pid = sf2_fourcc(pdta_ptr, pdta_len, poff);
        var psize = sf2_u32(pdta_ptr, pdta_len, poff + 4);
        var pdstart = poff + 8;
        var pdend = pdstart + psize;
        if (pdend > pdta_len) {
            return NIDHI_ERR_IMPORT;
        } else {
            if (pid == N_CC_PHDR) { phdr_ptr = pdta_ptr + pdstart; phdr_len = psize; phdr_found = 1; }
            if (pid == N_CC_PBAG) { pbag_ptr = pdta_ptr + pdstart; pbag_len = psize; pbag_found = 1; }
            if (pid == N_CC_PGEN) { pgen_ptr = pdta_ptr + pdstart; pgen_len = psize; pgen_found = 1; }
            if (pid == N_CC_INST) { inst_ptr = pdta_ptr + pdstart; inst_len = psize; inst_found = 1; }
            if (pid == N_CC_IBAG) { ibag_ptr = pdta_ptr + pdstart; ibag_len = psize; ibag_found = 1; }
            if (pid == N_CC_IGEN) { igen_ptr = pdta_ptr + pdstart; igen_len = psize; igen_found = 1; }
            if (pid == N_CC_SHDR) { shdr_ptr = pdta_ptr + pdstart; shdr_len = psize; shdr_found = 1; }
            poff = pdend + (psize & 1);
        }
    }

    if (phdr_found == 0) { return NIDHI_ERR_IMPORT; }
    if (pbag_found == 0) { return NIDHI_ERR_IMPORT; }
    if (pgen_found == 0) { return NIDHI_ERR_IMPORT; }
    if (inst_found == 0) { return NIDHI_ERR_IMPORT; }
    if (ibag_found == 0) { return NIDHI_ERR_IMPORT; }
    if (igen_found == 0) { return NIDHI_ERR_IMPORT; }
    if (shdr_found == 0) { return NIDHI_ERR_IMPORT; }

    var presets = vec_new();
    if (presets == 0) { return NIDHI_ERR_IMPORT; }
    var instruments = vec_new();
    if (instruments == 0) { return NIDHI_ERR_IMPORT; }
    # n_sample_bank_new answers 0 on a refused allocation; a 0 bank reached the caller as the
    # result's bank when no zone was built, and n_sample_bank_add(0, ..) otherwise.
    var bank = n_sample_bank_new();
    if (bank <= 0) { return NIDHI_ERR_IMPORT; }

    var ctx = alloc(sizeof(Sf2Ctx));
    if (ctx == 0) { return NIDHI_ERR_IMPORT; }
    var prange = alloc(sizeof(Sf2PRange));
    if (prange == 0) { return NIDHI_ERR_IMPORT; }
    Sf2Ctx_set_zones_left(ctx, N_SF2_MAX_ZONES);
    Sf2Ctx_set_work_left(ctx, N_SF2_MAX_WORK);
    Sf2Ctx_set_prange(ctx, prange);
    Sf2Ctx_set_smpl_ptr(ctx, smpl_ptr);
    Sf2Ctx_set_smpl_len(ctx, smpl_len);
    Sf2Ctx_set_bank(ctx, bank);
    Sf2Ctx_set_phdr_ptr(ctx, phdr_ptr);
    Sf2Ctx_set_phdr_len(ctx, phdr_len);
    Sf2Ctx_set_phdr_n(ctx, phdr_len / N_SF2_PHDR_SIZE);
    Sf2Ctx_set_pbag_ptr(ctx, pbag_ptr);
    Sf2Ctx_set_pbag_len(ctx, pbag_len);
    Sf2Ctx_set_pbag_n(ctx, pbag_len / N_SF2_BAG_SIZE);
    Sf2Ctx_set_pgen_ptr(ctx, pgen_ptr);
    Sf2Ctx_set_pgen_len(ctx, pgen_len);
    Sf2Ctx_set_pgen_n(ctx, pgen_len / N_SF2_GEN_SIZE);
    Sf2Ctx_set_inst_ptr(ctx, inst_ptr);
    Sf2Ctx_set_inst_len(ctx, inst_len);
    Sf2Ctx_set_inst_n(ctx, inst_len / N_SF2_INST_SIZE);
    Sf2Ctx_set_ibag_ptr(ctx, ibag_ptr);
    Sf2Ctx_set_ibag_len(ctx, ibag_len);
    Sf2Ctx_set_ibag_n(ctx, ibag_len / N_SF2_BAG_SIZE);
    Sf2Ctx_set_igen_ptr(ctx, igen_ptr);
    Sf2Ctx_set_igen_len(ctx, igen_len);
    Sf2Ctx_set_igen_n(ctx, igen_len / N_SF2_GEN_SIZE);
    Sf2Ctx_set_shdr_ptr(ctx, shdr_ptr);
    Sf2Ctx_set_shdr_len(ctx, shdr_len);
    Sf2Ctx_set_shdr_n(ctx, shdr_len / N_SF2_SHDR_SIZE);
    Sf2Ctx_set_spare_inst(ctx, 0);

    # memo[shdr_index] = SampleId, -1 = not converted yet. A count past VEC_CAP_MAX is refused
    # by n_vec_with_cap (an error return), not by vec_push's capacity abort.
    var shdr_n = Sf2Ctx_shdr_n(ctx);
    var memo = n_vec_with_cap(shdr_n);
    if (memo == 0) { return NIDHI_ERR_IMPORT; }
    var mi = 0;
    while (mi < shdr_n) { vec_push(memo, 0 - 1); mi = mi + 1; }
    Sf2Ctx_set_memo(ctx, memo);

    var rr = sf2_resolve(ctx, presets, instruments);
    if (rr < 0) { return rr; }

    var result = alloc(sizeof(Sf2Result));
    if (result == 0) { return NIDHI_ERR_IMPORT; }
    Sf2Result_set_presets(result, presets);
    Sf2Result_set_instruments(result, instruments);
    Sf2Result_set_bank(result, bank);
    return result;
}

# --- sfz.cyr ---

# sfz.cyr -- SFZ text parser (v1 + v2 subset)
# Requires: alloc, vec, str (str_*), string, math (f64_*, f64_parse), byte ops (load8),
#           hashmap (map_new_str / map_get_or / map_set), sample, zone (n_zone_*),
#           instrument (n_instrument_*), envelope (n_adsr_config_from_seconds), loop_mode (LOOP_*)
#
# Ports rust-old/src/sfz.rs. Line-based, whitespace-tokenized, key=value opcodes. Unknown opcodes
# and malformed tokens are silently ignored. Strings are stdlib Str objects. Option<String> ->
# null pointer (0 = None); Option<u8> -> -1 sentinel. parse is infallible (always returns a file).
#
# Every string the parsed file KEEPS (sample, loop_mode, fil_type, cc param, default_path,
# includes) is an owned, NUL-terminated copy. They used to be views into the caller's input
# buffer: a host that reused its read buffer for the next file (the pattern the stdlib's
# file_read_whole_into recommends) found `sample=a.wav` reading back as the next file's bytes,
# and a filename handed to n_load_wav (a cstr API) ran on to the end of the SFZ text. The oracle
# copied every one of them into a String.

var SFZ_HDR_NONE    = 0 - 1;
var SFZ_HDR_CONTROL = 0;
var SFZ_HDR_GLOBAL  = 1;
var SFZ_HDR_GROUP   = 2;
var SFZ_HDR_REGION  = 3;
var SFZ_HDR_CURVE   = 4;

# Longest `default_path` honoured: Linux PATH_MAX. The prefix is joined onto the filename of
# every region, so its length multiplies into the heap: a 1.19 MB file carrying a 1 MB
# default_path and 8,000 one-letter regions asked for ~8 GB and segfaulted once alloc returned 0
# (5,000 regions: 4,055,809,968 bytes, 3,560 heap bytes per input byte). The oracle did the same
# join. A longer prefix cannot name an openable file anyway -- open(2) answers ENAMETOOLONG -- so
# an over-long `default_path=` is ignored like any other unusable value.
var N_SFZ_PATH_MAX = 4096;

# --- small helpers ---

# Byte length of the Unicode White_Space code point at p (n bytes readable), or 0.
#
# The oracle split with `str::split_whitespace` and trimmed with `str::trim`, and both use
# char::is_whitespace -- all 25 White_Space code points, not just space/tab/CR/LF. A form feed
# or an NBSP glued `<region>` to the next opcode here, and the region vanished. U+0009..U+000D, U+0020, U+0085, U+00A0, U+1680, U+2000..U+200A, U+2028, U+2029,
# U+202F, U+205F, U+3000. Every multi-byte form starts with a UTF-8 lead byte, which never occurs
# as a continuation byte, so a byte-wise scan of valid UTF-8 can only match on a char boundary.
# The oracle took &str, so it never saw invalid UTF-8; here such bytes are simply not whitespace.
fn n_sfz_ws_at(p, n) {
    if (n <= 0) { return 0; }
    var c = load8(p);
    if (c == 32) { return 1; }
    if (c >= 9) { if (c <= 13) { return 1; } }
    if (c == 194) {
        if (n < 2) { return 0; }
        var d = load8(p + 1);
        if (d == 133) { return 2; }
        if (d == 160) { return 2; }
        return 0;
    }
    if (c < 225) { return 0; }
    if (c > 227) { return 0; }
    if (n < 3) { return 0; }
    var b1 = load8(p + 1);
    var b2 = load8(p + 2);
    if (c == 225) {
        if (b1 == 154) { if (b2 == 128) { return 3; } }
        return 0;
    }
    if (c == 227) {
        if (b1 == 128) { if (b2 == 128) { return 3; } }
        return 0;
    }
    if (b1 == 128) {
        if (b2 >= 128) { if (b2 <= 138) { return 3; } }
        if (b2 == 168) { return 3; }
        if (b2 == 169) { return 3; }
        if (b2 == 175) { return 3; }
        return 0;
    }
    if (b1 == 129) { if (b2 == 159) { return 3; } }
    return 0;
}

# Byte length of a White_Space code point ENDING at p + n, or 0 (the right-hand half of trim).
fn n_sfz_ws_before(p, n) {
    if (n <= 0) { return 0; }
    if (n_sfz_ws_at(p + n - 1, 1) == 1) { return 1; }
    if (n >= 2) { if (n_sfz_ws_at(p + n - 2, 2) == 2) { return 2; } }
    if (n >= 3) { if (n_sfz_ws_at(p + n - 3, 3) == 3) { return 3; } }
    return 0;
}

# 1 if the n bytes at p spell exactly the NUL-terminated cstr.
fn n_sfz_span_eq(p, n, cstr) {
    if (n != strlen(cstr)) { return 0; }
    return memeq(p, cstr, n);
}

# 1 if the n bytes at p spell the lowercase cstr, ignoring ASCII case.
fn n_sfz_span_eq_nocase(p, n, cstr) {
    if (n != strlen(cstr)) { return 0; }
    var i = 0;
    while (i < n) {
        var c = load8(p + i);
        if (c >= 65) { if (c <= 90) { c = c + 32; } }
        if (c != load8(cstr + i)) { return 0; }
        i = i + 1;
    }
    return 1;
}

# An owned, NUL-terminated copy of n bytes at p, as a Str (0 on OOM).
fn n_sfz_own(p, n) {
    var buf = alloc(n + 1);
    if (buf == 0) { return 0; }
    memcpy(buf, p, n);
    store8(buf + n, 0);
    return str_new(buf, n);
}

# prefix + name as one owned, NUL-terminated Str (0 on OOM). str_cat does not terminate.
fn n_sfz_join(prefix, name) {
    var la = str_len(prefix);
    var lb = str_len(name);
    var buf = alloc(la + lb + 1);
    if (buf == 0) { return 0; }
    memcpy(buf, str_data(prefix), la);
    memcpy(buf + la, str_data(name), lb);
    store8(buf + la + lb, 0);
    return str_new(buf, la + lb);
}

# parse a signed decimal integer from a Str (Rust i32/i64 FromStr: optional leading +/-).
# Returns 1 + writes to out, or 0 (unparseable).
fn sfz_int(s, out) {
    var data = str_data(s);
    var len = str_len(s);
    if (len == 0) { return 0; }
    var i = 0;
    var neg = 0;
    var c0 = load8(data);
    if (c0 == 45) { neg = 1; i = 1; }
    if (c0 == 43) { i = 1; }
    var val = 0;
    var any = 0;
    while (i < len) {
        var c = load8(data + i);
        if (c < 48) { return 0; }
        if (c > 57) { return 0; }
        # Reject rather than wrap. Rust's parse::<i32>/<i64> returns Err on overflow; the
        # port accumulated into an i64 and silently wrapped, so `group=9223372036854775808`
        # became i64::MIN and reached vec_get as a negative index -> exit(1), and
        # `lovel=9223372036854775808` produced negative bounds that matched no note at all.
        if (val > 922337203685477580) { return 0; }
        val = val * 10 + (c - 48);
        if (val < 0) { return 0; }
        any = 1;
        i = i + 1;
    }
    if (any == 0) { return 0; }
    if (neg == 1) { val = 0 - val; }
    store64(out, val);
    return 1;
}

# parse an unsigned decimal integer with Rust's parse::<usize>() semantics on a 64-bit target:
# optional leading +, rejects -, accepts 0..=u64::MAX and rejects anything larger.
#
# Saturate, do not wrap. usize genuinely ACCEPTS values above i64::MAX (up to u64::MAX), so
# rejecting those would break parity in one direction; they clamp to i64::MAX, which every
# downstream range check then treats on its own terms. Values ABOVE u64::MAX are an Err in Rust
# and leave the field unchanged -- the port used to saturate those too, so
# `offset=99999999999999999999999` set an offset the oracle never set. The cut is decided on the
# digit string (more than 20 significant digits, or 20 that compare above "18446744073709551615"),
# because u64::MAX itself does not fit the i64 accumulator.
fn sfz_uint(s, out) {
    var data = str_data(s);
    var len = str_len(s);
    if (len == 0) { return 0; }
    var i = 0;
    if (load8(data) == 43) { i = 1; }
    var val = 0;
    var any = 0;
    var over = 0;
    var sig = 0;
    var sig_at = 0 - 1;
    while (i < len) {
        var c = load8(data + i);
        if (c < 48) { return 0; }
        if (c > 57) { return 0; }
        if (sig == 0) { if (c != 48) { sig_at = i; } }
        if (sig_at >= 0) { sig = sig + 1; }
        if (val > 922337203685477580) { over = 1; }
        if (over == 0) {
            val = val * 10 + (c - 48);
            if (val < 0) { over = 1; }
        }
        any = 1;
        i = i + 1;
    }
    if (any == 0) { return 0; }
    if (sig > 20) { return 0; }
    if (sig == 20) {
        var umax = "18446744073709551615";
        var k = 0;
        while (k < 20) {
            var dc = load8(data + sig_at + k);
            var mc = load8(umax + k);
            if (dc > mc) { return 0; }
            if (dc < mc) { k = 20; }
            k = k + 1;
        }
    }
    if (over == 1) { val = 9223372036854775807; }
    store64(out, val);
    return 1;
}

# parse a u8 (Rust parse::<u8>: unsigned, 0..=255). Returns 0 (unparseable) if out of range.
fn sfz_u8(s, out) {
    if (sfz_uint(s, out) == 0) { return 0; }
    # The `< 0` half was missing: sfz_uint used to wrap, so a huge token arrived negative
    # and sailed past a `> 255` test unchallenged.
    if (load64(out) < 0) { return 0; }
    if (load64(out) > 255) { return 0; }
    return 1;
}

# parse a u32 (Rust parse::<u32>: 0..=4294967295).
fn sfz_u32(s, out) {
    if (sfz_uint(s, out) == 0) { return 0; }
    if (load64(out) < 0) { return 0; }
    if (load64(out) > 4294967295) { return 0; }
    return 1;
}

# parse an i32 (Rust parse::<i32>: -2147483648..=2147483647).
fn sfz_i32(s, out) {
    if (sfz_int(s, out) == 0) { return 0; }
    if (load64(out) < (0 - 2147483648)) { return 0; }
    if (load64(out) > 2147483647) { return 0; }
    return 1;
}

# n_sfz_parse_span(p, n, out) -> 1 and the f64 bits of the validated token p[0..n) in out, or 0.
#
# The stdlib's span form, f64_parse_n, only arrived in cyrius 6.7.9, and nidhi's consumers may be
# on 6.7.5. f64_parse reads a NUL-terminated string with the same grammar and rounding (on 6.7.18
# it IS f64_parse_n over the span up to the NUL), and a validated token holds no NUL, so the bits
# are identical. The copy goes on the stack for an ordinary token. Only a token of 64 bytes or more,
# which takes a hostile file, copies to the heap.
fn n_sfz_parse_span(p, n, out) {
    var buf[64];
    if (n < 64) {
        memcpy(&buf, p, n);
        store8(&buf + n, 0);
        store64(out, f64_parse(&buf));
        return 1;
    }
    var h = alloc(n + 1);
    if (h == 0) { return 0; }
    memcpy(h, p, n);
    store8(h + n, 0);
    store64(out, f64_parse(h));
    return 1;
}

# parse a Str as f64. Returns 1 + writes bits to out, or 0.
#
# f64_parse_ok stops at the first character it cannot use and reports success on the
# prefix, so every float opcode used to accept trailing garbage that Rust's
# parse::<f32>() rejects outright. That is not cosmetic: `cutoff=1000Hz` low-passed
# every note at 1 kHz where the oracle disables the filter entirely, and
# `ampeg_attack=10ms` became attack_samples=441000 -- a TEN-SECOND fade-in on every
# note where the oracle applies no per-zone envelope at all.
#
# Validate the WHOLE token first: [+-]? ( digits [. digits?] | . digits ) ( [eE] [+-]? digits )?
# Rust also accepts inf / infinity / nan, case-insensitively, so those pass through.
fn sfz_f64(s, out) {
    var len = str_len(s);
    if (len == 0) { return 0; }
    var data = str_data(s);
    var i = 0;
    var c0 = load8(data);
    if (c0 == 43) { i = 1; }
    if (c0 == 45) { i = 1; }
    if (i >= len) { return 0; }

    # inf / infinity / nan (case-insensitive) -- Rust accepts all three. Compared in place and
    # parsed through n_sfz_parse_span: this path used to build three lowercased heap copies and a
    # heap NUL-terminated copy of every float token, all of it never reclaimed.
    var rp = data + i;
    var rn = len - i;
    if (n_sfz_span_eq_nocase(rp, rn, "inf") == 1) { return n_sfz_parse_span(data, len, out); }
    if (n_sfz_span_eq_nocase(rp, rn, "infinity") == 1) { return n_sfz_parse_span(data, len, out); }
    if (n_sfz_span_eq_nocase(rp, rn, "nan") == 1) { return n_sfz_parse_span(data, len, out); }

    var digits = 0;
    while (i < len) {
        var c = load8(data + i);
        if (c < 48) { break; }
        if (c > 57) { break; }
        digits = digits + 1;
        i = i + 1;
    }
    if (i < len) {
        if (load8(data + i) == 46) {
            i = i + 1;
            while (i < len) {
                var cf = load8(data + i);
                if (cf < 48) { break; }
                if (cf > 57) { break; }
                digits = digits + 1;
                i = i + 1;
            }
        }
    }
    if (digits == 0) { return 0; }
    if (i < len) {
        var ce = load8(data + i);
        if (ce != 101) { if (ce != 69) { return 0; } }
        i = i + 1;
        if (i < len) {
            var cs = load8(data + i);
            if (cs == 43) { i = i + 1; }
            if (cs == 45) { i = i + 1; }
        }
        var edig = 0;
        while (i < len) {
            var cx = load8(data + i);
            if (cx < 48) { return 0; }
            if (cx > 57) { return 0; }
            edig = edig + 1;
            i = i + 1;
        }
        if (edig == 0) { return 0; }
    }
    if (i != len) { return 0; }
    # The whole token has been validated, so parsing exactly this span returns what f64_parse_ok
    # on a heap NUL-terminated copy did, bit for bit.
    if (n_sfz_parse_span(data, len, out) == 0) { return 0; }
    # Normalise -0.0 to +0.0. sfz_inh decides "was this opcode explicitly set?" by comparing
    # the stored value against the default as a RAW BIT PATTERN, and -0.0 is 0x8000...0, which
    # is not bit-equal to +0.0. The oracle compared with `== 0.0`, where -0.0 IS equal -- so
    # `<global> volume=-6` + `<region> volume=-0` inherited -6.0 in Rust and stayed at -0.0
    # here. Same trap at the has_ampeg / has_fileg gates, where `ampeg_attack=-0` made the port
    # wire a 1-sample-release ADSR the oracle never wired at all.
    # Normalising is behaviour-preserving downstream: -0.0 and +0.0 give the same amplitude,
    # the same pan, and the same envelope.
    if (load64(out) == 0x8000000000000000) { store64(out, 0); }
    return 1;
}

# --- parse_note_or_number(s) -> MIDI 0..127, or -1 (None) ---
#
# Two parse widths, both the oracle's (rust-old/src/sfz.rs parse_note_or_number):
#   * the numeric attempt is `s.parse::<u8>()`. It was a SIGNED parse here, so "-0" came back as
#     note 0 where u8 rejects the '-' and the note-name path then answers None: `hikey=-0` set
#     hikey 0 (a zone that matches only note 0) instead of leaving 127.
#   * the octave is `parse::<i32>()`. It was an i64 parse, and `(octave + 1) * 12` wrapped, so
#     `c4611686018427387903` came back as note 0 and `e...` as note 4 -- nonsense accepted as a
#     key. With the octave held to i32 the product cannot overflow an i64, so the range test
#     below sees the true value. (The oracle computed in i32: in a release build an octave near
#     2^30 wrapped there instead, and a debug build panicked. Those inputs return None here.)
#must_use
fn n_sfz_note_or_num(value) {
    var o[8];
    if (sfz_u8(value, &o) == 1) { return load64(&o); }
    var data = str_data(value);
    var len = str_len(value);
    if (len == 0) { return 0 - 1; }
    var c0 = load8(data);
    if (c0 >= 65) { if (c0 <= 90) { c0 = c0 + 32; } }
    var base = 0 - 1;
    if (c0 == 99) { base = 0; }
    if (c0 == 100) { base = 2; }
    if (c0 == 101) { base = 4; }
    if (c0 == 102) { base = 5; }
    if (c0 == 103) { base = 7; }
    if (c0 == 97) { base = 9; }
    if (c0 == 98) { base = 11; }
    if (base < 0) { return 0 - 1; }
    var idx = 1;
    var accidental = 0;
    if (idx < len) {
        var c1 = load8(data + idx);
        if (c1 == 35) { accidental = 1; idx = idx + 1; }
        else {
            if (c1 == 115) { accidental = 1; idx = idx + 1; }
            else {
                if (c1 == 98) {
                    if (idx + 1 < len) {
                        var c2 = load8(data + idx + 1);
                        if (c2 >= 48) { if (c2 <= 57) { accidental = 0 - 1; idx = idx + 1; } }
                    }
                }
            }
        }
    }
    # A stack Str over the octave digits: nothing here outlives the call.
    var os[16];
    store64(&os, data + idx);
    store64(&os + 8, len - idx);
    if (sfz_i32(&os, &o) == 0) { return 0 - 1; }
    var octave = load64(&o);
    var midi = (octave + 1) * 12 + base + accidental;
    if (midi < 0) { return 0 - 1; }
    if (midi > 127) { return 0 - 1; }
    return midi;
}

# --- SfzRegion (39 fields: the oracle's 37, then 2.2.2's seq_length and seq_position) ---
#derive(accessors)
struct NSfzRegion {
    sample;
    lokey;
    hikey;
    lovel;
    hivel;
    pitch_keycenter;
    tune;
    volume;
    pan;
    loop_mode;
    loop_start;
    loop_end;
    group;
    ampeg_attack;
    ampeg_decay;
    ampeg_sustain;
    ampeg_release;
    cutoff;
    fil_veltrack;
    fileg_attack;
    fileg_decay;
    fileg_sustain;
    fileg_release;
    fileg_depth;
    transpose;
    offset;
    end;
    resonance;
    fil_type;
    key;
    pitchlfo_freq;
    pitchlfo_depth;
    fillfo_freq;
    fillfo_depth;
    fil_keytrack;
    output;
    cc_modulations;
    seq_length;
    seq_position;
}

# a cc modulation entry: (param Str, cc int, depth f64)
#derive(accessors)
struct NSfzCC { param; cc; depth; }

#must_use
#
# -> the region, or 0 when an allocation is refused (it used to write the defaults through 0).
fn n_sfz_region_new() {
    var r = alloc(sizeof(NSfzRegion));
    if (r == 0) { return 0; }
    var cc = vec_new();
    if (cc == 0) { return 0; }
    var f100 = f64_from(100);
    NSfzRegion_set_sample(r, 0);
    NSfzRegion_set_lokey(r, 0);
    NSfzRegion_set_hikey(r, 127);
    NSfzRegion_set_lovel(r, 1);
    NSfzRegion_set_hivel(r, 127);
    NSfzRegion_set_pitch_keycenter(r, 60);
    NSfzRegion_set_tune(r, 0);
    NSfzRegion_set_volume(r, 0);
    NSfzRegion_set_pan(r, 0);
    NSfzRegion_set_loop_mode(r, 0);
    NSfzRegion_set_loop_start(r, 0);
    NSfzRegion_set_loop_end(r, 0);
    NSfzRegion_set_group(r, 0);
    # 0 = unset, so <group>/<global> inheritance can tell; to_zones maps 0 to SFZ's default of 1.
    NSfzRegion_set_seq_length(r, 0);
    NSfzRegion_set_seq_position(r, 0);
    NSfzRegion_set_ampeg_attack(r, 0);
    NSfzRegion_set_ampeg_decay(r, 0);
    NSfzRegion_set_ampeg_sustain(r, f100);
    NSfzRegion_set_ampeg_release(r, 0);
    NSfzRegion_set_cutoff(r, 0);
    NSfzRegion_set_fil_veltrack(r, 0);
    NSfzRegion_set_fileg_attack(r, 0);
    NSfzRegion_set_fileg_decay(r, 0);
    NSfzRegion_set_fileg_sustain(r, f100);
    NSfzRegion_set_fileg_release(r, 0);
    NSfzRegion_set_fileg_depth(r, 0);
    NSfzRegion_set_transpose(r, 0);
    NSfzRegion_set_offset(r, 0);
    NSfzRegion_set_end(r, 0);
    NSfzRegion_set_resonance(r, 0);
    NSfzRegion_set_fil_type(r, 0);
    NSfzRegion_set_key(r, 0 - 1);
    NSfzRegion_set_pitchlfo_freq(r, 0);
    NSfzRegion_set_pitchlfo_depth(r, 0);
    NSfzRegion_set_fillfo_freq(r, 0);
    NSfzRegion_set_fillfo_depth(r, 0);
    NSfzRegion_set_fil_keytrack(r, 0);
    NSfzRegion_set_output(r, 0);
    NSfzRegion_set_cc_modulations(r, cc);
    return r;
}

# Store an owned copy of `value` as the region's sample (which 0), loop_mode (1) or fil_type (2).
# -> 0, or NIDHI_ERR_IMPORT with the field unchanged when the copy is refused.
fn n_sfz_set_str(r, which, value) {
    var c = n_sfz_own(str_data(value), str_len(value));
    if (c == 0) { return NIDHI_ERR_IMPORT; }
    if (which == 0) { NSfzRegion_set_sample(r, c); }
    if (which == 1) { NSfzRegion_set_loop_mode(r, c); }
    if (which == 2) { NSfzRegion_set_fil_type(r, c); }
    return 0;
}

# apply one opcode (key, value are Str). Numeric parse failure leaves the field unchanged.
# Neither key nor value is retained: the string-valued opcodes store an owned copy, so a caller
# may pass views into a buffer it later reuses (n_sfz_parse passes stack views into its input).
# The numeric scratch is a stack slot; it was an alloc(8) per opcode, never reclaimed.
# loop_start / loop_end / offset / end parse as usize, as the oracle does (sfz.rs:265-272,
# 345-354), not u32: a value in (u32::MAX, u64::MAX] is accepted there and was refused here.
#
# -> 0, or NIDHI_ERR_IMPORT when the copy of a string value, or a cc entry, cannot be allocated.
# A refused copy used to store 0 -- an opcode silently dropped, so `sample=` vanished and the
# region was skipped -- and a refused cc entry was written through 0.
fn n_sfz_apply_opcode(r, key, value) {
    var ob[8];
    var o = &ob;
    if (str_eq_cstr(key, "sample") == 1) { return n_sfz_set_str(r, 0, value); }
    if (str_eq_cstr(key, "lokey") == 1) { var n = n_sfz_note_or_num(value); if (n >= 0) { NSfzRegion_set_lokey(r, n); } return 0; }
    if (str_eq_cstr(key, "hikey") == 1) { var n = n_sfz_note_or_num(value); if (n >= 0) { NSfzRegion_set_hikey(r, n); } return 0; }
    if (str_eq_cstr(key, "key") == 1) { var n = n_sfz_note_or_num(value); if (n >= 0) { NSfzRegion_set_key(r, n); } return 0; }
    if (str_eq_cstr(key, "lovel") == 1) { if (sfz_u8(value, o) == 1) { NSfzRegion_set_lovel(r, load64(o)); } return 0; }
    if (str_eq_cstr(key, "hivel") == 1) { if (sfz_u8(value, o) == 1) { NSfzRegion_set_hivel(r, load64(o)); } return 0; }
    if (str_eq_cstr(key, "pitch_keycenter") == 1) { var n = n_sfz_note_or_num(value); if (n >= 0) { NSfzRegion_set_pitch_keycenter(r, n); } return 0; }
    if (str_eq_cstr(key, "tune") == 1) { if (sfz_i32(value, o) == 1) { NSfzRegion_set_tune(r, load64(o)); } return 0; }
    if (str_eq_cstr(key, "volume") == 1) { if (sfz_f64(value, o) == 1) { NSfzRegion_set_volume(r, load64(o)); } return 0; }
    if (str_eq_cstr(key, "pan") == 1) { if (sfz_f64(value, o) == 1) { NSfzRegion_set_pan(r, f64_min(f64_max(load64(o), f64_neg(f64_from(100))), f64_from(100))); } return 0; }
    if (str_eq_cstr(key, "loop_mode") == 1) { return n_sfz_set_str(r, 1, value); }
    if (str_eq_cstr(key, "loopmode") == 1) { return n_sfz_set_str(r, 1, value); }
    if (str_eq_cstr(key, "loop_start") == 1) { if (sfz_uint(value, o) == 1) { NSfzRegion_set_loop_start(r, load64(o)); } return 0; }
    if (str_eq_cstr(key, "loopstart") == 1) { if (sfz_uint(value, o) == 1) { NSfzRegion_set_loop_start(r, load64(o)); } return 0; }
    if (str_eq_cstr(key, "loop_end") == 1) { if (sfz_uint(value, o) == 1) { NSfzRegion_set_loop_end(r, load64(o)); } return 0; }
    if (str_eq_cstr(key, "loopend") == 1) { if (sfz_uint(value, o) == 1) { NSfzRegion_set_loop_end(r, load64(o)); } return 0; }
    # seq_length / seq_position are SFZ's round-robin. The oracle wrote seq_position into `group`,
    # which gave each region of a round-robin set its OWN group, so the set could never cycle.
    # See docs/adr/0012-round-robin-plays.md.
    if (str_eq_cstr(key, "seq_length") == 1) { if (sfz_u32(value, o) == 1) { NSfzRegion_set_seq_length(r, load64(o)); } return 0; }
    if (str_eq_cstr(key, "seq_position") == 1) { if (sfz_u32(value, o) == 1) { NSfzRegion_set_seq_position(r, load64(o)); } return 0; }
    if (str_eq_cstr(key, "group") == 1) { if (sfz_u32(value, o) == 1) { NSfzRegion_set_group(r, load64(o)); } return 0; }
    if (str_eq_cstr(key, "ampeg_attack") == 1) { if (sfz_f64(value, o) == 1) { NSfzRegion_set_ampeg_attack(r, f64_max(load64(o), 0)); } return 0; }
    if (str_eq_cstr(key, "ampeg_decay") == 1) { if (sfz_f64(value, o) == 1) { NSfzRegion_set_ampeg_decay(r, f64_max(load64(o), 0)); } return 0; }
    if (str_eq_cstr(key, "ampeg_sustain") == 1) { if (sfz_f64(value, o) == 1) { NSfzRegion_set_ampeg_sustain(r, f64_min(f64_max(load64(o), 0), f64_from(100))); } return 0; }
    if (str_eq_cstr(key, "ampeg_release") == 1) { if (sfz_f64(value, o) == 1) { NSfzRegion_set_ampeg_release(r, f64_max(load64(o), 0)); } return 0; }
    if (str_eq_cstr(key, "cutoff") == 1) { if (sfz_f64(value, o) == 1) { NSfzRegion_set_cutoff(r, f64_max(load64(o), 0)); } return 0; }
    if (str_eq_cstr(key, "fil_veltrack") == 1) { if (sfz_f64(value, o) == 1) { NSfzRegion_set_fil_veltrack(r, load64(o)); } return 0; }
    if (str_eq_cstr(key, "fileg_attack") == 1) { if (sfz_f64(value, o) == 1) { NSfzRegion_set_fileg_attack(r, f64_max(load64(o), 0)); } return 0; }
    if (str_eq_cstr(key, "fileg_decay") == 1) { if (sfz_f64(value, o) == 1) { NSfzRegion_set_fileg_decay(r, f64_max(load64(o), 0)); } return 0; }
    if (str_eq_cstr(key, "fileg_sustain") == 1) { if (sfz_f64(value, o) == 1) { NSfzRegion_set_fileg_sustain(r, f64_min(f64_max(load64(o), 0), f64_from(100))); } return 0; }
    if (str_eq_cstr(key, "fileg_release") == 1) { if (sfz_f64(value, o) == 1) { NSfzRegion_set_fileg_release(r, f64_max(load64(o), 0)); } return 0; }
    if (str_eq_cstr(key, "fileg_depth") == 1) { if (sfz_f64(value, o) == 1) { NSfzRegion_set_fileg_depth(r, f64_min(f64_max(load64(o), f64_neg(f64_from(9600))), f64_from(9600))); } return 0; }
    if (str_eq_cstr(key, "transpose") == 1) { if (sfz_i32(value, o) == 1) { NSfzRegion_set_transpose(r, load64(o)); } return 0; }
    if (str_eq_cstr(key, "offset") == 1) { if (sfz_uint(value, o) == 1) { NSfzRegion_set_offset(r, load64(o)); } return 0; }
    if (str_eq_cstr(key, "end") == 1) { if (sfz_uint(value, o) == 1) { NSfzRegion_set_end(r, load64(o)); } return 0; }
    if (str_eq_cstr(key, "resonance") == 1) { if (sfz_f64(value, o) == 1) { NSfzRegion_set_resonance(r, f64_max(load64(o), 0)); } return 0; }
    if (str_eq_cstr(key, "fil_resonance") == 1) { if (sfz_f64(value, o) == 1) { NSfzRegion_set_resonance(r, f64_max(load64(o), 0)); } return 0; }
    if (str_eq_cstr(key, "fil_type") == 1) { return n_sfz_set_str(r, 2, value); }
    if (str_eq_cstr(key, "filtype") == 1) { return n_sfz_set_str(r, 2, value); }
    if (str_eq_cstr(key, "pitchlfo_freq") == 1) { if (sfz_f64(value, o) == 1) { NSfzRegion_set_pitchlfo_freq(r, f64_max(load64(o), 0)); } return 0; }
    if (str_eq_cstr(key, "pitchlfo_depth") == 1) { if (sfz_f64(value, o) == 1) { NSfzRegion_set_pitchlfo_depth(r, load64(o)); } return 0; }
    if (str_eq_cstr(key, "fillfo_freq") == 1) { if (sfz_f64(value, o) == 1) { NSfzRegion_set_fillfo_freq(r, f64_max(load64(o), 0)); } return 0; }
    if (str_eq_cstr(key, "fillfo_depth") == 1) { if (sfz_f64(value, o) == 1) { NSfzRegion_set_fillfo_depth(r, load64(o)); } return 0; }
    if (str_eq_cstr(key, "fil_keytrack") == 1) { if (sfz_f64(value, o) == 1) { NSfzRegion_set_fil_keytrack(r, f64_min(f64_max(load64(o), 0), f64_from(1200))); } return 0; }
    if (str_eq_cstr(key, "output") == 1) { if (sfz_u8(value, o) == 1) { NSfzRegion_set_output(r, load64(o)); } return 0; }

    # CC modulation fallback: key contains "_oncc"
    var pos = str_index_of_cstr(key, "_oncc");
    if (pos >= 0) {
        var cs[16];
        store64(&cs, str_data(key) + pos + 5);
        store64(&cs + 8, str_len(key) - pos - 5);
        var cc_out[8];
        if (sfz_u8(&cs, &cc_out) == 1) {
            if (sfz_f64(value, o) == 1) {
                var m = alloc(sizeof(NSfzCC));
                if (m == 0) { return NIDHI_ERR_IMPORT; }
                var param = n_sfz_own(str_data(key), pos);
                if (param == 0) { return NIDHI_ERR_IMPORT; }
                NSfzCC_set_param(m, param);
                NSfzCC_set_cc(m, load64(&cc_out));
                NSfzCC_set_depth(m, load64(o));
                if (vec_push_a(default_alloc(), NSfzRegion_cc_modulations(r), m) < 0) { return NIDHI_ERR_IMPORT; }
            }
        }
        return 0;
    }
    return 0;
}

# inherit a numeric field from parent when self is at `def` and parent differs.
fn sfz_inh(self_v, parent_v, def) {
    if (self_v == def) { if (parent_v != def) { return parent_v; } }
    return self_v;
}

# inherit_from(parent): global->group->region. Self keeps any non-default it already has.
fn n_sfz_inherit_from(self, parent) {
    var f100 = f64_from(100);
    # Option/pointer fields
    if (NSfzRegion_sample(self) == 0) { NSfzRegion_set_sample(self, NSfzRegion_sample(parent)); }
    if (NSfzRegion_loop_mode(self) == 0) { NSfzRegion_set_loop_mode(self, NSfzRegion_loop_mode(parent)); }
    if (NSfzRegion_fil_type(self) == 0) { NSfzRegion_set_fil_type(self, NSfzRegion_fil_type(parent)); }
    if (NSfzRegion_key(self) < 0) { NSfzRegion_set_key(self, NSfzRegion_key(parent)); }
    if (vec_len(NSfzRegion_cc_modulations(self)) == 0) {
        if (vec_len(NSfzRegion_cc_modulations(parent)) > 0) {
            NSfzRegion_set_cc_modulations(self, NSfzRegion_cc_modulations(parent));
        }
    }
    # numeric fields
    NSfzRegion_set_lokey(self, sfz_inh(NSfzRegion_lokey(self), NSfzRegion_lokey(parent), 0));
    NSfzRegion_set_hikey(self, sfz_inh(NSfzRegion_hikey(self), NSfzRegion_hikey(parent), 127));
    NSfzRegion_set_lovel(self, sfz_inh(NSfzRegion_lovel(self), NSfzRegion_lovel(parent), 1));
    NSfzRegion_set_hivel(self, sfz_inh(NSfzRegion_hivel(self), NSfzRegion_hivel(parent), 127));
    NSfzRegion_set_pitch_keycenter(self, sfz_inh(NSfzRegion_pitch_keycenter(self), NSfzRegion_pitch_keycenter(parent), 60));
    NSfzRegion_set_tune(self, sfz_inh(NSfzRegion_tune(self), NSfzRegion_tune(parent), 0));
    NSfzRegion_set_volume(self, sfz_inh(NSfzRegion_volume(self), NSfzRegion_volume(parent), 0));
    NSfzRegion_set_pan(self, sfz_inh(NSfzRegion_pan(self), NSfzRegion_pan(parent), 0));
    NSfzRegion_set_loop_start(self, sfz_inh(NSfzRegion_loop_start(self), NSfzRegion_loop_start(parent), 0));
    NSfzRegion_set_loop_end(self, sfz_inh(NSfzRegion_loop_end(self), NSfzRegion_loop_end(parent), 0));
    NSfzRegion_set_group(self, sfz_inh(NSfzRegion_group(self), NSfzRegion_group(parent), 0));
    NSfzRegion_set_seq_length(self, sfz_inh(NSfzRegion_seq_length(self), NSfzRegion_seq_length(parent), 0));
    NSfzRegion_set_seq_position(self, sfz_inh(NSfzRegion_seq_position(self), NSfzRegion_seq_position(parent), 0));
    NSfzRegion_set_ampeg_attack(self, sfz_inh(NSfzRegion_ampeg_attack(self), NSfzRegion_ampeg_attack(parent), 0));
    NSfzRegion_set_ampeg_decay(self, sfz_inh(NSfzRegion_ampeg_decay(self), NSfzRegion_ampeg_decay(parent), 0));
    NSfzRegion_set_ampeg_sustain(self, sfz_inh(NSfzRegion_ampeg_sustain(self), NSfzRegion_ampeg_sustain(parent), f100));
    NSfzRegion_set_ampeg_release(self, sfz_inh(NSfzRegion_ampeg_release(self), NSfzRegion_ampeg_release(parent), 0));
    NSfzRegion_set_cutoff(self, sfz_inh(NSfzRegion_cutoff(self), NSfzRegion_cutoff(parent), 0));
    NSfzRegion_set_fil_veltrack(self, sfz_inh(NSfzRegion_fil_veltrack(self), NSfzRegion_fil_veltrack(parent), 0));
    NSfzRegion_set_fileg_attack(self, sfz_inh(NSfzRegion_fileg_attack(self), NSfzRegion_fileg_attack(parent), 0));
    NSfzRegion_set_fileg_decay(self, sfz_inh(NSfzRegion_fileg_decay(self), NSfzRegion_fileg_decay(parent), 0));
    NSfzRegion_set_fileg_sustain(self, sfz_inh(NSfzRegion_fileg_sustain(self), NSfzRegion_fileg_sustain(parent), f100));
    NSfzRegion_set_fileg_release(self, sfz_inh(NSfzRegion_fileg_release(self), NSfzRegion_fileg_release(parent), 0));
    NSfzRegion_set_fileg_depth(self, sfz_inh(NSfzRegion_fileg_depth(self), NSfzRegion_fileg_depth(parent), 0));
    NSfzRegion_set_transpose(self, sfz_inh(NSfzRegion_transpose(self), NSfzRegion_transpose(parent), 0));
    NSfzRegion_set_offset(self, sfz_inh(NSfzRegion_offset(self), NSfzRegion_offset(parent), 0));
    NSfzRegion_set_end(self, sfz_inh(NSfzRegion_end(self), NSfzRegion_end(parent), 0));
    NSfzRegion_set_resonance(self, sfz_inh(NSfzRegion_resonance(self), NSfzRegion_resonance(parent), 0));
    NSfzRegion_set_pitchlfo_freq(self, sfz_inh(NSfzRegion_pitchlfo_freq(self), NSfzRegion_pitchlfo_freq(parent), 0));
    NSfzRegion_set_pitchlfo_depth(self, sfz_inh(NSfzRegion_pitchlfo_depth(self), NSfzRegion_pitchlfo_depth(parent), 0));
    NSfzRegion_set_fillfo_freq(self, sfz_inh(NSfzRegion_fillfo_freq(self), NSfzRegion_fillfo_freq(parent), 0));
    NSfzRegion_set_fillfo_depth(self, sfz_inh(NSfzRegion_fillfo_depth(self), NSfzRegion_fillfo_depth(parent), 0));
    NSfzRegion_set_fil_keytrack(self, sfz_inh(NSfzRegion_fil_keytrack(self), NSfzRegion_fil_keytrack(parent), 0));
    NSfzRegion_set_output(self, sfz_inh(NSfzRegion_output(self), NSfzRegion_output(parent), 0));
    return 0;
}

# --- SfzFile ---
#derive(accessors)
struct NSfzFile { global; groups; regions; group_indices; default_path; includes; }

fn n_sfz_parse_header(token) {
    var len = str_len(token);
    if (len < 2) { return SFZ_HDR_NONE; }
    var data = str_data(token);
    if (load8(data) != 60) { return SFZ_HDR_NONE; }
    if (load8(data + len - 1) != 62) { return SFZ_HDR_NONE; }
    var ip = data + 1;
    var il = len - 2;
    if (n_sfz_span_eq(ip, il, "control") == 1) { return SFZ_HDR_CONTROL; }
    if (n_sfz_span_eq(ip, il, "global") == 1) { return SFZ_HDR_GLOBAL; }
    if (n_sfz_span_eq(ip, il, "group") == 1) { return SFZ_HDR_GROUP; }
    if (n_sfz_span_eq(ip, il, "region") == 1) { return SFZ_HDR_REGION; }
    if (n_sfz_span_eq(ip, il, "curve") == 1) { return SFZ_HDR_CURVE; }
    return SFZ_HDR_NONE;
}

# parse_n(data, len) -> NSfzFile pointer, or a negative code: NIDHI_ERR_INVALID_PARAMETER for a
# negative len (or a 0 pointer with len > 0), NIDHI_ERR_IMPORT when an allocation is refused. It
# used to be "infallible", and wrote the parse through 0 when alloc refused a region. Malformed
# text is still never an error: unknown opcodes and bad values are dropped, as in the oracle.
#
# Reads exactly data[0..len) and never past it (fuzz/guard_sfz.fcyr runs every input against a
# PROT_NONE page). A NUL is an ordinary byte, as in the oracle's &str: it is not White_Space, so it
# neither splits a token nor trims from a line. n_sfz_parse(cstr) used to be the only entry, and
# it stopped at the first NUL, silently dropping every region after one.
#
# Lines, tokens, keys and values are SPANS over the input, carried in stack Str headers; only
# what the file keeps is allocated (n_sfz_apply_opcode copies it). This loop used to build a vec
# of every line, a trimmed Str per line, two str_from headers for the `//` / `#include` tests and
# a fresh 152-byte token vec per line -- none of it ever reclaimed. Measured on 1 MB of "x\n":
# 130,024,440 heap bytes (124 per input byte), so a 40 MB file exhausted a 4 GB address space
# and segfaulted once alloc returned 0. Now 1,104 bytes for that input (the empty file), and a
# realistic 1 MB instrument went from 13,875,928 to 6,331,968: heap tracks what is kept.
#
# Line handling follows the oracle: split on '\n' (`str::lines` also drops a trailing
# '\r', which trim removes anyway), `str::trim` with Unicode White_Space, `//` comments,
# `trim_start_matches("#include")` -- which strips EVERY repeat of the prefix -- then `trim`,
# then `trim_matches('"')`, which strips every leading and trailing quote, not one of each.
#must_use
fn n_sfz_parse_n(data, len) {
    if (len < 0) { return NIDHI_ERR_INVALID_PARAMETER; }
    if (data == 0) { if (len > 0) { return NIDHI_ERR_INVALID_PARAMETER; } }
    var al = default_alloc();
    var global = n_sfz_region_new();
    var groups = vec_new();
    var regions = vec_new();
    var group_indices = vec_new();
    var default_path = 0;
    var includes = vec_new();
    if (global == 0) { return NIDHI_ERR_IMPORT; }
    if (groups == 0) { return NIDHI_ERR_IMPORT; }
    if (regions == 0) { return NIDHI_ERR_IMPORT; }
    if (group_indices == 0) { return NIDHI_ERR_IMPORT; }
    if (includes == 0) { return NIDHI_ERR_IMPORT; }
    var current_header = SFZ_HDR_NONE;
    var current_group_idx = 0 - 1;
    var tk[16];
    var kk[16];
    var vv[16];

    var ls = 0;
    while (ls < len) {
        var le = ls;
        while (le < len) {
            if (load8(data + le) == 10) { break; }
            le = le + 1;
        }
        var next = le + 1;
        # trim
        var a = ls;
        var b = le;
        while (a < b) {
            var wa = n_sfz_ws_at(data + a, b - a);
            if (wa == 0) { break; }
            a = a + wa;
        }
        while (b > a) {
            var wb = n_sfz_ws_before(data + a, b - a);
            if (wb == 0) { break; }
            b = b - wb;
        }
        var p = data + a;
        var n = b - a;
        var skip = 0;
        if (n == 0) { skip = 1; }
        if (skip == 0) { if (n >= 2) { if (memeq(p, "//", 2) == 1) { skip = 1; } } }
        if (skip == 0) {
            if (n >= 8) {
                if (memeq(p, "#include", 8) == 1) {
                    skip = 1;
                    var ia = a;
                    while (b - ia >= 8) {
                        if (memeq(data + ia, "#include", 8) == 0) { break; }
                        ia = ia + 8;
                    }
                    var ib = b;
                    while (ia < ib) {
                        var wi = n_sfz_ws_at(data + ia, ib - ia);
                        if (wi == 0) { break; }
                        ia = ia + wi;
                    }
                    while (ib > ia) {
                        var wj = n_sfz_ws_before(data + ia, ib - ia);
                        if (wj == 0) { break; }
                        ib = ib - wj;
                    }
                    while (ia < ib) {
                        if (load8(data + ia) != 34) { break; }
                        ia = ia + 1;
                    }
                    while (ib > ia) {
                        if (load8(data + ib - 1) != 34) { break; }
                        ib = ib - 1;
                    }
                    if (ib > ia) {
                        var inc = n_sfz_own(data + ia, ib - ia);
                        if (inc == 0) { return NIDHI_ERR_IMPORT; }
                        if (vec_push_a(al, includes, inc) < 0) { return NIDHI_ERR_IMPORT; }
                    }
                }
            }
        }
        if (skip == 0) {
            var i = 0;
            while (i < n) {
                var w = n_sfz_ws_at(p + i, n - i);
                if (w > 0) {
                    i = i + w;
                } else {
                    var st = i;
                    while (i < n) {
                        if (n_sfz_ws_at(p + i, n - i) > 0) { break; }
                        i = i + 1;
                    }
                    var tp = p + st;
                    var tl = i - st;
                    store64(&tk, tp);
                    store64(&tk + 8, tl);
                    var hk = n_sfz_parse_header(&tk);
                    if (hk != SFZ_HDR_NONE) {
                        current_header = hk;
                        if (hk == SFZ_HDR_GROUP) {
                            var ng = n_sfz_region_new();
                            if (ng == 0) { return NIDHI_ERR_IMPORT; }
                            if (vec_push_a(al, groups, ng) < 0) { return NIDHI_ERR_IMPORT; }
                            current_group_idx = vec_len(groups) - 1;
                        }
                        if (hk == SFZ_HDR_REGION) {
                            var nr = n_sfz_region_new();
                            if (nr == 0) { return NIDHI_ERR_IMPORT; }
                            if (vec_push_a(al, group_indices, current_group_idx) < 0) { return NIDHI_ERR_IMPORT; }
                            if (vec_push_a(al, regions, nr) < 0) { return NIDHI_ERR_IMPORT; }
                        }
                    } else {
                        var eq = str_index_of(&tk, 61);
                        # split_opcode: key and value must both be non-empty
                        if (eq > 0) {
                            if (eq + 1 < tl) {
                                store64(&kk, tp);
                                store64(&kk + 8, eq);
                                store64(&vv, tp + eq + 1);
                                store64(&vv + 8, tl - eq - 1);
                                var arc = 0;
                                if (current_header == SFZ_HDR_CONTROL) {
                                    if (str_eq_cstr(&kk, "default_path") == 1) {
                                        if (tl - eq - 1 <= N_SFZ_PATH_MAX) {
                                            default_path = n_sfz_own(tp + eq + 1, tl - eq - 1);
                                            if (default_path == 0) { return NIDHI_ERR_IMPORT; }
                                        }
                                    }
                                } elif (current_header == SFZ_HDR_GLOBAL) {
                                    arc = n_sfz_apply_opcode(global, &kk, &vv);
                                } elif (current_header == SFZ_HDR_GROUP) {
                                    arc = n_sfz_apply_opcode(vec_get(groups, vec_len(groups) - 1), &kk, &vv);
                                } elif (current_header == SFZ_HDR_REGION) {
                                    arc = n_sfz_apply_opcode(vec_get(regions, vec_len(regions) - 1), &kk, &vv);
                                } elif (current_header == SFZ_HDR_NONE) {
                                    arc = n_sfz_apply_opcode(global, &kk, &vv);
                                }
                                if (arc < 0) { return arc; }
                            }
                        }
                    }
                }
            }
        }
        ls = next;
    }

    var f = alloc(sizeof(NSfzFile));
    if (f == 0) { return NIDHI_ERR_IMPORT; }
    NSfzFile_set_global(f, global);
    NSfzFile_set_groups(f, groups);
    NSfzFile_set_regions(f, regions);
    NSfzFile_set_group_indices(f, group_indices);
    NSfzFile_set_default_path(f, default_path);
    NSfzFile_set_includes(f, includes);
    return f;
}

# parse(input_cstr) -> n_sfz_parse_n over the bytes up to the first NUL. Kept for callers with a
# C string; anything holding a buffer and a length should call n_sfz_parse_n, which reads an
# embedded NUL as the byte it is.
#must_use
fn n_sfz_parse(input_cstr) {
    if (input_cstr == 0) { return NIDHI_ERR_INVALID_PARAMETER; }
    return n_sfz_parse_n(input_cstr, strlen(input_cstr));
}

# --- mapping helpers ---
#must_use
fn n_sfz_map_loop_mode(s) {
    if (s == 0) { return LOOP_ONESHOT; }
    if (str_eq_cstr(s, "loop_continuous") == 1) { return LOOP_FORWARD; }
    if (str_eq_cstr(s, "loop_sustain") == 1) { return LOOP_SUSTAIN; }
    return LOOP_ONESHOT;
}

#must_use
fn n_sfz_map_fil_type(s) {
    if (s == 0) { return FILTER_LOWPASS; }
    if (str_eq_cstr(s, "hpf_1p") == 1) { return FILTER_HIGHPASS; }
    if (str_eq_cstr(s, "hpf_2p") == 1) { return FILTER_HIGHPASS; }
    if (str_eq_cstr(s, "bpf_2p") == 1) { return FILTER_BANDPASS; }
    if (str_eq_cstr(s, "brf_2p") == 1) { return FILTER_NOTCH; }
    return FILTER_LOWPASS;
}

# map_fil_veltrack(cents) = clamp(cents / 9600, 0, 1)
#must_use
fn n_sfz_map_fil_veltrack(cents) {
    return f64_min(f64_max(f64_div(cents, f64_from(9600)), 0), F64_ONE);
}

# a (zone, filename) pair produced by to_zones
#derive(accessors)
struct NSfzZoneFile { zone; filename; }

# n_sfz_adsr_new(attack, decay, sustain_pct, release, sample_rate) -> a fresh NAdsrConfig, or 0
# when the allocation is refused. SFZ's sustain arrives as 0..100 and is divided here, as to_zones
# always did. Since 2.3.0 n_adsr_config_new checks its own allocation, so this is from_seconds
# itself; tests/sfz.tcyr pins the two bit for bit, NaN, infinities and the u32 ceiling included.
#must_use
fn n_sfz_adsr_new(attack, decay, sustain_pct, release, sample_rate) {
    return n_adsr_config_from_seconds(attack, decay, f64_div(sustain_pct, f64_from(100)), release, sample_rate);
}

# to_zones(sfzfile, sample_rate f64 bits) -> vec of NSfzZoneFile, or a negative code:
# NIDHI_ERR_INVALID_PARAMETER for a 0 or error-code file, NIDHI_ERR_IMPORT when ANY allocation is
# refused. All or nothing: a refusal never returns a partial instrument, because one that silently
# lacks some regions plays wrong notes, where an error lets the host say so. That includes the
# joined default_path name, which 2.2.2 answered by dropping the region. n_zone_new and every
# builder pass 0 through, so one test after the chain covers them all.
#
# The default_path join is memoized per distinct sample name (content-keyed). It used to be one
# fresh |default_path| + |sample| allocation PER REGION, so heap was |default_path| x regions --
# see N_SFZ_PATH_MAX for the 1.19 MB file that needed ~8 GB. With the path capped at PATH_MAX and
# the join shared, a region whose sample repeats costs nothing extra, and a distinct sample costs
# at most PATH_MAX more than the `sample=` token that introduced it. Regions that share a name now
# share one filename Str, which nothing in nidhi mutates.
#
# The merged (region <- group <- global) record is a stack scratch reused for every region. It was
# a heap clone per region, 312 never-reclaimed bytes each, and nothing keeps it: the zone copies
# its numbers, and the strings it points at belong to the parsed file.
#must_use
fn n_sfz_to_zones(f, sample_rate) {
    if (f <= 0) { return NIDHI_ERR_INVALID_PARAMETER; }
    var al = default_alloc();
    var out = vec_new();
    if (out == 0) { return NIDHI_ERR_IMPORT; }
    var regions = NSfzFile_regions(f);
    var groups = NSfzFile_groups(f);
    var group_indices = NSfzFile_group_indices(f);
    var global = NSfzFile_global(f);
    var default_path = NSfzFile_default_path(f);
    var joined = 0;
    if (default_path != 0) {
        joined = map_new_str();
        if (joined == 0) { return NIDHI_ERR_IMPORT; }
    }
    var mbuf[512];
    var merged = &mbuf;
    var nw = sizeof(NSfzRegion) / 8;
    if (nw * 8 > 512) { return NIDHI_ERR_IMPORT; }
    var nreg = vec_len(regions);
    var i = 0;
    while (i < nreg) {
        # Word copy: the stdlib memcpy moves a byte per iteration, and copying the 312-byte
        # record that way made to_zones 1.6x slower than the heap clone it replaced.
        var src = vec_get(regions, i);
        var w = 0;
        while (w < nw) {
            store64(merged + w * 8, load64(src + w * 8));
            w = w + 1;
        }
        var gi = vec_get(group_indices, i);
        if (gi >= 0) {
            if (gi < vec_len(groups)) { n_sfz_inherit_from(merged, vec_get(groups, gi)); }
        }
        n_sfz_inherit_from(merged, global);

        # key shorthand
        var kk = NSfzRegion_key(merged);
        if (kk >= 0) {
            if (NSfzRegion_lokey(merged) == 0) { if (NSfzRegion_hikey(merged) == 127) { NSfzRegion_set_lokey(merged, kk); NSfzRegion_set_hikey(merged, kk); } }
            if (NSfzRegion_pitch_keycenter(merged) == 60) { NSfzRegion_set_pitch_keycenter(merged, kk); }
        }

        var samp = NSfzRegion_sample(merged);
        var filename = samp;
        if (samp != 0) {
            if (default_path != 0) {
                if (str_starts_with(samp, default_path) == 0) {
                    filename = map_get_or(joined, samp, 0);
                    if (filename == 0) {
                        filename = n_sfz_join(default_path, samp);
                        if (filename == 0) { return NIDHI_ERR_IMPORT; }
                        if (map_set_a(al, joined, samp, filename) < 0) { return NIDHI_ERR_IMPORT; }
                    }
                }
            }
        }
        if (filename == 0) {
            # no sample -> skip region
        } else {
            # tune_cents = tune + transpose * 100
            var tune_cents = f64_add(f64_from(NSfzRegion_tune(merged)), f64_mul(f64_from(NSfzRegion_transpose(merged)), f64_from(100)));
            var filter_type = n_sfz_map_fil_type(NSfzRegion_fil_type(merged));

            var zone = n_zone_new(i);
            zone = n_zone_with_key_range(zone, NSfzRegion_lokey(merged), NSfzRegion_hikey(merged));
            zone = n_zone_with_vel_range(zone, NSfzRegion_lovel(merged), NSfzRegion_hivel(merged));
            zone = n_zone_with_root_note(zone, NSfzRegion_pitch_keycenter(merged));
            zone = n_zone_with_tune(zone, tune_cents);
            zone = n_zone_with_volume(zone, NSfzRegion_volume(merged));
            zone = n_zone_with_pan(zone, f64_div(NSfzRegion_pan(merged), f64_from(100)));
            zone = n_zone_with_loop(zone, n_sfz_map_loop_mode(NSfzRegion_loop_mode(merged)), NSfzRegion_loop_start(merged), NSfzRegion_loop_end(merged));
            zone = n_zone_with_filter(zone, NSfzRegion_cutoff(merged), n_sfz_map_fil_veltrack(NSfzRegion_fil_veltrack(merged)));
            zone = n_zone_with_filter_type(zone, filter_type);
            zone = n_zone_with_group(zone, NSfzRegion_group(merged));
            zone = n_zone_with_seq(zone, NSfzRegion_seq_length(merged), NSfzRegion_seq_position(merged));

            if (f64_gt(NSfzRegion_resonance(merged), 0) == 1) { zone = n_zone_with_filter_resonance(zone, NSfzRegion_resonance(merged)); }
            if (NSfzRegion_offset(merged) > 0) { zone = n_zone_with_sample_offset(zone, NSfzRegion_offset(merged)); }
            if (NSfzRegion_end(merged) > 0) { zone = n_zone_with_sample_end(zone, NSfzRegion_end(merged)); }
            if (zone <= 0) { return NIDHI_ERR_IMPORT; }

            # ampeg. The zone takes the fresh config as its own -- what n_zone_with_adsr's copy
            # gives it -- without that builder's unchecked second allocation.
            var f100 = f64_from(100);
            var has_ampeg = 0;
            if (NSfzRegion_ampeg_attack(merged) != 0) { has_ampeg = 1; }
            if (NSfzRegion_ampeg_decay(merged) != 0) { has_ampeg = 1; }
            if (NSfzRegion_ampeg_sustain(merged) != f100) { has_ampeg = 1; }
            if (NSfzRegion_ampeg_release(merged) != 0) { has_ampeg = 1; }
            if (has_ampeg == 1) {
                var adsr = n_sfz_adsr_new(NSfzRegion_ampeg_attack(merged), NSfzRegion_ampeg_decay(merged), NSfzRegion_ampeg_sustain(merged), NSfzRegion_ampeg_release(merged), sample_rate);
                if (adsr == 0) { return NIDHI_ERR_IMPORT; }
                NZone_set_adsr(zone, adsr);
            }
            # fileg: the builder with a 0 config clamps the depth and allocates nothing; the
            # checked config then goes in, as for ampeg.
            var has_fileg = 0;
            if (NSfzRegion_fileg_depth(merged) != 0) { has_fileg = 1; }
            if (NSfzRegion_fileg_attack(merged) != 0) { has_fileg = 1; }
            if (NSfzRegion_fileg_decay(merged) != 0) { has_fileg = 1; }
            if (NSfzRegion_fileg_sustain(merged) != f100) { has_fileg = 1; }
            if (NSfzRegion_fileg_release(merged) != 0) { has_fileg = 1; }
            if (has_fileg == 1) {
                var fileg = n_sfz_adsr_new(NSfzRegion_fileg_attack(merged), NSfzRegion_fileg_decay(merged), NSfzRegion_fileg_sustain(merged), NSfzRegion_fileg_release(merged), sample_rate);
                if (fileg == 0) { return NIDHI_ERR_IMPORT; }
                zone = n_zone_with_filter_envelope(zone, 0, NSfzRegion_fileg_depth(merged));
                NZone_set_fileg(zone, fileg);
            }
            # LFOs
            if (f64_gt(NSfzRegion_pitchlfo_freq(merged), 0) == 1) { if (NSfzRegion_pitchlfo_depth(merged) != 0) { zone = n_zone_with_pitch_lfo(zone, NSfzRegion_pitchlfo_freq(merged), NSfzRegion_pitchlfo_depth(merged)); } }
            if (f64_gt(NSfzRegion_fillfo_freq(merged), 0) == 1) { if (NSfzRegion_fillfo_depth(merged) != 0) { zone = n_zone_with_filter_lfo(zone, NSfzRegion_fillfo_freq(merged), NSfzRegion_fillfo_depth(merged)); } }
            if (f64_gt(NSfzRegion_fil_keytrack(merged), 0) == 1) { zone = n_zone_with_key_tracking(zone, f64_div(NSfzRegion_fil_keytrack(merged), f64_from(1200))); }
            if (NSfzRegion_output(merged) > 0) { zone = n_zone_with_output_bus(zone, NSfzRegion_output(merged)); }

            var pair = alloc(sizeof(NSfzZoneFile));
            if (pair == 0) { return NIDHI_ERR_IMPORT; }
            NSfzZoneFile_set_zone(pair, zone);
            NSfzZoneFile_set_filename(pair, filename);
            if (vec_push_a(al, out, pair) < 0) { return NIDHI_ERR_IMPORT; }
        }
        i = i + 1;
    }
    return out;
}

# shallow clone of a region (copy every slot; the cc_modulations vec is shared by reference,
# matching how to_zones only reads it).
#must_use
fn n_sfz_clone_region(src) {
    var r = alloc(sizeof(NSfzRegion));
    var n = sizeof(NSfzRegion) / 8;
    var i = 0;
    while (i < n) {
        store64(r + i * 8, load64(src + i * 8));
        i = i + 1;
    }
    return r;
}

# Filenames at least this long go through to_instrument's pointer map before the content hash.
var N_SFZ_PTR_MEMO_MIN = 64;

# a (instrument, sample_files) result
#derive(accessors)
struct NSfzInstResult { instrument; sample_files; }

# to_instrument(name, sample_rate) -> NSfzInstResult. Dedups filenames -> sequential SampleIds.
#
# -> the result, or a negative code: NIDHI_ERR_INVALID_PARAMETER for a 0 or error-code file, or
# NIDHI_ERR_IMPORT when any allocation is refused -- n_instrument_new returning 0, a refused
# add_zone (it now answers NIDHI_ERR_PLAYBACK rather than exiting), or to_zones' own refusal,
# which is passed on. All or nothing, as for to_zones: never a partly built instrument.
#
# Dedup is a content-keyed hashmap lookup, in first-seen order exactly as the oracle's
# `sample_files.iter().position(..)` scan assigns ids. That scan was ported literally, and it is
# O(regions x files): 40,000 regions with distinct names (a 1.16 MB file) took 14,346 ms here,
# 37 ms through the map. The stdlib map's hash is seeded per process, so a file cannot be
# crafted to collide its way back to quadratic.
#
# In front of it sits a pointer-keyed map. to_zones hands every region that shares a joined
# default_path name, or inherits one sample from <group>/<global>, the SAME Str, and hashing that
# Str's content per region was the cost left: 20,000 regions under a 4,096-byte default_path spent
# 260 ms re-hashing one 4 KB name; now 13 ms. A pointer seen before has its id already; only a new
# pointer pays the content hash. Same content under two pointers still meets in the content map,
# so ids and their order are unchanged. Names under N_SFZ_PTR_MEMO_MIN bytes skip the pointer map:
# hashing them costs about what the u64 probe does, and every region's own `sample=` copy is a
# distinct pointer, so there an ungated map only missed (20,000 plain regions: 13.5 -> 16.9 ms).
#must_use
fn n_sfz_to_instrument(f, name, sample_rate) {
    if (f <= 0) { return NIDHI_ERR_INVALID_PARAMETER; }
    var al = default_alloc();
    var inst = n_instrument_new(name);
    if (inst <= 0) { return NIDHI_ERR_IMPORT; }
    var pairs = n_sfz_to_zones(f, sample_rate);
    if (pairs <= 0) { return pairs; }
    var sample_files = vec_new();
    var seen = map_new_str();
    var by_ptr = map_u64_new();
    if (sample_files == 0) { return NIDHI_ERR_IMPORT; }
    if (seen == 0) { return NIDHI_ERR_IMPORT; }
    if (by_ptr == 0) { return NIDHI_ERR_IMPORT; }
    var np = vec_len(pairs);
    var i = 0;
    while (i < np) {
        var pair = vec_get(pairs, i);
        var zone = NSfzZoneFile_zone(pair);
        var filename = NSfzZoneFile_filename(pair);
        var long_name = 0;
        if (str_len(filename) >= N_SFZ_PTR_MEMO_MIN) { long_name = 1; }
        var idx = 0 - 1;
        if (long_name == 1) { idx = map_u64_get_or(by_ptr, filename, 0 - 1); }
        if (idx < 0) {
            idx = map_get_or(seen, filename, 0 - 1);
            if (idx < 0) {
                if (vec_push_a(al, sample_files, filename) < 0) { return NIDHI_ERR_IMPORT; }
                idx = vec_len(sample_files) - 1;
                if (map_set_a(al, seen, filename, idx) < 0) { return NIDHI_ERR_IMPORT; }
            }
            if (long_name == 1) {
                if (map_u64_set_a(al, by_ptr, filename, idx) < 0) { return NIDHI_ERR_IMPORT; }
            }
        }
        NZone_set_sample_id(zone, idx);
        if (n_instrument_add_zone(inst, zone) < 0) { return NIDHI_ERR_IMPORT; }
        i = i + 1;
    }
    var res = alloc(sizeof(NSfzInstResult));
    if (res == 0) { return NIDHI_ERR_IMPORT; }
    NSfzInstResult_set_instrument(res, inst);
    NSfzInstResult_set_sample_files(res, sample_files);
    return res;
}

# --- engine.cyr ---

# engine.cyr -- SamplerEngine: voice management + per-sample render loop
# Requires: alloc, vec, math (f64_*, f64_pow, f64_floor), sample, zone, instrument, envelope,
#           loop_mode, naad (filter_svf_*, SvfOutput_*, modulation_lfo_*, smoothing_*,
#           voice_manager_*, POLY_MODE_*, STEAL_MODE_*, MODULATION_LFO_SINE, naad_is_err)
#
# Ports rust-old/src/engine.rs (std path). "Use naad fully": the SVF filter, LFOs, cutoff
# smoother, and VoiceManager are naad's own. The engine never ticks the VoiceManager, so naad
# ages stay 0 -> Oldest steals the highest active index -- exactly the Rust parity behavior.
# Options -> null pointer (0) / -1 sentinel. All f32 -> f64. fill_buffer_stereo is rendered
# per-frame (output-identical to the Rust per-voice block render).

# PolyMode / StealMode: reuse naad's constants (POLY_MODE_POLY=0/MONO=1/LEGATO=2,
# STEAL_MODE_OLDEST=0/QUIETEST=1/LOWEST=2/NONE=3).

# --- VoiceFilter: stereo pair of naad SVFs ---
#derive(accessors)
struct NVoiceFilter { active; last_cutoff; filter_l; filter_r; mode; }

#must_use
fn nvf_bypass() {
    var vf = alloc(sizeof(NVoiceFilter));
    if (vf == 0) { return 0; }
    NVoiceFilter_set_active(vf, 0);
    NVoiceFilter_set_last_cutoff(vf, 0);
    NVoiceFilter_set_filter_l(vf, 0);
    NVoiceFilter_set_filter_r(vf, 0);
    NVoiceFilter_set_mode(vf, FILTER_LOWPASS);
    return vf;
}

# nvf_reinit -- re-arm the voice's EXISTING filter in place. Returns 1 if active, else 0.
#
# Every voice already owns an NVoiceFilter from n_voice_new; note_on used to throw it away and
# build a fresh one, allocating the struct plus TWO naad SVFs per note and never reclaiming any
# of it (the allocator's free is a no-op). At ten notes a second that is megabytes an hour.
#
# Reuse is behaviour-preserving, not merely cheaper: filter_svf_set_params validates frequency
# and q exactly as filter_svf_new does, and filter_svf_reset zeroes ic1eq/ic2eq -- precisely the
# two state variables the constructor zeroes. So a re-armed filter is indistinguishable from a
# fresh one. The reset is load-bearing: without it a new note inherits the previous note's
# integrator state and starts mid-ring.
#
# The SVFs are built lazily on first use rather than at voice construction, which sidesteps
# having to invent a default cutoff that validate_frequency accepts at every sample rate.
fn nvf_reinit(vf, cutoff, resonance, mode, vel_track, velocity, sample_rate) {
    if (f64_le(cutoff, 0) == 1) {
        NVoiceFilter_set_active(vf, 0);
        NVoiceFilter_set_last_cutoff(vf, 0);
        NVoiceFilter_set_mode(vf, FILTER_LOWPASS);
        return 0;
    }
    var vel_norm = f64_div(f64_from(velocity), f64_from(127));
    var ec = f64_mul(cutoff, f64_sub(F64_ONE, f64_mul(vel_track, f64_sub(F64_ONE, vel_norm))));
    var hi = f64_mul(sample_rate, 0x3FDF5C28F5C28F5C);
    ec = f64_min(f64_max(ec, 0x4034000000000000), hi);
    var q = f64_max(resonance, f64_div(F64_ONE, f64_from(10)));

    var fl = NVoiceFilter_filter_l(vf);
    if (fl == 0) {
        fl = filter_svf_new(ec, q, sample_rate);
        if (naad_is_err(fl) == 1) { fl = 0; }
        NVoiceFilter_set_filter_l(vf, fl);
    } else {
        if (naad_is_err(filter_svf_set_params(fl, ec, q)) == 1) { fl = 0; }
        if (fl != 0) { filter_svf_reset(fl); }
    }
    var fr = NVoiceFilter_filter_r(vf);
    if (fr == 0) {
        fr = filter_svf_new(ec, q, sample_rate);
        if (naad_is_err(fr) == 1) { fr = 0; }
        NVoiceFilter_set_filter_r(vf, fr);
    } else {
        if (naad_is_err(filter_svf_set_params(fr, ec, q)) == 1) { fr = 0; }
        if (fr != 0) { filter_svf_reset(fr); }
    }

    var active = 0;
    if (fl != 0) { active = 1; }
    NVoiceFilter_set_active(vf, active);
    NVoiceFilter_set_last_cutoff(vf, ec);
    NVoiceFilter_set_mode(vf, mode);
    return active;
}

#must_use
fn nvf_new(cutoff, resonance, mode, vel_track, velocity, sample_rate) {
    if (f64_le(cutoff, 0) == 1) { return nvf_bypass(); }
    var vel_norm = f64_div(f64_from(velocity), f64_from(127));
    var ec = f64_mul(cutoff, f64_sub(F64_ONE, f64_mul(vel_track, f64_sub(F64_ONE, vel_norm))));
    var hi = f64_mul(sample_rate, f64_div(f64_from(49), f64_from(100)));
    ec = f64_min(f64_max(ec, f64_from(20)), hi);
    var q = f64_max(resonance, f64_div(F64_ONE, f64_from(10)));
    var fl = filter_svf_new(ec, q, sample_rate);
    if (naad_is_err(fl) == 1) { fl = 0; }
    var fr = filter_svf_new(ec, q, sample_rate);
    if (naad_is_err(fr) == 1) { fr = 0; }
    var vf = alloc(sizeof(NVoiceFilter));
    var active = 0;
    if (fl != 0) { active = 1; }
    NVoiceFilter_set_active(vf, active);
    NVoiceFilter_set_last_cutoff(vf, ec);
    NVoiceFilter_set_filter_l(vf, fl);
    NVoiceFilter_set_filter_r(vf, fr);
    NVoiceFilter_set_mode(vf, mode);
    return vf;
}

fn nvf_pick(svfout, mode) {
    if (mode == FILTER_HIGHPASS) { return SvfOutput_high_pass(svfout); }
    if (mode == FILTER_BANDPASS) { return SvfOutput_band_pass(svfout); }
    if (mode == FILTER_NOTCH) { return SvfOutput_notch(svfout); }
    return SvfOutput_low_pass(svfout);
}

# 0.49 and 20.0 as literal f64 bit patterns, and F64_HALF for the hysteresis threshold --
# all three were rebuilt with divides on every sample of every filtered voice.
#   0.49 = 0x3FDF5C28F5C28F5C   20.0 = 0x4034000000000000
fn nvf_set_cutoff(vf, cutoff, sample_rate) {
    if (NVoiceFilter_active(vf) == 0) { return 0; }
    var hi = f64_mul(sample_rate, 0x3FDF5C28F5C28F5C);
    var c = f64_min(f64_max(cutoff, 0x4034000000000000), hi);
    if (f64_lt(f64_abs(f64_sub(c, NVoiceFilter_last_cutoff(vf))), F64_HALF) == 1) { return 0; }
    NVoiceFilter_set_last_cutoff(vf, c);
    var fl = NVoiceFilter_filter_l(vf);
    if (fl != 0) { filter_svf_set_params(fl, c, filter_svf_q(fl)); }
    var fr = NVoiceFilter_filter_r(vf);
    if (fr != 0) { filter_svf_set_params(fr, c, filter_svf_q(fr)); }
    return 0;
}

fn nvf_process_stereo(vf, left, right, out2) {
    if (NVoiceFilter_active(vf) == 0) { store64(out2, left); store64(out2 + 8, right); return 0; }
    var mode = NVoiceFilter_mode(vf);
    var fl = NVoiceFilter_filter_l(vf);
    var fr = NVoiceFilter_filter_r(vf);
    # Nothing here allocates. filter_svf_process_sample allocates an SvfOutput per channel
    # per voice per sample -- 22.6 MB/s at 8 voices, 180 MB/s at 64 -- and the bump
    # allocator never frees it. Low-pass, the default mode (zone.cyr and SFZ both), takes
    # the _lowpass form, which computes only that output. The other three modes take
    # filter_svf_process_sample_into (naad 2.3.2+), which writes all four outputs into the
    # caller's SvfOutput. naad's allocating form is alloc + _into, and all three run the
    # same integrator step, so filter state evolves bit-for-bit the same on every path.
    if (mode == FILTER_LOWPASS) {
        var ll = left;
        if (fl != 0) { ll = filter_svf_process_sample_lowpass(fl, left); }
        var rl = right;
        if (fr != 0) { rl = filter_svf_process_sample_lowpass(fr, right); }
        store64(out2, ll);
        store64(out2 + 8, rl);
        return 0;
    }
    # so is that SvfOutput, on the stack: four f64 fields, 32 bytes.
    var so[32];
    var l = left;
    if (fl != 0) {
        filter_svf_process_sample_into(fl, left, &so);
        l = nvf_pick(&so, mode);
    }
    var r = right;
    if (fr != 0) {
        filter_svf_process_sample_into(fr, right, &so);
        r = nvf_pick(&so, mode);
    }
    store64(out2, l);
    store64(out2 + 8, r);
    return 0;
}

# --- SamplerVoice ---
#derive(accessors)
struct NSamplerVoice {
    active;
    zone_index;
    position;
    speed;
    amplitude;
    note;
    age;
    forward;
    amp_env;
    filter_env;
    filter_env_depth;
    base_cutoff;
    filter;
    pitch_bend;
    pressure;
    brightness;
    choke_group;
    pitch_lfo;
    pitch_lfo_depth;
    filter_lfo;
    filter_lfo_depth;
    fil_keytrack;
    cutoff_smoother;
}

# Discard a value the caller does not need, without leaving a bare-statement call.
# n_-prefixed: this ships in dist/nidhi.cyr, and `ignore` is about as collision-prone a
# name as exists in a flat namespace.
fn n_ignore(v) { return 0; }

#must_use
# n_voice_lfo_new(sample_rate) -> a persistent SINE LFO, or 0. modulation_lfo_new refuses a NaN,
# +/-Inf, zero or negative rate with a negative code, and render gates on `!= 0`, so a code in
# this slot is dereferenced on the first frame. The oracle's `Lfo::new(..).ok()`: a rate naad
# refuses means no LFO, and the voice plays without one. n_engine_new does not refuse the rate
# either: the oracle's constructor cannot fail, and no caller checks it for a code.
#must_use
fn n_voice_lfo_new(sample_rate) {
    var lfo = modulation_lfo_new(MODULATION_LFO_SINE, F64_ONE, sample_rate);
    if (naad_is_err(lfo) == 1) { return 0; }
    return lfo;
}

#must_use
fn n_voice_new(sample_rate) {
    var v = alloc(sizeof(NSamplerVoice));
    if (v == 0) { return 0; }
    NSamplerVoice_set_active(v, 0);
    NSamplerVoice_set_zone_index(v, 0);
    NSamplerVoice_set_position(v, 0);
    NSamplerVoice_set_speed(v, F64_ONE);
    NSamplerVoice_set_amplitude(v, F64_ONE);
    NSamplerVoice_set_note(v, 0);
    NSamplerVoice_set_age(v, 0);
    NSamplerVoice_set_forward(v, 1);
    # nidhi's own allocations here are checked (2.3.0): the two configs and the filter struct. The
    # envelopes, LFOs and smoother are naad objects, and a refusal inside a naad constructor stops
    # at the null page by naad's own design (its ADR-0006), so there is nothing here to check.
    var aenv = n_amp_envelope_new(n_adsr_config_default(), sample_rate);
    if (aenv <= 0) { return 0; }
    NSamplerVoice_set_amp_env(v, aenv);
    # Persistent per-voice filter envelope and LFOs, re-armed in note_on rather than rebuilt.
    # `filter_env_depth` 0 is what disables the filter envelope, not a null pointer.
    var fenv = n_amp_envelope_new(n_adsr_config_default(), sample_rate);
    if (fenv <= 0) { return 0; }
    NSamplerVoice_set_filter_env(v, fenv);
    NSamplerVoice_set_filter_env_depth(v, 0);
    NSamplerVoice_set_base_cutoff(v, 0);
    var vfilt = nvf_bypass();
    if (vfilt == 0) { return 0; }
    NSamplerVoice_set_filter(v, vfilt);
    NSamplerVoice_set_pitch_bend(v, 0);
    NSamplerVoice_set_pressure(v, 0);
    NSamplerVoice_set_brightness(v, F64_HALF);
    NSamplerVoice_set_choke_group(v, 0);
    NSamplerVoice_set_pitch_lfo(v, n_voice_lfo_new(sample_rate));
    NSamplerVoice_set_pitch_lfo_depth(v, 0);
    NSamplerVoice_set_filter_lfo(v, n_voice_lfo_new(sample_rate));
    NSamplerVoice_set_filter_lfo_depth(v, 0);
    NSamplerVoice_set_fil_keytrack(v, 0);
    NSamplerVoice_set_cutoff_smoother(v, smoothing_new(f64_div(f64_from(5), f64_from(1000)), sample_rate, 0));
    return v;
}

#inline
#must_use
fn n_voice_is_active(v) { return NSamplerVoice_active(v); }
#inline
#must_use
fn n_voice_note(v) { return NSamplerVoice_note(v); }

# --- SamplerEngine ---
#derive(accessors)
struct NSamplerEngine {
    voices;
    instrument;
    bank;
    sample_rate;
    default_adsr;
    pitch_bend_range;
    rv_scratch;
    rv_xscratch;
    rv_fscratch;
    ns_out;
    voice_mgr;
}

#must_use
fn n_engine_new(max_voices, sample_rate) {
    var e = alloc(sizeof(NSamplerEngine));
    if (e == 0) { return 0; }
    # naad's VoiceManager clamps to [1,128], and nidhi now clamps to the same range. It used to
    # clamp the low end only (n_engine_new(0, sr) built 0 nidhi voices and 1 naad voice, and the
    # first note_on did vec_get on an empty vec -> exit(1)). Above 128 the extra voices could
    # never sound, because naad never hands out an index past 127, but render still scanned
    # them every frame: one note in a 4096-voice engine took 13.7 ms per 512-frame block, over
    # the 11.6 ms real-time budget. At 20,000,000 the unchecked n_voice_new allocations ran the
    # heap out and segfaulted. Nothing observable changes: voice counts and choke groups only
    # ever touch active voices.
    var mv = max_voices;
    if (mv < 1) { mv = 1; }
    if (mv > 128) { mv = 128; }
    var voices = vec_new();
    var i = 0;
    while (i < mv) {
        var nvoice = n_voice_new(sample_rate);
        if (nvoice == 0) { return 0; }
        vec_push(voices, nvoice);
        i = i + 1;
    }
    NSamplerEngine_set_voices(e, voices);
    NSamplerEngine_set_instrument(e, 0);
    var ebank = n_sample_bank_new();
    if (ebank == 0) { return 0; }
    NSamplerEngine_set_bank(e, ebank);
    NSamplerEngine_set_sample_rate(e, sample_rate);
    # Saturate to u32 range before f64_to, as n_adsr_config_from_seconds does: a release is a
    # sample count naad holds, not an i64, and a huge one must stay huge rather than click.
    var rcap = f64_from(4294967295);
    var rel = f64_to(f64_min(f64_max(f64_mul(sample_rate, f64_div(F64_ONE, f64_from(100))), F64_ONE), rcap));
    var dadsr = n_adsr_config_new(0, 0, F64_ONE, rel);
    if (dadsr == 0) { return 0; }
    NSamplerEngine_set_default_adsr(e, dadsr);
    NSamplerEngine_set_pitch_bend_range(e, f64_from(2));

    # Per-engine render scratch, allocated ONCE. These four slots used to be alloc(16)
    # calls on the per-FRAME path: 48 B/frame stereo (2,116,800 B/s at 44.1 kHz) and
    # 64 B/frame mono, none of it ever reclaimed -- lib/alloc.cyr is a bump allocator
    # whose free is a no-op. The endgame was not merely a leak but memory UNSAFETY: once
    # alloc() returns 0, n_engine_next_sample_stereo does store64(0, ...) and segfaults
    # inside the audio callback. (These replace a `scratch_buf` vec that was filled with
    # 2048 zeros at construction and never read -- a vestige of the unported Rust block
    # renderer. Note it was a vec OBJECT, so it could not have been used as raw scratch
    # anyway: store64 into it would corrupt the header.)
    var rv_s = alloc(16);
    var rv_x = alloc(16);
    var rv_f = alloc(16);
    var ns_o = alloc(16);
    if (rv_s == 0) { return 0; }
    if (rv_x == 0) { return 0; }
    if (rv_f == 0) { return 0; }
    if (ns_o == 0) { return 0; }
    NSamplerEngine_set_rv_scratch(e, rv_s);
    NSamplerEngine_set_rv_xscratch(e, rv_x);
    NSamplerEngine_set_rv_fscratch(e, rv_f);
    NSamplerEngine_set_ns_out(e, ns_o);

    NSamplerEngine_set_voice_mgr(e, voice_manager_new(mv, POLY_MODE_POLY, STEAL_MODE_OLDEST));
    return e;
}

fn n_engine_set_instrument(e, inst) {
    if (inst <= 0) { return NIDHI_ERR_INVALID_PARAMETER; }
    NSamplerEngine_set_instrument(e, inst);
    return 0;
}
# `<= 0` as set_instrument: a 0 or an error code here was dereferenced by the first render.
fn n_engine_set_bank(e, bank) {
    if (bank <= 0) { return NIDHI_ERR_INVALID_PARAMETER; }
    NSamplerEngine_set_bank(e, bank);
    return 0;
}
#must_use
fn n_engine_bank(e) { return NSamplerEngine_bank(e); }
# COPIES the config's values -- same aliasing class as n_zone_with_adsr and the set_release_ms
# fix in 2.0.2. Rust's set_adsr took AdsrConfig by value.
#
# Both setters write the engine's OWN config in place. 2.0.2 to 2.2.1 allocated a new 32-byte
# config per call, never reclaimed (the allocator's free is a no-op), so release automation at
# 1 kHz grew the heap 115 MB an hour. In-place is safe since 2.0.2 made the config engine-owned:
# n_engine_new builds it, set_adsr copies into it, n_zone_with_adsr copies out of anything it is
# given, and note_on only reads it. The 2.0.2 aliasing came from storing the CALLER's pointer.
fn n_engine_set_adsr(e, cfg) {
    if (cfg <= 0) { return NIDHI_ERR_INVALID_PARAMETER; }
    var own = NSamplerEngine_default_adsr(e);
    NAdsrConfig_set_attack_samples(own, NAdsrConfig_attack_samples(cfg));
    NAdsrConfig_set_decay_samples(own, NAdsrConfig_decay_samples(cfg));
    NAdsrConfig_set_sustain_level(own, NAdsrConfig_sustain_level(cfg));
    NAdsrConfig_set_release_samples(own, NAdsrConfig_release_samples(cfg));
    return 0;
}
# The cap is the same f64_to saturation as n_engine_new above.
fn n_engine_set_release_ms(e, ms) {
    var rcap = f64_from(4294967295);
    var rel = f64_to(f64_min(f64_max(f64_div(f64_mul(NSamplerEngine_sample_rate(e), ms), f64_from(1000)), F64_ONE), rcap));
    NAdsrConfig_set_release_samples(NSamplerEngine_default_adsr(e), rel);
    return 0;
}
fn n_engine_set_pitch_bend_range(e, semitones) { NSamplerEngine_set_pitch_bend_range(e, f64_max(semitones, 0)); return 0; }
fn n_engine_set_steal_mode(e, mode) { VoiceManager_set_steal_mode(NSamplerEngine_voice_mgr(e), mode); return 0; }
fn n_engine_set_poly_mode(e, mode) { VoiceManager_set_poly_mode(NSamplerEngine_voice_mgr(e), mode); return 0; }

fn n_engine_apply_pitch_bend(e, note, bend) {
    var bs = f64_mul(bend, NSamplerEngine_pitch_bend_range(e));
    var voices = NSamplerEngine_voices(e);
    var nv = vec_len(voices);
    var i = 0;
    while (i < nv) {
        var v = vec_get(voices, i);
        if (NSamplerVoice_active(v) == 1) { if (NSamplerVoice_note(v) == note) { NSamplerVoice_set_pitch_bend(v, bs); } }
        i = i + 1;
    }
    return 0;
}

fn n_engine_apply_pressure(e, note, pressure) {
    var p = f64_min(f64_max(pressure, 0), F64_ONE);
    var voices = NSamplerEngine_voices(e);
    var nv = vec_len(voices);
    var i = 0;
    while (i < nv) {
        var v = vec_get(voices, i);
        if (NSamplerVoice_active(v) == 1) { if (NSamplerVoice_note(v) == note) { NSamplerVoice_set_pressure(v, p); } }
        i = i + 1;
    }
    return 0;
}

fn n_engine_apply_brightness(e, note, brightness) {
    var b = f64_min(f64_max(brightness, 0), F64_ONE);
    var voices = NSamplerEngine_voices(e);
    var nv = vec_len(voices);
    var i = 0;
    while (i < nv) {
        var v = vec_get(voices, i);
        if (NSamplerVoice_active(v) == 1) { if (NSamplerVoice_note(v) == note) { NSamplerVoice_set_brightness(v, b); } }
        i = i + 1;
    }
    return 0;
}

#must_use
fn n_engine_active_voice_count(e) {
    var voices = NSamplerEngine_voices(e);
    var nv = vec_len(voices);
    var c = 0;
    var i = 0;
    while (i < nv) { if (NSamplerVoice_active(vec_get(voices, i)) == 1) { c = c + 1; } i = i + 1; }
    return c;
}

# test helper: 1 if some active voice currently plays `note`, else 0.
#must_use
fn n_engine_has_active_note(e, note) {
    var voices = NSamplerEngine_voices(e);
    var nv = vec_len(voices);
    var i = 0;
    while (i < nv) {
        var v = vec_get(voices, i);
        if (NSamplerVoice_active(v) == 1) { if (NSamplerVoice_note(v) == note) { return 1; } }
        i = i + 1;
    }
    return 0;
}

# n_engine_rate_scaled(speed, sample, engine_sr) -> speed x (sample rate / engine rate).
# Returns `speed` untouched when the sample is missing, its rate is not positive, the rates are
# equal, or the ratio is not finite: a rate nidhi cannot use is no reason to refuse the note.
#must_use
fn n_engine_rate_scaled(speed, sample, engine_sr) {
    if (sample <= 0) { return speed; }
    var ssr = NSample_sample_rate(sample);
    if (ssr <= 0) { return speed; }
    var ssr_f = f64_from(ssr);
    if (ssr_f == engine_sr) { return speed; }
    # A rate naad refuses (NaN, +/-Inf, zero, negative) builds an engine anyway (n_engine_new
    # does not refuse it), and +Inf would give a ratio of 0: a voice frozen on one frame.
    if (n_is_finite(engine_sr) == 0) { return speed; }
    if (f64_gt(engine_sr, 0) == 0) { return speed; }
    var ratio = f64_div(ssr_f, engine_sr);
    if (n_is_finite(ratio) == 0) { return speed; }
    if (f64_gt(ratio, 0) == 0) { return speed; }
    return f64_mul(speed, ratio);
}

# n_engine_sync_voice_mgr(e) -- copy nidhi's per-voice `active` into naad's VoiceManager.
#
# nidhi's voices are the truth, and naad's pool only picks the index. See
# docs/adr/0006-nidhi-voice-state-decides-allocation.md. The two pools used to drift:
#   * naad frees a slot at note_off while nidhi's voice is still in its release tail, so the
#     next note took that slot and cut the tail, although idle voices existed.
#   * naad's note_off frees only the FIRST slot holding the note, while nidhi releases every
#     voice playing it. A retriggered note left a naad slot busy forever, and polyphony
#     collapsed until all_notes_off: after three retriggered notes, a 4-voice engine played a
#     3-note chord on 2 voices.
#   * a choke cut and a voice ending on its own (the envelope reaching IDLE, a one-shot running
#     off its sample) never reached naad at all.
# Syncing just before naad allocates makes every one of those unrepresentable. It costs one pass
# over the voices per note_on and allocates nothing.
fn n_engine_sync_voice_mgr(e) {
    var vm = NSamplerEngine_voice_mgr(e);
    if (vm <= 0) { return 0; }
    var nvv = VoiceManager_voices(vm);
    var voices = NSamplerEngine_voices(e);
    var n = vec_len(nvv);
    if (vec_len(voices) < n) { n = vec_len(voices); }
    var i = 0;
    while (i < n) {
        Voice_set_active(vec_get(nvv, i), NSamplerVoice_active(vec_get(voices, i)));
        i = i + 1;
    }
    return 0;
}

# note_on(note, velocity) -> voice index, or -1.
#must_use
fn n_engine_note_on(e, note, velocity) {
    var inst = NSamplerEngine_instrument(e);
    # `<= 0`: sf2_parse and n_load_wav return NEGATIVE codes, which an `== 0` guard lets
    # straight through into NInstrument_zones.
    if (inst <= 0) { return 0 - 1; }
    # Round-robin selection (docs/adr/0012-round-robin-plays.md). The oracle's note_on played
    # find_zones(..)[0], the first match, so its own find_zone_rr, SFZ `seq_position` and every
    # zone group were parsed, stored and never heard. For an unsequenced, ungrouped zone set
    # this is the first match, exactly as before. No allocation: find_zone_rr is two passes over
    # the zones (a group's counter slot is sized when its zone is added).
    var zone_idx = n_instrument_find_zone_rr(inst, note, velocity);
    if (zone_idx < 0) { return 0 - 1; }
    var zones = NInstrument_zones(inst);
    var zone = vec_get(zones, zone_idx);

    var sr = NSamplerEngine_sample_rate(e);
    var speed = n_zone_playback_ratio(zone, note);
    # The sample's own rate. The oracle never read it (playback_ratio has no rate term), so a
    # 48 kHz sample in a 44.1 kHz engine played 1.47 semitones flat and a 22,050 Hz SF2 sample
    # an octave high. See docs/adr/0009-playback-speed-includes-sample-rate.md. Skipped when the
    # rates match, so those voices keep their exact speed bits.
    speed = n_engine_rate_scaled(speed, n_sample_bank_get(NSamplerEngine_bank(e), NZone_sample_id(zone)), sr);
    # Per-zone volume, applied at note-on. See docs/adr/0004-apply-zone-volume-db.md.
    #
    # NZone_volume_db was parsed from SFZ `volume=`, inherited through <group>/<global>, and
    # stored -- and then read by nothing. A `<region> volume=-6` rendered at full level, and
    # the RELATIVE balance a multi-region instrument encodes was silently discarded. The
    # oracle had the same gap, so this is a deliberate divergence, not a parity repair.
    #
    # Folded in here rather than per sample: the zone's volume cannot change for the life of
    # a voice, so this costs one f64_pow per note-on and nothing per frame.
    var amp = n_velocity_curve_apply(NZone_vel_curve(zone), velocity);
    # Clamped here, where it is applied, so the stored field keeps the oracle's raw value.
    var vol_db = n_volume_db_clamp(NZone_volume_db(zone));
    if (vol_db != 0) { amp = f64_mul(amp, naad_db_to_amplitude(vol_db)); }
    var f_cutoff = NZone_filter_cutoff(zone);
    var f_res = NZone_filter_resonance(zone);
    var f_type = NZone_filter_type(zone);
    var f_vel = NZone_filter_vel_track(zone);
    # `<= 0`, not `== 0`: a negative code written through NZone_set_adsr is no config either,
    # and n_amp_envelope_rearm would read it as a pointer.
    var adsr_config = NZone_adsr(zone);
    if (adsr_config <= 0) { adsr_config = NSamplerEngine_default_adsr(e); }
    var choke = NZone_choke_group(zone);
    var sample_offset = NZone_sample_offset(zone);
    var fileg_config = NZone_fileg(zone);
    var fileg_depth = NZone_fileg_depth(zone);
    var plfo_rate = NZone_pitchlfo_rate(zone);
    var plfo_depth = NZone_pitchlfo_depth(zone);
    var flfo_rate = NZone_fillfo_rate(zone);
    var flfo_depth = NZone_fillfo_depth(zone);
    var keytrack = NZone_fil_keytrack(zone);

    # choke: hard-cut active voices in the same choke group (before allocation)
    if (choke > 0) {
        var voices0 = NSamplerEngine_voices(e);
        var nv0 = vec_len(voices0);
        var ci = 0;
        while (ci < nv0) {
            var cv = vec_get(voices0, ci);
            if (NSamplerVoice_active(cv) == 1) { if (NSamplerVoice_choke_group(cv) == choke) { NSamplerVoice_set_active(cv, 0); } }
            ci = ci + 1;
        }
    }

    n_engine_sync_voice_mgr(e);
    var vidx = voice_manager_note_on(NSamplerEngine_voice_mgr(e), note, f64_div(f64_from(velocity), f64_from(127)));
    if (vidx < 0) { return 0 - 1; }
    # naad's voice count and nidhi's vec can disagree; never index on naad's word alone.
    if (vidx >= vec_len(NSamplerEngine_voices(e))) { return 0 - 1; }

    var voice = vec_get(NSamplerEngine_voices(e), vidx);
    NSamplerVoice_set_active(voice, 1);
    NSamplerVoice_set_zone_index(voice, zone_idx);
    NSamplerVoice_set_position(voice, f64_from(sample_offset));
    NSamplerVoice_set_speed(voice, speed);
    NSamplerVoice_set_amplitude(voice, amp);
    NSamplerVoice_set_note(voice, note);
    NSamplerVoice_set_age(voice, 0);
    NSamplerVoice_set_forward(voice, 1);
    # Re-arm the voice's own filter rather than allocating a new one per note.
    n_ignore(nvf_reinit(NSamplerVoice_filter(voice), f_cutoff, f_res, f_type, f_vel, velocity, sr));
    # Key tracking is folded in HERE rather than recomputed per sample. Both inputs -- the
    # voice's note and its fil_keytrack -- are written once at note_on and never mutated, so
    # the factor is voice-invariant, and the render path was paying an f64_pow (an x87 ln+exp
    # pair) for it on every sample of every voice. Multiplication order is unchanged:
    # (base * keytrack) * env * lfo, exactly as before, so output is bit-identical.
    #
    # Velocity tracking is folded in here too, for the same reason, and because render would
    # otherwise discard it. nvf_reinit applies `1 - vel_track * (1 - velocity/127)` to the SVF's
    # initial cutoff, but the first rendered frame recomputed the cutoff from base_cutoff,
    # which the oracle set to the raw zone cutoff: velocity 16 and velocity 127 were both at
    # 6000 Hz after one frame, so `fil_veltrack` had no audible effect. See
    # docs/adr/0007-filter-velocity-tracking-lasts-the-note.md. With vel_track 0 (the default)
    # the factor is exactly 1.0, so those voices are bit-identical.
    var base_cut = f_cutoff;
    if (f64_gt(f_vel, 0) == 1) {
        var vt_norm = f64_div(f64_from(velocity), f64_from(127));
        base_cut = f64_mul(base_cut, f64_sub(F64_ONE, f64_mul(f_vel, f64_sub(F64_ONE, vt_norm))));
    }
    if (f64_gt(keytrack, 0) == 1) {
        var kt_semis = f64_from(note - 60);
        var kt_c = f64_mul(f64_mul(kt_semis, f64_from(100)), keytrack);
        base_cut = f64_mul(base_cut, f64_pow(f64_from(2), f64_div(kt_c, f64_from(1200))));
    }
    NSamplerVoice_set_base_cutoff(voice, base_cut);
    # Snap the cutoff smoother to THIS note's cutoff. The smoother is per-voice and persistent,
    # so without this a reused voice glides over ~5 ms from the PREVIOUS note's cutoff into the
    # new one -- an audible filter sweep at the start of every note on a busy voice. Exactly the
    # defect filter_svf_reset fixes for the integrator state, one field over.
    #
    # Snapped to base_cut x 0.75, not base_cut: render multiplies the cutoff by
    # (0.5 + brightness * 0.5) before the smoother, and brightness is reset to 0.5 just below.
    # 2.1.1 to 2.2.1 snapped to base_cut, so every filtered note opened with a ~25 ms sweep from
    # base_cut down to 0.75 of it. 0.75 = 0x3FE8000000000000, exactly what render computes.
    var csm = NSamplerVoice_cutoff_smoother(voice);
    if (csm > 0) {
        smoothing_set_target(csm, f64_mul(base_cut, 0x3FE8000000000000));
        smoothing_snap(csm);
    }
    NSamplerVoice_set_pitch_bend(voice, 0);
    NSamplerVoice_set_pressure(voice, 0);
    NSamplerVoice_set_brightness(voice, F64_HALF);
    NSamplerVoice_set_choke_group(voice, choke);

    if (fileg_config > 0) {
        var fenv = NSamplerVoice_filter_env(voice);
        n_ignore(n_amp_envelope_rearm(fenv, fileg_config, sr));
        n_amp_envelope_trigger(fenv);
        NSamplerVoice_set_filter_env_depth(voice, fileg_depth);
    } else {
        NSamplerVoice_set_filter_env_depth(voice, 0);
    }

    # Re-arm the voice's own LFOs. `modulation_lfo_set_frequency` validates exactly as the
    # constructor does; `Lfo_set_phase(.,0)` is the phase reset naad has no named function for,
    # and is the same generated accessor naad's own constructor uses. nidhi only ever builds
    # SINE LFOs, whose output depends on phase and frequency alone -- the sample-and-hold
    # rng/latch fields are untouched by this shape.
    # A zero depth is what disables the LFO, so a live pointer with depth 0 is inert.
    var plfo = NSamplerVoice_pitch_lfo(voice);
    var p_depth = plfo_depth;
    if (plfo > 0) {
        if (f64_gt(plfo_rate, 0) == 1) {
            if (naad_is_err(modulation_lfo_set_frequency(plfo, plfo_rate)) == 1) { p_depth = 0; }
            Lfo_set_phase(plfo, 0);
        } else {
            p_depth = 0;
        }
    } else {
        p_depth = 0;
    }
    var flfo = NSamplerVoice_filter_lfo(voice);
    var f_depth = flfo_depth;
    if (flfo > 0) {
        if (f64_gt(flfo_rate, 0) == 1) {
            if (naad_is_err(modulation_lfo_set_frequency(flfo, flfo_rate)) == 1) { f_depth = 0; }
            Lfo_set_phase(flfo, 0);
        } else {
            f_depth = 0;
        }
    } else {
        f_depth = 0;
    }
    NSamplerVoice_set_pitch_lfo_depth(voice, p_depth);
    NSamplerVoice_set_filter_lfo_depth(voice, f_depth);
    NSamplerVoice_set_fil_keytrack(voice, keytrack);

    var aenv = NSamplerVoice_amp_env(voice);
    n_ignore(n_amp_envelope_rearm(aenv, adsr_config, sr));
    n_amp_envelope_trigger(aenv);

    return vidx;
}

fn n_engine_note_off(e, note) {
    voice_manager_note_off(NSamplerEngine_voice_mgr(e), note);
    var voices = NSamplerEngine_voices(e);
    var nv = vec_len(voices);
    var i = 0;
    while (i < nv) {
        var v = vec_get(voices, i);
        if (NSamplerVoice_active(v) == 1) {
            if (NSamplerVoice_note(v) == note) {
                if (n_amp_envelope_is_active(NSamplerVoice_amp_env(v)) == 1) {
                    n_amp_envelope_release(NSamplerVoice_amp_env(v));
                    if (NSamplerVoice_filter_env(v) != 0) { n_amp_envelope_release(NSamplerVoice_filter_env(v)); }
                }
            }
        }
        i = i + 1;
    }
    return 0;
}

fn n_engine_all_notes_off(e) {
    voice_manager_all_notes_off(NSamplerEngine_voice_mgr(e));
    var voices = NSamplerEngine_voices(e);
    var nv = vec_len(voices);
    var i = 0;
    while (i < nv) {
        var v = vec_get(voices, i);
        if (NSamplerVoice_active(v) == 1) {
            if (n_amp_envelope_is_active(NSamplerVoice_amp_env(v)) == 1) {
                n_amp_envelope_release(NSamplerVoice_amp_env(v));
                if (NSamplerVoice_filter_env(v) != 0) { n_amp_envelope_release(NSamplerVoice_filter_env(v)); }
            }
        }
        i = i + 1;
    }
    return 0;
}

# advance_position -> 1 to keep the voice, 0 to deactivate. speed here is the effective (bent) speed.
fn n_advance_position(voice, loop_mode, loop_start, loop_end, frames, released) {
    var eff_end = f64_from(frames);
    if (loop_end > 0) { eff_end = f64_from(loop_end); }
    var speed = NSamplerVoice_speed(voice);
    var pos = NSamplerVoice_position(voice);
    if (loop_mode == LOOP_ONESHOT) {
        pos = f64_add(pos, speed);
        NSamplerVoice_set_position(voice, pos);
        if (f64_ge(pos, f64_from(frames)) == 1) { return 0; }
        return 1;
    }
    if (loop_mode == LOOP_FORWARD) {
        pos = f64_add(pos, speed);
        if (f64_ge(pos, eff_end) == 1) { pos = f64_from(loop_start); }
        NSamplerVoice_set_position(voice, pos);
        return 1;
    }
    if (loop_mode == LOOP_PINGPONG) {
        if (NSamplerVoice_forward(voice) == 1) {
            pos = f64_add(pos, speed);
            if (f64_ge(pos, eff_end) == 1) { NSamplerVoice_set_forward(voice, 0); }
        } else {
            pos = f64_sub(pos, speed);
            if (f64_le(pos, f64_from(loop_start)) == 1) { NSamplerVoice_set_forward(voice, 1); }
        }
        NSamplerVoice_set_position(voice, pos);
        return 1;
    }
    if (loop_mode == LOOP_REVERSE) {
        pos = f64_sub(pos, speed);
        NSamplerVoice_set_position(voice, pos);
        if (f64_lt(pos, 0) == 1) { return 0; }
        return 1;
    }
    # LOOP_SUSTAIN
    pos = f64_add(pos, speed);
    NSamplerVoice_set_position(voice, pos);
    if (released == 1) {
        if (f64_ge(pos, f64_from(frames)) == 1) { return 0; }
    } else {
        if (f64_ge(pos, eff_end) == 1) { NSamplerVoice_set_position(voice, f64_from(loop_start)); }
    }
    return 1;
}

# render one active voice, adding its stereo contribution to accum2 (2 f64 slots).
fn n_engine_render_voice(voice, zones, bank, sr, accum2, scratch, xscratch, fscratch) {
    NSamplerVoice_set_age(voice, NSamplerVoice_age(voice) + 1);
    # n_engine_set_instrument swaps the pointer without re-resolving live voices, so a
    # patch change on a sustaining note can leave zone_index past the end of the NEW zone
    # vec (8-zone piano at zone 5 -> 1-zone patch) -> _vec_die -> exit(1) mid-render.
    # Deactivating mirrors the sample guard two lines below -- the house pattern.
    var zi = NSamplerVoice_zone_index(voice);
    if (zi >= vec_len(zones)) { NSamplerVoice_set_active(voice, 0); return 0; }
    var zone = vec_get(zones, zi);
    var sample = n_sample_bank_get(bank, NZone_sample_id(zone));
    if (sample <= 0) { NSamplerVoice_set_active(voice, 0); return 0; }
    var frames = NSample_frames(sample);
    var eff_frames = frames;
    if (NZone_sample_end(zone) > 0) { if (NZone_sample_end(zone) < eff_frames) { eff_frames = NZone_sample_end(zone); } }

    # pitch modulation
    #
    # Both LFOs are gated on DEPTH, as the oracle gated their construction (rate > 0 and depth
    # != 0). Since 2.1.1 every voice owns persistent LFOs, so gating on the pointer evaluated a
    # sine per LFO per voice per frame at depth 0. A skipped tick is unobservable: a depth fixed
    # at 0 for the voice's life multiplies the value away, and note_on resets the phase. Output
    # is bit-identical; plain voices render 23-29 % faster and low-pass filtered ones 34 %.
    var pitch_mod_cents = f64_mul(NSamplerVoice_pitch_bend(voice), f64_from(100));
    var plfo = NSamplerVoice_pitch_lfo(voice);
    var pdep = NSamplerVoice_pitch_lfo_depth(voice);
    if (pdep != 0) {
        if (plfo != 0) {
            pitch_mod_cents = f64_add(pitch_mod_cents, f64_mul(modulation_lfo_next_value(plfo), pdep));
        }
    }
    var eff_speed = NSamplerVoice_speed(voice);
    if (pitch_mod_cents != 0) {
        eff_speed = f64_mul(NSamplerVoice_speed(voice), f64_pow(f64_from(2), f64_div(pitch_mod_cents, f64_from(1200))));
        # A NaN bend (apply_pitch_bend takes it unclamped), an SFZ pitchlfo_depth=nan, or a
        # finite bend large enough to overflow the power made the position NaN for good: the
        # voice stayed active and silent until note-off, even after the bend returned to 0.
        # Fall back to the unbent speed for this frame.
        if (n_is_finite(eff_speed) == 0) { eff_speed = NSamplerVoice_speed(voice); }
    }

    # read interpolated source
    n_sample_read_stereo_interpolated(sample, NSamplerVoice_position(voice), scratch);
    var sl = load64(scratch);
    var srr = load64(scratch + 8);

    # loop crossfade (Forward / LoopSustain, crossfade_length > 0)
    #
    # DIVERGENCE from the oracle, deliberate -- see docs/adr/0001-loop-crossfade-seam.md.
    #
    # rust-old reads the fade-in source from `loop_start + (xfade - dist)`, which walks
    # FORWARD from loop_start as the playhead approaches loop_end. At the wrap itself
    # (dist = 0) that lands on `loop_start + xfade`, and the very next frame -- now wrapped
    # -- plays `loop_start`. So the seam ends on a jump of xfade samples backwards: the
    # crossfade attenuates the click without ever closing it.
    #
    # The material that must FOLLOW loop_end is the material that PRECEDES loop_start,
    # because that is what naturally leads into loop_start. So the source walks backward
    # from loop_start: `loop_start - dist`, reaching exactly loop_start at the wrap, where
    # the post-wrap playhead also sits. The seam closes.
    #
    # Two clamps make it safe, and both are load-bearing:
    #   * against the loop length -- a crossfade longer than the loop was live from frame 0
    #     and the loop's own material was never heard at full level.
    #   * against loop_start -- there is no material before sample frame 0, and reading there
    #     returns zero-padding, so an unclamped backward fade would blend in SILENCE and
    #     attenuate the loop by up to 50%. This is why the naive fix is wrong on its own.
    #
    # When loop_start < xfade there is genuinely no pre-roll to fade from, and no crossfade
    # can close a seam whose two endpoints differ -- only moving the wrap point could, which
    # would change the loop's period and therefore its pitch. Rather than disable the fade
    # (measurably WORSE than shipping nothing: a ramp loop at loop_start=0 went from a
    # 0.028 seam to 0.199), that case keeps the legacy forward blend. So: closure where it
    # is achievable, never worse than 2.0.2 where it is not.
    var xfade = NZone_crossfade_length(zone);
    if (xfade > 0) {
        var lm0 = NZone_loop_mode(zone);
        var do_xf = 0;
        if (lm0 == LOOP_FORWARD) { do_xf = 1; }
        # A released LoopSustain voice plays straight through loop_end into the sample's tail,
        # so there is no wrap to hide, and fading loop_start material in there MADE a seam: a
        # 100x jump on a ramp. See docs/adr/0008-released-sustain-loop-skips-the-crossfade.md.
        if (lm0 == LOOP_SUSTAIN) {
            if (n_amp_envelope_is_releasing(NSamplerVoice_amp_env(voice)) == 0) { do_xf = 1; }
        }
        if (do_xf == 1) {
            var ls_i = NZone_loop_start(zone);
            var le_i = eff_frames;
            if (NZone_loop_end(zone) > 0) { le_i = NZone_loop_end(zone); }
            var xf_i = xfade;
            var loop_len = le_i - ls_i;
            if (xf_i > loop_len) { xf_i = loop_len; }
            if (xf_i > 0) {
                var have_preroll = 0;
                if (ls_i >= xf_i) { have_preroll = 1; }
                var loop_end_f = f64_from(le_i);
                var xfade_f = f64_from(xf_i);
                var dist = f64_sub(loop_end_f, NSamplerVoice_position(voice));
                if (f64_ge(dist, 0) == 1) {
                    if (f64_lt(dist, xfade_f) == 1) {
                        var t = f64_div(dist, xfade_f);
                        var xfade_pos = f64_add(f64_from(ls_i), f64_sub(xfade_f, dist));
                        if (have_preroll == 1) { xfade_pos = f64_sub(f64_from(ls_i), dist); }
                        n_sample_read_stereo_interpolated(sample, xfade_pos, xscratch);
                        sl = f64_add(f64_mul(sl, t), f64_mul(load64(xscratch), f64_sub(F64_ONE, t)));
                        srr = f64_add(f64_mul(srr, t), f64_mul(load64(xscratch + 8), f64_sub(F64_ONE, t)));
                    }
                }
            }
        }
    }

    # filter cutoff modulation (only when base_cutoff > 0)
    if (f64_gt(NSamplerVoice_base_cutoff(voice), 0) == 1) {
        # base_cutoff already carries the key-tracking factor -- folded in at note_on, where
        # its two inputs are fixed for the voice's life.
        var cutoff = NSamplerVoice_base_cutoff(voice);
        # Gate on DEPTH, not on the pointer: since 2.1.1 every voice owns a persistent filter
        # envelope, so the pointer is always live and a zero depth is what disables it.
        var fenv = NSamplerVoice_filter_env(voice);
        if (NSamplerVoice_filter_env_depth(voice) != 0) {
            var mod_cents = f64_mul(NSamplerVoice_filter_env_depth(voice), n_amp_envelope_tick(fenv));
            cutoff = f64_mul(cutoff, f64_pow(f64_from(2), f64_div(mod_cents, f64_from(1200))));
        }
        var flfo = NSamplerVoice_filter_lfo(voice);
        var fdep = NSamplerVoice_filter_lfo_depth(voice);
        if (fdep == 0) { flfo = 0; }
        if (flfo != 0) {
            var lfo_cents = f64_mul(modulation_lfo_next_value(flfo), fdep);
            cutoff = f64_mul(cutoff, f64_pow(f64_from(2), f64_div(lfo_cents, f64_from(1200))));
        }
        cutoff = f64_mul(cutoff, f64_add(F64_HALF, f64_mul(NSamplerVoice_brightness(voice), F64_HALF)));
        var smoother = NSamplerVoice_cutoff_smoother(voice);
        smoothing_set_target(smoother, cutoff);
        cutoff = smoothing_next_value(smoother);
        nvf_set_cutoff(NSamplerVoice_filter(voice), cutoff, sr);
    }

    # stereo filter
    nvf_process_stereo(NSamplerVoice_filter(voice), sl, srr, fscratch);
    sl = load64(fscratch);
    srr = load64(fscratch + 8);

    # amplitude envelope
    var env = n_amp_envelope_tick(NSamplerVoice_amp_env(voice));
    if (n_amp_envelope_is_active(NSamplerVoice_amp_env(voice)) == 0) {
        NSamplerVoice_set_active(voice, 0);
        return 0;
    }

    # pressure, gain, pan
    # 0.4 = 0x3FD999999999999A, the value f64_div(4, 10) computed on every frame.
    var pressure_mod = f64_add(F64_ONE, f64_mul(f64_sub(NSamplerVoice_pressure(voice), F64_HALF), 0x3FD999999999999A));
    var amp = f64_mul(f64_mul(NSamplerVoice_amplitude(voice), env), pressure_mod);
    var pan = NZone_pan(zone);
    var pan_l = f64_mul(f64_sub(F64_ONE, pan), F64_HALF);
    var pan_r = f64_mul(f64_add(F64_ONE, pan), F64_HALF);
    store64(accum2, f64_add(load64(accum2), f64_mul(f64_mul(sl, amp), pan_l)));
    store64(accum2 + 8, f64_add(load64(accum2 + 8), f64_mul(f64_mul(srr, amp), pan_r)));

    # advance read cursor with the pitch-bent speed
    var saved_speed = NSamplerVoice_speed(voice);
    NSamplerVoice_set_speed(voice, eff_speed);
    var released = n_amp_envelope_is_releasing(NSamplerVoice_amp_env(voice));
    if (n_advance_position(voice, NZone_loop_mode(zone), NZone_loop_start(zone), NZone_loop_end(zone), eff_frames, released) == 0) {
        NSamplerVoice_set_active(voice, 0);
    }
    NSamplerVoice_set_speed(voice, saved_speed);
    return 0;
}

# next_sample_stereo -> writes out2[0]=L, out2[1]=R.
fn n_engine_next_sample_stereo(e, out2) {
    store64(out2, 0);
    store64(out2 + 8, 0);
    var inst = NSamplerEngine_instrument(e);
    # `<= 0`, not `== 0`: sf2_parse and n_load_wav return NEGATIVE codes, and a consumer
    # forwarding one unchecked would sail past an `== 0` guard into NInstrument_zones(-5).
    if (inst <= 0) { return 0; }
    var zones = NInstrument_zones(inst);
    var bank = NSamplerEngine_bank(e);
    var sr = NSamplerEngine_sample_rate(e);
    var scratch = NSamplerEngine_rv_scratch(e);
    var xscratch = NSamplerEngine_rv_xscratch(e);
    var fscratch = NSamplerEngine_rv_fscratch(e);
    var voices = NSamplerEngine_voices(e);
    var nv = vec_len(voices);
    var vi = 0;
    while (vi < nv) {
        var voice = vec_get(voices, vi);
        if (NSamplerVoice_active(voice) == 1) {
            n_engine_render_voice(voice, zones, bank, sr, out2, scratch, xscratch, fscratch);
        }
        vi = vi + 1;
    }
    return 0;
}

#must_use
fn n_engine_next_sample(e) {
    var o = NSamplerEngine_ns_out(e);
    n_engine_next_sample_stereo(e, o);
    return f64_mul(f64_add(load64(o), load64(o + 8)), F64_HALF);
}

# fill_buffer(buf vec, n): mono, each element = next_sample.
# `n` is clamped to the buffer. Rust derived the frame count FROM buffer.len(), so a caller
# could not ask for more than it supplied; the port took a separate length and trusted it, and
# vec_set past the end is _vec_die -> exit(1) inside the audio callback.
fn n_engine_fill_buffer(e, buf, n) {
    var lim = n;
    if (lim > vec_len(buf)) { lim = vec_len(buf); }
    var i = 0;
    while (i < lim) { vec_set(buf, i, n_engine_next_sample(e)); i = i + 1; }
    return 0;
}

# fill_buffer_stereo(buf vec, len): interleaved stereo, rendered per-frame (output-identical
# to the Rust per-voice block render).
fn n_engine_fill_buffer_stereo(e, buf, len) {
    var lim = len;
    if (lim > vec_len(buf)) { lim = vec_len(buf); }
    var frames = lim / 2;
    var o = NSamplerEngine_ns_out(e);
    var f = 0;
    while (f < frames) {
        n_engine_next_sample_stereo(e, o);
        vec_set(buf, f * 2, load64(o));
        vec_set(buf, f * 2 + 1, load64(o + 8));
        f = f + 1;
    }
    return 0;
}
