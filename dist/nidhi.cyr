# --- error.cyr ---

# error.cyr -- nidhi error codes
# Requires: (nothing -- pure integer constants + a predicate)
#
# Ports the Rust `NidhiError` enum to negative integer error codes, matching the
# naad/hisab/shravan ecosystem convention (functions return 0/NIDHI_ERR_NONE or a
# valid pointer on success, a negative NIDHI_ERR_* on failure). The Rust variants'
# String payloads are dropped -- the code IS the error. (Serde is NOT ported: this note
# used to claim config types carry `#derive(Serialize)` and pointed at zone.cyr, which
# never had it. See docs/adr/0003-serde-is-not-ported.md.)
#
# The `NIDHI_` prefix is mandatory, not decorative: dist/nidhi.cyr is concatenated
# into a FLAT namespace alongside naad/goonj/shravan/sankoch, and a bare `ERR_NONE`
# collides with `lib/goonj.cyr` and shravan's `enum ShravanErr`. They all happen to
# be 0 today, which is exactly what makes it dangerous -- the clash is invisible
# until one side renumbers. naad escaped the same trap in 2.2.0 (ERR_* ->
# NAAD_ERR_*); this is nidhi's half. See docs/port/26-mod-io-bench.md, which
# specified `NIDHI_ERR_IMPORT` from the start.
#
# Rust variant           -> code
#   (ok)                 ->  NIDHI_ERR_NONE              =  0
#   SampleNotFound(id)   ->  NIDHI_ERR_SAMPLE_NOT_FOUND  = -1
#   InvalidZone(msg)     ->  NIDHI_ERR_INVALID_ZONE      = -2
#   InvalidParameter{..} ->  NIDHI_ERR_INVALID_PARAMETER = -3
#   Playback(msg)        ->  NIDHI_ERR_PLAYBACK          = -4
#   ImportError(msg)     ->  NIDHI_ERR_IMPORT            = -5

var NIDHI_ERR_NONE              = 0;
var NIDHI_ERR_SAMPLE_NOT_FOUND  = (0 - 1);
var NIDHI_ERR_INVALID_ZONE      = (0 - 2);
var NIDHI_ERR_INVALID_PARAMETER = (0 - 3);
var NIDHI_ERR_PLAYBACK          = (0 - 4);
var NIDHI_ERR_IMPORT            = (0 - 5);

# n_is_err -- 1 if `code` is a nidhi error (negative), else 0.
#must_use
fn n_is_err(code) {
    if (code < 0) { return 1; }
    return 0;
}

# --- f64_util.cyr ---

# f64_util.cyr -- nidhi f64 helpers (self-contained, no naad dependency)
# Requires: math (f64_abs, f64_lt), alloc + vec (n_vec_with_cap)
#
# f64 values are IEEE-754 bit patterns in i64 slots. nidhi's Rust is written in
# f32 but Cyrius has only f64 (ADR-002: everything is i64) -- every f32 becomes an
# f64 bit-pattern here, matching how naad/shravan store audio samples (vecs of f64).
# Symbols are `n_`-prefixed so they never collide with naad's `flush_denormal` in
# the flat concatenated bundle namespace.

# f32::MIN_POSITIVE (smallest positive normal f32 = 2^-126) as an f64 bit pattern.
# Used as the denormal-flush threshold to match the Rust crate-root helper exactly.
var N_F32_MIN_POS = 0x3810000000000000;

# f32::EPSILON (2^-23 ~= 1.1920929e-7) as an f64 bit pattern. Shared tolerance for
# "approximately equal" checks that the Rust code did against f32::EPSILON.
var N_F32_EPSILON = 0x3E80000000000000;

# n_is_finite(x) -- 1 if the f64 bit pattern x is finite (not +/-Inf, not NaN), else 0.
# Non-finite <=> the 11 exponent bits are all set (0x7FF).
#must_use
fn n_is_finite(x) {
    if ((x & 0x7FF0000000000000) == 0x7FF0000000000000) { return 0; }
    return 1;
}

# n_pos_in_range(x) -> 1 when |x| < 2^53, the most a read position can be and still survive
# f64_to + idx +/- 2 without wrapping. NaN and +/-Inf answer 0 too: with the sign masked off,
# IEEE-754 magnitudes order as integers, and both sit above every finite value. Same cost as
# n_is_finite, one mask and one compare.
fn n_pos_in_range(x) {
    if ((x & 0x7FFFFFFFFFFFFFFF) >= 0x4340000000000000) { return 0; }
    return 1;
}

# n_flush_denormal -- flush subnormal-magnitude values to +0.0 to avoid the 10-100x
# x86 slowdown on denormals. Mirrors Rust `flush_denormal`:
#   if x.abs() < f32::MIN_POSITIVE { 0.0 } else { x }
# (+0.0 has bit pattern 0, so `return 0` is the correct f64 zero.)
#must_use
fn n_flush_denormal(x) {
    if (f64_lt(f64_abs(x), N_F32_MIN_POS) == 1) { return 0; }
    return x;
}

# n_round_half_away(x) -- round to nearest, ties AWAY FROM ZERO. Matches Rust's f64::round().
#
# Cyrius's builtin f64_round is round-half-to-EVEN (verified: 0.5 -> 0, 1.5 -> 2, 2.5 -> 2,
# 3.5 -> 4), which is the IEEE default and NOT what Rust does (0.5 -> 1, 2.5 -> 3). Every
# `.round()` in the oracle therefore mis-ported, and each one sets a stretched buffer's
# target length -- so any (input_len * ratio) landing exactly on .5 produced an output one
# frame shorter than Rust's.
#
# Computed from floor/ceil rather than floor(x + 0.5), which is subtly wrong: for
# x = 0.49999999999999994 the addition rounds up to exactly 1.0 and floor then yields 1.
#must_use
fn n_round_half_away(x) {
    if (f64_lt(x, 0) == 1) {
        var c = f64_ceil(x);
        if (f64_ge(f64_sub(c, x), F64_HALF) == 1) { return f64_sub(c, F64_ONE); }
        return c;
    }
    var f = f64_floor(x);
    if (f64_ge(f64_sub(x, f), F64_HALF) == 1) { return f64_add(f, F64_ONE); }
    return f;
}

# n_vec_with_cap(n) -> an empty vec with room for exactly n elements, or 0 when it cannot be
# allocated (n past VEC_CAP_MAX included). For a sample buffer whose final length is known before
# the first push: vec_push from vec_new() doubles 16 -> n, and since alloc never frees, every
# outgrown buffer stays allocated -- a 1M-sample PCM vec cost 16.78 MB of heap that way against
# 8.00 MB here. Shared by sf2.cyr and io.cyr, which cannot see each other (sf2's tests link no
# shravan), so it lives in the one module both include.
#
# The {data, len, cap} header is lib/vec.cyr's own (vec_new_a writes the same three slots), so
# vec_push/vec_get treat the result as any other vec and still grow it past n. A caller that
# fills the buffer through load64(v) instead of vec_push stores the final length at v + 8.
#must_use
fn n_vec_with_cap(n) {
    if (n <= 0) { return vec_new(); }
    if (n > VEC_CAP_MAX) { return 0; }
    var v = alloc(24);
    if (v == 0) { return 0; }
    var data = alloc(n * 8);
    if (data == 0) { return 0; }
    store64(v, data);
    store64(v + 8, 0);
    store64(v + 16, n);
    return v;
}

