# fuzz_sfz.fcyr -- never-crash fuzz for the SFZ parser (ports rust-old/fuzz/fuzz_sfz).
# Invariant: n_sfz_parse + n_sfz_to_zones(44100) + n_sfz_to_instrument("fuzz", 44100) must never
# crash on ANY input. Feeds pure-random text, byte-mutated valid SFZ (with a broad opcode set), and
# (2.2.2) splices of fragments aimed at the byte-level scanner: multi-byte White_Space sequences,
# truncated ones at line and buffer ends, quote runs, repeated #include, and usize edge values.
# Second invariant (2.2.2): parse heap stays linear, <= 96 bytes per input byte + 8 KB. The worst
# legitimate shape is back-to-back `<group>` / `<region>` headers (~460 B per 8-byte header).
# This is a backstop against super-linear allocation only: inputs this short cannot expose the
# 124 B-per-byte line overhead 2.2.2 removed (the 8 KB slack absorbs it), so that one is pinned by
# tests/sfz.tcyr on a 256 KB input instead.
# Run: cyrius fuzz   (or: cyrius build fuzz/fuzz_sfz.fcyr build/fuzz_sfz && ./build/fuzz_sfz)

include "lib/hisab.cyr"
include "lib/goonj.cyr"
include "lib/naad.cyr"
include "src/error.cyr"
include "src/f64_util.cyr"
include "src/loop_mode.cyr"
include "src/envelope.cyr"
include "src/zone.cyr"
include "src/sample.cyr"
include "src/instrument.cyr"
include "src/sfz.cyr"

var FUZZ_RNG = 0;
fn rng_seed(s) { FUZZ_RNG = s; return 0; }
fn rng_next() {
    var x = FUZZ_RNG;
    x = x ^ (x << 13);
    x = x ^ (x >> 7);
    x = x ^ (x << 17);
    FUZZ_RNG = x;
    return x & 0x7FFFFFFFFFFFFFFF;
}
fn rng_range(n) { if (n <= 0) { return 0; } return rng_next() % n; }
fn rng_byte() { return rng_next() & 0xFF; }

# A valid SFZ blob exercising a broad opcode set (headers, inheritance, note names, ranges,
# loop/filter/envelope/lfo/cc/output/default_path/include).
var SFZ_TEMPLATE = 0;

var FUZZ_FRAGS = 0;
var FUZZ_NFRAGS = 0;

fn fuzz_one(cstr) {
    var len = strlen(cstr);
    var a0 = alloc_used();
    var f = n_sfz_parse(cstr);
    var used = alloc_used() - a0;
    if (used > 96 * len + 8192) {
        println("fuzz_sfz: parse heap not linear in input");
        println_int(len);
        println_int(used);
        syscall(60, 1);
    }
    n_sfz_to_zones(f, f64_from(44100));
    n_sfz_to_instrument(f, str_from("fuzz"), f64_from(44100));
    return 0;
}

fn fuzz_frag(k) {
    return load64(FUZZ_FRAGS + k * 8);
}

fn fuzz_frags_init() {
    var list = vec_new();
    vec_push(list, "\xC2"); vec_push(list, "\xC2\xA0"); vec_push(list, "\xC2\x85");
    vec_push(list, "\xE2\x80"); vec_push(list, "\xE2\x80\xA8"); vec_push(list, "\xE2\x80\x8A");
    vec_push(list, "\xE2\x81\x9F"); vec_push(list, "\xE3\x80\x80"); vec_push(list, "\xE1\x9A\x80");
    vec_push(list, "\x0B"); vec_push(list, "\x0C"); vec_push(list, "\r"); vec_push(list, "\n");
    vec_push(list, " "); vec_push(list, "\""); vec_push(list, "#include"); vec_push(list, "//");
    vec_push(list, "<region>"); vec_push(list, "<group>"); vec_push(list, "<control>"); vec_push(list, "<global>");
    vec_push(list, "sample="); vec_push(list, "a.wav"); vec_push(list, "default_path="); vec_push(list, "=");
    vec_push(list, "key=c4"); vec_push(list, "lokey=-0"); vec_push(list, "hikey=c4611686018427387903");
    vec_push(list, "offset=18446744073709551615"); vec_push(list, "loop_end=18446744073709551616");
    vec_push(list, "group=-1"); vec_push(list, "seq_position=4097"); vec_push(list, "volume_oncc7=nan");
    vec_push(list, "loop_mode=loop_continuous"); vec_push(list, "fil_type=bpf_2p"); vec_push(list, "x");
    FUZZ_FRAGS = load64(list);
    FUZZ_NFRAGS = vec_len(list);
    return 0;
}

# 1..64 fragments spliced end to end; the buffer ends wherever the last fragment does, so a
# multi-byte sequence is regularly cut off at the very end of the input.
fn fuzz_splice() {
    var n = 1 + rng_range(64);
    var buf = alloc(n * 32 + 1);
    var len = 0;
    var k = 0;
    while (k < n) {
        var fr = fuzz_frag(rng_range(FUZZ_NFRAGS));
        var fl = strlen(fr);
        memcpy(buf + len, fr, fl);
        len = len + fl;
        k = k + 1;
    }
    store8(buf + len, 0);
    fuzz_one(buf);
    return 0;
}

fn fuzz_iter(tmpl_len) {
    var mode = rng_range(3);
    if (mode == 2) { return fuzz_splice(); }
    if (mode == 0) {
        var len = rng_range(256);
        var buf = alloc(len + 1);
        var j = 0; while (j < len) { store8(buf + j, rng_byte()); j = j + 1; }
        store8(buf + len, 0);
        fuzz_one(buf);
    } else {
        var buf = alloc(tmpl_len + 1);
        var j = 0; while (j < tmpl_len) { store8(buf + j, load8(SFZ_TEMPLATE + j)); j = j + 1; }
        store8(buf + tmpl_len, 0);
        var flips = rng_range(12);
        var k = 0; while (k < flips) { store8(buf + rng_range(tmpl_len), rng_byte()); k = k + 1; }
        store8(buf + tmpl_len, 0);
        fuzz_one(buf);
    }
    return 0;
}

fn main() {
    alloc_init();
    SFZ_TEMPLATE = "<control> default_path=samples/\n#include \"x.sfz\"\n<global> volume=-3 ampeg_release=0.1\n<group> lokey=c3 hikey=g5 loop_mode=loop_continuous\n<region> sample=a.wav key=60 pan=25 tune=5 transpose=2 cutoff=2000 resonance=1.5 fil_type=hpf_2p ampeg_attack=0.01 fileg_depth=1200 pitchlfo_freq=5 pitchlfo_depth=50 fil_keytrack=600 output=1 volume_oncc1=6 offset=100 end=5000\n<region> sample=b.wav lokey=48 hikey=59\n";
    rng_seed(0x9E3779B97F4A7C15);
    fuzz_frags_init();
    var tmpl_len = strlen(SFZ_TEMPLATE);
    var iters = 3000;
    var i = 0;
    while (i < iters) { fuzz_iter(tmpl_len); i = i + 1; }
    println("fuzz_sfz: ok (no crash across all inputs)");
    return 0;
}

var r = main();
syscall(60, r);
