# io.tcyr -- parity tests for src/io.cyr (ports rust-old/src/io.rs #[test]s + file/stream round-trip).

include "lib/sankoch.cyr"
include "lib/shravan.cyr"
include "src/error.cyr"
include "src/f64_util.cyr"
include "src/sample.cyr"
include "src/io.cyr"

fn approx(a, b, tol) {
    if (f64_lt(f64_abs(f64_sub(a, b)), tol) == 1) { return 1; }
    return 0;
}

# ch-channel test signal, exact in f32: channel c of frame f is (c + 1) / 16 + f / 1024, and
# channel 1 is negated so a swapped or shifted pair cannot pass for the right one.
fn mc_value(f, c) {
    var v = f64_add(f64_div(f64_from(c + 1), f64_from(16)), f64_div(f64_from(f), f64_from(1024)));
    if (c == 1) { return f64_neg(v); }
    return v;
}

fn mc_wav(channels, frames, out) {
    var v = vec_new();
    var f = 0;
    while (f < frames) {
        var c = 0;
        while (c < channels) { vec_push(v, mc_value(f, c)); c = c + 1; }
        f = f + 1;
    }
    return wav_encode(v, 44100, channels, PCM_F32, out);
}

# 1 when the interleaved stereo vec `d` holds frames [first, first + n) of mc_value's front pair.
fn mc_front_pair_ok(d, first, n) {
    if (vec_len(d) != n * 2) { return 0; }
    var f = 0;
    while (f < n) {
        if (vec_get(d, f * 2) != mc_value(first + f, 0)) { return 0; }
        if (vec_get(d, f * 2 + 1) != mc_value(first + f, 1)) { return 0; }
        f = f + 1;
    }
    return 1;
}

fn write_file(path, buf, len) {
    var fd = file_open(path, O_WRONLY | O_CREAT | O_TRUNC, 420);   # mode 0644
    if (fd < 0) { return 0 - 1; }
    file_write(fd, buf, len);
    file_close(fd);
    return 0;
}

fn main() {
    alloc_init();

    test_group("load_wav_from_memory mono");
    var mono = vec_new();
    vec_push(mono, f64_div(f64_from(1), f64_from(10)));
    vec_push(mono, f64_div(f64_from(2), f64_from(10)));
    vec_push(mono, f64_div(f64_from(3), f64_from(10)));
    vec_push(mono, f64_div(f64_from(4), f64_from(10)));
    var wavbuf = alloc(8192);
    var nbytes = wav_encode(mono, 44100, 1, PCM_F32, wavbuf);
    assert(nbytes > 0, "wav_encode mono produced bytes");
    var sm = n_load_wav_from_memory(wavbuf, nbytes);
    assert(sm > 0, "load mono succeeded (positive ptr)");
    assert_eq(NSample_frames(sm), 4, "mono frames 4");
    assert_eq(NSample_channels(sm), 1, "mono channels 1");
    assert_eq(NSample_sample_rate(sm), 44100, "mono sample_rate 44100");

    test_group("load_wav_from_memory stereo");
    var st = vec_new();
    vec_push(st, f64_div(f64_from(1), f64_from(10)));
    vec_push(st, f64_neg(f64_div(f64_from(1), f64_from(10))));
    vec_push(st, f64_div(f64_from(2), f64_from(10)));
    vec_push(st, f64_neg(f64_div(f64_from(2), f64_from(10))));
    var wavbuf2 = alloc(8192);
    var nbytes2 = wav_encode(st, 48000, 2, PCM_F32, wavbuf2);
    var ss = n_load_wav_from_memory(wavbuf2, nbytes2);
    assert_eq(NSample_frames(ss), 2, "stereo frames 2");
    assert_eq(NSample_channels(ss), 2, "stereo channels 2");
    assert_eq(NSample_sample_rate(ss), 48000, "stereo sample_rate 48000");

    test_group("load_wav_from_memory invalid");
    var badbuf = alloc(4);
    store8(badbuf, 0);
    store8(badbuf + 1, 1);
    store8(badbuf + 2, 2);
    store8(badbuf + 3, 3);
    assert_eq(n_is_err(n_load_wav_from_memory(badbuf, 4)), 1, "invalid bytes -> error");

    # sankoch and shravan both define a global detect_format, and since cyrius 6.6.20 every
    # call binds the LAST definition. cyrius.cyml keeps sankoch above shravan so that is
    # shravan's. Since shravan 2.9.2 its decoders detect through shravan_detect_format, so
    # a reordered manifest fails only this assertion; before that, decode_file refused
    # every audio file and this named the cause.
    test_group("detect_format binds shravan's definition");
    assert_eq(detect_format(wavbuf, nbytes), FMT_WAV, "RIFF -> FMT_WAV (sankoch above shravan in cyrius.cyml)");

    test_group("load_wav file + file_stem");
    write_file("/tmp/nidhi_io_test.wav", wavbuf, nbytes);
    var lw = n_load_wav("/tmp/nidhi_io_test.wav");
    assert(lw > 0, "load_wav succeeded");
    assert_eq(NSample_frames(lw), 4, "load_wav frames 4");
    assert_eq(NSample_channels(lw), 1, "load_wav channels 1");
    assert_eq(str_eq(NSample_name(lw), str_from("nidhi_io_test")), 1, "name == file stem");

    test_group("streaming reader");
    var srd = n_stream_reader_open("/tmp/nidhi_io_test.wav");
    assert(srd > 0, "stream open succeeded");
    assert_eq(NStreamReader_channels(srd), 1, "stream channels 1");
    assert_eq(NStreamReader_sample_rate(srd), 44100, "stream sample_rate 44100");
    assert_eq(NStreamReader_total_frames(srd), 4, "stream total_frames 4");
    var allsmp = n_stream_reader_read_all(srd);
    assert_eq(NSample_frames(allsmp), 4, "stream read_all frames 4");

    # --- 2.0.2 regression: integer PCM decoded to pure silence ---
    # Every fixture above encodes PCM_F32, the one format that needs no scale constant,
    # which is exactly why this went unnoticed. nidhi never called shravan_init_constants(),
    # so shravan's F64_RCP_* were all +0.0 and every integer sample was multiplied by zero.
    # Assert VALUES, not just frame counts -- a frame-count assertion passes on silence.
    test_group("integer PCM decodes to real audio (not silence)");
    var ipcm = vec_new();
    vec_push(ipcm, F64_HALF);
    vec_push(ipcm, f64_neg(F64_HALF));
    vec_push(ipcm, f64_div(F64_ONE, f64_from(4)));
    vec_push(ipcm, f64_div(F64_ONE, f64_from(8)));
    var fmts = vec_new();
    vec_push(fmts, PCM_I8);
    vec_push(fmts, PCM_I16);
    vec_push(fmts, PCM_I24);
    vec_push(fmts, PCM_I32);
    var fi = 0;
    while (fi < vec_len(fmts)) {
        var fmt = vec_get(fmts, fi);
        var ibuf = alloc(8192);
        var ib = wav_encode(ipcm, 44100, 1, fmt, ibuf);
        assert(ib > 0, "integer PCM encoded");
        var ism = n_load_wav_from_memory(ibuf, ib);
        assert(ism > 0, "integer PCM decoded");
        assert_eq(NSample_frames(ism), 4, "integer PCM frames 4");
        var idata = NSample_data(ism);
        var nonzero = 0;
        var k = 0;
        while (k < vec_len(idata)) {
            if (vec_get(idata, k) != 0) { nonzero = nonzero + 1; }
            k = k + 1;
        }
        assert_eq(nonzero, 4, "integer PCM is NOT silence");
        # 8-bit has ~1/256 resolution, so tolerance has to cover the coarsest format.
        var tol = f64_div(F64_ONE, f64_from(50));
        assert_eq(approx(vec_get(idata, 0), F64_HALF, tol), 1, "integer PCM value[0] ~ 0.5");
        assert_eq(approx(vec_get(idata, 1), f64_neg(F64_HALF), tol), 1, "integer PCM value[1] ~ -0.5");
        fi = fi + 1;
    }

    # --- 2.0.2 regression: the streaming reader truncated everything over ~4 KB ---
    # It fed shravan in 4096-byte slices, but that decoder is buffer-then-decode-once and
    # wav_decode clamps the declared data size to what is present -- so the first slice
    # decoded as a complete WAV and every later feed was ignored. 5000 frames came back
    # as 1013. total_frames stayed correct, so the reader disagreed with itself.
    test_group("streaming reader returns the whole file, not the first 4 KB");
    var big = vec_new();
    var bi = 0;
    while (bi < 5000) {
        vec_push(big, f64_div(f64_from(bi % 100), f64_from(200)));
        bi = bi + 1;
    }
    var bigbuf = alloc(131072);
    var bign = wav_encode(big, 44100, 1, PCM_F32, bigbuf);
    assert(bign > 20000, "big fixture is well over one 4096-byte slice");
    write_file("/tmp/nidhi_io_big.wav", bigbuf, bign);
    var bsr = n_stream_reader_open("/tmp/nidhi_io_big.wav");
    assert(bsr > 0, "big stream open succeeded");
    assert_eq(NStreamReader_total_frames(bsr), 5000, "big stream total_frames 5000");
    var ball = n_stream_reader_read_all(bsr);
    assert_eq(NSample_frames(ball), 5000, "big stream read_all returns ALL 5000 frames");
    var bload = n_load_wav("/tmp/nidhi_io_big.wav");
    assert_eq(NSample_frames(bload), NSample_frames(ball), "stream agrees with load_wav");
    var bd = NSample_data(ball);
    var tol2 = f64_div(F64_ONE, f64_from(10000));
    assert_eq(approx(vec_get(bd, 4999), f64_div(f64_from(4999 % 100), f64_from(200)), tol2), 1,
        "last frame survives the stream");

    # --- 2.1.0: the reader decodes once, and chunks are a cursor ---
    # It used to decode the whole file in open() purely for the header, throw the samples
    # away, then feed the entire file back through shravan's stream decoder to recover them.
    test_group("streaming reader decodes once and chunks sequentially (2.1.0)");
    var csr = n_stream_reader_open("/tmp/nidhi_io_big.wav");
    assert(csr > 0, "cursor reader opens");
    assert_eq(NStreamReader_total_frames(csr), 5000, "total_frames from the DECODED data");
    var c1 = n_stream_reader_read_chunk(csr, 1000);
    assert_eq(vec_len(c1), 1000, "first chunk is 1000 mono frames");
    var c2 = n_stream_reader_read_chunk(csr, 1000);
    assert_eq(vec_len(c2), 1000, "second chunk is 1000 frames");
    # The chunks must be SEQUENTIAL, not both from the start.
    assert_eq(approx(vec_get(c2, 0), f64_div(f64_from(1000 % 100), f64_from(200)), tol2), 1,
        "chunk 2 continues where chunk 1 stopped");
    var rest = n_stream_reader_read_chunk(csr, 100000);
    assert_eq(vec_len(rest), 3000, "over-asking returns only what remains");
    assert_eq(vec_len(n_stream_reader_read_chunk(csr, 100)), 0, "exhausted reader returns empty");

    # Peak memory: opening must not cost two decoded copies of the file.
    var before_open = alloc_used();
    var msr = n_stream_reader_open("/tmp/nidhi_io_big.wav");
    assert(msr > 0, "measured reader opens");
    var open_bytes = alloc_used() - before_open;
    println_int(open_bytes);
    # 5000 mono f64 frames = 40 KB decoded, plus the raw file buffer. Two decoded copies plus
    # a pending vec would be far more; assert well under that.
    assert(open_bytes < 4000000, "open does not hold multiple decoded copies");

    # --- 2.2.2: read_all hands over the decoded buffer instead of copying it ---
    # It was read_chunk(total) -- vec_push per sample from vec_new(), so the doubling chain on
    # top of a full copy: 16.78 MB of heap for a 10 s stereo file's 7.06 MB of samples.
    test_group("read_all of a fresh reader copies nothing (2.2.2)");
    var rasr = n_stream_reader_open("/tmp/nidhi_io_big.wav");
    var ra0 = alloc_used();
    var rall = n_stream_reader_read_all(rasr);
    var ra_bytes = alloc_used() - ra0;
    assert_eq(NSample_frames(rall), 5000, "read_all frames 5000");
    assert(ra_bytes < 4096, "read_all of a fresh reader allocates < 4 KB (was ~128 KB)");
    assert_eq(vec_len(n_stream_reader_read_chunk(rasr, 10)), 0, "read_all exhausts the reader");
    assert_eq(vec_get(NSample_data(rall), 4999), vec_get(NSample_data(bload), 4999), "read_all data == load_wav data");

    # --- 2.2.2: n_read_file reports a read error instead of treating it as end-of-file ---
    # A directory opens, then read() fails with -EISDIR: the loop took that as EOF and handed
    # back a non-0 buffer of length 0. A read error mid-file returned a silent prefix the same way.
    test_group("n_read_file: a failed read is an error (2.2.2)");
    var dslot = alloc(8);
    assert_eq(n_read_file("tests", dslot), 0, "reading a directory -> 0 (an error), not an empty buffer");
    assert_eq(load64(dslot), 0, "length 0 on error");
    assert_eq(n_read_file("/tmp/nidhi_io_no_such_file.wav", dslot), 0, "missing file -> 0");

    # --- 2.2.2: n_load_wav reads through nidhi's checked reader, then codec_open ---
    # shravan's decode_file started every read at a 1 MB buffer and never checked its growth
    # alloc (n_load_wav("/dev/zero") SIGSEGV'd under a 700 MB address-space limit). The format
    # coverage is decode_file's own dispatch, codec_open, so AIFF and FLAC must still load.
    test_group("n_load_wav: small read buffer, same format coverage (2.2.2)");
    var lw0 = alloc_used();
    var lwk = 0;
    while (lwk < 8) {
        assert(n_load_wav("/tmp/nidhi_io_test.wav") > 0, "tiny WAV loads");
        lwk = lwk + 1;
    }
    var lw_per = (alloc_used() - lw0) / 8;
    assert(lw_per < 65536, "a 4-frame WAV costs < 64 KB per load (was 1,049,832 B)");
    var aiffbuf = alloc(8192);
    var aiffn = aiff_encode(ipcm, 44100, 1, 16, aiffbuf);
    assert(aiffn > 0, "aiff_encode");
    write_file("/tmp/nidhi_io_test.aif", aiffbuf, aiffn);
    var la = n_load_wav("/tmp/nidhi_io_test.aif");
    assert(la > 0, "AIFF loads through n_load_wav");
    assert_eq(approx(vec_get(NSample_data(la), 0), F64_HALF, f64_div(F64_ONE, f64_from(1000))), 1, "AIFF value[0] ~ 0.5");
    var flacbuf = alloc(65536);
    var flacn = flac_encode(ipcm, 44100, 1, 16, flacbuf);
    assert(flacn > 0, "flac_encode");
    write_file("/tmp/nidhi_io_test.flac", flacbuf, flacn);
    var lf = n_load_wav("/tmp/nidhi_io_test.flac");
    assert(lf > 0, "FLAC loads through n_load_wav");
    assert_eq(NSample_frames(lf), 4, "FLAC frames 4");
    assert_eq(vec_get(NSample_data(lf), 1), f64_neg(F64_HALF), "FLAC value[1] == -0.5 exactly");

    # --- 2.2.2: the stream reader applies the same non-finite scrub as n_load_wav ---
    # shravan zeroes non-finite f32 samples itself but copies 64-bit float samples raw, so a
    # PCM_F64 WAV holding NaN/Inf reached the consumer through the stream reader only.
    test_group("stream reader scrubs NaN/Inf like n_load_wav (2.2.2)");
    var nanv = vec_new();
    vec_push(nanv, F64_HALF);
    vec_push(nanv, 0x7FF8000000000000);
    vec_push(nanv, 0x7FF0000000000000);
    vec_push(nanv, 0xFFF0000000000001);
    var nanbuf = alloc(8192);
    var nann = wav_encode(nanv, 44100, 1, PCM_F64, nanbuf);
    write_file("/tmp/nidhi_io_nan.wav", nanbuf, nann);
    var nl = n_load_wav("/tmp/nidhi_io_nan.wav");
    assert_eq(vec_get(NSample_data(nl), 1), 0, "n_load_wav: NaN -> +0.0");
    var nsr = n_stream_reader_open("/tmp/nidhi_io_nan.wav");
    var nch = n_stream_reader_read_chunk(nsr, 4);
    assert_eq(vec_get(nch, 0), F64_HALF, "finite sample untouched");
    assert_eq(vec_get(nch, 1), 0, "stream: NaN -> +0.0");
    assert_eq(vec_get(nch, 2), 0, "stream: +Inf -> +0.0");
    assert_eq(vec_get(nch, 3), 0, "stream: NaN with sign + payload -> +0.0");

    # --- 2.2.2: the Sample name is a copy, not a view of the caller's path ---
    test_group("sample name survives the caller reusing its path buffer (2.2.2)");
    write_file("/tmp/nidhi_io_aaaa.wav", wavbuf, nbytes);
    write_file("/tmp/nidhi_io_bbbb.wav", wavbuf, nbytes);
    var pbuf = alloc(64);
    memcpy(pbuf, "/tmp/nidhi_io_aaaa.wav", 23);
    var na = n_load_wav(pbuf);
    memcpy(pbuf, "/tmp/nidhi_io_bbbb.wav", 23);
    var nb = n_load_wav(pbuf);
    assert_eq(str_eq(NSample_name(na), str_from("nidhi_io_aaaa")), 1, "first name unchanged after reuse");
    assert_eq(str_eq(NSample_name(nb), str_from("nidhi_io_bbbb")), 1, "second name");

    # --- 2.2.2: more than two channels load the front pair (docs/adr/0010) ---
    # They were handed to n_sample_from_stereo as they were: a 3-channel file of F frames loaded
    # as 3F/2 "frames" of interleaved channels, and the stream reader reported F frames while
    # serving 3F/2.
    test_group("3- and 6-channel WAV load the front pair (2.2.2)");
    var mcs = vec_new();
    vec_push(mcs, 3);
    vec_push(mcs, 6);
    var mi = 0;
    while (mi < vec_len(mcs)) {
        var mch = vec_get(mcs, mi);
        var mbuf = alloc(65536);
        var mn = mc_wav(mch, 50, mbuf);
        assert(mn > 0, "multichannel wav_encode");
        var mm = n_load_wav_from_memory(mbuf, mn);
        assert_eq(NSample_channels(mm), 2, "from_memory: channels 2");
        assert_eq(NSample_frames(mm), 50, "from_memory: 50 frames");
        assert_eq(mc_front_pair_ok(NSample_data(mm), 0, 50), 1, "from_memory: L/R are channels 1 and 2");
        write_file("/tmp/nidhi_io_mc.wav", mbuf, mn);
        var mf = n_load_wav("/tmp/nidhi_io_mc.wav");
        assert_eq(NSample_channels(mf), 2, "load_wav: channels 2");
        assert_eq(NSample_frames(mf), 50, "load_wav: 50 frames");
        assert_eq(mc_front_pair_ok(NSample_data(mf), 0, 50), 1, "load_wav: L/R are channels 1 and 2");
        var ms = n_stream_reader_open("/tmp/nidhi_io_mc.wav");
        assert_eq(NStreamReader_channels(ms), 2, "stream: channels 2");
        assert_eq(NStreamReader_total_frames(ms), 50, "stream: total_frames 50");
        var mc1 = n_stream_reader_read_chunk(ms, 7);
        assert_eq(mc_front_pair_ok(mc1, 0, 7), 1, "stream: chunk of 7 front-pair frames");
        var mrest = n_stream_reader_read_all(ms);
        assert_eq(NSample_frames(mrest), 43, "stream: read_all serves the other 43");
        assert_eq(mc_front_pair_ok(NSample_data(mrest), 7, 43), 1, "stream: read_all continues the pair");
        var ms2 = n_stream_reader_open("/tmp/nidhi_io_mc.wav");
        var mall = n_stream_reader_read_all(ms2);
        assert_eq(NSample_frames(mall), NSample_frames(mf), "read_all frames == load_wav frames");
        assert_eq(mc_front_pair_ok(NSample_data(mall), 0, 50), 1, "read_all data == load_wav data");
        mi = mi + 1;
    }

    return assert_summary();
}

var exit_code = main();
syscall(60, exit_code);
