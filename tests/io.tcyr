# io.tcyr -- parity tests for src/io.cyr (ports rust-old/src/io.rs #[test]s + file/stream round-trip).

include "lib/sankoch.cyr"
include "lib/shravan.cyr"
include "src/error.cyr"
include "src/f64_util.cyr"
include "src/sample.cyr"
include "src/io.cyr"

fn approx(a, b, tol) {
    if (f64_lt(f64_abs(f64_sub(a, b)), tol) == 1) { return 1; }
    return 0;
}

fn write_file(path, buf, len) {
    var fd = file_open(path, 577, 420);   # O_WRONLY|O_CREAT|O_TRUNC, mode 0644
    if (fd < 0) { return 0 - 1; }
    file_write(fd, buf, len);
    file_close(fd);
    return 0;
}

fn main() {
    alloc_init();

    test_group("load_wav_from_memory mono");
    var mono = vec_new();
    vec_push(mono, f64_div(f64_from(1), f64_from(10)));
    vec_push(mono, f64_div(f64_from(2), f64_from(10)));
    vec_push(mono, f64_div(f64_from(3), f64_from(10)));
    vec_push(mono, f64_div(f64_from(4), f64_from(10)));
    var wavbuf = alloc(8192);
    var nbytes = wav_encode(mono, 44100, 1, PCM_F32, wavbuf);
    assert(nbytes > 0, "wav_encode mono produced bytes");
    var sm = n_load_wav_from_memory(wavbuf, nbytes);
    assert(sm > 0, "load mono succeeded (positive ptr)");
    assert_eq(NSample_frames(sm), 4, "mono frames 4");
    assert_eq(NSample_channels(sm), 1, "mono channels 1");
    assert_eq(NSample_sample_rate(sm), 44100, "mono sample_rate 44100");

    test_group("load_wav_from_memory stereo");
    var st = vec_new();
    vec_push(st, f64_div(f64_from(1), f64_from(10)));
    vec_push(st, f64_neg(f64_div(f64_from(1), f64_from(10))));
    vec_push(st, f64_div(f64_from(2), f64_from(10)));
    vec_push(st, f64_neg(f64_div(f64_from(2), f64_from(10))));
    var wavbuf2 = alloc(8192);
    var nbytes2 = wav_encode(st, 48000, 2, PCM_F32, wavbuf2);
    var ss = n_load_wav_from_memory(wavbuf2, nbytes2);
    assert_eq(NSample_frames(ss), 2, "stereo frames 2");
    assert_eq(NSample_channels(ss), 2, "stereo channels 2");
    assert_eq(NSample_sample_rate(ss), 48000, "stereo sample_rate 48000");

    test_group("load_wav_from_memory invalid");
    var badbuf = alloc(4);
    store8(badbuf, 0);
    store8(badbuf + 1, 1);
    store8(badbuf + 2, 2);
    store8(badbuf + 3, 3);
    assert_eq(n_is_err(n_load_wav_from_memory(badbuf, 4)), 1, "invalid bytes -> error");

    test_group("load_wav file + file_stem");
    write_file("/tmp/nidhi_io_test.wav", wavbuf, nbytes);
    var lw = n_load_wav("/tmp/nidhi_io_test.wav");
    assert(lw > 0, "load_wav succeeded");
    assert_eq(NSample_frames(lw), 4, "load_wav frames 4");
    assert_eq(NSample_channels(lw), 1, "load_wav channels 1");
    assert_eq(str_eq(NSample_name(lw), str_from("nidhi_io_test")), 1, "name == file stem");

    test_group("streaming reader");
    var srd = n_stream_reader_open("/tmp/nidhi_io_test.wav");
    assert(srd > 0, "stream open succeeded");
    assert_eq(NStreamReader_channels(srd), 1, "stream channels 1");
    assert_eq(NStreamReader_sample_rate(srd), 44100, "stream sample_rate 44100");
    assert_eq(NStreamReader_total_frames(srd), 4, "stream total_frames 4");
    var allsmp = n_stream_reader_read_all(srd);
    assert_eq(NSample_frames(allsmp), 4, "stream read_all frames 4");

    # --- 2.0.2 regression: integer PCM decoded to pure silence ---
    # Every fixture above encodes PCM_F32, the one format that needs no scale constant,
    # which is exactly why this went unnoticed. nidhi never called shravan_init_constants(),
    # so shravan's F64_RCP_* were all +0.0 and every integer sample was multiplied by zero.
    # Assert VALUES, not just frame counts -- a frame-count assertion passes on silence.
    test_group("integer PCM decodes to real audio (not silence)");
    var ipcm = vec_new();
    vec_push(ipcm, F64_HALF);
    vec_push(ipcm, f64_neg(F64_HALF));
    vec_push(ipcm, f64_div(F64_ONE, f64_from(4)));
    vec_push(ipcm, f64_div(F64_ONE, f64_from(8)));
    var fmts = vec_new();
    vec_push(fmts, PCM_I8);
    vec_push(fmts, PCM_I16);
    vec_push(fmts, PCM_I24);
    vec_push(fmts, PCM_I32);
    var fi = 0;
    while (fi < vec_len(fmts)) {
        var fmt = vec_get(fmts, fi);
        var ibuf = alloc(8192);
        var ib = wav_encode(ipcm, 44100, 1, fmt, ibuf);
        assert(ib > 0, "integer PCM encoded");
        var ism = n_load_wav_from_memory(ibuf, ib);
        assert(ism > 0, "integer PCM decoded");
        assert_eq(NSample_frames(ism), 4, "integer PCM frames 4");
        var idata = NSample_data(ism);
        var nonzero = 0;
        var k = 0;
        while (k < vec_len(idata)) {
            if (vec_get(idata, k) != 0) { nonzero = nonzero + 1; }
            k = k + 1;
        }
        assert_eq(nonzero, 4, "integer PCM is NOT silence");
        # 8-bit has ~1/256 resolution, so tolerance has to cover the coarsest format.
        var tol = f64_div(F64_ONE, f64_from(50));
        assert_eq(approx(vec_get(idata, 0), F64_HALF, tol), 1, "integer PCM value[0] ~ 0.5");
        assert_eq(approx(vec_get(idata, 1), f64_neg(F64_HALF), tol), 1, "integer PCM value[1] ~ -0.5");
        fi = fi + 1;
    }

    # --- 2.0.2 regression: the streaming reader truncated everything over ~4 KB ---
    # It fed shravan in 4096-byte slices, but that decoder is buffer-then-decode-once and
    # wav_decode clamps the declared data size to what is present -- so the first slice
    # decoded as a complete WAV and every later feed was ignored. 5000 frames came back
    # as 1013. total_frames stayed correct, so the reader disagreed with itself.
    test_group("streaming reader returns the whole file, not the first 4 KB");
    var big = vec_new();
    var bi = 0;
    while (bi < 5000) {
        vec_push(big, f64_div(f64_from(bi % 100), f64_from(200)));
        bi = bi + 1;
    }
    var bigbuf = alloc(131072);
    var bign = wav_encode(big, 44100, 1, PCM_F32, bigbuf);
    assert(bign > 20000, "big fixture is well over one 4096-byte slice");
    write_file("/tmp/nidhi_io_big.wav", bigbuf, bign);
    var bsr = n_stream_reader_open("/tmp/nidhi_io_big.wav");
    assert(bsr > 0, "big stream open succeeded");
    assert_eq(NStreamReader_total_frames(bsr), 5000, "big stream total_frames 5000");
    var ball = n_stream_reader_read_all(bsr);
    assert_eq(NSample_frames(ball), 5000, "big stream read_all returns ALL 5000 frames");
    var bload = n_load_wav("/tmp/nidhi_io_big.wav");
    assert_eq(NSample_frames(bload), NSample_frames(ball), "stream agrees with load_wav");
    var bd = NSample_data(ball);
    var tol2 = f64_div(F64_ONE, f64_from(10000));
    assert_eq(approx(vec_get(bd, 4999), f64_div(f64_from(4999 % 100), f64_from(200)), tol2), 1,
        "last frame survives the stream");

    return assert_summary();
}

var exit_code = main();
syscall(60, exit_code);
