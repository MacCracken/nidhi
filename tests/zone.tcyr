# zone.tcyr -- parity tests for src/zone.cyr (ports rust-old/src/zone.rs #[test]s + curve/clamp coverage).

include "lib/hisab.cyr"
include "lib/goonj.cyr"
include "lib/naad.cyr"
include "src/error.cyr"
include "src/f64_util.cyr"
include "src/loop_mode.cyr"
include "src/envelope.cyr"
include "src/zone.cyr"

fn approx(a, b, tol) {
    if (f64_lt(f64_abs(f64_sub(a, b)), tol) == 1) { return 1; }
    return 0;
}

fn main() {
    alloc_init();

    test_group("velocity curve");
    assert_eq(f64_to(n_velocity_curve_apply(VEL_CURVE_LINEAR, 127)), 1, "Linear(127)=1.0");
    assert_eq(n_velocity_curve_apply(VEL_CURVE_LINEAR, 0), 0, "Linear(0)=0.0");
    assert_eq(f64_to(n_velocity_curve_apply(VEL_CURVE_CONCAVE, 127)), 1, "Concave(127)=1.0");
    assert_eq(f64_to(n_velocity_curve_apply(VEL_CURVE_CONVEX, 127)), 1, "Convex(127)=1.0");
    assert_eq(approx(n_velocity_curve_apply(VEL_CURVE_CONVEX, 64),
        f64_sqrt(f64_div(f64_from(64), f64_from(127))), f64_div(F64_ONE, f64_from(10000))), 1,
        "Convex(64)=sqrt(64/127)");
    assert_eq(f64_to(n_velocity_curve_apply(VEL_CURVE_SWITCH, 65)), 1, "Switch(65)=1.0");
    assert_eq(n_velocity_curve_apply(VEL_CURVE_SWITCH, 64), 0, "Switch(64)=0.0");
    assert_eq(n_velocity_curve_apply(VEL_CURVE_SWITCH, 0), 0, "Switch(0)=0.0");

    test_group("zone defaults");
    var zd = n_zone_new(7);
    assert_eq(NZone_sample_id(zd), 7, "sample_id set to 7");
    assert_eq(NZone_key_lo(zd), 0, "key_lo default 0");
    assert_eq(NZone_key_hi(zd), 127, "key_hi default 127");
    assert_eq(NZone_vel_lo(zd), 1, "vel_lo default 1");
    assert_eq(NZone_root_note(zd), 60, "root_note default 60");
    assert_eq(NZone_loop_mode(zd), 0, "loop_mode default OneShot(0)");
    assert_eq(NZone_filter_type(zd), 0, "filter_type default LowPass(0)");
    assert_eq(NZone_vel_curve(zd), 0, "vel_curve default Linear(0)");
    assert_eq(NZone_adsr(zd), 0, "adsr default None (null)");
    assert_eq(NZone_fileg(zd), 0, "fileg default None (null)");
    assert_eq(approx(NZone_filter_resonance(zd), f64_div(f64_from(707), f64_from(1000)),
        f64_div(F64_ONE, f64_from(1000))), 1, "filter_resonance default ~0.707");

    test_group("zone matches");
    var zm = n_zone_new(0);
    zm = n_zone_with_key_range(zm, 60, 72);
    zm = n_zone_with_vel_range(zm, 1, 127);
    assert_eq(n_zone_matches(zm, 66, 100), 1, "note 66 vel 100 matches");
    assert_eq(n_zone_matches(zm, 59, 100), 0, "note 59 below key range");
    assert_eq(n_zone_matches(zm, 73, 100), 0, "note 73 above key range");

    test_group("playback ratio");
    var zr = n_zone_new(0);
    zr = n_zone_with_root_note(zr, 60);
    assert_eq(approx(n_zone_playback_ratio(zr, 60), F64_ONE, f64_div(F64_ONE, f64_from(1000))), 1,
        "ratio at root ~1.0");
    assert_eq(approx(n_zone_playback_ratio(zr, 72), f64_from(2), f64_div(F64_ONE, f64_from(100))), 1,
        "ratio one octave up ~2.0");
    var zt = n_zone_new(0);
    zt = n_zone_with_root_note(zt, 60);
    zt = n_zone_with_tune(zt, f64_from(50));
    var rt = n_zone_playback_ratio(zt, 60);
    assert_eq(f64_gt(rt, F64_ONE), 1, "50-cent tuned ratio > 1.0");
    assert_eq(f64_lt(rt, f64_div(f64_from(106), f64_from(100))), 1, "50-cent tuned ratio < 1.06");

    test_group("zone clamps");
    var zc = n_zone_new(0);
    zc = n_zone_with_pan(zc, f64_from(5));
    assert_eq(f64_to(NZone_pan(zc)), 1, "pan clamps to +1.0");
    zc = n_zone_with_pan(zc, f64_neg(f64_from(5)));
    assert_eq(f64_to(NZone_pan(zc)), 0 - 1, "pan clamps to -1.0");
    zc = n_zone_with_time_stretch(zc, f64_from(10));
    assert_eq(f64_to(NZone_time_stretch(zc)), 4, "time_stretch clamps to 4.0");
    zc = n_zone_with_filter_resonance(zc, 0);
    assert_eq(approx(NZone_filter_resonance(zc), f64_div(F64_ONE, f64_from(10)),
        f64_div(F64_ONE, f64_from(1000))), 1, "resonance clamps up to 0.1");
    zc = n_zone_with_tune(zc, f64_from(20000));
    assert_eq(f64_to(NZone_tune_cents(zc)), 12800, "tune clamps to +12800");

    test_group("zone adsr wiring");
    var za = n_zone_new(0);
    var cfg = n_adsr_config_new(10, 20, F64_ONE, 30);
    za = n_zone_with_adsr(za, cfg);
    # 2.0.6: the zone COPIES the config; it no longer aliases the caller's pointer. This
    # assertion used to pin the aliasing itself (NZone_adsr(za) == cfg), which is exactly the
    # behaviour Rust did not have -- with_adsr took AdsrConfig by VALUE.
    assert(NZone_adsr(za) > 0, "adsr set (Some)");
    assert_eq(NAdsrConfig_attack_samples(NZone_adsr(za)), 10, "adsr config readable through zone");
    assert_eq(NAdsrConfig_decay_samples(NZone_adsr(za)), 20, "adsr decay copied");
    assert_eq(NAdsrConfig_release_samples(NZone_adsr(za)), 30, "adsr release copied");

    # The copy is the point: mutating the caller's config, or handing it to a second zone,
    # must not reach through into a zone that was already built from it.
    var zb = n_zone_with_adsr(n_zone_new(0), cfg);
    NAdsrConfig_set_attack_samples(cfg, 999);
    assert_eq(NAdsrConfig_attack_samples(NZone_adsr(za)), 10, "mutating the source config does not reach zone A");
    assert_eq(NAdsrConfig_attack_samples(NZone_adsr(zb)), 10, "mutating the source config does not reach zone B");
    assert(NZone_adsr(za) != NZone_adsr(zb), "two zones from one config do not share state");

    # Same for the filter envelope.
    var zfe = n_zone_with_filter_envelope(n_zone_new(0), cfg, f64_from(1200));
    assert_eq(NAdsrConfig_attack_samples(NZone_fileg(zfe)), 999, "fileg copies the config as it stands");
    NAdsrConfig_set_attack_samples(cfg, 111);
    assert_eq(NAdsrConfig_attack_samples(NZone_fileg(zfe)), 999, "mutating the source does not reach fileg");
    assert_eq(n_zone_with_filter_envelope(n_zone_new(0), 0, 0) > 0, 1, "fileg None (0) still accepted");

    # --- 2.0.5: the oracle's maximal builder chain ---
    #
    # rust-old/src/lib.rs all_public_types_roundtrip built a Zone through 23 chained builders
    # and serde-round-tripped it. The port cannot reproduce the round-trip (no serde), but the
    # CHAIN is the valuable half: docs/port/20-mod-core.md called it "the single best fixture
    # for Zone field parity" and cited it by line number rather than reproducing it -- so it
    # died with the oracle. Reconstructed here from git history, with every field read back.
    # 15 of these 23 builders had no direct assertion anywhere in the suite.
    test_group("maximal zone builder chain (2.0.5)");
    var mz = n_zone_new(0);
    mz = n_zone_with_key_range(mz, 36, 84);
    mz = n_zone_with_vel_range(mz, 1, 127);
    mz = n_zone_with_root_note(mz, 60);
    mz = n_zone_with_tune(mz, f64_from(50));
    mz = n_zone_with_volume(mz, f64_neg(f64_from(3)));
    mz = n_zone_with_pan(mz, F64_HALF);
    mz = n_zone_with_loop(mz, LOOP_FORWARD, 100, 5000);
    mz = n_zone_with_crossfade(mz, 64);
    mz = n_zone_with_sample_offset(mz, 10);
    mz = n_zone_with_sample_end(mz, 9000);
    mz = n_zone_with_filter(mz, f64_from(2000), F64_HALF);
    mz = n_zone_with_filter_resonance(mz, f64_from(2));
    mz = n_zone_with_filter_type(mz, FILTER_LOWPASS);
    mz = n_zone_with_group(mz, 1);
    mz = n_zone_with_choke_group(mz, 1);
    mz = n_zone_with_velocity_curve(mz, VEL_CURVE_CONVEX);
    mz = n_zone_with_adsr(mz, n_adsr_config_from_seconds(
        f64_div(F64_ONE, f64_from(100)), f64_div(F64_ONE, f64_from(10)),
        f64_div(f64_from(7), f64_from(10)), f64_div(f64_from(3), f64_from(10)), f64_from(44100)));
    mz = n_zone_with_filter_envelope(mz, n_adsr_config_from_seconds(
        f64_div(f64_from(5), f64_from(100)), f64_div(f64_from(2), f64_from(10)),
        F64_HALF, f64_div(F64_ONE, f64_from(10)), f64_from(44100)), f64_from(2400));
    mz = n_zone_with_pitch_lfo(mz, f64_from(5), f64_from(50));
    mz = n_zone_with_filter_lfo(mz, f64_from(3), f64_from(600));
    mz = n_zone_with_key_tracking(mz, F64_HALF);
    mz = n_zone_with_time_stretch(mz, f64_div(f64_from(3), f64_from(2)));
    mz = n_zone_with_output_bus(mz, 2);

    var mt = f64_div(F64_ONE, f64_from(1000));
    assert_eq(NZone_sample_id(mz), 0, "chain: sample_id 0");
    assert_eq(NZone_key_lo(mz), 36, "chain: key_lo 36");
    assert_eq(NZone_key_hi(mz), 84, "chain: key_hi 84");
    assert_eq(NZone_vel_lo(mz), 1, "chain: vel_lo 1");
    assert_eq(NZone_vel_hi(mz), 127, "chain: vel_hi 127");
    assert_eq(NZone_root_note(mz), 60, "chain: root_note 60");
    assert_eq(approx(NZone_tune_cents(mz), f64_from(50), mt), 1, "chain: tune 50");
    assert_eq(approx(NZone_volume_db(mz), f64_neg(f64_from(3)), mt), 1, "chain: volume -3");
    assert_eq(approx(NZone_pan(mz), F64_HALF, mt), 1, "chain: pan 0.5");
    assert_eq(NZone_loop_mode(mz), LOOP_FORWARD, "chain: loop_mode Forward");
    assert_eq(NZone_loop_start(mz), 100, "chain: loop_start 100");
    assert_eq(NZone_loop_end(mz), 5000, "chain: loop_end 5000");
    assert_eq(NZone_crossfade_length(mz), 64, "chain: crossfade 64");
    assert_eq(NZone_sample_offset(mz), 10, "chain: sample_offset 10");
    assert_eq(NZone_sample_end(mz), 9000, "chain: sample_end 9000");
    assert_eq(approx(NZone_filter_cutoff(mz), f64_from(2000), mt), 1, "chain: cutoff 2000");
    assert_eq(approx(NZone_filter_vel_track(mz), F64_HALF, mt), 1, "chain: fil_veltrack 0.5");
    assert_eq(approx(NZone_filter_resonance(mz), f64_from(2), mt), 1, "chain: resonance 2");
    assert_eq(NZone_filter_type(mz), FILTER_LOWPASS, "chain: filter_type LowPass");
    assert_eq(NZone_group(mz), 1, "chain: group 1");
    assert_eq(NZone_choke_group(mz), 1, "chain: choke_group 1");
    assert_eq(NZone_vel_curve(mz), VEL_CURVE_CONVEX, "chain: vel_curve Convex");
    assert(NZone_adsr(mz) > 0, "chain: adsr set");
    assert_eq(NAdsrConfig_attack_samples(NZone_adsr(mz)), 441, "chain: adsr attack 0.01s @44.1k = 441");
    assert(NZone_fileg(mz) > 0, "chain: filter envelope set");
    assert_eq(NAdsrConfig_attack_samples(NZone_fileg(mz)), 2205, "chain: fileg attack 0.05s = 2205");
    assert_eq(approx(NZone_fileg_depth(mz), f64_from(2400), mt), 1, "chain: fileg_depth 2400");
    assert_eq(approx(NZone_pitchlfo_rate(mz), f64_from(5), mt), 1, "chain: pitchlfo_rate 5");
    assert_eq(approx(NZone_pitchlfo_depth(mz), f64_from(50), mt), 1, "chain: pitchlfo_depth 50");
    assert_eq(approx(NZone_fillfo_rate(mz), f64_from(3), mt), 1, "chain: fillfo_rate 3");
    assert_eq(approx(NZone_fillfo_depth(mz), f64_from(600), mt), 1, "chain: fillfo_depth 600");
    assert_eq(approx(NZone_fil_keytrack(mz), F64_HALF, mt), 1, "chain: fil_keytrack 0.5");
    assert_eq(approx(NZone_time_stretch(mz), f64_div(f64_from(3), f64_from(2)), mt), 1, "chain: time_stretch 1.5");
    assert_eq(NZone_output_bus(mz), 2, "chain: output_bus 2");

    # The chain must not have disturbed matching: key 36..84, vel 1..127.
    assert_eq(n_zone_matches(mz, 60, 100), 1, "chain: matches note 60 vel 100");
    assert_eq(n_zone_matches(mz, 35, 100), 0, "chain: rejects note below key_lo");
    assert_eq(n_zone_matches(mz, 85, 100), 0, "chain: rejects note above key_hi");
    assert_eq(n_zone_matches(mz, 60, 0), 0, "chain: rejects vel below vel_lo");

    # --- 2.0.6: NaN parameters clamp to a bound, never propagate (ADR 0002) ---
    # Every clamped builder is f64_min(f64_max(x, lo), hi), and f64_min/f64_max are built on
    # f64_lt/f64_gt, which return 0 for a NaN operand -- so NaN falls through to the bound.
    # Rust's f32::clamp propagates NaN instead. Keeping the port's behaviour is deliberate: a
    # NaN reaching the SVF latches the voice for its whole life, and nidhi already stops
    # non-finite audio at every other boundary. Pin the finiteness AND the specific bound so
    # neither drifts silently.
    test_group("NaN parameters clamp to a bound, never propagate (2.0.6)");
    var NANBITS = 0x7FF8000000000000;
    var nt = n_zone_with_tune(n_zone_new(0), NANBITS);
    assert_eq(n_is_finite(NZone_tune_cents(nt)), 1, "tune(NaN) stays finite");
    assert_eq(f64_to(NZone_tune_cents(nt)), 0 - 12800, "tune(NaN) lands on the low bound");
    var np = n_zone_with_pan(n_zone_new(0), NANBITS);
    assert_eq(n_is_finite(NZone_pan(np)), 1, "pan(NaN) stays finite");
    assert_eq(f64_to(f64_mul(NZone_pan(np), f64_from(1000))), 0 - 1000, "pan(NaN) lands on -1.0");
    var nfc = n_zone_with_filter(n_zone_new(0), NANBITS, NANBITS);
    assert_eq(n_is_finite(NZone_filter_cutoff(nfc)), 1, "cutoff(NaN) stays finite");
    assert_eq(n_is_finite(NZone_filter_vel_track(nfc)), 1, "fil_veltrack(NaN) stays finite");
    # A .max()-only site does NOT diverge -- Rust's f32::max also drops NaN. Same result here.
    var nr = n_zone_with_filter_resonance(n_zone_new(0), NANBITS);
    assert_eq(n_is_finite(NZone_filter_resonance(nr)), 1, "resonance(NaN) stays finite");

    return assert_summary();
}

var exit_code = main();
syscall(60, exit_code);
