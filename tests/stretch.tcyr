# stretch.tcyr -- parity tests for src/stretch.cyr (ports rust-old/src/stretch.rs #[test]s).

include "src/error.cyr"
include "src/f64_util.cyr"
include "src/stretch.cyr"

fn approx(a, b, tol) {
    if (f64_lt(f64_abs(f64_sub(a, b)), tol) == 1) { return 1; }
    return 0;
}

fn all_finite(v) {
    var n = vec_len(v);
    var i = 0;
    while (i < n) {
        if (n_is_finite(vec_get(v, i)) == 0) { return 0; }
        i = i + 1;
    }
    return 1;
}

fn make_sine(freq, sr, n) {
    var out = vec_new();
    var i = 0;
    while (i < n) {
        var ph = f64_div(f64_mul(f64_mul(F64_TAU, f64_from(freq)), f64_from(i)), f64_from(sr));
        vec_push(out, f64_sin(ph));
        i = i + 1;
    }
    return out;
}

fn main() {
    alloc_init();

    var n_in = 4410;
    var sine = make_sine(440, 44100, n_in);
    var st = n_stretcher_new(sine, f64_from(44100));
    var ratio15 = f64_div(f64_from(3), f64_from(2));

    test_group("length ratios");
    var r1 = n_stretch(st, F64_ONE);
    assert(vec_len(r1) >= (n_in * 98) / 100, "ratio 1.0 length >= 98% input");
    assert(vec_len(r1) <= (n_in * 102) / 100, "ratio 1.0 length <= 102% input");
    var r2 = n_stretch(st, f64_from(2));
    assert(vec_len(r2) >= (n_in * 2 * 95) / 100, "ratio 2.0 ~ 2x (>=95%)");
    assert(vec_len(r2) <= (n_in * 2 * 105) / 100, "ratio 2.0 ~ 2x (<=105%)");
    var rh = n_stretch(st, F64_HALF);
    assert(vec_len(rh) >= (n_in * 95) / 200, "ratio 0.5 ~ half (>=95%)");
    assert(vec_len(rh) <= (n_in * 105) / 200, "ratio 0.5 ~ half (<=105%)");

    test_group("finite output");
    var wo = n_stretch(st, ratio15);
    assert(vec_len(wo) > 0, "wsola output non-empty");
    assert_eq(all_finite(wo), 1, "wsola output all finite");
    var oo = n_stretch_ola(st, ratio15);
    assert(vec_len(oo) > 0, "ola output non-empty");
    assert_eq(all_finite(oo), 1, "ola output all finite");

    test_group("empty + invalid ratios");
    var empty_st = n_stretcher_new(vec_new(), f64_from(44100));
    assert_eq(vec_len(n_stretch(empty_st, f64_from(2))), 0, "empty input -> empty (wsola)");
    assert_eq(vec_len(n_stretch_ola(empty_st, f64_from(2))), 0, "empty input -> empty (ola)");
    assert_eq(vec_len(n_stretch(st, f64_from(0))), 0, "ratio 0 -> empty");
    assert_eq(vec_len(n_stretch(st, f64_neg(F64_ONE))), 0, "ratio -1 -> empty");
    assert_eq(vec_len(n_stretch(st, 0x7FF8000000000000)), 0, "ratio NaN -> empty");
    assert_eq(vec_len(n_stretch(st, 0x7FF0000000000000)), 0, "ratio +Inf -> empty");
    # 2.0.5: the oracle asserted all EIGHT cases -- the same four guards on stretch_ola, which
    # is a separate function with its own copy of the guard prologue. Only the n_stretch half
    # was ported, so a regression in stretch_ola's guards would have gone unnoticed.
    assert_eq(vec_len(n_stretch_ola(st, f64_from(0))), 0, "ola ratio 0 -> empty");
    assert_eq(vec_len(n_stretch_ola(st, f64_neg(F64_ONE))), 0, "ola ratio -1 -> empty");
    assert_eq(vec_len(n_stretch_ola(st, 0x7FF8000000000000)), 0, "ola ratio NaN -> empty");
    assert_eq(vec_len(n_stretch_ola(st, 0x7FF0000000000000)), 0, "ola ratio +Inf -> empty");
    # -Inf is representable too and neither side ever tested it.
    assert_eq(vec_len(n_stretch(st, 0xFFF0000000000000)), 0, "ratio -Inf -> empty");
    assert_eq(vec_len(n_stretch_ola(st, 0xFFF0000000000000)), 0, "ola ratio -Inf -> empty");

    test_group("very short input (stretch_short)");
    var shortv = vec_new();
    vec_push(shortv, F64_HALF);
    vec_push(shortv, f64_div(f64_from(3), f64_from(10)));
    vec_push(shortv, f64_div(f64_from(1), f64_from(10)));
    var short_st = n_stretcher_new(shortv, f64_from(44100));
    var sw = n_stretch(short_st, f64_from(2));
    assert(vec_len(sw) > 0, "short wsola non-empty");
    assert_eq(all_finite(sw), 1, "short wsola finite");
    assert(vec_len(n_stretch_ola(short_st, f64_from(2))) > 0, "short ola non-empty");

    test_group("stretch_with_mode dispatch");
    var mo = n_stretch_with_mode(st, ratio15, SM_OLA);
    var mw = n_stretch_with_mode(st, ratio15, SM_WSOLA);
    var mp = n_stretch_with_mode(st, ratio15, SM_PHASE_VOCODER);
    assert(vec_len(mo) > 0, "mode OLA non-empty");
    assert(vec_len(mw) > 0, "mode WSOLA non-empty");
    assert(vec_len(mp) > 0, "mode PhaseVocoder non-empty");
    assert_eq(vec_len(mw), vec_len(mp), "PhaseVocoder length == WSOLA length");

    test_group("cross_correlate");
    var cc = vec_new();
    var ci = 0;
    while (ci < 128) { vec_push(cc, f64_from(ci)); ci = ci + 1; }
    assert_eq(n_cross_correlate(cc, cc, 64), 0, "identical -> lag 0");
    assert_eq(n_cross_correlate(vec_new(), cc, 64), 0, "empty a -> 0");
    assert_eq(n_cross_correlate(cc, vec_new(), 64), 0, "empty b -> 0");

    test_group("hann window");
    var hw = n_hann_window(256);
    assert_eq(vec_len(hw), 256, "hann len 256");
    # The oracle used TWO tolerances here and the port had flattened both to 0.02: endpoints
    # at 1e-6 (they are structurally zero, not merely small) and the midpoint at 0.02. A 0.02
    # endpoint check would pass on a window that never tapers, which is the whole point of it.
    var t_end = f64_div(F64_ONE, f64_from(1000000));
    var t_mid = f64_div(f64_from(2), f64_from(100));
    assert_eq(approx(vec_get(hw, 0), f64_from(0), t_end), 1, "hann[0] ~ 0 (1e-6)");
    assert_eq(approx(vec_get(hw, 255), f64_from(0), t_end), 1, "hann[255] ~ 0 (1e-6)");
    assert_eq(approx(vec_get(hw, 127), F64_ONE, t_mid), 1, "hann[127] ~ 1.0 (0.02)");

    test_group("builder");
    var bs = n_stretcher_new(vec_new(), f64_from(44100));
    bs = n_stretcher_with_frame_size(bs, 512);
    assert_eq(NTimeStretcher_frame_size(bs), 512, "with_frame_size sets 512");

    # --- 2.0.3: Rust .round() is half-AWAY-FROM-ZERO, Cyrius f64_round is half-to-EVEN ---
    # Every oracle `.round()` sets a stretched buffer's target length, so an exact .5 product
    # used to yield an output one frame shorter than Rust's.
    test_group("round-half-away matches Rust f64::round (2.0.3)");
    var h = F64_HALF;
    assert_eq(f64_to(n_round_half_away(h)), 1, "0.5 -> 1 (f64_round gives 0)");
    assert_eq(f64_to(n_round_half_away(f64_div(f64_from(3), f64_from(2)))), 2, "1.5 -> 2");
    assert_eq(f64_to(n_round_half_away(f64_div(f64_from(5), f64_from(2)))), 3, "2.5 -> 3 (f64_round gives 2)");
    assert_eq(f64_to(n_round_half_away(f64_div(f64_from(7), f64_from(2)))), 4, "3.5 -> 4");
    assert_eq(f64_to(n_round_half_away(f64_neg(f64_div(f64_from(5), f64_from(2))))), 0 - 3, "-2.5 -> -3");
    assert_eq(f64_to(n_round_half_away(f64_div(f64_from(24), f64_from(10)))), 2, "2.4 -> 2");
    assert_eq(f64_to(n_round_half_away(f64_div(f64_from(26), f64_from(10)))), 3, "2.6 -> 3");
    assert_eq(f64_to(n_round_half_away(f64_from(7))), 7, "exact integer unchanged");

    # End to end: 5 frames at ratio 1.5 = 7.5 -> Rust rounds to 8, half-to-even gives 7.
    var din = vec_new();
    var i2 = 0;
    while (i2 < 5) { vec_push(din, f64_div(f64_from(i2), f64_from(5))); i2 = i2 + 1; }
    var stq = n_stretcher_new(din, f64_from(44100));
    var outq = n_stretch(stq, f64_div(f64_from(3), f64_from(2)));
    assert_eq(vec_len(outq), 8, "5 frames x1.5 -> 8 (was 7 before 2.0.3)");

    # --- 2.1.3: a length no vec can hold is an empty result, not a dead process ---
    # f64_to has saturated since cyrius 6.6.8, so the short path's target_len arrived as
    # i64::MAX and its push loop ran until the process died; it used to arrive as i64::MIN
    # and skip the loop by accident. 1 << 30 is the finite case: past VEC_CAP_MAX on any
    # toolchain, so it aborted before and after 6.6.8 alike.
    test_group("length past VEC_CAP_MAX is refused (2.1.3)");
    var big_r = vec_new();
    vec_push(big_r, 0x43ABC16D674EC800);
    vec_push(big_r, 0x46293E5939A08CEA);
    vec_push(big_r, 0x7FEFFFFFFFFFFFFF);
    vec_push(big_r, f64_from(1 << 30));
    var fsh = n_stretcher_new(din, f64_from(44100));
    var fln_in = vec_new();
    var fli = 0;
    while (fli < 4096) { vec_push(fln_in, F64_HALF); fli = fli + 1; }
    var fln = n_stretcher_new(fln_in, f64_from(44100));
    var bri = 0;
    while (bri < vec_len(big_r)) {
        var br = vec_get(big_r, bri);
        assert_eq(vec_len(n_stretch(fsh, br)), 0, "wsola short path refuses");
        assert_eq(vec_len(n_stretch_ola(fsh, br)), 0, "ola short path refuses");
        assert_eq(vec_len(n_stretch(fln, br)), 0, "wsola long path refuses");
        assert_eq(vec_len(n_stretch_ola(fln, br)), 0, "ola long path refuses");
        bri = bri + 1;
    }

    # --- 2.2.2: a read position past 2^63 is refused in f64, before f64_to ---
    # Needs nothing but the public builder: frame_size 2 or 3 gives syn_hop 1, ratio 1e-19 makes
    # frame 1 read at ~1e19, f64_to saturated it to i64::MAX, `optimal + frame_size` wrapped
    # negative, both guards passed, and vec_get ended the process (exit 1). The oracle's usize
    # arithmetic does not wrap there and simply stops, which is what both loops do now.
    test_group("ratio 1e-19 with a 1-sample hop returns, not exits (2.2.2)");
    var tiny = 0x3BFD83C94FB6D2AC;
    var tin = vec_new();
    var ti = 0;
    while (ti < 4096) { vec_push(tin, F64_HALF); ti = ti + 1; }
    var tfs = 2;
    while (tfs <= 3) {
        var tst = n_stretcher_with_frame_size(n_stretcher_new(tin, f64_from(44100)), tfs);
        assert_eq(vec_len(n_stretch(tst, tiny)), 0, "wsola frame 2/3, ratio 1e-19 -> empty");
        assert_eq(vec_len(n_stretch_ola(tst, tiny)), 0, "ola frame 2/3, ratio 1e-19 -> empty");
        tfs = tfs + 1;
    }

    # --- 2.2.2: overlap through the derived setter cannot end the process ---
    # The oracle's overlap was private and always 0.5; NTimeStretcher_set_overlap is public.
    # Past 1.0 syn_hop went negative and vec_get(output, oi < 0) ended the process (exit 1); the
    # oracle's `as usize` saturates that hop to 0, so it now takes the oracle's copy path. Just
    # under 1.0 the hop is 1 and the tiny-ratio wrap above applies.
    test_group("overlap past 1.0 via the setter copies the input (2.2.2)");
    var ost = n_stretcher_new(tin, f64_from(44100));
    NTimeStretcher_set_overlap(ost, 0x3FF8000000000000);
    assert_eq(vec_len(n_stretch(ost, F64_ONE)), 4096, "overlap 1.5 wsola -> input copy");
    assert_eq(vec_len(n_stretch_ola(ost, F64_ONE)), 4096, "overlap 1.5 ola -> input copy");
    assert_eq(vec_get(n_stretch(ost, f64_from(2)), 4095), F64_HALF, "the copy is the input");
    NTimeStretcher_set_overlap(ost, 0x3FEFF80000000000);
    assert_eq(vec_len(n_stretch(ost, tiny)), 0, "overlap 1-1/1024, ratio 1e-19 wsola -> empty");
    assert_eq(vec_len(n_stretch_ola(ost, tiny)), 0, "overlap 1-1/1024, ratio 1e-19 ola -> empty");

    # --- 2.2.2: cross_correlate is seeded as the oracle seeds it (-inf, lag 0) ---
    # stretch.rs: `best_lag = 0; best_corr = f64::NEG_INFINITY`, taken on a strict `>`. The port
    # seeded from the first lag evaluated, which differs only when that first sum is NaN or -inf.
    test_group("cross_correlate non-finite seeding matches the oracle (2.2.2)");
    var xa = vec_new();
    vec_push(xa, 0);
    vec_push(xa, 0x7FF0000000000000);
    vec_push(xa, 0);
    vec_push(xa, 0);
    var xb = vec_new();
    var xi = 0;
    while (xi < 4) { vec_push(xb, 0); xi = xi + 1; }
    # lag -1 sums inf*0 = NaN (never > anything); lag -2 sums 0 > -inf; every other lag is NaN
    assert_eq(n_cross_correlate(xa, xb, 2), 0 - 2, "first lag NaN: oracle picks -2 (was -1)");
    var xc = vec_new();
    vec_push(xc, 0xFFF0000000000000);
    vec_push(xc, 0xFFF0000000000000);
    var xd = vec_new();
    vec_push(xd, F64_ONE);
    vec_push(xd, F64_ONE);
    assert_eq(n_cross_correlate(xc, xd, 1), 0, "every sum -inf: oracle keeps lag 0 (was -1)");
    assert_eq(n_cross_correlate(cc, cc, 64), 0, "finite input unchanged: identical -> lag 0");

    # --- 2.2.2: stretch buffers are sized once, not grown by vec_push ---
    # Push-doubling on a bump allocator leaves every smaller buffer behind: a one-second x2
    # stretch allocated 4,210,528 bytes (1,444,168 sized), and a refused grow ended the process
    # even for requests n_stretch_fits accepts.
    test_group("stretch buffers are sized once (2.2.2)");
    var zv = n_vec_zeros(1000);
    assert_eq(vec_len(zv), 1000, "n_vec_zeros len");
    assert_eq(vec_cap(zv), 1000, "n_vec_zeros cap is exact");
    assert_eq(vec_get(zv, 999), 0, "n_vec_zeros zeroed");
    vec_push(zv, F64_ONE);
    assert_eq(vec_len(zv), 1001, "still an ordinary vec: pushable past its cap");
    assert_eq(vec_len(n_vec_zeros(5)), 5, "n below the initial capacity");
    assert_eq(vec_len(n_vec_zeros(0)), 0, "n = 0 is an empty vec");
    assert_eq(n_vec_zeros(0 - 1), 0, "negative n refused");
    assert_eq(n_vec_zeros(VEC_CAP_MAX + 1), 0, "n past VEC_CAP_MAX refused (n * 8 cannot wrap)");
    var sec = make_sine(440, 44100, 44100);
    var sst = n_stretcher_new(sec, f64_from(44100));
    var a0 = alloc_used();
    var sola = n_stretch_ola(sst, f64_from(2));
    var used = alloc_used() - a0;
    assert_eq(vec_len(sola), 88200, "1 s x2 ola length");
    assert(used < 1600000, "1 s x2 ola allocates < 1.6 MB (was 4.2 MB)");
    var sh_in = vec_new();
    var shi = 0;
    while (shi < 100) { vec_push(sh_in, F64_HALF); shi = shi + 1; }
    var shst = n_stretcher_new(sh_in, f64_from(44100));
    var a1 = alloc_used();
    var shout = n_stretch_short(shst, f64_from(1000));
    var used2 = alloc_used() - a1;
    assert_eq(vec_len(shout), 100000, "short path 100 x1000 length");
    assert(used2 < 900000, "short path allocates < 0.9 MB (was 2.1 MB)");
    assert_eq(vec_len(n_stretch_short(shst, f64_neg(F64_ONE))), 0, "short path negative ratio -> empty");

    return assert_summary();
}

var exit_code = main();
syscall(60, exit_code);
