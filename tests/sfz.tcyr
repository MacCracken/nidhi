# sfz.tcyr -- parity tests for src/sfz.cyr (ports rust-old/src/sfz.rs #[test]s).

include "lib/hisab.cyr"
include "lib/goonj.cyr"
include "lib/naad.cyr"
include "src/error.cyr"
include "src/f64_util.cyr"
include "src/loop_mode.cyr"
include "src/envelope.cyr"
include "src/zone.cyr"
include "src/sample.cyr"
include "src/instrument.cyr"
include "src/sfz.cyr"

# Explicitly discard a #must_use result the test does not need.
fn ignore(v) { return 0; }

fn approx(a, b, tol) {
    if (f64_lt(f64_abs(f64_sub(a, b)), tol) == 1) { return 1; }
    return 0;
}

fn zone0(f, sr) {
    return NSfzZoneFile_zone(vec_get(n_sfz_to_zones(f, sr), 0));
}

# `pat` repeated to fill `total` bytes, NUL-terminated.
fn rep_buf(pat, total) {
    var pl = strlen(pat);
    var reps = total / pl;
    var b = alloc(reps * pl + 1);
    var i = 0;
    while (i < reps) { memcpy(b + i * pl, pat, pl); i = i + 1; }
    store8(b + reps * pl, 0);
    return b;
}

# `hdr` then `nreg` lines "<region> sample=sNNNNNNN.wav": a distinct name per region when
# distinct == 1, the same name for all when distinct == 0.
fn region_buf(hdr, nreg, distinct) {
    var line = "\n<region> sample=s0000000.wav";
    var hl = strlen(hdr);
    var pl = strlen(line);
    var b = alloc(hl + nreg * pl + 1);
    memcpy(b, hdr, hl);
    var i = 0;
    while (i < nreg) {
        var p = b + hl + i * pl;
        memcpy(p, line, pl);
        var v = i * distinct;
        var d = 0;
        while (d < 7) { store8(p + 18 + 6 - d, 48 + (v % 10)); v = v / 10; d = d + 1; }
        i = i + 1;
    }
    store8(b + hl + nreg * pl, 0);
    return b;
}

# "<control> default_path=" followed by n 'a' bytes.
fn dp_buf(n) {
    var h = "<control> default_path=";
    var hl = strlen(h);
    var b = alloc(hl + n + 1);
    memcpy(b, h, hl);
    var i = 0;
    while (i < n) { store8(b + hl + i, 97); i = i + 1; }
    store8(b + hl + n, 0);
    return b;
}

fn main() {
    alloc_init();
    var sr = f64_from(44100);
    var tol = f64_div(F64_ONE, f64_from(1000));

    test_group("note parsing");
    assert_eq(n_sfz_note_or_num(str_from("60")), 60, "60 -> 60");
    assert_eq(n_sfz_note_or_num(str_from("c4")), 60, "c4 -> 60");
    assert_eq(n_sfz_note_or_num(str_from("C4")), 60, "C4 -> 60");
    assert_eq(n_sfz_note_or_num(str_from("f#3")), 54, "f#3 -> 54");
    assert_eq(n_sfz_note_or_num(str_from("eb4")), 63, "eb4 -> 63");
    assert_eq(n_sfz_note_or_num(str_from("b4")), 71, "b4 -> 71");
    assert_eq(n_sfz_note_or_num(str_from("c-1")), 0, "c-1 -> 0");
    assert_eq(n_sfz_note_or_num(str_from("g9")), 127, "g9 -> 127");
    assert_eq(n_sfz_note_or_num(str_from("")), 0 - 1, "empty -> None");
    assert_eq(n_sfz_note_or_num(str_from("xyz")), 0 - 1, "xyz -> None");

    test_group("parse single region");
    var f = n_sfz_parse("<region> sample=kick.wav lokey=36 hikey=48\n");
    assert_eq(vec_len(NSfzFile_regions(f)), 1, "1 region");
    var reg0 = vec_get(NSfzFile_regions(f), 0);
    assert_eq(str_eq_cstr(NSfzRegion_sample(reg0), "kick.wav"), 1, "sample kick.wav");
    assert_eq(NSfzRegion_lokey(reg0), 36, "lokey 36");
    assert_eq(NSfzRegion_hikey(reg0), 48, "hikey 48");

    test_group("key shorthand");
    var z = zone0(n_sfz_parse("<region> sample=a.wav key=60\n"), sr);
    assert_eq(NZone_key_lo(z), 60, "key -> lo 60");
    assert_eq(NZone_key_hi(z), 60, "key -> hi 60");
    assert_eq(NZone_root_note(z), 60, "key -> root 60");

    test_group("round trip pan/tune/volume");
    var z3 = zone0(n_sfz_parse("<region> sample=a.wav pan=50 tune=5 volume=-3\n"), sr);
    assert_eq(approx(NZone_pan(z3), F64_HALF, tol), 1, "pan 50 -> 0.5");
    assert_eq(approx(NZone_tune_cents(z3), f64_from(5), tol), 1, "tune 5 cents");
    assert_eq(approx(NZone_volume_db(z3), f64_neg(f64_from(3)), tol), 1, "volume -3 dB");

    test_group("transpose adds to tune");
    var z4 = zone0(n_sfz_parse("<region> sample=a.wav tune=10 transpose=2\n"), sr);
    assert_eq(approx(NZone_tune_cents(z4), f64_from(210), tol), 1, "tune 10 + transpose 2 -> 210");

    test_group("global + group inheritance");
    var z5 = zone0(n_sfz_parse("<global> volume=-6\n<group> lokey=40\n<region> sample=a.wav\n"), sr);
    assert_eq(approx(NZone_volume_db(z5), f64_neg(f64_from(6)), tol), 1, "inherits global volume -6");
    assert_eq(NZone_key_lo(z5), 40, "inherits group lokey 40");

    test_group("region overrides group overrides global");
    var z6 = zone0(n_sfz_parse("<global> volume=-10 pan=25\n<group> volume=-5\n<region> sample=a.wav volume=-2\n"), sr);
    assert_eq(approx(NZone_volume_db(z6), f64_neg(f64_from(2)), tol), 1, "region volume -2 wins");
    assert_eq(approx(NZone_pan(z6), f64_div(f64_from(25), f64_from(100)), tol), 1, "pan inherited 25 -> 0.25");

    test_group("loop mode mapping");
    assert_eq(NZone_loop_mode(zone0(n_sfz_parse("<region> sample=a.wav loop_mode=loop_continuous\n"), sr)), LOOP_FORWARD, "loop_continuous -> Forward");
    assert_eq(NZone_loop_mode(zone0(n_sfz_parse("<region> sample=a.wav loop_mode=loop_sustain\n"), sr)), LOOP_SUSTAIN, "loop_sustain -> LoopSustain");

    test_group("region without sample skipped");
    assert_eq(vec_len(n_sfz_to_zones(n_sfz_parse("<region> lokey=36\n<region> sample=a.wav\n"), sr)), 1, "no-sample region skipped");

    test_group("to_instrument dedup");
    var ir = n_sfz_to_instrument(n_sfz_parse("<region> sample=a.wav\n<region> sample=a.wav\n<region> sample=b.wav\n"), str_from("test"), sr);
    var inst = NSfzInstResult_instrument(ir);
    assert_eq(n_instrument_zone_count(inst), 3, "3 zones");
    assert_eq(vec_len(NSfzInstResult_sample_files(ir)), 2, "2 sample files");
    var zones = NInstrument_zones(inst);
    assert_eq(NZone_sample_id(vec_get(zones, 0)), 0, "zone0 id 0");
    assert_eq(NZone_sample_id(vec_get(zones, 1)), 0, "zone1 id 0 (dedup)");
    assert_eq(NZone_sample_id(vec_get(zones, 2)), 1, "zone2 id 1");

    test_group("default_path");
    var pr = n_sfz_to_zones(n_sfz_parse("<control> default_path=samples/piano/\n<region> sample=c4.wav\n"), sr);
    assert_eq(str_eq_cstr(NSfzZoneFile_filename(vec_get(pr, 0)), "samples/piano/c4.wav"), 1, "default_path prepended");

    test_group("includes");
    var f11 = n_sfz_parse("#include \"a.sfz\"\n#include \"b.sfz\"\n");
    assert_eq(vec_len(NSfzFile_includes(f11)), 2, "2 includes");
    assert_eq(str_eq_cstr(vec_get(NSfzFile_includes(f11), 0), "a.sfz"), 1, "include 0 quotes stripped");

    test_group("cc modulation");
    var reg12 = vec_get(NSfzFile_regions(n_sfz_parse("<region> sample=a.wav volume_oncc1=6\n")), 0);
    var ccs = NSfzRegion_cc_modulations(reg12);
    assert_eq(vec_len(ccs), 1, "1 cc mod");
    var cc0 = vec_get(ccs, 0);
    assert_eq(str_eq_cstr(NSfzCC_param(cc0), "volume"), 1, "cc param volume");
    assert_eq(NSfzCC_cc(cc0), 1, "cc number 1");
    assert_eq(approx(NSfzCC_depth(cc0), f64_from(6), tol), 1, "cc depth 6");

    test_group("filter opcodes");
    var z13 = zone0(n_sfz_parse("<region> sample=a.wav cutoff=2000 fil_veltrack=4800 fil_type=hpf_2p\n"), sr);
    assert_eq(approx(NZone_filter_cutoff(z13), f64_from(2000), tol), 1, "cutoff 2000");
    assert_eq(approx(NZone_filter_vel_track(z13), F64_HALF, tol), 1, "fil_veltrack 4800/9600 = 0.5");
    assert_eq(NZone_filter_type(z13), FILTER_HIGHPASS, "hpf_2p -> HighPass");

    test_group("ampeg wired");
    var z14 = zone0(n_sfz_parse("<region> sample=a.wav ampeg_attack=0.01 ampeg_release=0.5\n"), sr);
    assert(NZone_adsr(z14) != 0, "adsr set (Some)");
    assert_eq(NAdsrConfig_attack_samples(NZone_adsr(z14)), 441, "adsr attack 441 samples");

    test_group("fileg wired");
    var z15 = zone0(n_sfz_parse("<region> sample=a.wav fileg_attack=0.02 fileg_depth=1200\n"), sr);
    assert(NZone_fileg(z15) != 0, "fileg set (Some)");
    assert_eq(approx(NZone_fileg_depth(z15), f64_from(1200), tol), 1, "fileg_depth 1200");

    test_group("comments and blanks");
    assert_eq(vec_len(NSfzFile_regions(n_sfz_parse("// comment\n\n<region> sample=a.wav\n// another\n"))), 1, "comments/blanks skipped");

    test_group("offset/end/output/keytrack");
    var z17 = zone0(n_sfz_parse("<region> sample=a.wav offset=100 end=5000 output=2 fil_keytrack=600\n"), sr);
    assert_eq(NZone_sample_offset(z17), 100, "offset 100");
    assert_eq(NZone_sample_end(z17), 5000, "end 5000");
    assert_eq(NZone_output_bus(z17), 2, "output bus 2");
    assert_eq(approx(NZone_fil_keytrack(z17), F64_HALF, tol), 1, "fil_keytrack 600/1200 = 0.5");

    test_group("multiple groups");
    var f19 = n_sfz_parse("<group> lokey=36\n<region> sample=a.wav\n<group> lokey=48\n<region> sample=b.wav\n<region> sample=c.wav\n");
    assert_eq(vec_len(NSfzFile_groups(f19)), 2, "2 groups");
    assert_eq(vec_len(NSfzFile_regions(f19)), 3, "3 regions");
    var zs19 = n_sfz_to_zones(f19, sr);
    assert_eq(NZone_key_lo(NSfzZoneFile_zone(vec_get(zs19, 0))), 36, "region 0 -> group 0 lokey 36");
    assert_eq(NZone_key_lo(NSfzZoneFile_zone(vec_get(zs19, 1))), 48, "region 1 -> group 1 lokey 48");
    assert_eq(NZone_key_lo(NSfzZoneFile_zone(vec_get(zs19, 2))), 48, "region 2 -> group 1 lokey 48");

    test_group("integer parse strictness (parity audit fixes)");
    var reg_u8 = vec_get(NSfzFile_regions(n_sfz_parse("<region> sample=a.wav lovel=300 output=999\n")), 0);
    assert_eq(NSfzRegion_lovel(reg_u8), 1, "lovel=300 (>255) rejected -> default 1");
    assert_eq(NSfzRegion_output(reg_u8), 0, "output=999 (>255) rejected -> default 0");
    var reg_neg = vec_get(NSfzFile_regions(n_sfz_parse("<region> sample=a.wav group=-1 offset=-10\n")), 0);
    assert_eq(NSfzRegion_group(reg_neg), 0, "group=-1 (unsigned) rejected -> default 0");
    assert_eq(NSfzRegion_offset(reg_neg), 0, "offset=-10 (unsigned) rejected -> default 0");
    var reg_plus = vec_get(NSfzFile_regions(n_sfz_parse("<region> sample=a.wav tune=+5\n")), 0);
    assert_eq(NSfzRegion_tune(reg_plus), 5, "tune=+5 (leading +) accepted -> 5");
    var reg_cc = vec_get(NSfzFile_regions(n_sfz_parse("<region> sample=a.wav volume_oncc300=6\n")), 0);
    assert_eq(vec_len(NSfzRegion_cc_modulations(reg_cc)), 0, "cc#300 (>255) rejected -> no cc modulation");

    # --- 2.0.2: numeric parse strictness ---
    # f64_parse_ok reports success on a PREFIX, so every float opcode used to accept
    # trailing garbage that Rust's parse::<f32>() rejects. `cutoff=1000Hz` low-passed every
    # note at 1 kHz where the oracle disables the filter; `ampeg_attack=10ms` became a
    # ten-second fade-in on every note where the oracle applies no envelope at all.
    test_group("float opcodes reject trailing garbage (2.0.2)");
    var fo = alloc(8);
    assert_eq(sfz_f64(str_from("1000Hz"), fo), 0, "1000Hz rejected");
    assert_eq(sfz_f64(str_from("50%"), fo), 0, "50% rejected");
    assert_eq(sfz_f64(str_from("-6dB"), fo), 0, "-6dB rejected");
    assert_eq(sfz_f64(str_from("10ms"), fo), 0, "10ms rejected");
    assert_eq(sfz_f64(str_from("0.5s"), fo), 0, "0.5s rejected");
    assert_eq(sfz_f64(str_from("1200cents"), fo), 0, "1200cents rejected");
    assert_eq(sfz_f64(str_from("1_000"), fo), 0, "1_000 rejected");
    assert_eq(sfz_f64(str_from("1e"), fo), 0, "bare exponent rejected");
    assert_eq(sfz_f64(str_from("."), fo), 0, "lone dot rejected");
    # ...while everything the oracle accepts still parses.
    assert_eq(sfz_f64(str_from(".5"), fo), 1, ".5 accepted");
    assert_eq(sfz_f64(str_from("5."), fo), 1, "5. accepted");
    assert_eq(sfz_f64(str_from("+3"), fo), 1, "+3 accepted");
    assert_eq(sfz_f64(str_from("-2.5"), fo), 1, "-2.5 accepted");
    assert_eq(sfz_f64(str_from("1e1"), fo), 1, "1e1 accepted");
    assert_eq(sfz_f64(str_from("1.5E-3"), fo), 1, "1.5E-3 accepted");
    assert_eq(sfz_f64(str_from("inf"), fo), 1, "inf accepted");
    assert_eq(sfz_f64(str_from("NaN"), fo), 1, "NaN accepted");
    # SIGNED inf/nan: str_substr takes an exclusive END index, not a length, so the 2.0.2
    # validator computed the wrong slice and rejected every signed spelling. Unsigned worked
    # only by coincidence (end == len when the sign is absent).
    assert_eq(sfz_f64(str_from("-inf"), fo), 1, "-inf accepted (broken in 2.0.2)");
    assert_eq(sfz_f64(str_from("+inf"), fo), 1, "+inf accepted (broken in 2.0.2)");
    assert_eq(sfz_f64(str_from("-infinity"), fo), 1, "-infinity accepted");
    assert_eq(sfz_f64(str_from("-nan"), fo), 1, "-nan accepted");
    assert_eq(sfz_f64(str_from("-infx"), fo), 0, "-infx still rejected");

    # Integer overflow used to WRAP: group=9223372036854775808 became i64::MIN and reached
    # vec_get as a negative index -> exit(1) from a 47-byte file.
    test_group("integer opcodes reject overflow (2.0.2)");
    var io = alloc(8);
    assert_eq(sfz_i32(str_from("9223372036854775808"), io), 0, "i32 overflow rejected");
    assert_eq(sfz_u32(str_from("9223372036854775808"), io), 0, "u32 overflow rejected");
    assert_eq(sfz_u32(str_from("300000000"), io), 1, "valid u32 still accepted");
    assert_eq(sfz_u32(str_from("4294967296"), io), 0, "above u32::MAX rejected");
    assert_eq(sfz_u8(str_from("99999999999999999999"), io), 0, "u8 huge rejected");
    assert_eq(sfz_u8(str_from("255"), io), 1, "u8 255 accepted");
    assert_eq(sfz_u8(str_from("256"), io), 0, "u8 256 rejected");

    # A group above the rr_counters cap must import as UNGROUPED, not abort.
    test_group("huge group imports without aborting (2.0.2)");
    var gp = n_sfz_parse("<region> sample=x.wav group=300000000");
    assert(gp > 0, "huge group parses");
    # n_sfz_to_instrument returns an NSfzInstResult, not an instrument. 2.0.2 to 2.2.1 passed the
    # result itself to the two instrument calls below, which then read its sample_files vec as the
    # zone list: zone_count saw 1 file and passed by accident, and find_zone_rr walked file-name
    # Strs as zones. 2.2.2's sequence counters read past the 2-slot result and segfaulted.
    var ginst = NSfzInstResult_instrument(n_sfz_to_instrument(gp, str_from("g"), f64_from(44100)));
    assert(ginst > 0, "huge group builds an instrument");
    # Reaching this line IS the assertion. Before the N_MAX_ZONE_GROUP cap, group=300000000
    # made n_instrument_ensure_counters push ~300M slots -- ~4 GB, then `vec: capacity
    # overflow` and exit(1). A test that merely inspects the parsed group would not prove
    # that, because the abort happened during add_zone, before anything was inspectable.
    assert_eq(n_instrument_zone_count(ginst), 1, "the region imported as exactly one zone");
    ignore(n_instrument_find_zone_rr(ginst, 60, 100));
    assert(1, "find_zone_rr over a capped group does not abort");

    # --- 2.0.5: oracle #[test] cases with no counterpart ---

    # rust-old/src/sfz.rs parse_empty_file
    test_group("empty input parses to an empty file (2.0.5)");
    var ef = n_sfz_parse("");
    assert(ef > 0, "empty input parses (does not error)");
    assert_eq(vec_len(NSfzFile_regions(ef)), 0, "no regions");
    assert_eq(vec_len(NSfzFile_groups(ef)), 0, "no groups");

    # rust-old/src/sfz.rs loop_mode_mapping -- all six cases, including the two that must
    # fall through to OneShot. `no_loop` and `one_shot` are NOT recognised names in the
    # mapper; they reach OneShot via the same default as an unknown token, and the oracle
    # asserted all six explicitly rather than trusting that.
    test_group("loop_mode mapping, all six oracle cases (2.0.5)");
    assert_eq(n_sfz_map_loop_mode(0), LOOP_ONESHOT, "None -> OneShot");
    assert_eq(n_sfz_map_loop_mode(str_from("no_loop")), LOOP_ONESHOT, "no_loop -> OneShot");
    assert_eq(n_sfz_map_loop_mode(str_from("one_shot")), LOOP_ONESHOT, "one_shot -> OneShot");
    assert_eq(n_sfz_map_loop_mode(str_from("loop_continuous")), LOOP_FORWARD, "loop_continuous -> Forward");
    assert_eq(n_sfz_map_loop_mode(str_from("loop_sustain")), LOOP_SUSTAIN, "loop_sustain -> LoopSustain");
    assert_eq(n_sfz_map_loop_mode(str_from("unknown_mode")), LOOP_ONESHOT, "unknown -> OneShot");

    # rust-old/src/sfz.rs invalid_opcode_ignored -- unknown opcodes must be dropped silently
    # WITHOUT derailing the rest of the region.
    test_group("unknown opcodes are ignored, not fatal (2.0.5)");
    var iv = n_sfz_parse("<region>\nsample=test.wav\ntotally_fake_opcode=999\nanother_invalid=hello\nlokey=60\n");
    assert(iv > 0, "parses despite unknown opcodes");
    assert_eq(vec_len(NSfzFile_regions(iv)), 1, "one region");
    var ivr = vec_get(NSfzFile_regions(iv), 0);
    assert_eq(NSfzRegion_lokey(ivr), 60, "lokey survives the unknown opcodes");
    assert_eq(str_eq_cstr(NSfzRegion_sample(ivr), "test.wav"), 1, "sample survives");

    # loop_start / loop_end VALUES -- the path 2.0.2 rewrote to sfz_u32. The suite asserted
    # the loop MODE but never the numbers.
    test_group("loop point values reach the zone (2.0.5)");
    var lz = zone0(n_sfz_parse("<region> sample=a.wav key=60 loop_mode=loop_continuous loop_start=1000 loop_end=2000\n"), sr);
    assert_eq(NZone_loop_mode(lz), LOOP_FORWARD, "loop_mode -> Forward");
    assert_eq(NZone_loop_start(lz), 1000, "loop_start 1000");
    assert_eq(NZone_loop_end(lz), 2000, "loop_end 2000");

    # Wiring paths exercised by NOTHING in the repo before 2.0.5.
    test_group("resonance / fil_resonance wiring (2.0.5)");
    var rz = zone0(n_sfz_parse("<region> sample=a.wav key=60 cutoff=1000 resonance=3\n"), sr);
    assert_eq(approx(NZone_filter_resonance(rz), f64_from(3), tol), 1, "resonance -> zone");
    var rz2 = zone0(n_sfz_parse("<region> sample=a.wav key=60 cutoff=1000 fil_resonance=5\n"), sr);
    assert_eq(approx(NZone_filter_resonance(rz2), f64_from(5), tol), 1, "fil_resonance alias -> zone");

    test_group("pitchlfo / fillfo wiring (2.0.5)");
    var pz = zone0(n_sfz_parse("<region> sample=a.wav key=60 pitchlfo_freq=5 pitchlfo_depth=50\n"), sr);
    assert_eq(approx(NZone_pitchlfo_rate(pz), f64_from(5), tol), 1, "pitchlfo_freq -> rate");
    assert_eq(approx(NZone_pitchlfo_depth(pz), f64_from(50), tol), 1, "pitchlfo_depth -> depth");
    var fz = zone0(n_sfz_parse("<region> sample=a.wav key=60 cutoff=1000 fillfo_freq=2 fillfo_depth=1200\n"), sr);
    assert_eq(approx(NZone_fillfo_rate(fz), f64_from(2), tol), 1, "fillfo_freq -> rate");
    assert_eq(approx(NZone_fillfo_depth(fz), f64_from(1200), tol), 1, "fillfo_depth -> depth");

    test_group("<curve> header is recognised (2.0.5)");
    assert_eq(n_sfz_parse_header(str_from("<curve>")), SFZ_HDR_CURVE, "<curve> -> SFZ_HDR_CURVE");
    var cv = n_sfz_parse("<curve>\nv000=0\n<region> sample=a.wav key=60\n");
    assert(cv > 0, "a file containing <curve> still parses");
    assert_eq(vec_len(NSfzFile_regions(cv)), 1, "<curve> does not swallow the region");

    # --- 2.0.6: -0.0 must satisfy the "unset" sentinel, as `== 0.0` did in Rust ---
    # sfz_inh compares raw BIT PATTERNS, and -0.0 is 0x8000...0, not bit-equal to +0.0. So
    # `<global> volume=-6` + `<region> volume=-0` inherited -6.0 in the oracle and stayed at
    # -0.0 here. sfz_f64 now normalises -0.0 to +0.0 at the parse site, which is
    # behaviour-preserving downstream (same amplitude, same pan, same envelope).
    test_group("-0.0 is treated as unset for inheritance (2.0.6)");
    var nz = alloc(8);
    assert_eq(sfz_f64(str_from("-0"), nz), 1, "-0 parses");
    assert_eq(load64(nz), 0, "-0 normalised to +0.0 bit pattern");
    assert_eq(sfz_f64(str_from("-0.0"), nz), 1, "-0.0 parses");
    assert_eq(load64(nz), 0, "-0.0 normalised to +0.0 bit pattern");
    var negz = zone0(n_sfz_parse("<global> volume=-6\n<region> sample=a.wav key=60 volume=-0\n"), sr);
    assert_eq(approx(NZone_volume_db(negz), f64_neg(f64_from(6)), tol), 1,
        "volume=-0 inherits the group's -6, matching the oracle");

    # --- 2.2.2: hostile-input hardening (P(-1) audit) ---

    # default_path is joined onto every region's filename, so its length multiplied into the
    # heap: a 1.19 MB file (1 MB path, 8,000 one-letter regions) needed ~8 GB and segfaulted.
    test_group("default_path: over-long path ignored, join shared per sample (2.2.2)");
    var dpl = n_sfz_parse(region_buf(dp_buf(8192), 3, 0));
    assert_eq(NSfzFile_default_path(dpl), 0, "an 8 KB default_path (> PATH_MAX) is ignored");
    assert_eq(str_eq_cstr(NSfzZoneFile_filename(vec_get(n_sfz_to_zones(dpl, sr), 0)), "s0000000.wav"), 1,
        "and the filename stays the raw sample");
    var dpk = n_sfz_parse(region_buf(dp_buf(4096), 1, 0));
    assert(NSfzFile_default_path(dpk) != 0, "a 4096-byte default_path is still honoured");
    # 2,000 regions sharing one sample under a 4,000-byte path: the join used to cost 2,000 x 4 KB.
    var with_dp = n_sfz_parse(region_buf(dp_buf(4000), 2000, 0));
    var no_dp = n_sfz_parse(region_buf("", 2000, 0));
    var h0 = alloc_used();
    ignore(n_sfz_to_zones(no_dp, sr));
    var h1 = alloc_used();
    ignore(n_sfz_to_zones(with_dp, sr));
    var h2 = alloc_used();
    assert((h2 - h1) - (h1 - h0) < 65536, "default_path adds < 64 KB over 2,000 regions sharing a sample");
    var jz = n_sfz_to_zones(with_dp, sr);
    assert_eq(NSfzZoneFile_filename(vec_get(jz, 0)), NSfzZoneFile_filename(vec_get(jz, 1999)),
        "regions with the same sample share one joined filename");
    assert_eq(str_len(NSfzZoneFile_filename(vec_get(jz, 0))), 4000 + 12, "joined = path + sample");

    # The dedup scanned every known filename per zone: 40,000 distinct names took 14.9 s.
    test_group("to_instrument dedup is not quadratic (2.2.2)");
    var dd = n_sfz_parse(region_buf("", 20000, 1));
    var t0 = now_ns();
    var ddi = n_sfz_to_instrument(dd, str_from("dd"), sr);
    var dms = (now_ns() - t0) / 1000000;
    # 20,000 distinct names: ~3,700 ms quadratic, ~20 ms hashed. The bound sits far from both.
    assert(dms < 1500, "to_instrument over 20,000 distinct samples finishes in < 1.5 s");
    assert_eq(vec_len(NSfzInstResult_sample_files(ddi)), 20000, "20,000 sample files");
    var ddz = NInstrument_zones(NSfzInstResult_instrument(ddi));
    assert_eq(NZone_sample_id(vec_get(ddz, 0)), 0, "first-seen order: zone 0 -> id 0");
    assert_eq(NZone_sample_id(vec_get(ddz, 19999)), 19999, "first-seen order: zone 19999 -> id 19999");
    var dr = n_sfz_to_instrument(n_sfz_parse("<region> sample=b.wav\n<region> sample=a.wav\n<region> sample=b.wav\n<region> sample=c.wav\n<region> sample=a.wav\n"), str_from("r"), sr);
    var drz = NInstrument_zones(NSfzInstResult_instrument(dr));
    assert_eq(NZone_sample_id(vec_get(drz, 2)), 0, "repeat of b -> id 0");
    assert_eq(NZone_sample_id(vec_get(drz, 3)), 2, "c -> id 2");
    assert_eq(NZone_sample_id(vec_get(drz, 4)), 1, "repeat of a -> id 1");

    # Parsing allocated ~124 heap bytes per input byte (a vec of lines, a trimmed Str and two
    # str_from headers per line, a fresh token vec per line), so a 40 MB file segfaulted.
    test_group("parse heap tracks what the file keeps, not its line count (2.2.2)");
    var xb = rep_buf("x\n", 262144);
    var pa0 = alloc_used();
    ignore(n_sfz_parse(xb));
    var pa1 = alloc_used();
    assert((pa1 - pa0) < 65536, "256 KB of opcode-free lines allocates < 64 KB (was ~32 MB)");

    # Kept strings were views into the caller's buffer, and not NUL-terminated.
    test_group("parsed strings are owned and NUL-terminated (2.2.2)");
    var srcl = "<control> default_path=d/\n#include \"i.sfz\"\n<region> sample=a.wav loop_mode=loop_continuous fil_type=hpf_2p volume_oncc7=3\n";
    var obuf = alloc(strlen(srcl) + 1);
    memcpy(obuf, srcl, strlen(srcl) + 1);
    var of = n_sfz_parse(obuf);
    var k = 0;
    while (k < strlen(srcl)) { store8(obuf + k, 90); k = k + 1; }
    var oreg = vec_get(NSfzFile_regions(of), 0);
    assert_eq(str_eq_cstr(NSfzRegion_sample(oreg), "a.wav"), 1, "sample survives the caller reusing its buffer");
    assert_eq(str_eq_cstr(NSfzRegion_loop_mode(oreg), "loop_continuous"), 1, "loop_mode survives");
    assert_eq(str_eq_cstr(NSfzRegion_fil_type(oreg), "hpf_2p"), 1, "fil_type survives");
    assert_eq(str_eq_cstr(NSfzCC_param(vec_get(NSfzRegion_cc_modulations(oreg), 0)), "volume"), 1, "cc param survives");
    assert_eq(str_eq_cstr(NSfzFile_default_path(of), "d/"), 1, "default_path survives");
    assert_eq(str_eq_cstr(vec_get(NSfzFile_includes(of), 0), "i.sfz"), 1, "include survives");
    var osf = vec_get(NSfzInstResult_sample_files(n_sfz_to_instrument(of, str_from("o"), sr)), 0);
    assert_eq(str_eq_cstr(osf, "d/a.wav"), 1, "joined filename correct");
    assert_eq(strlen(str_data(osf)), str_len(osf), "joined filename is NUL-terminated (a cstr path)");
    var nsf = vec_get(NSfzInstResult_sample_files(n_sfz_to_instrument(n_sfz_parse("<region> sample=a.wav key=60\n"), str_from("n"), sr)), 0);
    assert_eq(strlen(str_data(nsf)), str_len(nsf), "plain filename is NUL-terminated (a cstr path)");

    # rust-old/src/sfz.rs parse_note_or_number: `parse::<u8>()` then an i32 octave.
    test_group("note names: u8 numeric, i32 octave (2.2.2)");
    assert_eq(n_sfz_note_or_num(str_from("-0")), 0 - 1, "-0 is not a u8 and not a note -> None");
    assert_eq(n_sfz_note_or_num(str_from("+60")), 60, "+60 is a u8 -> 60");
    assert_eq(n_sfz_note_or_num(str_from("c4611686018427387903")), 0 - 1, "octave past i32 -> None (wrapped to 0)");
    assert_eq(n_sfz_note_or_num(str_from("e4611686018427387903")), 0 - 1, "octave past i32 -> None (wrapped to 4)");
    assert_eq(n_sfz_note_or_num(str_from("c1073741823")), 0 - 1, "huge i32 octave -> None, no wrap");
    assert_eq(n_sfz_note_or_num(str_from("c+4")), 60, "c+4 -> 60 (i32 accepts a leading +)");
    var mz = vec_get(NSfzFile_regions(n_sfz_parse("<region> sample=a.wav hikey=-0 pitch_keycenter=-0\n")), 0);
    assert_eq(NSfzRegion_hikey(mz), 127, "hikey=-0 leaves 127");
    assert_eq(NSfzRegion_pitch_keycenter(mz), 60, "pitch_keycenter=-0 leaves 60");

    # parse(): `trim_start_matches("#include").trim().trim_matches('"')`.
    test_group("#include path trimming follows trim_matches (2.2.2)");
    var qi = n_sfz_parse("#include \"\"a.sfz\"\"\n#include \"\"\"\n#include#include \"b.sfz\"\n");
    assert_eq(vec_len(NSfzFile_includes(qi)), 2, "an all-quotes path is empty -> not recorded");
    assert_eq(str_eq_cstr(vec_get(NSfzFile_includes(qi), 0), "a.sfz"), 1, "every surrounding quote stripped");
    assert_eq(str_eq_cstr(vec_get(NSfzFile_includes(qi), 1), "b.sfz"), 1, "a repeated #include prefix stripped");

    # str::split_whitespace and str::trim split on every Unicode White_Space code point.
    test_group("Unicode White_Space separates tokens and trims lines (2.2.2)");
    assert_eq(vec_len(NSfzFile_regions(n_sfz_parse("<region>\x0Csample=a.wav\x0Ckey=60\n"))), 1, "form feed (U+000C)");
    assert_eq(vec_len(NSfzFile_regions(n_sfz_parse("<region>\x0Bsample=a.wav\n"))), 1, "vertical tab (U+000B)");
    assert_eq(vec_len(NSfzFile_regions(n_sfz_parse("<region>\xC2\xA0sample=a.wav\n"))), 1, "NBSP (U+00A0)");
    assert_eq(vec_len(NSfzFile_regions(n_sfz_parse("<region>\xE3\x80\x80sample=a.wav\n"))), 1, "ideographic space (U+3000)");
    assert_eq(vec_len(NSfzFile_regions(n_sfz_parse("<region>\xE2\x80\xA8sample=a.wav\n"))), 1, "line separator (U+2028)");
    var wsf = n_sfz_parse("<region>\xE2\x80\x8Asample=a.wav\xC2\x85key=62\n");
    assert_eq(vec_len(NSfzFile_regions(wsf)), 1, "hair space (U+200A) after <region>");
    if (vec_len(NSfzFile_regions(wsf)) == 1) {
        var wsr = vec_get(NSfzFile_regions(wsf), 0);
        assert_eq(str_eq_cstr(NSfzRegion_sample(wsr), "a.wav"), 1, "NEL (U+0085) ends the sample token");
        assert_eq(NSfzRegion_key(wsr), 62, "NEL (U+0085) separates key=62");
    }
    assert_eq(vec_len(NSfzFile_includes(n_sfz_parse("\xC2\xA0#include \"a.sfz\"\xE3\x80\x80\n"))), 1, "a line is trimmed of Unicode spaces before #include");
    assert_eq(vec_len(NSfzFile_regions(n_sfz_parse("<region>\xC2\xA1sample=a.wav\n"))), 0, "U+00A1 is not whitespace");

    # rust-old/src/sfz.rs:265-272, 345-354: loop points, offset and end are `usize`.
    test_group("loop points / offset / end parse as usize (2.2.2)");
    var uz = vec_get(NSfzFile_regions(n_sfz_parse("<region> sample=a.wav offset=4294967296 end=4294967297 loop_start=4294967298 loop_end=18446744073709551615\n")), 0);
    assert_eq(NSfzRegion_offset(uz), 4294967296, "offset above u32::MAX accepted");
    assert_eq(NSfzRegion_end(uz), 4294967297, "end above u32::MAX accepted");
    assert_eq(NSfzRegion_loop_start(uz), 4294967298, "loop_start above u32::MAX accepted");
    assert_eq(NSfzRegion_loop_end(uz), 9223372036854775807, "u64::MAX accepted, saturated to i64::MAX");
    var ux = vec_get(NSfzFile_regions(n_sfz_parse("<region> sample=a.wav offset=7 offset=18446744073709551616 end=99999999999999999999999\n")), 0);
    assert_eq(NSfzRegion_offset(ux), 7, "above u64::MAX is an Err -> field unchanged");
    assert_eq(NSfzRegion_end(ux), 0, "far above u64::MAX is an Err -> field unchanged");
    var uo = alloc(8);
    assert_eq(sfz_uint(str_from("00018446744073709551615"), uo), 1, "leading zeros do not count toward the 20 digits");
    assert_eq(sfz_uint(str_from("18446744073709551616"), uo), 0, "u64::MAX + 1 rejected");
    assert_eq(sfz_uint(str_from("+"), uo), 0, "a lone + rejected");


    # --- 2.2.2: seq_length / seq_position are SFZ's round-robin (ADR 0012) ---
    # The oracle wrote seq_position into `group`, giving every region of a round-robin set its own
    # group, so find_zone_rr could never cycle the set: a3.wav below never played.
    test_group("seq_length / seq_position round-robin (2.2.2)");
    var rrf = n_sfz_parse("<group> seq_length=3 key=60\n<region> sample=a1.wav seq_position=1\n<region> sample=a2.wav seq_position=2\n<region> sample=a3.wav seq_position=3\n");
    var rrz = n_sfz_to_zones(rrf, sr);
    assert_eq(vec_len(rrz), 3, "3 regions");
    var rrz2 = NSfzZoneFile_zone(vec_get(rrz, 2));
    assert_eq(NZone_seq_length(rrz2), 3, "seq_length inherits from <group>");
    assert_eq(NZone_seq_position(rrz2), 3, "seq_position from the region");
    assert_eq(NZone_group(rrz2), 0, "seq_position no longer writes the RR group");
    var rri = NSfzInstResult_instrument(n_sfz_to_instrument(rrf, str_from("rr"), sr));
    assert_eq(n_instrument_find_zone_rr(rri, 60, 100), 0, "note 1 plays a1");
    assert_eq(n_instrument_find_zone_rr(rri, 60, 100), 1, "note 2 plays a2");
    assert_eq(n_instrument_find_zone_rr(rri, 60, 100), 2, "note 3 plays a3");
    assert_eq(n_instrument_find_zone_rr(rri, 60, 100), 0, "note 4 plays a1 again");
    var rrd = zone0(n_sfz_parse("<region> sample=a.wav\n"), sr);
    assert_eq(NZone_seq_length(rrd), 1, "no seq opcodes: length 1");
    assert_eq(NZone_seq_position(rrd), 1, "no seq opcodes: position 1");
    assert_eq(NZone_group(zone0(n_sfz_parse("<region> sample=a.wav group=4\n"), sr)), 4, "group= still sets the RR group, as in the oracle");
    return assert_summary();
}

var exit_code = main();
syscall(60, exit_code);
