# engine.tcyr -- parity tests for src/engine.cyr (ports rust-old/src/engine.rs #[test]s).

include "lib/hisab.cyr"
include "lib/goonj.cyr"
include "lib/naad.cyr"
include "src/error.cyr"
include "src/f64_util.cyr"
include "src/loop_mode.cyr"
include "src/envelope.cyr"
include "src/zone.cyr"
include "src/sample.cyr"
include "src/instrument.cyr"
include "src/engine.cyr"

# Explicitly discard a #must_use result the test does not need. Naming the intent beats
# leaving a permanent warning that trains everyone to ignore the diagnostic.
fn ignore(v) { return 0; }

fn make_sine(freq, n) {
    var v = vec_new();
    var i = 0;
    while (i < n) {
        var ph = f64_div(f64_mul(f64_mul(F64_TAU, f64_from(freq)), f64_from(i)), f64_from(44100));
        vec_push(v, f64_sin(ph));
        i = i + 1;
    }
    return v;
}

fn make_engine_n(max) {
    var sr = f64_from(44100);
    var bank = n_sample_bank_new();
    var id = n_sample_bank_add(bank, n_sample_from_mono(make_sine(440, 44100), 44100));
    var zone = n_zone_new(id);
    zone = n_zone_with_key_range(zone, 0, 127);
    zone = n_zone_with_root_note(zone, 69);
    var inst = n_instrument_new(str_from("t"));
    n_instrument_add_zone(inst, zone);
    var e = n_engine_new(max, sr);
    n_engine_set_bank(e, bank);
    n_engine_set_instrument(e, inst);
    return e;
}

fn make_engine() { return make_engine_n(8); }

# Every sample-rate consumer on one voice: filter, filter envelope, and both LFOs.
fn make_engine_modulated(sr) {
    var bank = n_sample_bank_new();
    var id = n_sample_bank_add(bank, n_sample_from_mono(make_sine(440, 4410), 44100));
    var z = n_zone_new(id);
    z = n_zone_with_key_range(z, 0, 127);
    z = n_zone_with_root_note(z, 69);
    z = n_zone_with_filter(z, f64_from(2400), F64_HALF);
    z = n_zone_with_filter_envelope(z, n_adsr_config_new(10, 100, F64_HALF, 100), f64_from(1200));
    z = n_zone_with_pitch_lfo(z, f64_from(5), f64_from(30));
    z = n_zone_with_filter_lfo(z, f64_from(3), f64_from(300));
    var inst = n_instrument_new(str_from("t"));
    n_instrument_add_zone(inst, z);
    var e = n_engine_new(4, sr);
    n_engine_set_bank(e, bank);
    n_engine_set_instrument(e, inst);
    return e;
}

fn make_engine_with_zone(zone) {
    var sr = f64_from(44100);
    var bank = n_sample_bank_new();
    var id = n_sample_bank_add(bank, n_sample_from_mono(make_sine(440, 44100), 44100));
    NZone_set_sample_id(zone, id);
    var inst = n_instrument_new(str_from("t"));
    n_instrument_add_zone(inst, zone);
    var e = n_engine_new(8, sr);
    n_engine_set_bank(e, bank);
    n_engine_set_instrument(e, inst);
    return e;
}

fn sum_abs(e, n) {
    var s = 0;
    var i = 0;
    while (i < n) { s = f64_add(s, f64_abs(n_engine_next_sample(e))); i = i + 1; }
    return s;
}

fn run_samples(e, n) {
    var i = 0;
    while (i < n) { ignore(n_engine_next_sample(e)); i = i + 1; }
    return 0;
}

# --- 2.0.2 regression harness: the render path must allocate NOTHING ---
# Before 2.0.2, n_engine_next_sample_stereo did three alloc(16) per FRAME and
# n_engine_next_sample a fourth: 48 B/frame stereo = 2,116,800 B/s at 44.1 kHz, none of
# it ever reclaimed (lib/alloc.cyr is a bump allocator with a no-op free). The endgame is
# memory UNSAFETY, not just growth -- once alloc() returns 0 the render path store64's
# through a null pointer inside the audio callback. naad's allocating one-shot SVF added
# another 32 B per channel per voice per sample on top.
fn eng_leak_build(nv, mode) {
    var e = n_engine_new(nv, f64_from(44100));
    var bank = n_engine_bank(e);
    var data = vec_new();
    var i = 0;
    while (i < 8820) { vec_push(data, f64_div(f64_from(i % 100), f64_from(200))); i = i + 1; }
    var sid = n_sample_bank_add(bank, n_sample_from_mono(data, 44100));
    var inst = n_instrument_new(str_from("leak"));
    var z = n_zone_new(sid);
    z = n_zone_with_key_range(z, 0, 127);
    if (mode >= 0) {
        z = n_zone_with_filter(z, f64_from(2000), 0);
        z = n_zone_with_filter_type(z, mode);
    }
    n_instrument_add_zone(inst, z);
    n_engine_set_instrument(e, inst);
    return e;
}

fn eng_leak_bytes(nv, mode) {
    var e = eng_leak_build(nv, mode);
    ignore(n_engine_note_on(e, 60, 100));
    var buf = vec_new();
    var i = 0;
    while (i < 1024) { vec_push(buf, 0); i = i + 1; }
    n_engine_fill_buffer_stereo(e, buf, 1024);
    var before = alloc_used();
    var b = 0;
    while (b < 20) { n_engine_fill_buffer_stereo(e, buf, 1024); b = b + 1; }
    return alloc_used() - before;
}


# --- 2.0.3: loop crossfade seam ---
# A 400-frame linear ramp is the right probe: with a CORRECT loop crossfade the seam is
# exactly continuous, because the material preceding loop_start is what must follow
# loop_end. Returns the largest frame-to-frame jump in the left channel across the wrap,
# so a smaller number is a tighter seam. See docs/adr/0001-loop-crossfade-seam.md.
fn xf_seam(xfade, ls, le) {
    var e = n_engine_new(4, f64_from(44100));
    var bank = n_engine_bank(e);
    var d = vec_new();
    var i = 0;
    while (i < 400) { vec_push(d, f64_div(f64_from(i), f64_from(400))); i = i + 1; }
    var sid = n_sample_bank_add(bank, n_sample_from_mono(d, 44100));
    var inst = n_instrument_new(str_from("ramp"));
    var z = n_zone_new(sid);
    z = n_zone_with_key_range(z, 0, 127);
    z = n_zone_with_root_note(z, 60);
    z = n_zone_with_loop(z, LOOP_FORWARD, ls, le);
    z = n_zone_with_crossfade(z, xfade);
    n_instrument_add_zone(inst, z);
    ignore(n_engine_set_instrument(e, inst));
    ignore(n_engine_note_on(e, 60, 127));
    var buf = vec_new();
    var k = 0;
    while (k < 1200) { vec_push(buf, 0); k = k + 1; }
    n_engine_fill_buffer_stereo(e, buf, 1200);
    var worst = 0;
    var f = 20;
    while (f < 590) {
        var dlt = f64_abs(f64_sub(vec_get(buf, (f + 1) * 2), vec_get(buf, f * 2)));
        if (f64_gt(dlt, worst) == 1) { worst = dlt; }
        f = f + 1;
    }
    return f64_to(f64_mul(worst, f64_from(1000000)));
}


# Renders one block at volume 0 dB and one at -6 dB from an otherwise identical zone, and
# returns the ratio of peak levels scaled by 1000. -6 dB is a factor of 0.501, so ~501.
fn vol_peak(db) {
    var e = n_engine_new(4, f64_from(44100));
    var bank = n_engine_bank(e);
    var d = vec_new();
    var i = 0;
    while (i < 2000) { vec_push(d, f64_div(f64_from((i * 11) % 32), f64_from(32))); i = i + 1; }
    var sid = n_sample_bank_add(bank, n_sample_from_mono(d, 44100));
    var inst = n_instrument_new(str_from("v"));
    var z = n_zone_with_root_note(n_zone_with_key_range(n_zone_new(sid), 0, 127), 60);
    z = n_zone_with_volume(z, db);
    n_instrument_add_zone(inst, z);
    ignore(n_engine_set_instrument(e, inst));
    ignore(n_engine_note_on(e, 60, 127));
    var buf = vec_new();
    var k = 0;
    while (k < 512) { vec_push(buf, 0); k = k + 1; }
    n_engine_fill_buffer_stereo(e, buf, 512);
    var pk = 0;
    var j = 0;
    while (j < 512) {
        var a = f64_abs(vec_get(buf, j));
        if (f64_gt(a, pk) == 1) { pk = a; }
        j = j + 1;
    }
    return pk;
}

fn fn_vol_check() {
    var p0 = vol_peak(0);
    var pm6 = vol_peak(f64_neg(f64_from(6)));
    var pp6 = vol_peak(f64_from(6));
    assert_eq(f64_gt(p0, 0), 1, "0 dB reference renders audible output");
    # -6 dB = x0.5012. Assert the RATIO so the test does not depend on the source material.
    var ratio = f64_to(f64_mul(f64_div(pm6, p0), f64_from(1000)));
    assert(ratio > 480, "volume=-6 attenuates (ratio > 0.48)");
    assert(ratio < 520, "volume=-6 attenuates to ~0.501, not further");
    # +6 dB = x1.995.
    var ratio_up = f64_to(f64_mul(f64_div(pp6, p0), f64_from(1000)));
    assert(ratio_up > 1900, "volume=+6 boosts (ratio > 1.9)");
    assert(ratio_up < 2100, "volume=+6 boosts to ~1.995");
    return 0;
}


# Bytes allocated across N note_on/note_off pairs on an already-warmed engine.
# Warm-up first: each voice builds its two SVFs lazily on its first filtered note (nvf_reinit),
# once for its whole life. Since 2.2.2 (ADR 0006) a note goes to a voice that is really free,
# so with no render between on and off the 8 voices are all still releasing and every pair
# lands on a new voice until all 8 are warm. One full pass of the loop warms them all; the
# measured pass after it must then allocate exactly nothing.
fn noteon_bytes(pairs) {
    var e = eng_leak_build(8, FILTER_LOWPASS);
    var w = 0;
    while (w < pairs) {
        ignore(n_engine_note_on(e, 60 + (w % 12), 100));
        n_engine_note_off(e, 60 + (w % 12));
        w = w + 1;
    }
    var before = alloc_used();
    var i = 0;
    while (i < pairs) {
        ignore(n_engine_note_on(e, 60 + (i % 12), 100));
        n_engine_note_off(e, 60 + (i % 12));
        i = i + 1;
    }
    return alloc_used() - before;
}


# ---------------------------------------------------------------------------------------------
# 2.2.2 sweep helpers. Constant (or arithmetic) sample data, so nothing here depends on f64_sin.
# ---------------------------------------------------------------------------------------------

# 1-zone engine over all keys with `frames` frames of constant 0.5 at sample rate `ssr`.
fn sw_engine(nv, frames, ssr, esr) {
    var e = n_engine_new(nv, f64_from(esr));
    var d = vec_new();
    var i = 0;
    while (i < frames) { vec_push(d, F64_HALF); i = i + 1; }
    var sid = n_sample_bank_add(n_engine_bank(e), n_sample_from_mono(d, ssr));
    var inst = n_instrument_new(str_from("sw"));
    var z = n_zone_with_loop(n_zone_with_key_range(n_zone_new(sid), 0, 127), LOOP_FORWARD, 0, 0);
    n_instrument_add_zone(inst, z);
    ignore(n_engine_set_instrument(e, inst));
    return e;
}

fn sw_energy(e, n) {
    var s = 0;
    var i = 0;
    while (i < n) { s = f64_add(s, f64_abs(n_engine_next_sample(e))); i = i + 1; }
    return s;
}

# Render `n` mono samples and count the non-finite ones.
fn sw_nonfinite(e, n) {
    var bad = 0;
    var i = 0;
    while (i < n) { if (n_is_finite(n_engine_next_sample(e)) == 0) { bad = bad + 1; } i = i + 1; }
    return bad;
}

# Engine with one filtered zone (8 kHz, vel_track `vt`) over a 50-frame sawtooth.
fn sw_filtered(vt) {
    var e = n_engine_new(2, f64_from(44100));
    var d = vec_new();
    var i = 0;
    while (i < 20000) { vec_push(d, f64_div(f64_from(i % 50), f64_from(50))); i = i + 1; }
    var sid = n_sample_bank_add(n_engine_bank(e), n_sample_from_mono(d, 44100));
    var inst = n_instrument_new(str_from("f"));
    n_instrument_add_zone(inst, n_zone_with_filter(n_zone_with_key_range(n_zone_new(sid), 0, 127), f64_from(8000), vt));
    ignore(n_engine_set_instrument(e, inst));
    return e;
}
fn sw_cutoff(e) {
    var v = vec_get(NSamplerEngine_voices(e), 0);
    return f64_to(filter_svf_frequency(NVoiceFilter_filter_l(NSamplerVoice_filter(v))));
}

# Largest frame-to-frame jump (x1e6) after a LoopSustain voice on a 400-frame ramp is released
# at frame 50 and plays straight through loop_end (loop 100..200).
fn sw_sustain_jump(xfade) {
    var e = n_engine_new(2, f64_from(44100));
    n_engine_set_release_ms(e, f64_from(100000));
    var d = vec_new();
    var i = 0;
    while (i < 400) { vec_push(d, f64_div(f64_from(i), f64_from(400))); i = i + 1; }
    var sid = n_sample_bank_add(n_engine_bank(e), n_sample_from_mono(d, 44100));
    var inst = n_instrument_new(str_from("r"));
    var z = n_zone_with_loop(n_zone_with_key_range(n_zone_new(sid), 0, 127), LOOP_SUSTAIN, 100, 200);
    n_instrument_add_zone(inst, n_zone_with_crossfade(z, xfade));
    ignore(n_engine_set_instrument(e, inst));
    ignore(n_engine_note_on(e, 60, 127));
    var o = alloc(16);
    var prev = 0;
    var worst = 0;
    var f = 0;
    while (f < 300) {
        if (f == 50) { n_engine_note_off(e, 60); }
        n_engine_next_sample_stereo(e, o);
        if (f > 150) {
            var dl = f64_abs(f64_sub(load64(o), prev));
            if (f64_gt(dl, worst) == 1) { worst = dl; }
        }
        prev = load64(o);
        f = f + 1;
    }
    return f64_to(f64_mul(worst, f64_from(1000000)));
}

fn main() {
    alloc_init();
    var eps = f64_div(F64_ONE, f64_from(100));
    var tenth = f64_div(F64_ONE, f64_from(10));

    test_group("note_on produces output");
    var e1 = make_engine();
    assert(n_engine_note_on(e1, 69, 100) >= 0, "note_on returns index");
    assert_eq(n_engine_active_voice_count(e1), 1, "1 active voice");
    assert_eq(f64_gt(sum_abs(e1, 4410), 0), 1, "nonzero output");

    test_group("note_off releases");
    var e2 = make_engine();
    ignore(n_engine_note_on(e2, 69, 100));
    n_engine_note_off(e2, 69);
    run_samples(e2, 44100);
    assert_eq(n_engine_active_voice_count(e2), 0, "voice released");

    test_group("pitch shift");
    var e3 = make_engine();
    ignore(n_engine_note_on(e3, 81, 100));
    var buf3 = vec_new();
    var z3 = 0; while (z3 < 4410) { vec_push(buf3, 0); z3 = z3 + 1; }
    n_engine_fill_buffer(e3, buf3, 4410);
    var any3 = 0; var i3 = 0;
    while (i3 < 4410) { if (f64_gt(f64_abs(vec_get(buf3, i3)), tenth) == 1) { any3 = 1; i3 = 4410; } else { i3 = i3 + 1; } }
    assert_eq(any3, 1, "pitch-shifted output non-trivial");

    test_group("no instrument silent");
    var e4 = n_engine_new(8, f64_from(44100));
    assert_eq(n_engine_note_on(e4, 60, 100), 0 - 1, "note_on -> -1 (no instrument)");
    assert_eq(n_engine_next_sample(e4), 0, "silent");

    test_group("adsr shapes output");
    var e5 = make_engine();
    n_engine_set_adsr(e5, n_adsr_config_new(100, 100, F64_HALF, 100));
    ignore(n_engine_note_on(e5, 69, 127));
    var first5 = f64_abs(n_engine_next_sample(e5));
    run_samples(e5, 49);
    var mid5 = f64_abs(n_engine_next_sample(e5));
    assert_eq(f64_gt(mid5, first5), 1, "envelope rising during attack");

    test_group("stereo pan hard right");
    var zp = n_zone_new(0);
    zp = n_zone_with_key_range(zp, 0, 127);
    zp = n_zone_with_root_note(zp, 69);
    zp = n_zone_with_pan(zp, F64_ONE);
    var e6 = make_engine_with_zone(zp);
    ignore(n_engine_note_on(e6, 69, 127));
    var suml = 0; var sumr = 0; var o6 = alloc(16); var i6 = 0;
    while (i6 < 1000) {
        n_engine_next_sample_stereo(e6, o6);
        suml = f64_add(suml, f64_abs(load64(o6)));
        sumr = f64_add(sumr, f64_abs(load64(o6 + 8)));
        i6 = i6 + 1;
    }
    assert_eq(f64_lt(suml, eps), 1, "hard-right: left ~ 0");
    assert_eq(f64_gt(sumr, F64_ONE), 1, "hard-right: right > 1.0");

    test_group("filter reduces brightness");
    var sq = vec_new();
    var qi = 0;
    while (qi < 44100) {
        if (qi % 2 == 0) { vec_push(sq, F64_ONE); } else { vec_push(sq, f64_neg(F64_ONE)); }
        qi = qi + 1;
    }
    var srf = f64_from(44100);
    var banka = n_sample_bank_new();
    var ida = n_sample_bank_add(banka, n_sample_from_mono(sq, 44100));
    var za = n_zone_new(ida); za = n_zone_with_key_range(za, 0, 127); za = n_zone_with_root_note(za, 69);
    var insta = n_instrument_new(str_from("a")); n_instrument_add_zone(insta, za);
    var ea = n_engine_new(1, srf); n_engine_set_bank(ea, banka); n_engine_set_instrument(ea, insta);
    var bankb = n_sample_bank_new();
    var idb = n_sample_bank_add(bankb, n_sample_from_mono(sq, 44100));
    var zb = n_zone_new(idb); zb = n_zone_with_key_range(zb, 0, 127); zb = n_zone_with_root_note(zb, 69);
    zb = n_zone_with_filter(zb, f64_from(100), 0);
    var instb = n_instrument_new(str_from("b")); n_instrument_add_zone(instb, zb);
    var eb = n_engine_new(1, srf); n_engine_set_bank(eb, bankb); n_engine_set_instrument(eb, instb);
    ignore(n_engine_note_on(ea, 69, 127));
    ignore(n_engine_note_on(eb, 69, 127));
    var sum_un = sum_abs(ea, 1000);
    var sum_fil = sum_abs(eb, 1000);
    assert_eq(f64_lt(sum_fil, sum_un), 1, "LP filter reduces energy");

    test_group("fill_buffer_stereo");
    var e8 = make_engine();
    ignore(n_engine_note_on(e8, 69, 100));
    var buf8 = vec_new(); var z8 = 0; while (z8 < 200) { vec_push(buf8, 0); z8 = z8 + 1; }
    n_engine_fill_buffer_stereo(e8, buf8, 200);
    var any8 = 0; var i8 = 0;
    while (i8 < 200) { if (f64_gt(f64_abs(vec_get(buf8, i8)), eps) == 1) { any8 = 1; i8 = 200; } else { i8 = i8 + 1; } }
    assert_eq(any8, 1, "block render produces output");

    test_group("all_notes_off");
    var e9 = make_engine();
    ignore(n_engine_note_on(e9, 69, 100));
    ignore(n_engine_note_on(e9, 72, 100));
    assert_eq(n_engine_active_voice_count(e9), 2, "2 voices");
    n_engine_all_notes_off(e9);
    run_samples(e9, 44100);
    assert_eq(n_engine_active_voice_count(e9), 0, "all released");

    test_group("per-zone adsr overrides default");
    var z10 = n_zone_new(0);
    z10 = n_zone_with_key_range(z10, 0, 127);
    z10 = n_zone_with_root_note(z10, 69);
    z10 = n_zone_with_adsr(z10, n_adsr_config_new(500, 0, F64_ONE, 100));
    var e10 = make_engine_with_zone(z10);
    ignore(n_engine_note_on(e10, 69, 127));
    var first10 = f64_abs(n_engine_next_sample(e10));
    run_samples(e10, 249);
    var mid10 = f64_abs(n_engine_next_sample(e10));
    assert_eq(f64_gt(mid10, first10), 1, "slow per-zone attack still rising at ~250");

    test_group("choke group");
    var srh = f64_from(44100);
    var bankh = n_sample_bank_new();
    var idh = n_sample_bank_add(bankh, n_sample_from_mono(make_sine(440, 44100), 44100));
    var zha = n_zone_new(idh); zha = n_zone_with_key_range(zha, 42, 42); zha = n_zone_with_choke_group(zha, 1);
    var zhb = n_zone_new(idh); zhb = n_zone_with_key_range(zhb, 46, 46); zhb = n_zone_with_choke_group(zhb, 1);
    var insth = n_instrument_new(str_from("hh")); n_instrument_add_zone(insth, zha); n_instrument_add_zone(insth, zhb);
    var eh = n_engine_new(8, srh); n_engine_set_bank(eh, bankh); n_engine_set_instrument(eh, insth);
    ignore(n_engine_note_on(eh, 46, 100));
    assert_eq(n_engine_active_voice_count(eh), 1, "open hh: 1 voice");
    ignore(n_engine_note_on(eh, 42, 100));
    assert_eq(n_engine_active_voice_count(eh), 1, "closed hh chokes open: still 1");

    test_group("pitch bend");
    var e12 = make_engine();
    ignore(n_engine_note_on(e12, 69, 100));
    run_samples(e12, 100);
    n_engine_apply_pitch_bend(e12, 69, F64_ONE);
    var sum12 = 0; var j12 = 0;
    while (j12 < 100) { sum12 = f64_add(sum12, n_engine_next_sample(e12)); j12 = j12 + 1; }
    assert_eq(n_is_finite(sum12), 1, "bent output finite");

    test_group("steal mode none");
    var e13 = make_engine_n(2);
    n_engine_set_steal_mode(e13, STEAL_MODE_NONE);
    ignore(n_engine_note_on(e13, 60, 100));
    ignore(n_engine_note_on(e13, 64, 100));
    assert_eq(n_engine_active_voice_count(e13), 2, "2 voices full");
    assert_eq(n_engine_note_on(e13, 67, 100), 0 - 1, "none rejects when full");
    assert_eq(n_engine_active_voice_count(e13), 2, "still 2");

    test_group("steal mode oldest");
    var e14 = make_engine_n(2);
    n_engine_set_steal_mode(e14, STEAL_MODE_OLDEST);
    ignore(n_engine_note_on(e14, 60, 100));
    run_samples(e14, 100);
    ignore(n_engine_note_on(e14, 64, 100));
    assert_eq(n_engine_active_voice_count(e14), 2, "2 voices");
    ignore(n_engine_note_on(e14, 67, 100));
    assert_eq(n_engine_active_voice_count(e14), 2, "still 2 after steal");
    assert_eq(n_engine_has_active_note(e14, 67), 1, "note 67 active");

    test_group("steal mode lowest");
    var e15 = make_engine_n(2);
    n_engine_set_steal_mode(e15, STEAL_MODE_LOWEST);
    ignore(n_engine_note_on(e15, 60, 100));
    ignore(n_engine_note_on(e15, 72, 100));
    assert_eq(n_engine_active_voice_count(e15), 2, "2 voices");
    ignore(n_engine_note_on(e15, 66, 100));
    assert_eq(n_engine_active_voice_count(e15), 2, "still 2");
    assert_eq(n_engine_has_active_note(e15, 60), 0, "lowest note 60 stolen");
    assert_eq(n_engine_has_active_note(e15, 66), 1, "note 66 active");
    assert_eq(n_engine_has_active_note(e15, 72), 1, "note 72 active");

    test_group("render path is allocation-free (2.0.2)");
    assert_eq(eng_leak_bytes(8, 0 - 1), 0, "8 voices unfiltered: 0 bytes per 20 blocks");
    assert_eq(eng_leak_bytes(64, 0 - 1), 0, "64 voices unfiltered: 0 bytes per 20 blocks");
    assert_eq(eng_leak_bytes(8, FILTER_LOWPASS), 0, "8 voices lowpass: 0 bytes per 20 blocks");
    assert_eq(eng_leak_bytes(64, FILTER_LOWPASS), 0, "64 voices lowpass: 0 bytes per 20 blocks");

    # 2.2.1: the other three modes took naad's allocating one-shot SVF, 32 B per channel per
    # sample, until naad 2.3.2 shipped filter_svf_process_sample_into.
    test_group("high-pass, band-pass and notch render allocation-free (2.2.1)");
    assert_eq(eng_leak_bytes(8, FILTER_HIGHPASS), 0, "8 voices highpass: 0 bytes per 20 blocks");
    assert_eq(eng_leak_bytes(64, FILTER_HIGHPASS), 0, "64 voices highpass: 0 bytes per 20 blocks");
    assert_eq(eng_leak_bytes(8, FILTER_BANDPASS), 0, "8 voices bandpass: 0 bytes per 20 blocks");
    assert_eq(eng_leak_bytes(64, FILTER_BANDPASS), 0, "64 voices bandpass: 0 bytes per 20 blocks");
    assert_eq(eng_leak_bytes(8, FILTER_NOTCH), 0, "8 voices notch: 0 bytes per 20 blocks");
    assert_eq(eng_leak_bytes(64, FILTER_NOTCH), 0, "64 voices notch: 0 bytes per 20 blocks");

    test_group("engine input validation (2.0.2)");
    # max_voices below 1 used to build 0 nidhi voices against naad's clamped 1 -> exit(1).
    var e0 = n_engine_new(0, f64_from(44100));
    assert(e0 > 0, "n_engine_new(0) returns an engine");
    var b0 = n_engine_bank(e0);
    var d0 = vec_new();
    var q = 0;
    while (q < 400) { vec_push(d0, F64_HALF); q = q + 1; }
    var s0 = n_sample_bank_add(b0, n_sample_from_mono(d0, 44100));
    var i0 = n_instrument_new(str_from("z"));
    var zz = n_zone_with_key_range(n_zone_new(s0), 0, 127);
    n_instrument_add_zone(i0, zz);
    n_engine_set_instrument(e0, i0);
    ignore(n_engine_note_on(e0, 60, 100));
    var bb = vec_new();
    var w = 0;
    while (w < 64) { vec_push(bb, 0); w = w + 1; }
    n_engine_fill_buffer_stereo(e0, bb, 64);
    assert(1, "0-voice engine renders without aborting");

    # A negative error code forwarded from sf2_parse / n_load_wav must be rejected, not
    # laundered into a pointer.
    assert_eq(n_engine_set_instrument(e0, NIDHI_ERR_IMPORT), NIDHI_ERR_INVALID_PARAMETER,
        "set_instrument rejects a negative error code");

    # Hot-swapping to a SMALLER instrument used to leave zone_index past the end of the
    # new zone vec -> _vec_die -> exit(1) mid-render.
    var eswap = eng_leak_build(8, 0 - 1);
    var big = NSamplerEngine_instrument(eswap);
    var k = 0;
    while (k < 7) {
        n_instrument_add_zone(big, n_zone_with_key_range(n_zone_new(0), 0, 127));
        k = k + 1;
    }
    ignore(n_engine_note_on(eswap, 60, 100));
    var small = n_instrument_new(str_from("small"));
    n_instrument_add_zone(small, n_zone_with_key_range(n_zone_new(0), 0, 127));
    n_engine_set_instrument(eswap, small);
    var sb = vec_new();
    var y = 0;
    while (y < 128) { vec_push(sb, 0); y = y + 1; }
    n_engine_fill_buffer_stereo(eswap, sb, 128);
    assert(1, "instrument hot-swap to a smaller patch does not abort");

    test_group("loop crossfade closes the seam (2.0.3)");
    # Before 2.0.3 the fade-in source walked FORWARD from loop_start, so at the wrap it read
    # loop_start + xfade while the next frame played loop_start: the click was attenuated but
    # never closed. Measured 22999 then; the ramp's own per-frame step is ~2500, so 4000 is
    # essentially a closed seam. Assert well inside both, so this cannot silently regress.
    var seam = xf_seam(20, 100, 200);
    assert(seam < 8000, "crossfaded seam is closed (was 22999 before 2.0.3)");
    assert(seam > 0, "seam measurement is live, not a stuck zero");

    # Control: with no crossfade the raw seam must be untouched by this change.
    assert_eq(xf_seam(0, 100, 200), 99000, "no-crossfade seam unchanged");

    # A crossfade longer than the loop used to be live from frame 0, so the loop's own
    # material was never heard at full level. Now clamped to the loop length.
    var seam_long = xf_seam(500, 100, 200);
    assert(seam_long < 8000, "crossfade longer than the loop is clamped (was 19602)");

    # No pre-roll before loop_start: a seam whose endpoints differ CANNOT be closed by any
    # crossfade, so this keeps the legacy forward blend rather than disabling the fade.
    # Disabling measured 199000 -- far worse than shipping nothing. Pin the no-regression.
    assert_eq(xf_seam(20, 0, 200), 28000, "no-preroll case is no worse than 2.0.2");

    # --- 2.0.6: caller-supplied buffer length must not be trusted ---
    # Rust derived the frame count FROM buffer.len(), so over-asking was unrepresentable.
    # The port took a separate length; vec_set past the end is _vec_die -> exit(1) inside
    # the audio callback.
    test_group("fill_buffer clamps to the buffer (2.0.6)");
    var ce = eng_leak_build(4, 0 - 1);
    ignore(n_engine_note_on(ce, 60, 100));
    var small_buf = vec_new();
    var sbi = 0;
    while (sbi < 16) { vec_push(small_buf, 0); sbi = sbi + 1; }
    n_engine_fill_buffer(ce, small_buf, 100000);
    assert_eq(vec_len(small_buf), 16, "mono: over-long n did not grow or overrun the buffer");
    n_engine_fill_buffer_stereo(ce, small_buf, 100000);
    assert_eq(vec_len(small_buf), 16, "stereo: over-long len did not overrun the buffer");

    test_group("set_adsr copies its config (2.0.6)");
    var ae = n_engine_new(2, f64_from(44100));
    var acfg = n_adsr_config_new(11, 22, F64_ONE, 33);
    assert_eq(n_engine_set_adsr(ae, acfg), 0, "set_adsr accepts a valid config");
    NAdsrConfig_set_attack_samples(acfg, 999);
    assert_eq(NAdsrConfig_attack_samples(NSamplerEngine_default_adsr(ae)), 11,
        "mutating the caller's config does not reach the engine");
    assert_eq(n_engine_set_adsr(ae, NIDHI_ERR_IMPORT), NIDHI_ERR_INVALID_PARAMETER,
        "set_adsr rejects a negative error code");

    # --- 2.1.0: per-zone volume is applied (ADR 0004) ---
    # volume_db was parsed, inherited and stored, then read by nothing: a volume=-6 region
    # rendered at full level and the relative balance between regions was discarded.
    test_group("zone volume_db reaches the output (2.1.0)");
    fn_vol_check();

    # --- 2.1.0: note_on reuses the voice's filter instead of allocating one ---
    # Every voice already owns an NVoiceFilter from n_voice_new, but note_on threw it away and
    # built a fresh one -- the struct plus TWO naad SVFs per note, never reclaimed. The
    # envelope and LFO halves still allocate: naad has filter_svf_reset but no
    # envelope_adsr_reset and no LFO frequency setter, so those are upstream-gated.
    test_group("note_on does not allocate a filter per note (2.1.0)");
    var per_note = noteon_bytes(200) / 200;
    println_int(per_note);
    # 2.1.1: ZERO. 2.1.0 reused the filter (264 -> 72 B); the remaining 72 B was the amp
    # envelope, which looked upstream-gated because naad ships no envelope_adsr_set_params --
    # but struct Adsr is #derive(accessors), so every parameter is a settable field. Same for
    # the LFOs via modulation_lfo_set_frequency + Lfo_set_phase.
    assert_eq(per_note, 0, "note_on allocates NOTHING (was 264 B pre-2.1.0, 72 B in 2.1.0)");

    # --- 2.1.1: a reused voice must not inherit the previous note's cutoff ---
    # The cutoff smoother is per-voice and persistent; note_on never reset it, so a voice
    # picking up a new note glided over ~5 ms from the OLD note's cutoff. Build two zones with
    # very different cutoffs, play them on the same engine, and check the second note's first
    # block is not still sweeping down from the first note's.
    test_group("reused voice does not inherit the previous cutoff (2.1.1)");
    var se = n_engine_new(1, f64_from(44100));
    var sbank = n_engine_bank(se);
    var sd = vec_new();
    var si = 0;
    while (si < 4000) { vec_push(sd, f64_div(f64_from((si * 13) % 64), f64_from(64))); si = si + 1; }
    var ssid = n_sample_bank_add(sbank, n_sample_from_mono(sd, 44100));
    var sinst = n_instrument_new(str_from("s"));
    var szhi = n_zone_with_root_note(n_zone_with_key_range(n_zone_new(ssid), 0, 63), 60);
    szhi = n_zone_with_filter(szhi, f64_from(18000), 0);
    var szlo = n_zone_with_root_note(n_zone_with_key_range(n_zone_new(ssid), 64, 127), 60);
    szlo = n_zone_with_filter(szlo, f64_from(300), 0);
    n_instrument_add_zone(sinst, szhi);
    n_instrument_add_zone(sinst, szlo);
    ignore(n_engine_set_instrument(se, sinst));

    var sbuf = vec_new();
    var sk = 0;
    while (sk < 512) { vec_push(sbuf, 0); sk = sk + 1; }

    ignore(n_engine_note_on(se, 40, 100));      # bright zone, cutoff 18000
    n_engine_fill_buffer_stereo(se, sbuf, 512);
    n_engine_note_off(se, 40);
    ignore(n_engine_note_on(se, 100, 100));     # dark zone, cutoff 300 -- same voice
    n_engine_fill_buffer_stereo(se, sbuf, 512);
    var epk = 0;
    var ej = 0;
    while (ej < 512) {
        var ea = f64_abs(vec_get(sbuf, ej));
        if (f64_gt(ea, epk) == 1) { epk = ea; }
        ej = ej + 1;
    }
    # A 300 Hz low-pass on this material is heavily attenuated. If the smoother were still
    # gliding down from 18000 the opening of the block would be far brighter and louder.
    assert_eq(n_is_finite(epk), 1, "reused voice renders finite output");
    assert(f64_lt(epk, F64_ONE) == 1, "reused voice is filtered by ITS OWN cutoff, not the previous note's");

    # --- 2.1.3: a rate naad refuses degrades the voice, as the oracle did ---
    # Neither fix is a refusal: the oracle's constructor cannot fail. 2.1.1 moved LFO construction
    # into n_voice_new and dropped the `.ok()`, so the error code sat in the slot and render,
    # which gates on `!= 0`, dereferenced it. The same change added n_amp_envelope_rearm without
    # the constructor's fallback, so +Inf reached naad as a NaN envelope and then the mix. The
    # voice's filter and LFOs go; the note still plays.
    test_group("invalid sample rate degrades, as the oracle did (2.1.3)");
    var isr = vec_new();
    vec_push(isr, 0x7FF8000000000000);
    vec_push(isr, 0x7FF0000000000000);
    vec_push(isr, 0xFFF0000000000000);
    vec_push(isr, 0);
    vec_push(isr, f64_neg(f64_from(44100)));
    var ivb = vec_new();
    var ivi = 0;
    while (ivi < 2048) { vec_push(ivb, 0); ivi = ivi + 1; }
    var isi = 0;
    while (isi < vec_len(isr)) {
        var ive = make_engine_modulated(vec_get(isr, isi));
        assert(ive > 0, "engine builds: the constructor does not refuse the rate");
        var iv0 = vec_get(NSamplerEngine_voices(ive), 0);
        assert_eq(NSamplerVoice_pitch_lfo(iv0), 0, "no error code in the pitch LFO slot");
        assert_eq(NSamplerVoice_filter_lfo(iv0), 0, "no error code in the filter LFO slot");
        assert(n_engine_note_on(ive, 69, 100) >= 0, "note_on still plays");
        n_engine_fill_buffer_stereo(ive, ivb, 2048);
        var inz = 0;
        var ibad = 0;
        ivi = 0;
        while (ivi < 2048) {
            if (vec_get(ivb, ivi) != 0) { inz = inz + 1; }
            if (n_is_finite(vec_get(ivb, ivi)) == 0) { ibad = ibad + 1; }
            ivi = ivi + 1;
        }
        assert_eq(ibad, 0, "output stays finite");
        assert(inz > 0, "the voice is heard, not silenced");
        n_engine_note_off(ive, 69);
        n_engine_fill_buffer_stereo(ive, ivb, 2048);
        isi = isi + 1;
    }
    var igood = make_engine_modulated(f64_from(44100));
    assert(NSamplerVoice_pitch_lfo(vec_get(NSamplerEngine_voices(igood), 0)) > 0, "a real rate still gets its LFOs");

    # =========================================================================================
    # 2.2.2 sweep. Every group below failed on 2.2.1.
    # =========================================================================================

    test_group("a re-armed envelope starts from silence (2.2.2)");
    # A one-shot that runs off its sample while held leaves its envelope in SUSTAIN at 1.0.
    # note_on + note_off in one MIDI block then released from that stale level.
    var w_se_fresh = sw_engine(1, 2000, 44100, 44100);
    NSamplerEngine_set_instrument(w_se_fresh, NSamplerEngine_instrument(w_se_fresh));
    var w_se_r = sw_engine(1, 2000, 44100, 44100);
    var w_se_z = vec_get(NInstrument_zones(NSamplerEngine_instrument(w_se_r)), 0);
    NZone_set_loop_mode(w_se_z, LOOP_ONESHOT);
    NZone_set_loop_mode(vec_get(NInstrument_zones(NSamplerEngine_instrument(w_se_fresh)), 0), LOOP_ONESHOT);
    n_engine_set_release_ms(w_se_fresh, f64_from(500));
    n_engine_set_release_ms(w_se_r, f64_from(500));
    ignore(n_engine_note_on(w_se_fresh, 60, 127));
    n_engine_note_off(w_se_fresh, 60);
    var w_se_e0 = sw_energy(w_se_fresh, 1500);
    ignore(n_engine_note_on(w_se_r, 60, 127));
    ignore(sw_energy(w_se_r, 3000));
    n_engine_note_off(w_se_r, 60);
    ignore(n_engine_note_on(w_se_r, 60, 127));
    n_engine_note_off(w_se_r, 60);
    var w_se_e1 = sw_energy(w_se_r, 1500);
    assert_eq(w_se_e1, w_se_e0, "a reused voice releases exactly like a fresh one");
    var w_se_env = NSamplerVoice_amp_env(vec_get(NSamplerEngine_voices(w_se_r), 0));
    ignore(n_amp_envelope_rearm(w_se_env, n_adsr_config_default(), f64_from(44100)));
    assert_eq(Adsr_current_value(w_se_env), 0, "rearm zeroes current_value, as the constructor does");
    assert_eq(envelope_adsr_state(w_se_env), ENV_STATE_IDLE, "rearm leaves the envelope IDLE");

    test_group("set_bank refuses 0 and error codes (2.2.2)");
    var w_sb = sw_engine(2, 100, 44100, 44100);
    var w_sb_bank = n_engine_bank(w_sb);
    assert_eq(n_engine_set_bank(w_sb, NIDHI_ERR_IMPORT), NIDHI_ERR_INVALID_PARAMETER, "negative code refused");
    assert_eq(n_engine_set_bank(w_sb, 0), NIDHI_ERR_INVALID_PARAMETER, "0 refused");
    assert_eq(n_engine_bank(w_sb), w_sb_bank, "the bank is unchanged");
    ignore(n_engine_note_on(w_sb, 60, 100));
    assert(f64_gt(sw_energy(w_sb, 100), 0) == 1, "and the engine still renders");

    test_group("a negative envelope config is no config (2.2.2)");
    var w_nz = n_zone_with_adsr(n_zone_new(0), NIDHI_ERR_INVALID_PARAMETER);
    assert_eq(NZone_adsr(w_nz), 0, "zone stores 0, not the code");
    w_nz = n_zone_with_filter_envelope(w_nz, NIDHI_ERR_INVALID_PARAMETER, f64_from(1200));
    assert_eq(NZone_fileg(w_nz), 0, "filter envelope stores 0, not the code");
    var w_nc = sw_engine(2, 1000, 44100, 44100);
    var w_ncz = vec_get(NInstrument_zones(NSamplerEngine_instrument(w_nc)), 0);
    NZone_set_adsr(w_ncz, NIDHI_ERR_IMPORT);
    NZone_set_fileg(w_ncz, NIDHI_ERR_IMPORT);
    assert(n_engine_note_on(w_nc, 60, 100) >= 0, "a code written straight to the zone does not crash note_on");
    assert(f64_gt(sw_energy(w_nc, 100), 0) == 1, "and the note plays on the engine default");

    test_group("non-finite volume stays out of the mix (2.2.2)");
    var w_vn = sw_engine(2, 4000, 44100, 44100);
    var w_vnz = vec_get(NInstrument_zones(NSamplerEngine_instrument(w_vn)), 0);
    n_ignore(n_zone_with_volume(w_vnz, 0x7FF8000000000000));
    assert_eq(NZone_volume_db(w_vnz), 0x7FF8000000000000, "the stored field keeps the raw value (oracle)");
    ignore(n_engine_note_on(w_vn, 60, 100));
    assert_eq(sw_nonfinite(w_vn, 1000), 0, "volume=NaN renders finite");
    var w_vi = sw_engine(2, 4000, 44100, 44100);
    n_ignore(n_zone_with_volume(vec_get(NInstrument_zones(NSamplerEngine_instrument(w_vi)), 0), 0x7FF0000000000000));
    ignore(n_engine_note_on(w_vi, 60, 100));
    assert_eq(sw_nonfinite(w_vi, 1000), 0, "volume=+Inf renders finite");
    assert_eq(n_volume_db_clamp(0x7FF8000000000000), f64_from(0 - 144), "NaN takes the low bound (ADR 0002)");
    assert_eq(n_volume_db_clamp(f64_from(-6)), f64_from(-6), "an ordinary level passes through");

    test_group("a NaN pitch bend does not stick (2.2.2)");
    var w_pb = sw_engine(2, 4000, 44100, 44100);
    ignore(n_engine_note_on(w_pb, 60, 127));
    ignore(sw_energy(w_pb, 100));
    n_engine_apply_pitch_bend(w_pb, 60, 0x7FF8000000000000);
    assert_eq(sw_nonfinite(w_pb, 10), 0, "the NaN bend renders finite");
    n_engine_apply_pitch_bend(w_pb, 60, 0);
    assert(f64_gt(sw_energy(w_pb, 4000), F64_ONE) == 1, "the note is audible once the bend is back at 0");

    test_group("the cutoff smoother snaps to the first frame's target (2.2.2)");
    var w_sm = sw_filtered(0);
    ignore(n_engine_note_on(w_sm, 60, 127));
    ignore(n_engine_next_sample(w_sm));
    assert_eq(sw_cutoff(w_sm), 6000, "8 kHz x brightness 0.75 from the first frame, no onset sweep");

    test_group("filter velocity tracking lasts the note (2.2.2, ADR 0007)");
    var w_vh = sw_filtered(F64_ONE);
    var w_vl = sw_filtered(F64_ONE);
    ignore(n_engine_note_on(w_vh, 60, 127));
    ignore(n_engine_note_on(w_vl, 60, 16));
    ignore(sw_energy(w_vh, 2000));
    ignore(sw_energy(w_vl, 2000));
    assert_eq(sw_cutoff(w_vh), 6000, "velocity 127 keeps the full cutoff");
    assert(sw_cutoff(w_vl) < sw_cutoff(w_vh) / 2, "velocity 16 stays darker after 2000 frames");
    var w_rv0 = sw_filtered(0);
    ignore(n_engine_note_on(w_rv0, 60, 16));
    ignore(sw_energy(w_rv0, 2000));
    assert_eq(sw_cutoff(w_rv0), 6000, "vel_track 0 ignores velocity, as before");

    test_group("a released sustain loop does not crossfade (2.2.2, ADR 0008)");
    var w_sj0 = sw_sustain_jump(0);
    var w_sj20 = sw_sustain_jump(20);
    assert(w_sj20 < w_sj0 * 2, "the pass-through after release has no crossfade click");

    test_group("nidhi's voice state decides allocation (2.2.2, ADR 0006)");
    var w_da = sw_engine(8, 20000, 44100, 44100);
    n_engine_set_release_ms(w_da, f64_from(500));
    ignore(n_engine_note_on(w_da, 60, 100));
    ignore(sw_energy(w_da, 100));
    n_engine_note_off(w_da, 60);
    ignore(sw_energy(w_da, 100));
    ignore(n_engine_note_on(w_da, 64, 100));
    assert_eq(n_engine_has_active_note(w_da, 60), 1, "a release tail survives a new note while voices are free");
    assert_eq(n_engine_active_voice_count(w_da), 2, "tail + new note");
    var w_db = sw_engine(4, 20000, 44100, 44100);
    n_engine_set_release_ms(w_db, f64_from(5));
    var w_dk = 0;
    while (w_dk < 3) {
        ignore(n_engine_note_on(w_db, 60 + w_dk, 100));
        ignore(n_engine_note_on(w_db, 60 + w_dk, 100));
        n_engine_note_off(w_db, 60 + w_dk);
        w_dk = w_dk + 1;
    }
    ignore(sw_energy(w_db, 44100));
    assert_eq(n_engine_active_voice_count(w_db), 0, "every voice has finished");
    ignore(n_engine_note_on(w_db, 70, 100));
    ignore(n_engine_note_on(w_db, 72, 100));
    ignore(n_engine_note_on(w_db, 76, 100));
    assert_eq(n_engine_active_voice_count(w_db), 3, "a retriggered note no longer leaks a voice");

    test_group("playback speed includes the sample rate (2.2.2, ADR 0009)");
    var w_r48 = sw_engine(2, 1000, 48000, 44100);
    ignore(n_engine_note_on(w_r48, 60, 100));
    var w_r48v = vec_get(NSamplerEngine_voices(w_r48), 0);
    assert_eq(NSamplerVoice_speed(w_r48v), f64_div(f64_from(48000), f64_from(44100)), "48 kHz in a 44.1 kHz engine: speed 48000/44100");
    var w_r22 = sw_engine(2, 1000, 22050, 44100);
    ignore(n_engine_note_on(w_r22, 72, 100));
    assert_eq(NSamplerVoice_speed(vec_get(NSamplerEngine_voices(w_r22), 0)), F64_ONE, "22.05 kHz an octave up plays at 1.0");
    var w_r44 = sw_engine(2, 1000, 44100, 44100);
    ignore(n_engine_note_on(w_r44, 60, 100));
    assert_eq(NSamplerVoice_speed(vec_get(NSamplerEngine_voices(w_r44), 0)), F64_ONE, "matching rates keep the exact ratio");
    var w_r0 = sw_engine(2, 1000, 0, 44100);
    ignore(n_engine_note_on(w_r0, 60, 100));
    assert_eq(NSamplerVoice_speed(vec_get(NSamplerEngine_voices(w_r0), 0)), F64_ONE, "a sample without a rate is not rescaled");

    test_group("the engine holds at most naad's 128 voices (2.2.2)");
    var w_mv = n_engine_new(4096, f64_from(44100));
    assert_eq(vec_len(NSamplerEngine_voices(w_mv)), 128, "4096 requested, 128 built");
    assert_eq(vec_len(NSamplerEngine_voices(n_engine_new(20000000, f64_from(44100)))), 128, "20M requested does not exhaust the heap");

    test_group("the ADSR setters allocate nothing (2.2.2)");
    var w_as = n_engine_new(4, f64_from(44100));
    var w_acfg2 = n_adsr_config_new(0, 0, F64_ONE, 100);
    var w_as_before = alloc_used();
    var w_ai = 0;
    while (w_ai < 1000) {
        n_engine_set_release_ms(w_as, f64_from(10 + w_ai % 50));
        ignore(n_engine_set_adsr(w_as, w_acfg2));
        w_ai = w_ai + 1;
    }
    assert_eq(alloc_used() - w_as_before, 0, "1000 set_release_ms + set_adsr calls: 0 bytes");
    n_engine_set_release_ms(w_as, f64_from(10));
    assert_eq(NAdsrConfig_release_samples(NSamplerEngine_default_adsr(w_as)), 441, "set_release_ms still sets 10 ms");


    test_group("note_on round-robins (2.2.2, ADR 0012)");
    # Two zones on one key in RR group 1. The oracle's note_on played the first match only.
    var w_rre = n_engine_new(8, f64_from(44100));
    var w_rrd = vec_new();
    var w_rri = 0;
    while (w_rri < 4000) { vec_push(w_rrd, F64_HALF); w_rri = w_rri + 1; }
    var w_rrs = n_sample_bank_add(n_engine_bank(w_rre), n_sample_from_mono(w_rrd, 44100));
    var w_rrinst = n_instrument_new(str_from("rr"));
    n_instrument_add_zone(w_rrinst, n_zone_with_group(n_zone_with_key_range(n_zone_new(w_rrs), 60, 60), 1));
    n_instrument_add_zone(w_rrinst, n_zone_with_group(n_zone_with_key_range(n_zone_new(w_rrs), 60, 60), 1));
    ignore(n_engine_set_instrument(w_rre, w_rrinst));
    var w_nv0 = n_engine_note_on(w_rre, 60, 100);
    var w_nv1 = n_engine_note_on(w_rre, 60, 100);
    var w_nv2 = n_engine_note_on(w_rre, 60, 100);
    assert_eq(NSamplerVoice_zone_index(vec_get(NSamplerEngine_voices(w_rre), w_nv0)), 0, "note 1 plays zone 0");
    assert_eq(NSamplerVoice_zone_index(vec_get(NSamplerEngine_voices(w_rre), w_nv1)), 1, "note 2 plays zone 1");
    assert_eq(NSamplerVoice_zone_index(vec_get(NSamplerEngine_voices(w_rre), w_nv2)), 0, "note 3 plays zone 0 again");
    # An SFZ-style sequence through note_on.
    var w_sqe = n_engine_new(8, f64_from(44100));
    var w_sqs = n_sample_bank_add(n_engine_bank(w_sqe), n_sample_from_mono(w_rrd, 44100));
    var w_sqinst = n_instrument_new(str_from("sq"));
    n_instrument_add_zone(w_sqinst, n_zone_with_seq(n_zone_with_key_range(n_zone_new(w_sqs), 60, 60), 2, 1));
    n_instrument_add_zone(w_sqinst, n_zone_with_seq(n_zone_with_key_range(n_zone_new(w_sqs), 60, 60), 2, 2));
    ignore(n_engine_set_instrument(w_sqe, w_sqinst));
    var w_q0 = n_engine_note_on(w_sqe, 60, 100);
    var w_q1 = n_engine_note_on(w_sqe, 60, 100);
    assert_eq(NSamplerVoice_zone_index(vec_get(NSamplerEngine_voices(w_sqe), w_q0)), 0, "seq step 1 plays position 1");
    assert_eq(NSamplerVoice_zone_index(vec_get(NSamplerEngine_voices(w_sqe), w_q1)), 1, "seq step 2 plays position 2");
    var w_rrb = alloc_used();
    var w_rk = 0;
    while (w_rk < 100) {
        ignore(n_engine_note_on(w_rre, 60, 100));
        ignore(n_engine_note_on(w_sqe, 60, 100));
        w_rk = w_rk + 1;
    }
    assert_eq(alloc_used() - w_rrb, 0, "round-robin and sequenced note_ons allocate nothing");
    return assert_summary();
}

var exit_code = main();
syscall(60, exit_code);
