# sf2.tcyr -- parity tests for src/sf2.cyr (ports rust-old/src/sf2.rs #[test]s).
# Builds minimal SF2 blobs with a byte-builder (chunk-size backpatching) and parses them.

include "src/error.cyr"
include "src/f64_util.cyr"
include "src/loop_mode.cyr"
include "src/zone.cyr"
include "src/sample.cyr"
include "src/instrument.cyr"
include "src/sf2.cyr"

# --- byte builder (buf + cursor) ---
fn bb_new(cap) { var b = alloc(16); store64(b, alloc(cap)); store64(b + 8, 0); return b; }
fn bb_buf(b) { return load64(b); }
fn bb_len(b) { return load64(b + 8); }
fn bb_u8(b, v) { store8(bb_buf(b) + bb_len(b), v & 0xFF); store64(b + 8, bb_len(b) + 1); return 0; }
fn bb_u16(b, v) { bb_u8(b, v); bb_u8(b, v >> 8); return 0; }
fn bb_i16(b, v) { bb_u16(b, v & 0xFFFF); return 0; }
fn bb_u32(b, v) { bb_u8(b, v); bb_u8(b, v >> 8); bb_u8(b, v >> 16); bb_u8(b, v >> 24); return 0; }
fn bb_str4(b, s) { var i = 0; while (i < 4) { bb_u8(b, load8(s + i)); i = i + 1; } return 0; }
fn bb_fixed_str(b, s, flen) {
    var slen = strlen(s);
    var i = 0;
    while (i < flen) {
        if (i < slen) { bb_u8(b, load8(s + i)); } else { bb_u8(b, 0); }
        i = i + 1;
    }
    return 0;
}
fn bb_chunk_begin(b, id) { bb_str4(b, id); var pos = bb_len(b); bb_u32(b, 0); return pos; }
fn bb_chunk_end(b, pos) {
    var content_len = bb_len(b) - (pos + 4);
    var p = bb_buf(b) + pos;
    store8(p, content_len & 0xFF);
    store8(p + 1, (content_len >> 8) & 0xFF);
    store8(p + 2, (content_len >> 16) & 0xFF);
    store8(p + 3, (content_len >> 24) & 0xFF);
    if ((content_len & 1) == 1) { bb_u8(b, 0); }
    return 0;
}

fn make_samples(n) {
    var v = vec_new();
    var i = 0;
    while (i < n) { vec_push(v, F64_HALF); i = i + 1; }
    return v;
}

# Build a full valid minimal SF2. Returns the byte-builder.
fn build_minimal_sf2(preset_name, samples, root_key, key_lo, key_hi, vel_lo, vel_hi, loop_mode, loop_start, loop_end) {
    var num = vec_len(samples);
    var b = bb_new(16384);

    var riff = bb_chunk_begin(b, "RIFF");
    bb_str4(b, "sfbk");

    # sdta LIST { smpl }
    var sdta = bb_chunk_begin(b, "LIST");
    bb_str4(b, "sdta");
    var smpl = bb_chunk_begin(b, "smpl");
    var si = 0;
    while (si < num) {
        var iv = f64_to(f64_round(f64_mul(vec_get(samples, si), f64_from(32767))));
        if (iv > 32767) { iv = 32767; }
        if (iv < 0 - 32768) { iv = 0 - 32768; }
        bb_i16(b, iv);
        si = si + 1;
    }
    bb_chunk_end(b, smpl);
    bb_chunk_end(b, sdta);

    # pdta LIST { phdr pbag pgen inst ibag igen shdr }
    var pdta = bb_chunk_begin(b, "LIST");
    bb_str4(b, "pdta");

    var phdr = bb_chunk_begin(b, "phdr");
    bb_fixed_str(b, preset_name, 20); bb_u16(b, 0); bb_u16(b, 0); bb_u16(b, 0);
    bb_u32(b, 0); bb_u32(b, 0); bb_u32(b, 0);
    bb_fixed_str(b, "EOP", 20); bb_u16(b, 0); bb_u16(b, 0); bb_u16(b, 1);
    bb_u32(b, 0); bb_u32(b, 0); bb_u32(b, 0);
    bb_chunk_end(b, phdr);

    var pbag = bb_chunk_begin(b, "pbag");
    bb_u16(b, 0); bb_u16(b, 0);
    bb_u16(b, 1); bb_u16(b, 0);
    bb_chunk_end(b, pbag);

    var pgen = bb_chunk_begin(b, "pgen");
    bb_u16(b, 41); bb_i16(b, 0);
    bb_u16(b, 0); bb_i16(b, 0);
    bb_chunk_end(b, pgen);

    var inst = bb_chunk_begin(b, "inst");
    bb_fixed_str(b, "Instrument", 20); bb_u16(b, 0);
    bb_fixed_str(b, "EOI", 20); bb_u16(b, 1);
    bb_chunk_end(b, inst);

    var ibag = bb_chunk_begin(b, "ibag");
    bb_u16(b, 0); bb_u16(b, 0);
    bb_u16(b, 4); bb_u16(b, 0);
    bb_chunk_end(b, ibag);

    var igen = bb_chunk_begin(b, "igen");
    bb_u16(b, 43); bb_i16(b, key_lo | (key_hi << 8));
    bb_u16(b, 44); bb_i16(b, vel_lo | (vel_hi << 8));
    bb_u16(b, 54); bb_i16(b, loop_mode);
    bb_u16(b, 53); bb_i16(b, 0);
    bb_u16(b, 0); bb_i16(b, 0);
    bb_chunk_end(b, igen);

    var shdr = bb_chunk_begin(b, "shdr");
    bb_fixed_str(b, "Sample", 20);
    bb_u32(b, 0);
    bb_u32(b, num);
    bb_u32(b, loop_start);
    bb_u32(b, loop_end);
    bb_u32(b, 44100);
    bb_u8(b, root_key);
    bb_u8(b, 0);
    bb_u16(b, 0);
    bb_u16(b, 1);
    bb_fixed_str(b, "EOS", 20);
    bb_u32(b, 0); bb_u32(b, 0); bb_u32(b, 0); bb_u32(b, 0); bb_u32(b, 0);
    bb_u8(b, 0); bb_u8(b, 0); bb_u16(b, 0); bb_u16(b, 0);
    bb_chunk_end(b, shdr);

    bb_chunk_end(b, pdta);
    bb_chunk_end(b, riff);
    return b;
}

fn approx(a, b, tol) {
    if (f64_lt(f64_abs(f64_sub(a, b)), tol) == 1) { return 1; }
    return 0;
}

fn store_i16le(buf, off, v) {
    store8(buf + off, v & 0xFF);
    store8(buf + off + 1, (v >> 8) & 0xFF);
    return 0;
}

fn first_zone(res) {
    return vec_get(NInstrument_zones(vec_get(Sf2Result_instruments(res), 0)), 0);
}

# A structurally valid SF2 whose walk shape is set by its index fields alone: npresets presets
# whose phdr bag_index alternates 0 / nbags - 1 (so every other preset spans every pbag), nbags
# pbags whose gen_index alternates 0 / ngens (so every other pbag spans every pgen), and ngens
# pgens of an operator the walk ignores. No pbag names an instrument, so no zone is ever built
# and the zone budget never moves -- the hostile shape behind the prange and walk-budget fixes.
fn build_walk_sf2(npresets, nbags, ngens) {
    var b = bb_new(64 + npresets * 38 + nbags * 4 + ngens * 4 + 256);
    var riff = bb_chunk_begin(b, "RIFF");
    bb_str4(b, "sfbk");
    var sdta = bb_chunk_begin(b, "LIST");
    bb_str4(b, "sdta");
    var smpl = bb_chunk_begin(b, "smpl");
    bb_u32(b, 0);
    bb_chunk_end(b, smpl);
    bb_chunk_end(b, sdta);
    var pdta = bb_chunk_begin(b, "LIST");
    bb_str4(b, "pdta");
    var phdr = bb_chunk_begin(b, "phdr");
    var i = 0;
    while (i < npresets) {
        bb_fixed_str(b, "P", 20); bb_u16(b, 0); bb_u16(b, 0);
        if ((i & 1) == 0) { bb_u16(b, 0); } else { bb_u16(b, nbags - 1); }
        bb_u32(b, 0); bb_u32(b, 0); bb_u32(b, 0);
        i = i + 1;
    }
    bb_fixed_str(b, "EOP", 20); bb_u16(b, 0); bb_u16(b, 0); bb_u16(b, nbags - 1);
    bb_u32(b, 0); bb_u32(b, 0); bb_u32(b, 0);
    bb_chunk_end(b, phdr);
    var pbag = bb_chunk_begin(b, "pbag");
    i = 0;
    while (i < nbags) {
        if ((i & 1) == 0) { bb_u16(b, 0); } else { bb_u16(b, ngens); }
        bb_u16(b, 0);
        i = i + 1;
    }
    bb_chunk_end(b, pbag);
    var pgen = bb_chunk_begin(b, "pgen");
    i = 0;
    while (i < ngens) { bb_u16(b, 8); bb_i16(b, 1000); i = i + 1; }
    bb_chunk_end(b, pgen);
    var inst = bb_chunk_begin(b, "inst");
    bb_fixed_str(b, "I", 20); bb_u16(b, 0); bb_fixed_str(b, "EOI", 20); bb_u16(b, 0);
    bb_chunk_end(b, inst);
    var ibag = bb_chunk_begin(b, "ibag");
    bb_u16(b, 0); bb_u16(b, 0);
    bb_chunk_end(b, ibag);
    var igen = bb_chunk_begin(b, "igen");
    bb_u16(b, 0); bb_i16(b, 0);
    bb_chunk_end(b, igen);
    var shdr = bb_chunk_begin(b, "shdr");
    bb_fixed_str(b, "EOS", 20);
    bb_u32(b, 0); bb_u32(b, 0); bb_u32(b, 0); bb_u32(b, 0); bb_u32(b, 0);
    bb_u8(b, 0); bb_u8(b, 0); bb_u16(b, 0); bb_u16(b, 0);
    bb_chunk_end(b, shdr);
    bb_chunk_end(b, pdta);
    bb_chunk_end(b, riff);
    return b;
}

# One preset -> one instrument with nzones zones; zone z plays sample z % nsamples (each of
# `frames` frames). With full == 1 a zone also has key range (z % 128)..127 and odd zones loop;
# with full == 0 its only generator is sampleID, which keeps every record table small (2.2.2's
# copied tables were refused by a low ALLOC_MAX before any zone was built). Every sample is
# real, so every zone is built: the shape for the refused-allocation and shdr-count tests.
fn build_zones_sf2(nzones, nsamples, frames, full) {
    var b = bb_new(1024 + nzones * 16 + nsamples * (46 + frames * 2));
    var riff = bb_chunk_begin(b, "RIFF");
    bb_str4(b, "sfbk");
    var sdta = bb_chunk_begin(b, "LIST");
    bb_str4(b, "sdta");
    var smpl = bb_chunk_begin(b, "smpl");
    var i = 0;
    while (i < nsamples * frames) { bb_i16(b, (i * 37) & 0x7FFF); i = i + 1; }
    bb_chunk_end(b, smpl);
    bb_chunk_end(b, sdta);
    var pdta = bb_chunk_begin(b, "LIST");
    bb_str4(b, "pdta");
    var phdr = bb_chunk_begin(b, "phdr");
    bb_fixed_str(b, "Zones", 20); bb_u16(b, 3); bb_u16(b, 1); bb_u16(b, 0);
    bb_u32(b, 0); bb_u32(b, 0); bb_u32(b, 0);
    bb_fixed_str(b, "EOP", 20); bb_u16(b, 0); bb_u16(b, 0); bb_u16(b, 1);
    bb_u32(b, 0); bb_u32(b, 0); bb_u32(b, 0);
    bb_chunk_end(b, phdr);
    var pbag = bb_chunk_begin(b, "pbag");
    bb_u16(b, 0); bb_u16(b, 0); bb_u16(b, 1); bb_u16(b, 0);
    bb_chunk_end(b, pbag);
    var pgen = bb_chunk_begin(b, "pgen");
    bb_u16(b, 41); bb_i16(b, 0); bb_u16(b, 0); bb_i16(b, 0);
    bb_chunk_end(b, pgen);
    var inst = bb_chunk_begin(b, "inst");
    bb_fixed_str(b, "I", 20); bb_u16(b, 0); bb_fixed_str(b, "EOI", 20); bb_u16(b, nzones);
    bb_chunk_end(b, inst);
    var ibag = bb_chunk_begin(b, "ibag");
    i = 0;
    var per = 1;
    if (full == 1) { per = 3; }
    while (i <= nzones) { bb_u16(b, i * per); bb_u16(b, 0); i = i + 1; }
    bb_chunk_end(b, ibag);
    var igen = bb_chunk_begin(b, "igen");
    i = 0;
    while (i < nzones) {
        if (full == 1) {
            bb_u16(b, 43); bb_i16(b, (i % 128) | (127 << 8));
            bb_u16(b, 54); bb_i16(b, i & 1);
        }
        bb_u16(b, 53); bb_i16(b, i % nsamples);
        i = i + 1;
    }
    bb_u16(b, 0); bb_i16(b, 0);
    bb_chunk_end(b, igen);
    var shdr = bb_chunk_begin(b, "shdr");
    i = 0;
    while (i < nsamples) {
        bb_fixed_str(b, "S", 20);
        bb_u32(b, i * frames); bb_u32(b, i * frames + frames);
        bb_u32(b, i * frames + 1); bb_u32(b, i * frames + frames - 1);
        bb_u32(b, 44100); bb_u8(b, 60); bb_u8(b, 0); bb_u16(b, 0); bb_u16(b, 1);
        i = i + 1;
    }
    bb_fixed_str(b, "EOS", 20);
    bb_u32(b, 0); bb_u32(b, 0); bb_u32(b, 0); bb_u32(b, 0); bb_u32(b, 0);
    bb_u8(b, 0); bb_u8(b, 0); bb_u16(b, 0); bb_u16(b, 0);
    bb_chunk_end(b, shdr);
    bb_chunk_end(b, pdta);
    bb_chunk_end(b, riff);
    return b;
}

# sf2_parse with every allocation larger than `limit` bytes refused (ALLOC_MAX is the stdlib's
# own per-request ceiling, on every target), restored before returning.
fn parse_with_alloc_max(b, limit) {
    var saved = ALLOC_MAX;
    ALLOC_MAX = limit;
    var r = sf2_parse(bb_buf(b), bb_len(b));
    ALLOC_MAX = saved;
    return r;
}

fn zone_total(res) {
    var n = 0;
    var insts = Sf2Result_instruments(res);
    var i = 0;
    while (i < vec_len(insts)) { n = n + n_instrument_zone_count(vec_get(insts, i)); i = i + 1; }
    return n;
}

fn main() {
    alloc_init();
    var tol = f64_div(F64_ONE, f64_from(1000));

    test_group("reject invalid");
    var small = alloc(4);
    store8(small, 0); store8(small + 1, 0); store8(small + 2, 0); store8(small + 3, 0);
    assert(sf2_parse(small, 4) < 0, "too small -> error");
    var notriff = alloc(12);
    store8(notriff, 78); store8(notriff + 1, 79); store8(notriff + 2, 84); store8(notriff + 3, 70);
    var zz = 4; while (zz < 12) { store8(notriff + zz, 0); zz = zz + 1; }
    assert(sf2_parse(notriff, 12) < 0, "non-RIFF -> error");
    var wf = alloc(12);
    store8(wf, 82); store8(wf + 1, 73); store8(wf + 2, 70); store8(wf + 3, 70);
    store8(wf + 4, 0); store8(wf + 5, 0); store8(wf + 6, 0); store8(wf + 7, 0);
    store8(wf + 8, 87); store8(wf + 9, 65); store8(wf + 10, 86); store8(wf + 11, 69);
    assert(sf2_parse(wf, 12) < 0, "wrong form type -> error");

    test_group("parse minimal sf2");
    var b = build_minimal_sf2("Piano", make_samples(100), 60, 36, 84, 0, 127, 0, 0, 0);
    var res = sf2_parse(bb_buf(b), bb_len(b));
    assert(res > 0, "parse succeeded (positive ptr)");
    assert_eq(vec_len(Sf2Result_presets(res)), 1, "1 preset");
    assert_eq(vec_len(Sf2Result_instruments(res)), 1, "1 instrument");
    assert_eq(str_eq(Sf2Preset_name(vec_get(Sf2Result_presets(res), 0)), str_from("Piano")), 1, "preset name Piano");
    var inst0 = vec_get(Sf2Result_instruments(res), 0);
    assert_eq(n_instrument_zone_count(inst0), 1, "1 zone");
    var z0 = first_zone(res);
    assert_eq(NZone_key_lo(z0), 36, "zone key_lo 36");
    assert_eq(NZone_key_hi(z0), 84, "zone key_hi 84");
    assert_eq(NZone_root_note(z0), 60, "zone root_note 60");
    assert_eq(NZone_loop_mode(z0), LOOP_ONESHOT, "loop OneShot");
    assert_eq(n_sample_bank_len(Sf2Result_bank(res)), 1, "bank len 1");
    assert_eq(NSample_frames(n_sample_bank_get(Sf2Result_bank(res), 0)), 100, "sample frames 100");

    test_group("forward loop preserved");
    var bf = build_minimal_sf2("P", make_samples(200), 60, 0, 127, 0, 127, 1, 50, 150);
    var rf = sf2_parse(bb_buf(bf), bb_len(bf));
    var zf = first_zone(rf);
    assert_eq(NZone_loop_mode(zf), LOOP_FORWARD, "loop Forward");
    assert_eq(NZone_loop_start(zf), 50, "loop_start 50");
    assert_eq(NZone_loop_end(zf), 150, "loop_end 150");

    test_group("loop sustain mode 3");
    var bs = build_minimal_sf2("P", make_samples(200), 60, 0, 127, 0, 127, 3, 10, 90);
    var zs = first_zone(sf2_parse(bb_buf(bs), bb_len(bs)));
    assert_eq(NZone_loop_mode(zs), LOOP_SUSTAIN, "loop LoopSustain");

    test_group("velocity range preserved");
    var bv = build_minimal_sf2("P", make_samples(100), 60, 0, 127, 32, 96, 0, 0, 0);
    var zv = first_zone(sf2_parse(bb_buf(bv), bb_len(bv)));
    assert_eq(NZone_vel_lo(zv), 32, "vel_lo 32");
    assert_eq(NZone_vel_hi(zv), 96, "vel_hi 96");

    test_group("pcm16 conversion");
    assert_eq(vec_len(sf2_pcm16_to_f32(0, 0, 0, 0)), 0, "empty -> empty");
    var pcmoob = alloc(2); store8(pcmoob, 0); store8(pcmoob + 1, 0);
    assert_eq(vec_len(sf2_pcm16_to_f32(pcmoob, 2, 0, 100)), 0, "out of bounds -> empty");
    var acc = alloc(10);
    store_i16le(acc, 0, 0);
    store_i16le(acc, 2, 16384);
    store_i16le(acc, 4, 0 - 16384);
    store_i16le(acc, 6, 32767);
    store_i16le(acc, 8, 0 - 32767);
    var dec = sf2_pcm16_to_f32(acc, 10, 0, 5);
    assert_eq(vec_len(dec), 5, "decoded 5 samples");
    assert_eq(approx(vec_get(dec, 0), f64_from(0), tol), 1, "0.0");
    assert_eq(approx(vec_get(dec, 1), F64_HALF, tol), 1, "0.5");
    assert_eq(approx(vec_get(dec, 2), f64_neg(F64_HALF), tol), 1, "-0.5");
    assert_eq(approx(vec_get(dec, 3), F64_ONE, tol), 1, "~1.0");
    assert_eq(approx(vec_get(dec, 4), f64_neg(F64_ONE), tol), 1, "~-1.0");

    test_group("reject chunk size overflow");
    var ov = alloc(24);
    store8(ov, 82); store8(ov + 1, 73); store8(ov + 2, 70); store8(ov + 3, 70);
    store8(ov + 4, 0); store8(ov + 5, 0); store8(ov + 6, 0); store8(ov + 7, 0);
    store8(ov + 8, 115); store8(ov + 9, 102); store8(ov + 10, 98); store8(ov + 11, 107);
    store8(ov + 12, 76); store8(ov + 13, 73); store8(ov + 14, 83); store8(ov + 15, 84);
    store8(ov + 16, 255); store8(ov + 17, 255); store8(ov + 18, 255); store8(ov + 19, 255);
    store8(ov + 20, 0); store8(ov + 21, 0); store8(ov + 22, 0); store8(ov + 23, 0);
    assert(sf2_parse(ov, 24) < 0, "chunk size overflow -> error (no panic)");

    # --- 2.2.2: per-pbag Sf2PRange allocation ---
    # sf2_do_pbag ran alloc(48) on every preset-bag VISIT, before the instrument check and
    # outside the zone budget. 32 presets spanning 1024 empty pbags are 32,736 visits: 1.57 MB of
    # never-freed heap from a 6.6 KB file (the 376 KB version reached 4.7 GB and SIGSEGV'd).
    test_group("preset-bag visits allocate nothing (2.2.2)");
    var bw = build_walk_sf2(64, 1024, 1);
    var heap0 = alloc_used();
    var rw = sf2_parse(bb_buf(bw), bb_len(bw));
    var walk_heap = alloc_used() - heap0;
    assert(rw > 0, "overlapping empty preset bags parse");
    assert_eq(vec_len(Sf2Result_presets(rw)), 0, "no preset has a zone");
    assert(walk_heap < 262144, "32,736 preset-bag visits cost < 256 KB of heap (was 1.57 MB)");

    # --- 2.2.2: the walk has a work budget ---
    # pbag gen_index alternating 0 / 4096 makes every other bag rescan all 4096 pgens: 16.8M
    # generator visits for ONE preset of a 49 KB file, none of which builds a zone. At 65,535
    # pgens that was 14.4 s per preset; any number of presets could be stacked on it.
    test_group("generator-scan bomb hits the work budget (2.2.2)");
    var bg = build_walk_sf2(1, 8192, 4096);
    assert_eq(sf2_parse(bb_buf(bg), bb_len(bg)), NIDHI_ERR_IMPORT, "16.8M-visit walk -> NIDHI_ERR_IMPORT");
    # Under the budget, the same shape still parses: 2048 x 2048 = 4.2M visits.
    var bgo = build_walk_sf2(1, 4096, 2048);
    assert(sf2_parse(bb_buf(bgo), bb_len(bgo)) > 0, "a 4.2M-visit walk is inside the budget");

    # --- 2.2.2 / 2.3.0: no record count can reach vec_push's capacity abort ---
    # vec_push past VEC_CAP_MAX is _vec_abort -> exit(1), with no error return. 2.2.2 refused a
    # record chunk too big for a vec; 2.3.0 reads records in place, so only the shdr memo is a
    # vec at all. A chunk that large is ~1 GiB, so the test lowers the cap instead.
    test_group("record counts past VEC_CAP_MAX (2.2.2, 2.3.0)");
    var bc = build_walk_sf2(1, 4097, 1);
    var cap_saved = VEC_CAP_MAX;
    VEC_CAP_MAX = 4096;
    var rc_cap = sf2_parse(bb_buf(bc), bb_len(bc));
    VEC_CAP_MAX = cap_saved;
    assert(rc_cap > 0, "4097 pbags under VEC_CAP_MAX 4096 parse: records are not vec elements (2.3.0)");
    var bcs = build_zones_sf2(1, 4097, 1, 1);
    VEC_CAP_MAX = 4096;
    var rc_shdr = sf2_parse(bb_buf(bcs), bb_len(bcs));
    VEC_CAP_MAX = cap_saved;
    assert_eq(rc_shdr, NIDHI_ERR_IMPORT, "4098 shdrs under VEC_CAP_MAX 4096: the memo is refused, not aborted");

    # --- 2.2.2: names are owned, not borrowed from the caller's buffer ---
    # str_new borrows. Overwriting (or reusing) the file buffer after the parse renamed every
    # preset, instrument and sample; Rust returned owned Strings.
    test_group("names survive the caller reusing its buffer (2.2.2)");
    var bn = build_minimal_sf2("Piano", make_samples(16), 60, 0, 127, 0, 127, 0, 0, 0);
    var rn = sf2_parse(bb_buf(bn), bb_len(bn));
    assert(rn > 0, "parsed");
    var zi = 0;
    while (zi < bb_len(bn)) { store8(bb_buf(bn) + zi, 88); zi = zi + 1; }
    assert_eq(str_eq(Sf2Preset_name(vec_get(Sf2Result_presets(rn), 0)), str_from("Piano")), 1, "preset name intact");
    assert_eq(str_eq(NInstrument_name(vec_get(Sf2Result_instruments(rn), 0)), str_from("Piano")), 1, "instrument name intact");
    assert_eq(str_eq(NSample_name(n_sample_bank_get(Sf2Result_bank(rn), 0)), str_from("Sample")), 1, "sample name intact");

    # --- 2.2.2: pcm16 conversion is sized once and bit-identical to x / 32768 ---
    test_group("pcm16 exact for all 65536 values, one allocation (2.2.2)");
    var allv = alloc(131072);
    var ai = 0;
    while (ai < 65536) { store_i16le(allv, ai * 2, ai); ai = ai + 1; }
    var pheap0 = alloc_used();
    var pv = sf2_pcm16_to_f32(allv, 131072, 0, 65536);
    var pheap = alloc_used() - pheap0;
    assert_eq(vec_len(pv), 65536, "65536 samples");
    var bad = 0;
    ai = 0;
    while (ai < 65536) {
        var sv = ai;
        if (sv >= 0x8000) { sv = sv - 0x10000; }
        if (vec_get(pv, ai) != f64_div(f64_from(sv), f64_from(32768))) { bad = bad + 1; }
        ai = ai + 1;
    }
    assert_eq(bad, 0, "every 16-bit value bit-identical to the oracle's x / 32768");
    # 65536 x 8 bytes plus the 24-byte header; vec_push from vec_new() spent ~2x that.
    assert(pheap <= 65536 * 8 + 64, "one exact-size buffer, no doubling chain");

    # --- 2.3.0: records are read in place; nothing is allocated per record ---
    # Each record used to become a heap struct plus a vec slot (and phdr/inst/shdr a borrowed
    # name Str), and every preset an instrument, kept or not: 6x the file in never-freed heap,
    # 251.7 MB for a 42 MB SF2. 4096 zone-less presets over 4096 generators are 155 KB of file.
    test_group("record floods cost no per-record heap (2.3.0)");
    var bfl = build_walk_sf2(4096, 2, 4096);
    var fheap0 = alloc_used();
    var rf2 = sf2_parse(bb_buf(bfl), bb_len(bfl));
    var fheap = alloc_used() - fheap0;
    assert(rf2 > 0, "flood parses");
    assert_eq(vec_len(Sf2Result_presets(rf2)), 0, "no preset has a zone");
    assert(fheap < 16384, "4096 presets + 4096 generators cost < 16 KB of heap (was ~2.4 MB)");

    # --- 2.3.0: a refused allocation fails the parse; it never drops a zone or writes through 0 ---
    # The constructors answer 0 (and n_instrument_add_zone a negative code) when alloc refuses.
    # n_zone_new's 0 flowed through the builders into n_instrument_add_zone, whose error was
    # discarded, so a preset silently lost zones, or vanished when it lost them all; a refused
    # instrument was read through by n_instrument_zone_count. ALLOC_MAX picks which requests
    # fail: just under sizeof(NZone) (272) refuses only zones; 511 refuses a vec's grow from 32
    # slots to 64. (Refusing n_instrument_new, n_sample_from_mono or n_sample_bank_new alone is
    # not reachable this way: their requests are no bigger than the 128-byte buffer every
    # vec_new takes, and the parse makes those first.)
    test_group("refused allocations fail the parse (2.3.0)");
    var bz8 = build_zones_sf2(8, 2, 16, 0);
    assert_eq(zone_total(sf2_parse(bb_buf(bz8), bb_len(bz8))), 8, "8 zones unconstrained");
    assert_eq(parse_with_alloc_max(bz8, sizeof(NZone) - 1), NIDHI_ERR_IMPORT, "refused n_zone_new -> NIDHI_ERR_IMPORT, not a preset without zones");
    var bz = build_zones_sf2(40, 3, 16, 0);
    var rz = sf2_parse(bb_buf(bz), bb_len(bz));
    assert(rz > 0, "unconstrained parse");
    assert_eq(zone_total(rz), 40, "40 zones");
    assert_eq(n_sample_bank_len(Sf2Result_bank(rz)), 3, "3 samples");
    assert_eq(parse_with_alloc_max(bz, 511), NIDHI_ERR_IMPORT, "refused zone-vec grow (zone 33) -> NIDHI_ERR_IMPORT, not 32 zones");
    var bzs = build_zones_sf2(40, 40, 16, 0);
    assert_eq(parse_with_alloc_max(bzs, 511), NIDHI_ERR_IMPORT, "refused bank grow (sample 33) -> NIDHI_ERR_IMPORT");
    var bzf = build_zones_sf2(40, 3, 16, 1);
    var rzf = sf2_parse(bb_buf(bzf), bb_len(bzf));
    assert_eq(zone_total(rzf), 40, "full zones (ranges, loops) unconstrained");
    # Every ceiling from 0 to 1 KB: the parse either fails with NIDHI_ERR_IMPORT or returns
    # exactly the unconstrained result. Partial results were the 2.2.2 behaviour.
    var lim = 0;
    var wrong = 0;
    var refused = 0;
    while (lim <= 1024) {
        var rl = parse_with_alloc_max(bz, lim);
        if (rl < 0) {
            if (rl != NIDHI_ERR_IMPORT) { wrong = wrong + 1; }
            refused = refused + 1;
        } else {
            if (vec_len(Sf2Result_presets(rl)) != 1) { wrong = wrong + 1; }
            if (zone_total(rl) != 40) { wrong = wrong + 1; }
            if (n_sample_bank_len(Sf2Result_bank(rl)) != 3) { wrong = wrong + 1; }
        }
        lim = lim + 8;
    }
    assert_eq(wrong, 0, "ALLOC_MAX 0..1024: NIDHI_ERR_IMPORT or the full result, never a partial one");
    assert(refused > 0, "the sweep does refuse some parses");

    return assert_summary();
}

var exit_code = main();
syscall(60, exit_code);
