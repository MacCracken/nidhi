# golden.tcyr -- assert the Cyrius port against values captured from the Rust oracle.
#
# rust-old/ was deleted in 2.0.4. Before that, a throwaway crate depending on it by path
# emitted these vectors; the oracle itself was never modified. The 2.0.3 audit found that
# stretch output VALUES were untested on BOTH sides -- all 13 Rust and all 40 Cyrius stretch
# assertions checked only length, non-emptiness or finiteness, so a wholesale algorithmic
# defect that preserved output length passed everything. This file closes that.
#
# Fixture: ((i * 7) % 32) / 32, i.e. k/32 -- EXACTLY representable in both f32 and f64, so a
# mismatch here is the algorithm and never the input. Goldens are round(value * 1e6).

include "lib/hisab.cyr"
include "lib/goonj.cyr"
include "lib/naad.cyr"
include "src/error.cyr"
include "src/f64_util.cyr"
include "src/loop_mode.cyr"
include "src/sample.cyr"
include "src/capture.cyr"
include "src/stretch.cyr"

fn fixture(n) {
    var v = vec_new();
    var i = 0;
    while (i < n) {
        vec_push(v, f64_div(f64_from((i * 7) % 32), f64_from(32)));
        i = i + 1;
    }
    return v;
}

# |actual*1e6 - golden| <= tol, compared in the float domain so f64_to never truncates a
# near-miss into a pass.
fn near(actual, golden_e6, tol_e6) {
    var a = f64_mul(actual, f64_from(1000000));
    var d = f64_abs(f64_sub(a, f64_from(golden_e6)));
    if (f64_le(d, f64_from(tol_e6)) == 1) { return 1; }
    return 0;
}

fn check(out, gold, offset, tol_e6, label) {
    var n = vec_len(gold);
    var bad = 0;
    var i = 0;
    while (i < n) {
        if (offset + i < vec_len(out)) {
            if (near(vec_get(out, offset + i), vec_get(gold, i), tol_e6) == 0) { bad = bad + 1; }
        } else {
            bad = bad + 1;
        }
        i = i + 1;
    }
    assert_eq(bad, 0, label);
    return bad;
}

fn main() {
    alloc_init();

    test_group("stretch_short values match the Rust oracle");

    var gold_short_1_0 = vec_new();
    vec_push(gold_short_1_0, 0); vec_push(gold_short_1_0, 218750); vec_push(gold_short_1_0, 437500); vec_push(gold_short_1_0, 656250); vec_push(gold_short_1_0, 875000); vec_push(gold_short_1_0, 93750); vec_push(gold_short_1_0, 312500); vec_push(gold_short_1_0, 531250); vec_push(gold_short_1_0, 750000); vec_push(gold_short_1_0, 968750);
    vec_push(gold_short_1_0, 187500); vec_push(gold_short_1_0, 406250); vec_push(gold_short_1_0, 625000); vec_push(gold_short_1_0, 843750); vec_push(gold_short_1_0, 62500); vec_push(gold_short_1_0, 281250); vec_push(gold_short_1_0, 500000); vec_push(gold_short_1_0, 718750); vec_push(gold_short_1_0, 937500); vec_push(gold_short_1_0, 156250);
    vec_push(gold_short_1_0, 375000); vec_push(gold_short_1_0, 593750); vec_push(gold_short_1_0, 812500); vec_push(gold_short_1_0, 31250); vec_push(gold_short_1_0, 250000); vec_push(gold_short_1_0, 468750); vec_push(gold_short_1_0, 687500); vec_push(gold_short_1_0, 906250); vec_push(gold_short_1_0, 125000); vec_push(gold_short_1_0, 343750);
    vec_push(gold_short_1_0, 562500); vec_push(gold_short_1_0, 781250); vec_push(gold_short_1_0, 0); vec_push(gold_short_1_0, 218750); vec_push(gold_short_1_0, 437500); vec_push(gold_short_1_0, 656250); vec_push(gold_short_1_0, 875000); vec_push(gold_short_1_0, 93750); vec_push(gold_short_1_0, 312500); vec_push(gold_short_1_0, 531250);
    var st_short_1_0 = n_stretcher_new(fixture(100), f64_from(44100));
    var out_short_1_0 = n_stretch(st_short_1_0, F64_ONE);
    assert_eq(vec_len(out_short_1_0), 100, "short_1_0 length matches oracle");
    check(out_short_1_0, gold_short_1_0, 0, 2, "short_1_0 values match oracle (tol 2e-6)");

    var gold_short_1_5 = vec_new();
    vec_push(gold_short_1_5, 0); vec_push(gold_short_1_5, 145833); vec_push(gold_short_1_5, 291667); vec_push(gold_short_1_5, 437500); vec_push(gold_short_1_5, 583333); vec_push(gold_short_1_5, 729167); vec_push(gold_short_1_5, 875000); vec_push(gold_short_1_5, 354167); vec_push(gold_short_1_5, 166667); vec_push(gold_short_1_5, 312500);
