    vec_push(gold_short_2_0, 187500); vec_push(gold_short_2_0, 296875); vec_push(gold_short_2_0, 406250); vec_push(gold_short_2_0, 515625); vec_push(gold_short_2_0, 625000); vec_push(gold_short_2_0, 734375); vec_push(gold_short_2_0, 843750); vec_push(gold_short_2_0, 453125); vec_push(gold_short_2_0, 62500); vec_push(gold_short_2_0, 171875);
    vec_push(gold_short_2_0, 281250); vec_push(gold_short_2_0, 390625); vec_push(gold_short_2_0, 500000); vec_push(gold_short_2_0, 609375); vec_push(gold_short_2_0, 718750); vec_push(gold_short_2_0, 828125); vec_push(gold_short_2_0, 937500); vec_push(gold_short_2_0, 546875); vec_push(gold_short_2_0, 156250); vec_push(gold_short_2_0, 265625);
    var st_short_2_0 = n_stretcher_new(fixture(100), f64_from(44100));
    var out_short_2_0 = n_stretch(st_short_2_0, f64_from(2));
    assert_eq(vec_len(out_short_2_0), 200, "short_2_0 length matches oracle");
    check(out_short_2_0, gold_short_2_0, 0, 2, "short_2_0 values match oracle (tol 2e-6)");

    test_group("WSOLA / OLA interior values match the Rust oracle");
    # Sampled at index 2000, inside the fully-overlapped region. The oracle's own output is
    # amplified up to ~588x at the EDGES, where window_sum falls under the 1e-6 normalise
    # threshold -- an inherited upstream defect the port reproduces faithfully (identical
    # threshold and guard). Interior samples are the meaningful comparison; the tolerance is
    # wide because f32-vs-f64 error is multiplied by the same normalisation.

    var gold_wsola_1_5 = vec_new();
    vec_push(gold_wsola_1_5, 521355); vec_push(gold_wsola_1_5, 748145); vec_push(gold_wsola_1_5, 974181); vec_push(gold_wsola_1_5, 162093); vec_push(gold_wsola_1_5, 388390); vec_push(gold_wsola_1_5, 613971); vec_push(gold_wsola_1_5, 838863); vec_push(gold_wsola_1_5, 32215); vec_push(gold_wsola_1_5, 257337); vec_push(gold_wsola_1_5, 481808);
    vec_push(gold_wsola_1_5, 705655); vec_push(gold_wsola_1_5, 928904); vec_push(gold_wsola_1_5, 127953); vec_push(gold_wsola_1_5, 351414); vec_push(gold_wsola_1_5, 574315); vec_push(gold_wsola_1_5, 796681); vec_push(gold_wsola_1_5, 0); vec_push(gold_wsola_1_5, 222548); vec_push(gold_wsola_1_5, 444600); vec_push(gold_wsola_1_5, 666181);
    vec_push(gold_wsola_1_5, 887316); vec_push(gold_wsola_1_5, 94974); vec_push(gold_wsola_1_5, 316274); vec_push(gold_wsola_1_5, 537166); vec_push(gold_wsola_1_5, 757675); vec_push(gold_wsola_1_5, 977827); vec_push(gold_wsola_1_5, 189102); vec_push(gold_wsola_1_5, 409401); vec_push(gold_wsola_1_5, 629380); vec_push(gold_wsola_1_5, 849064);
    vec_push(gold_wsola_1_5, 62852); vec_push(gold_wsola_1_5, 282654); vec_push(gold_wsola_1_5, 502197); vec_push(gold_wsola_1_5, 721508); vec_push(gold_wsola_1_5, 940609); vec_push(gold_wsola_1_5, 156693); vec_push(gold_wsola_1_5, 375896); vec_push(gold_wsola_1_5, 594928); vec_push(gold_wsola_1_5, 813813); vec_push(gold_wsola_1_5, 31290);
    var st_wsola_1_5 = n_stretcher_new(fixture(4096), f64_from(44100));
    var out_wsola_1_5 = n_stretch(st_wsola_1_5, f64_div(f64_from(3), f64_from(2)));
    assert_eq(vec_len(out_wsola_1_5), 6144, "wsola_1_5 length matches oracle");
    check(out_wsola_1_5, gold_wsola_1_5, 2000, 2000, "wsola_1_5 interior values match oracle");

    var gold_wsola_0_5 = vec_new();
    vec_push(gold_wsola_0_5, 521355); vec_push(gold_wsola_0_5, 748145); vec_push(gold_wsola_0_5, 974181); vec_push(gold_wsola_0_5, 162093); vec_push(gold_wsola_0_5, 388390); vec_push(gold_wsola_0_5, 613971); vec_push(gold_wsola_0_5, 838863); vec_push(gold_wsola_0_5, 32215); vec_push(gold_wsola_0_5, 257337); vec_push(gold_wsola_0_5, 481808);
    vec_push(gold_wsola_0_5, 705655); vec_push(gold_wsola_0_5, 928904); vec_push(gold_wsola_0_5, 127953); vec_push(gold_wsola_0_5, 351414); vec_push(gold_wsola_0_5, 574315); vec_push(gold_wsola_0_5, 796681); vec_push(gold_wsola_0_5, 0); vec_push(gold_wsola_0_5, 222548); vec_push(gold_wsola_0_5, 444600); vec_push(gold_wsola_0_5, 666181);
    vec_push(gold_wsola_0_5, 887316); vec_push(gold_wsola_0_5, 94974); vec_push(gold_wsola_0_5, 316274); vec_push(gold_wsola_0_5, 537166); vec_push(gold_wsola_0_5, 757675); vec_push(gold_wsola_0_5, 977827); vec_push(gold_wsola_0_5, 189102); vec_push(gold_wsola_0_5, 409401); vec_push(gold_wsola_0_5, 629380); vec_push(gold_wsola_0_5, 849064);
    vec_push(gold_wsola_0_5, 62852); vec_push(gold_wsola_0_5, 282654); vec_push(gold_wsola_0_5, 502197); vec_push(gold_wsola_0_5, 721508); vec_push(gold_wsola_0_5, 940609); vec_push(gold_wsola_0_5, 156693); vec_push(gold_wsola_0_5, 375896); vec_push(gold_wsola_0_5, 594928); vec_push(gold_wsola_0_5, 813813); vec_push(gold_wsola_0_5, 31290);
