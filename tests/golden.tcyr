    var out_wsola_0_5 = n_stretch(st_wsola_0_5, F64_HALF);
    assert_eq(vec_len(out_wsola_0_5), 2048, "wsola_0_5 length matches oracle");
    check(out_wsola_0_5, gold_wsola_0_5, 2000, 2000, "wsola_0_5 interior values match oracle");

    var gold_ola_1_5 = vec_new();
    vec_push(gold_ola_1_5, 525401); vec_push(gold_ola_1_5, 752015); vec_push(gold_ola_1_5, 958153); vec_push(gold_ola_1_5, 165624); vec_push(gold_ola_1_5, 391758); vec_push(gold_ola_1_5, 617179); vec_push(gold_ola_1_5, 825629); vec_push(gold_ola_1_5, 35118); vec_push(gold_ola_1_5, 260093); vec_push(gold_ola_1_5, 484422);
    vec_push(gold_ola_1_5, 708130); vec_push(gold_ola_1_5, 918763); vec_push(gold_ola_1_5, 130163); vec_push(gold_ola_1_5, 353497); vec_push(gold_ola_1_5, 576275); vec_push(gold_ola_1_5, 798522); vec_push(gold_ola_1_5, 1726); vec_push(gold_ola_1_5, 224163); vec_push(gold_ola_1_5, 446108); vec_push(gold_ola_1_5, 667585);
    vec_push(gold_ola_1_5, 881663); vec_push(gold_ola_1_5, 96183); vec_push(gold_ola_1_5, 317391); vec_push(gold_ola_1_5, 538194); vec_push(gold_ola_1_5, 758619); vec_push(gold_ola_1_5, 974088); vec_push(gold_ola_1_5, 189888); vec_push(gold_ola_1_5, 410113); vec_push(gold_ola_1_5, 630022); vec_push(gold_ola_1_5, 846567);
    vec_push(gold_ola_1_5, 63365); vec_push(gold_ola_1_5, 283108); vec_push(gold_ola_1_5, 502597); vec_push(gold_ola_1_5, 721855); vec_push(gold_ola_1_5, 939311); vec_push(gold_ola_1_5, 156948); vec_push(gold_ola_1_5, 376111); vec_push(gold_ola_1_5, 595105); vec_push(gold_ola_1_5, 813191); vec_push(gold_ola_1_5, 31403);
    var st_ola_1_5 = n_stretcher_new(fixture(4096), f64_from(44100));
    var out_ola_1_5 = n_stretch_ola(st_ola_1_5, f64_div(f64_from(3), f64_from(2)));
    assert_eq(vec_len(out_ola_1_5), 6144, "ola_1_5 length matches oracle");
    check(out_ola_1_5, gold_ola_1_5, 2000, 2000, "ola_1_5 interior values match oracle");

    var gold_ola_0_5 = vec_new();
    vec_push(gold_ola_0_5, 521355); vec_push(gold_ola_0_5, 748145); vec_push(gold_ola_0_5, 974181); vec_push(gold_ola_0_5, 162093); vec_push(gold_ola_0_5, 388390); vec_push(gold_ola_0_5, 613971); vec_push(gold_ola_0_5, 838863); vec_push(gold_ola_0_5, 32215); vec_push(gold_ola_0_5, 257337); vec_push(gold_ola_0_5, 481808);
    vec_push(gold_ola_0_5, 705655); vec_push(gold_ola_0_5, 928904); vec_push(gold_ola_0_5, 127953); vec_push(gold_ola_0_5, 351414); vec_push(gold_ola_0_5, 574315); vec_push(gold_ola_0_5, 796681); vec_push(gold_ola_0_5, 0); vec_push(gold_ola_0_5, 222548); vec_push(gold_ola_0_5, 444600); vec_push(gold_ola_0_5, 666181);
    vec_push(gold_ola_0_5, 887316); vec_push(gold_ola_0_5, 94974); vec_push(gold_ola_0_5, 316274); vec_push(gold_ola_0_5, 537166); vec_push(gold_ola_0_5, 757675); vec_push(gold_ola_0_5, 977827); vec_push(gold_ola_0_5, 189102); vec_push(gold_ola_0_5, 409401); vec_push(gold_ola_0_5, 629380); vec_push(gold_ola_0_5, 849064);
    vec_push(gold_ola_0_5, 62852); vec_push(gold_ola_0_5, 282654); vec_push(gold_ola_0_5, 502197); vec_push(gold_ola_0_5, 721508); vec_push(gold_ola_0_5, 940609); vec_push(gold_ola_0_5, 156693); vec_push(gold_ola_0_5, 375896); vec_push(gold_ola_0_5, 594928); vec_push(gold_ola_0_5, 813813); vec_push(gold_ola_0_5, 31290);
    var st_ola_0_5 = n_stretcher_new(fixture(4096), f64_from(44100));
    var out_ola_0_5 = n_stretch_ola(st_ola_0_5, F64_HALF);
    assert_eq(vec_len(out_ola_0_5), 2048, "ola_0_5 length matches oracle");
    check(out_ola_0_5, gold_ola_0_5, 2000, 2000, "ola_0_5 interior values match oracle");

    test_group("round-half-away ties match the Rust oracle");
    # n = 1,3,5,7,9,11 at ratio 0.5 -> 0.5,1.5,2.5,3.5,4.5,5.5. Rust rounds half AWAY from
    # zero: 1 2 3 4 5 6. Cyrius f64_round is half-to-EVEN and would give 0 2 2 4 4 6, so
    # this is a direct discriminator for the 2.0.3 n_round_half_away fix.
    assert_eq(vec_len(n_stretch(n_stretcher_new(fixture(1), f64_from(44100)), F64_HALF)), 1, "n=1 ratio 0.5 -> 1 frames");
    assert_eq(vec_len(n_stretch(n_stretcher_new(fixture(3), f64_from(44100)), F64_HALF)), 2, "n=3 ratio 0.5 -> 2 frames");
    assert_eq(vec_len(n_stretch(n_stretcher_new(fixture(5), f64_from(44100)), F64_HALF)), 3, "n=5 ratio 0.5 -> 3 frames");
    assert_eq(vec_len(n_stretch(n_stretcher_new(fixture(7), f64_from(44100)), F64_HALF)), 4, "n=7 ratio 0.5 -> 4 frames");
    assert_eq(vec_len(n_stretch(n_stretcher_new(fixture(9), f64_from(44100)), F64_HALF)), 5, "n=9 ratio 0.5 -> 5 frames");
    assert_eq(vec_len(n_stretch(n_stretcher_new(fixture(11), f64_from(44100)), F64_HALF)), 6, "n=11 ratio 0.5 -> 6 frames");

    test_group("detect_loop_points ordering matches the Rust oracle");
    var per = vec_new();
    var pi = 0;
    while (pi < 2000) {
        vec_push(per, f64_sub(f64_div(f64_from(pi % 50), f64_from(50)), F64_HALF));
        pi = pi + 1;
    }
    var psm = n_sample_from_mono(per, 44100);
    var lps = n_detect_loop_points(psm, 100);
    assert_eq(vec_len(lps), 10, "candidate count matches oracle");
    if (vec_len(lps) > 0) {
        assert_eq(load64(vec_get(lps, 0)), 26, "loop[0].start == 26");
        assert_eq(load64(vec_get(lps, 0) + 8), 126, "loop[0].end == 126");
    }
    if (vec_len(lps) > 1) {
        assert_eq(load64(vec_get(lps, 1)), 26, "loop[1].start == 26");
        assert_eq(load64(vec_get(lps, 1) + 8), 176, "loop[1].end == 176");
    }
    if (vec_len(lps) > 2) {
        assert_eq(load64(vec_get(lps, 2)), 26, "loop[2].start == 26");
        assert_eq(load64(vec_get(lps, 2) + 8), 226, "loop[2].end == 226");
    }
    if (vec_len(lps) > 3) {
        assert_eq(load64(vec_get(lps, 3)), 26, "loop[3].start == 26");
        assert_eq(load64(vec_get(lps, 3) + 8), 276, "loop[3].end == 276");
    }
    if (vec_len(lps) > 4) {
        assert_eq(load64(vec_get(lps, 4)), 26, "loop[4].start == 26");
        assert_eq(load64(vec_get(lps, 4) + 8), 326, "loop[4].end == 326");
    }
    if (vec_len(lps) > 5) {
        assert_eq(load64(vec_get(lps, 5)), 26, "loop[5].start == 26");
        assert_eq(load64(vec_get(lps, 5) + 8), 376, "loop[5].end == 376");
    }
    if (vec_len(lps) > 6) {
        assert_eq(load64(vec_get(lps, 6)), 26, "loop[6].start == 26");
        assert_eq(load64(vec_get(lps, 6) + 8), 426, "loop[6].end == 426");
    }
    if (vec_len(lps) > 7) {
        assert_eq(load64(vec_get(lps, 7)), 26, "loop[7].start == 26");
        assert_eq(load64(vec_get(lps, 7) + 8), 476, "loop[7].end == 476");
    }
    if (vec_len(lps) > 8) {
        assert_eq(load64(vec_get(lps, 8)), 26, "loop[8].start == 26");
        assert_eq(load64(vec_get(lps, 8) + 8), 526, "loop[8].end == 526");
    }
    if (vec_len(lps) > 9) {
        assert_eq(load64(vec_get(lps, 9)), 26, "loop[9].start == 26");
        assert_eq(load64(vec_get(lps, 9) + 8), 576, "loop[9].end == 576");
    }

    return assert_summary();
}

var exit_code = main();
syscall(60, exit_code);
