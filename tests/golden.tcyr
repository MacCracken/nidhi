    vec_push(gold_short_1_5, 583333); vec_push(gold_short_1_5, 62500); vec_push(gold_short_1_5, 208333); vec_push(gold_short_1_5, 354167); vec_push(gold_short_1_5, 500000); vec_push(gold_short_1_5, 645833); vec_push(gold_short_1_5, 791667); vec_push(gold_short_1_5, 937500); vec_push(gold_short_1_5, 416667); vec_push(gold_short_1_5, 229167);
