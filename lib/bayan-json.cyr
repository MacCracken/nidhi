# floor(a / b) for b > 0 (cyrius `/` truncates toward zero).
fn _d_floordiv(a, b): i64 {
    var q = a / b;
    if (a < 0) { if (q * b != a) { q = q - 1; } }
    return q;
}
# table accessors — significand from storage; exponents closed-form.
fn _d_sig(idx): i64 { return load64(&_D_POW10_SIG + idx * 8); }
fn _d_decexp(idx): i64 { return (0 - 348) + 8 * idx; }
# binexp = floor(decexp * log2(10)) - 63, with log2(10) ~= 108853/32768 (exact
# for every table entry, validated).
fn _d_binexp(idx): i64 { return _d_floordiv(_d_decexp(idx) * 108853, 32768) - 63; }
# integer 10^n for small nonneg n (0..18).
fn _d_pow10_i(n): i64 {
    var r = 1;
    var i = 0;
    while (i < n) { r = r * 10; i = i + 1; }
    return r;
}

# ---- unsigned 64-bit helpers (i64 holds u64 bit patterns) ----
# a < b as u64: flip both sign bits, then a signed compare yields the u64 order.
fn _d_ult(a, b): i64 { return (a ^ 0x8000000000000000) < (b ^ 0x8000000000000000); }
fn _d_ule(a, b): i64 { if (_d_ult(b, a) == 1) { return 0; } return 1; }

# High 64 bits of (a*b), rounded, both treated as u64 — the DiyFp significand
# multiply (rapidjson DiyFp::Multiply). Splits into 32-bit pieces so each partial
# product fits a register; `>>` is logical so the bit patterns are true unsigned
# products even when the i64 sign bit is set.
fn _d_mul_hi(a, b): i64 {
    var ah = (a >> 32) & _D_MASK32;
    var al = a & _D_MASK32;
    var bh = (b >> 32) & _D_MASK32;
    var bl = b & _D_MASK32;
    var ac = ah * bh;
    var bc = al * bh;
    var ad = ah * bl;
    var bd = al * bl;
    var tmp = ((bd >> 32) & _D_MASK32) + (ad & _D_MASK32) + (bc & _D_MASK32);
    tmp = tmp + 0x80000000;   # round-to-nearest of the discarded low half (1<<31)
    return ac + ((ad >> 32) & _D_MASK32) + ((bc >> 32) & _D_MASK32) + ((tmp >> 32) & _D_MASK32);
}

# Number of decimal digits in a 32-bit value p (1..10).
fn _d_dec_digits32(p): i64 {
    var n = 1;
    while (n < 10) {
        if (_d_ult(p, _d_pow10_i(n)) == 1) { return n; }
        n = n + 1;
    }
    return 10;
}

# Pick the cached-power index so the multiplied result's exponent lands in the
# Grisu window [-59,-32]. Exactly one 8-step entry qualifies for a given e (=Mp.e).
fn _d_pick_power(e): i64 {
    var idx = 0;
    while (idx < 87) {
        var pe = _d_binexp(idx) + e + 64;
        if (pe >= (0 - 59)) {
            if (pe <= (0 - 32)) { return idx; }
        }
        idx = idx + 1;
    }
    return 86;
}

# GrisuRound: nudge the last emitted digit down while staying inside the interval
# and getting closer to w (rapidjson GrisuRound). All compares are u64.
fn _d_grisu_round(buf, len, delta, rest, ten_kappa, wp_w): i64 {
    while (1 == 1) {
        if (_d_ult(rest, wp_w) != 1) { return 0; }
        if (_d_ule(ten_kappa, delta - rest) != 1) { return 0; }
        var cond = 0;
        if (_d_ult(rest + ten_kappa, wp_w) == 1) { cond = 1; }
        elif (_d_ult((rest + ten_kappa) - wp_w, wp_w - rest) == 1) { cond = 1; }
        if (cond == 0) { return 0; }
        store8(buf + len - 1, load8(buf + len - 1) - 1);
        rest = rest + ten_kappa;
    }
    return 0;
}

# Grisu2 digit generation. W = scaled value, Mp = scaled upper boundary (same e =
# mp_e), delta = interval width (u64). Writes ASCII digits into buf; returns count;
# writes the decimal power k to kout[0] (value == digits * 10^k).
fn _d_digit_gen(w_f, mp_f, mp_e, delta, buf, kout): i64 {
    var one_f = 1 << (0 - mp_e);
    var one_e = mp_e;
    var wp_w = mp_f - w_f;
    var p1 = (mp_f >> (0 - one_e)) & _D_MASK32;
    var p2 = mp_f & (one_f - 1);
    var kappa = _d_dec_digits32(p1);
    var len = 0;
    while (kappa > 0) {
        var pw = _d_pow10_i(kappa - 1);
        var d = p1 / pw;
        if (d != 0 || len != 0) { store8(buf + len, 48 + d); len = len + 1; }
        p1 = p1 - d * pw;
        kappa = kappa - 1;
        var tmp = ((p1 & _D_MASK32) << (0 - one_e)) + p2;
        if (_d_ule(tmp, delta) == 1) {
            _d_grisu_round(buf, len, delta, tmp, _d_pow10_i(kappa) << (0 - one_e), wp_w);
            store64(kout, kappa);
            return len;
        }
    }
    while (1 == 1) {
        p2 = p2 * 10;
        delta = delta * 10;
        var d2 = (p2 >> (0 - one_e)) & _D_MASK32;
        if (d2 != 0 || len != 0) { store8(buf + len, 48 + d2); len = len + 1; }
        p2 = p2 & (one_f - 1);
        kappa = kappa - 1;
        if (_d_ult(p2, delta) == 1) {
            var scale = _d_pow10_i(0 - kappa);
            _d_grisu_round(buf, len, delta, p2, one_f, wp_w * scale);
            store64(kout, kappa);
            return len;
        }
    }
    store64(kout, kappa);
    return len;
}

# Grisu2 core: f64 bits (finite, nonzero, positive) -> ASCII digits in buf,
# decimal exponent to kout[0]. Returns digit count. value == digits * 10^K.
fn _d_grisu2(bits, buf, kout): i64 {
    var mant = bits & 0x000FFFFFFFFFFFFF;
    var be   = (bits >> 52) & 0x7FF;
    var f = 0;
    var e = 0;
    if (be != 0) { f = mant + 0x0010000000000000; e = be - 1075; }
    else         { f = mant;                       e = 0 - 1074; }

    # NormalizedBoundaries: plus boundary
    var mp_f = (f << 1) + 1;
    var mp_e = e - 1;
    while ((mp_f & 0x0020000000000000) == 0) { mp_f = mp_f << 1; mp_e = mp_e - 1; }
    mp_f = mp_f << 10;
    mp_e = mp_e - 10;
    # minus boundary
    var mm_f = 0;
    if (f == 0x0010000000000000) { mm_f = (f << 2) - 1; }
    else                          { mm_f = (f << 1) - 1; }
    var mm_e = e - 1;
    if (f == 0x0010000000000000) { mm_e = e - 2; }
    mm_f = mm_f << (mm_e - mp_e);

    # normalize v
    var vf = f;
    var ve = e;
    while ((vf & _D_BIT63) == 0) { vf = vf << 1; ve = ve - 1; }

    var idx = _d_pick_power(mp_e);
    var cf = _d_sig(idx);
    var ce = _d_binexp(idx);
    var cdec = _d_decexp(idx);

    var W_f  = _d_mul_hi(vf, cf);
    var Wp_f = _d_mul_hi(mp_f, cf);
    var Wm_f = _d_mul_hi(mm_f, cf);
    Wp_f = Wp_f - 1;
    Wm_f = Wm_f + 1;
    var delta = Wp_f - Wm_f;
    var Wp_e = mp_e + ce + 64;

    var len = _d_digit_gen(W_f, Wp_f, Wp_e, delta, buf, kout);
    # value == digits * 10^(kappa - decexp)  (rapidjson: K=-decexp, then K+=kappa)
    store64(kout, load64(kout) - cdec);
    return len;
}

# write a signed decimal exponent at buf+pos; return chars written.
fn _d_write_exp(buf, pos, e): i64 {
    var n = 1;
    if (e < 0) { store8(buf + pos, 45); e = 0 - e; }
    else       { store8(buf + pos, 43); }
    pos = pos + 1;
    var tmp[8];
    var ti = 0;
    if (e == 0) { store8(&tmp, 48); ti = 1; }
    while (e > 0) { store8(&tmp + ti, 48 + e % 10); ti = ti + 1; e = e / 10; }
    var w = ti;
    while (ti > 0) { ti = ti - 1; store8(buf + pos, load8(&tmp + ti)); pos = pos + 1; }
    return n + w;
}

# Prettify (rapidjson): value == digits * 10^k, decimal point after (len + k).
# Fixed notation for a moderate window, else exponent form. `buf` holds `len`
# ASCII digits on entry. Returns total length.
fn _d_prettify(buf, len, k): i64 {
    var kk = len + k;
    if (len <= kk && kk <= 21) {
        var i = len;
        while (i < kk) { store8(buf + i, 48); i = i + 1; }
        store8(buf + kk, 46);
        store8(buf + kk + 1, 48);
        return kk + 2;
    } elif (0 < kk && kk <= 21) {
        var i2 = len;
        while (i2 > kk) { store8(buf + i2, load8(buf + i2 - 1)); i2 = i2 - 1; }
        store8(buf + kk, 46);
        return len + 1;
    } elif ((0 - 6) < kk && kk <= 0) {
        var offset = 2 - kk;
        var j = len - 1;
        while (j >= 0) { store8(buf + j + offset, load8(buf + j)); j = j - 1; }
        store8(buf, 48);
        store8(buf + 1, 46);
        var z = 0;
        while (z < (0 - kk)) { store8(buf + 2 + z, 48); z = z + 1; }
        return len + offset;
    } elif (len == 1) {
        store8(buf + 1, 101);
        return 2 + _d_write_exp(buf, 2, kk - 1);
    } else {
        # insert '.' after the first digit: move digits[1..len-1] right by one,
        # THEN write '.' at [1]. (The old `t=len..2` loop left buf[1] unmoved and
        # then clobbered it with '.', dropping digit[1] — only bit exponent form.)
        var t = len - 1;
        while (t >= 1) { store8(buf + t + 1, load8(buf + t)); t = t - 1; }
        store8(buf + 1, 46);
        store8(buf + len + 1, 101);
        return len + 2 + _d_write_exp(buf, len + 2, kk - 1);
    }
}

# Public: format an f64 bit pattern as a JSON number into `buf` (no NUL written).
# Returns the byte length. Non-finite -> "null" (4). Handles sign and zero.
fn bayan_f64_to_json(bits, buf): i64 {
    _d_init_tables();
    var be = (bits >> 52) & 0x7FF;
    var mant = bits & 0x000FFFFFFFFFFFFF;
    if (be == 0x7FF) {
        store8(buf, 110); store8(buf + 1, 117); store8(buf + 2, 108); store8(buf + 3, 108);
        return 4;
    }
    var pos = 0;
    if ((bits & _D_BIT63) != 0) { store8(buf, 45); pos = 1; }
    if (be == 0 && mant == 0) {
        store8(buf + pos, 48); store8(buf + pos + 1, 46); store8(buf + pos + 2, 48);
        return pos + 3;
    }
    var pbits = bits & 0x7FFFFFFFFFFFFFFF;
    var kbuf[8];
    var len = _d_grisu2(pbits, buf + pos, &kbuf);
    var k = load64(&kbuf);
    return pos + _d_prettify(buf + pos, len, k);
}

# ================================================================
# Parsing: decimal text -> f64 bit pattern, CORRECTLY ROUNDED for every input
# (IEEE 754 round-half-to-even), by the stdlib's f64_parse_n (lib/math.cyr).
#
# 1.5.7 to 1.5.13 carried bayan's own three-tier parser here (Clinger, a DiyFp
# approximation that answers only outside its error window, an exact decimal;
# ADR-0003). cyrius 6.6.13 ported it into lib/math.cyr, and cyrius 6.7.9 made
# its length-bounded form public as f64_parse_n(s, n), so bayan delegates rather
# than keep a second copy of a numerically delicate routine in step (B-4,
# CHANGELOG bayan [1.5.14]: the same bits as the 1.5.13 parser on every input of
# a differential of over a million strings).
#
# The one point the two disagree on stays on bayan's side. f64_parse_n is strict:
# only a whole `nan` / `inf` inside the span, any other n/N/i/I start is 0.
# bayan's readers have always taken ANY n/N start as NaN (so `null` and `nan` both
# read as NaN) and any i/I start as +/-Inf, and keep doing so.
# ================================================================

# Parse a decimal number to an f64 bit pattern, reading at most `n` bytes from `s`
# and stopping at the first non-number byte. Leading spaces/tabs and one sign are
# skipped; an n/N start is quiet NaN and an i/I start +/-Inf (above). Everything
# else is f64_parse_n's: integer/fraction, e/E exponent, the exponent accumulator
# SATURATING (no O(exp) loop -> no DoS); no digits -> 0, "-0" -> -0.0.
fn bayan_f64_parse(s, n): i64 {
    var i = 0;
    var neg = 0;
    while (i < n && (load8(s + i) == 32 || load8(s + i) == 9)) { i = i + 1; }
    if (i < n && load8(s + i) == 45) { neg = 1; i = i + 1; }
    elif (i < n && load8(s + i) == 43) { i = i + 1; }
    var c0 = 0;
    if (i < n) { c0 = load8(s + i); }
    if (c0 == 110 || c0 == 78) { return 0x7FF8000000000000; }   # n/N -> NaN (also 'null')
    if (c0 == 105 || c0 == 73) {                                # i/I -> Inf
        if (neg == 1) { return 0xFFF0000000000000; }
        return 0x7FF0000000000000;
    }
    return f64_parse_n(s, n);
}

# Parse a NUL-terminated decimal cstring (the scan self-delimits at the NUL / any
# non-number byte). Used by #derive(Serialize) deserialize.
fn bayan_f64_from_json(s): i64 { return bayan_f64_parse(s, 2147483647); }

# --- json.cyr ---

# json.cyr — minimal JSON parser and builder
# Usage: include "lib/bayan.cyr" (full bundle) or "lib/bayan-json.cyr" (sublib).
#        `lib/json.cyr` was the pre-carve stdlib module and no longer ships —
#        this content moved into bayan at 1.0.0 / cyrius 6.1.25.
# Requires: string.cyr, alloc.cyr, str.cyr, vec.cyr, fmt.cyr, io.cyr, slice.cyr (1.11.1),
#           hashseed.cyr (1.11.1: the duplicate-key set's per-process hash seed)
# Internally includes: fnptr.cyr (for streaming-parser fncallN dispatch)
#
# THE PARSERS READ THROUGH SLICES (1.11.1; cyrius 6.7.18 D1, the user's
# decision). Every fn of the three parsers that reads the document wraps its
# (buf, len) in a fn-local `var bs: [u8]` (slice_set) and reads bs[i], which is
# bounds-checked in EVERY build: an index outside [0, len) is not a read past
# the input but "slice bounds violation" and exit 134. A peer's document is the
# input these parsers see most, and before this the bytes were raw load8(buf +
# i) reads that cyrius's #bounds mode cannot see. The cost is a call per byte.
# lib/slice.cyr is therefore a requirement of this module (the bundles' Requires
# block names it).
#
# bayan_json_parse, the flat key/value API just below, reads ONE object's
# top-level members into key/value pairs of raw source bytes (callers convert
# with str_to_int etc.). A member whose value is an object or an array comes
# back whole, as its raw source span, and bayan_json_parse reads that span
# again. Malformed input stops it, keeping the pairs read before the defect.
# bayan_json_v_parse, the tagged-tree engine further down, builds every level,
# decodes escapes, and refuses a malformed document outright;
# bayan_json_stream_parse walks the same grammar as events.

# v5.8.30: Result-returning *_r variants for the file-loading
# parsers (`bayan_json_parse_file_r`). Bare `bayan_json_parse(src)` keeps its
# best-effort vec return — no clean -1 surface to migrate.

# v5.8.30 — JsonError variants. `JsonIoErr` covers any underlying
# IoError raised while reading the source file; `JsonParseErr` is
# reserved for a future slot when the parser tracks structural
# errors instead of best-effort recovery; `JsonOther` is the
# catch-all. Keep variant-name prefix `Json` to avoid colliding
# with IoError's `Io*` variants in the global enum-variant
# namespace.
enum JsonError {
    JsonIoErr;
    JsonParseErr;
    JsonOther;
}

# JSON pair: { key: Str, value: Str, kind } — 24 bytes as of 1.7.0, 16 before.
const JSON_PAIR_SIZE = 24;

# --- Value kinds (1.7.0) ---------------------------------------------------
#
# A pair records which form its value took, as TOML's have since 1.5.4. Until
# 1.7.0 a pair held two Strs and nothing else, so bayan_json_build could not
# tell the number 42 from the string "42", a nested object from a string that
# happened to start with `{`, or the raw bytes the parser keeps (escapes as
# written) from text a caller built a pair with (escapes still to add). It
# quoted everything and escaped nothing: numbers came back as strings, nested
# values as quoted spans, and a `"` or `\` in a hand-built value made invalid
# JSON.
#
# JSON_K_TEXT is what a hand-built pair gets: its key and value are plain text,
# which bayan_json_build escapes, and the value is written as a string, as it
# always was. The other kinds come from bayan_json_parse, whose keys and values
# are raw source bytes: the builder writes them as they were read.
const JSON_K_TEXT   = 0;   # built by hand: text, escaped and quoted on output
const JSON_K_STRING = 1;   # a string; the value is its body, escapes as written
const JSON_K_BARE   = 2;   # a number, true, false or null, as written
const JSON_K_OBJECT = 3;   # an object, its whole raw span
const JSON_K_ARRAY  = 4;   # an array, its whole raw span

# 1.7.0 — Allocator-as-first-arg pair constructor that records the value's kind
# (a JSON_K_* value). Any kind but JSON_K_TEXT says that the key and value are
# raw JSON source bytes, which bayan_json_build writes unchanged. Returns 0 on
# OOM.
fn bayan_json_pair_new_kind_a(a, key, value, kind): i64 {
    var p = alloc_via(a, JSON_PAIR_SIZE);
    if (p == 0) { return 0; }
    store64(p, key);
    store64(p + 8, value);
    store64(p + 16, kind);
    return p;
}

# 1.7.0 — Default-allocator form of bayan_json_pair_new_kind_a.
fn bayan_json_pair_new_kind(key, value, kind): i64 {
    return bayan_json_pair_new_kind_a(default_alloc(), key, value, kind);
}

# v5.8.36 — Allocator-as-first-arg variant of bayan_json_pair_new.
# Allocates the pair via `a`. Returns 0 on OOM.
#
# ⚠ THE PAIR IS 24 BYTES AS OF 1.7.0, not 16. Anything that allocated a pair by
# hand, or assumed the size, must be re-checked. Reading a pair through the
# accessors is unaffected, and this constructor keeps its signature: a pair
# built here is JSON_K_TEXT.
fn bayan_json_pair_new_a(a, key, value): i64 {
    return bayan_json_pair_new_kind_a(a, key, value, JSON_K_TEXT);
}

# Create a new key-value pair for JSON storage. v5.8.36 wrapper.
fn bayan_json_pair_new(key, value): i64 {
    return bayan_json_pair_new_a(default_alloc(), key, value);
}

# Return the key Str from a JSON pair
fn bayan_json_key(p): i64 { return load64(p); }
# Return the value Str from a JSON pair
fn bayan_json_value(p): i64 { return load64(p + 8); }
# 1.7.0 — Which form this pair's value took (a JSON_K_* value).
fn bayan_json_pair_kind(p): i64 { return load64(p + 16); }

# --- Duplicate object keys (1.11.1) ----------------------------------------
#
# A DUPLICATE KEY IS REFUSED, by every parser in this file and by yaml's mapping
# parser: "duplicate key" with the byte offset of the second one (the user's
# decision at the 6.7.18 audit). Until 1.11.1 JSON accepted them and answered the
# FIRST, the opposite of most readers: {"role":"user","role":"admin"} read
# role=user here, bayan_json_v_build re-emitted both pairs, and every last-wins
# reader downstream saw admin, so a bayan component that validated a body and
# another that acted on it disagreed about a role, the shape yaml and toml in
# this fold already refuse. Keys compare DECODED: "\u0061dmin" is "admin".
#
# The key set is one object's keys while it is parsed, a stack local of the
# parsing frame (_JK_SIZE bytes): up to _JK_INLINE keys compare in place, with no
# allocation, so an object of 32 keys or fewer allocates exactly what it did
# before 1.11.1; past that an open-addressing table, doubled at half
# full, finds a key in O(1), so an object of n keys costs O(n), not the O(n^2) of
# a walk of the keys before it (yaml's mapping parser, until 1.11.1). It borrows
# the key bytes, so they must outlive the parse of the object.
#   +0  a       the allocator the table comes from
#   +8  n       keys added
#   +16 slots   0 while n <= _JK_INLINE; then cap slots of {hash, ptr, len + 1}
#   +24 cap     a power of two
#   +32         _JK_INLINE x {ptr, len}
const _JK_INLINE = 32;
const _JK_SIZE = 544;

fn _jk_init(ks, a): i64 {
    store64(ks, a);
    store64(ks + 8, 0);
    store64(ks + 16, 0);
    store64(ks + 24, 0);
    return 0;
}

# FNV-1a over the key bytes from a basis seeded per process, then hashseed's
# finalizer, so every bit of the slot depends on the whole key AND the seed. The
# keys are a peer's: with published constants alone (1.11.1 as first written) a
# peer precomputed, offline and once, keys sharing a slot, and each insert walked
# every key before it (10,000 of them, 147 KB: 309 ms a parse, quadratic from
# there, against 6 ms) — the hash flooding lib/hashseed.cyr closed for the
# stdlib's maps. Seeding the basis alone would not do: its header says why.
fn _jk_hash(p, n): i64 {
    var h = 0xCBF29CE484222325 ^ _hm_seed_get();
    var i = 0;
    while (i < n) {
        h = (h ^ load8(p + i)) * 0x100000001B3;
        i = i + 1;
    }
    return _hm_mix(h);
}

# Put {h, p, n} into the table `slots` of mask + 1 slots, which has room.
fn _jk_put(slots, mask, h, p, n): i64 {
    var i = h & mask;
    while (load64(slots + i * 24 + 16) != 0) { i = (i + 1) & mask; }
    var s = slots + i * 24;
    store64(s, h);
    store64(s + 8, p);
    store64(s + 16, n + 1);
    return 0;
}

# A zeroed table of `cap` slots holding the set's keys so far, or 0 if refused.
fn _jk_table(ks, cap): i64 {
    var t = alloc_via(load64(ks), cap * 24);
    if (t == 0) { return 0; }
    memset(t, 0, cap * 24);
    var old = load64(ks + 16);
    var i = 0;
    if (old == 0) {
        while (i < load64(ks + 8)) {
            var e = ks + 32 + i * 16;
            _jk_put(t, cap - 1, _jk_hash(load64(e), load64(e + 8)), load64(e), load64(e + 8));
            i = i + 1;
        }
        return t;
    }
    var ocap = load64(ks + 24);
    while (i < ocap) {
        var o = old + i * 24;
        if (load64(o + 16) != 0) { _jk_put(t, cap - 1, load64(o), load64(o + 8), load64(o + 16) - 1); }
        i = i + 1;
    }
    free_via(load64(ks), old);
    return t;
}

# Add the key p[0, n) to the set: 1 when it is new, 0 when the set already holds
# it, -1 when the table's allocation is refused.
fn _jk_add(ks, p, n): i64 {
    var cnt = load64(ks + 8);
    var slots = load64(ks + 16);
    if (slots == 0) {
        var i = 0;
        while (i < cnt) {
            var e = ks + 32 + i * 16;
            if (load64(e + 8) == n) {
                if (memeq(load64(e), p, n) == 1) { return 0; }
            }
            i = i + 1;
        }
        if (cnt < _JK_INLINE) {
            store64(ks + 32 + cnt * 16, p);
            store64(ks + 32 + cnt * 16 + 8, n);
            store64(ks + 8, cnt + 1);
            return 1;
        }
        # Four slots per key held, so the table starts under half full.
        slots = _jk_table(ks, _JK_INLINE * 4);
        if (slots == 0) { return 0 - 1; }
        store64(ks + 16, slots);
        store64(ks + 24, _JK_INLINE * 4);
    }
    var cap = load64(ks + 24);
    var h = _jk_hash(p, n);
    var j = h & (cap - 1);
    while (load64(slots + j * 24 + 16) != 0) {
        var s = slots + j * 24;
        if (load64(s) == h && load64(s + 16) == n + 1) {
            if (memeq(load64(s + 8), p, n) == 1) { return 0; }
        }
        j = (j + 1) & (cap - 1);
    }
    if ((cnt + 1) * 2 > cap) {
        slots = _jk_table(ks, cap * 2);
        if (slots == 0) { return 0 - 1; }
        store64(ks + 16, slots);
        store64(ks + 24, cap * 2);
        cap = cap * 2;
    }
    _jk_put(slots, cap - 1, h, p, n);
    store64(ks + 8, cnt + 1);
    return 1;
}

# Give the set's table, if it grew one, back to its allocator.
fn _jk_free(ks): i64 {
    if (load64(ks + 16) != 0) { free_via(load64(ks), load64(ks + 16)); }
    store64(ks + 16, 0);
    return 0;
}

# Index of the first byte at or after data[i] that is not JSON whitespace, or
# slen. JSON whitespace is space, TAB, LF and CR (RFC 8259 section 2); the flat
# parser's bare-value scan used to end a value only at space and LF, so TAB and
# CR stayed in it: a CRLF document's last value came back as `0.79\r`, which a
# number parse then refused.
#
# The byte classes in this scanner are BITMAPS, bit c set when byte c is in the
# class: 0x100002600 has bits 9, 10, 13 and 32. A chain of `==` per byte made the
# whole parse 37% slower than 1.5.9's on a 1 MB document (measured); a shift and
# a mask is one test. tests/bayan.tcyr walks all 256 bytes through every class.
fn _json_flat_skip_ws(data, slen, i): i64 {
    var bs: [u8] = 0;
    slice_set(&bs, data, slen);
    while (i < slen) {
        var c = bs[i];
        if (c > 32) { return i; }
        if (((0x100002600 >> c) & 1) == 0) { return i; }
        i = i + 1;
    }
    return i;
}

# Index of the `"` that closes the string whose body starts at data[i], or -1
# when the input ends first.
#
# ESCAPES (fixed in 1.5.1 — this let a value inject object keys).
# The scan used to stop at the first `"` regardless of a preceding
# backslash, so for the perfectly valid document
#
#     {"note":"hi\"there","admin":"false"}
#
# the value of `note` ended at the ESCAPED quote and the parser
# resynchronised mid-value: it produced the pairs [note]=[hi\] and
# [,]=[false], and `admin` vanished entirely. A caller doing
# bayan_json_get(pairs, "admin") to check a permission got a silent
# "not found" that an attacker controls through any string field.
#
# The value bytes are still captured VERBATIM (this flat API does
# not decode escapes — the tagged-tree parser does); the backslash
# only has to stop the quote from terminating the scan. A backslash in the
# LAST byte steps i past slen; the loop test fails before anything is read
# there, so the -1 costs no out-of-bounds load.
fn _json_flat_str_end(data, slen, i): i64 {
    var bs: [u8] = 0;
    slice_set(&bs, data, slen);
    while (i < slen) {
        var c = bs[i];
        if (c == 34) { return i; }
        if (c == 92) { i = i + 1; }
        i = i + 1;
    }
    return 0 - 1;
}

# Index just past the bare value (a number, true, false or null; the bytes are
# not validated) that starts at data[i]: the first JSON whitespace or structural
# byte, or slen. Ending only at `,` `}` and whitespace let `{"a":1"b":2}` hand a
# the value `1"b":2`; no bare value contains `"` `:` `[` `]` `{` or `}`. Which
# byte ended it is the caller's test: only whitespace, `,` or `}` follows a
# whole value, so any other one means the value was cut there.
# 0x0400100500002600: bits 9 10 13 32 34 44 58 (whitespace, `"` `,` `:`);
# 0x2800000028000000: bits 27 29 59 61, i.e. bytes 91 93 123 125 (`[` `]` `{` `}`).
fn _json_flat_bare_end(data, slen, i): i64 {
    var bs: [u8] = 0;
    slice_set(&bs, data, slen);
    while (i < slen) {
        var c = bs[i];
        if (c < 64) {
            if (((0x0400100500002600 >> c) & 1) == 1) { return i; }
        } elif (c < 128) {
            if (((0x2800000028000000 >> (c - 64)) & 1) == 1) { return i; }
        }
        i = i + 1;
    }
    return i;
}

# Index just past the object or array that opens at data[i], or -1 when its end
# cannot be trusted: the input ends inside it, a closer of the wrong kind meets
# an open level, or it nests deeper than the tree parser allows. String-aware, so
# a `}` `]` or `,` inside a string is text.
#
# KINDS ARE MATCHED. Counting depth alone (the first cut of this fix) let a
# wrong-kind closer end the span early and the parse resume inside the value:
# {"meta":{"x":[}],"admin":"true"},"admin":"false"} surfaced meta's `admin` as
# a top-level pair, the shape 1.5.1 closed for strings. `kinds` is a 128-bit
# stack on this frame, one bit per open level (1 = object), so the scan stays
# linear and never recurses: a 100,000-deep `[[[...` is refused at the cap after
# one pass over its first 128 bytes.
fn _json_flat_span_end(data, slen, i): i64 {
    var bs: [u8] = 0;
    slice_set(&bs, data, slen);
    var kinds[16];
    var depth = 0;
    while (i < slen) {
        var c = bs[i];
        if (c == 34) {
            i = _json_flat_str_end(data, slen, i + 1);
            if (i < 0) { return 0 - 1; }
        } elif (c == 123 || c == 91) {
            # `depth` counts the levels open inside this value, and the object
            # holding it is one more: the tree parser's count, whose top-level
            # object is depth 1. So both refuse the same documents. The second
            # test is the stack's own bound: _JP_MAX_DEPTH is a var, and raising
            # it must not let this write past kinds[15].
            # The bound check must stay BEFORE the store below. Moved after it,
            # a raised cap writes one bit into kinds[16] at depth 128 and is
            # refused right after: the same answer, so no test can see it.
            if (depth + 1 >= _JP_MAX_DEPTH || depth >= 128) { return 0 - 1; }
            var kb = &kinds + (depth >> 3);
            var km = 1 << (depth & 7);
            if (c == 123) { store8(kb, load8(kb) | km); }
            else { store8(kb, load8(kb) & (255 - km)); }
            depth = depth + 1;
        } elif (c == 125 || c == 93) {
            depth = depth - 1;
            var open_obj = (load8(&kinds + (depth >> 3)) >> (depth & 7)) & 1;
            var close_obj = 0;
            if (c == 125) { close_obj = 1; }
            if (open_obj != close_obj) { return 0 - 1; }
            if (depth == 0) { return i + 1; }
        }
        i = i + 1;
    }
    return 0 - 1;
}

# Parse a JSON object string into a vec of key-value pairs.
# Handles: {"key": "value", "key2": "value2", "num": 42, "obj": {"a": [1, 2]}}
# Returns vec of json_pair pointers, one per TOP-LEVEL member, in source order,
# or 0 when an allocation is refused, never a partial vec. 1.5.9 checked no
# allocation: it carried on past a refused Str and could hand a shorter vec back
# as success, and a refused growth of the vec ended the process.
# bayan_json_get_by_cstr(0, key) answers 0, as for an absent key.
#
# VALUES ARE THE RAW SOURCE BYTES — escapes are NOT decoded. `\"` stays two
# bytes and `\u00e9` stays six. That is a deliberate split, not an oversight:
# the TAGGED-TREE parser in this same file (bayan_json_v_parse) resolves
# them at parse time, and a caller who needs decoded values should use it.
# The statement of this contract used to live fourteen lines inside this
# function's body, in a historical note, where no caller would ever read it.
#
# A NESTED VALUE IS ONE VALUE (1.5.10). A member whose value is an object or an
# array comes back as its raw source span, brackets included. To reach a member
# inside it, parse the span again: bayan_json_parse(bayan_json_get_by_cstr(pairs, key))
# (a 0 from an absent key gives an empty vec). The scan used to treat `{` and
# `[` as the start of a bare value, cut it at its first `,` `}` space or LF, and
# resume INSIDE it, so nested members surfaced as top-level pairs and the real
# top-level pairs after them were lost: for
# {"meta":{"x":1,"admin":"true"},"admin":"false"},
# bayan_json_get(pairs, "admin") answered "true", from inside meta.
#
# PASS AN OBJECT DOCUMENT. The parse starts at the first `{` BYTE anywhere in the
# source, even one inside a string, and reads members from there. For a document
# whose top level is an array or a string the result is unspecified.
#
# MALFORMED INPUT STOPS THE PARSE (1.5.10). The vec holds the pairs read before
# the first defect it stops on, never one after it. Those defects are:
#   - a key not followed by `:`. The scan used to skip to the NEXT `:` in the
#     document, wherever it was, so the key took the next pair's value;
#   - a `:` not followed by a value. `,` was skipped in every state, so
#     `"a":,"b":2` gave a the value `b`;
#   - a value followed by `:`, which makes it the next KEY: this key had no
#     value, and {"a":"b":2} gave a the value `b`;
#   - a bare value cut by `"` `:` `[` `]` or `{`. Only whitespace, `,` or `}`
#     follows a whole one, and the part before the cut can parse: {"GBP":0.7:9}
#     would give GBP the rate 0.7;
#   - a string or nested value the input ends inside, or a bare value it ends on
#     (`"n":12` may be the start of 123);
#   - a closer of the wrong kind;
#   - where a key belongs, any byte but whitespace, `,`, `"` or `}`.
#
# DEPTH IS CAPPED, AS THE TREE PARSER CAPS IT. A VALID member nested deeper than
# _JP_MAX_DEPTH (128) levels, counting the top-level object (a value that opens
# 128 levels of its own), is refused at that member, as bayan_json_v_parse
# refuses the document (RFC 8259 section 9 allows the limit): that member and
# every member after it are absent. 127 levels inside the value parse. The flat
# scan's own stack holds 128 levels inside a value, so raising _JP_MAX_DEPTH past
# 129 lets the tree parser go deeper but not this one, which then refuses there.
#
# Still tolerated, because none of them can hand a key another key's bytes in an
# object document: bytes before the first `{` and after the `}` that closes it;
# missing, doubled or trailing commas between members; and unvalidated bare
# values (`{"n":abc}` gives n = abc).
#
# A DUPLICATE KEY REFUSES THE DOCUMENT (1.11.1): 0, with "duplicate key" and the
# byte offset of the second one in bayan_json_last_error() / _pos() (a parse that
# returns pairs clears them). Not a stop with the pairs before it: those would be
# the FIRST value, and a last-wins reader of the same bytes acts on the last. The
# keys compare decoded, as the tree parser's do, so {"admin":1,"\u0061dmin":2}
# is refused too; only the top-level object's keys are this parser's to compare.
#
# THE LOOKUPS COMPARE RAW KEYS. A key comes back as its source bytes, escapes as
# written, and bayan_json_get_by_cstr / _by_str compare those bytes: for
# {"\u0061dmin":true} they answer "admin" absent where the tree parser answers it
# present. Do not decide an allowlist or a denylist by a flat lookup of a key a
# peer wrote; parse with bayan_json_v_parse, whose keys are decoded.
#
# Parse one JSON object's top-level members into a vec of raw key/value pairs (0 on a refused alloc).
fn bayan_json_parse(src): i64 {
    return bayan_json_parse_a(default_alloc(), src);
}

# The decoded form of the key whose opening quote is data[kq], to compare it with
# the document's other keys: 0 when it has no escape (its raw bytes are its
# decoded form), the decoded Str, or -1 when `a` refuses the allocation. A key
# whose escapes do not decode (the flat parser does not validate them) compares
# as its raw bytes.
fn _json_flat_key_dec(a, data, slen, kq, ke): i64 {
    var bs: [u8] = 0;
    slice_set(&bs, data, slen);
    var i = kq + 1;
    while (i < ke) {
        if (bs[i] == 92) { break; }
        i = i + 1;
    }
    if (i >= ke) { return 0; }
    var kps[_JP_STATE_SIZE];
    _jp_state_init(&kps, data, slen);
    store64(&kps + 16, kq);
    var d = _jp_parse_string_a(a, &kps);
    if (d != 0) { return d; }
    if (streq(load64(&kps + 24), "out of memory in string") == 1) { return 0 - 1; }
    return 0;
}

# 1.5.10 — Allocator-as-first-arg variant of bayan_json_parse: every allocation
# (the vec, each key and value Str, each pair, each growth of the vec) goes
# through `a`. Returns 0 when `a` refuses any of them, never a partial vec.
#
# Parse like bayan_json_parse, allocating through `a`; 0 if `a` refuses any allocation.
fn bayan_json_parse_a(a, src): i64 {
    var pairs = vec_new_a(a);
    if (pairs == 0) { return 0; }
    _json_err_msg = 0;
    _json_err_pos = 0;
    if (src == 0) { return pairs; }
    var data = str_data(src);
    var slen = str_len(src);
    var bs: [u8] = 0;
    slice_set(&bs, data, slen);
    # The top-level keys so far, decoded: a duplicate refuses the document.
    var kset[_JK_SIZE];
    _jk_init(&kset, a);
    var ji = 0;
    # Skip to the first `{` byte (see PASS AN OBJECT DOCUMENT above).
    while (ji < slen) {
        if (bs[ji] == 123) { ji = ji + 1; break; }
        ji = ji + 1;
    }
    # One member per pass. Every `break` but the `}` one is a defect: it ends the
    # parse with the pairs read so far.
    while (ji < slen) {
        var c = bs[ji];
        # Whitespace or `,`. Space and `,` are tested first: they are most of the
        # bytes between members, and on indented or space-heavy documents the
        # two compares beat the bitmap alone (measured). 0x100100002600 is the
        # whitespace map plus bit 44.
        if (c == 32 || c == 44) { ji = ji + 1; }
        elif ((c < 64) && (((0x100100002600 >> c) & 1) == 1)) { ji = ji + 1; }
        elif (c == 125) { break; }
        elif (c == 34) {
            var ks = ji + 1;
            var ke = _json_flat_str_end(data, slen, ks);
            if (ke < 0) { break; }
            # The key's own `:`, after whitespace — not the next `:` anywhere.
            ji = _json_flat_skip_ws(data, slen, ke + 1);
            if (ji >= slen || bs[ji] != 58) { break; }
            ji = _json_flat_skip_ws(data, slen, ji + 1);
            if (ji >= slen) { break; }
            var vc = bs[ji];
            var vs = ji;
            var ve = 0;
            var vk = JSON_K_BARE;
            if (vc == 34) {
                # A value that never ends is not a value: `{"a":"xyz` used to
                # give a = xyz.
                vs = ji + 1;
                ve = _json_flat_str_end(data, slen, vs);
                if (ve < 0) { break; }
                ji = ve + 1;
                vk = JSON_K_STRING;
            } elif (vc == 123 || vc == 91) {
                ve = _json_flat_span_end(data, slen, ji);
                if (ve < 0) { break; }
                ji = ve;
                vk = JSON_K_ARRAY;
                if (vc == 123) { vk = JSON_K_OBJECT; }
            } else {
                # Empty: the `:` meets `,` `}` `]` or `:`, so there is no value.
                ve = _json_flat_bare_end(data, slen, ji);
                if (ve == ji || ve >= slen) { break; }
                # Cut: bare_end stops only at whitespace (every such byte is
                # <= 32) or a structural byte, and of those only `,` and `}`
                # may follow a whole value.
                var tc = bs[ve];
                if (tc > 32 && tc != 44 && tc != 125) { break; }
                ji = ve;
            }
            # A value followed by `:` was the next KEY: this key had none.
            ji = _json_flat_skip_ws(data, slen, ji);
            if (ji < slen && bs[ji] == 58) { break; }
            var kd = _json_flat_key_dec(a, data, slen, ks - 1, ke);
            if (kd < 0) { return 0; }
            var fresh = 0;
            if (kd == 0) { fresh = _jk_add(&kset, data + ks, ke - ks); }
            else { fresh = _jk_add(&kset, str_data(kd), str_len(kd)); }
            if (fresh < 0) { return 0; }
            if (fresh == 0) {
                _json_err_msg = "duplicate key";
                _json_err_pos = ks - 1;
                return 0;
            }
            var k = str_new_a(a, data + ks, ke - ks);
            if (k == 0) { return 0; }
            var v = str_new_a(a, data + vs, ve - vs);
            if (v == 0) { return 0; }
            var p = bayan_json_pair_new_kind_a(a, k, v, vk);
            if (p == 0) { return 0; }
            if (vec_push_a(a, pairs, p) < 0) { return 0; }
        } else {
            # Where a key belongs. A stray `{` or `[` here used to be stepped
            # over byte by byte, so {"a":1, {"b":2}} surfaced the nested b.
            break;
        }
    }
    _jk_free(&kset);
    return pairs;
}

# Find value by key in parsed JSON: the value Str of the FIRST pair whose key is `key`, or 0 if
# none is. 1.11.0: the name says what the key is. A Str key, compared with its length: _by_str. A
# C string or literal: _by_cstr, whose `key: cstring` makes cyrius warn when a Str is passed. The
# bare bayan_json_get took a Str without saying so, and bayan_toml_get a C string, and each answered
# the other's key type with a silent "not found" (ADR 0014). A null pairs or key is 0.
fn bayan_json_get_by_str(pairs, key: Str): i64 {
    if (pairs == 0) { return 0; }
    if (key == 0) { return 0; }
    var len = vec_len(pairs);
    var gi = 0;
    while (gi < len) {
        var p = vec_get(pairs, gi);
        if (str_eq(bayan_json_key(p), key) == 1) {
            return bayan_json_value(p);
        }
        gi = gi + 1;
    }
    return 0;
}

# bayan_json_get_by_str's twin for a C-string key (1.11.0).
fn bayan_json_get_by_cstr(pairs, key: cstring): i64 {
    if (pairs == 0) { return 0; }
    if (key == 0) { return 0; }
    var len = vec_len(pairs);
    var gi = 0;
    while (gi < len) {
        var p = vec_get(pairs, gi);
        if (str_eq_cstr(bayan_json_key(p), key) == 1) {
            return bayan_json_value(p);
        }
        gi = gi + 1;
    }
    return 0;
}

# The pre-1.11.0 name, which does not say its key is a Str. Same lookup and same answers: it
# forwards to _by_str.
#
# DEPRECATED (1.11.0): use bayan_json_get_by_cstr (C-string key) or bayan_json_get_by_str (Str key).
#deprecated("use bayan_json_get_by_cstr (C-string/literal key) or bayan_json_get_by_str (Str key)")
fn bayan_json_get(pairs, key): i64 { return bayan_json_get_by_str(pairs, key); }

# Get value as integer.
#
# Returns 0 if the key is absent OR the value contains no digits at all.
# It does NOT return 0 for a non-numeric value: str_to_int walks the whole Str
# and silently skips every byte outside 48..57, so "1.5.1" is 151, "1e3" is
# 13, "12abc" is 12 and "v2" is 2. There is no way to detect "not an integer"
# through the return value — the old "0 if not found or not numeric" comment
# invited exactly the sentinel check that never fires.
#
# 1.11.0: _by_str takes a Str key and _by_cstr a C string, as bayan_json_get_by_* do.
fn bayan_json_get_int_by_str(pairs, key: Str): i64 {
    var v = bayan_json_get_by_str(pairs, key);
    if (v == 0) { return 0; }
    return str_to_int(v);
}

# bayan_json_get_int_by_str's twin for a C-string key (1.11.0).
fn bayan_json_get_int_by_cstr(pairs, key: cstring): i64 {
    var v = bayan_json_get_by_cstr(pairs, key);
    if (v == 0) { return 0; }
    return str_to_int(v);
}

# The pre-1.11.0 name. Forwards to _by_str; same answers.
#
# DEPRECATED (1.11.0): use bayan_json_get_int_by_cstr (C-string key) or bayan_json_get_int_by_str (Str key).
#deprecated("use bayan_json_get_int_by_cstr (C-string/literal key) or bayan_json_get_int_by_str (Str key)")
fn bayan_json_get_int(pairs, key): i64 { return bayan_json_get_int_by_str(pairs, key); }

# Build a JSON object from a vec of key-value pairs.
#
# VALID JSON, SAME VALUES (1.7.0 — this quoted everything and escaped nothing).
# Each pair is written by its kind. A JSON_K_TEXT pair (built by hand) has its
# key and value escaped, and the value written as a string, as before. A pair
# from bayan_json_parse is written as it was read: a string's raw body between
# quotes, and a number, true, false, null, object or array as its raw bytes, so
# bayan_json_build(bayan_json_parse(doc)) has doc's members and values. Until
# 1.7.0 {"n":42,"o":{"a":1}} came back as {"n": "42", "o": "{"a":1}"}, the
# second of which is not JSON, and a hand-built value holding `"` or `\` broke
# the document the same way.
#
# A raw byte below 0x20 inside a string, which JSON forbids but the flat parser
# does not refuse, is written as \u00XX, which keeps the value and the output
# valid. Other bytes the flat parser tolerates in a document that is not JSON
# (an unvalidated bare value such as `abc`, an escape JSON does not define) come
# out as they went in.
fn bayan_json_build(pairs): i64 {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{");
    var len = vec_len(pairs);
    var bi = 0;
    while (bi < len) {
        if (bi > 0) { str_builder_add_cstr(sb, ", "); }
        var p = vec_get(pairs, bi);
        var kind = bayan_json_pair_kind(p);
        if (kind == JSON_K_TEXT) {
            _jb_append_string(sb, bayan_json_key(p));
            str_builder_add_cstr(sb, ": ");
            _jb_append_string(sb, bayan_json_value(p));
        } else {
            _json_flat_raw_string(sb, bayan_json_key(p));
            str_builder_add_cstr(sb, ": ");
            if (kind == JSON_K_STRING) { _json_flat_raw_string(sb, bayan_json_value(p)); }
            else { str_builder_add(sb, bayan_json_value(p)); }
        }
        bi = bi + 1;
    }
    str_builder_add_cstr(sb, "}");
    return str_builder_build(sb);
}

# A raw string body from the flat parser, between quotes. Its escapes are
# already JSON's and are copied as they are; a raw byte below 0x20 becomes
# \u00XX, the one change that keeps both the value and the document valid.
fn _json_flat_raw_string(sb, s): i64 {
    str_builder_add_cstr(sb, "\"");
    var data = str_data(s);
    var n = str_len(s);
    var start = 0;
    var i = 0;
    while (i < n) {
        var c = load8(data + i);
        if (c < 32) {
            if (i > start) { str_builder_add(sb, str_new(data + start, i - start)); }
            var hb[8];
            store8(&hb, 92); store8(&hb + 1, 117); store8(&hb + 2, 48); store8(&hb + 3, 48);
            store8(&hb + 4, 48 + (c >> 4));
            var lo = c & 15;
            if (lo < 10) { store8(&hb + 5, 48 + lo); } else { store8(&hb + 5, 87 + lo); }
            store8(&hb + 6, 0);
            str_builder_add_cstr(sb, &hb);
            start = i + 1;
        }
        i = i + 1;
    }
    if (n > start) { str_builder_add(sb, str_new(data + start, n - start)); }
    str_builder_add_cstr(sb, "\"");
    return 0;
}

# Read a whole file into a Str, however large. 0 on open failure.
#
# The fixed-size read buffers these loaders used to carry (16 KiB here, 256 KiB
# in toml) TRUNCATED silently and then reported success: a 52 KB / 2,001-key
# JSON object parsed to 630 pairs with no error, and the cut landed mid-token,
# so the last surviving pair could be a fragment. A str_builder grows, so there
# is no cap left to exceed and no cliff to fall off.
fn _json_slurp(path): Str {
    var fd = file_open(path, 0, 0);
    if (fd < 0) { return 0; }
    var sb = str_builder_new();
    var chunk = alloc(65536);
    if (chunk == 0) { file_close(fd); return 0; }
    loop {
        var n = file_read(fd, chunk, 65536);
        if (n <= 0) { break; }
        else { str_builder_add(sb, str_new(chunk, n)); }
    }
    file_close(fd);
    return str_builder_build(sb);
}

# An empty vec when the file cannot be opened or is empty, and also when the read
# buffer's allocation is refused (_json_slurp gives 0 for both). 0 when an
# allocation INSIDE the parse is refused, as bayan_json_parse returns (1.5.10).
#
# Parse a JSON file into the flat key/value pairs bayan_json_parse returns.
fn bayan_json_parse_file(path): i64 {
    var src = _json_slurp(path);
    if (src == 0) { return vec_new(); }
    if (str_len(src) == 0) { return vec_new(); }
    return bayan_json_parse(src);
}

# v5.8.30 — Result variant of bayan_json_parse_file. Open + read are
# pushed through file_open_r / file_read_r so an underlying
# IoError surfaces as Err(JsonIoErr) instead of being silently
# converted to an empty vec (the back-compat behavior of
# `bayan_json_parse_file`). A refused allocation inside the parse comes back as
# Ok(0), bayan_json_parse's own 0 (1.5.10), not as an Err.
fn bayan_json_parse_file_r(path): i64 {
    var fd_r_tag, fd_r = file_open_r(path, 0, 0);
    if (is_err_result(fd_r_tag) == 1) { return Err(JsonIoErr); }
    var fd = fd_r;
    var sb = str_builder_new();
    var chunk = alloc(65536);
    if (chunk == 0) { sys_close(fd); return Err(JsonIoErr); }
    var total = 0;
    loop {
        var rd_r_tag, rd_r = file_read_r(fd, chunk, 65536);
        if (is_err_result(rd_r_tag) == 1) { sys_close(fd); return Err(JsonIoErr); }
        var n = rd_r;
        if (n <= 0) { break; }
        else {
            str_builder_add(sb, str_new(chunk, n));
            total = total + n;
        }
    }
    sys_close(fd);
    if (total == 0) { return Err(JsonIoErr); }
    return Ok(bayan_json_parse(str_builder_build(sb)));
}

# ======================================================================
# JSON ENGINE (v5.7.20) — Tagged-value tree with full nesting + escapes
# ======================================================================
#
# Stdlib baseline. RPC-grade scope (custom serializers, binary
# extensions, etc.) is owned by sandhi (lib/sandhi.cyr).
#
# Backward compat: the flat key-value API at the top of this file
# (bayan_json_parse, bayan_json_get, bayan_json_get_int, bayan_json_pair_new, bayan_json_key,
# bayan_json_value, bayan_json_build, bayan_json_parse_file) is preserved; its
# scan was hardened at 1.5.10 (a nested value is one value — see bayan_json_parse).
# Existing kybernet / argonaut / libro callers stay green.
#
# The new engine below uses a `json_v_*` prefix and a tagged 24-byte
# heap value:
#
#   +0   tag      u64    JTAG_NULL / BOOL / INT / FLOAT / STR / ARR / OBJ
#   +8   payload  u64    i64 / f64 bits / Str ptr / vec ptr
#   +16  reserved u64    0, with one exception: a JTAG_STR cell bayan_toml_v_parse made from a
#                         TOML date or time holds its TOML_DT_* kind here, which
#                         bayan_toml_v_datetime_kind reads (1.11.0). Nothing in this file reads
#                         the word, and every constructor here writes 0 to it.
#
# Vec contents:
#   ARR: vec<json_v*> — element values in declaration order
#   OBJ: vec<json_v_pair*> — { key: Str, value: json_v* } pairs in order
#
# Strings (STR tag and OBJ keys) are decoded — \" \\ \/ \b \f \n \r \t
# \uXXXX (UTF-8 encoded) are all resolved at parse time. The Str ptr  #skip-lint: \u-escape notation, not a deferral
# holds the decoded byte sequence, not the source-text bytes.
#
# Numbers: parsed as INT if the source has no `.` `e` `E`; else FLOAT.
# Float parsing handles scientific notation `3.14e10` / `1.5E-3`.
#
# Errors: parse failures set _json_err_msg (cstr) and _json_err_pos
# (input byte offset). bayan_json_v_parse* returns 0 on error.

const JTAG_NULL  = 0;
const JTAG_BOOL  = 1;
const JTAG_INT   = 2;
const JTAG_FLOAT = 3;
const JTAG_STR   = 4;
const JTAG_ARR   = 5;
const JTAG_OBJ   = 6;

const JV_SIZE = 24;

# Legacy single-threaded last-error slots. As of v1.0.3 the parser keys off a
# per-call state struct (see "Reentrant parser state" below), so these are
# populated by the globals-compat entry points (bayan_json_v_parse_buf /
# bayan_json_v_parse / bayan_json_stream_parse) AFTER a parse returns, purely so
# bayan_json_last_error()/_pos() keep working for existing single-threaded
# callers. Concurrent parsers must use bayan_json_v_parse_ctx and read the error
# from their own state via bayan_json_state_error()/_pos().
var _json_err_msg = 0;
var _json_err_pos = 0;

# Return the last parse error message (cstr) — set on bayan_json_v_parse* failure.
fn bayan_json_last_error(): i64 {
    if (_json_err_msg == 0) { return ""; }
    return _json_err_msg;
}

# Return the last parse error byte offset — set on bayan_json_v_parse* failure.
fn bayan_json_last_error_pos(): i64 { return _json_err_pos; }

# === Constructors ===

# v5.8.36 — Allocator-as-first-arg internal jv-cell allocator.
# Returns 0 on OOM (caller must check). Used by every json_v_*_new_a
# constructor below.
fn _jv_alloc_a(a, tag): i64 {
    var v = alloc_via(a, JV_SIZE);
    if (v == 0) { return 0; }
    store64(v, tag);
    store64(v + 8, 0);
    store64(v + 16, 0);
    return v;
}

# Internal jv-cell allocator (back-compat wrapper).
fn _jv_alloc(tag): i64 { return _jv_alloc_a(default_alloc(), tag); }

# v5.8.36 — Allocator-as-first-arg variant of bayan_json_v_null.
fn bayan_json_v_null_a(a): i64 { return _jv_alloc_a(a, JTAG_NULL); }

# Create a new JTAG_NULL value. v5.8.36 wrapper.
fn bayan_json_v_null(): i64 { return _jv_alloc(JTAG_NULL); }

# v5.8.36 — Allocator-as-first-arg variant of bayan_json_v_bool_new.
fn bayan_json_v_bool_new_a(a, b): i64 {
    var v = _jv_alloc_a(a, JTAG_BOOL);
    if (v == 0) { return 0; }
    if (b == 0) { store64(v + 8, 0); }
    else        { store64(v + 8, 1); }
    return v;
}

# Create a new JTAG_BOOL value (b is 0 or 1). v5.8.36 wrapper.
fn bayan_json_v_bool_new(b): i64 {
    return bayan_json_v_bool_new_a(default_alloc(), b);
}

# v5.8.36 — Allocator-as-first-arg variant of bayan_json_v_int_new.
fn bayan_json_v_int_new_a(a, n): i64 {
    var v = _jv_alloc_a(a, JTAG_INT);
    if (v == 0) { return 0; }
    store64(v + 8, n);
    return v;
}

# Create a new JTAG_INT value (n is i64). v5.8.36 wrapper.
fn bayan_json_v_int_new(n): i64 {
    return bayan_json_v_int_new_a(default_alloc(), n);
}

# v5.8.36 — Allocator-as-first-arg variant of bayan_json_v_float_new.
fn bayan_json_v_float_new_a(a, f): i64 {
    var v = _jv_alloc_a(a, JTAG_FLOAT);
    if (v == 0) { return 0; }
    store64(v + 8, f);
    return v;
}

# Create a new JTAG_FLOAT value (f is f64 bit pattern). v5.8.36 wrapper.
fn bayan_json_v_float_new(f): i64 {
    return bayan_json_v_float_new_a(default_alloc(), f);
}

# v5.8.36 — Allocator-as-first-arg variant of bayan_json_v_str_new.
fn bayan_json_v_str_new_a(a, s): i64 {
    var v = _jv_alloc_a(a, JTAG_STR);
    if (v == 0) { return 0; }
    store64(v + 8, s);
    return v;
}

# Create a new JTAG_STR value (s is a Str ptr). v5.8.36 wrapper.
fn bayan_json_v_str_new(s): i64 {
    return bayan_json_v_str_new_a(default_alloc(), s);
}

# v5.8.36 — Allocator-as-first-arg variant of bayan_json_v_arr_new.
# Allocates BOTH the jv-cell AND the inner vec via `a`.
fn bayan_json_v_arr_new_a(a): i64 {
    var v = _jv_alloc_a(a, JTAG_ARR);
    if (v == 0) { return 0; }
    var inner = vec_new_a(a);
    if (inner == 0) { return 0; }
    store64(v + 8, inner);
    return v;
}

# Create an empty JTAG_ARR value. v5.8.36 wrapper. Append via
# bayan_json_v_arr_push (use bayan_json_v_arr_push_a if you need the same
# allocator threaded through grows).
fn bayan_json_v_arr_new(): i64 {
    return bayan_json_v_arr_new_a(default_alloc());
}

# v5.8.36 — Allocator-as-first-arg variant of bayan_json_v_obj_new.
# Allocates BOTH the jv-cell AND the inner pairs vec via `a`.
fn bayan_json_v_obj_new_a(a): i64 {
    var v = _jv_alloc_a(a, JTAG_OBJ);
    if (v == 0) { return 0; }
    var inner = vec_new_a(a);
    if (inner == 0) { return 0; }
    store64(v + 8, inner);
    return v;
}

# Create an empty JTAG_OBJ value. v5.8.36 wrapper.
fn bayan_json_v_obj_new(): i64 {
    return bayan_json_v_obj_new_a(default_alloc());
}

# v5.8.36 — Allocator-as-first-arg variant of _jv_pair_new.
fn _jv_pair_new_a(a, key, val): i64 {
    var p = alloc_via(a, 16);
    if (p == 0) { return 0; }
    store64(p, key);
    store64(p + 8, val);
    return p;
}

# A pair is a 16-byte heap struct: { key: Str @ +0, value: json_v* @ +8 }.
# v5.8.36 wrapper.
fn _jv_pair_new(key, val): i64 {
    return _jv_pair_new_a(default_alloc(), key, val);
}

# v5.8.36 — Allocator-as-first-arg variant of bayan_json_v_arr_push.
# Routes any vec-grow through `a`. Returns -1 on grow OOM
# (vs. back-compat which aborts via vec_push).
fn bayan_json_v_arr_push_a(a, arr, val): i64 {
    if (arr == 0) { return 0 - 1; }
    if (load64(arr) != JTAG_ARR) { return 0 - 1; }
    return vec_push_a(a, load64(arr + 8), val);
}

# Append a value to an array. No-op if arr is not JTAG_ARR.
# v5.8.36 wrapper.
fn bayan_json_v_arr_push(arr, val): i64 {
    if (arr == 0) { return 0; }
    if (load64(arr) != JTAG_ARR) { return 0; }
    vec_push(load64(arr + 8), val);
    return 0;
}

# Allocator-as-first-arg variant of bayan_json_v_obj_set. Routes BOTH the
# 16-byte pair cell and any vec-grow through `a`. Returns -1 on a bad object or
# on OOM (vs. back-compat, which returns 0 for a bad object and aborts inside
# vec_push on OOM) — the same contract split bayan_json_v_arr_push_a uses.
#
# This is the last constructor in the value API to get an `_a` form. Without it
# a caller could build every cell of a tree through an arena and still leak the
# pair cells onto the global bump, which is the shape that makes an arena look
# like it is working while the per-request cost stays flat.
fn bayan_json_v_obj_set_a(a, obj, key, val): i64 {
    if (obj == 0) { return 0 - 1; }
    if (load64(obj) != JTAG_OBJ) { return 0 - 1; }
    var p = _jv_pair_new_a(a, key, val);
    if (p == 0) { return 0 - 1; }
    return vec_push_a(a, load64(obj + 8), p);
}

# Append a key/value pair to an object. No-op if obj is not JTAG_OBJ.
# ⚠ `key` is a `Str` and is stored AS a Str — the pair layout is `{ key: Str @ +0, ... }`.
# Look it up with `bayan_json_v_obj_get_by_str` (a Str key) or `_by_cstr` (a C string);
# the bare `bayan_json_v_obj_get` is deprecated because its name says neither. See the
# banner on `_by_cstr` before "making them match".
fn bayan_json_v_obj_set(obj, key, val): i64 {
    if (obj == 0) { return 0; }
    if (load64(obj) != JTAG_OBJ) { return 0; }
    vec_push(load64(obj + 8), _jv_pair_new(key, val));
    return 0;
}

# === Tag predicates ===

# Return the value tag (JTAG_NULL/BOOL/INT/FLOAT/STR/ARR/OBJ), or -1 if v is 0.
fn bayan_json_v_tag(v): i64 {
    if (v == 0) { return 0 - 1; }
    return load64(v);
}

# Tag predicates — true if v has the given tag, else false. All are false on null v.
fn bayan_json_v_is_null(v): bool {
    if (v == 0) { return false; }
    if (load64(v) == JTAG_NULL) { return true; }
    return false;
}
# True if v is a JTAG_BOOL value.
fn bayan_json_v_is_bool(v): bool {
    if (v == 0) { return false; }
    if (load64(v) == JTAG_BOOL) { return true; }
    return false;
}
# True if v is a JTAG_INT value.
fn bayan_json_v_is_int(v): bool {
    if (v == 0) { return false; }
    if (load64(v) == JTAG_INT) { return true; }
    return false;
}
# True if v is a JTAG_FLOAT value.
fn bayan_json_v_is_float(v): bool {
    if (v == 0) { return false; }
    if (load64(v) == JTAG_FLOAT) { return true; }
    return false;
}
# True if v is a JTAG_STR value.
fn bayan_json_v_is_str(v): bool {
    if (v == 0) { return false; }
    if (load64(v) == JTAG_STR) { return true; }
    return false;
}
# True if v is a JTAG_ARR value.
fn bayan_json_v_is_arr(v): bool {
    if (v == 0) { return false; }
    if (load64(v) == JTAG_ARR) { return true; }
    return false;
}
# True if v is a JTAG_OBJ value.
fn bayan_json_v_is_obj(v): bool {
    if (v == 0) { return false; }
    if (load64(v) == JTAG_OBJ) { return true; }
    return false;
}

# === Value accessors (INT/FLOAT coercion) ===

# Return v as i64 (0 or 1) if v is JTAG_BOOL, else 0.
fn bayan_json_v_bool(v): i64 {
    if (v == 0) { return 0; }
    if (load64(v) != JTAG_BOOL) { return 0; }
    return load64(v + 8);
}

# Return v as i64 — coerces JTAG_FLOAT via f64_to. Returns 0 on other tags.
fn bayan_json_v_int(v): i64 {
    if (v == 0) { return 0; }
    var t = load64(v);
    if (t == JTAG_INT) { return load64(v + 8); }
    if (t == JTAG_FLOAT) { return f64_to(load64(v + 8)); }
    return 0;
}

# Return v as f64 bit pattern — coerces JTAG_INT via f64_from. Returns f64_from(0) on other tags.
fn bayan_json_v_float(v): i64 {
    if (v == 0) { return 0; }
    var t = load64(v);
    if (t == JTAG_FLOAT) { return load64(v + 8); }
    if (t == JTAG_INT)   { return f64_from(load64(v + 8)); }
    return f64_from(0);
}

# Return v as Str ptr if v is JTAG_STR, else 0.
fn bayan_json_v_str(v): i64 {
    if (v == 0) { return 0; }
    if (load64(v) != JTAG_STR) { return 0; }
    return load64(v + 8);
}

# === Container accessors ===

# Return array length, or 0 if v is not JTAG_ARR.
fn bayan_json_v_arr_len(v): i64 {
    if (v == 0) { return 0; }
    if (load64(v) != JTAG_ARR) { return 0; }
    return vec_len(load64(v + 8));
}

# Return array element at index i (json_v* or 0 if out of range / wrong tag).
fn bayan_json_v_arr_get(v, i): i64 {
    if (v == 0) { return 0; }
    if (load64(v) != JTAG_ARR) { return 0; }
    var arr = load64(v + 8);
    if (i < 0) { return 0; }
    if (i >= vec_len(arr)) { return 0; }
    return vec_get(arr, i);
}

# Return object pair count, or 0 if v is not JTAG_OBJ.
fn bayan_json_v_obj_len(v): i64 {
    if (v == 0) { return 0; }
    if (load64(v) != JTAG_OBJ) { return 0; }
    return vec_len(load64(v + 8));
}

# Return the n-th object key (Str ptr or 0 if out of range / wrong tag).
fn bayan_json_v_obj_key(v, i): i64 {
    if (v == 0) { return 0; }
    if (load64(v) != JTAG_OBJ) { return 0; }
    var pairs = load64(v + 8);
    if (i < 0) { return 0; }
    if (i >= vec_len(pairs)) { return 0; }
    return load64(vec_get(pairs, i));
}

# Return the n-th object value (json_v* or 0 if out of range / wrong tag).
fn bayan_json_v_obj_val(v, i): i64 {
    if (v == 0) { return 0; }
    if (load64(v) != JTAG_OBJ) { return 0; }
    var pairs = load64(v + 8);
    if (i < 0) { return 0; }
    if (i >= vec_len(pairs)) { return 0; }
    return load64(vec_get(pairs, i) + 8);
}

# === Object lookup: the caller states the key type (1.5.10) ===
#
# `bayan_json_v_obj_set` STORES a `Str` key. A lookup can be handed a `Str` or a C string,
# and cyrius passes both as the same i64, so only the CALLEE'S NAME can say which one it
# reads. Hence two explicitly-typed lookups and a deprecated bare name:
#
#     bayan_json_v_obj_get_by_cstr(o, "name")             # a literal / NUL-terminated char*
#     bayan_json_v_obj_get_by_str(o, str_from("name"))    # a Str
#     bayan_json_v_obj_get(o, "name")                     # DEPRECATED: warns, same answer
#
# All three answer the FIRST pair whose key matches (obj_set appends, so a repeated key is a
# second pair), and 0 for a null or non-object `v` or a null `key`.
#
# ⛔ WHY DEPRECATE THE BARE NAME instead of fixing it (issue 2026-08-04):
#
#   - 1.4.1 annotated the key `: cstring` so cyrius's Str-to-cstring diagnostic would catch
#     a Str key. It catches only a NAMED Str-typed local or parameter, and not in a tail
#     call `return f(o, s)` (one with an integer-literal argument is re-routed through the
#     ordinary call path and does warn): it types the argument's first identifier, never
#     a call's result, so
#     `bayan_json_v_obj_get(o, str_from("k"))` — the filed repro's own spelling — compiles
#     with ZERO warnings and returns 0, "not found". So do a `Str` global, a `: Str` field
#     and `return bayan_json_v_obj_get(o, s)` (all re-measured on cyrius 6.6.12, x86_64
#     and aarch64). A cyrius-side gap.
#   - cyrius's overload routing (`foo(Str, ..)` -> `foo_str`) keys on the FIRST argument
#     only. The key is the SECOND, so no `_str` sibling can route on it.
#   - The filing's rename (the bare name takes a `Str`, `_cstr` takes the C string) was
#     rejected in 1.4.1 and again here: renaming the bare name to a Str key would silently
#     break every caller passing a non-literal C string (a cstr variable, a `vec_get`
#     result). Each would keep compiling and break worse than today: `str_len` on a raw C
#     string reads its characters 8..15 as the length and characters 0..7 as the pointer.
#   - `#deprecated` warns at every call site of the bare name WHATEVER the argument is, so
#     it reaches the inline `str_from(..)` spelling the type check cannot see, and it
#     changes nothing at run time: the deprecated names forward to `_by_cstr` and answer
#     exactly as before. Measured on 6.6.12: a plain, statement, tail (`return f(..)`),
#     nested-argument or top-level call warns. Three shapes do NOT: a call through
#     `&bayan_json_v_obj_get`, a method-dot call (`j.obj_get(..)` on a struct named
#     `json_v` reaches the `json_v_obj_get` alias), and a call the compiler parses before
#     the definition (an include ordered after its user). scripts/consumer-check.sh
#     compiles calls of both deprecated names against every bundle that carries them and
#     checks each warning and its exact message, so the attribute cannot silently fall out
#     of `cyrius distlib` or a future toolchain; it also refuses any call of them in src/
#     or dist/, where one parsed before the definition would not warn.
#   - The deprecation flags the bare name's call sites; it does not widen the diagnostic.
#     `_by_cstr` has exactly the old name's reach: a Str-returning call, a Str global or a
#     `: Str` field passed to it compiles with no warning. A call holding a `Str` key moves
#     to `_by_str`, however the key is spelled.

# bayan_json_v_obj_get_by_cstr — 1.5.10. The body is the pre-1.5.10 `bayan_json_v_obj_get`
# plus a null-key guard: a null `key` reached `strlen(0)` and died of SIGSEGV; it returns 0.
#
# ⛔ PASS A C STRING, NUL-terminated where the key ends. obj_set stores a `Str`, and cyrius
# is i64-everywhere, so a `Str` here still compiles: `strlen` walks the 16-byte header, stops
# a few bytes in on the data pointer's zero high bytes, and yields a junk length — the
# compare misses and this returns 0, a SILENT WRONG ANSWER that then SIGSEGVs downstream
# when the caller does `bayan_json_v_str(0)` -> `str_len(0)`. A Str's data pointer is no
# better: a Str is not NUL-terminated at its length (str_sub, str_split and str_new borrow
# their parent's bytes), so `strlen` runs past the key and the lookup can match a LONGER
# stored key — another pair's value. A `Str` key goes to `_by_str`, below.
#
# `: cstring` arms cyrius's Str-to-cstring diagnostic for a named Str-typed local (see the
# banner for the shapes it cannot see) and makes a non-zero integer-literal key a compile
# error. It changes no answer: bayan's build is byte-identical with and without it
# (re-measured on 6.6.12). scripts/consumer-check.sh pins both diagnostics on this name.
#
# The `_cstr` suffix is a cyrius overload-slot suffix, like `_str`. It is inert here for
# two independent reasons, each measured on 6.6.12: the base it would attach to,
# `bayan_json_v_obj_get_by`, does not exist (CI forbids defining it), and the compiler
# registers `_cstr` siblings but never reads that slot when dispatching a call.
#
# Look up an object member by NUL-terminated C-string key: the first match's json_v*, or 0.
fn bayan_json_v_obj_get_by_cstr(v, key: cstring): i64 {
    if (v == 0) { return 0; }
    if (key == 0) { return 0; }
    if (load64(v) != JTAG_OBJ) { return 0; }
    var pairs = load64(v + 8);
    var n = vec_len(pairs);
    var klen = strlen(key);
    var i = 0;
    while (i < n) {
        var p = vec_get(pairs, i);
        var ks = load64(p);
        if (str_len(ks) == klen) {
            if (memeq(str_data(ks), key, klen) == 1) {
                return load64(p + 8);
            }
        }
        i = i + 1;
    }
    return 0;
}

# bayan_json_v_obj_get — the pre-1.5.10 name, which does not say what the key is. Same lookup
# and same answers (it forwards to `_by_cstr`, null-key guard included); only the call site's
# warning is new. Keeps `key: cstring` so the named-Str-local diagnostic still fires where
# callers have not migrated yet.
#
# DEPRECATED (1.5.10): use bayan_json_v_obj_get_by_cstr (C-string key) or bayan_json_v_obj_get_by_str (Str key).
#deprecated("use bayan_json_v_obj_get_by_cstr for a C-string/literal key, bayan_json_v_obj_get_by_str for a Str key")
fn bayan_json_v_obj_get(v, key: cstring): i64 { return bayan_json_v_obj_get_by_cstr(v, key); }

# bayan_json_v_obj_get_by_str — matches what `bayan_json_v_obj_set` stores. bayan 1.4.1. The
# null-key guard is 1.5.10: a null `key` reached `str_data(0)` and died of SIGSEGV.
#
# ⚠ NOT named `..._obj_get_str`: a trailing `_str` is a RESERVED cyrius overload slot —
# defining `<base>_str` makes the compiler reroute every `<base>(Str, ..)` call of matching
# arity to it — and `bayan_json_v_obj_get` is a live base. `_by_` keeps both typed lookups
# off any base that exists.
#
# Look up an object member by Str key (what obj_set stores): the first match's json_v*, or 0.
fn bayan_json_v_obj_get_by_str(v, key: Str): i64 {
    if (v == 0) { return 0; }
    if (key == 0) { return 0; }
    if (load64(v) != JTAG_OBJ) { return 0; }
    return _jp_obj_lookup(v, str_data(key), str_len(key));
}

# === Reentrant parser state (v1.0.3) ===
#
# The recursive-descent value parser and the streaming parser both key off a
# per-call state struct threaded as their first argument — NOT module globals —
# so two threads can parse concurrently without clobbering each other's cursor.
# (Pre-1.0.3 this was a process-global _jp_buf/_jp_len/_jp_pos triplet; a second
# parse reset it mid-descent through the first. See
# docs/development/issues/archived/2026-06-23-thoth-json-value-parser-global-cursor-not-thread-safe.md.)
#
# The state is _JP_STATE_SIZE bytes and may be stack- or heap-allocated by the
# caller; the globals-compat wrappers stack-allocate it, so existing callers are
# unaffected and become concurrency-safe. Node allocation still flows through the
# json_v_*_new constructors' default_alloc() — the filed race is the cursor, not
# the node arena (use a thread-safe / thread-local allocator for concurrent node
# allocation).
#
# Layout:
#   +0   buf      cstr   input pointer        (invariant during a parse)
#   +8   len      i64    input length         (invariant during a parse)
#   +16  pos      i64    current byte offset   (advanced through the descent)
#   +24  err_msg  cstr   parse-error message, or 0
#   +32  err_pos  i64    byte offset of the parse error
#   +40  depth    i64    open-container count  (bounds recursion, cap _JP_MAX_DEPTH)
#
# A `const` (1.5.13), so bayan's own stack states are sized by it — `var
# ps[_JP_STATE_SIZE]` — instead of a hand-copied 48 at each site.
const _JP_STATE_SIZE = 48;

# Recursion-depth cap shared by both descents (value + streaming). 128 matches
# serde_json's default, so Rust→Cyrius ports keep wire parity: a deeper
# document fails the parse with "nesting too deep" through the normal per-call
# error path instead of overflowing the caller's stack (a hostile `[[[[…` body
# costs 2 bytes per level, so any untrusted input can otherwise out-recurse any
# thread stack). See
# docs/development/issues/archived/2026-07-16-agnosai-json-no-recursion-depth-cap.md.
var _JP_MAX_DEPTH = 128;

# Initialise a parser state over (buf, len). pos = 0, error cleared, depth 0.
fn _jp_state_init(ps, buf, len): i64 {
    store64(ps,      buf);
    store64(ps + 8,  len);
    store64(ps + 16, 0);
    store64(ps + 24, 0);
    store64(ps + 32, 0);
    store64(ps + 40, 0);
    return 0;
}

# Record a parse error (message + byte offset) into the per-call state. `pos` is
# passed explicitly because the hot scanners keep the cursor in a local.
fn _jp_set_err(ps, msg, pos): i64 {
    store64(ps + 24, msg);
    store64(ps + 32, pos);
    return 0;
}

# Skip whitespace (space, tab, LF, CR). Advances ps's cursor.
fn _jp_skip_ws(ps): i64 {
    var buf = load64(ps);
    var len = load64(ps + 8);
    var bs: [u8] = 0;
    slice_set(&bs, buf, len);
    var pos = load64(ps + 16);
    while (pos < len) {
        var c = bs[pos];
        if (c == 32 || c == 9 || c == 10 || c == 13) { pos = pos + 1; }
        else { store64(ps + 16, pos); return 0; }
    }
    store64(ps + 16, pos);
    return 0;
}

# 1 when buf[at, at + n) holds the n bytes of the literal `w`. The caller has
# checked at + n <= len; the slice turns a wrong check into a trap, not a read
# past the input (6.7.18 D1, below).
fn _jp_word(buf, len, at, w, n): i64 {
    var bs: [u8] = 0;
    slice_set(&bs, buf, len);
    var i = 0;
    while (i < n) {
        if (bs[at + i] != load8(w + i)) { return 0; }
        i = i + 1;
    }
    return 1;
}

# Decode a hex digit (returns -1 if not a hex digit).
fn _jp_hex(c): i64 {
    if (c >= 48) { if (c <= 57)  { return c - 48; } }
    if (c >= 97) { if (c <= 102) { return c - 87; } }
    if (c >= 65) { if (c <= 70)  { return c - 55; } }
    return 0 - 1;
}

# Encode codepoint cp as UTF-8 into dst; return bytes written (1..4).
# Caller handles surrogate pairs before calling.
fn _jp_emit_utf8(dst, cp): i64 {
    if (cp < 128)    { store8(dst, cp); return 1; }
    if (cp < 2048)   {
        store8(dst, 192 | (cp >> 6));
        store8(dst + 1, 128 | (cp & 63));
        return 2;
    }
    if (cp < 65536)  {
        store8(dst, 224 | (cp >> 12));
        store8(dst + 1, 128 | ((cp >> 6) & 63));
        store8(dst + 2, 128 | (cp & 63));
        return 3;
    }
    store8(dst, 240 | (cp >> 18));
    store8(dst + 1, 128 | ((cp >> 12) & 63));
    store8(dst + 2, 128 | ((cp >> 6) & 63));
    store8(dst + 3, 128 | (cp & 63));
    return 4;
}

# Allocator-as-first-arg variant of _jp_parse_string. Returns Str* or 0.
#
# Parse a JSON string starting at the opening quote. Returns Str* or 0.
# On entry, ps's cursor points at the `"`. On success it points just past the
# closing `"`. The cursor is kept in a local for the hot scan loop and written
# back to ps only on success (error paths abort the whole parse).
fn _jp_parse_string_a(a, ps): i64 {
    var buf = load64(ps);
    var len = load64(ps + 8);
    var bs: [u8] = 0;
    slice_set(&bs, buf, len);
    var pos = load64(ps + 16);
    if (pos >= len) { _jp_set_err(ps, "unexpected EOF in string", pos); return 0; }
    if (bs[pos] != 34) { _jp_set_err(ps, "expected string", pos); return 0; }
    pos = pos + 1;
    # Size the buffer from THIS STRING'S span, not from the rest of the
    # document (1.5.1 — this was a quadratic memory blowup).
    #
    # `cap = len - pos + 1` used the whole remaining document length, so every
    # string in a document allocated ~(document size) bytes and nothing is ever
    # freed on a bump allocator. Measured on `["a","a",...]`: 40 KB of input
    # took 200 MB of heap, and 1 MB of input took 125 GB / 46 GB RSS. Both
    # parsers share this helper, so the STREAMING parser — whose entire stated
    # purpose is bounded memory for multi-MB input — was the most quadratic
    # path in the module.
    #
    # A pre-scan for the closing quote costs one extra linear pass per string,
    # so the parse stays O(n) overall while memory drops to O(sum of string
    # lengths). Decoding never expands: an escape is at least 2 raw bytes for 1
    # out, \uXXXX is 6 raw for at most 3 out, and a surrogate pair is 12 raw  #skip-lint: \u-escape notation, not a deferral
    # for 4 — so the raw span is always a sufficient cap.
    var scan = pos;
    while (scan < len) {
        var sc = bs[scan];
        if (sc == 34) { break; }
        # Consume the backslash AND the byte it escapes, so an escaped quote
        # does not end the scan. A trailing lone backslash pushes scan past
        # len and is caught by the check below.
        if (sc == 92) { scan = scan + 1; }
        scan = scan + 1;
    }
    if (scan >= len) { _jp_set_err(ps, "unterminated string", pos); return 0; }
    var cap = scan - pos + 1;
    var out = alloc_via(a, cap + 4);
    # 1.4.0: an arena can genuinely run dry here; the pre-1.4.0 body used the
    # global bump and never checked, so a 0 would have been written through.
    if (out == 0) { _jp_set_err(ps, "out of memory in string", pos); return 0; }
    var oi = 0;
    while (1 == 1) {
        if (pos >= len) { _jp_set_err(ps, "unterminated string", pos); return 0; }
        var c = bs[pos];
        if (c == 34) { pos = pos + 1; store64(ps + 16, pos); store8(out + oi, 0); return str_new_a(a, out, oi); }
        if (c == 92) {
            # Escape sequence
            pos = pos + 1;
            if (pos >= len) { _jp_set_err(ps, "unterminated escape", pos); return 0; }
            var e = bs[pos];
            pos = pos + 1;
            if      (e == 34)  { store8(out + oi,  34); oi = oi + 1; }
            elif    (e == 92)  { store8(out + oi,  92); oi = oi + 1; }
            elif    (e == 47)  { store8(out + oi,  47); oi = oi + 1; }
            elif    (e == 98)  { store8(out + oi,   8); oi = oi + 1; }
            elif    (e == 102) { store8(out + oi,  12); oi = oi + 1; }
            elif    (e == 110) { store8(out + oi,  10); oi = oi + 1; }
            elif    (e == 114) { store8(out + oi,  13); oi = oi + 1; }
            elif    (e == 116) { store8(out + oi,   9); oi = oi + 1; }
            elif    (e == 117) {
                if (pos + 3 >= len) { _jp_set_err(ps, "\\u needs 4 hex digits", pos); return 0; }
                var d0 = _jp_hex(bs[pos]);
                var d1 = _jp_hex(bs[pos + 1]);
                var d2 = _jp_hex(bs[pos + 2]);
                var d3 = _jp_hex(bs[pos + 3]);
                if (d0 < 0 || d1 < 0 || d2 < 0 || d3 < 0) { _jp_set_err(ps, "\\u: bad hex digit", pos); return 0; }
                pos = pos + 4;
                var cp = (d0 << 12) | (d1 << 8) | (d2 << 4) | d3;
                # Surrogate pair handling
                if (cp >= 0xD800 && cp <= 0xDBFF) {
                    # High surrogate — expect low surrogate next
                    if (pos + 5 >= len) { _jp_set_err(ps, "incomplete surrogate pair", pos); return 0; }
                    if (bs[pos] != 92 || bs[pos + 1] != 117) {
                        _jp_set_err(ps, "expected low surrogate after high", pos);
                        return 0;
                    }
                    pos = pos + 2;
                    var l0 = _jp_hex(bs[pos]);
                    var l1 = _jp_hex(bs[pos + 1]);
                    var l2 = _jp_hex(bs[pos + 2]);
                    var l3 = _jp_hex(bs[pos + 3]);
                    if (l0 < 0 || l1 < 0 || l2 < 0 || l3 < 0) {
                        _jp_set_err(ps, "low surrogate: bad hex", pos); return 0;
                    }
                    pos = pos + 4;
                    var lo = (l0 << 12) | (l1 << 8) | (l2 << 4) | l3;
                    if (lo < 0xDC00 || lo > 0xDFFF) { _jp_set_err(ps, "invalid low surrogate", pos); return 0; }
                    cp = 0x10000 + ((cp - 0xD800) << 10) + (lo - 0xDC00);
                }
                elif (cp >= 0xDC00 && cp <= 0xDFFF) {
                    _jp_set_err(ps, "unexpected low surrogate", pos);
                    return 0;
                }
                oi = oi + _jp_emit_utf8(out + oi, cp);
            }
            else { _jp_set_err(ps, "unknown escape sequence", pos); return 0; }
        }
        else {
            # Ordinary byte
            store8(out + oi, c);
            oi = oi + 1;
            pos = pos + 1;
        }
    }
    return 0;
}

# Parse a JSON string starting at the opening quote. Returns Str* or 0.
# Back-compat wrapper over the allocator-threaded form.
fn _jp_parse_string(ps): i64 {
    return _jp_parse_string_a(default_alloc(), ps);
}

# The extent of the JSON number at ps's cursor, which it does not move: the index
# just past it, or -1 with the error recorded. RFC 8259 section 6's grammar,
#   -?(0|[1-9][0-9]*)(\.[0-9]+)?([eE][+-]?[0-9]+)?
# so a sign alone, a fraction or exponent with no digits, and a leading zero
# before another digit are each refused by name. out+0 gets 1 for a fraction or
# an exponent, out+8 the index just past the integer part.
#
# ONE SCANNER FOR BOTH DESCENTS (1.11.1). 1.5.1 fixed the tree parser's copy
# (digitless parts, i64 range) and the streaming parser kept its own laxer one:
# [-] reached on_int as 0, [18446744073709551616] as 0 and [9223372036854775808]
# as INT64_MIN, each with success. A leading zero (`01`), which both accepted, is
# refused too (the user's decision at the 6.7.18 audit).
fn _jp_scan_number(ps, out): i64 {
    var buf = load64(ps);
    var len = load64(ps + 8);
    var bs: [u8] = 0;
    slice_set(&bs, buf, len);
    var pos = load64(ps + 16);
    var start = pos;
    store64(out, 0);
    if (pos < len && bs[pos] == 45) { pos = pos + 1; }
    var int_start = pos;
    while (pos < len) {
        var c = bs[pos];
        if (c >= 48 && c <= 57) { pos = pos + 1; }
        else { break; }
    }
    if (pos == int_start) { _jp_set_err(ps, "expected number", start); return 0 - 1; }
    if (pos - int_start > 1 && bs[int_start] == 48) {
        _jp_set_err(ps, "a number may not have a leading zero", start);
        return 0 - 1;
    }
    store64(out + 8, pos);
    if (pos < len && bs[pos] == 46) {
        store64(out, 1);
        pos = pos + 1;
        var frac_start = pos;
        while (pos < len) {
            var c2 = bs[pos];
            if (c2 >= 48 && c2 <= 57) { pos = pos + 1; }
            else { break; }
        }
        if (pos == frac_start) { _jp_set_err(ps, "expected digits after the decimal point", pos); return 0 - 1; }
    }
    if (pos < len) {
        var ec = bs[pos];
        if (ec == 101 || ec == 69) {
            store64(out, 1);
            pos = pos + 1;
            if (pos < len) {
                var sg = bs[pos];
                if (sg == 43 || sg == 45) { pos = pos + 1; }
            }
            var exp_start = pos;
            while (pos < len) {
                var c3 = bs[pos];
                if (c3 >= 48 && c3 <= 57) { pos = pos + 1; }
                else { break; }
            }
            if (pos == exp_start) { _jp_set_err(ps, "expected digits in the exponent", pos); return 0 - 1; }
        }
    }
    return pos;
}

# Allocator-as-first-arg variant of _jp_parse_number.
#
# Parse a number (_jp_scan_number's grammar). Returns json_v* (INT or FLOAT) or
# 0. The cursor is written back before the (allocating) constructor call.
fn _jp_parse_number_a(a, ps): i64 {
    var buf = load64(ps);
    var start = load64(ps + 16);
    var nb: i64[2];
    var pos = _jp_scan_number(ps, &nb);
    if (pos < 0) { return 0; }
    store64(ps + 16, pos);
    if (load64(&nb) == 1) {
        var fbits = _jp_atof(buf + start, pos - start);
        var fv2 = bayan_json_v_float_new_a(a, fbits);
        if (fv2 == 0) { _jp_set_err(ps, "out of memory building a number", start); }
        return fv2;
    }
    # RANGE (1.5.1). _jp_atoi accumulates with `n * 10 + d` and wraps silently,
    # so 9223372036854775808 came back as -9223372036854775808 — a value whose
    # SIGN differs from the document's, round-tripping out of the serialiser as
    # a different number with no error. An integer bayan cannot represent is
    # now a parse error rather than a plausible wrong answer.
    if (_jp_int_fits(buf + start, load64(&nb + 8) - start) == 0) {
        _jp_set_err(ps, "integer is out of range for i64", start);
        return 0;
    }
    var iv = _jp_atoi(buf + start, pos - start);
    var ivv = bayan_json_v_int_new_a(a, iv);
    if (ivv == 0) { _jp_set_err(ps, "out of memory building a number", start); }
    return ivv;
}

# Parse a number. Back-compat wrapper over the allocator-threaded form.
fn _jp_parse_number(ps): i64 {
    return _jp_parse_number_a(default_alloc(), ps);
}

# Parse a signed integer from buf[0..len). Returns i64.
# 1 when the decimal integer in buf[0..len) fits in an i64, else 0.
# `len` covers an optional leading '-' and the integer digits only.
#
# Compares by DIGIT COUNT then lexically against the i64 bound, because the
# obvious check — accumulate and see if it went negative — is exactly the
# wrapping this exists to detect.
fn _jp_int_fits(buf, len): i64 {
    var bs: [u8] = 0;
    slice_set(&bs, buf, len);
    var i = 0;
    var neg = 0;
    if (len > 0 && bs[0] == 45) { neg = 1; i = 1; }
    # Leading zeros do not count toward magnitude.
    while (i < len && bs[i] == 48) { i = i + 1; }
    var digits = len - i;
    if (digits < 19) { return 1; }
    if (digits > 19) { return 0; }
    var bound = "9223372036854775807";
    if (neg == 1) { bound = "9223372036854775808"; }
    var k = 0;
    while (k < 19) {
        var d = bs[i + k];
        var b = load8(bound + k);
        if (d < b) { return 1; }
        if (d > b) { return 0; }
        k = k + 1;
    }
    return 1;
}

fn _jp_atoi(buf, len): i64 {
    var bs: [u8] = 0;
    slice_set(&bs, buf, len);
    var i = 0;
    var sign = 1;
    if (len > 0 && bs[0] == 45) { sign = 0 - 1; i = 1; }
    var n = 0;
    while (i < len) {
        n = n * 10 + (bs[i] - 48);
        i = i + 1;
    }
    return sign * n;
}

# Parse a float from buf[0..len). Returns f64 bit pattern.
# Handles signed mantissa, optional fraction, optional signed exponent.
# v1.2.1: delegates to the correctly-rounded, DoS-safe parser in dtoa.cyr. The
# old body accumulated digits in f64 (imprecise, disagreed with math f64_parse by
# 1 ULP) and applied the exponent as a loop of once-per-unit-of-exponent-VALUE
# f64 muls (O(exp) -> a 17-byte "1e100000000" burned ~237 ms). See dtoa.cyr.
fn _jp_atof(buf, len): i64 { return bayan_f64_parse(buf, len); }

# === Main parse entry ===

# Allocator-as-first-arg variant of _jp_parse_value.
#
# Recursive value parser. Returns json_v* or 0. The structural parsers cross
# sub-parser call boundaries, so they read/advance the cursor directly in ps
# (ps + 16) rather than caching it — no local/state desync is possible.
fn _jp_parse_value_a(a, ps): i64 {
    _jp_skip_ws(ps);
    var buf = load64(ps);
    var len = load64(ps + 8);
    var bs: [u8] = 0;
    slice_set(&bs, buf, len);
    var pos = load64(ps + 16);
    if (pos >= len) { _jp_set_err(ps, "unexpected EOF", pos); return 0; }
    var c = bs[pos];
    if (c == 123 || c == 91) {
        # Containers recurse — bound the descent before entering (scalars can't
        # recurse, so only these two branches touch the depth counter).
        var depth = load64(ps + 40);
        if (depth >= _JP_MAX_DEPTH) { _jp_set_err(ps, "nesting too deep", pos); return 0; }
        store64(ps + 40, depth + 1);
        var v = 0;
        if (c == 123) { v = _jp_parse_object_a(a, ps); }
        else          { v = _jp_parse_array_a(a, ps); }
        store64(ps + 40, depth);
        return v;
    }
    if (c == 34)  {
        var s = _jp_parse_string_a(a, ps);
        if (s == 0) { return 0; }
        # A constructor returns 0 on OOM. Handing that back bare is
        # indistinguishable from a parse failure and leaves err_msg EMPTY, so
        # the caller sees "parse returned 0" with nothing to report (1.5.1 —
        # measured on a real arena: of 31 capacities that failed a "[1,2,3]"
        # parse, 9 reported no error at all). Every scalar arm now names it.
        var sv = bayan_json_v_str_new_a(a, s);
        if (sv == 0) { _jp_set_err(ps, "out of memory building a string value", pos); }
        return sv;
    }
    if (c == 116) {
        if (pos + 3 < len && _jp_word(buf, len, pos + 1, "rue", 3) == 1) {
            store64(ps + 16, pos + 4);
            var tv = bayan_json_v_bool_new_a(a, 1);
            if (tv == 0) { _jp_set_err(ps, "out of memory building a boolean", pos); }
            return tv;
        }
        _jp_set_err(ps, "expected 'true'", pos); return 0;
    }
    if (c == 102) {
        if (pos + 4 < len && _jp_word(buf, len, pos + 1, "alse", 4) == 1) {
            store64(ps + 16, pos + 5);
            var fv = bayan_json_v_bool_new_a(a, 0);
            if (fv == 0) { _jp_set_err(ps, "out of memory building a boolean", pos); }
            return fv;
        }
        _jp_set_err(ps, "expected 'false'", pos); return 0;
    }
    if (c == 110) {
        if (pos + 3 < len && _jp_word(buf, len, pos + 1, "ull", 3) == 1) {
            store64(ps + 16, pos + 4);
            var nv = bayan_json_v_null_a(a);
            if (nv == 0) { _jp_set_err(ps, "out of memory building null", pos); }
            return nv;
        }
        _jp_set_err(ps, "expected 'null'", pos); return 0;
    }
    if (c == 45 || (c >= 48 && c <= 57)) {
        return _jp_parse_number_a(a, ps);
    }
    _jp_set_err(ps, "unexpected character", pos);
    return 0;
}

# Recursive value parser. Back-compat wrapper over the allocator-threaded form.
fn _jp_parse_value(ps): i64 {
    return _jp_parse_value_a(default_alloc(), ps);
}

# Allocator-as-first-arg variant of _jp_parse_array.
fn _jp_parse_array_a(a, ps): i64 {
    var buf = load64(ps);
    var len = load64(ps + 8);
    var bs: [u8] = 0;
    slice_set(&bs, buf, len);
    if (bs[load64(ps + 16)] != 91) { _jp_set_err(ps, "expected '['", load64(ps + 16)); return 0; }
    store64(ps + 16, load64(ps + 16) + 1);
    var arr = bayan_json_v_arr_new_a(a);
    if (arr == 0) { _jp_set_err(ps, "out of memory in array", load64(ps + 16)); return 0; }
    _jp_skip_ws(ps);
    if (load64(ps + 16) < len && bs[load64(ps + 16)] == 93) {
        store64(ps + 16, load64(ps + 16) + 1);
        return arr;
    }
    while (1 == 1) {
        var v = _jp_parse_value_a(a, ps);
        if (v == 0) { return 0; }
        if (bayan_json_v_arr_push_a(a, arr, v) != 0) {
            _jp_set_err(ps, "out of memory in array", load64(ps + 16)); return 0;
        }
        _jp_skip_ws(ps);
        if (load64(ps + 16) >= len) { _jp_set_err(ps, "unterminated array", load64(ps + 16)); return 0; }
        var c = bs[load64(ps + 16)];
        if (c == 44) { store64(ps + 16, load64(ps + 16) + 1); _jp_skip_ws(ps); }
        elif (c == 93) { store64(ps + 16, load64(ps + 16) + 1); return arr; }
        else { _jp_set_err(ps, "expected ',' or ']'", load64(ps + 16)); return 0; }
    }
    return 0;
}

# Back-compat wrapper over the allocator-threaded form.
fn _jp_parse_array(ps): i64 {
    return _jp_parse_array_a(default_alloc(), ps);
}

# Allocator-as-first-arg variant of _jp_parse_object.
fn _jp_parse_object_a(a, ps): i64 {
    var buf = load64(ps);
    var len = load64(ps + 8);
    var bs: [u8] = 0;
    slice_set(&bs, buf, len);
    if (bs[load64(ps + 16)] != 123) { _jp_set_err(ps, "expected '{'", load64(ps + 16)); return 0; }
    store64(ps + 16, load64(ps + 16) + 1);
    var obj = bayan_json_v_obj_new_a(a);
    if (obj == 0) { _jp_set_err(ps, "out of memory in object", load64(ps + 16)); return 0; }
    _jp_skip_ws(ps);
    if (load64(ps + 16) < len && bs[load64(ps + 16)] == 125) {
        store64(ps + 16, load64(ps + 16) + 1);
        return obj;
    }
    # The object's keys so far: a duplicate is refused (1.11.1; see the key set).
    var ks[_JK_SIZE];
    _jk_init(&ks, a);
    while (1 == 1) {
        _jp_skip_ws(ps);
        var kpos = load64(ps + 16);
        var k = _jp_parse_string_a(a, ps);
        if (k == 0) { return 0; }
        var fresh = _jk_add(&ks, str_data(k), str_len(k));
        if (fresh == 0) { _jp_set_err(ps, "duplicate key", kpos); return 0; }
        if (fresh < 0) { _jp_set_err(ps, "out of memory in object", kpos); return 0; }
        _jp_skip_ws(ps);
        if (load64(ps + 16) >= len) { _jp_set_err(ps, "unterminated object", load64(ps + 16)); return 0; }
        if (bs[load64(ps + 16)] != 58) {
            _jp_set_err(ps, "expected ':' after key", load64(ps + 16)); return 0;
        }
        store64(ps + 16, load64(ps + 16) + 1);
        _jp_skip_ws(ps);
        var val = _jp_parse_value_a(a, ps);
        if (val == 0) { return 0; }
        if (bayan_json_v_obj_set_a(a, obj, k, val) != 0) {
            _jp_set_err(ps, "out of memory in object", load64(ps + 16)); return 0;
        }
        _jp_skip_ws(ps);
        if (load64(ps + 16) >= len) { _jp_set_err(ps, "unterminated object", load64(ps + 16)); return 0; }
        var c = bs[load64(ps + 16)];
        if (c == 44) { store64(ps + 16, load64(ps + 16) + 1); }
        elif (c == 125) { store64(ps + 16, load64(ps + 16) + 1); _jk_free(&ks); return obj; }
        else { _jp_set_err(ps, "expected ',' or '}'", load64(ps + 16)); return 0; }
    }
    return 0;
}

# Back-compat wrapper over the allocator-threaded form.
fn _jp_parse_object(ps): i64 {
    return _jp_parse_object_a(default_alloc(), ps);
}

# === Reentrant parse entry (v1.0.3, thread-safe) ===
#
# bayan_json_v_parse_ctx threads all parser state through `ps` (a caller-owned
# _JP_STATE_SIZE-byte buffer — stack `var ps[48]` or heap `alloc(...)`; bayan's
# own sites write `var ps[_JP_STATE_SIZE]`). It
# touches NO module globals, so concurrent threads each parsing into their own
# `ps` cannot corrupt one another's cursor. On failure it returns 0 and records
# the error in `ps`; read it with bayan_json_state_error()/_pos().

# Size (bytes) a caller must reserve for a parser state passed to *_parse_ctx*.
fn bayan_json_parse_state_size(): i64 { return _JP_STATE_SIZE; }

# Error message (cstr) recorded in a parser state, or "" if none.
fn bayan_json_state_error(ps): i64 {
    var m = load64(ps + 24);
    if (m == 0) { return ""; }
    return m;
}

# Byte offset of the error recorded in a parser state.
fn bayan_json_state_error_pos(ps): i64 { return load64(ps + 32); }

# Allocator-as-first-arg variant of bayan_json_v_parse_ctx — the whole value
# tree (cells, pair cells, decoded key/value strings, and any vec growth) lands
# on `a`. Pair it with an arena + reset_via to make a parse cost nothing after
# the request that needed it. Returns json_v* or 0; on 0 the error lives in `ps`
# and an exhausted arena reports as a normal "out of memory in ..." parse error.
fn bayan_json_v_parse_ctx_a(a, ps, buf, len): i64 {
    _jp_state_init(ps, buf, len);
    var v = _jp_parse_value_a(a, ps);
    if (v == 0) { return 0; }
    _jp_skip_ws(ps);
    if (load64(ps + 16) != len) {
        _jp_set_err(ps, "trailing content after JSON value", load64(ps + 16));
        return 0;
    }
    return v;
}

# Reentrant parse — explicit cstr+len into a caller-owned state. Returns
# json_v* or 0; on 0 the error lives in `ps`. Does not touch the legacy globals.
fn bayan_json_v_parse_ctx(ps, buf, len): i64 {
    return bayan_json_v_parse_ctx_a(default_alloc(), ps, buf, len);
}

# Reentrant parse — Str convenience over bayan_json_v_parse_ctx.
fn bayan_json_v_parse_ctx_str(ps, src): i64 {
    if (src == 0) {
        _jp_state_init(ps, 0, 0);
        _jp_set_err(ps, "null source", 0);
        return 0;
    }
    return bayan_json_v_parse_ctx(ps, str_data(src), str_len(src));
}

# Public parse entry — Str. Returns json_v* or 0.
fn bayan_json_v_parse(src): i64 {
    if (src == 0) { _json_err_msg = "null source"; _json_err_pos = 0; return 0; }
    return bayan_json_v_parse_buf(str_data(src), str_len(src));
}

# Allocator-as-first-arg variant of bayan_json_v_parse — Str convenience over
# bayan_json_v_parse_buf_a.
fn bayan_json_v_parse_a(a, src): i64 {
    if (src == 0) { _json_err_msg = "null source"; _json_err_pos = 0; return 0; }
    return bayan_json_v_parse_buf_a(a, str_data(src), str_len(src));
}

# Public parse entry — explicit cstr+len. Globals-compat wrapper over the
# reentrant path: each call owns a stack-local parser state (so the parse itself
# is now thread-safe), then mirrors the per-call error into the legacy
# bayan_json_last_error()/_pos() slots for source compatibility. Concurrent
# callers that need race-free error reporting should call bayan_json_v_parse_ctx
# directly and read bayan_json_state_error()/_pos().
#
# NAMED `_buf`, NOT `_str` — and it must stay that way. Cyrius routes a call
# `X(a, ...)` to `X_str` whenever `a` is Str-typed at the call site and `X_str`
# exists (the same overload dispatch that routes `&IDENT` to `_ptr`). While this
# was `bayan_json_v_parse_str`, every `bayan_json_v_parse(someStr)` in the
# ecosystem was silently rewritten into a 1-arg call to this 2-arg function and
# returned 0 for valid JSON. In Cyrius, `X_str` means "the Str-taking variant of
# X" — so a cstr+len form may never occupy that name. See CHANGELOG [1.3.0].
fn bayan_json_v_parse_buf(buf, len): i64 {
    var ps[_JP_STATE_SIZE];
    var v = bayan_json_v_parse_ctx(&ps, buf, len);
    _json_err_msg = load64(&ps + 24);
    _json_err_pos = load64(&ps + 32);
    return v;
}

# Allocator-as-first-arg variant of bayan_json_v_parse_buf. The whole tree lands
# on `a`; the parser state stays a stack local, so this allocates nothing outside
# `a`. Mirrors the same legacy-globals error slots as the non-`_a` form, so it is
# a drop-in for the common single-threaded call site.
#
# The `_buf` / `_str` naming rule above applies here too: the allocator suffix
# `_a` is a plain convention (as in str_from_a / alloc_via), NOT one of Cyrius's
# dispatch suffixes, so it cannot collide with the `X_str` / `X_ptr` routing.
fn bayan_json_v_parse_buf_a(a, buf, len): i64 {
    var ps[_JP_STATE_SIZE];
    var v = bayan_json_v_parse_ctx_a(a, &ps, buf, len);
    _json_err_msg = load64(&ps + 24);
    _json_err_pos = load64(&ps + 32);
    return v;
}

# === Serializer ===

# Allocator-as-first-arg variant of _jb_append_string. Returns -1 if any
# grow through `a` fails, 0 otherwise.
fn _jb_append_string_a(a, sb, s): i64 {
    if (str_builder_add_cstr_a(a, sb, "\"") != 0) { return 0 - 1; }
    var data = str_data(s);
    var slen = str_len(s);
    var i = 0;
    while (i < slen) {
        var c = load8(data + i);
        var rc = 0;
        if      (c == 34) { rc = str_builder_add_cstr_a(a, sb, "\\\""); }
        elif    (c == 92) { rc = str_builder_add_cstr_a(a, sb, "\\\\"); }
        elif    (c ==  8) { rc = str_builder_add_cstr_a(a, sb, "\\b"); }
        elif    (c == 12) { rc = str_builder_add_cstr_a(a, sb, "\\f"); }
        elif    (c == 10) { rc = str_builder_add_cstr_a(a, sb, "\\n"); }
        elif    (c == 13) { rc = str_builder_add_cstr_a(a, sb, "\\r"); }
        elif    (c ==  9) { rc = str_builder_add_cstr_a(a, sb, "\\t"); }
        elif    (c < 32) {
            # Control char — emit \u00XX
            if (str_builder_add_cstr_a(a, sb, "\\u00") != 0) { return 0 - 1; }
            var hi = c >> 4;
            var lo = c & 15;
            var hb[3];
            if (hi < 10) { store8(&hb, 48 + hi); } else { store8(&hb, 87 + hi); }
            if (lo < 10) { store8(&hb + 1, 48 + lo); } else { store8(&hb + 1, 87 + lo); }
            store8(&hb + 2, 0);
            rc = str_builder_add_cstr_a(a, sb, &hb);
        }
        else {
            var bb[2];
            store8(&bb, c);
            store8(&bb + 1, 0);
            rc = str_builder_add_cstr_a(a, sb, &bb);
        }
        if (rc != 0) { return 0 - 1; }
        i = i + 1;
    }
    if (str_builder_add_cstr_a(a, sb, "\"") != 0) { return 0 - 1; }
    return 0;
}

# Append a JSON-escaped string into sb, including the surrounding quotes.
# Back-compat wrapper: aborts on OOM, matching the non-`_a` str_builder verbs
# it used to call directly.
fn _jb_append_string(sb, s): i64 {
    if (_jb_append_string_a(default_alloc(), sb, s) != 0) {
        syscall(1, 2, "bayan: json build alloc failed\n", 31);
        _sb_die();
    }
    return 0;
}

# Allocator-as-first-arg variant of _jb_emit_indent. Returns -1 on grow OOM.
#
# Emits the newline and each space through `str_builder_add_cstr_a` rather than
# `str_builder_add_byte`, which has no `_a` form and aborts on OOM. The bytes
# emitted are identical — both literals are one byte — so pretty output is
# unchanged; this only moves the growth onto `a` and makes the failure
# reportable instead of fatal.
fn _jb_emit_indent_a(a, sb, indent, level): i64 {
    if (str_builder_add_cstr_a(a, sb, "\n") != 0) { return 0 - 1; }
    var total = indent * level;
    var i = 0;
    while (i < total) {
        if (str_builder_add_cstr_a(a, sb, " ") != 0) { return 0 - 1; }
        i = i + 1;
    }
    return 0;
}

# Emit '\n' followed by (indent * level) spaces. Pretty-mode helper.
# Back-compat wrapper: aborts on OOM.
fn _jb_emit_indent(sb, indent, level): i64 {
    if (_jb_emit_indent_a(default_alloc(), sb, indent, level) != 0) {
        syscall(1, 2, "bayan: json build alloc failed\n", 31);
        _sb_die();
    }
    return 0;
}

# Allocator-as-first-arg variant of _jb_walk. Returns -1 if any append or grow
# through `a` fails, 0 otherwise. This is the single implementation; the
# back-compat `_jb_walk` delegates to it.
#
# Unified compact + pretty walker. `indent` param drives mode:
# 0 = compact (":" separator), >0 = pretty (newlines, ": ").
# `if n > 0` guards empty-container case for both modes.
# See CHANGELOG [5.7.47].
#
# NOTE: the recursion here is uncapped, matching the pre-1.4.0 serializer. Only
# reachable from a tree the caller built, so it is not an untrusted-input path
# — but do not build unbounded-depth values from user data. (The *parsers* both
# cap at _JP_MAX_DEPTH; the serializer never has.)
fn _jb_walk_a(a, sb, v, indent, level): i64 {
    if (v == 0) { return str_builder_add_cstr_a(a, sb, "null"); }
    var t = load64(v);
    if      (t == JTAG_NULL)  { return str_builder_add_cstr_a(a, sb, "null"); }
    elif    (t == JTAG_BOOL)  {
        if (load64(v + 8) == 0) { return str_builder_add_cstr_a(a, sb, "false"); }
        return str_builder_add_cstr_a(a, sb, "true");
    }
    elif    (t == JTAG_INT)   {
        var nb[24];
        var nl = fmt_int_buf(load64(v + 8), &nb);
        store8(&nb + nl, 0);
        return str_builder_add_cstr_a(a, sb, &nb);
    }
    elif    (t == JTAG_FLOAT) {
        var fb[64];
        # v1.2.1: Grisu2 round-trip-correct (was fmt_float_buf(,6) — 6-decimal cap
        # lost mantissa bits, flushed |x|<5e-7 to 0, and emitted "-.00000-" for
        # Inf/NaN/>=2^63). Non-finite -> "null". See dtoa.cyr.
        var fl = bayan_f64_to_json(load64(v + 8), &fb);
        store8(&fb + fl, 0);
        return str_builder_add_cstr_a(a, sb, &fb);
    }
    elif    (t == JTAG_STR)   { return _jb_append_string_a(a, sb, load64(v + 8)); }
    elif    (t == JTAG_ARR)   {
        if (str_builder_add_cstr_a(a, sb, "[") != 0) { return 0 - 1; }
        var arr = load64(v + 8);
        var n = vec_len(arr);
        if (n > 0) {
            var i = 0;
            while (i < n) {
                if (i > 0) {
                    if (str_builder_add_cstr_a(a, sb, ",") != 0) { return 0 - 1; }
                }
                if (indent > 0) {
                    if (_jb_emit_indent_a(a, sb, indent, level + 1) != 0) { return 0 - 1; }
                }
                if (_jb_walk_a(a, sb, vec_get(arr, i), indent, level + 1) != 0) { return 0 - 1; }
                i = i + 1;
            }
            if (indent > 0) {
                if (_jb_emit_indent_a(a, sb, indent, level) != 0) { return 0 - 1; }
            }
        }
        return str_builder_add_cstr_a(a, sb, "]");
    }
    elif    (t == JTAG_OBJ)   {
        if (str_builder_add_cstr_a(a, sb, "{") != 0) { return 0 - 1; }
        var pairs = load64(v + 8);
        var pn = vec_len(pairs);
        if (pn > 0) {
            var pi = 0;
            while (pi < pn) {
                if (pi > 0) {
                    if (str_builder_add_cstr_a(a, sb, ",") != 0) { return 0 - 1; }
                }
                if (indent > 0) {
                    if (_jb_emit_indent_a(a, sb, indent, level + 1) != 0) { return 0 - 1; }
                }
                var p = vec_get(pairs, pi);
                if (_jb_append_string_a(a, sb, load64(p)) != 0) { return 0 - 1; }
                if (indent > 0) {
                    if (str_builder_add_cstr_a(a, sb, ": ") != 0) { return 0 - 1; }
                } else {
                    if (str_builder_add_cstr_a(a, sb, ":") != 0) { return 0 - 1; }
                }
                if (_jb_walk_a(a, sb, load64(p + 8), indent, level + 1) != 0) { return 0 - 1; }
                pi = pi + 1;
            }
            if (indent > 0) {
                if (_jb_emit_indent_a(a, sb, indent, level) != 0) { return 0 - 1; }
            }
        }
        return str_builder_add_cstr_a(a, sb, "}");
    }
    return str_builder_add_cstr_a(a, sb, "null");
}

# Back-compat walker: aborts on OOM, matching the non-`_a` str_builder verbs
# this used to call directly. On the global bump allocator that branch is
# effectively unreachable (alloc only returns 0 for size<=0 or >ALLOC_MAX, and a
# failed chunk mmap exits inside alloc_init); with an arena it is reachable,
# which is exactly why the `_a` form reports rather than aborts.
fn _jb_walk(sb, v, indent, level): i64 {
    if (_jb_walk_a(default_alloc(), sb, v, indent, level) != 0) {
        syscall(1, 2, "bayan: json build alloc failed\n", 31);
        _sb_die();
    }
    return 0;
}

# Allocator-as-first-arg variant of bayan_json_v_build. Routes the builder's
# scratch buffer, every grow, and the final Str through `a`. Returns 0 on OOM
# (the caller cannot tell a failed build from an empty tree by the return value
# alone — check for 0, which a successful build never returns).
#
# This is the half of a per-request JSON response that an arena could not reach
# before 1.4.0: the value tree had `_a` constructors, the serializer did not.
fn bayan_json_v_build_a(a, v): i64 {
    var sb = str_builder_new_a(a);
    if (sb == 0) { return 0; }
    if (_jb_walk_a(a, sb, v, 0, 0) != 0) { return 0; }
    return str_builder_build_a(a, sb);
}

# bayan_json_v_build — serialize a tagged value tree to a Str (compact).
fn bayan_json_v_build(v): i64 {
    var sb = str_builder_new();
    _jb_walk(sb, v, 0, 0);
    return str_builder_build(sb);
}

# bayan_json_v_build_pretty — serialize a tagged value tree with newlines + indent.
# `indent` is the spaces per level; `indent <= 0` falls back to compact.
fn bayan_json_v_build_pretty(v, indent): i64 {
    if (indent <= 0) { return bayan_json_v_build(v); }
    var sb = str_builder_new();
    _jb_walk(sb, v, indent, 0);
    return str_builder_build(sb);
}

# Allocator-as-first-arg variant of bayan_json_v_build_pretty. Same `indent <= 0`
# fallback to the compact form. Returns 0 on OOM.
fn bayan_json_v_build_pretty_a(a, v, indent): i64 {
    if (indent <= 0) { return bayan_json_v_build_a(a, v); }
    var sb = str_builder_new_a(a);
    if (sb == 0) { return 0; }
    if (_jb_walk_a(a, sb, v, indent, 0) != 0) { return 0; }
    return str_builder_build_a(a, sb);
}

# ======================================================================
# STREAMING PARSER (v5.7.41) — event-driven, no tree allocation
# ======================================================================
#
# For multi-MB JSON inputs that don't fit the tagged-tree memory model.
# Caller allocates a handler struct, fills in the callbacks they care
# about (others stay 0 = no-op), and the driver fires events as it walks.
#
# Handler layout (96 bytes):
#   +0   ctx              user pointer (1st arg to every callback)
#   +8   on_object_start  fnptr or 0  fncall1(ctx)
#   +16  on_object_end    fnptr or 0  fncall1(ctx)
#   +24  on_array_start   fnptr or 0  fncall1(ctx)
#   +32  on_array_end     fnptr or 0  fncall1(ctx)
#   +40  on_key           fnptr or 0  fncall2(ctx, key_str)
#   +48  on_string        fnptr or 0  fncall2(ctx, value_str)
#   +56  on_int           fnptr or 0  fncall2(ctx, value_i64)
#   +64  on_float         fnptr or 0  fncall2(ctx, value_f64_bits)
#   +72  on_bool          fnptr or 0  fncall2(ctx, value_0_or_1)
#   +80  on_null          fnptr or 0  fncall1(ctx)
#   +88  on_error         fnptr or 0  fncall3(ctx, msg_cstr, pos)
#
# Lex state is the same per-call parser state struct the tree parser uses (`ps`,
# threaded as the first argument), so the shared helpers _jp_skip_ws,
# _jp_parse_string, _jp_atoi, _jp_atof, _jp_set_err are reused as-is and the
# streaming parser is reentrant too. This keeps the streaming surface ~210 LOC
# instead of ~400.

const JS_EV_OBJECT_START = 0;
const JS_EV_OBJECT_END   = 1;
const JS_EV_ARRAY_START  = 2;
const JS_EV_ARRAY_END    = 3;
const JS_EV_KEY          = 4;
const JS_EV_STRING       = 5;
const JS_EV_INT          = 6;
const JS_EV_FLOAT        = 7;
const JS_EV_BOOL         = 8;
const JS_EV_NULL         = 9;
const JS_EV_ERROR        = 10;
const JS_EV_COUNT        = 11;

var _JS_HANDLER_SIZE = 96;

# Allocate a handler with all callback slots 0 (no-op). `ctx` is the
# user pointer threaded through every callback as its first argument.
fn bayan_json_stream_handler_new(ctx): i64 {
    var h = alloc(_JS_HANDLER_SIZE);
    var i = 0;
    while (i < _JS_HANDLER_SIZE) { store64(h + i, 0); i = i + 8; }
    store64(h, ctx);
    return h;
}

# Bind callback `fp` to event `event_id`. Returns 0 on success, -1 on
# bad event_id. Pass fp=0 to clear an event.
fn bayan_json_stream_on(h, event_id, fp): i64 {
    if (event_id < 0 || event_id >= JS_EV_COUNT) { return 0 - 1; }
    store64(h + 8 + event_id * 8, fp);
    return 0;
}

fn _js_ctx(h): i64 { return load64(h); }
fn _js_cb(h, event_id): i64 { return load64(h + 8 + event_id * 8); }

# Record the error into the per-call state + fire on_error if registered.
fn _js_emit_error(ps, h, msg): i64 {
    var pos = load64(ps + 16);
    _jp_set_err(ps, msg, pos);
    var fp = _js_cb(h, JS_EV_ERROR);
    if (fp != 0) { fncall3(fp, _js_ctx(h), msg, pos); }
    return 0;
}

# Relay a _jp_set_err-set error through to on_error (for paths that
# call _jp_parse_string and get a 0 back — ps's error slots are already
# populated, just need to forward).
fn _js_relay_err(ps, h): i64 {
    var fp = _js_cb(h, JS_EV_ERROR);
    if (fp != 0) { fncall3(fp, _js_ctx(h), load64(ps + 24), load64(ps + 32)); }
    return 0;
}

# Number parser — _jp_scan_number's grammar and the tree parser's i64 range
# (1.11.1; see there), emitted through a callback instead of a json_v*. Returns
# 0 on success, -1 on error.
fn _js_parse_number(ps, h): i64 {
    var buf = load64(ps);
    var start = load64(ps + 16);
    var nb: i64[2];
    var pos = _jp_scan_number(ps, &nb);
    if (pos < 0) { _js_relay_err(ps, h); return 0 - 1; }
    if (load64(&nb) == 1) {
        store64(ps + 16, pos);
        var fbits = _jp_atof(buf + start, pos - start);
        var fp_f = _js_cb(h, JS_EV_FLOAT);
        if (fp_f != 0) { fncall2(fp_f, _js_ctx(h), fbits); }
        return 0;
    }
    if (_jp_int_fits(buf + start, load64(&nb + 8) - start) == 0) {
        _jp_set_err(ps, "integer is out of range for i64", start);
        _js_relay_err(ps, h);
        return 0 - 1;
    }
    store64(ps + 16, pos);
    var iv = _jp_atoi(buf + start, pos - start);
    var fp_i = _js_cb(h, JS_EV_INT);
    if (fp_i != 0) { fncall2(fp_i, _js_ctx(h), iv); }
    return 0;
}

fn _js_parse_array(ps, h): i64 {
    var buf = load64(ps);
    var len = load64(ps + 8);
    var bs: [u8] = 0;
    slice_set(&bs, buf, len);
    if (bs[load64(ps + 16)] != 91) { _js_emit_error(ps, h, "expected '['"); return 0 - 1; }
    store64(ps + 16, load64(ps + 16) + 1);
    var fp_s = _js_cb(h, JS_EV_ARRAY_START);
    if (fp_s != 0) { fncall1(fp_s, _js_ctx(h)); }
    _jp_skip_ws(ps);
    if (load64(ps + 16) < len && bs[load64(ps + 16)] == 93) {
        store64(ps + 16, load64(ps + 16) + 1);
        var fp_e = _js_cb(h, JS_EV_ARRAY_END);
        if (fp_e != 0) { fncall1(fp_e, _js_ctx(h)); }
        return 0;
    }
    while (1 == 1) {
        if (_js_parse_value(ps, h) != 0) { return 0 - 1; }
        _jp_skip_ws(ps);
        if (load64(ps + 16) >= len) { _js_emit_error(ps, h, "unterminated array"); return 0 - 1; }
        var c = bs[load64(ps + 16)];
        if (c == 44) { store64(ps + 16, load64(ps + 16) + 1); _jp_skip_ws(ps); }
        elif (c == 93) {
            store64(ps + 16, load64(ps + 16) + 1);
            var fp_e2 = _js_cb(h, JS_EV_ARRAY_END);
            if (fp_e2 != 0) { fncall1(fp_e2, _js_ctx(h)); }
            return 0;
        } else { _js_emit_error(ps, h, "expected ',' or ']'"); return 0 - 1; }
    }
    return 0;
}

fn _js_parse_object(ps, h): i64 {
    var buf = load64(ps);
    var len = load64(ps + 8);
    var bs: [u8] = 0;
    slice_set(&bs, buf, len);
    if (bs[load64(ps + 16)] != 123) { _js_emit_error(ps, h, "expected '{'"); return 0 - 1; }
    store64(ps + 16, load64(ps + 16) + 1);
    var fp_s = _js_cb(h, JS_EV_OBJECT_START);
    if (fp_s != 0) { fncall1(fp_s, _js_ctx(h)); }
    _jp_skip_ws(ps);
    if (load64(ps + 16) < len && bs[load64(ps + 16)] == 125) {
        store64(ps + 16, load64(ps + 16) + 1);
        var fp_e = _js_cb(h, JS_EV_OBJECT_END);
        if (fp_e != 0) { fncall1(fp_e, _js_ctx(h)); }
        return 0;
    }
    # A duplicate key is refused before its JS_EV_KEY fires (1.11.1).
    var ks[_JK_SIZE];
    _jk_init(&ks, default_alloc());
    while (1 == 1) {
        _jp_skip_ws(ps);
        var kpos = load64(ps + 16);
        var k = _jp_parse_string(ps);
        if (k == 0) { _js_relay_err(ps, h); return 0 - 1; }
        var fresh = _jk_add(&ks, str_data(k), str_len(k));
        if (fresh <= 0) {
            if (fresh == 0) { _jp_set_err(ps, "duplicate key", kpos); }
            else { _jp_set_err(ps, "out of memory in object", kpos); }
            _js_relay_err(ps, h);
            return 0 - 1;
        }
        var fp_k = _js_cb(h, JS_EV_KEY);
        if (fp_k != 0) { fncall2(fp_k, _js_ctx(h), k); }
        _jp_skip_ws(ps);
        if (load64(ps + 16) >= len) { _js_emit_error(ps, h, "unterminated object"); return 0 - 1; }
        if (bs[load64(ps + 16)] != 58) { _js_emit_error(ps, h, "expected ':' after key"); return 0 - 1; }
        store64(ps + 16, load64(ps + 16) + 1);
        if (_js_parse_value(ps, h) != 0) { return 0 - 1; }
        _jp_skip_ws(ps);
        if (load64(ps + 16) >= len) { _js_emit_error(ps, h, "unterminated object"); return 0 - 1; }
        var c = bs[load64(ps + 16)];
        if (c == 44) { store64(ps + 16, load64(ps + 16) + 1); }
        elif (c == 125) {
            store64(ps + 16, load64(ps + 16) + 1);
            _jk_free(&ks);
            var fp_e2 = _js_cb(h, JS_EV_OBJECT_END);
            if (fp_e2 != 0) { fncall1(fp_e2, _js_ctx(h)); }
            return 0;
        } else { _js_emit_error(ps, h, "expected ',' or '}'"); return 0 - 1; }
    }
    return 0;
}

fn _js_parse_value(ps, h): i64 {
    _jp_skip_ws(ps);
    var buf = load64(ps);
    var len = load64(ps + 8);
    var bs: [u8] = 0;
    slice_set(&bs, buf, len);
    var pos = load64(ps + 16);
    if (pos >= len) { _js_emit_error(ps, h, "unexpected EOF"); return 0 - 1; }
    var c = bs[pos];
    if (c == 123 || c == 91) {
        # Same depth bound as _jp_parse_value — the streaming descent recurses
        # through _js_parse_array/_js_parse_object identically.
        var depth = load64(ps + 40);
        if (depth >= _JP_MAX_DEPTH) { _js_emit_error(ps, h, "nesting too deep"); return 0 - 1; }
        store64(ps + 40, depth + 1);
        var rc = 0;
        if (c == 123) { rc = _js_parse_object(ps, h); }
        else          { rc = _js_parse_array(ps, h); }
        store64(ps + 40, depth);
        return rc;
    }
    if (c == 34)  {
        var s = _jp_parse_string(ps);
        if (s == 0) { _js_relay_err(ps, h); return 0 - 1; }
        var fp_s = _js_cb(h, JS_EV_STRING);
        if (fp_s != 0) { fncall2(fp_s, _js_ctx(h), s); }
        return 0;
    }
    if (c == 116) {
        if (pos + 3 < len && _jp_word(buf, len, pos + 1, "rue", 3) == 1) {
            store64(ps + 16, pos + 4);
            var fp_b = _js_cb(h, JS_EV_BOOL);
            if (fp_b != 0) { fncall2(fp_b, _js_ctx(h), 1); }
            return 0;
        }
        _js_emit_error(ps, h, "expected 'true'");
        return 0 - 1;
    }
    if (c == 102) {
        if (pos + 4 < len && _jp_word(buf, len, pos + 1, "alse", 4) == 1) {
            store64(ps + 16, pos + 5);
            var fp_b = _js_cb(h, JS_EV_BOOL);
            if (fp_b != 0) { fncall2(fp_b, _js_ctx(h), 0); }
            return 0;
        }
        _js_emit_error(ps, h, "expected 'false'");
        return 0 - 1;
    }
    if (c == 110) {
        if (pos + 3 < len && _jp_word(buf, len, pos + 1, "ull", 3) == 1) {
            store64(ps + 16, pos + 4);
            var fp_n = _js_cb(h, JS_EV_NULL);
            if (fp_n != 0) { fncall1(fp_n, _js_ctx(h)); }
            return 0;
        }
        _js_emit_error(ps, h, "expected 'null'");
        return 0 - 1;
    }
    if (c == 45 || (c >= 48 && c <= 57)) {
        return _js_parse_number(ps, h);
    }
    _js_emit_error(ps, h, "unexpected character");
    return 0 - 1;
}

# Public stream-parse entry — explicit cstr+len+handler. Returns 0 on
# success, -1 on error. After error, callers can read bayan_json_last_error()
# and bayan_json_last_error_pos(); the JS_EV_ERROR callback (if registered)
# already fired.
fn bayan_json_stream_parse(buf, len, h): i64 {
    var ps[_JP_STATE_SIZE];
    _jp_state_init(&ps, buf, len);
    var rc = 0;
    if (_js_parse_value(&ps, h) != 0) {
        rc = 0 - 1;
    } else {
        _jp_skip_ws(&ps);
        if (load64(&ps + 16) != len) {
            _js_emit_error(&ps, h, "trailing content after JSON value");
            rc = 0 - 1;
        }
    }
    # Mirror the per-call error into the legacy last-error slots for back-compat
    # (0/0 on success). Concurrent stream parsers should read the JS_EV_ERROR
    # callback rather than bayan_json_last_error().
    _json_err_msg = load64(&ps + 24);
    _json_err_pos = load64(&ps + 32);
    return rc;
}

# Convenience: stream-parse from a Str.
fn bayan_json_stream_parse_str(src, h): i64 {
    if (src == 0) { _json_err_msg = "null source"; _json_err_pos = 0; return 0 - 1; }
    return bayan_json_stream_parse(str_data(src), str_len(src), h);
}

# ======================================================================
# JSON POINTER (v5.7.42, RFC 6901)
# ======================================================================
#
# Walk the tagged tree by slash-separated path. Returns the referenced
# json_v* or 0 (not found / invalid pointer / can't descend into scalar).
#
# Empty pointer ""           → whole document
# "/foo"                     → root["foo"]
# "/foo/0/bar"               → root["foo"][0]["bar"]
# "/" (just slash)           → root[""] (empty-string key)
# "/a/"                      → a[""] (trailing-slash empty token)
#
# Tokens are unescaped per RFC 6901 §3: "~1" → "/", "~0" → "~". The
# left-to-right single-pass unescape below is equivalent to the spec's
# two-pass "~1 then ~0" order — only "~0" and "~1" are valid escapes,
# so any other "~X" is an error and returns 0.
#
# Array tokens must match `0|[1-9][0-9]*` per RFC 6901 §4. The "-"
# (next-element) token is append-only and has no read meaning, so
# it returns 0.

# Look up (buf, len) as a key in OBJ value `v`. Length-explicit so
# tokens with interior NUL bytes (theoretical via `\u0000`) still match.
fn _jp_obj_lookup(v, buf, len): i64 {
    if (load64(v) != JTAG_OBJ) { return 0; }
    var pairs = load64(v + 8);
    var n = vec_len(pairs);
    var i = 0;
    while (i < n) {
        var p = vec_get(pairs, i);
        var ks = load64(p);
        if (str_len(ks) == len) {
            if (memeq(str_data(ks), buf, len) == 1) {
                return load64(p + 8);
            }
        }
        i = i + 1;
    }
    return 0;
}

# Parse (buf, len) as a strict array index per RFC 6901 §4. Returns
# index >= 0, or -1 on invalid (leading zero, non-digit, empty,
# the "-" next-element token, etc.).
fn _jp_parse_idx(buf, len): i64 {
    if (len == 0) { return 0 - 1; }
    var c0 = load8(buf);
    if (c0 == 48) { if (len == 1) { return 0; } return 0 - 1; }
    if (c0 < 49 || c0 > 57) { return 0 - 1; }
    var n = c0 - 48;
    var i = 1;
    while (i < len) {
        var c = load8(buf + i);
        if (c < 48 || c > 57) { return 0 - 1; }
        # OVERFLOW (fixed in 1.5.1). `n = n * 10 + d` wrapped mod 2^64, so a
        # pointer token of enough digits landed back INSIDE the array: against
        # a 3-element array, "/1" followed by 64 zeros selected element 0 and
        # "/18446744073709551618" selected element 2. An out-of-range pointer
        # must resolve to nothing, not to a neighbouring element chosen by
        # arithmetic wraparound. No array can hold 10^18 elements, so anything
        # past that is out of range by construction.
        if (n > 999999999999999999) { return 0 - 1; }
        n = n * 10 + (c - 48);
        i = i + 1;
    }
    return n;
}

# Unescape one reference token from (src, src_len) into a freshly
# allocated buffer. Layout: u64 length prefix at offset 0, decoded
# bytes from offset 8, NUL byte at offset 8+len. Returns the alloc
# pointer, or 0 on bad escape (lone "~" or "~X" where X != 0/1).
fn _jp_token_unescape(src, src_len): i64 {
    var out = alloc(src_len + 8 + 1);
    var oi = 0;
    var i = 0;
    while (i < src_len) {
        var c = load8(src + i);
        if (c == 126) {
            i = i + 1;
            if (i >= src_len) { return 0; }
            var e = load8(src + i);
            if      (e == 48) { store8(out + 8 + oi, 126); oi = oi + 1; }
            elif    (e == 49) { store8(out + 8 + oi,  47); oi = oi + 1; }
            else { return 0; }
            i = i + 1;
        } else {
            store8(out + 8 + oi, c);
            oi = oi + 1;
            i = i + 1;
        }
    }
    store8(out + 8 + oi, 0);
    store64(out, oi);
    return out;
}

# Public entry — explicit buf+len pointer string.
fn bayan_json_v_pointer_cstr(v, ptr, plen): i64 {
    if (v == 0) { return 0; }
    if (plen == 0) { return v; }
    if (load8(ptr) != 47) { return 0; }   # must start with '/'
    var pos = 1;
    var cur = v;
    while (pos <= plen) {
        var start = pos;
        while (pos < plen) {
            if (load8(ptr + pos) == 47) { break; }
            pos = pos + 1;
        }
        var tok_len = pos - start;
        var ub = _jp_token_unescape(ptr + start, tok_len);
        if (ub == 0) { return 0; }
        var ulen = load64(ub);
        var ubuf = ub + 8;
        if (cur == 0) { return 0; }
        var t = load64(cur);
        if (t == JTAG_OBJ) {
            cur = _jp_obj_lookup(cur, ubuf, ulen);
        } elif (t == JTAG_ARR) {
            var idx = _jp_parse_idx(ubuf, ulen);
            if (idx < 0) { return 0; }
            cur = bayan_json_v_arr_get(cur, idx);
        } else {
            return 0;
        }
        if (cur == 0) { return 0; }
        if (pos == plen) { return cur; }
        pos = pos + 1;
    }
    return cur;
}

# Convenience: pointer as a Str.
fn bayan_json_v_pointer(v, ptr): i64 {
    if (ptr == 0) { return v; }
    return bayan_json_v_pointer_cstr(v, str_data(ptr), str_len(ptr));
}
