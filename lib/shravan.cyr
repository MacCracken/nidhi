    store8(_silk_shell3 + 128, 55); store8(_silk_shell3 + 129, 27); store8(_silk_shell3 + 130, 11); store8(_silk_shell3 + 131, 3); store8(_silk_shell3 + 132, 2); store8(_silk_shell3 + 133, 1); store8(_silk_shell3 + 134, 0); store8(_silk_shell3 + 135, 255); store8(_silk_shell3 + 136, 254); store8(_silk_shell3 + 137, 253); store8(_silk_shell3 + 138, 252); store8(_silk_shell3 + 139, 239); store8(_silk_shell3 + 140, 221); store8(_silk_shell3 + 141, 194); store8(_silk_shell3 + 142, 158); store8(_silk_shell3 + 143, 117);
    store8(_silk_shell3 + 144, 76); store8(_silk_shell3 + 145, 42); store8(_silk_shell3 + 146, 18); store8(_silk_shell3 + 147, 4); store8(_silk_shell3 + 148, 3); store8(_silk_shell3 + 149, 2); store8(_silk_shell3 + 150, 1); store8(_silk_shell3 + 151, 0);
    _silk_shell_off = alloc(17);
    store8(_silk_shell_off + 0, 0); store8(_silk_shell_off + 1, 0); store8(_silk_shell_off + 2, 2); store8(_silk_shell_off + 3, 5); store8(_silk_shell_off + 4, 9); store8(_silk_shell_off + 5, 14); store8(_silk_shell_off + 6, 20); store8(_silk_shell_off + 7, 27); store8(_silk_shell_off + 8, 35); store8(_silk_shell_off + 9, 44); store8(_silk_shell_off + 10, 54); store8(_silk_shell_off + 11, 65); store8(_silk_shell_off + 12, 77); store8(_silk_shell_off + 13, 90); store8(_silk_shell_off + 14, 104); store8(_silk_shell_off + 15, 119);
    store8(_silk_shell_off + 16, 135);
    _silk_sign_icdf = alloc(42);
    store8(_silk_sign_icdf + 0, 254); store8(_silk_sign_icdf + 1, 49); store8(_silk_sign_icdf + 2, 67); store8(_silk_sign_icdf + 3, 77); store8(_silk_sign_icdf + 4, 82); store8(_silk_sign_icdf + 5, 93); store8(_silk_sign_icdf + 6, 99); store8(_silk_sign_icdf + 7, 198); store8(_silk_sign_icdf + 8, 11); store8(_silk_sign_icdf + 9, 18); store8(_silk_sign_icdf + 10, 24); store8(_silk_sign_icdf + 11, 31); store8(_silk_sign_icdf + 12, 36); store8(_silk_sign_icdf + 13, 45); store8(_silk_sign_icdf + 14, 255); store8(_silk_sign_icdf + 15, 46);
    store8(_silk_sign_icdf + 16, 66); store8(_silk_sign_icdf + 17, 78); store8(_silk_sign_icdf + 18, 87); store8(_silk_sign_icdf + 19, 94); store8(_silk_sign_icdf + 20, 104); store8(_silk_sign_icdf + 21, 208); store8(_silk_sign_icdf + 22, 14); store8(_silk_sign_icdf + 23, 21); store8(_silk_sign_icdf + 24, 32); store8(_silk_sign_icdf + 25, 42); store8(_silk_sign_icdf + 26, 51); store8(_silk_sign_icdf + 27, 66); store8(_silk_sign_icdf + 28, 255); store8(_silk_sign_icdf + 29, 94); store8(_silk_sign_icdf + 30, 104); store8(_silk_sign_icdf + 31, 109);
    store8(_silk_sign_icdf + 32, 112); store8(_silk_sign_icdf + 33, 115); store8(_silk_sign_icdf + 34, 118); store8(_silk_sign_icdf + 35, 248); store8(_silk_sign_icdf + 36, 53); store8(_silk_sign_icdf + 37, 69); store8(_silk_sign_icdf + 38, 80); store8(_silk_sign_icdf + 39, 88); store8(_silk_sign_icdf + 40, 95); store8(_silk_sign_icdf + 41, 102);
    return 0;
}

# ---- excitation decode (decode_pulses.c / shell_coder.c / code_signs.c) ----
# decode_split: split parent pulse count p into two children via shell cdf table.
fn silk_decode_split(ec, p, shell_table, out2) {
    # out2[0]=child1, out2[1]=child2
    if (p > 0) {
        var c1 = ec_dec_icdf(ec, shell_table + load8(_silk_shell_off + p), 8);
        store64(out2 + 0, c1);
        store64(out2 + 8, p - c1);
    } else {
        store64(out2 + 0, 0);
        store64(out2 + 8, 0);
    }
    return 0;
}

# silk_shell_decoder: decode one 16-pulse shell block into pulses0[16] (i64 slots).
fn silk_shell_decoder(pulses0, ec, pulses4) {
    var p3 = alloc(2 * 8);
    var p2 = alloc(4 * 8);
    var p1 = alloc(8 * 8);
    var tmp = alloc(2 * 8);
    silk_decode_split(ec, pulses4, _silk_shell3, tmp);
    store64(p3 + 0, load64(tmp + 0)); store64(p3 + 8, load64(tmp + 8));

    silk_decode_split(ec, load64(p3 + 0), _silk_shell2, tmp);
    store64(p2 + 0, load64(tmp + 0)); store64(p2 + 8, load64(tmp + 8));

    silk_decode_split(ec, load64(p2 + 0), _silk_shell1, tmp);
    store64(p1 + 0, load64(tmp + 0)); store64(p1 + 8, load64(tmp + 8));
    silk_decode_split(ec, load64(p1 + 0), _silk_shell0, tmp);
    store64(pulses0 + 0 * 8, load64(tmp + 0)); store64(pulses0 + 1 * 8, load64(tmp + 8));
    silk_decode_split(ec, load64(p1 + 8), _silk_shell0, tmp);
    store64(pulses0 + 2 * 8, load64(tmp + 0)); store64(pulses0 + 3 * 8, load64(tmp + 8));

    silk_decode_split(ec, load64(p2 + 8), _silk_shell1, tmp);
    store64(p1 + 2 * 8, load64(tmp + 0)); store64(p1 + 3 * 8, load64(tmp + 8));
    silk_decode_split(ec, load64(p1 + 2 * 8), _silk_shell0, tmp);
    store64(pulses0 + 4 * 8, load64(tmp + 0)); store64(pulses0 + 5 * 8, load64(tmp + 8));
    silk_decode_split(ec, load64(p1 + 3 * 8), _silk_shell0, tmp);
    store64(pulses0 + 6 * 8, load64(tmp + 0)); store64(pulses0 + 7 * 8, load64(tmp + 8));

    silk_decode_split(ec, load64(p3 + 8), _silk_shell2, tmp);
    store64(p2 + 2 * 8, load64(tmp + 0)); store64(p2 + 3 * 8, load64(tmp + 8));

    silk_decode_split(ec, load64(p2 + 2 * 8), _silk_shell1, tmp);
    store64(p1 + 4 * 8, load64(tmp + 0)); store64(p1 + 5 * 8, load64(tmp + 8));
    silk_decode_split(ec, load64(p1 + 4 * 8), _silk_shell0, tmp);
    store64(pulses0 + 8 * 8, load64(tmp + 0)); store64(pulses0 + 9 * 8, load64(tmp + 8));
    silk_decode_split(ec, load64(p1 + 5 * 8), _silk_shell0, tmp);
    store64(pulses0 + 10 * 8, load64(tmp + 0)); store64(pulses0 + 11 * 8, load64(tmp + 8));

    silk_decode_split(ec, load64(p2 + 3 * 8), _silk_shell1, tmp);
    store64(p1 + 6 * 8, load64(tmp + 0)); store64(p1 + 7 * 8, load64(tmp + 8));
    silk_decode_split(ec, load64(p1 + 6 * 8), _silk_shell0, tmp);
    store64(pulses0 + 12 * 8, load64(tmp + 0)); store64(pulses0 + 13 * 8, load64(tmp + 8));
    silk_decode_split(ec, load64(p1 + 7 * 8), _silk_shell0, tmp);
    store64(pulses0 + 14 * 8, load64(tmp + 0)); store64(pulses0 + 15 * 8, load64(tmp + 8));
    return 0;
}

# silk_decode_signs: attach signs to nonzero pulses in place. sum_pulses[iter] i64.
fn silk_decode_signs(ec, pulses, length, signalType, quantOffsetType, sum_pulses) {
    var icdf2 = alloc(2);
    store8(icdf2 + 1, 0);
    var base = quantOffsetType + (signalType << 1);
    var icdf_ptr = _silk_sign_icdf + 7 * base;
    var nblk = (length + 8) >> 4;
    var i = 0;
    while (i < nblk) {
        var p = load64(sum_pulses + i * 8);
        if (p > 0) {
            var idx = p & 0x1F;
            if (idx > 6) { idx = 6; }
            store8(icdf2 + 0, load8(icdf_ptr + idx));
            var j = 0;
            while (j < 16) {
                var qj = load64(pulses + (i * 16 + j) * 8);
                if (qj > 0) {
                    var m = ec_dec_icdf(ec, icdf2, 8);
                    store64(pulses + (i * 16 + j) * 8, qj * ((m << 1) - 1));   # silk_dec_map
                }
                j = j + 1;
            }
        }
        i = i + 1;
    }
    return 0;
}

# silk_decode_pulses: decode the full excitation vector pulses[frame_length] (i64 slots).
fn silk_decode_pulses(ec, pulses, signalType, quantOffsetType, frame_length) {
    if (_silk_ratelvl_icdf == 0) { _silk_tables5_init(); }
    var RateLevelIndex = ec_dec_icdf(ec, _silk_ratelvl_icdf + (signalType >> 1) * 9, 8);
    var iter = frame_length >> 4;
    # 10 ms @ 12 kHz is 120 samples = 7.5 shell blocks; libopus rounds up and
    # asserts this is the only config where it happens (decode_pulses.c:58).
    if ((iter << 4) < frame_length) { iter = iter + 1; }
    var sum_pulses = alloc(20 * 8);
    var nLshifts = alloc(20 * 8);
    var cdf = _silk_ppb_icdf + RateLevelIndex * 18;
    var i = 0;
    while (i < iter) {
        store64(nLshifts + i * 8, 0);
        var sp = ec_dec_icdf(ec, cdf, 8);
        while (sp == 17) {                                  # SILK_MAX_PULSES+1
            store64(nLshifts + i * 8, load64(nLshifts + i * 8) + 1);
            var extra = 0;
            if (load64(nLshifts + i * 8) == 10) { extra = 1; }
            sp = ec_dec_icdf(ec, _silk_ppb_icdf + 9 * 18 + extra, 8);
        }
        store64(sum_pulses + i * 8, sp);
        i = i + 1;
    }
    i = 0;
    while (i < iter) {
        if (load64(sum_pulses + i * 8) > 0) {
            silk_shell_decoder(pulses + (i * 16) * 8, ec, load64(sum_pulses + i * 8));
        } else {
            var z = 0;
            while (z < 16) { store64(pulses + (i * 16 + z) * 8, 0); z = z + 1; }
        }
        i = i + 1;
    }
    i = 0;
    while (i < iter) {
        var nLS = load64(nLshifts + i * 8);
        if (nLS > 0) {
            var k = 0;
            while (k < 16) {
                var abs_q = load64(pulses + (i * 16 + k) * 8);
                var j = 0;
                while (j < nLS) {
                    abs_q = abs_q << 1;
                    abs_q = abs_q + ec_dec_icdf(ec, _silk_lsb_icdf, 8);
                    j = j + 1;
                }
                store64(pulses + (i * 16 + k) * 8, abs_q);
                k = k + 1;
            }
            store64(sum_pulses + i * 8, load64(sum_pulses + i * 8) | (nLS << 5));
        }
        i = i + 1;
    }
    silk_decode_signs(ec, pulses, frame_length, signalType, quantOffsetType, sum_pulses);
    return 0;
}

# ---- LTP+LPC synthesis (decode_core.c) ----
fn silk_sub32_ovflw(a, b) { return silk_sx32(a - b); }
fn silk_lshift_ovflw(a, shift) { return silk_sx32(a << shift); }
fn silk_add_sat32(a, b) { return silk_sat32(a + b); }

# silk_DIV32_varQ: ~ (a32 << Qres) / b32, b32 != 0, Qres >= 0.
fn silk_div32_varq(a32, b32, Qres) {
    var a_hr = silk_clz32(silk_abs64(a32)) - 1;
    var a_nrm = a32 << a_hr;
    var b_hr = silk_clz32(silk_abs64(b32)) - 1;
    var b_nrm = b32 << b_hr;
    var b_inv = silk_div_trunc(sar(2147483647, 2), sar(b_nrm, 16));
    var result = silk_smulwb(a_nrm, b_inv);
    a_nrm = silk_sub32_ovflw(a_nrm, silk_lshift_ovflw(silk_smmul(b_nrm, result), 3));
    result = silk_smlawb(result, a_nrm, b_inv);
    var lshift = 29 + a_hr - b_hr - Qres;
    if (lshift < 0) { return silk_lshift_sat32(result, 0 - lshift); }
    if (lshift < 32) { return sar(result, lshift); }
    return 0;
}

# silk_SMLABB_ovflw(a,b,c) = ADD32_ovflw(a, (int16)b * (int16)c)
fn silk_smlabb_ovflw(a, b, c) { return silk_sx32(a + _i16(b) * _i16(c)); }

# silk_LPC_analysis_filter (#else scalar branch): out[len] from in[len], MA coefs B[d] (Q12).
# in/out are int16 values held in i64 slots.
fn silk_lpc_analysis_filter(out, inp, B, len, d) {
    var ix = d;
    while (ix < len) {
        # in_ptr = &in[ix-1]; out32_Q12 = sum_{j=0..d-1} in_ptr[-j]*B[j]  (ovflw)
        var acc = silk_smulbb(load64(inp + (ix - 1) * 8), load64(B + 0));
        var j = 1;
        while (j < d) {
            acc = silk_smlabb_ovflw(acc, load64(inp + (ix - 1 - j) * 8), load64(B + j * 8));
            j = j + 1;
        }
        # out32_Q12 = (in[ix] << 12) - acc  (ovflw); out32 = RSHIFT_ROUND(.,12); SAT16
        acc = silk_sub32_ovflw(load64(inp + ix * 8) << 12, acc);
        store64(out + ix * 8, silk_sat16(silk_rshift_round(acc, 12)));
        ix = ix + 1;
    }
    var z = 0;
    while (z < d) { store64(out + z * 8, 0); z = z + 1; }
    return 0;
}

# offset_Q10 lookup: silk_Quantization_Offsets_Q10[signalType>>1][quantOffsetType].
fn silk_quant_offset(signalType, quantOffset) {
    # {{100,240},{32,100}}
    if ((signalType >> 1) == 0) {
        if (quantOffset == 0) { return 100; }
        return 240;
    }
    if (quantOffset == 0) { return 32; }
    return 100;
}

# st layout (i64):  0 fs_kHz 1 LPC_order 2 frame_length 3 subfr_length 4 ltp_mem_length
#   5 nb_subfr 6 prev_gain_Q16 7 prevSignalType 8 lagPrev 9 lossCnt
#   10 exc_Q14(ptr) 11 sLPC_Q14_buf(ptr,16) 12 outBuf(ptr, ltp_mem_length+frame_length)
# ctrl layout (i64): 0 PredCoef0(ptr) 1 PredCoef1(ptr) 2 Gains(ptr,4) 3 pitchL(ptr,4)
#   4 LTPCoef(ptr,20) 5 LTPscale 6 signalType 7 quantOffset 8 seed 9 ninterp
fn silk_decode_core(st, ctrl, xq, pulses) {
    var LPC_order = load64(st + 1 * 8);
    var frame_length = load64(st + 2 * 8);
    var subfr_length = load64(st + 3 * 8);
    var ltp_mem = load64(st + 4 * 8);
    var nb_subfr = load64(st + 5 * 8);
    var exc = load64(st + 10 * 8);
    var sLPCbuf = load64(st + 11 * 8);
    var outBuf = load64(st + 12 * 8);
    var signalType = load64(ctrl + 6 * 8);
    var quantOffset = load64(ctrl + 7 * 8);
    var seed = load64(ctrl + 8 * 8);
    var ninterp = load64(ctrl + 9 * 8);
    var gains = load64(ctrl + 2 * 8);
    var pitchL = load64(ctrl + 3 * 8);
    var ltpcoef = load64(ctrl + 4 * 8);
    var ltpscale = load64(ctrl + 5 * 8);

    var sLTP = alloc(ltp_mem * 8);
    var sLTP_Q15 = alloc((ltp_mem + frame_length) * 8);
    var res = alloc(subfr_length * 8);
    var sLPC = alloc((subfr_length + 16) * 8);

    var offset_Q10 = silk_quant_offset(signalType, quantOffset);
    var nlsf_interp_flag = 0;
    if (ninterp < 4) { nlsf_interp_flag = 1; }

    # Decode excitation into exc[]
    var rand_seed = seed;
    var i = 0;
    while (i < frame_length) {
        rand_seed = silk_sx32(907633515 + rand_seed * 196314165);   # silk_RAND
        var e = load64(pulses + i * 8) << 14;
        if (e > 0) { e = e - 1280; }
        else { if (e < 0) { e = e + 1280; } }
        e = e + (offset_Q10 << 4);
        if (rand_seed < 0) { e = 0 - e; }
        store64(exc + i * 8, e);
        rand_seed = silk_sx32(rand_seed + load64(pulses + i * 8));   # ADD32_ovflw
        i = i + 1;
    }

    # Copy LPC state
    i = 0;
    while (i < 16) { store64(sLPC + i * 8, load64(sLPCbuf + i * 8)); i = i + 1; }

    var sLTP_buf_idx = ltp_mem;
    var prev_gain = load64(st + 6 * 8);
    var k = 0;
    while (k < nb_subfr) {
        var A = load64(ctrl + 0 * 8);
        if ((k >> 1) == 1) { A = load64(ctrl + 1 * 8); }
        var B = ltpcoef + (k * 5) * 8;
        var gk = load64(gains + k * 8);
        var Gain_Q10 = sar(gk, 6);
        var inv_gain = silk_inverse32_varq(gk, 47);

        var gain_adj = 1 << 16;
        if (gk != prev_gain) {
            gain_adj = silk_div32_varq(prev_gain, gk, 16);
            var g = 0;
            while (g < 16) { store64(sLPC + g * 8, silk_smulww(gain_adj, load64(sLPC + g * 8))); g = g + 1; }
        }
        prev_gain = gk;

        # (PLC transition path omitted: lossCnt == 0 for clean decode)
        var pexc_base = k * subfr_length;    # index into exc for this subframe

        if (signalType == 2) {
            var lag = load64(pitchL + k * 8);
            if ((k == 0) | ((k == 2) & (nlsf_interp_flag == 1))) {
                var start_idx = ltp_mem - lag - LPC_order - 2;
                if (k == 2) {
                    # outBuf[ltp_mem .. ltp_mem+2*subfr_length) = xq[0..2*subfr_length)
                    var c = 0;
                    while (c < 2 * subfr_length) { store64(outBuf + (ltp_mem + c) * 8, load64(xq + c * 8)); c = c + 1; }
                }
                silk_lpc_analysis_filter(sLTP + start_idx * 8,
                    outBuf + (start_idx + k * subfr_length) * 8, A, ltp_mem - start_idx, LPC_order);
                if (k == 0) {
                    inv_gain = silk_smulwb(inv_gain, ltpscale) << 2;
                }
                i = 0;
                while (i < lag + 2) {
                    store64(sLTP_Q15 + (sLTP_buf_idx - i - 1) * 8,
                        silk_smulwb(inv_gain, load64(sLTP + (ltp_mem - i - 1) * 8)));
                    i = i + 1;
                }
            } else {
                if (gain_adj != (1 << 16)) {
                    i = 0;
                    while (i < lag + 2) {
                        store64(sLTP_Q15 + (sLTP_buf_idx - i - 1) * 8,
                            silk_smulww(gain_adj, load64(sLTP_Q15 + (sLTP_buf_idx - i - 1) * 8)));
                        i = i + 1;
                    }
                }
            }
        }

        # Long-term prediction -> res[], or pres = exc for unvoiced
        var pres_is_exc = 1;
        if (signalType == 2) {
            pres_is_exc = 0;
            var lag2 = load64(pitchL + k * 8);
            var plp = sLTP_buf_idx - lag2 + 2;    # pred_lag_ptr index base
            i = 0;
            while (i < subfr_length) {
                var ltp = 2;
                ltp = silk_smlawb(ltp, load64(sLTP_Q15 + (plp + i) * 8), load64(B + 0));
                ltp = silk_smlawb(ltp, load64(sLTP_Q15 + (plp + i - 1) * 8), load64(B + 1 * 8));
                ltp = silk_smlawb(ltp, load64(sLTP_Q15 + (plp + i - 2) * 8), load64(B + 2 * 8));
                ltp = silk_smlawb(ltp, load64(sLTP_Q15 + (plp + i - 3) * 8), load64(B + 3 * 8));
                ltp = silk_smlawb(ltp, load64(sLTP_Q15 + (plp + i - 4) * 8), load64(B + 4 * 8));
                var pr = silk_sx32(load64(exc + (pexc_base + i) * 8) + (ltp << 1));
                store64(res + i * 8, pr);
                store64(sLTP_Q15 + sLTP_buf_idx * 8, pr << 1);
                sLTP_buf_idx = sLTP_buf_idx + 1;
                i = i + 1;
            }
        }

        # Short-term (LPC) prediction + gain scale -> xq
        i = 0;
        while (i < subfr_length) {
            var lpc = sar(LPC_order, 1);
            var j = 0;
            while (j < LPC_order) {
                lpc = silk_smlawb(lpc, load64(sLPC + (16 + i - 1 - j) * 8), load64(A + j * 8));
                j = j + 1;
            }
            var pr = load64(exc + (pexc_base + i) * 8);
            if (pres_is_exc == 0) { pr = load64(res + i * 8); }
            var s = silk_add_sat32(pr, silk_lshift_sat32(lpc, 4));
            store64(sLPC + (16 + i) * 8, s);
            store64(xq + (k * subfr_length + i) * 8,
                silk_sat16(silk_rshift_round(silk_smulww(s, Gain_Q10), 8)));
            i = i + 1;
        }

        # Shift LPC state: sLPC[0..15] = sLPC[subfr_length..subfr_length+15]
        i = 0;
        while (i < 16) { store64(sLPC + i * 8, load64(sLPC + (subfr_length + i) * 8)); i = i + 1; }
        k = k + 1;
    }

    # Save LPC state + prev_gain
    i = 0;
    while (i < 16) { store64(sLPCbuf + i * 8, load64(sLPC + i * 8)); i = i + 1; }
    store64(st + 6 * 8, prev_gain);
    return 0;
}

# ============================================================================
# SILK ENCODE — bitstream layer (v2.8.0)
# ============================================================================
# silk_encode_indices (encode_indices.c) — the exact inverse of
# silk_decode_indices_ec_cond above, field for field and table for table. The
# `idx` buffer uses the SAME layout the decoder fills, so a decode->encode round
# trip reproduces the original bytes:
#     0 signalType   1 quantOffset   2..5 gain indices   6..9 gains (Q16, unused
#     here)   10 NLSF stage-1   11 NLSF interp   12 lagIndex   13 contourIndex
#     14 PERIndex   15 LTP_scaleIndex   16 seed   17 (ec_tell, unused)
#     18..18+order NLSF indices (stage-1 then `order` residuals)
#     19+order..    LTP gain indices
# `cond` is condCoding (0 independent, 1 conditional); `ecprev` is the 2-slot
# [ec_prevSignalType, ec_prevLagIndex] predictor state, matching the decoder.
fn silk_encode_indices_ec(ec, fs_kHz, idx, nb_subfr, cond, ecprev) {
    if (_silk_type_VAD == 0) { _silk_tables_init(); }
    if (_silk_ec_sel_nb == 0) { _silk_tables2_init(); }
    if (_silk_contour_10_wb == 0) { _silk_tables6_init(); }
    var order = 16;
    if (fs_kHz < 16) { order = 10; }
    var signalType = load64(idx + 0 * 8);
    var quantOffset = load64(idx + 1 * 8);

    # A: signal type + quantizer offset
    var typeOffset = 2 * signalType + quantOffset;
    if (typeOffset >= 2) { ec_enc_icdf(ec, typeOffset - 2, _silk_type_VAD, 8); }
    else { ec_enc_icdf(ec, typeOffset, _silk_type_noVAD, 8); }

    # B: gains — first subframe conditional or two-stage absolute, rest delta
    var g0 = load64(idx + 2 * 8);
    if (cond == 1) {
        ec_enc_icdf(ec, g0, _silk_delta_gain, 8);
    } else {
        ec_enc_icdf(ec, g0 >> 3, _silk_gain_iCDF + signalType * 8, 8);
        ec_enc_icdf(ec, g0 & 7, _silk_uniform8, 8);
    }
    var i = 1;
    while (i < nb_subfr) { ec_enc_icdf(ec, load64(idx + (2 + i) * 8), _silk_delta_gain, 8); i = i + 1; }

    # C: NLSF stage-1 index
    var cb1 = _silk_cb1_wb;
    if (fs_kHz < 16) { cb1 = _silk_cb1_nb; }
    var nlsf0 = load64(idx + 18 * 8);
    ec_enc_icdf(ec, nlsf0, cb1 + (signalType >> 1) * 32, 8);

    # D: NLSF stage-2 residuals, with the extension codebook at the extremes
    var ec_ix = alloc(order * 8);
    var pred = alloc(order);
    silk_nlsf_unpack(nlsf0, fs_kHz, ec_ix, pred);
    var ec_icdf = _silk_ec_icdf_wb;
    if (fs_kHz < 16) { ec_icdf = _silk_ec_icdf_nb; }
    i = 0;
    while (i < order) {
        var v = load64(idx + (19 + i) * 8);
        if (v >= 4) {
            ec_enc_icdf(ec, 8, ec_icdf + load64(ec_ix + i * 8), 8);
            ec_enc_icdf(ec, v - 4, _silk_nlsf_ext, 8);
        } else {
            if (v <= 0 - 4) {
                ec_enc_icdf(ec, 0, ec_icdf + load64(ec_ix + i * 8), 8);
                ec_enc_icdf(ec, (0 - v) - 4, _silk_nlsf_ext, 8);
            } else {
                ec_enc_icdf(ec, v + 4, ec_icdf + load64(ec_ix + i * 8), 8);
            }
        }
        i = i + 1;
    }

    # E: NLSF interpolation factor — only for 20 ms (nb_subfr == 4)
    if (nb_subfr == 4) { ec_enc_icdf(ec, load64(idx + 11 * 8), _silk_nlsf_interp, 8); }

    if (signalType == 2) {
        # F: pitch lag — delta from the previous frame when conditional coding
        # allows it, otherwise absolute as high/low parts.
        var lagIndex = load64(idx + 12 * 8);
        var absolute = 1;
        if (cond == 1) {
            if (load64(ecprev + 0) == 2) {
                var dl = lagIndex - load64(ecprev + 8);
                if (dl < 0 - 8) { dl = 0; } else { if (dl > 11) { dl = 0; } else { dl = dl + 9; absolute = 0; } }
                ec_enc_icdf(ec, dl, _silk_pitch_delta, 8);
            }
        }
        if (absolute == 1) {
            var half = fs_kHz >> 1;
            var hi = lagIndex / half;
            var lo = lagIndex - hi * half;
            ec_enc_icdf(ec, hi, _silk_pitch_lag, 8);
            var lowbits = _silk_uniform8;
            if (fs_kHz == 12) { lowbits = _silk_uniform6; }
            if (fs_kHz == 8) { lowbits = _silk_uniform4; }
            ec_enc_icdf(ec, lo, lowbits, 8);
        }
        store64(ecprev + 8, lagIndex);

        # G: pitch contour — codebook per bandwidth and frame size
        var contour = _silk_pitch_contour;
        if (fs_kHz == 8) { contour = _silk_pitch_contour_nb; }
        if (nb_subfr == 2) {
            contour = _silk_contour_10_wb;
            if (fs_kHz == 8) { contour = _silk_contour_10_nb; }
        }
        ec_enc_icdf(ec, load64(idx + 13 * 8), contour, 8);

        # H: LTP periodicity index + per-subframe gain indices
        var PER = load64(idx + 14 * 8);
        ec_enc_icdf(ec, PER, _silk_ltp_per, 8);
        var ltpgain = _silk_ltp_gain0;
        if (PER == 1) { ltpgain = _silk_ltp_gain1; }
        if (PER == 2) { ltpgain = _silk_ltp_gain2; }
        var lbase = 19 + order;
        var k = 0;
        while (k < nb_subfr) { ec_enc_icdf(ec, load64(idx + (lbase + k) * 8), ltpgain, 8); k = k + 1; }

        # I: LTP scaling — only sent on an independently coded frame
        if (cond == 0) { ec_enc_icdf(ec, load64(idx + 15 * 8), _silk_ltpscale, 8); }
    }
    store64(ecprev + 0, signalType);

    # J: seed
    ec_enc_icdf(ec, load64(idx + 16 * 8), _silk_uniform4, 8);
    return 0;
}

# silk_ROR32 — 32-bit rotate right; a negative count rotates left.
fn silk_ror32(a32, rot) {
    var x = a32 & 0xFFFFFFFF;
    if (rot == 0) { return silk_sx32(x); }
    if (rot < 0) {
        var m = 0 - rot;
        return silk_sx32(((x << m) | (x >> (32 - m))) & 0xFFFFFFFF);
    }
    return silk_sx32(((x << (32 - rot)) | (x >> rot)) & 0xFFFFFFFF);
}

# silk_lin2log (lin2log.c): piece-wise parabolic log2, output in Q7.
# The inverse of silk_log2lin above, and the front half of gain quantisation.
fn silk_lin2log(inLin) {
    var lz = silk_clz32(inLin);
    var frac_Q7 = silk_ror32(inLin, 24 - lz) & 0x7F;
    return silk_smlawb(frac_Q7, silk_mul(frac_Q7, 128 - frac_Q7), 179) + ((31 - lz) << 7);
}

# silk_gains_quant (gain_quant.c) — the exact inverse of _silk_gains_dequant_impl.
# Writes the gain indices to `ind`, replaces `gains_q16` with the QUANTISED gains
# (what the decoder will reconstruct), and advances `lastgain_ptr`.
#   OFFSET 2090, SCALE_Q16 2251, INV_SCALE_Q16 1907825, N_LEVELS_QGAIN 64,
#   MIN/MAX_DELTA_GAIN_QUANT -4/36 — taken from libopus's own headers, not derived.
fn silk_gains_quant(ind, gains_q16, lastgain_ptr, conditional, nb_subfr) {
    var prev_ind = load64(lastgain_ptr);
    var k = 0;
    while (k < nb_subfr) {
        # log scale, scale, floor
        var v = silk_smulwb(2251, silk_lin2log(load64(gains_q16 + k * 8)) - 2090);
        # round towards the previous quantised gain (hysteresis)
        if (v < prev_ind) { v = v + 1; }
        if (v < 0) { v = 0; }
        if (v > 63) { v = 63; }

        if ((k == 0) & (conditional == 0)) {
            var lo = prev_ind - 4;               # + MIN_DELTA_GAIN_QUANT
            if (v < lo) { v = lo; }
            if (v > 63) { v = 63; }
            if (v < 0) { v = 0; }
            prev_ind = v;
            store64(ind + k * 8, v);
        } else {
            var d = v - prev_ind;
            # Double the step for large increases so the top level stays reachable.
            var thr = 2 * 36 - 64 + prev_ind;
            if (d > thr) { d = thr + ((d - thr + 1) >> 1); }
            if (d < 0 - 4) { d = 0 - 4; }
            if (d > 36) { d = 36; }
            if (d > thr) {
                prev_ind = prev_ind + ((d << 1) - thr);
                if (prev_ind > 63) { prev_ind = 63; }
            } else {
                prev_ind = prev_ind + d;
            }
            store64(ind + k * 8, d - (0 - 4));   # shift to non-negative
        }

        var il = silk_smulwb(1907825, prev_ind) + 2090;
        if (il > 3967) { il = 3967; }
        store64(gains_q16 + k * 8, silk_log2lin(il));
        k = k + 1;
    }
    store64(lastgain_ptr, prev_ind);
    return 0;
}

# ---- SILK ENCODE: LPC -> NLSF (A2NLSF.c) ------------------------------------
# Fixed point even in libopus's float build, so this must reproduce the integer
# arithmetic exactly -- the decoder's silk_NLSF2A is its inverse and any drift
# shows up as a different NLSF index.

# silk_bwexpander_32: chirp the coefficients toward the origin (Q16 in place).
fn silk_bwexpander_32(ar, d, chirp_Q16) {
    var chirp = chirp_Q16;
    var chirp_minus_one = chirp - 65536;
    var i = 0;
    while (i < d - 1) {
        store64(ar + i * 8, silk_smulww(chirp, load64(ar + i * 8)));
        chirp = chirp + silk_rshift_round(silk_mul(chirp, chirp_minus_one), 16);
        i = i + 1;
    }
    store64(ar + (d - 1) * 8, silk_smulww(chirp, load64(ar + (d - 1) * 8)));
    return 0;
}

# Transform a polynomial from the cos(n*f) basis to cos(f)^n.
fn _silk_a2nlsf_trans_poly(pp, dd) {
    var k = 2;
    while (k <= dd) {
        var n = dd;
        while (n > k) {
            store64(pp + (n - 2) * 8, load64(pp + (n - 2) * 8) - load64(pp + n * 8));
            n = n - 1;
        }
        store64(pp + (k - 2) * 8, load64(pp + (k - 2) * 8) - (load64(pp + k * 8) << 1));
        k = k + 1;
    }
    return 0;
}

# Horner evaluation of a Q16 polynomial at a Q12 point; result Q16.
fn _silk_a2nlsf_eval_poly(pp, x, dd) {
    var y32 = load64(pp + dd * 8);
    var x_Q16 = x << 4;
    var n = dd - 1;
    while (n >= 0) {
        y32 = silk_smlaww(load64(pp + n * 8), y32, x_Q16);
        n = n - 1;
    }
    return y32;
}

# Split the whitening filter into its symmetric (P) and antisymmetric (Q) parts,
# divide out the known roots at z = +/-1, and move to the cos(f)^n basis.
fn _silk_a2nlsf_init(a_Q16, P, Q, dd) {
    store64(P + dd * 8, 1 << 16);
    store64(Q + dd * 8, 1 << 16);
    var k = 0;
    while (k < dd) {
        var lo = load64(a_Q16 + (dd - k - 1) * 8);
        var hi = load64(a_Q16 + (dd + k) * 8);
        store64(P + k * 8, (0 - lo) - hi);
        store64(Q + k * 8, (0 - lo) + hi);
        k = k + 1;
    }
    k = dd;
    while (k > 0) {
        store64(P + (k - 1) * 8, load64(P + (k - 1) * 8) - load64(P + k * 8));
        store64(Q + (k - 1) * 8, load64(Q + (k - 1) * 8) + load64(Q + k * 8));
        k = k - 1;
    }
    _silk_a2nlsf_trans_poly(P, dd);
    _silk_a2nlsf_trans_poly(Q, dd);
    return 0;
}

# silk_A2NLSF: find the d roots of P and Q by scanning the cosine table for sign
# changes, refining each with 3 binary divisions plus one linear interpolation.
# If the roots cannot all be found the coefficients are bandwidth-expanded and
# the search restarts; after 16 such attempts it falls back to a white spectrum.
# `a_Q16` is modified in place (that is libopus's contract, not an accident).
fn silk_a2nlsf(NLSF, a_Q16, d) {
    if (_silk_lsfcos_q12 == 0) { _silk_lsfcos_init(); }
    var dd = d >> 1;
    var P = alloc((dd + 1) * 8);
    var Q = alloc((dd + 1) * 8);
    _silk_a2nlsf_init(a_Q16, P, Q, dd);

    var pp = P;
    var xlo = load64(_silk_lsfcos_q12 + 0 * 8);
    var ylo = _silk_a2nlsf_eval_poly(pp, xlo, dd);
    var root_ix = 0;
    if (ylo < 0) {
        store64(NLSF + 0 * 8, 0);
        pp = Q;
        ylo = _silk_a2nlsf_eval_poly(pp, xlo, dd);
        root_ix = 1;
    }
    var k = 1;
    var i = 0;
    var thr = 0;
    var done = 0;
    while (done == 0) {
        var xhi = load64(_silk_lsfcos_q12 + k * 8);
        var yhi = _silk_a2nlsf_eval_poly(pp, xhi, dd);

        var cross = 0;
        if ((ylo <= 0) & (yhi >= thr)) { cross = 1; }
        if ((ylo >= 0) & (yhi <= 0 - thr)) { cross = 1; }

        if (cross == 1) {
            if (yhi == 0) { thr = 1; } else { thr = 0; }
            var ffrac = 0 - 256;
            var m = 0;
            while (m < 3) {                              # BIN_DIV_STEPS_A2NLSF_FIX
                var xmid = silk_rshift_round(xlo + xhi, 1);
                var ymid = _silk_a2nlsf_eval_poly(pp, xmid, dd);
                var c2 = 0;
                if ((ylo <= 0) & (ymid >= 0)) { c2 = 1; }
                if ((ylo >= 0) & (ymid <= 0)) { c2 = 1; }
                if (c2 == 1) { xhi = xmid; yhi = ymid; }
                else { xlo = xmid; ylo = ymid; ffrac = ffrac + sar(128, m); }
                m = m + 1;
            }
            var aylo = ylo; if (aylo < 0) { aylo = 0 - aylo; }
            if (aylo < 65536) {
                var den = ylo - yhi;
                var nom = (ylo << 5) + sar(den, 1);      # 8 - BIN_DIV_STEPS = 5
                if (den != 0) { ffrac = ffrac + silk_div_trunc(nom, den); }
            } else {
                ffrac = ffrac + silk_div_trunc(ylo, sar(ylo - yhi, 5));
            }
            var val = (k << 8) + ffrac;
            if (val > 32767) { val = 32767; }
            store64(NLSF + root_ix * 8, val);
            root_ix = root_ix + 1;
            if (root_ix >= d) { done = 1; }
            else {
                pp = P;
                if ((root_ix & 1) != 0) { pp = Q; }
                xlo = load64(_silk_lsfcos_q12 + (k - 1) * 8);
                ylo = (1 - (root_ix & 2)) << 12;
            }
        } else {
            k = k + 1;
            xlo = xhi;
            ylo = yhi;
            thr = 0;
            if (k > 128) {                               # LSF_COS_TAB_SZ_FIX
                i = i + 1;
                if (i > 16) {                            # MAX_ITERATIONS_A2NLSF_FIX
                    var w = silk_div_trunc(1 << 15, d + 1);
                    store64(NLSF + 0 * 8, w);
                    var k2 = 1;
                    while (k2 < d) {
                        store64(NLSF + k2 * 8, _i16(load64(NLSF + (k2 - 1) * 8) + w));
                        k2 = k2 + 1;
                    }
                    return 0;
                }
                silk_bwexpander_32(a_Q16, d, 65536 - (1 << i));
                _silk_a2nlsf_init(a_Q16, P, Q, dd);
                pp = P;
                xlo = load64(_silk_lsfcos_q12 + 0 * 8);
                ylo = _silk_a2nlsf_eval_poly(pp, xlo, dd);
                root_ix = 0;
                if (ylo < 0) {
                    store64(NLSF + 0 * 8, 0);
                    pp = Q;
                    ylo = _silk_a2nlsf_eval_poly(pp, xlo, dd);
                    root_ix = 1;
                }
                k = 1;
            }
        }
    }
    return 0;
}

# ---- SILK ENCODE: NLSF quantisation (NLSF_VQ*.c, NLSF_del_dec_quant.c) -------
# Also fixed point in libopus's float build.

# silk_NLSF_VQ_weights_laroia: inverse-spacing weights, NLSF_W_Q = 2.
fn silk_nlsf_vq_weights_laroia(w_out, nlsf_Q15, D) {
    var t1 = load64(nlsf_Q15 + 0 * 8);
    if (t1 < 1) { t1 = 1; }
    t1 = silk_div_trunc(1 << 17, t1);                       # 1 << (15 + NLSF_W_Q)
    var t2 = load64(nlsf_Q15 + 1 * 8) - load64(nlsf_Q15 + 0 * 8);
    if (t2 < 1) { t2 = 1; }
    t2 = silk_div_trunc(1 << 17, t2);
    var v0 = t1 + t2;
    if (v0 > 32767) { v0 = 32767; }
    store64(w_out + 0 * 8, v0);

    var k = 1;
    while (k < D - 1) {
        var a = load64(nlsf_Q15 + (k + 1) * 8) - load64(nlsf_Q15 + k * 8);
        if (a < 1) { a = 1; }
        t1 = silk_div_trunc(1 << 17, a);
        var v1 = t1 + t2;
        if (v1 > 32767) { v1 = 32767; }
        store64(w_out + k * 8, v1);

        var b = load64(nlsf_Q15 + (k + 2) * 8) - load64(nlsf_Q15 + (k + 1) * 8);
        if (b < 1) { b = 1; }
        t2 = silk_div_trunc(1 << 17, b);
        var v2 = t1 + t2;
        if (v2 > 32767) { v2 = 32767; }
        store64(w_out + (k + 1) * 8, v2);
        k = k + 2;
    }
    var c = (1 << 15) - load64(nlsf_Q15 + (D - 1) * 8);
    if (c < 1) { c = 1; }
    t1 = silk_div_trunc(1 << 17, c);
    var vl = t1 + t2;
    if (vl > 32767) { vl = 32767; }
    store64(w_out + (D - 1) * 8, vl);
    return 0;
}

# silk_NLSF_VQ: weighted predictive absolute error of the input against every
# stage-1 codebook vector, used to pick survivors.
fn silk_nlsf_vq(err_Q24, in_Q15, cb_Q8, wght_Q9, K, order) {
    var i = 0;
    while (i < K) {
        var sum_error = 0;
        var pred = 0;
        var m = order - 2;
        while (m >= 0) {
            var diff = load64(in_Q15 + (m + 1) * 8) - (load8(cb_Q8 + i * order + m + 1) << 7);
            var diffw = silk_smulbb(diff, load64(wght_Q9 + (i * order + m + 1) * 8));
            var e1 = diffw - sar(pred, 1);
            if (e1 < 0) { e1 = 0 - e1; }
            sum_error = sum_error + e1;
            pred = diffw;

            diff = load64(in_Q15 + m * 8) - (load8(cb_Q8 + i * order + m) << 7);
            diffw = silk_smulbb(diff, load64(wght_Q9 + (i * order + m) * 8));
            var e2 = diffw - sar(pred, 1);
            if (e2 < 0) { e2 = 0 - e2; }
            sum_error = sum_error + e2;
            pred = diffw;
            m = m - 2;
        }
        store64(err_Q24 + i * 8, sum_error);
        i = i + 1;
    }
    return 0;
}

# silk_NLSF_del_dec_quant: delayed-decision (4-state) quantisation of the
# stage-2 residual, trading squared error against the entropy-coder rate through
# mu_Q20. Returns the winning R/D value in Q25 and fills `indices`.
fn silk_nlsf_del_dec_quant(indices, x_Q10, w_Q5, pred_coef_Q8, ec_ix, ec_rates_Q5,
                           quant_step_size_Q16, inv_quant_step_size_Q6, mu_Q20, order) {
    var NST = 4;                                    # NLSF_QUANT_DEL_DEC_STATES
    var EXT = 10;                                   # NLSF_QUANT_MAX_AMPLITUDE_EXT
    var AMP = 4;                                    # NLSF_QUANT_MAX_AMPLITUDE
    var ADJ = 102;                                  # SILK_FIX_CONST(0.1, 10)

    # Precompute the two reconstruction levels for every index.
    var out0_tab = alloc(2 * EXT * 8);
    var out1_tab = alloc(2 * EXT * 8);
    var i = 0 - EXT;
    while (i <= EXT - 1) {
        var o0 = i << 10;
        var o1 = o0 + 1024;
        if (i > 0) { o0 = o0 - ADJ; o1 = o1 - ADJ; }
        else { if (i == 0) { o1 = o1 - ADJ; }
        else { if (i == 0 - 1) { o0 = o0 + ADJ; }
        else { o0 = o0 + ADJ; o1 = o1 + ADJ; } } }
        store64(out0_tab + (i + EXT) * 8, sar(silk_smulbb(o0, quant_step_size_Q16), 16));
        store64(out1_tab + (i + EXT) * 8, sar(silk_smulbb(o1, quant_step_size_Q16), 16));
        i = i + 1;
    }

    var ind = alloc(NST * 16 * 8);
    var prev_out = alloc(2 * NST * 8);
    var RD = alloc(2 * NST * 8);
    var RD_min = alloc(NST * 8);
    var RD_max = alloc(NST * 8);
    var ind_sort = alloc(NST * 8);
    var nStates = 1;
    store64(RD + 0, 0);
    store64(prev_out + 0, 0);

    i = order - 1;
    while (i >= 0) {
        var rates = ec_rates_Q5 + load64(ec_ix + i * 8);
        var in_Q10 = load64(x_Q10 + i * 8);
        var j = 0;
        while (j < nStates) {
            var pred_Q10 = sar(silk_smulbb(load8(pred_coef_Q8 + i), load64(prev_out + j * 8)), 8);
            var res_Q10 = _i16(in_Q10 - pred_Q10);
            var ind_tmp = sar(silk_smulbb(inv_quant_step_size_Q6, res_Q10), 16);
            if (ind_tmp < 0 - EXT) { ind_tmp = 0 - EXT; }
            if (ind_tmp > EXT - 1) { ind_tmp = EXT - 1; }
            store64(ind + (j * 16 + i) * 8, ind_tmp);

            var o0q = _i16(load64(out0_tab + (ind_tmp + EXT) * 8) + pred_Q10);
            var o1q = _i16(load64(out1_tab + (ind_tmp + EXT) * 8) + pred_Q10);
            store64(prev_out + j * 8, o0q);
            store64(prev_out + (j + nStates) * 8, o1q);

            var rate0 = 0;
            var rate1 = 0;
            if (ind_tmp + 1 >= AMP) {
                if (ind_tmp + 1 == AMP) {
                    rate0 = load8(rates + ind_tmp + AMP);
                    rate1 = 280;
                } else {
                    rate0 = (280 - 43 * AMP) + silk_smulbb(43, ind_tmp);
                    rate1 = rate0 + 43;
                }
            } else {
                if (ind_tmp <= 0 - AMP) {
                    if (ind_tmp == 0 - AMP) {
                        rate0 = 280;
                        rate1 = load8(rates + ind_tmp + 1 + AMP);
                    } else {
                        rate0 = (280 - 43 * AMP) + silk_smulbb(0 - 43, ind_tmp);
                        rate1 = rate0 - 43;
                    }
                } else {
                    rate0 = load8(rates + ind_tmp + AMP);
                    rate1 = load8(rates + ind_tmp + 1 + AMP);
                }
            }
            # libopus accumulates RD in opus_int32 and lets it wrap; the
            # distortion term SMULBB(d,d)*w_Q5 routinely exceeds 2^31, so the
            # wrap is part of the defined result, not an accident.
            var RD_tmp = load64(RD + j * 8);
            var d0 = _i16(in_Q10 - o0q);
            var acc0 = silk_sx32(RD_tmp + silk_sx32(silk_smulbb(d0, d0) * load64(w_Q5 + i * 8)));
            store64(RD + j * 8, silk_sx32(acc0 + silk_smulbb(mu_Q20, rate0)));
            var d1 = _i16(in_Q10 - o1q);
            var acc1 = silk_sx32(RD_tmp + silk_sx32(silk_smulbb(d1, d1) * load64(w_Q5 + i * 8)));
            store64(RD + (j + nStates) * 8, silk_sx32(acc1 + silk_smulbb(mu_Q20, rate1)));
            j = j + 1;
        }

        if (nStates <= NST / 2) {
            j = 0;
            while (j < nStates) {
                store64(ind + ((j + nStates) * 16 + i) * 8, load64(ind + (j * 16 + i) * 8) + 1);
                j = j + 1;
            }
            nStates = nStates << 1;
            j = nStates;
            while (j < NST) {
                store64(ind + (j * 16 + i) * 8, load64(ind + ((j - nStates) * 16 + i) * 8));
                j = j + 1;
            }
        } else {
            j = 0;
            while (j < NST) {
                if (load64(RD + j * 8) > load64(RD + (j + NST) * 8)) {
                    store64(RD_max + j * 8, load64(RD + j * 8));
                    store64(RD_min + j * 8, load64(RD + (j + NST) * 8));
                    store64(RD + j * 8, load64(RD_min + j * 8));
                    store64(RD + (j + NST) * 8, load64(RD_max + j * 8));
                    var sw = load64(prev_out + j * 8);
                    store64(prev_out + j * 8, load64(prev_out + (j + NST) * 8));
                    store64(prev_out + (j + NST) * 8, sw);
                    store64(ind_sort + j * 8, j + NST);
                } else {
                    store64(RD_min + j * 8, load64(RD + j * 8));
                    store64(RD_max + j * 8, load64(RD + (j + NST) * 8));
                    store64(ind_sort + j * 8, j);
                }
                j = j + 1;
            }
            var settled = 0;
            while (settled == 0) {
                var min_max = 2147483647;
                var max_min = 0;
                var ind_min_max = 0;
                var ind_max_min = 0;
                j = 0;
                while (j < NST) {
                    if (min_max > load64(RD_max + j * 8)) { min_max = load64(RD_max + j * 8); ind_min_max = j; }
                    if (max_min < load64(RD_min + j * 8)) { max_min = load64(RD_min + j * 8); ind_max_min = j; }
                    j = j + 1;
                }
                if (min_max >= max_min) { settled = 1; }
                else {
                    store64(ind_sort + ind_max_min * 8, load64(ind_sort + ind_min_max * 8) ^ NST);
                    store64(RD + ind_max_min * 8, load64(RD + (ind_min_max + NST) * 8));
                    store64(prev_out + ind_max_min * 8, load64(prev_out + (ind_min_max + NST) * 8));
                    store64(RD_min + ind_max_min * 8, 0);
                    store64(RD_max + ind_min_max * 8, 2147483647);
                    var c = 0;
                    while (c < 16) {
                        store64(ind + (ind_max_min * 16 + c) * 8, load64(ind + (ind_min_max * 16 + c) * 8));
                        c = c + 1;
                    }
                }
            }
            j = 0;
            while (j < NST) {
                store64(ind + (j * 16 + i) * 8,
                        load64(ind + (j * 16 + i) * 8) + sar(load64(ind_sort + j * 8), 2));
                j = j + 1;
            }
        }
        i = i - 1;
    }

    var ind_tmp2 = 0;
    var min_Q25 = 2147483647;
    var j2 = 0;
    while (j2 < 2 * NST) {
        if (min_Q25 > load64(RD + j2 * 8)) { min_Q25 = load64(RD + j2 * 8); ind_tmp2 = j2; }
        j2 = j2 + 1;
    }
    j2 = 0;
    while (j2 < order) {
        store64(indices + j2 * 8, load64(ind + ((ind_tmp2 & (NST - 1)) * 16 + j2) * 8));
        j2 = j2 + 1;
    }
    store64(indices + 0, load64(indices + 0) + sar(ind_tmp2, 2));
    return min_Q25;
}

