    _celt_eprob_intra1 = alloc(42);
    store8(_celt_eprob_intra1 + 0, 23); store8(_celt_eprob_intra1 + 1, 178); store8(_celt_eprob_intra1 + 2, 54); store8(_celt_eprob_intra1 + 3, 115); store8(_celt_eprob_intra1 + 4, 63); store8(_celt_eprob_intra1 + 5, 102); store8(_celt_eprob_intra1 + 6, 66); store8(_celt_eprob_intra1 + 7, 98); store8(_celt_eprob_intra1 + 8, 69); store8(_celt_eprob_intra1 + 9, 99); store8(_celt_eprob_intra1 + 10, 74); store8(_celt_eprob_intra1 + 11, 89); store8(_celt_eprob_intra1 + 12, 71); store8(_celt_eprob_intra1 + 13, 91);
    store8(_celt_eprob_intra1 + 14, 73); store8(_celt_eprob_intra1 + 15, 91); store8(_celt_eprob_intra1 + 16, 78); store8(_celt_eprob_intra1 + 17, 89); store8(_celt_eprob_intra1 + 18, 86); store8(_celt_eprob_intra1 + 19, 80); store8(_celt_eprob_intra1 + 20, 92); store8(_celt_eprob_intra1 + 21, 66); store8(_celt_eprob_intra1 + 22, 93); store8(_celt_eprob_intra1 + 23, 64); store8(_celt_eprob_intra1 + 24, 102); store8(_celt_eprob_intra1 + 25, 59); store8(_celt_eprob_intra1 + 26, 103); store8(_celt_eprob_intra1 + 27, 60);
    store8(_celt_eprob_intra1 + 28, 104); store8(_celt_eprob_intra1 + 29, 60); store8(_celt_eprob_intra1 + 30, 117); store8(_celt_eprob_intra1 + 31, 52); store8(_celt_eprob_intra1 + 32, 123); store8(_celt_eprob_intra1 + 33, 44); store8(_celt_eprob_intra1 + 34, 138); store8(_celt_eprob_intra1 + 35, 35); store8(_celt_eprob_intra1 + 36, 133); store8(_celt_eprob_intra1 + 37, 31); store8(_celt_eprob_intra1 + 38, 97); store8(_celt_eprob_intra1 + 39, 38); store8(_celt_eprob_intra1 + 40, 77); store8(_celt_eprob_intra1 + 41, 45);
    # libopus quant_bands.c: pred_coef[4] = {29440, 26112, 21248, 16384},
    #                        beta_coef[4] = {30147, 22282, 12124, 6554}, /32768.
    CELT_PRED_COEF2 = f64_div(f64_from(21248), f64_from(32768));
    CELT_BETA_COEF2 = f64_div(f64_from(12124), f64_from(32768));
    CELT_PRED_COEF1 = f64_div(f64_from(26112), f64_from(32768));
    CELT_BETA_COEF1 = f64_div(f64_from(22282), f64_from(32768));
    CELT_PRED_COEF0 = f64_div(f64_from(29440), f64_from(32768));
    CELT_BETA_COEF0 = f64_div(f64_from(30147), f64_from(32768));
    return 0;
}

# ec_laplace_get_freq1: ft=32736-fs0; return (ft*(16384-decay))>>15.
fn _ec_laplace_get_freq1(fs0, decay) {
    var ft = 32736 - fs0;
    return (ft * (16384 - decay)) >> 15;
}

# ec_laplace_decode(dec, fs, decay) -> signed energy delta qi (exact port).
fn ec_laplace_decode(ec, fs, decay) {
    var val = 0;
    var fm = ec_decode_bin(ec, 15);
    var fl = 0;
    if (fm >= fs) {
        val = 1;
        fl = fs;
        fs = _ec_laplace_get_freq1(fs, decay) + 1;
        while ((fs > 1) & (fm >= fl + 2 * fs)) {
            fs = fs * 2;
            fl = fl + fs;
            fs = ((fs - 2) * decay) >> 15;
            fs = fs + 1;
            val = val + 1;
        }
        if (fs <= 1) {
            var di = (fm - fl) >> 1;
            val = val + di;
            fl = fl + 2 * di;
        }
        if (fm < fl + fs) {
            val = 0 - val;
        } else {
            fl = fl + fs;
        }
    }
    var fh = fl + fs;
    if (fh > 32768) { fh = 32768; }
    ec_dec_update(ec, fl, fh, 32768);
    return val;
}

# ec_laplace_encode (laplace.c): encode a signed value with a Laplace-ish PDF (fs = P(0),
# decay). Inverse of ec_laplace_decode. Returns the (possibly clamped for the flat tail)
# value the decoder will recover — the caller uses it for the fine-energy error.
# LAPLACE_MINP=1, LAPLACE_LOG_MINP=0, LAPLACE_NMIN=16 (baked into _ec_laplace_get_freq1).
fn ec_laplace_encode(enc, value, fs, decay) {
    var fl = 0;
    var val = value;
    if (val != 0) {
        var s = 0 - (val < 0);            # s = -(val<0)
        val = (val + s) ^ s;              # abs(val)
        fl = fs;
        fs = _ec_laplace_get_freq1(fs, decay);
        var i = 1;
        while ((fs > 0) & (i < val)) {
            fs = fs * 2;
            fl = fl + fs + 2;             # fl += fs + 2*LAPLACE_MINP
            fs = (fs * decay) >> 15;
            i = i + 1;
        }
        if (fs == 0) {
            var ndi_max = 32768 - fl;     # (32768-fl+MINP-1)>>LOG_MINP
            ndi_max = (ndi_max - s) >> 1;
            var di = val - i;
            if (ndi_max - 1 < di) { di = ndi_max - 1; }
            fl = fl + (2 * di + 1 + s);   # *LAPLACE_MINP
            fs = 1;
            if (32768 - fl < 1) { fs = 32768 - fl; }
            value = (i + di + s) ^ s;
        } else {
            fs = fs + 1;                  # fs += LAPLACE_MINP
            fl = fl + (fs & (0 - 1 - s)); # fl += fs & ~s
        }
    }
    ec_encode_bin(enc, fl, fl + fs, 15);
    return value;
}

# unquant_coarse_energy: fills oldEBands[0..C*21) with base-2 log energies.
# `intra` is decoded by the caller (orchestration) and passed in.
fn celt_unquant_coarse_energy(oldEBands, intra, ec, C, start, end, LM) {
    if (_celt_eprob_inter == 0) { _celt_energy_tables_init(); }
    var prob = 0;
    var coef = F64_ZERO;
    var beta = F64_ZERO;
    # Energy model + prediction coefficients are per-frame-size (LM). beta_intra shared.
    if (intra != 0) {
        prob = _celt_eprob_intra;
        if (LM == 2) { prob = _celt_eprob_intra2; }
        if (LM == 1) { prob = _celt_eprob_intra1; }
        if (LM == 0) { prob = _celt_eprob_intra0; }
        coef = F64_ZERO;
        beta = CELT_BETA_INTRA;
    } else {
        prob = _celt_eprob_inter;
        coef = CELT_PRED_COEF3;
        beta = CELT_BETA_COEF3;
        if (LM == 2) { prob = _celt_eprob_inter2; coef = CELT_PRED_COEF2; beta = CELT_BETA_COEF2; }
        if (LM == 1) { prob = _celt_eprob_inter1; coef = CELT_PRED_COEF1; beta = CELT_BETA_COEF1; }
        if (LM == 0) { prob = _celt_eprob_inter0; coef = CELT_PRED_COEF0; beta = CELT_BETA_COEF0; }
    }
    var budget = load64(ec + 8) * 8;
    var prev0 = F64_ZERO;
    var prev1 = F64_ZERO;
    var neg9 = f64_neg(f64_from(9));
    var i = start;
    while (i < end) {
        var c = 0;
        while (c < C) {
            var idx = i + c * CELT_NB_EBANDS;
            var tell = ec_tell(ec);
            var qi = 0;
            if (budget - tell >= 15) {
                var pi = 2 * i;   # min(i,20)=i for i<21
                qi = ec_laplace_decode(ec, load8(prob + pi) << 7, load8(prob + pi + 1) << 6);
            } else {
                if (budget - tell >= 2) {
                    var sym = ec_dec_icdf(ec, _celt_small_en_icdf, 2);
                    qi = (sym >> 1) ^ (0 - (sym & 1));
                } else {
                    if (budget - tell >= 1) {
                        qi = 0 - ec_dec_bit_logp(ec, 1);
                    } else {
                        qi = 0 - 1;
                    }
                }
            }
            var q = f64_from(qi);
            var oldE = load64(oldEBands + idx * 8);
            oldE = f64_max(neg9, oldE);
            var prevc = prev0;
            if (c == 1) { prevc = prev1; }
            var tmp = f64_add(f64_add(f64_mul(coef, oldE), prevc), q);
            store64(oldEBands + idx * 8, tmp);
            # prev[c] += q - beta*q
            var np = f64_add(prevc, f64_sub(q, f64_mul(beta, q)));
            if (c == 1) { prev1 = np; } else { prev0 = np; }
            c = c + 1;
        }
        i = i + 1;
    }
    return 0;
}

# unquant_fine_energy: adds fine corrections (raw bits from the back).
fn celt_unquant_fine_energy(oldEBands, fine_quant, ec, C, start, end) {
    var i = start;
    while (i < end) {
        var extra = load64(fine_quant + i * 8);
        if (extra <= 0) {
            i = i + 1;
        } else {
            if (ec_tell(ec) + C * extra > load64(ec + 8) * 8) {
                i = i + 1;
            } else {
                var c = 0;
                while (c < C) {
                    var idx = i + c * CELT_NB_EBANDS;
                    var q2 = ec_dec_bits(ec, extra);
                    # offset = (q2+0.5)/(1<<extra) - 0.5   (prev==0 factor is 1.0)
                    var num = f64_add(f64_from(q2), F64_HALF);
                    var den = f64_from(1 << extra);
                    var offset = f64_sub(f64_div(num, den), F64_HALF);
                    store64(oldEBands + idx * 8, f64_add(load64(oldEBands + idx * 8), offset));
                    c = c + 1;
                }
                i = i + 1;
            }
        }
    }
    return 0;
}

# unquant_energy_finalise: use leftover bits, 1 per (band,ch), two priority passes.
fn celt_unquant_energy_finalise(oldEBands, fine_quant, fine_priority, bits_left, ec, C, start, end) {
    var prio = 0;
    while (prio < 2) {
        var i = start;
        while ((i < end) & (bits_left >= C)) {
            var fq = load64(fine_quant + i * 8);
            if ((fq >= CELT_MAX_FINE_BITS) | (load64(fine_priority + i * 8) != prio)) {
                i = i + 1;
            } else {
                var c = 0;
                while (c < C) {
                    var idx = i + c * CELT_NB_EBANDS;
                    var q2 = ec_dec_bits(ec, 1);
                    # offset = (q2-0.5)/(1<<(fq+1))
                    var den = f64_from(1 << (fq + 1));
                    var offset = f64_div(f64_sub(f64_from(q2), F64_HALF), den);
                    store64(oldEBands + idx * 8, f64_add(load64(oldEBands + idx * 8), offset));
                    bits_left = bits_left - 1;
                    c = c + 1;
                }
                i = i + 1;
            }
        }
        prio = prio + 1;
    }
    return 0;
}

# ================================================================
# CELT band-energy ENCODE (quant_bands.c) — inverse of the unquant path above.
# ================================================================
# quant_coarse_energy_impl: encode target log-energies eBands[] with intra/inter prediction
# + Laplace coding, updating oldEBands in place and writing the residual to error[]. Mirrors
# celt_unquant_coarse_energy exactly. Returns "badness" (sum of clamp adjustments).
fn quant_coarse_energy_impl(start, end, eBands, oldEBands, budget, prob, error, enc, C, LM, intra, max_decay) {
    var badness = 0;
    var coef = F64_ZERO;
    var beta = CELT_BETA_INTRA;
    if (intra == 0) {
        coef = CELT_PRED_COEF3; beta = CELT_BETA_COEF3;
        if (LM == 2) { coef = CELT_PRED_COEF2; beta = CELT_BETA_COEF2; }
    }
    if (ec_tell(enc) + 3 <= budget) { ec_enc_bit_logp(enc, intra, 3); }
    var prev0 = F64_ZERO;
    var prev1 = F64_ZERO;
    var neg9 = f64_neg(f64_from(9));
    var neg28 = f64_neg(f64_from(28));
    var i = start;
    while (i < end) {
        var c = 0;
        while (c < C) {
            var idx = i + c * CELT_NB_EBANDS;
            var prevc = prev0;
            if (c == 1) { prevc = prev1; }
            var x = load64(eBands + idx * 8);
            var oldEraw = load64(oldEBands + idx * 8);
            var oldE = f64_max(neg9, oldEraw);
            var f = f64_sub(f64_sub(x, f64_mul(coef, oldE)), prevc);
            # qi = floor(0.5 + f)
            var yv = f64_add(f, F64_HALF);
            var qi = f64_to(yv);
            if (f64_lt(yv, f64_from(qi)) == 1) { qi = qi - 1; }
            # prevent energy dropping too fast
            var decay_bound = f64_sub(f64_max(neg28, oldEraw), max_decay);
            if ((qi < 0) & (f64_lt(x, decay_bound) == 1)) {
                qi = qi + f64_to(f64_sub(decay_bound, x));
                if (qi > 0) { qi = 0; }
            }
            var qi0 = qi;
            var t2 = ec_tell(enc);
            var bits_left = budget - t2 - 3 * C * (end - i);
            if ((i != start) & (bits_left < 30)) {
                if ((bits_left < 24) & (qi > 1)) { qi = 1; }
                if ((bits_left < 16) & (qi < 0 - 1)) { qi = 0 - 1; }
            }
            if (budget - t2 >= 15) {
                var pi = 2 * i;                 # 2*min(i,20), i<21
                qi = ec_laplace_encode(enc, qi, load8(prob + pi) << 7, load8(prob + pi + 1) << 6);
            } else {
                if (budget - t2 >= 2) {
                    if (qi > 1) { qi = 1; }
                    if (qi < 0 - 1) { qi = 0 - 1; }
                    ec_enc_icdf(enc, (2 * qi) ^ (0 - (qi < 0)), _celt_small_en_icdf, 2);
                } else {
                    if (budget - t2 >= 1) {
                        if (qi > 0) { qi = 0; }
                        ec_enc_bit_logp(enc, 0 - qi, 1);
                    } else {
                        qi = 0 - 1;
                    }
                }
            }
            var q = f64_from(qi);
            store64(error + idx * 8, f64_sub(f, q));
            var d = qi0 - qi;
            if (d < 0) { d = 0 - d; }
            badness = badness + d;
            store64(oldEBands + idx * 8, f64_add(f64_add(f64_mul(coef, oldE), prevc), q));
            var np = f64_add(prevc, f64_sub(q, f64_mul(beta, q)));
            if (c == 1) { prev1 = np; } else { prev0 = np; }
            c = c + 1;
        }
        i = i + 1;
    }
    return badness;
}

# quant_coarse_energy: single-pass coarse-energy encode (choose intra via `force_intra` +
# the budget guard; select the per-(LM,intra) probability model). The full libopus 2-pass
# intra-vs-inter size race is a bit-allocation optimization on top of this and is a separate
# step — this pass already produces a correct, decodable stream. budget/max_decay per libopus.
# quant_coarse_energy: the 2-pass intra/inter race (quant_bands.c). Unless intra is forced,
# encode both an intra pass (into a scratch state) and an inter pass, then keep whichever spends
# fewer bits (lower badness, tie → fewer bits) by restoring the winner's range-coder state + the
# bytes it flushed. Coarse energy writes only front (range) bytes, so a 12-slot ec-state copy +
# the [nstart,nintra) byte range fully captures a pass. Returns the chosen intra flag.
fn quant_coarse_energy(start, end, eBands, oldEBands, error, enc, C, LM, force_intra, nbAvailableBytes) {
    if (_celt_eprob_inter == 0) { _celt_energy_tables_init(); }
    var budget = load64(enc + 8) * 8;
    var two_pass = 1;
    var intra = force_intra;
    if (ec_tell(enc) + 3 > budget) { two_pass = 0; intra = 0; }
    var max_decay = f64_from(16);
    if (end - start > 10) {
        var md2 = f64_mul(f64_div(F64_ONE, f64_from(8)), f64_from(nbAvailableBytes));
        if (f64_lt(md2, max_decay) == 1) { max_decay = md2; }
    }
    var prob_intra = _celt_eprob_intra; if (LM == 2) { prob_intra = _celt_eprob_intra2; }
    var prob_inter = _celt_eprob_inter; if (LM == 2) { prob_inter = _celt_eprob_inter2; }
    var enc_start = alloc(96);
    var k = 0; while (k < 12) { store64(enc_start + k * 8, load64(enc + k * 8)); k = k + 1; }
    var oldE_intra = alloc(C * 21 * 8);
    var err_intra = alloc(C * 21 * 8);
    k = 0; while (k < C * 21) { store64(oldE_intra + k * 8, load64(oldEBands + k * 8)); k = k + 1; }
    var badness1 = 0;
    if ((two_pass != 0) | (intra != 0)) {
        badness1 = quant_coarse_energy_impl(start, end, eBands, oldE_intra, budget, prob_intra, err_intra, enc, C, LM, 1, max_decay);
    }
    if (intra == 0) {
        var tell_intra = ec_tell_frac(enc);
        var enc_intra = alloc(96);
        k = 0; while (k < 12) { store64(enc_intra + k * 8, load64(enc + k * 8)); k = k + 1; }
        var nstart = load64(enc_start + 48);
        var save_n = load64(enc + 48) - nstart;
        var buf = load64(enc + 0);
        var intra_bytes = alloc(save_n + 1);
        var b = 0; while (b < save_n) { store8(intra_bytes + b, load8(buf + nstart + b)); b = b + 1; }
        k = 0; while (k < 12) { store64(enc + k * 8, load64(enc_start + k * 8)); k = k + 1; }
        var badness2 = quant_coarse_energy_impl(start, end, eBands, oldEBands, budget, prob_inter, error, enc, C, LM, 0, max_decay);
        var pick_intra = 0;
        if (two_pass != 0) {
            if (badness1 < badness2) { pick_intra = 1; }
            else { if ((badness1 == badness2) & (ec_tell_frac(enc) > tell_intra)) { pick_intra = 1; } }
        }
        if (pick_intra == 1) {
            k = 0; while (k < 12) { store64(enc + k * 8, load64(enc_intra + k * 8)); k = k + 1; }
            b = 0; while (b < save_n) { store8(buf + nstart + b, load8(intra_bytes + b)); b = b + 1; }
            k = 0; while (k < C * 21) { store64(oldEBands + k * 8, load64(oldE_intra + k * 8)); store64(error + k * 8, load64(err_intra + k * 8)); k = k + 1; }
            intra = 1;
        } else {
            intra = 0;
        }
    } else {
        k = 0; while (k < C * 21) { store64(oldEBands + k * 8, load64(oldE_intra + k * 8)); store64(error + k * 8, load64(err_intra + k * 8)); k = k + 1; }
    }
    return intra;
}

# quant_fine_energy: encode the fine-resolution refinement bits (raw bits, prev=0 base path).
fn quant_fine_energy(oldEBands, error, fine_quant, enc, C, start, end) {
    var i = start;
    while (i < end) {
        var fq = load64(fine_quant + i * 8);
        if (fq <= 0) {
            i = i + 1;
        } else {
            if (ec_tell(enc) + C * fq > load64(enc + 8) * 8) {
                i = i + 1;
            } else {
                var extra = 1 << fq;
                var c = 0;
                while (c < C) {
                    var idx = i + c * CELT_NB_EBANDS;
                    # q2 = floor((error+0.5)*extra), clamped to [0, extra-1]
                    var q2 = f64_to(f64_mul(f64_add(load64(error + idx * 8), F64_HALF), f64_from(extra)));
                    if (q2 > extra - 1) { q2 = extra - 1; }
                    if (q2 < 0) { q2 = 0; }
                    ec_enc_bits(enc, q2, fq);
                    var offset = f64_sub(f64_div(f64_add(f64_from(q2), F64_HALF), f64_from(extra)), F64_HALF);
                    store64(oldEBands + idx * 8, f64_add(load64(oldEBands + idx * 8), offset));
                    store64(error + idx * 8, f64_sub(load64(error + idx * 8), offset));
                    c = c + 1;
                }
                i = i + 1;
            }
        }
    }
    return 0;
}

# quant_energy_finalise: spend the remaining bits, 1 per band per priority pass.
fn quant_energy_finalise(oldEBands, error, fine_quant, fine_priority, bits_left, enc, C, start, end) {
    var prio = 0;
    while (prio < 2) {
        var i = start;
        while ((i < end) & (bits_left >= C)) {
            var fq = load64(fine_quant + i * 8);
            if ((fq >= CELT_MAX_FINE_BITS) | (load64(fine_priority + i * 8) != prio)) {
                i = i + 1;
            } else {
                var c = 0;
                while (c < C) {
                    var idx = i + c * CELT_NB_EBANDS;
                    var q2 = 0;
                    if (f64_lt(load64(error + idx * 8), F64_ZERO) == 0) { q2 = 1; }
                    ec_enc_bits(enc, q2, 1);
                    var offset = f64_div(f64_sub(f64_from(q2), F64_HALF), f64_from(1 << (fq + 1)));
                    store64(oldEBands + idx * 8, f64_add(load64(oldEBands + idx * 8), offset));
                    store64(error + idx * 8, f64_sub(load64(error + idx * 8), offset));
                    bits_left = bits_left - 1;
                    c = c + 1;
                }
                i = i + 1;
            }
        }
        prio = prio + 1;
    }
    return 0;
}

# ================================================================
# CELT allocation tables (extracted verbatim from libopus mode48000_960_120)
# ================================================================
var _celt_eBands = 0;
var _celt_logN = 0;
var _celt_cacheIdx = 0;
var _celt_tfsel = 0;   # tf_select_table[4][8], row stride 8, indexed LM*8 + 4*isTransient + 2*tf_select + tf_change
var _celt_log2frac = 0;
var _celt_allocVec = 0;
var _celt_cacheBits = 0;
var _celt_cacheCaps = 0;
var _celt_trimIcdf = 0;
var _celt_spreadIcdf = 0;
var _celt_tapsetIcdf = 0;

fn _celt_alloc_tables_init() {
    _celt_eBands = alloc(22 * 8);
    store64(_celt_eBands + 0 * 8, 0); store64(_celt_eBands + 1 * 8, 1); store64(_celt_eBands + 2 * 8, 2); store64(_celt_eBands + 3 * 8, 3); store64(_celt_eBands + 4 * 8, 4); store64(_celt_eBands + 5 * 8, 5);
    store64(_celt_eBands + 6 * 8, 6); store64(_celt_eBands + 7 * 8, 7); store64(_celt_eBands + 8 * 8, 8); store64(_celt_eBands + 9 * 8, 10); store64(_celt_eBands + 10 * 8, 12); store64(_celt_eBands + 11 * 8, 14);
