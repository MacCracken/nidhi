    store8(_silk_ppb_bits + 54, 125); store8(_silk_ppb_bits + 55, 74); store8(_silk_ppb_bits + 56, 59); store8(_silk_ppb_bits + 57, 69); store8(_silk_ppb_bits + 58, 97); store8(_silk_ppb_bits + 59, 141); store8(_silk_ppb_bits + 60, 182); store8(_silk_ppb_bits + 61, 255); store8(_silk_ppb_bits + 62, 255); store8(_silk_ppb_bits + 63, 255); store8(_silk_ppb_bits + 64, 255); store8(_silk_ppb_bits + 65, 255); store8(_silk_ppb_bits + 66, 255); store8(_silk_ppb_bits + 67, 255); store8(_silk_ppb_bits + 68, 255); store8(_silk_ppb_bits + 69, 255); store8(_silk_ppb_bits + 70, 255); store8(_silk_ppb_bits + 71, 255);
