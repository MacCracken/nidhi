    store64(L+ 9*8,12); store64(L+10*8,11); store64(L+11*8,10); store64(L+12*8, 9); store64(L+13*8, 8); store64(L+14*8, 9); store64(L+15*8,10); store64(L+16*8,11); store64(L+17*8,12);
    store64(L+18*8,12); store64(L+19*8,10); store64(L+20*8, 9); store64(L+21*8, 8); store64(L+22*8, 7); store64(L+23*8, 8); store64(L+24*8, 9); store64(L+25*8,10); store64(L+26*8,11);
    store64(L+27*8,11); store64(L+28*8, 9); store64(L+29*8, 8); store64(L+30*8, 5); store64(L+31*8, 4); store64(L+32*8, 5); store64(L+33*8, 8); store64(L+34*8, 9); store64(L+35*8,11);
    store64(L+36*8,10); store64(L+37*8, 8); store64(L+38*8, 7); store64(L+39*8, 4); store64(L+40*8, 1); store64(L+41*8, 4); store64(L+42*8, 7); store64(L+43*8, 8); store64(L+44*8,11);
    store64(L+45*8,11); store64(L+46*8, 9); store64(L+47*8, 8); store64(L+48*8, 5); store64(L+49*8, 4); store64(L+50*8, 5); store64(L+51*8, 8); store64(L+52*8, 9); store64(L+53*8,11);
    store64(L+54*8,11); store64(L+55*8,10); store64(L+56*8, 9); store64(L+57*8, 8); store64(L+58*8, 7); store64(L+59*8, 8); store64(L+60*8, 9); store64(L+61*8,10); store64(L+62*8,11);
    store64(L+63*8,12); store64(L+64*8,11); store64(L+65*8,10); store64(L+66*8, 9); store64(L+67*8, 8); store64(L+68*8, 9); store64(L+69*8,10); store64(L+70*8,11); store64(L+71*8,12);
    store64(L+72*8,13); store64(L+73*8,12); store64(L+74*8,12); store64(L+75*8,11); store64(L+76*8,10); store64(L+77*8,10); store64(L+78*8,11); store64(L+79*8,12); store64(L+80*8,13);
    store64(C+ 0*8,0x1fff); store64(C+ 1*8,0x0ff7); store64(C+ 2*8,0x07f4); store64(C+ 3*8,0x07e8); store64(C+ 4*8,0x03f1); store64(C+ 5*8,0x07ee); store64(C+ 6*8,0x07f9); store64(C+ 7*8,0x0ff8); store64(C+ 8*8,0x1ffd);
    store64(C+ 9*8,0x0ffd); store64(C+10*8,0x07f1); store64(C+11*8,0x03e8); store64(C+12*8,0x01e8); store64(C+13*8,0x00f0); store64(C+14*8,0x01ec); store64(C+15*8,0x03ee); store64(C+16*8,0x07f2); store64(C+17*8,0x0ffa);
    store64(C+18*8,0x0ff4); store64(C+19*8,0x03ef); store64(C+20*8,0x01f2); store64(C+21*8,0x00e8); store64(C+22*8,0x0070); store64(C+23*8,0x00ec); store64(C+24*8,0x01f0); store64(C+25*8,0x03ea); store64(C+26*8,0x07f3);
    store64(C+27*8,0x07eb); store64(C+28*8,0x01eb); store64(C+29*8,0x00ea); store64(C+30*8,0x001a); store64(C+31*8,0x0008); store64(C+32*8,0x0019); store64(C+33*8,0x00ee); store64(C+34*8,0x01ef); store64(C+35*8,0x07ed);
    store64(C+36*8,0x03f0); store64(C+37*8,0x00f2); store64(C+38*8,0x0073); store64(C+39*8,0x000b); store64(C+40*8,0x0000); store64(C+41*8,0x000a); store64(C+42*8,0x0071); store64(C+43*8,0x00f3); store64(C+44*8,0x07e9);
    store64(C+45*8,0x07ef); store64(C+46*8,0x01ee); store64(C+47*8,0x00ef); store64(C+48*8,0x0018); store64(C+49*8,0x0009); store64(C+50*8,0x001b); store64(C+51*8,0x00eb); store64(C+52*8,0x01e9); store64(C+53*8,0x07ec);
    store64(C+54*8,0x07f6); store64(C+55*8,0x03eb); store64(C+56*8,0x01f3); store64(C+57*8,0x00ed); store64(C+58*8,0x0072); store64(C+59*8,0x00e9); store64(C+60*8,0x01f1); store64(C+61*8,0x03ed); store64(C+62*8,0x07f7);
    store64(C+63*8,0x0ff6); store64(C+64*8,0x07f0); store64(C+65*8,0x03e9); store64(C+66*8,0x01ed); store64(C+67*8,0x00f1); store64(C+68*8,0x01ea); store64(C+69*8,0x03ec); store64(C+70*8,0x07f8); store64(C+71*8,0x0ff9);
    store64(C+72*8,0x1ffc); store64(C+73*8,0x0ffc); store64(C+74*8,0x0ff5); store64(C+75*8,0x07ea); store64(C+76*8,0x03f3); store64(C+77*8,0x03f2); store64(C+78*8,0x07f5); store64(C+79*8,0x0ffb); store64(C+80*8,0x1ffe);
    return 0;
}

# HCB6: signed pair, values -4..4, no sign bits, 81 entries.
# Derived by measuring a reference decoder (see docs/sources.md);
# verified complete prefix code: Kraft == 1, no duplicate or
# prefix-colliding codewords, all 81 symbols reachable.
fn _aac_init_hcb6() {
    var L = alloc(81 * 8); var C = alloc(81 * 8);
    _aac_hcb6_lens = L; _aac_hcb6_codes = C;
    # Lengths (81 entries)
