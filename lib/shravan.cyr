# ================================================================
# CELT bit allocation (RFC 6716 §4.3.3) — port of rate.c + init_caps/tf_decode
# ================================================================
# All integer math in 1/8-bit units (BITRES=3). Signed arithmetic right shift is
# needed where the C uses `>>` on values that can go negative (trim/offset).

# Arithmetic (sign-preserving) right shift — Cyrius `>>` is logical.
fn sar(x, n) {
    if (x >= 0) { return x >> n; }
    var nx = 0 - x - 1;         # ~x for x<0 is non-negative
    return 0 - (nx >> n) - 1;   # ~((~x)>>n)
}

# get_pulses(i): pseudo-pulse index -> actual pulse count K (rate.h:48).
fn celt_get_pulses(i) {
    if (i < 8) { return i; }
    return (8 + (i & 7)) << ((i >> 3) - 1);
}

# bits2pulses(band, LM, bits) -> pseudo index (rate.h:53). NOTE bits-- first.
fn celt_bits2pulses(band, LM, bits) {
    var cache = _celt_cacheBits + load64(_celt_cacheIdx + ((LM + 1) * 21 + band) * 8);
    var lo = 0;
    var hi = load8(cache);
    bits = bits - 1;
    var i = 0;
    while (i < 6) {
        var mid = (lo + hi + 1) >> 1;
        if (load8(cache + mid) >= bits) { hi = mid; } else { lo = mid; }
        i = i + 1;
    }
    var loval = 0 - 1;
    if (lo != 0) { loval = load8(cache + lo); }
    if (bits - loval <= load8(cache + hi) - bits) { return lo; }
    return hi;
}

# pulses2bits(band, LM, pulses) -> whole bits (rate.h:80).
fn celt_pulses2bits(band, LM, pulses) {
    if (pulses == 0) { return 0; }
    var cache = _celt_cacheBits + load64(_celt_cacheIdx + ((LM + 1) * 21 + band) * 8);
    return load8(cache + pulses) + 1;
}

# init_caps: cap[i] = ((cache_caps[21*(2LM+C-1)+i]+64)*C*N) >> 2   (celt.c).
fn celt_init_caps(cap_out, LM, C) {
    var i = 0;
    while (i < 21) {
        var nn = (load64(_celt_eBands + (i + 1) * 8) - load64(_celt_eBands + i * 8)) << LM;
        var ci = 21 * (2 * LM + C - 1) + i;
        store64(cap_out + i * 8, ((load8(_celt_cacheCaps + ci) + 64) * C * nn) >> 2);
        i = i + 1;
    }
    return 0;
}

# tf_decode (celt_decoder.c:513). Fills tf_res[0..20] (signed tf_select_table vals).
fn celt_tf_decode(tf_res, isTransient, ec, start, end, LM) {
    var budget = load64(ec + 8) * 8;
    var tell = ec_tell(ec);
    var logp = 4;
    if (isTransient != 0) { logp = 2; }
    var tf_select_rsv = 0;
    # LM>0: a 2.5 ms frame has no tf_select bit at all, and reading one anyway
    # desynchronises the range decoder for every config 16/20/24/28 frame.
    if (LM > 0) { if (tell + logp + 1 <= budget) { tf_select_rsv = 1; } }
    budget = budget - tf_select_rsv;
    var tf_changed = 0;
    var curr = 0;
    var i = start;
    while (i < end) {
        if (tell + logp <= budget) {
            curr = curr ^ ec_dec_bit_logp(ec, logp);
            tell = ec_tell(ec);
            tf_changed = tf_changed | curr;
        }
        store64(tf_res + i * 8, curr);
        logp = 5;
        if (isTransient != 0) { logp = 4; }
        i = i + 1;
    }
    var base = LM * 8 + 4 * isTransient;
    var tf_select = 0;
    if (tf_select_rsv != 0) {
        if (load64(_celt_tfsel + (base + tf_changed) * 8) != load64(_celt_tfsel + (base + 2 + tf_changed) * 8)) {
            tf_select = ec_dec_bit_logp(ec, 1);
        }
    }
    i = start;
    while (i < end) {
        var idx = base + 2 * tf_select + load64(tf_res + i * 8);
        store64(tf_res + i * 8, load64(_celt_tfsel + idx * 8));
        i = i + 1;
    }
    return 0;
}

# celt_tf_encode (celt_encoder.c): encode per-band tf decisions (inverse of celt_tf_decode).
# tf_res[] holds the encoder's 0/1 tf-change decisions on input; on output it is remapped to
# the tf_select_table values (the tf_change the band coder uses), same as the decoder. Uses the
# tf_select_table row selected by LM, as in the decoder.
fn celt_tf_encode(tf_res, isTransient, tf_select, ec, start, end, LM) {
    var budget = load64(ec + 8) * 8;
    var tell = ec_tell(ec);
    var logp = 4;
    if (isTransient != 0) { logp = 2; }
    var tf_select_rsv = 0;
    if (LM > 0) { if (tell + logp + 1 <= budget) { tf_select_rsv = 1; } }
    budget = budget - tf_select_rsv;
    var tf_changed = 0;
    var curr = 0;
    var i = start;
    while (i < end) {
        if (tell + logp <= budget) {
            ec_enc_bit_logp(ec, load64(tf_res + i * 8) ^ curr, logp);
            tell = ec_tell(ec);
            curr = load64(tf_res + i * 8);
            tf_changed = tf_changed | curr;
        } else {
            store64(tf_res + i * 8, curr);
        }
        logp = 5;
        if (isTransient != 0) { logp = 4; }
        i = i + 1;
    }
    var base = LM * 8 + 4 * isTransient;
    if (tf_select_rsv != 0) {
        if (load64(_celt_tfsel + (base + tf_changed) * 8) != load64(_celt_tfsel + (base + 2 + tf_changed) * 8)) {
            ec_enc_bit_logp(ec, tf_select, 1);
        } else {
            tf_select = 0;
        }
    }
    i = start;
    while (i < end) {
        var idx = base + 2 * tf_select + load64(tf_res + i * 8);
        store64(tf_res + i * 8, load64(_celt_tfsel + idx * 8));
        i = i + 1;
    }
    return 0;
}

# median_of_3 / median_of_5 (celt_encoder.c:990/1029) — the dynalloc median filter. Operate on
# `x`, a pointer to 3 / 5 consecutive f64 log-energies; return the median.
fn _celt_median3(x) {
    var a = load64(x + 0); var b = load64(x + 8); var c = load64(x + 16);
    var t0 = a; var t1 = b;
    if (f64_gt(a, b) != 0) { t0 = b; t1 = a; }
    if (f64_lt(t1, c) != 0) { return t1; }
    if (f64_lt(t0, c) != 0) { return c; }
    return t0;
}

fn _celt_median5(x) {
    var t2 = load64(x + 16);
    var a = load64(x + 0); var b = load64(x + 8);
    var t0 = a; var t1 = b;
    if (f64_gt(a, b) != 0) { t0 = b; t1 = a; }
    var d = load64(x + 24); var e = load64(x + 32);
    var t3 = d; var t4 = e;
    if (f64_gt(d, e) != 0) { t3 = e; t4 = d; }
    if (f64_gt(t0, t3) != 0) { var s = t0; t0 = t3; t3 = s; s = t1; t1 = t4; t4 = s; }
    if (f64_gt(t2, t1) != 0) {
        if (f64_lt(t1, t3) != 0) { var r = t2; if (f64_lt(t3, r) != 0) { r = t3; } return r; }
        var r2 = t4; if (f64_lt(t1, r2) != 0) { r2 = t1; } return r2;
    }
    if (f64_lt(t2, t3) != 0) { var r3 = t1; if (f64_lt(t3, r3) != 0) { r3 = t3; } return r3; }
    var r4 = t2; if (f64_lt(t4, r4) != 0) { r4 = t4; } return r4;
}

# celt_dynalloc_analysis (celt_encoder.c:1049, float path) — decide per-band bit boosts (offsets)
# and the per-band tf importance from a simple masking model. Mono, non-surround, non-tone,
# analysis-off, LM>0 (the current CELT encode target). bandLogE is log2(E)-eMeans. Fills:
#   offsets[i] — the dynalloc boost TARGET in accumulated 1/64-bit units (= boost_count·quanta, so
#                the existing R9 boost loop reproduces exactly boost_count flags; boost_bits ==
#                boost_count·quanta in every width branch, so this is bit-exact to libopus's offsets),
#   importance[i] — floor(0.5 + 13·2^min(follower,4)), the tf_analysis Viterbi weight.
# The float macros make SHR32/SHL32/DB_SHIFT no-ops, so the whole thing works in raw log2 units
# (1 unit = 6.02 dB; GCONST(.5)=+3 dB). lsb_depth = 24 (the float default).
fn celt_dynalloc_analysis(bandLogE, end, LM, effectiveBytes, offsets, importance, isTransient) {
    var lsb_depth = 24;
    var nf = alloc(end * 8);
    var c0062 = f64_div(f64_from(62), f64_from(10000));       # 0.0062
    var c00625 = f64_div(f64_from(1), f64_from(16));          # 0.0625
    var i = 0;
    while (i < end) {
        var t = f64_mul(c00625, f64_from(load64(_celt_logN + i * 8)));
        t = f64_add(t, F64_HALF);
        t = f64_add(t, f64_from(9 - lsb_depth));
        t = f64_sub(t, load64(_celt_eMeans + i * 8));
        var i5 = i + 5;
        t = f64_add(t, f64_mul(c0062, f64_from(i5 * i5)));
        store64(nf + i * 8, t);
        store64(importance + i * 8, 13);                     # default (dynalloc-off fallback)
        store64(offsets + i * 8, 0);
        i = i + 1;
    }
    if (effectiveBytes < (30 + 5 * LM)) { return 0; }        # dynalloc disabled at very low rate
    # --- masking follower over bandLogE (bandLogE2 == bandLogE for long/low-complexity blocks) ---
    var f = alloc(end * 8);
    var last = 0;
    store64(f + 0, load64(bandLogE + 0));
    i = 1;
    var c15 = f64_div(f64_from(3), f64_from(2));              # 1.5
    while (i < end) {
        if (f64_gt(load64(bandLogE + i * 8), f64_add(load64(bandLogE + (i - 1) * 8), F64_HALF)) != 0) { last = i; }
        var mn = f64_add(load64(f + (i - 1) * 8), c15);
        var bv = load64(bandLogE + i * 8); if (f64_lt(bv, mn) != 0) { mn = bv; }
        store64(f + i * 8, mn);
        i = i + 1;
    }
    i = last - 1;
    while (i >= 0) {
        var a = f64_add(load64(f + (i + 1) * 8), F64_TWO);
        var bv2 = load64(bandLogE + i * 8); if (f64_lt(bv2, a) != 0) { a = bv2; }
        var cur = load64(f + i * 8); if (f64_lt(a, cur) != 0) { cur = a; }
        store64(f + i * 8, cur);
        i = i - 1;
    }
    # median filter (offset = 1.0), edges via median-of-3
    i = 2;
    while (i < end - 2) {
        var v = f64_sub(_celt_median5(bandLogE + (i - 2) * 8), F64_ONE);
        var cur2 = load64(f + i * 8); if (f64_gt(v, cur2) != 0) { store64(f + i * 8, v); }
        i = i + 1;
    }
    var tmp = f64_sub(_celt_median3(bandLogE + 0), F64_ONE);
    if (f64_gt(tmp, load64(f + 0)) != 0) { store64(f + 0, tmp); }
    if (f64_gt(tmp, load64(f + 8)) != 0) { store64(f + 8, tmp); }
    tmp = f64_sub(_celt_median3(bandLogE + (end - 3) * 8), F64_ONE);
    if (f64_gt(tmp, load64(f + (end - 2) * 8)) != 0) { store64(f + (end - 2) * 8, tmp); }
    if (f64_gt(tmp, load64(f + (end - 1) * 8)) != 0) { store64(f + (end - 1) * 8, tmp); }
    i = 0;
    while (i < end) { var nfv = load64(nf + i * 8); if (f64_gt(nfv, load64(f + i * 8)) != 0) { store64(f + i * 8, nfv); } i = i + 1; }
    # mono: follower = max(0, bandLogE - follower)
    i = 0;
    while (i < end) {
        var dd = f64_sub(load64(bandLogE + i * 8), load64(f + i * 8));
        if (f64_lt(dd, F64_ZERO) != 0) { dd = F64_ZERO; }
        store64(f + i * 8, dd);
        i = i + 1;
    }
    var four = f64_add(F64_TWO, F64_TWO);
    # importance = floor(0.5 + 13·2^min(follower,4))
    i = 0;
    while (i < end) {
        var fm = load64(f + i * 8); if (f64_gt(fm, four) != 0) { fm = four; }
        store64(importance + i * 8, f64_to(f64_floor(f64_add(F64_HALF, f64_mul(f64_from(13), _celt_exp2(fm))))));
        i = i + 1;
    }
    # CBR (vbr=0) non-transient: halve the dynalloc contribution
    if (isTransient == 0) { i = 0; while (i < end) { store64(f + i * 8, f64_mul(F64_HALF, load64(f + i * 8))); i = i + 1; } }
    # band shaping: boost low bands (<8) ×2, cut high bands (≥12) ×0.5
    i = 0;
    while (i < end) {
        var fv = load64(f + i * 8);
        if (i < 8) { fv = f64_mul(F64_TWO, fv); }
        if (i >= 12) { fv = f64_mul(F64_HALF, fv); }
        store64(f + i * 8, fv);
        i = i + 1;
    }
    if (effectiveBytes > 320) {
        var add = f64_mul(f64_div(f64_from(1), f64_from(1000)), f64_from(effectiveBytes - 320));
        if (f64_gt(add, c15) != 0) { add = c15; }
        store64(f + 0, f64_add(load64(f + 0), add));
    }
    # --- boost counts -> accumulated bit offsets, with the CBR 2/3-budget cap ---
    var tot_boost = 0;
    var budget23 = 2 * effectiveBytes / 3;
    i = 0;
    var stop = 0;
    while ((i < end) & (stop == 0)) {
        var fv2 = load64(f + i * 8); if (f64_gt(fv2, four) != 0) { fv2 = four; }
        var width = (load64(_celt_eBands + (i + 1) * 8) - load64(_celt_eBands + i * 8)) << LM;
        var quanta = width << 3; var q2 = 48; if (width > q2) { q2 = width; } if (q2 < quanta) { quanta = q2; }
        var boost = 0;
        if (width < 6) { boost = f64_to(fv2); }
        else {
            if (width > 48) { boost = f64_to(f64_mul(fv2, f64_from(8))); }
            else { boost = f64_to(f64_div(f64_mul(fv2, f64_from(width)), f64_from(6))); }
        }
        var boost_bits = boost * quanta;
        if (((tot_boost + boost_bits) >> 6) > budget23) {
            var cap = budget23 << 6;
            store64(offsets + i * 8, cap - tot_boost);
            tot_boost = cap;
            stop = 1;
        } else {
            store64(offsets + i * 8, boost_bits);
            tot_boost = tot_boost + boost_bits;
            i = i + 1;
        }
    }
    return 0;
}

# l1_metric (celt_encoder.c:650, float path): L1 = Σ|tmp| then bias toward good frequency
# resolution — L1 · (1 + lmb·bias). The float macros collapse ABS16(SHR32(x,NORM_SHIFT-14)) to
# |x| and MAC16_32_Q15(L1, lmb·bias, L1) to L1 + (lmb·bias)·L1.
fn _l1_metric(tmp, N, lmb, bias) {
    var L1 = f64_from(0);
    var i = 0;
    while (i < N) { L1 = f64_add(L1, f64_abs(load64(tmp + i * 8))); i = i + 1; }
    return f64_mul(L1, f64_add(F64_ONE, f64_mul(f64_from(lmb), bias)));
}

fn _iabs(x) { if (x < 0) { return 0 - x; } return x; }

# celt_tf_analysis (celt_encoder.c:663, float path) — pick each band's time/freq resolution.
# Per band: copy the normalized coeffs, walk Haar levels, score each with the L1 metric, keep the
# level with the smallest (freq-biased) L1 → per-band metric in Q1. Then a dual Viterbi (over the
# two tf_select rows) chooses tf_select, and a second Viterbi (with backtrace) fills tf_res[0..len)
# with the 0/1 change flags — smoothed by `lambda` (bit cost of a tf change). `importance[]` (the
# per-band Viterbi weight from celt_dynalloc_analysis; uniform 13 when dynalloc is off) scales the
# metric-distance cost. Indexes the tf_select_table row for this LM, the same table
# celt_tf_encode/decode use. Returns tf_select.
fn celt_tf_analysis(X, N0, len, isTransient, LM, tf_estimate, tf_chan, lambda, tf_res, importance) {
    # bias = 0.04 · max(-0.25, 0.5 − tf_estimate)
    var b_arg = f64_sub(F64_HALF, tf_estimate);
    var neg025 = f64_neg(f64_div(f64_from(1), f64_from(4)));
    if (f64_lt(b_arg, neg025) != 0) { b_arg = neg025; }
    var bias = f64_mul(f64_div(f64_from(4), f64_from(100)), b_arg);
    var metric = alloc(len * 8);
    var path0 = alloc(len * 8);
    var path1 = alloc(len * 8);
    var tmp = alloc(960 * 8);
    var tmp1 = alloc(960 * 8);
    var i = 0;
    while (i < len) {
        var w = load64(_celt_eBands + (i + 1) * 8) - load64(_celt_eBands + i * 8);
        var N = w << LM;
        var narrow = 0; if (w == 1) { narrow = 1; }
        var off = (load64(_celt_eBands + i * 8) << LM) + tf_chan * N0;
        var j = 0; while (j < N) { store64(tmp + j * 8, load64(X + (off + j) * 8)); j = j + 1; }
        var lm0 = 0; if (isTransient != 0) { lm0 = LM; }
        var best_L1 = _l1_metric(tmp, N, lm0, bias);
        var best_level = 0;
        if ((isTransient != 0) & (narrow == 0)) {                # the LM=-1 case for transients
            j = 0; while (j < N) { store64(tmp1 + j * 8, load64(tmp + j * 8)); j = j + 1; }
            haar1(tmp1, N >> LM, 1 << LM);
            var La = _l1_metric(tmp1, N, LM + 1, bias);
            if (f64_lt(La, best_L1) != 0) { best_L1 = La; best_level = 0 - 1; }
        }
        var kmax = LM;                                           # LM + !(isTransient||narrow)
        if ((isTransient == 0) & (narrow == 0)) { kmax = LM + 1; }
        var k = 0;
        while (k < kmax) {
            var B = k + 1; if (isTransient != 0) { B = LM - k - 1; }
            haar1(tmp, N >> k, 1 << k);                          # progressive Haar levels
            var Lb = _l1_metric(tmp, N, B, bias);
            if (f64_lt(Lb, best_L1) != 0) { best_L1 = Lb; best_level = k + 1; }
            k = k + 1;
        }
        var m = 0 - 2 * best_level; if (isTransient != 0) { m = 2 * best_level; }
        if ((narrow != 0) & ((m == 0) | (m == (0 - 2 * LM)))) { m = m - 1; }  # nudge off the mid-point
        store64(metric + i * 8, m);
        i = i + 1;
    }
    var base = LM * 8 + 4 * isTransient;
    # Choose tf_select: run each of the two rows through the Viterbi, take the cheaper (transients only)
    var tf_select = 0;
    var selcost0 = 0; var selcost1 = 0;
    var sel = 0;
    while (sel < 2) {
        var t0 = load64(_celt_tfsel + (base + 2 * sel + 0) * 8);
        var t1 = load64(_celt_tfsel + (base + 2 * sel + 1) * 8);
        var lam0 = lambda; if (isTransient != 0) { lam0 = 0; }
        var cost0 = load64(importance + 0) * _iabs(load64(metric + 0) - 2 * t0);
        var cost1 = load64(importance + 0) * _iabs(load64(metric + 0) - 2 * t1) + lam0;
        var ii = 1;
        while (ii < len) {
            var c0 = cost0; var a0 = cost1 + lambda; if (a0 < c0) { c0 = a0; }
            var c1 = cost1; var a1 = cost0 + lambda; if (a1 < c1) { c1 = a1; }
            cost0 = c0 + load64(importance + ii * 8) * _iabs(load64(metric + ii * 8) - 2 * t0);
            cost1 = c1 + load64(importance + ii * 8) * _iabs(load64(metric + ii * 8) - 2 * t1);
            ii = ii + 1;
        }
        var fin = cost0; if (cost1 < fin) { fin = cost1; }
        if (sel == 0) { selcost0 = fin; } else { selcost1 = fin; }
        sel = sel + 1;
    }
    if ((selcost1 < selcost0) & (isTransient != 0)) { tf_select = 1; }
    # Viterbi forward pass with the chosen tf_select, recording the backtrace
    var s0 = load64(_celt_tfsel + (base + 2 * tf_select + 0) * 8);
    var s1 = load64(_celt_tfsel + (base + 2 * tf_select + 1) * 8);
    var lamf = lambda; if (isTransient != 0) { lamf = 0; }
    var cost0 = load64(importance + 0) * _iabs(load64(metric + 0) - 2 * s0);
    var cost1 = load64(importance + 0) * _iabs(load64(metric + 0) - 2 * s1) + lamf;
    var ii = 1;
    while (ii < len) {
        var from0 = cost0; var from1 = cost1 + lambda;
        var curr0 = from1; store64(path0 + ii * 8, 1);
        if (from0 < from1) { curr0 = from0; store64(path0 + ii * 8, 0); }
        from0 = cost0 + lambda; from1 = cost1;
        var curr1 = from1; store64(path1 + ii * 8, 1);
        if (from0 < from1) { curr1 = from0; store64(path1 + ii * 8, 0); }
        cost0 = curr0 + load64(importance + ii * 8) * _iabs(load64(metric + ii * 8) - 2 * s0);
        cost1 = curr1 + load64(importance + ii * 8) * _iabs(load64(metric + ii * 8) - 2 * s1);
        ii = ii + 1;
    }
    var last = 1; if (cost0 < cost1) { last = 0; }
    store64(tf_res + (len - 1) * 8, last);
    var bi = len - 2;                                            # backward pass over the backtrace
    while (bi >= 0) {
        if (load64(tf_res + (bi + 1) * 8) == 1) {
            store64(tf_res + bi * 8, load64(path1 + (bi + 1) * 8));
        } else {
            store64(tf_res + bi * 8, load64(path0 + (bi + 1) * 8));
        }
        bi = bi - 1;
    }
    return tf_select;
}

# clt_compute_allocation + interp_bits2pulses (rate.c). start=0,end=21.
# Fills pulses[](1/8-bit shape budget), ebits[](fine bits), fine_priority[];
# writes *intensity_out,*dual_out,*balance_out; returns codedBands.
fn celt_compute_allocation(offsets, cap, alloc_trim, intensity_out, dual_out, total_in, balance_out, pulses, ebits, fine_priority, C, LM, ec, start, end, encode, prev, signalBandwidth) {
    var len = 21;
    var nbAllocVectors = 11;
    var total = total_in;
    if (total < 0) { total = 0; }
    var skip_start = start;
    var skip_rsv = 0;
    if (total >= 8) { skip_rsv = 8; }
    total = total - skip_rsv;
    var intensity_rsv = 0;
    var dual_stereo_rsv = 0;
    if (C == 2) {
        intensity_rsv = load64(_celt_log2frac + (end - start) * 8);
        if (intensity_rsv > total) {
            intensity_rsv = 0;
        } else {
            total = total - intensity_rsv;
            if (total >= 8) { dual_stereo_rsv = 8; }
            total = total - dual_stereo_rsv;
        }
    }
    var thresh = alloc(21 * 8);
    var trim_offset = alloc(21 * 8);
    var j = start;
    while (j < end) {
        var N0 = load64(_celt_eBands + (j + 1) * 8) - load64(_celt_eBands + j * 8);
        var th = (((3 * N0) << LM) << 3) >> 4;
        var cfloor = C << 3;
        if (th < cfloor) { th = cfloor; }
        store64(thresh + j * 8, th);
        var to = sar(C * N0 * (alloc_trim - 5 - LM) * (end - j - 1) * (1 << (LM + 3)), 6);
        if ((N0 << LM) == 1) { to = to - (C << 3); }
        store64(trim_offset + j * 8, to);
        j = j + 1;
    }
    # outer alloc-vector bisection
    var lo = 1;
    var hi = nbAllocVectors - 1;
    var cont = 1;
    while (cont == 1) {
        var mid = (lo + hi) >> 1;
        var done = 0;
        var psum = 0;
        var jj = end - 1;
        while (jj >= start) {
            var nb = load64(_celt_eBands + (jj + 1) * 8) - load64(_celt_eBands + jj * 8);
            var bj = ((C * nb * load8(_celt_allocVec + (mid * len + jj))) << LM) >> 2;
            if (bj > 0) {
                bj = bj + load64(trim_offset + jj * 8);
                if (bj < 0) { bj = 0; }
            }
            bj = bj + load64(offsets + jj * 8);
            if ((bj >= load64(thresh + jj * 8)) | (done == 1)) {
                done = 1;
                var cj = load64(cap + jj * 8);
                if (bj < cj) { psum = psum + bj; } else { psum = psum + cj; }
            } else {
                if (bj >= (C << 3)) { psum = psum + (C << 3); }
            }
            jj = jj - 1;
        }
        if (psum > total) { hi = mid - 1; } else { lo = mid + 1; }
        if (lo <= hi) { cont = 1; } else { cont = 0; }
    }
    hi = lo;
    lo = lo - 1;
    # bits1/bits2 endpoints
    var bits1 = alloc(21 * 8);
    var bits2 = alloc(21 * 8);
    j = start;
    while (j < end) {
        var nc = load64(_celt_eBands + (j + 1) * 8) - load64(_celt_eBands + j * 8);
        var b1 = ((C * nc * load8(_celt_allocVec + (lo * len + j))) << LM) >> 2;
        var b2 = 0;
        if (hi >= nbAllocVectors) {
            b2 = load64(cap + j * 8);
        } else {
            b2 = ((C * nc * load8(_celt_allocVec + (hi * len + j))) << LM) >> 2;
        }
        if (b1 > 0) { b1 = b1 + load64(trim_offset + j * 8); if (b1 < 0) { b1 = 0; } }
        if (b2 > 0) { b2 = b2 + load64(trim_offset + j * 8); if (b2 < 0) { b2 = 0; } }
        if (lo > 0) { b1 = b1 + load64(offsets + j * 8); }
        b2 = b2 + load64(offsets + j * 8);
        if (load64(offsets + j * 8) > 0) { skip_start = j; }
        b2 = b2 - b1;
        if (b2 < 0) { b2 = 0; }
        store64(bits1 + j * 8, b1);
        store64(bits2 + j * 8, b2);
        j = j + 1;
    }
    # interp_bits2pulses
    var alloc_floor = C << 3;
    var stereo = 0;
    if (C > 1) { stereo = 1; }
    var logM = LM << 3;
    var bits = alloc(21 * 8);
    var ilo = 0;
    var ihi = 64;
    var it = 0;
    while (it < 6) {
        var mid2 = (ilo + ihi) >> 1;
        var psum2 = 0;
        var done2 = 0;
        var jk = end - 1;
        while (jk >= start) {
            var tmp = load64(bits1 + jk * 8) + ((mid2 * load64(bits2 + jk * 8)) >> 6);
            if ((tmp >= load64(thresh + jk * 8)) | (done2 == 1)) {
                done2 = 1;
                var ck = load64(cap + jk * 8);
                if (tmp < ck) { psum2 = psum2 + tmp; } else { psum2 = psum2 + ck; }
            } else {
                if (tmp >= alloc_floor) { psum2 = psum2 + alloc_floor; }
            }
            jk = jk - 1;
        }
        if (psum2 > total) { ihi = mid2; } else { ilo = mid2; }
        it = it + 1;
    }
    var psum3 = 0;
    var done3 = 0;
    var jm = end - 1;
    while (jm >= start) {
        var tmp2 = load64(bits1 + jm * 8) + ((ilo * load64(bits2 + jm * 8)) >> 6);
        if ((tmp2 < load64(thresh + jm * 8)) & (done3 == 0)) {
            if (tmp2 >= alloc_floor) { tmp2 = alloc_floor; } else { tmp2 = 0; }
        } else {
            done3 = 1;
        }
        var cm = load64(cap + jm * 8);
        if (tmp2 > cm) { tmp2 = cm; }
        store64(bits + jm * 8, tmp2);
        psum3 = psum3 + tmp2;
        jm = jm - 1;
    }
    # skip loop (descending)
    var codedBands = end;
    var cont2 = 1;
    while (cont2 == 1) {
        var jb = codedBands - 1;
        if (jb <= skip_start) {
            total = total + skip_rsv;
            cont2 = 0;
        } else {
            var left = total - psum3;
            var span = load64(_celt_eBands + codedBands * 8) - load64(_celt_eBands + start * 8);
            var percoeff = left / span;
            left = left - span * percoeff;
            var rem = left - (load64(_celt_eBands + jb * 8) - load64(_celt_eBands + start * 8));
            if (rem < 0) { rem = 0; }
            var bw = load64(_celt_eBands + codedBands * 8) - load64(_celt_eBands + jb * 8);
            var band_bits = load64(bits + jb * 8) + percoeff * bw + rem;
            var thr = load64(thresh + jb * 8);
            var afl = alloc_floor + 8;
            if (afl > thr) { thr = afl; }
            var stop = 0;
            if (band_bits >= thr) {
                if (encode != 0) {
                    var depth_threshold = 0;
                    if (codedBands > 17) { depth_threshold = 9; if (jb < prev) { depth_threshold = 7; } }
                    var keep = 0;
                    if ((codedBands <= start + 2) | ((band_bits > (((depth_threshold * bw) << LM << 3) >> 4)) & (jb <= signalBandwidth))) { keep = 1; }
                    if (keep == 1) { ec_enc_bit_logp(ec, 1, 1); stop = 1; }
                    else { ec_enc_bit_logp(ec, 0, 1); psum3 = psum3 + 8; band_bits = band_bits - 8; }
                } else {
                    if (ec_dec_bit_logp(ec, 1) != 0) {
                        stop = 1;
                    } else {
                        psum3 = psum3 + 8;
                        band_bits = band_bits - 8;
                    }
                }
            }
            if (stop == 1) {
                cont2 = 0;
            } else {
                psum3 = psum3 - (load64(bits + jb * 8) + intensity_rsv);
                if (intensity_rsv > 0) {
                    intensity_rsv = load64(_celt_log2frac + (jb - start) * 8);
                }
                psum3 = psum3 + intensity_rsv;
                if (band_bits >= alloc_floor) {
                    psum3 = psum3 + alloc_floor;
                    store64(bits + jb * 8, alloc_floor);
                } else {
                    store64(bits + jb * 8, 0);
                }
                codedBands = codedBands - 1;
            }
        }
    }
    # intensity + dual_stereo
    if (intensity_rsv > 0) {
        if (encode != 0) {
            var ivc = load64(intensity_out); if (ivc > codedBands) { ivc = codedBands; }   # rate.c:400 clamp
            store64(intensity_out, ivc);
            ec_enc_uint(ec, ivc - start, codedBands + 1 - start);
        }
        else { store64(intensity_out, start + ec_dec_uint(ec, codedBands + 1 - start)); }
    } else {
        store64(intensity_out, 0);
    }
    if (load64(intensity_out) <= start) {
        total = total + dual_stereo_rsv;
        dual_stereo_rsv = 0;
    }
    if (dual_stereo_rsv > 0) {
        if (encode != 0) { ec_enc_bit_logp(ec, load64(dual_out), 1); }
        else { store64(dual_out, ec_dec_bit_logp(ec, 1)); }
    } else {
        store64(dual_out, 0);
    }
    # distribute remaining
    var left2 = total - psum3;
    var span2 = load64(_celt_eBands + codedBands * 8) - load64(_celt_eBands + start * 8);
    var pc2 = left2 / span2;
    left2 = left2 - span2 * pc2;
    j = start;
    while (j < codedBands) {
        var w = load64(_celt_eBands + (j + 1) * 8) - load64(_celt_eBands + j * 8);
        store64(bits + j * 8, load64(bits + j * 8) + pc2 * w);
        j = j + 1;
    }
    j = start;
    while (j < codedBands) {
        var w2 = load64(_celt_eBands + (j + 1) * 8) - load64(_celt_eBands + j * 8);
        var t = left2;
        if (w2 < t) { t = w2; }
        store64(bits + j * 8, load64(bits + j * 8) + t);
        left2 = left2 - t;
        j = j + 1;
    }
    # fine/shape split
    var balance = 0;
    j = start;
    while (j < codedBands) {
        var nd = load64(_celt_eBands + (j + 1) * 8) - load64(_celt_eBands + j * 8);
        var nf = nd << LM;
        var bit = load64(bits + j * 8) + balance;
        var excess = 0;
        if (nf > 1) {
            excess = bit - load64(cap + j * 8);
            if (excess < 0) { excess = 0; }
            store64(bits + j * 8, bit - excess);
            var den = C * nf;
            if ((C == 2) & (nf > 2) & (load64(dual_out) == 0) & (j < load64(intensity_out))) {
                den = den + 1;
            }
            var nclogn = den * (load64(_celt_logN + j * 8) + logM);
            var offset = sar(nclogn, 1) - den * 21;
            if (nf == 2) { offset = offset + ((den << 3) >> 2); }
            var bjj = load64(bits + j * 8);
            if (bjj + offset < ((den * 2) << 3)) {
                offset = offset + sar(nclogn, 2);
            } else {
                if (bjj + offset < ((den * 3) << 3)) { offset = offset + sar(nclogn, 3); }
            }
            var eb = bjj + offset + (den << 2);
            if (eb < 0) { eb = 0; }
            eb = (eb / den) >> 3;
            if (C * eb > (bjj >> 3)) { eb = (bjj >> stereo) >> 3; }
            if (eb > 8) { eb = 8; }
            var fp = 0;
            if (eb * (den << 3) >= bjj + offset) { fp = 1; }
            store64(fine_priority + j * 8, fp);
            store64(ebits + j * 8, eb);
            store64(bits + j * 8, bjj - ((C * eb) << 3));
        } else {
            excess = bit - (C << 3);
            if (excess < 0) { excess = 0; }
            store64(bits + j * 8, bit - excess);
            store64(ebits + j * 8, 0);
            store64(fine_priority + j * 8, 1);
        }
        if (excess > 0) {
            var ef = excess >> (stereo + 3);
            var room = 8 - load64(ebits + j * 8);
            if (ef > room) { ef = room; }
            store64(ebits + j * 8, load64(ebits + j * 8) + ef);
            var extra_bits = (ef * C) << 3;
            var fp2 = 0;
            if (extra_bits >= excess - balance) { fp2 = 1; }
            store64(fine_priority + j * 8, fp2);
            excess = excess - extra_bits;
        }
        balance = excess;
        j = j + 1;
    }
    store64(balance_out, balance);
    # skipped bands
    j = codedBands;
    while (j < end) {
        store64(ebits + j * 8, (load64(bits + j * 8) >> stereo) >> 3);
        store64(bits + j * 8, 0);
        var fp3 = 0;
        if (load64(ebits + j * 8) < 1) { fp3 = 1; }
        store64(fine_priority + j * 8, fp3);
        j = j + 1;
    }
    # copy working bits -> pulses
    j = start;
    while (j < end) {
        store64(pulses + j * 8, load64(bits + j * 8));
        j = j + 1;
    }
    return codedBands;
}

# Front-of-frame decode (R1..R13): silence..postfilter..transient..intra..coarse
# ..tf..spread..caps..dynalloc..trim..allocation..fine. Fills oldBandE (persists),
# tf_res, offsets, pulses, fine_quant, fine_priority, cap; scal[0..9] gets the
# scalar results. Returns the ec_dec state (positioned at quant_all_bands).
# Payload wrapper: CELT-only fullband prefix (fresh ec, start=0, end=21).
fn celt_decode_frame_prefix(payload, len, C, oldBandE, tf_res, offsets, pulses, fine_quant, fine_priority, cap, scal) {
    return celt_decode_frame_prefix_ec(ec_dec_new(payload, len), len, C, 3, 0, 21, oldBandE, tf_res, offsets, pulses, fine_quant, fine_priority, cap, scal);
}

# ec-taking core: decode the CELT frame header (silence, postfilter, transient, intra,
# coarse+fine energy, tf, spread, dynalloc, allocation) over bands [start,end) from a
# caller-owned range decoder. Postfilter is only present when start==0 (hybrid skips it).
fn celt_decode_frame_prefix_ec(ec, len, C, LM, start, end, oldBandE, tf_res, offsets, pulses, fine_quant, fine_priority, cap, scal) {
    if (_celt_allocVec == 0) { _celt_alloc_tables_init(); }
    if (_celt_eprob_inter == 0) { _celt_energy_tables_init(); }
    var M = 1 << LM;
    var total_bits = len * 8;
    # [C==1] fold stored 2nd-channel energy into channel 0
    if (C == 1) {
        var f = 0;
        while (f < 21) {
            store64(oldBandE + f * 8, f64_max(load64(oldBandE + f * 8), load64(oldBandE + (21 + f) * 8)));
            f = f + 1;
        }
    }
    var tell = ec_tell(ec);
    # R1 silence
    var silence = 0;
    if (tell >= total_bits) { silence = 1; }
    else { if (tell == 1) { silence = ec_dec_bit_logp(ec, 15); } }
    if (silence != 0) {
        store64(ec + 40, load64(ec + 40) + (total_bits - ec_tell(ec)));
    }
    # R2 postfilter (parse only; params unused for allocation)
    var pf_pitch = 0;
    var pf_tapset = 0;
    var pf_gain = F64_ZERO;
    tell = ec_tell(ec);
    if ((start == 0) & (tell + 16 <= total_bits)) {
        if (ec_dec_bit_logp(ec, 1) != 0) {
            var octave = ec_dec_uint(ec, 6);
            pf_pitch = (16 << octave) + ec_dec_bits(ec, 4 + octave) - 1;
            var qg = ec_dec_bits(ec, 3);
            if (ec_tell(ec) + 2 <= total_bits) {
                pf_tapset = ec_dec_icdf(ec, _celt_tapsetIcdf, 2);
            }
            pf_gain = f64_mul(f64_div(f64_from(3), f64_from(32)), f64_from(qg + 1));
        }
    }
    # R3 transient. A 2.5 ms frame is already one short block, so LM=0 carries no
    # transient bit at all (celt_decoder.c:1154) -- reading one desynchronises the
    # range decoder for configs 16/20/24/28.
    tell = ec_tell(ec);
    var isTransient = 0;
    if (LM > 0) {
        if (tell + 3 <= total_bits) { isTransient = ec_dec_bit_logp(ec, 3); }
    }
    # R4 intra
    tell = ec_tell(ec);
    var intra = 0;
    if (tell + 3 <= total_bits) { intra = ec_dec_bit_logp(ec, 3); }
    # R5 coarse energy
    celt_unquant_coarse_energy(oldBandE, intra, ec, C, start, end, LM);
    # R6 tf_decode
    celt_tf_decode(tf_res, isTransient, ec, start, end, LM);
    # R7 spread
    tell = ec_tell(ec);
    var spread = 2;
    if (tell + 4 <= total_bits) { spread = ec_dec_icdf(ec, _celt_spreadIcdf, 5); }
    # R8 caps
    celt_init_caps(cap, LM, C);
    # R9 dynalloc
    var dynalloc_logp = 6;
    var tb2 = total_bits << 3;
    tell = ec_tell_frac(ec);
    var i = start;
    while (i < end) {
        var width = (C * (load64(_celt_eBands + (i + 1) * 8) - load64(_celt_eBands + i * 8))) << LM;
        var q1 = width << 3;
        var q2m = 48;
        if (width > q2m) { q2m = width; }
        var quanta = q1;
        if (q2m < quanta) { quanta = q2m; }
        var dll = dynalloc_logp;
        var boost = 0;
        var loopc = 1;
        while (loopc == 1) {
            if ((tell + (dll << 3) < tb2) & (boost < load64(cap + i * 8))) {
                var flag = ec_dec_bit_logp(ec, dll);
                tell = ec_tell_frac(ec);
                if (flag == 0) {
                    loopc = 0;
                } else {
                    boost = boost + quanta;
                    tb2 = tb2 - quanta;
                    dll = 1;
                }
            } else {
                loopc = 0;
            }
        }
        store64(offsets + i * 8, boost);
        if (boost > 0) {
            dynalloc_logp = dynalloc_logp - 1;
            if (dynalloc_logp < 2) { dynalloc_logp = 2; }
        }
        i = i + 1;
    }
    # R10 alloc_trim
    var alloc_trim = 5;
    if (tell + 48 <= tb2) { alloc_trim = ec_dec_icdf(ec, _celt_trimIcdf, 7); }
    # R11 budget + anti-collapse reservation
    var bits = (total_bits << 3) - ec_tell_frac(ec) - 1;
    var acr = 0;
    if ((isTransient != 0) & (LM >= 2) & (bits >= ((LM + 2) << 3))) { acr = 8; }
    bits = bits - acr;
    # R12 allocation
    var intensity = alloc(8);
    var dual = alloc(8);
    var balance = alloc(8);
    var codedBands = celt_compute_allocation(offsets, cap, alloc_trim, intensity, dual, bits, balance, pulses, fine_quant, fine_priority, C, LM, ec, start, end, 0, 0, end);
    # R13 fine energy
    celt_unquant_fine_energy(oldBandE, fine_quant, ec, C, start, end);
    store64(scal + 0 * 8, silence);
    store64(scal + 1 * 8, isTransient);
    store64(scal + 2 * 8, intra);
    store64(scal + 3 * 8, spread);
    store64(scal + 4 * 8, alloc_trim);
    store64(scal + 5 * 8, acr);
    store64(scal + 6 * 8, codedBands);
    store64(scal + 7 * 8, load64(intensity));
    store64(scal + 8 * 8, load64(dual));
    store64(scal + 9 * 8, load64(balance));
    store64(scal + 10 * 8, pf_pitch);
    store64(scal + 11 * 8, pf_tapset);
    store64(scal + 12 * 8, pf_gain);
    return ec;
}

# ================================================================
# CELT CWRS: codeword index -> pulse vector (RFC 6716 §4.3.4) — cwrs.c port
# ================================================================
# U(N,K) counts sign-annotated pulse combos; V(N,K)=U(N,K)+U(N,K+1) is the range
# coder `ft`. Table U[row][col] built by the recurrence U(n,k)=U(n-1,k)+U(n,k-1)+
# U(n-1,k-1). Only rows 0..15 are needed (allocation guarantees the smaller of
# (N,K) is <=14 for any codeword that fits uint32); cells >= 2^32 are saturated so
# i64 never overflows (saturated cells are never used as a real `ft`).

var _celt_pvqU = 0;
var CELT_U_NC = 178;

fn _celt_pvq_u_init() {
    var NROW = 16;
    var NC = CELT_U_NC;
    var CAP = 4294967296;     # 2^32
    _celt_pvqU = alloc(NROW * NC * 8);
    var k = 0;
    while (k < NC) { store64(_celt_pvqU + (0 * NC + k) * 8, 0); k = k + 1; }
    store64(_celt_pvqU + 0, 1);              # U[0][0] = 1
    var n = 1;
    while (n < NROW) {
        store64(_celt_pvqU + (n * NC + 0) * 8, 0);   # U[n][0] = 0
        k = 1;
        while (k < NC) {
            var a = load64(_celt_pvqU + ((n - 1) * NC + k) * 8);
            var b = load64(_celt_pvqU + (n * NC + (k - 1)) * 8);
            var c = load64(_celt_pvqU + ((n - 1) * NC + (k - 1)) * 8);
            var v = a + b + c;
            if (v >= CAP) { v = CAP; }
            store64(_celt_pvqU + (n * NC + k) * 8, v);
            k = k + 1;
        }
        n = n + 1;
    }
    return 0;
}

# Direct row access U_ROW[a][b] (a<=15, b<=177).
fn _u(a, b) {
    return load64(_celt_pvqU + (a * CELT_U_NC + b) * 8);
}

# U(n,k) with symmetry U(n,k)=U(k,n): row=min, col=max.
fn celt_pvq_u(n, k) {
    if (_celt_pvqU == 0) { _celt_pvq_u_init(); }
    if (n <= k) { return _u(n, k); }
    return _u(k, n);
}

fn celt_pvq_v(n, k) {
    return celt_pvq_u(n, k) + celt_pvq_u(n, k + 1);
}

# cwrsi (cwrs.c:467): index i -> pulse vector y[0..n-1]; returns yy = sum(y[j]^2).
fn celt_cwrsi(n, k, i, y) {
    if (_celt_pvqU == 0) { _celt_pvq_u_init(); }
    var NC = CELT_U_NC;
    var yy = 0;
    var N = n;
    var K = k;
    var ii = i;
    var yp = 0;
    while (N > 2) {
        var val = 0;
        if (K >= N) {
            # lots of pulses: row = N (N<=14 here)
            var p = load64(_celt_pvqU + (N * NC + (K + 1)) * 8);
            var s = 0;
            if (ii >= p) { s = 0 - 1; ii = ii - (p & s); }
            var k0 = K;
            var q = load64(_celt_pvqU + (N * NC + N) * 8);
            if (q > ii) {
                K = N;
                var cont = 1;
                while (cont == 1) {
                    K = K - 1;
                    p = load64(_celt_pvqU + (K * NC + N) * 8);
                    if (p > ii) { cont = 1; } else { cont = 0; }
                }
            } else {
                p = load64(_celt_pvqU + (N * NC + K) * 8);
                while (p > ii) { K = K - 1; p = load64(_celt_pvqU + (N * NC + K) * 8); }
            }
            ii = ii - p;
            val = (k0 - K + s) ^ s;
        } else {
            # lots of dimensions: row = K (K<=14 here)
            var p = load64(_celt_pvqU + (K * NC + N) * 8);
            var q = load64(_celt_pvqU + ((K + 1) * NC + N) * 8);
            if ((p <= ii) & (ii < q)) {
                ii = ii - p;
                val = 0;
            } else {
                var s = 0;
                if (ii >= q) { s = 0 - 1; ii = ii - (q & s); }
                var k0 = K;
                var cont = 1;
                while (cont == 1) {
                    K = K - 1;
                    p = load64(_celt_pvqU + (K * NC + N) * 8);
                    if (p > ii) { cont = 1; } else { cont = 0; }
                }
                ii = ii - p;
                val = (k0 - K + s) ^ s;
            }
        }
        store64(y + yp * 8, val);
        yp = yp + 1;
        yy = yy + val * val;
        N = N - 1;
    }
    # N == 2
    var p2 = 2 * K + 1;
    var s2 = 0;
    if (ii >= p2) { s2 = 0 - 1; ii = ii - (p2 & s2); }
    var k02 = K;
    K = (ii + 1) >> 1;
    if (K != 0) { ii = ii - (2 * K - 1); }
    var val2 = (k02 - K + s2) ^ s2;
    store64(y + yp * 8, val2);
    yp = yp + 1;
    yy = yy + val2 * val2;
    # N == 1
    var s1 = 0 - ii;
    var val1 = (K + s1) ^ s1;
    store64(y + yp * 8, val1);
    yy = yy + val1 * val1;
    return yy;
}

# decode_pulses (cwrs.c:543): read codeword index, then cwrsi. Returns yy.
fn celt_decode_pulses(ec, n, k, y) {
    var v = celt_pvq_v(n, k);
    var i = ec_dec_uint(ec, v);
    return celt_cwrsi(n, k, i, y);
}

# ================================================================
# CELT bands / VQ (RFC 6716 §4.3.4) — bands.c + vq.c port (decode path)
# ================================================================
# Integer-exact pieces (bitexact_cos/log2tan, compute_qn, the recursion split
# bookkeeping, collapse masks, LCG) MUST match libopus or the range coder desyncs;
# the float pieces (normalise/rotation/denormalise/merge) only affect sample values.

var _celt_eMeans = 0;      # 21 f64
var _celt_spreadF = 0;     # {15,10,5}
var _celt_exp2_8 = 0;      # 8 int
var _celt_ordery = 0;      # ordery_table (offsets: stride-2)
var _celt_bitil = 0;       # bit_interleave_table[16]
var _celt_bitdeil = 0;     # bit_deinterleave_table[16]
var _celt_inv_table = 0;   # transient_analysis inv_table[128] (6*64/x, trained)
var _celt_tf_estimate = 0; # last transient_analysis tf_estimate (f64, for tf/VBR)
var _celt_tf_chan = 0;     # last transient_analysis dominant channel
var _celt_enc_bandE = 0;   # per-frame band energies (C*21) for stereo encode (intensity/MIN_STEREO)
var _celt_int_thr = 0;     # intensity_thresholds[21] (kbps → intensity band, celt_encoder.c)
var _celt_int_hyst = 0;    # intensity_histeresis[21]
var _celt_last_dual = 0;   # last stereo encode's dual_stereo decision (test visibility)
var F64_SQRT1_2 = 0;       # 0.70710678

fn _celt_bands_tables_init() {
    var em = alloc(21 * 8);
    var m16 = alloc(21 * 8);
    store64(m16+0,103); store64(m16+8,100); store64(m16+16,92); store64(m16+24,85);
    store64(m16+32,81); store64(m16+40,77); store64(m16+48,72); store64(m16+56,70);
    store64(m16+64,78); store64(m16+72,75); store64(m16+80,73); store64(m16+88,71);
    store64(m16+96,78); store64(m16+104,74); store64(m16+112,69); store64(m16+120,72);
    store64(m16+128,70); store64(m16+136,74); store64(m16+144,76); store64(m16+152,71);
    store64(m16+160,60);
    var i = 0;
    while (i < 21) { store64(em + i * 8, f64_div(f64_from(load64(m16 + i * 8)), f64_from(16))); i = i + 1; }
    _celt_eMeans = em;
    _celt_spreadF = alloc(3 * 8);
    store64(_celt_spreadF + 0, 15); store64(_celt_spreadF + 8, 10); store64(_celt_spreadF + 16, 5);
    _celt_exp2_8 = alloc(8 * 8);
    store64(_celt_exp2_8+0,16384); store64(_celt_exp2_8+8,17866); store64(_celt_exp2_8+16,19483);
    store64(_celt_exp2_8+24,21247); store64(_celt_exp2_8+32,23170); store64(_celt_exp2_8+40,25267);
    store64(_celt_exp2_8+48,27554); store64(_celt_exp2_8+56,30048);
    _celt_ordery = alloc(30 * 8);
    var od = alloc(30 * 8);
    store64(od+0,1); store64(od+8,0);
    store64(od+16,3); store64(od+24,0); store64(od+32,2); store64(od+40,1);
    store64(od+48,7); store64(od+56,0); store64(od+64,4); store64(od+72,3); store64(od+80,6); store64(od+88,1); store64(od+96,5); store64(od+104,2);
    store64(od+112,15); store64(od+120,0); store64(od+128,8); store64(od+136,7); store64(od+144,12); store64(od+152,3); store64(od+160,11); store64(od+168,4);
    store64(od+176,14); store64(od+184,1); store64(od+192,9); store64(od+200,6); store64(od+208,13); store64(od+216,2); store64(od+224,10); store64(od+232,5);
    i = 0; while (i < 30) { store64(_celt_ordery + i * 8, load64(od + i * 8)); i = i + 1; }
    _celt_bitil = alloc(16);
    store8(_celt_bitil+0,0); store8(_celt_bitil+1,1); store8(_celt_bitil+2,1); store8(_celt_bitil+3,1);
    store8(_celt_bitil+4,2); store8(_celt_bitil+5,3); store8(_celt_bitil+6,3); store8(_celt_bitil+7,3);
    store8(_celt_bitil+8,2); store8(_celt_bitil+9,3); store8(_celt_bitil+10,3); store8(_celt_bitil+11,3);
    store8(_celt_bitil+12,2); store8(_celt_bitil+13,3); store8(_celt_bitil+14,3); store8(_celt_bitil+15,3);
    _celt_bitdeil = alloc(16);
    store8(_celt_bitdeil+0,0); store8(_celt_bitdeil+1,3); store8(_celt_bitdeil+2,12); store8(_celt_bitdeil+3,15);
    store8(_celt_bitdeil+4,48); store8(_celt_bitdeil+5,51); store8(_celt_bitdeil+6,60); store8(_celt_bitdeil+7,63);
    store8(_celt_bitdeil+8,192); store8(_celt_bitdeil+9,195); store8(_celt_bitdeil+10,204); store8(_celt_bitdeil+11,207);
    store8(_celt_bitdeil+12,240); store8(_celt_bitdeil+13,243); store8(_celt_bitdeil+14,252); store8(_celt_bitdeil+15,255);
    F64_SQRT1_2 = f64_div(f64_from(70710678), f64_from(100000000));
    # transient_analysis inv_table[128] — "6*64/x" trained (celt_encoder.c:286)
    _celt_inv_table = alloc(128);
    var iv = _celt_inv_table;
    store8(iv+0,255); store8(iv+1,255); store8(iv+2,156); store8(iv+3,110); store8(iv+4,86); store8(iv+5,70); store8(iv+6,59); store8(iv+7,51);
    store8(iv+8,45); store8(iv+9,40); store8(iv+10,37); store8(iv+11,33); store8(iv+12,31); store8(iv+13,28); store8(iv+14,26); store8(iv+15,25);
    store8(iv+16,23); store8(iv+17,22); store8(iv+18,21); store8(iv+19,20); store8(iv+20,19); store8(iv+21,18); store8(iv+22,17); store8(iv+23,16);
    store8(iv+24,16); store8(iv+25,15); store8(iv+26,15); store8(iv+27,14); store8(iv+28,13); store8(iv+29,13); store8(iv+30,12); store8(iv+31,12);
    store8(iv+32,12); store8(iv+33,12); store8(iv+34,11); store8(iv+35,11); store8(iv+36,11); store8(iv+37,10); store8(iv+38,10); store8(iv+39,10);
    store8(iv+40,9); store8(iv+41,9); store8(iv+42,9); store8(iv+43,9); store8(iv+44,9); store8(iv+45,9); store8(iv+46,8); store8(iv+47,8);
    store8(iv+48,8); store8(iv+49,8); store8(iv+50,8); store8(iv+51,7); store8(iv+52,7); store8(iv+53,7); store8(iv+54,7); store8(iv+55,7);
    store8(iv+56,7); store8(iv+57,6); store8(iv+58,6); store8(iv+59,6); store8(iv+60,6); store8(iv+61,6); store8(iv+62,6); store8(iv+63,6);
    store8(iv+64,6); store8(iv+65,6); store8(iv+66,6); store8(iv+67,6); store8(iv+68,6); store8(iv+69,6); store8(iv+70,6); store8(iv+71,6);
    store8(iv+72,6); store8(iv+73,5); store8(iv+74,5); store8(iv+75,5); store8(iv+76,5); store8(iv+77,5); store8(iv+78,5); store8(iv+79,5);
    store8(iv+80,5); store8(iv+81,5); store8(iv+82,5); store8(iv+83,5); store8(iv+84,5); store8(iv+85,4); store8(iv+86,4); store8(iv+87,4);
    store8(iv+88,4); store8(iv+89,4); store8(iv+90,4); store8(iv+91,4); store8(iv+92,4); store8(iv+93,4); store8(iv+94,4); store8(iv+95,4);
    store8(iv+96,4); store8(iv+97,4); store8(iv+98,4); store8(iv+99,4); store8(iv+100,4); store8(iv+101,4); store8(iv+102,4); store8(iv+103,4);
    store8(iv+104,4); store8(iv+105,4); store8(iv+106,4); store8(iv+107,4); store8(iv+108,4); store8(iv+109,4); store8(iv+110,3); store8(iv+111,3);
    store8(iv+112,3); store8(iv+113,3); store8(iv+114,3); store8(iv+115,3); store8(iv+116,3); store8(iv+117,3); store8(iv+118,3); store8(iv+119,3);
    store8(iv+120,3); store8(iv+121,3); store8(iv+122,3); store8(iv+123,3); store8(iv+124,3); store8(iv+125,3); store8(iv+126,3); store8(iv+127,2);
    # intensity_thresholds[21] / intensity_histeresis[21] (kbps → intensity band, celt_encoder.c)
    _celt_int_thr = alloc(21 * 8);
    store64(_celt_int_thr+0,1); store64(_celt_int_thr+8,2); store64(_celt_int_thr+16,3); store64(_celt_int_thr+24,4);
    store64(_celt_int_thr+32,5); store64(_celt_int_thr+40,6); store64(_celt_int_thr+48,7); store64(_celt_int_thr+56,8);
    store64(_celt_int_thr+64,16); store64(_celt_int_thr+72,24); store64(_celt_int_thr+80,36); store64(_celt_int_thr+88,44);
    store64(_celt_int_thr+96,50); store64(_celt_int_thr+104,56); store64(_celt_int_thr+112,62); store64(_celt_int_thr+120,67);
    store64(_celt_int_thr+128,72); store64(_celt_int_thr+136,79); store64(_celt_int_thr+144,88); store64(_celt_int_thr+152,106); store64(_celt_int_thr+160,134);
    _celt_int_hyst = alloc(21 * 8);
    store64(_celt_int_hyst+0,1); store64(_celt_int_hyst+8,1); store64(_celt_int_hyst+16,1); store64(_celt_int_hyst+24,1);
    store64(_celt_int_hyst+32,1); store64(_celt_int_hyst+40,1); store64(_celt_int_hyst+48,1); store64(_celt_int_hyst+56,2);
    store64(_celt_int_hyst+64,2); store64(_celt_int_hyst+72,2); store64(_celt_int_hyst+80,2); store64(_celt_int_hyst+88,2);
    store64(_celt_int_hyst+96,2); store64(_celt_int_hyst+104,2); store64(_celt_int_hyst+112,3); store64(_celt_int_hyst+120,3);
    store64(_celt_int_hyst+128,4); store64(_celt_int_hyst+136,5); store64(_celt_int_hyst+144,6); store64(_celt_int_hyst+152,8); store64(_celt_int_hyst+160,8);
    return 0;
}

# hysteresis_decision (celt.c) — map a value onto a band index via a threshold table with
# hysteresis around the previous choice. Integer domain (val = equiv kbps).
fn _celt_hysteresis(val, thresholds, hyst, n, prev) {
    var i = 0; var found = 0;
    while ((i < n) & (found == 0)) {
        if (val < load64(thresholds + i * 8)) { found = 1; } else { i = i + 1; }
    }
    if ((i > prev) & (val < load64(thresholds + prev * 8) + load64(hyst + prev * 8))) { i = prev; }
    if ((i < prev) & (prev > 0) & (val > load64(thresholds + (prev - 1) * 8) - load64(hyst + (prev - 1) * 8))) { i = prev; }
    if (i < 0) { i = 0; }
    if (i > n - 1) { i = n - 1; }
    return i;
}

fn celt_lcg_rand(seed) {
    return (1664525 * seed + 1013904223) & 0xFFFFFFFF;
}

# sign-extend low 16 bits to signed
fn _i16(x) { return ((x & 0xFFFF) ^ 0x8000) - 0x8000; }

fn frac_mul16(a, b) {
    return sar(16384 + _i16(a) * _i16(b), 15);
}

fn bitexact_cos(x) {
    var tmp = (4096 + x * x) >> 13;
    var x2 = _i16(tmp);
    var inner = 8277 + frac_mul16(0 - 626, x2);
    inner = (0 - 7651) + frac_mul16(x2, inner);
    x2 = (32767 - x2) + frac_mul16(x2, inner);
    return 1 + x2;
}

fn bitexact_log2tan(isin, icos) {
    var lc = ec_ilog(icos);
    var ls = ec_ilog(isin);
    icos = icos << (15 - lc);
    isin = isin << (15 - ls);
    return (ls - lc) * 2048
         + frac_mul16(isin, frac_mul16(isin, 0 - 2597) + 7932)
         - frac_mul16(icos, frac_mul16(icos, 0 - 2597) + 7932);
}

# isqrt32: floor(sqrt(v)) for v>=0 (exact).
fn isqrt32(v) {
    if (v <= 0) { return 0; }
    var r = 0;
    var b = 1;
    while (b * 4 <= v) { b = b * 4; }
    var x = v;
    while (b != 0) {
        if (x >= r + b) {
            x = x - (r + b);
            r = (r >> 1) + b;
        } else {
            r = r >> 1;
        }
        b = b >> 2;
    }
    return r;
}

fn compute_qn(N, b, offset, pulse_cap, stereo) {
    var N2 = 2 * N - 1;
    if ((stereo != 0) & (N == 2)) { N2 = N2 - 1; }
    # celt_sudiv(b + N2*offset, N2) — signed truncating division
    var num = b + N2 * offset;
    var qb = 0;
    if (num >= 0) { qb = num / N2; } else { qb = 0 - ((0 - num) / N2); }
    var lim = b - pulse_cap - 32;
    if (lim < qb) { qb = lim; }
    if (64 < qb) { qb = 64; }
    var qn = 1;
    if (qb >= 4) {
        qn = load64(_celt_exp2_8 + (qb & 7) * 8) >> (14 - (qb >> 3));
        qn = ((qn + 1) >> 1) << 1;
    }
    return qn;
}

# 2^x for f64 x
fn _celt_exp2(x) { return f64_pow(F64_TWO, x); }

# normalise_residual: X[i] = iy[i] * gain / sqrt(Ryy)   (float path)
fn normalise_residual(iy, X, N, ryy, gain) {
    var g = f64_div(gain, f64_sqrt(f64_from(ryy)));
    var i = 0;
    while (i < N) {
        store64(X + i * 8, f64_mul(f64_from(load64(iy + i * 8)), g));
        i = i + 1;
    }
    return 0;
}

fn exp_rotation1(X, len, stride, c, s) {
    var ms = f64_neg(s);
    var i = 0;
    var lim = len - stride;
    while (i < lim) {
        var x1 = load64(X + i * 8);
        var x2 = load64(X + (i + stride) * 8);
        store64(X + (i + stride) * 8, f64_add(f64_mul(c, x2), f64_mul(s, x1)));
        store64(X + i * 8, f64_add(f64_mul(c, x1), f64_mul(ms, x2)));
        i = i + 1;
    }
    i = len - 2 * stride - 1;
    while (i >= 0) {
        var x1b = load64(X + i * 8);
        var x2b = load64(X + (i + stride) * 8);
        store64(X + (i + stride) * 8, f64_add(f64_mul(c, x2b), f64_mul(s, x1b)));
        store64(X + i * 8, f64_add(f64_mul(c, x1b), f64_mul(ms, x2b)));
        i = i - 1;
    }
    return 0;
}

# exp_rotation for decode (dir<0).
fn exp_rotation(X, len, stride, K, spread) {
    if ((2 * K >= len) | (spread == 0)) { return 0; }
    var factor = load64(_celt_spreadF + (spread - 1) * 8);
    var gain = f64_div(f64_from(len), f64_from(len + factor * K));
    var theta = f64_mul(F64_HALF, f64_mul(gain, gain));
    var halfpi = f64_mul(F64_HALF, F64_PI);
    var c = f64_cos(f64_mul(halfpi, theta));
    var s = f64_cos(f64_mul(halfpi, f64_sub(F64_ONE, theta)));
    var stride2 = 0;
    if (len >= 8 * stride) {
        stride2 = 1;
        while ((stride2 * stride2 + stride2) * stride + (stride >> 2) < len) { stride2 = stride2 + 1; }
    }
    var blocklen = len / stride;
    var b = 0;
    while (b < stride) {
        var Xb = X + b * blocklen * 8;
        if (stride2 != 0) { exp_rotation1(Xb, blocklen, stride2, s, c); }
        exp_rotation1(Xb, blocklen, 1, c, s);
        b = b + 1;
    }
    return 0;
}

fn renormalise_vector(X, N, gain) {
    var E = f64_div(f64_from(1), f64_from(1000000000000000));   # EPSILON 1e-15
    var i = 0;
    while (i < N) {
        var x = load64(X + i * 8);
        E = f64_add(E, f64_mul(x, x));
        i = i + 1;
    }
    var g = f64_div(gain, f64_sqrt(E));
    i = 0;
    while (i < N) { store64(X + i * 8, f64_mul(g, load64(X + i * 8))); i = i + 1; }
    return 0;
}

fn extract_collapse_mask(iy, N, B) {
    if (B <= 1) { return 1; }
    var N0 = N / B;
    var mask = 0;
    var i = 0;
    while (i < B) {
        var tmp = 0;
        var j = 0;
        while (j < N0) { tmp = tmp | load64(iy + (i * N0 + j) * 8); j = j + 1; }
        if (tmp != 0) { mask = mask | (1 << i); }
        i = i + 1;
    }
    return mask;
}

# ================================================================
# CELT PVQ ENCODE (vq.c / cwrs.c) — inverse of the decode path above.
# ================================================================
# exp_rotation forward (dir>=0): the encoder rotates INTO the search domain (angle-negated,
# reversed stage order vs the decode exp_rotation).
fn exp_rotation_enc(X, len, stride, K, spread) {
    if ((2 * K >= len) | (spread == 0)) { return 0; }
    if (_celt_spreadF == 0) { _celt_bands_tables_init(); }
    var factor = load64(_celt_spreadF + (spread - 1) * 8);
    var gain = f64_div(f64_from(len), f64_from(len + factor * K));
    var theta = f64_mul(F64_HALF, f64_mul(gain, gain));
    var halfpi = f64_mul(F64_HALF, F64_PI);
    var c = f64_cos(f64_mul(halfpi, theta));
    var s = f64_cos(f64_mul(halfpi, f64_sub(F64_ONE, theta)));
    var stride2 = 0;
    if (len >= 8 * stride) {
        stride2 = 1;
        while ((stride2 * stride2 + stride2) * stride + (stride >> 2) < len) { stride2 = stride2 + 1; }
    }
    var blocklen = len / stride;
    var ns = f64_neg(s);
    var nc = f64_neg(c);
    var b = 0;
    while (b < stride) {
        var Xb = X + b * blocklen * 8;
        exp_rotation1(Xb, blocklen, 1, c, ns);
        if (stride2 != 0) { exp_rotation1(Xb, blocklen, stride2, s, nc); }
        b = b + 1;
    }
    return 0;
}

# op_pvq_search (vq.c): find the K-pulse integer vector iy that best matches X (max
# Rxy^2/Ryy), via a projection pre-search (K>N/2) + greedy one-pulse-at-a-time refinement.
# X is overwritten with |X| (sign restored into iy). Returns yy = sum(iy^2).
fn op_pvq_search(X, iy, K, N) {
    var y = alloc(N * 8);
    var signx = alloc(N * 8);
    var j = 0;
    while (j < N) {
        var xj = load64(X + j * 8);
        var sg = 0;
        if (f64_lt(xj, F64_ZERO) == 1) { sg = 1; xj = f64_neg(xj); }
        store64(signx + j * 8, sg);
        store64(X + j * 8, xj);
        store64(iy + j * 8, 0);
        store64(y + j * 8, F64_ZERO);
        j = j + 1;
    }
    var xy = F64_ZERO;
    var yy = F64_ZERO;
    var pulsesLeft = K;
    if (K > (N >> 1)) {
        var sum = F64_ZERO;
        j = 0;
        while (j < N) { sum = f64_add(sum, load64(X + j * 8)); j = j + 1; }
        var ok = 0;
        if ((f64_gt(sum, F64_1E30INV) == 1) & (f64_lt(sum, f64_from(64)) == 1)) { ok = 1; }
        if (ok == 0) {
            store64(X + 0, F64_ONE);
            var jj = 1; while (jj < N) { store64(X + jj * 8, F64_ZERO); jj = jj + 1; }
            sum = F64_ONE;
        }
        var rcp = f64_div(f64_add(f64_from(K), f64_div(f64_from(8), f64_from(10))), sum);   # (K+0.8)/sum
        j = 0;
        while (j < N) {
            var xj = load64(X + j * 8);
            var iyj = f64_to(f64_mul(rcp, xj));    # floor (rcp*X >= 0)
            store64(iy + j * 8, iyj);
            var yj = f64_from(iyj);
            yy = f64_add(yy, f64_mul(yj, yj));
            xy = f64_add(xy, f64_mul(xj, yj));
            store64(y + j * 8, f64_mul(yj, F64_TWO));
            pulsesLeft = pulsesLeft - iyj;
            j = j + 1;
        }
    }
    if (pulsesLeft > N + 3) {
        var tmp = f64_from(pulsesLeft);
        yy = f64_add(yy, f64_mul(tmp, tmp));
        yy = f64_add(yy, f64_mul(tmp, load64(y + 0)));
        store64(iy + 0, load64(iy + 0) + pulsesLeft);
        pulsesLeft = 0;
    }
    var i = 0;
    while (i < pulsesLeft) {
        yy = f64_add(yy, F64_ONE);
        var best_id = 0;
        var Rxy0 = f64_add(xy, load64(X + 0));
        var Ryy0 = f64_add(yy, load64(y + 0));
        Rxy0 = f64_mul(Rxy0, Rxy0);
        var best_den = Ryy0;
        var best_num = Rxy0;
        j = 1;
        while (j < N) {
            var Rxyj = f64_add(xy, load64(X + j * 8));
            var Ryyj = f64_add(yy, load64(y + j * 8));
            Rxyj = f64_mul(Rxyj, Rxyj);
            if (f64_gt(f64_mul(best_den, Rxyj), f64_mul(Ryyj, best_num)) == 1) {
                best_den = Ryyj;
                best_num = Rxyj;
                best_id = j;
            }
            j = j + 1;
        }
        xy = f64_add(xy, load64(X + best_id * 8));
        yy = f64_add(yy, load64(y + best_id * 8));
        store64(y + best_id * 8, f64_add(load64(y + best_id * 8), F64_TWO));
        store64(iy + best_id * 8, load64(iy + best_id * 8) + 1);
        i = i + 1;
    }
    j = 0;
    while (j < N) {
        if (load64(signx + j * 8) == 1) { store64(iy + j * 8, 0 - load64(iy + j * 8)); }
        j = j + 1;
    }
    return f64_to(yy);   # yy is an exact integer (sum iy^2); return as int for normalise_residual
}

# icwrs (cwrs.c): pulse vector y -> combinatorial index (inverse of celt_cwrsi).
fn icwrs(n, y) {
    var j = n - 1;
    var yj = load64(y + j * 8);
    var i = 0;
    if (yj < 0) { i = 1; }
    var k = yj; if (k < 0) { k = 0 - k; }
    var cont = 1;
    while (cont == 1) {
        j = j - 1;
        i = i + celt_pvq_u(n - j, k);
        var yv = load64(y + j * 8);
        var av = yv; if (av < 0) { av = 0 - av; }
        k = k + av;
        if (yv < 0) { i = i + celt_pvq_u(n - j, k + 1); }
        if (j > 0) { cont = 1; } else { cont = 0; }
    }
    return i;
}

# celt_encode_pulses: encode the pulse vector index (inverse of celt_decode_pulses).
fn celt_encode_pulses(enc, n, k, y) {
    ec_enc_uint(enc, icwrs(n, y), celt_pvq_v(n, k));
    return 0;
}

# alg_quant (encode): rotate into search domain -> PVQ search -> encode pulses ->
# resynth the quantized unit shape into X (rotate back). Returns the collapse mask.
fn alg_quant(X, N, K, spread, B, enc, gain) {
    var iy = alloc((N + 3) * 8);
    exp_rotation_enc(X, N, B, K, spread);
    var yy = op_pvq_search(X, iy, K, N);
    var collapse_mask = extract_collapse_mask(iy, N, B);
    celt_encode_pulses(enc, N, K, iy);
    normalise_residual(iy, X, N, yy, gain);
    exp_rotation(X, N, B, K, spread);
    return collapse_mask;
}

# alg_unquant (decode): decode_pulses -> normalise -> rotation -> collapse mask.
fn alg_unquant(ec, X, N, K, spread, B, gain) {
    var iy = alloc(N * 8);
    var ryy = celt_decode_pulses(ec, N, K, iy);
    normalise_residual(iy, X, N, ryy, gain);
    exp_rotation(X, N, B, K, spread);
    return extract_collapse_mask(iy, N, B);
}

fn haar1(X, N0, stride) {
    var n0 = N0 >> 1;
    var i = 0;
    while (i < stride) {
        var j = 0;
        while (j < n0) {
            var a = load64(X + (stride * 2 * j + i) * 8);
            var bb = load64(X + (stride * (2 * j + 1) + i) * 8);
            var t1 = f64_mul(F64_SQRT1_2, a);
            var t2 = f64_mul(F64_SQRT1_2, bb);
            store64(X + (stride * 2 * j + i) * 8, f64_add(t1, t2));
            store64(X + (stride * (2 * j + 1) + i) * 8, f64_sub(t1, t2));
            j = j + 1;
        }
        i = i + 1;
    }
    return 0;
}

fn deinterleave_hadamard(X, N0, stride, hadamard) {
    var N = N0 * stride;
    var tmp = alloc(N * 8);
    if (hadamard != 0) {
        var ordery = _celt_ordery + (stride - 2) * 8;
        var i = 0;
        while (i < stride) {
            var oi = load64(ordery + i * 8);
            var j = 0;
            while (j < N0) {
                store64(tmp + (oi * N0 + j) * 8, load64(X + (j * stride + i) * 8));
                j = j + 1;
            }
            i = i + 1;
        }
    } else {
        var i2 = 0;
        while (i2 < stride) {
            var j2 = 0;
            while (j2 < N0) {
                store64(tmp + (i2 * N0 + j2) * 8, load64(X + (j2 * stride + i2) * 8));
                j2 = j2 + 1;
            }
            i2 = i2 + 1;
        }
    }
    var c = 0;
    while (c < N) { store64(X + c * 8, load64(tmp + c * 8)); c = c + 1; }
    return 0;
}

fn interleave_hadamard(X, N0, stride, hadamard) {
    var N = N0 * stride;
    var tmp = alloc(N * 8);
    if (hadamard != 0) {
        var ordery = _celt_ordery + (stride - 2) * 8;
        var i = 0;
        while (i < stride) {
            var oi = load64(ordery + i * 8);
            var j = 0;
            while (j < N0) {
                store64(tmp + (j * stride + i) * 8, load64(X + (oi * N0 + j) * 8));
                j = j + 1;
            }
            i = i + 1;
        }
    } else {
        var i2 = 0;
        while (i2 < stride) {
            var j2 = 0;
            while (j2 < N0) {
                store64(tmp + (j2 * stride + i2) * 8, load64(X + (i2 * N0 + j2) * 8));
                j2 = j2 + 1;
            }
            i2 = i2 + 1;
        }
    }
    var c = 0;
    while (c < N) { store64(X + c * 8, load64(tmp + c * 8)); c = c + 1; }
    return 0;
}

# stereo_merge (bands.c:418) — reconstruct L/R from mid(X)/side(Y).
# stereo_split (bands.c:406) — encode-side L/R → mid/side rotation by 1/√2 (the inverse of the
# decoder's stereo_merge). X=(l+r)/√2, Y=(r−l)/√2 with l=X/√2, r=Y/√2 pre-scaled.
fn stereo_split(X, Y, N) {
    var s = F64_SQRT1_2;
    var j = 0;
    while (j < N) {
        var l = f64_mul(s, load64(X + j * 8));
        var r = f64_mul(s, load64(Y + j * 8));
        store64(X + j * 8, f64_add(l, r));
        store64(Y + j * 8, f64_sub(r, l));
        j = j + 1;
    }
    return 0;
}

# intensity_stereo (bands.c:380, float path) — fold Y into X for an intensity-coded band: X ←
# a1·X + a2·Y with a1=left/norm, a2=right/norm, norm=ε+√(ε+left²+right²) (the side isn't coded).
# bandE holds the C*21 band amplitudes; band `i` uses left=bandE[i], right=bandE[21+i].
fn intensity_stereo(X, Y, bandE, i, N) {
    var left = load64(bandE + i * 8);
    var right = load64(bandE + (21 + i) * 8);
    var eps = f64_div(f64_from(1), f64_from(1000000000000000));
    var norm = f64_add(eps, f64_sqrt(f64_add(eps, f64_add(f64_mul(left, left), f64_mul(right, right)))));
    var a1 = f64_div(left, norm);
    var a2 = f64_div(right, norm);
    var j = 0;
    while (j < N) {
        store64(X + j * 8, f64_add(f64_mul(a1, load64(X + j * 8)), f64_mul(a2, load64(Y + j * 8))));
        j = j + 1;
    }
    return 0;
}

# stereo_analysis (celt_encoder.c) — decide joint (mid/side) vs dual (L/R separate) stereo by
# comparing the L1 "entropy" of L/R against M/S over the first 13 bands. Returns dual_stereo (0/1).
# X holds the normalized bands: channel 0 in X[0..N0), channel 1 in X[N0..2·N0).
fn stereo_analysis(X, LM, N0) {
    var eps = f64_div(f64_from(1), f64_from(1000000000000000));
    var sumLR = eps; var sumMS = eps;
    var i = 0;
    while (i < 13) {
        var j = load64(_celt_eBands + i * 8) << LM;
        var jend = load64(_celt_eBands + (i + 1) * 8) << LM;
        while (j < jend) {
            var L = load64(X + j * 8);
            var R = load64(X + (N0 + j) * 8);
            sumLR = f64_add(sumLR, f64_add(f64_abs(L), f64_abs(R)));
            sumMS = f64_add(sumMS, f64_add(f64_abs(f64_add(L, R)), f64_abs(f64_sub(L, R))));
            j = j + 1;
        }
        i = i + 1;
    }
    sumMS = f64_mul(sumMS, F64_SQRT1_2);
    var thetas = 13;
    if (LM <= 1) { thetas = 5; }
    var w = load64(_celt_eBands + 13 * 8) << (LM + 1);
    if (f64_gt(f64_mul(f64_from(w + thetas), sumMS), f64_mul(f64_from(w), sumLR)) != 0) { return 1; }
    return 0;
}

fn stereo_merge(X, Y, mid, N) {
    var xp = F64_ZERO;
    var sside = F64_ZERO;
    var j = 0;
    while (j < N) {
        xp = f64_add(xp, f64_mul(load64(Y + j * 8), load64(X + j * 8)));
        sside = f64_add(sside, f64_mul(load64(Y + j * 8), load64(Y + j * 8)));
        j = j + 1;
    }
    xp = f64_mul(xp, mid);
    var mid2 = f64_mul(mid, mid);
    var El = f64_sub(f64_add(mid2, sside), f64_mul(F64_TWO, xp));
    var Er = f64_add(f64_add(mid2, sside), f64_mul(F64_TWO, xp));
    var thr = f64_div(f64_from(6), f64_from(10000));
    if ((f64_lt(Er, thr) == 1) | (f64_lt(El, thr) == 1)) {
        j = 0;
        while (j < N) { store64(Y + j * 8, load64(X + j * 8)); j = j + 1; }
        return 0;
    }
    var lgain = f64_div(F64_ONE, f64_sqrt(El));
    var rgain = f64_div(F64_ONE, f64_sqrt(Er));
    j = 0;
    while (j < N) {
        var l = f64_mul(mid, load64(X + j * 8));
        var r = load64(Y + j * 8);
        store64(X + j * 8, f64_mul(lgain, f64_sub(l, r)));
        store64(Y + j * 8, f64_mul(rgain, f64_add(l, r)));
        j = j + 1;
    }
    return 0;
}

# stereo_itheta (vq.c): the split angle in Q30 from the two sides' energies. Encoder-side —
# mono split uses X (first half) vs Y (second half); stereo uses (X+Y)/(X-Y). We use the
# exact atan2 (the decoder reconstructs from the *quantized* itheta, so bit-exactness of the
# pre-quant angle isn't required). itheta_q30 = round(2^30 * (2/pi)*atan2(side, mid)).
fn stereo_itheta(X, Y, stereo, N) {
    var Emid = F64_ZERO;
    var Eside = F64_ZERO;
    var i = 0;
    if (stereo != 0) {
        while (i < N) {
            var xi = load64(X + i * 8);
            var yi = load64(Y + i * 8);
            var m = f64_add(xi, yi);
            var s = f64_sub(xi, yi);
            Emid = f64_add(Emid, f64_mul(m, m));
            Eside = f64_add(Eside, f64_mul(s, s));
            i = i + 1;
        }
    } else {
        while (i < N) {
            var xi = load64(X + i * 8);
            Emid = f64_add(Emid, f64_mul(xi, xi));
            var yi = load64(Y + i * 8);
            Eside = f64_add(Eside, f64_mul(yi, yi));
            i = i + 1;
        }
    }
    var mid = f64_sqrt(Emid);
    var side = f64_sqrt(Eside);
    var norm = f64_mul(f64_atan2(side, mid), f64_div(F64_TWO, F64_PI));   # (2/pi)*atan2 in [0,1]
    var scaled = f64_mul(norm, f64_from(1073741824));                     # * 2^30
    return f64_to(f64_add(scaled, F64_HALF));                            # round; scaled>=0
}

# compute_theta (bands.c:700) — encode/decode the split angle, fill sctx[0..7]:
#  imid,iside,delta,itheta,qalloc,inv,new_b,new_fill. `encode` (ctx+72) selects direction;
#  X/Y supply the angle on encode. theta_round at ctx+80 (0 for CELT mono/decode).
fn compute_theta(ctx, X, Y, N, b, B, B0, LM, stereo, fill, sctx) {
    var ec = load64(ctx + 0);
    var ii = load64(ctx + 24);
    var intensity = load64(ctx + 48);
    var encode = load64(ctx + 72);
    var theta_round = load64(ctx + 80);
    var pulse_cap = load64(_celt_logN + ii * 8) + LM * 8;
    var qoff = 4;
    if ((stereo != 0) & (N == 2)) { qoff = 16; }
    var offset = (pulse_cap >> 1) - qoff;
    var qn = compute_qn(N, b, offset, pulse_cap, stereo);
    if ((stereo != 0) & (ii >= intensity)) { qn = 1; }
    var tell = ec_tell_frac(ec);
    var itheta = 0;
    if (encode != 0) { itheta = stereo_itheta(X, Y, stereo, N) >> 16; }
    var inv = 0;
    if (qn != 1) {
        if (encode != 0) {
            # quantize itheta (Q14 angle) to [0, qn]
            if ((stereo == 0) | (theta_round == 0)) {
                itheta = (itheta * qn + 8192) >> 14;
                if ((stereo == 0) & (load64(ctx + 64) != 0) & (itheta > 0) & (itheta < qn)) {
                    var unq = (itheta * 16384) / qn;
                    var im0 = bitexact_cos(unq);
                    var is0 = bitexact_cos(16384 - unq);
                    var dl0 = frac_mul16((N - 1) << 7, bitexact_log2tan(is0, im0));
                    if (dl0 > b) { itheta = qn; } else { if (dl0 < 0 - b) { itheta = 0; } }
                }
            } else {
                var bias = 0 - (32767 / qn);
                if (itheta > 8192) { bias = 32767 / qn; }
                var down = (itheta * qn + bias) >> 14;
                if (down < 0) { down = 0; }
                if (down > qn - 1) { down = qn - 1; }
                itheta = down;
                if (theta_round >= 0) { itheta = down + 1; }
            }
        }
        if ((stereo != 0) & (N > 2)) {
            var p0 = 3;
            var x0 = qn / 2;
            var ft = p0 * (x0 + 1) + x0;
            if (encode != 0) {
                var xe = itheta;
                var fle = 0; var fhe = 0;
                if (xe <= x0) { fle = p0 * xe; fhe = p0 * (xe + 1); }
                else { fle = (xe - 1 - x0) + (x0 + 1) * p0; fhe = (xe - x0) + (x0 + 1) * p0; }
                ec_encode(ec, fle, fhe, ft);
            } else {
                var fs = ec_decode(ec, ft);
                var x = 0;
                if (fs < (x0 + 1) * p0) { x = fs / p0; } else { x = x0 + 1 + (fs - (x0 + 1) * p0); }
                var fl = 0;
                var fh = 0;
                if (x <= x0) { fl = p0 * x; fh = p0 * (x + 1); }
                else { fl = (x - 1 - x0) + (x0 + 1) * p0; fh = (x - x0) + (x0 + 1) * p0; }
                ec_dec_update(ec, fl, fh, ft);
                itheta = x;
            }
        } else {
            if ((B0 > 1) | (stereo != 0)) {
                if (encode != 0) { ec_enc_uint(ec, itheta, qn + 1); }
                else { itheta = ec_dec_uint(ec, qn + 1); }
            } else {
                var ft2 = ((qn >> 1) + 1) * ((qn >> 1) + 1);
                if (encode != 0) {
                    var fse = 0; var fle2 = 0;
                    if (itheta <= (qn >> 1)) { fse = itheta + 1; fle2 = (itheta * (itheta + 1)) >> 1; }
                    else { fse = qn + 1 - itheta; fle2 = ft2 - (((qn + 1 - itheta) * (qn + 2 - itheta)) >> 1); }
                    ec_encode(ec, fle2, fle2 + fse, ft2);
                } else {
                    var fm = ec_decode(ec, ft2);
                    var fl2 = 0;
                    var fs2 = 0;
                    var thr = ((qn >> 1) * ((qn >> 1) + 1)) >> 1;
                    if (fm < thr) {
                        itheta = (isqrt32(8 * fm + 1) - 1) >> 1;
                        fs2 = itheta + 1;
                        fl2 = (itheta * (itheta + 1)) >> 1;
                    } else {
                        itheta = (2 * (qn + 1) - isqrt32(8 * (ft2 - fm - 1) + 1)) >> 1;
                        fs2 = qn + 1 - itheta;
                        fl2 = ft2 - (((qn + 1 - itheta) * (qn + 2 - itheta)) >> 1);
                    }
                    ec_dec_update(ec, fl2, fl2 + fs2, ft2);
                }
            }
        }
        itheta = (itheta * 16384) / qn;
        if ((encode != 0) & (stereo != 0)) {                 # apply the split the decoder inverts
            if (itheta == 0) { intensity_stereo(X, Y, load64(ctx + 88), ii, N); }
            else { stereo_split(X, Y, N); }
        }
    } else {
        if (stereo != 0) {                                   # qn==1: intensity band (theta forced 0)
            if (encode != 0) {
                if ((itheta > 8192) & (load64(ctx + 56) == 0)) { inv = 1; }   # side inversion decision
                if (inv != 0) { var jj = 0; while (jj < N) { store64(Y + jj * 8, f64_neg(load64(Y + jj * 8))); jj = jj + 1; } }
                intensity_stereo(X, Y, load64(ctx + 88), ii, N);
                if ((b > 16) & (load64(ctx + 16) > 16)) { ec_enc_bit_logp(ec, inv, 2); } else { inv = 0; }
                if (load64(ctx + 56) != 0) { inv = 0; }
            } else {
                if ((b > 16) & (load64(ctx + 16) > 16)) { inv = ec_dec_bit_logp(ec, 2); } else { inv = 0; }
                if (load64(ctx + 56) != 0) { inv = 0; }
            }
            itheta = 0;
        }
    }
    var qalloc = ec_tell_frac(ec) - tell;
    b = b - qalloc;
    var imid = 0;
    var iside = 0;
    var delta = 0;
    if (itheta == 0) {
        imid = 32767; iside = 0;
        fill = fill & ((1 << B) - 1);
        delta = 0 - 16384;
    } else {
        if (itheta == 16384) {
            imid = 0; iside = 32767;
            fill = fill & (((1 << B) - 1) << B);
            delta = 16384;
        } else {
            imid = bitexact_cos(itheta);
            iside = bitexact_cos(16384 - itheta);
            delta = frac_mul16((N - 1) << 7, bitexact_log2tan(iside, imid));
        }
    }
    store64(sctx + 0, imid);
    store64(sctx + 8, iside);
    store64(sctx + 16, delta);
    store64(sctx + 24, itheta);
    store64(sctx + 32, qalloc);
    store64(sctx + 40, inv);
    store64(sctx + 48, b);
    store64(sctx + 56, fill);
    return 0;
}

fn quant_band_n1(ctx, X, Y, lowband_out) {
    var ec = load64(ctx + 0);
    var stereo = 0;
    if (Y != 0) { stereo = 1; }
    var x = X;
    var c = 0;
    while (c < 1 + stereo) {
        var sign = 0;
        if (load64(ctx + 16) >= 8) {
            if (load64(ctx + 72) != 0) {
                if (f64_lt(load64(x + 0), F64_ZERO) == 1) { sign = 1; }
                ec_enc_bits(ec, sign, 1);
            } else {
                sign = ec_dec_bits(ec, 1);
            }
            store64(ctx + 16, load64(ctx + 16) - 8);
        }
        if (sign != 0) { store64(x + 0, f64_neg(F64_ONE)); } else { store64(x + 0, F64_ONE); }
        x = Y;
        c = c + 1;
    }
    if (lowband_out != 0) { store64(lowband_out + 0, load64(X + 0)); }
    return 1;
}

fn quant_partition(ctx, X, N, b, B, lowband, LM, gain, fill) {
    var ec = load64(ctx + 0);
    var ii = load64(ctx + 24);
    var spread = load64(ctx + 32);
    var B0 = B;
    var cm = 0;
    var cache = _celt_cacheBits + load64(_celt_cacheIdx + ((LM + 1) * 21 + ii) * 8);
    var cache0 = load8(cache);
    if ((LM != (0 - 1)) & (b > load8(cache + cache0) + 12) & (N > 2)) {
        var Nh = N >> 1;
        var Y = X + Nh * 8;
        var LMn = LM - 1;
        if (B == 1) { fill = (fill & 1) | (fill << 1); }
        var Bn = (B + 1) >> 1;
        var sctx = alloc(64);
        compute_theta(ctx, X, Y, Nh, b, Bn, B0, LMn, 0, fill, sctx);
        var imid = load64(sctx + 0);
        var iside = load64(sctx + 8);
        var delta = load64(sctx + 16);
        var itheta = load64(sctx + 24);
        b = load64(sctx + 48);
        fill = load64(sctx + 56);
        var mid = f64_div(f64_from(imid), f64_from(32768));
        var side = f64_div(f64_from(iside), f64_from(32768));
        if ((B0 > 1) & ((itheta & 0x3fff) != 0)) {
            if (itheta > 8192) { delta = delta - sar(delta, 4 - LMn); }
            else {
                var dd = delta + ((Nh << 3) >> (5 - LMn));
                if (dd > 0) { dd = 0; }
                delta = dd;
            }
        }
        var mbits = (b - delta) / 2;
        if (mbits > b) { mbits = b; }
        if (mbits < 0) { mbits = 0; }
        var sbits = b - mbits;
        store64(ctx + 16, load64(ctx + 16) - load64(sctx + 32));
        var next_lb = 0;
        if (lowband != 0) { next_lb = lowband + Nh * 8; }
        var rebalance = load64(ctx + 16);
        if (mbits >= sbits) {
            cm = quant_partition(ctx, X, Nh, mbits, Bn, lowband, LMn, f64_mul(gain, mid), fill);
            rebalance = mbits - (rebalance - load64(ctx + 16));
            if ((rebalance > 24) & (itheta != 0)) { sbits = sbits + rebalance - 24; }
            cm = cm | (quant_partition(ctx, Y, Nh, sbits, Bn, next_lb, LMn, f64_mul(gain, side), fill >> Bn) << (B0 >> 1));
        } else {
            cm = quant_partition(ctx, Y, Nh, sbits, Bn, next_lb, LMn, f64_mul(gain, side), fill >> Bn) << (B0 >> 1);
            rebalance = sbits - (rebalance - load64(ctx + 16));
            if ((rebalance > 24) & (itheta != 16384)) { mbits = mbits + rebalance - 24; }
            cm = cm | quant_partition(ctx, X, Nh, mbits, Bn, lowband, LMn, f64_mul(gain, mid), fill);
        }
    } else {
        var q = celt_bits2pulses(ii, LM, b);
        var curr_bits = celt_pulses2bits(ii, LM, q);
        store64(ctx + 16, load64(ctx + 16) - curr_bits);
        while ((load64(ctx + 16) < 0) & (q > 0)) {
            store64(ctx + 16, load64(ctx + 16) + curr_bits);
            q = q - 1;
            curr_bits = celt_pulses2bits(ii, LM, q);
            store64(ctx + 16, load64(ctx + 16) - curr_bits);
        }
        if (q != 0) {
            var K = celt_get_pulses(q);
            if (load64(ctx + 72) != 0) { cm = alg_quant(X, N, K, spread, B, ec, gain); }
            else { cm = alg_unquant(ec, X, N, K, spread, B, gain); }
        } else {
            var cm_mask = (1 << B) - 1;
            fill = fill & cm_mask;
            if (fill == 0) {
                var z = 0;
                while (z < N) { store64(X + z * 8, F64_ZERO); z = z + 1; }
                cm = 0;
            } else {
                if (lowband == 0) {
                    var j = 0;
                    while (j < N) {
                        var seed = celt_lcg_rand(load64(ctx + 8));
                        store64(ctx + 8, seed);
                        var sv = seed;
                        if (sv >= 2147483648) { sv = sv - 4294967296; }
                        store64(X + j * 8, f64_from(sar(sv, 20)));
                        j = j + 1;
                    }
                    cm = cm_mask;
                    renormalise_vector(X, N, gain);
                } else {
                    var tmpv = f64_div(F64_ONE, f64_from(256));
                    var j2 = 0;
                    while (j2 < N) {
                        var seed2 = celt_lcg_rand(load64(ctx + 8));
                        store64(ctx + 8, seed2);
                        var t = tmpv;
                        if ((seed2 & 0x8000) == 0) { t = f64_neg(tmpv); }
                        store64(X + j2 * 8, f64_add(load64(lowband + j2 * 8), t));
                        j2 = j2 + 1;
                    }
                    cm = fill;
                    renormalise_vector(X, N, gain);
                }
            }
        }
    }
    return cm;
}

fn quant_band(ctx, X, N, b, B, lowband, LM, lowband_out, gain, lowband_scratch, fill) {
    var tf_change = load64(ctx + 40);
    var encode = load64(ctx + 72);
    var N0 = N;
    var N_B = N;
    var B0 = B;
    var time_divide = 0;
    var recombine = 0;
    var longBlocks = 0;
    if (B0 == 1) { longBlocks = 1; }
    N_B = N_B / B;
    if (N == 1) { return quant_band_n1(ctx, X, 0, lowband_out); }
    if (tf_change > 0) { recombine = tf_change; }
    if ((lowband_scratch != 0) & (lowband != 0) & ((recombine != 0) | ((((N_B & 1) == 0) & (tf_change < 0)) != 0) | (B0 > 1))) {
        var cpi = 0;
        while (cpi < N) { store64(lowband_scratch + cpi * 8, load64(lowband + cpi * 8)); cpi = cpi + 1; }
        lowband = lowband_scratch;
    }
    var k = 0;
    while (k < recombine) {
        if (encode != 0) { haar1(X, N >> k, 1 << k); }
        if (lowband != 0) { haar1(lowband, N >> k, 1 << k); }
        fill = load8(_celt_bitil + (fill & 0xF)) | (load8(_celt_bitil + (fill >> 4)) << 2);
        k = k + 1;
    }
    B = B >> recombine;
    N_B = N_B << recombine;
    while (((N_B & 1) == 0) & (tf_change < 0)) {
        if (encode != 0) { haar1(X, N_B, B); }
        if (lowband != 0) { haar1(lowband, N_B, B); }
        fill = fill | (fill << B);
        B = B << 1;
        N_B = N_B >> 1;
        time_divide = time_divide + 1;
        tf_change = tf_change + 1;
    }
    B0 = B;
    var N_B0 = N_B;
    if (B0 > 1) {
        if (encode != 0) { deinterleave_hadamard(X, N_B >> recombine, B0 << recombine, longBlocks); }
        if (lowband != 0) { deinterleave_hadamard(lowband, N_B >> recombine, B0 << recombine, longBlocks); }
    }
    var cm = quant_partition(ctx, X, N, b, B, lowband, LM, gain, fill);
    if (B0 > 1) { interleave_hadamard(X, N_B >> recombine, B0 << recombine, longBlocks); }
    N_B = N_B0;
    B = B0;
    k = 0;
    while (k < time_divide) {
        B = B >> 1;
        N_B = N_B << 1;
        cm = cm | (cm >> B);
        haar1(X, N_B, B);
        k = k + 1;
    }
    k = 0;
    while (k < recombine) {
        cm = load8(_celt_bitdeil + cm);
        haar1(X, N0 >> k, 1 << k);
        k = k + 1;
    }
    B = B << recombine;
    if (lowband_out != 0) {
        var nn = f64_sqrt(f64_from(N0));
        var j = 0;
        while (j < N0) { store64(lowband_out + j * 8, f64_mul(nn, load64(X + j * 8))); j = j + 1; }
    }
    cm = cm & ((1 << B) - 1);
    return cm;
}

fn quant_band_stereo(ctx, X, Y, N, b, B, lowband, LM, lowband_out, lowband_scratch, fill) {
    var ec = load64(ctx + 0);
    if (N == 1) { return quant_band_n1(ctx, X, Y, lowband_out); }
    var orig_fill = fill;
    if (load64(ctx + 72) != 0) {                             # encode: if a channel is ~silent, copy
        var iim = load64(ctx + 24);                          # the louder one over it (MIN_STEREO_ENERGY)
        var beb = load64(ctx + 88);
        var eL = load64(beb + iim * 8);
        var eR = load64(beb + (21 + iim) * 8);
        var mse = f64_div(F64_ONE, f64_from(10000000000));   # 1e-10
        if ((f64_lt(eL, mse) != 0) | (f64_lt(eR, mse) != 0)) {
            var jz = 0;
            if (f64_gt(eL, eR) != 0) { while (jz < N) { store64(Y + jz * 8, load64(X + jz * 8)); jz = jz + 1; } }
            else { while (jz < N) { store64(X + jz * 8, load64(Y + jz * 8)); jz = jz + 1; } }
        }
    }
    var sctx = alloc(64);
    compute_theta(ctx, X, Y, N, b, B, B, LM, 1, fill, sctx);
    var inv = load64(sctx + 40);
    var imid = load64(sctx + 0);
    var iside = load64(sctx + 8);
    var delta = load64(sctx + 16);
    var itheta = load64(sctx + 24);
    b = load64(sctx + 48);
    fill = load64(sctx + 56);
    var mid = f64_div(f64_from(imid), f64_from(32768));
    var side = f64_div(f64_from(iside), f64_from(32768));
    var cm = 0;
    if (N == 2) {
        var mbits = b;
        var sbits = 0;
        if ((itheta != 0) & (itheta != 16384)) { sbits = 8; }
        mbits = mbits - sbits;
        var cc = 0;
        if (itheta > 8192) { cc = 1; }
        store64(ctx + 16, load64(ctx + 16) - (load64(sctx + 32) + sbits));
        var x2 = X;
        var y2 = Y;
        if (cc != 0) { x2 = Y; y2 = X; }
        var sign = 0;
        if (sbits != 0) {
            if (load64(ctx + 72) != 0) {                     # encode: sign from the mid/side cross term
                var cross = f64_sub(f64_mul(load64(x2 + 0), load64(y2 + 8)), f64_mul(load64(x2 + 8), load64(y2 + 0)));
                if (f64_lt(cross, F64_ZERO) != 0) { sign = 1; }
                ec_enc_bits(ec, sign, 1);
            } else {
                sign = ec_dec_bits(ec, 1);
            }
        }
        sign = 1 - 2 * sign;
        cm = quant_band(ctx, x2, N, mbits, B, lowband, LM, lowband_out, F64_ONE, lowband_scratch, orig_fill);
        store64(y2 + 0, f64_mul(f64_from(0 - sign), load64(x2 + 8)));
        store64(y2 + 8, f64_mul(f64_from(sign), load64(x2 + 0)));
        store64(X + 0, f64_mul(mid, load64(X + 0)));
        store64(X + 8, f64_mul(mid, load64(X + 8)));
        store64(Y + 0, f64_mul(side, load64(Y + 0)));
        store64(Y + 8, f64_mul(side, load64(Y + 8)));
        var t0 = load64(X + 0);
        store64(X + 0, f64_sub(t0, load64(Y + 0)));
        store64(Y + 0, f64_add(t0, load64(Y + 0)));
        var t1 = load64(X + 8);
        store64(X + 8, f64_sub(t1, load64(Y + 8)));
        store64(Y + 8, f64_add(t1, load64(Y + 8)));
    } else {
        var mbits = (b - delta) / 2;
        if (mbits > b) { mbits = b; }
        if (mbits < 0) { mbits = 0; }
        var sbits = b - mbits;
        store64(ctx + 16, load64(ctx + 16) - load64(sctx + 32));
        var rebalance = load64(ctx + 16);
        if (mbits >= sbits) {
            cm = quant_band(ctx, X, N, mbits, B, lowband, LM, lowband_out, F64_ONE, lowband_scratch, fill);
            rebalance = mbits - (rebalance - load64(ctx + 16));
            if ((rebalance > 24) & (itheta != 0)) { sbits = sbits + rebalance - 24; }
            cm = cm | quant_band(ctx, Y, N, sbits, B, 0, LM, 0, side, 0, fill >> B);
        } else {
            cm = quant_band(ctx, Y, N, sbits, B, 0, LM, 0, side, 0, fill >> B);
            rebalance = sbits - (rebalance - load64(ctx + 16));
            if ((rebalance > 24) & (itheta != 16384)) { mbits = mbits + rebalance - 24; }
            cm = cm | quant_band(ctx, X, N, mbits, B, lowband, LM, lowband_out, F64_ONE, lowband_scratch, fill);
        }
        stereo_merge(X, Y, mid, N);
    }
    # The side inversion applies to EVERY stereo band, not just the split ones.
    # libopus gates only stereo_merge on N != 2 (bands.c, end of quant_band_stereo);
    # this negation used to sit inside the N > 2 branch, so an N == 2 band that
    # signalled inv kept the wrong sign on its side channel. N == 2 is every band
    # of width 1 -- the eight lowest -- so this hit ordinary stereo streams.
    if (inv != 0) {
        var j = 0;
        while (j < N) { store64(Y + j * 8, f64_neg(load64(Y + j * 8))); j = j + 1; }
    }
    return cm;
}

# quant_all_bands driver (decode). X_/Y_ byte pointers; collapse_masks byte array.
fn quant_all_bands(X_, Y_, collapse_masks, pulses, shortBlocks, spread, dual_stereo, intensity, tf_res, total_bits, balance, ec, LM, codedBands, seed_ptr, disable_inv, C, start, end, encode) {
    if (_celt_eMeans == 0) { _celt_bands_tables_init(); }
    var M = 1 << LM;
    var Bf = 1;
    if (shortBlocks != 0) { Bf = M; }
    var normsz = M * load64(_celt_eBands + 20 * 8);
    var norm = alloc(C * normsz * 8);
    var norm2 = norm + normsz * 8;
    # norm is indexed absolutely (norm[M*eBands[i]]); norm_offset = M*eBands[start] is
    # the frequency of the first coded band, used to clamp the fold source so hybrid
    # (start=17) never folds from the un-decoded low region. Zero for config-31.
    var norm_offset = M * load64(_celt_eBands + start * 8);
    var lowband_scratch_base = X_ + M * load64(_celt_eBands + 20 * 8) * 8;
    var ctx = alloc(96);
    store64(ctx + 0, ec);
    store64(ctx + 8, load64(seed_ptr));
    store64(ctx + 32, spread);
    store64(ctx + 48, intensity);
    store64(ctx + 56, disable_inv);
    var avoid = 0;
    if (Bf > 1) { avoid = 1; }
    store64(ctx + 64, avoid);
    store64(ctx + 72, encode);
    store64(ctx + 80, 0);   # theta_round = 0
    store64(ctx + 88, _celt_enc_bandE);   # band energies for stereo intensity/MIN_STEREO (encode)
    var lowband_offset = 0;
    var update_lowband = 1;
    var i = start;
    while (i < end) {
        store64(ctx + 24, i);
        var last = 0;
        if (i == end - 1) { last = 1; }
        var Mei = M * load64(_celt_eBands + i * 8);
        var X = X_ + Mei * 8;
        var Y = 0;
        if (Y_ != 0) { Y = Y_ + Mei * 8; }
        var N = M * load64(_celt_eBands + (i + 1) * 8) - Mei;
        var tell = ec_tell_frac(ec);
        if (i != start) { balance = balance - tell; }
        var remaining_bits = total_bits - tell - 1;
        store64(ctx + 16, remaining_bits);
        var b = 0;
        if (i <= codedBands - 1) {
            var mn = codedBands - i;
            if (mn > 3) { mn = 3; }
            var curr_balance = balance / mn;
            if (balance < 0) { curr_balance = 0 - ((0 - balance) / mn); }
            b = load64(pulses + i * 8) + curr_balance;
            if (remaining_bits + 1 < b) { b = remaining_bits + 1; }
            if (16383 < b) { b = 16383; }
            if (b < 0) { b = 0; }
        }
        if ((Mei - N >= norm_offset) | (i == start + 1)) {
            if ((update_lowband != 0) | (lowband_offset == 0)) { lowband_offset = i; }
        }
        # special_hybrid_folding (bands.c:1579): at the 2nd coded band, duplicate enough of
        # the first band's fold data so the (wider) 2nd band can fold — hybrid has no lower
        # band to borrow from. norm is indexed absolutely here; libopus uses norm-relative,
        # so dst=M*eBands[start+1], src=norm_offset+2*n1-n2, len=n2-n1 (dst=src+len, no overlap).
        # For CELT-only (equal band widths at start) len=0 → no-op.
        if (i == start + 1) {
            var shf_n1 = M * (load64(_celt_eBands + (start + 1) * 8) - load64(_celt_eBands + start * 8));
            var shf_n2 = M * (load64(_celt_eBands + (start + 2) * 8) - load64(_celt_eBands + (start + 1) * 8));
            var shf_dst = M * load64(_celt_eBands + (start + 1) * 8);
            var shf_src = norm_offset + 2 * shf_n1 - shf_n2;
            var shf_len = shf_n2 - shf_n1;
            var shf_j = 0;
            while (shf_j < shf_len) {
                store64(norm + (shf_dst + shf_j) * 8, load64(norm + (shf_src + shf_j) * 8));
                if (dual_stereo != 0) { store64(norm2 + (shf_dst + shf_j) * 8, load64(norm2 + (shf_src + shf_j) * 8)); }
                shf_j = shf_j + 1;
            }
        }
        var tf_change = load64(tf_res + i * 8);
        store64(ctx + 40, tf_change);
        var lbscr = lowband_scratch_base;
        if (last != 0) { lbscr = 0; }
        var effective_lowband = 0 - 1;
        var x_cm = 0;
        var y_cm = 0;
        if ((lowband_offset != 0) & ((spread != 3) | (Bf > 1) | (tf_change < 0))) {
            effective_lowband = M * load64(_celt_eBands + lowband_offset * 8) - N;
            if (effective_lowband < norm_offset) { effective_lowband = norm_offset; }
            var fold_start = lowband_offset;
            var cs = 1;
            while (cs == 1) {
                fold_start = fold_start - 1;
                if (M * load64(_celt_eBands + fold_start * 8) > effective_lowband) { cs = 1; } else { cs = 0; }
            }
            var fold_end = lowband_offset - 1;
            var ce = 1;
            while (ce == 1) {
                fold_end = fold_end + 1;
                if ((fold_end < i) & (M * load64(_celt_eBands + fold_end * 8) < effective_lowband + N)) { ce = 1; } else { ce = 0; }
            }
            var fi = fold_start;
            var cf = 1;
            while (cf == 1) {
                x_cm = x_cm | load8(collapse_masks + (fi * C + 0));
                y_cm = y_cm | load8(collapse_masks + (fi * C + C - 1));
                fi = fi + 1;
                if (fi < fold_end) { cf = 1; } else { cf = 0; }
            }
        } else {
            x_cm = (1 << Bf) - 1;
            y_cm = (1 << Bf) - 1;
        }
        if ((dual_stereo != 0) & (i == intensity)) {
            dual_stereo = 0;
            var jj = 0;
            while (jj < Mei) {
                store64(norm + jj * 8, f64_mul(F64_HALF, f64_add(load64(norm + jj * 8), load64(norm2 + jj * 8))));
                jj = jj + 1;
            }
        }
        var lb = 0;
        if (effective_lowband != (0 - 1)) { lb = norm + effective_lowband * 8; }
        var out = 0;
        if (last == 0) { out = norm + Mei * 8; }
        if (dual_stereo != 0) {
            var lbx = 0;
            var lby = 0;
            if (effective_lowband != (0 - 1)) { lbx = norm + effective_lowband * 8; lby = norm2 + effective_lowband * 8; }
            var outx = 0;
            var outy = 0;
            if (last == 0) { outx = norm + Mei * 8; outy = norm2 + Mei * 8; }
            x_cm = quant_band(ctx, X, N, b / 2, Bf, lbx, LM, outx, F64_ONE, lbscr, x_cm);
            y_cm = quant_band(ctx, Y, N, b / 2, Bf, lby, LM, outy, F64_ONE, lbscr, y_cm);
        } else {
            if (Y != 0) {
                x_cm = quant_band_stereo(ctx, X, Y, N, b, Bf, lb, LM, out, lbscr, x_cm | y_cm);
                y_cm = x_cm;
            } else {
                x_cm = quant_band(ctx, X, N, b, Bf, lb, LM, out, F64_ONE, lbscr, x_cm | y_cm);
                y_cm = x_cm;
            }
        }
        store8(collapse_masks + (i * C + 0), x_cm & 0xFF);
        store8(collapse_masks + (i * C + C - 1), y_cm & 0xFF);
        balance = balance + load64(pulses + i * 8) + tell;
        update_lowband = 0;
        if (b > (N << 3)) { update_lowband = 1; }
        store64(ctx + 64, 0);
        i = i + 1;
    }
    store64(seed_ptr, load64(ctx + 8));
    return 0;
}

# compute_band_energies (bands.c, float path): bandE[i] = sqrt(1e-27 + sum X[j]^2)
# over each band — the L2 norm of the band's MDCT coefficients (encoder side).
fn compute_band_energies(X, bandE, end, C, LM) {
    if (_celt_eBands == 0) { _celt_alloc_tables_init(); }
    var M = 1 << LM;
    var N = 120 << LM;
    var eps = f64_mul(f64_div(F64_ONE, f64_from(1000000000)), f64_div(F64_ONE, f64_from(1000000000000000000)));  # 1e-27
    var c = 0;
    while (c < C) {
        var i = 0;
        while (i < end) {
            var j = M * load64(_celt_eBands + i * 8);
            var j1 = M * load64(_celt_eBands + (i + 1) * 8);
            var sum = eps;
            while (j < j1) {
                var x = load64(X + (c * N + j) * 8);
                sum = f64_add(sum, f64_mul(x, x));
                j = j + 1;
            }
            store64(bandE + (i + c * 21) * 8, f64_sqrt(sum));
            i = i + 1;
        }
        c = c + 1;
    }
    return 0;
}

# normalise_bands (bands.c, float path): X[j] = freq[j] / (1e-27 + bandE[i]) — the
# unit-norm spectral shape the PVQ then quantizes (inverse of denormalise_bands).
fn normalise_bands(freq, X, bandE, end, C, LM) {
    if (_celt_eBands == 0) { _celt_alloc_tables_init(); }
    var M = 1 << LM;
    var N = 120 << LM;
    var eps = f64_mul(f64_div(F64_ONE, f64_from(1000000000)), f64_div(F64_ONE, f64_from(1000000000000000000)));  # 1e-27
    var c = 0;
    while (c < C) {
        var i = 0;
        while (i < end) {
            var g = f64_div(F64_ONE, f64_add(eps, load64(bandE + (i + c * 21) * 8)));
            var j = M * load64(_celt_eBands + i * 8);
            var j1 = M * load64(_celt_eBands + (i + 1) * 8);
            while (j < j1) {
                store64(X + (c * N + j) * 8, f64_mul(load64(freq + (c * N + j) * 8), g));
                j = j + 1;
            }
            i = i + 1;
        }
        c = c + 1;
    }
    return 0;
}

# denormalise_bands (bands.c:188): freq[j] = X[j]*2^(bandLogE[i]+eMeans[i]).
fn denormalise_bands(X, freq, bandLogE, silence, start, end, LM) {
    var M = 1 << LM;
    var N = 120 << LM;
    var bound = M * load64(_celt_eBands + end * 8);
    if (silence != 0) { bound = 0; }
    # Zero bands below `start` (hybrid: CELT contributes nothing to the SILK-covered
    # low band). For config-31 (start=0) this loop is empty.
    var lo = M * load64(_celt_eBands + start * 8);
    if (silence != 0) { lo = 0; }
    var z0 = 0;
    while (z0 < lo) { store64(freq + z0 * 8, F64_ZERO); z0 = z0 + 1; }
    if (silence == 0) {
        var i = start;
        while (i < end) {
            var j = M * load64(_celt_eBands + i * 8);
            var band_end = M * load64(_celt_eBands + (i + 1) * 8);
            var lg = f64_add(load64(bandLogE + i * 8), load64(_celt_eMeans + i * 8));
            if (f64_gt(lg, f64_from(32)) == 1) { lg = f64_from(32); }
            var g = _celt_exp2(lg);
            while (j < band_end) {
                store64(freq + j * 8, f64_mul(load64(X + j * 8), g));
                j = j + 1;
            }
            i = i + 1;
        }
    }
    var z = bound;
    while (z < N) { store64(freq + z * 8, F64_ZERO); z = z + 1; }
    return 0;
}

# ================================================================
# CELT inverse MDCT + synthesis + de-emphasis (RFC 6716 §4.3.7) — mdct.c/celt_decoder.c
# ================================================================
# Float path: clt_mdct_backward as a direct O(N^2) DFT (correctness-first).
# trig[i]=cos(2*PI*(i+1/8)/N), N=1920>>shift; window[i]=sin(pi/2*sin(pi/2*(i+.5)/120)^2).

var _celt_window = 0;         # 120 f64
var _mdct_trig = 0;           # [4] ptr -> trig(N2) per shift
var _mdct_dc = 0;             # [4] ptr -> cos(2pi m/N4)
var _mdct_ds = 0;             # [4] ptr -> sin(2pi m/N4)
var F64_1E30INV = 0;          # VERY_SMALL 1e-30
var CELT_DEEMPH = 0;          # 0.8500061035

fn _celt_window_init() {
    _celt_window = alloc(120 * 8);
    var halfpi = f64_mul(F64_HALF, F64_PI);
    var i = 0;
    while (i < 120) {
        var inner = f64_sin(f64_mul(halfpi, f64_div(f64_add(f64_from(i), F64_HALF), f64_from(120))));
        var w = f64_sin(f64_mul(halfpi, f64_mul(inner, inner)));
        store64(_celt_window + i * 8, w);
        i = i + 1;
    }
    F64_1E30INV = f64_div(F64_ONE, f64_pow(f64_from(10), f64_from(30)));
    CELT_DEEMPH = f64_div(f64_from(27853), f64_from(32768));
    return 0;
}

fn _mdct_cache_init(shift) {
    if (_mdct_trig == 0) {
        _mdct_trig = alloc(4 * 8);
        _mdct_dc = alloc(4 * 8);
        _mdct_ds = alloc(4 * 8);
        var z = 0;
        while (z < 4) { store64(_mdct_trig + z * 8, 0); store64(_mdct_dc + z * 8, 0); store64(_mdct_ds + z * 8, 0); z = z + 1; }
    }
    if (_celt_window == 0) { _celt_window_init(); }
    if (load64(_mdct_trig + shift * 8) != 0) { return 0; }
    var N = 1920 >> shift;
    var N2 = N >> 1;
    var N4 = N >> 2;
    var twopi = f64_mul(F64_TWO, F64_PI);
    var eighth = f64_div(F64_ONE, f64_from(8));
    var tr = alloc(N2 * 8);
    var i = 0;
    while (i < N2) {
        store64(tr + i * 8, f64_cos(f64_div(f64_mul(twopi, f64_add(f64_from(i), eighth)), f64_from(N))));
        i = i + 1;
    }
    store64(_mdct_trig + shift * 8, tr);
    var dc = alloc(N4 * 8);
    var ds = alloc(N4 * 8);
    i = 0;
    while (i < N4) {
        var a = f64_div(f64_mul(twopi, f64_from(i)), f64_from(N4));
        store64(dc + i * 8, f64_cos(a));
        store64(ds + i * 8, f64_sin(a));
        i = i + 1;
    }
    store64(_mdct_dc + shift * 8, dc);
    store64(_mdct_ds + shift * 8, ds);
    return 0;
}

# clt_mdct_backward (float, direct DFT). in: MDCT coeffs (stride in_stride);
# out: writes out[0 .. N2+59], reading out[0..59] as prev overlap. overlap=120.
fn clt_mdct_backward(inp, in_stride, out, shift) {
    _mdct_cache_init(shift);
    var N = 1920 >> shift;
    var N2 = N >> 1;
    var N4 = N >> 2;
    var t = load64(_mdct_trig + shift * 8);
    var dc = load64(_mdct_dc + shift * 8);
    var ds = load64(_mdct_ds + shift * 8);
    var Cr = alloc(N4 * 8);
    var Ci = alloc(N4 * 8);
    var i = 0;
    while (i < N4) {
        var x1 = load64(inp + (2 * i * in_stride) * 8);
        var x2 = load64(inp + ((N2 - 1 - 2 * i) * in_stride) * 8);
        var ti = load64(t + i * 8);
        var tn = load64(t + (N4 + i) * 8);
        store64(Ci + i * 8, f64_add(f64_mul(x2, ti), f64_mul(x1, tn)));   # C[i].i = yr
        store64(Cr + i * 8, f64_sub(f64_mul(x1, ti), f64_mul(x2, tn)));   # C[i].r = yi
        i = i + 1;
    }
    # forward DFT: Fout[k] = sum_i C[i]*(cos(2pi ki/N4) - j sin)
    var Fr = alloc(N4 * 8);
    var Fi = alloc(N4 * 8);
    var k = 0;
    while (k < N4) {
        var sr = F64_ZERO;
        var si = F64_ZERO;
        i = 0;
        while (i < N4) {
            var m = (k * i) % N4;
            var cs = load64(dc + m * 8);
            var sn = load64(ds + m * 8);
            var cri = load64(Cr + i * 8);
            var cii = load64(Ci + i * 8);
            sr = f64_add(sr, f64_add(f64_mul(cri, cs), f64_mul(cii, sn)));
            si = f64_add(si, f64_sub(f64_mul(cii, cs), f64_mul(cri, sn)));
            i = i + 1;
        }
        store64(Fr + k * 8, sr);
        store64(Fi + k * 8, si);
        k = k + 1;
    }
    # post-rotate -> out[60 ..]
    var lim = (N4 + 1) >> 1;
    i = 0;
    while (i < lim) {
        var re = load64(Fi + i * 8);
        var im = load64(Fr + i * 8);
        var t0 = load64(t + i * 8);
        var t1 = load64(t + (N4 + i) * 8);
        var yr = f64_add(f64_mul(re, t0), f64_mul(im, t1));
        var yi = f64_sub(f64_mul(re, t1), f64_mul(im, t0));
        var re2 = load64(Fi + (N4 - 1 - i) * 8);
        var im2 = load64(Fr + (N4 - 1 - i) * 8);
        var t0b = load64(t + (N4 - i - 1) * 8);
        var t1b = load64(t + (N2 - i - 1) * 8);
        var yr2 = f64_add(f64_mul(re2, t0b), f64_mul(im2, t1b));
        var yi2 = f64_sub(f64_mul(re2, t1b), f64_mul(im2, t0b));
        store64(out + (60 + 2 * i) * 8, yr);
        store64(out + (60 + N2 - 1 - 2 * i) * 8, yi);
        store64(out + (60 + N2 - 2 - 2 * i) * 8, yr2);
        store64(out + (60 + 2 * i + 1) * 8, yi2);
        i = i + 1;
    }
    # mirror / TDAC on out[0..119]
    var w = _celt_window;
    i = 0;
    while (i < 60) {
        var x1 = load64(out + (119 - i) * 8);
        var x2 = load64(out + i * 8);
        var wlo = load64(w + i * 8);
        var whi = load64(w + (119 - i) * 8);
        store64(out + i * 8, f64_sub(f64_mul(x2, whi), f64_mul(x1, wlo)));
        store64(out + (119 - i) * 8, f64_add(f64_mul(x2, wlo), f64_mul(x1, whi)));
        i = i + 1;
    }
    return 0;
}

# clt_mdct_forward — forward MDCT (mdct.c float path), inverse of clt_mdct_backward.
# Windows/folds `in` (frame + 120-sample overlap) into N4 complex, pre-rotates (scale
# = 1/N4), runs the same direct N4-point DFT as the backward transform, post-rotates
# into `out` (N2 real coeffs, stride out_stride). N = 1920>>shift, N2=N/2, N4=N/4.
fn clt_mdct_forward(inp, out, out_stride, shift) {
    _mdct_cache_init(shift);
    var N = 1920 >> shift;
    var N2 = N >> 1;
    var N4 = N >> 2;
    var t = load64(_mdct_trig + shift * 8);
    var dc = load64(_mdct_dc + shift * 8);
    var ds = load64(_mdct_ds + shift * 8);
    var w = _celt_window;
    var scale = f64_div(F64_ONE, f64_from(N4));
    var f = alloc(N2 * 8);          # interleaved re/im: N4 complex
    var Cr = alloc(N4 * 8);
    var Ci = alloc(N4 * 8);
    # --- window / shuffle / fold: input [a,b,c,d] -> f ---
    var nfirst = (120 + 3) >> 2;    # (overlap+3)>>2 = 30
    var xp1 = 60;                   # in + overlap/2
    var xp2 = N2 - 1 + 60;          # in + N2-1 + overlap/2
    var wp1 = 60;                   # window + overlap/2
    var wp2 = 59;                   # window + overlap/2 - 1
    var yp = 0;
    var i = 0;
    while (i < nfirst) {
        store64(f + yp * 8, f64_add(f64_mul(load64(inp + (xp1 + N2) * 8), load64(w + wp2 * 8)), f64_mul(load64(inp + xp2 * 8), load64(w + wp1 * 8))));
        store64(f + (yp + 1) * 8, f64_sub(f64_mul(load64(inp + xp1 * 8), load64(w + wp1 * 8)), f64_mul(load64(inp + (xp2 - N2) * 8), load64(w + wp2 * 8))));
        xp1 = xp1 + 2; xp2 = xp2 - 2; wp1 = wp1 + 2; wp2 = wp2 - 2; yp = yp + 2;
        i = i + 1;
    }
    while (i < N4 - nfirst) {
        store64(f + yp * 8, load64(inp + xp2 * 8));
        store64(f + (yp + 1) * 8, load64(inp + xp1 * 8));
        xp1 = xp1 + 2; xp2 = xp2 - 2; yp = yp + 2;
        i = i + 1;
    }
    var wp1b = 0;                   # window
    var wp2b = 119;                 # window + overlap - 1
    while (i < N4) {
        store64(f + yp * 8, f64_add(f64_neg(f64_mul(load64(inp + (xp1 - N2) * 8), load64(w + wp1b * 8))), f64_mul(load64(inp + xp2 * 8), load64(w + wp2b * 8))));
        store64(f + (yp + 1) * 8, f64_add(f64_mul(load64(inp + xp1 * 8), load64(w + wp2b * 8)), f64_mul(load64(inp + (xp2 + N2) * 8), load64(w + wp1b * 8))));
        xp1 = xp1 + 2; xp2 = xp2 - 2; wp1b = wp1b + 2; wp2b = wp2b - 2; yp = yp + 2;
        i = i + 1;
    }
    # --- pre-rotation (+ scale) ---
    i = 0;
    while (i < N4) {
        var re = load64(f + (2 * i) * 8);
        var im = load64(f + (2 * i + 1) * 8);
        var t0 = load64(t + i * 8);
        var t1 = load64(t + (N4 + i) * 8);
        store64(Cr + i * 8, f64_mul(f64_sub(f64_mul(re, t0), f64_mul(im, t1)), scale));
        store64(Ci + i * 8, f64_mul(f64_add(f64_mul(im, t0), f64_mul(re, t1)), scale));
        i = i + 1;
    }
    # --- N4-point forward DFT (same kernel as backward) ---
    var Fr = alloc(N4 * 8);
    var Fi = alloc(N4 * 8);
    var k = 0;
    while (k < N4) {
        var sr = F64_ZERO;
        var si = F64_ZERO;
        i = 0;
        while (i < N4) {
            var m = (k * i) % N4;
            var cs = load64(dc + m * 8);
            var sn = load64(ds + m * 8);
            var cri = load64(Cr + i * 8);
            var cii = load64(Ci + i * 8);
            sr = f64_add(sr, f64_add(f64_mul(cri, cs), f64_mul(cii, sn)));
            si = f64_add(si, f64_sub(f64_mul(cii, cs), f64_mul(cri, sn)));
            i = i + 1;
        }
        store64(Fr + k * 8, sr);
        store64(Fi + k * 8, si);
        k = k + 1;
    }
    # --- post-rotation -> out (stride) ---
    i = 0;
    while (i < N4) {
        var fr = load64(Fr + i * 8);
        var fi = load64(Fi + i * 8);
        var pt0 = load64(t + i * 8);
        var pt1 = load64(t + (N4 + i) * 8);
        store64(out + (2 * i) * out_stride * 8, f64_sub(f64_mul(fi, pt1), f64_mul(fr, pt0)));
        store64(out + (N2 - 1 - 2 * i) * out_stride * 8, f64_add(f64_mul(fr, pt1), f64_mul(fi, pt0)));
        i = i + 1;
    }
    return 0;
}

# celt_synthesis: per channel denormalise + IMDCT into decode_mem+1088.
fn celt_synthesis(X, dm0, dm1, oldBandE, C, isTransient, silence, start, end, LM) {
    var N = 120 << LM;
    var B = 1;
    var NB = 120 << LM;
    var shift = 3 - LM;
    if (isTransient != 0) { B = 1 << LM; NB = 120; shift = 3; }
    var osoff = 2048 - N;
    var freq = alloc(N * 8);
    var c = 0;
    while (c < C) {
        var Xc = X + c * N * 8;
        var dm = dm0;
        if (c == 1) { dm = dm1; }
        var os = dm + osoff * 8;
        denormalise_bands(Xc, freq, oldBandE + c * 21 * 8, silence, start, end, LM);
        var b = 0;
        while (b < B) {
            clt_mdct_backward(freq + b * 8, B, os + NB * b * 8, shift);
            b = b + 1;
        }
        c = c + 1;
    }
    return 0;
}

# anti_collapse (bands.c:259) — refill collapsed short blocks with scaled noise.
fn anti_collapse(X, collapse_masks, C, size, logE, prevLogE, prevLogE2, pulses, seed_ptr, start, end, LM) {
    var i = start;
    while (i < end) {
        var eb0 = load64(_celt_eBands + i * 8);
        var eb1 = load64(_celt_eBands + (i + 1) * 8);
        var N0 = eb1 - eb0;
        var depth = ((1 + load64(pulses + i * 8)) / N0) >> LM;
        var thresh = f64_mul(F64_HALF, _celt_exp2(f64_neg(f64_mul(f64_div(F64_ONE, f64_from(8)), f64_from(depth)))));
        var sqrt_1 = f64_div(F64_ONE, f64_sqrt(f64_from(N0 << LM)));
        var c = 0;
        while (c < C) {
            var prev1 = load64(prevLogE + (c * 21 + i) * 8);
            var prev2 = load64(prevLogE2 + (c * 21 + i) * 8);
            if (C == 1) {
                prev1 = f64_max(prev1, load64(prevLogE + (21 + i) * 8));
                prev2 = f64_max(prev2, load64(prevLogE2 + (21 + i) * 8));
            }
            var minp = prev1;
            if (f64_lt(prev2, prev1) == 1) { minp = prev2; }
            var Ediff = f64_sub(load64(logE + (c * 21 + i) * 8), minp);
            if (f64_lt(Ediff, F64_ZERO) == 1) { Ediff = F64_ZERO; }
            var r = f64_mul(F64_TWO, _celt_exp2(f64_neg(Ediff)));
            if (LM == 3) { r = f64_mul(r, f64_div(f64_from(141421356), f64_from(100000000))); }   # *sqrt(2), only LM==3 (bands.c:329)
            if (f64_lt(thresh, r) == 1) { r = thresh; }
            r = f64_mul(r, sqrt_1);
            var Xc = X + (c * size + (eb0 << LM)) * 8;
            var renorm = 0;
            var kk = 0;
            while (kk < (1 << LM)) {
                if ((load8(collapse_masks + (i * C + c)) & (1 << kk)) == 0) {
                    var j = 0;
                    while (j < N0) {
                        var seed = celt_lcg_rand(load64(seed_ptr));
                        store64(seed_ptr, seed);
                        var val = r;
                        if ((seed & 0x8000) == 0) { val = f64_neg(r); }
                        store64(Xc + ((j << LM) + kk) * 8, val);
                        j = j + 1;
                    }
                    renorm = 1;
                }
                kk = kk + 1;
            }
            if (renorm != 0) { renormalise_vector(Xc, N0 << LM, F64_ONE); }
            c = c + 1;
        }
        i = i + 1;
    }
    return 0;
}

# deemphasis: out_syn -> interleaved pcm[j*CC+c], with persistent IIR memory.
fn celt_deemphasis(out_syn, pcm, c, CC, preemph_ptr, accum, LM) {
    var m = load64(preemph_ptr + c * 8);
    var j = 0;
    var N = 120 << LM;
    while (j < N) {
        var tmp = f64_add(f64_add(load64(out_syn + j * 8), F64_1E30INV), m);
        m = f64_mul(CELT_DEEMPH, tmp);
        var v = f64_div(tmp, f64_from(32768));
        # Hybrid: accumulate the CELT high band onto the SILK low band already in pcm.
        if (accum != 0) { v = f64_add(load64(pcm + (j * CC + c) * 8), v); }
        store64(pcm + (j * CC + c) * 8, v);
        j = j + 1;
    }
    store64(preemph_ptr + c * 8, m);
    return 0;
}

# ---- pitch post-filter (comb_filter) — celt.c float path ----
var _comb_gains = 0;   # gains[3][3]

fn _comb_gains_init() {
    _comb_gains = alloc(9 * 8);
    store64(_comb_gains + 0 * 8, f64_div(f64_from(10048), f64_from(32768)));  # .3066406250
    store64(_comb_gains + 1 * 8, f64_div(f64_from(7112),  f64_from(32768)));  # .2170410156
    store64(_comb_gains + 2 * 8, f64_div(f64_from(4248),  f64_from(32768)));  # .1296386719
    store64(_comb_gains + 3 * 8, f64_div(f64_from(15200), f64_from(32768)));  # .4638671875
    store64(_comb_gains + 4 * 8, f64_div(f64_from(8784),  f64_from(32768)));  # .2680664062
    store64(_comb_gains + 5 * 8, F64_ZERO);
    store64(_comb_gains + 6 * 8, f64_div(f64_from(26208), f64_from(32768)));  # .7998046875
    store64(_comb_gains + 7 * 8, f64_div(f64_from(3280),  f64_from(32768)));  # .1000976562
    store64(_comb_gains + 8 * 8, F64_ZERO);
    return 0;
}

fn comb_filter_const(y, x, T, N, g10, g11, g12) {
    var x4 = load64(x + (0 - T - 2) * 8);
    var x3 = load64(x + (0 - T - 1) * 8);
    var x2 = load64(x + (0 - T) * 8);
    var x1 = load64(x + (0 - T + 1) * 8);
    var i = 0;
    while (i < N) {
        var x0 = load64(x + (i - T + 2) * 8);
        var yv = f64_add(load64(x + i * 8),
            f64_add(f64_mul(g10, x2),
            f64_add(f64_mul(g11, f64_add(x1, x3)),
                    f64_mul(g12, f64_add(x0, x4)))));
        store64(y + i * 8, yv);
        x4 = x3; x3 = x2; x2 = x1; x1 = x0;
        i = i + 1;
    }
    return 0;
}

# comb_filter in-place (y==x): crossfade old->new params over `overlap`, then const.
fn comb_filter(y, x, T0, T1, N, g0, g1, tapset0, tapset1, overlap) {
    if (_comb_gains == 0) { _comb_gains_init(); }
    if ((g0 == F64_ZERO) & (g1 == F64_ZERO)) { return 0; }
    if (T0 < 15) { T0 = 15; }
    if (T1 < 15) { T1 = 15; }
    var g00 = f64_mul(g0, load64(_comb_gains + (tapset0 * 3 + 0) * 8));
    var g01 = f64_mul(g0, load64(_comb_gains + (tapset0 * 3 + 1) * 8));
    var g02 = f64_mul(g0, load64(_comb_gains + (tapset0 * 3 + 2) * 8));
    var g10 = f64_mul(g1, load64(_comb_gains + (tapset1 * 3 + 0) * 8));
    var g11 = f64_mul(g1, load64(_comb_gains + (tapset1 * 3 + 1) * 8));
    var g12 = f64_mul(g1, load64(_comb_gains + (tapset1 * 3 + 2) * 8));
    var x1 = load64(x + (0 - T1 + 1) * 8);
    var x2 = load64(x + (0 - T1) * 8);
    var x3 = load64(x + (0 - T1 - 1) * 8);
    var x4 = load64(x + (0 - T1 - 2) * 8);
    var ov = overlap;
    if ((g0 == g1) & (T0 == T1) & (tapset0 == tapset1)) { ov = 0; }
    var i = 0;
    while (i < ov) {
        var x0 = load64(x + (i - T1 + 2) * 8);
        var f = f64_mul(load64(_celt_window + i * 8), load64(_celt_window + i * 8));
        var omf = f64_sub(F64_ONE, f);
        var yv = f64_add(load64(x + i * 8),
            f64_add(f64_mul(f64_mul(omf, g00), load64(x + (i - T0) * 8)),
            f64_add(f64_mul(f64_mul(omf, g01), f64_add(load64(x + (i - T0 + 1) * 8), load64(x + (i - T0 - 1) * 8))),
            f64_add(f64_mul(f64_mul(omf, g02), f64_add(load64(x + (i - T0 + 2) * 8), load64(x + (i - T0 - 2) * 8))),
            f64_add(f64_mul(f64_mul(f, g10), x2),
            f64_add(f64_mul(f64_mul(f, g11), f64_add(x1, x3)),
                    f64_mul(f64_mul(f, g12), f64_add(x0, x4))))))));
        store64(y + i * 8, yv);
        x4 = x3; x3 = x2; x2 = x1; x1 = x0;
        i = i + 1;
    }
    if (g1 == F64_ZERO) { return 0; }
    comb_filter_const(y + i * 8, x + i * 8, T1, N - i, g10, g11, g12);
    return 0;
}

# ---- decoder state + full frame decode ----
# State: +0 oldBandE(42) +8 oldLogE(42) +16 oldLogE2(42) +24 dm0(2168) +32 dm1(2168)
#   +40 preemph(2) +48 rng +56 pf_period +64 pf_period_old +72 pf_gain +80 pf_gain_old
#   +88 pf_tapset +96 pf_tapset_old

fn celt_dec_state_new() {
    var st = alloc(112);
    var obe = alloc(42 * 8);
    var ole = alloc(42 * 8);
    var ol2 = alloc(42 * 8);
    var neg28 = f64_neg(f64_from(28));
    var i = 0;
    while (i < 42) {
        store64(obe + i * 8, F64_ZERO);
        store64(ole + i * 8, neg28);
        store64(ol2 + i * 8, neg28);
        i = i + 1;
    }
    var dm0 = alloc(2168 * 8);
    var dm1 = alloc(2168 * 8);
    i = 0;
    while (i < 2168) { store64(dm0 + i * 8, F64_ZERO); store64(dm1 + i * 8, F64_ZERO); i = i + 1; }
    var pre = alloc(2 * 8);
    store64(pre + 0, F64_ZERO);
    store64(pre + 8, F64_ZERO);
    store64(st + 0, obe);
    store64(st + 8, ole);
    store64(st + 16, ol2);
    store64(st + 24, dm0);
    store64(st + 32, dm1);
    store64(st + 40, pre);
    store64(st + 48, 0);
    store64(st + 56, 0);
    store64(st + 64, 0);
    store64(st + 72, F64_ZERO);
    store64(st + 80, F64_ZERO);
    store64(st + 88, 0);
    store64(st + 96, 0);
    return st;
}

# Payload wrapper: CELT-only fullband (start=0, end=21, no accumulate, fresh ec).
fn celt_decode_frame(st, payload, len, C, pcm_out) {
    return celt_decode_frame_ec(st, ec_dec_new(payload, len), len, C, 0, 21, 0, 3, pcm_out);
}

# celt_spreading_decision (bands.c): choose the PVQ spread (NONE/LIGHT/NORMAL/AGGRESSIVE) from
# the normalized shape X — a rough CDF of |x[j]|²·N per band, averaged + hysteresis. Encoder
# quality: replaces the hardcoded SPREAD_NORMAL. avg_ptr holds the running average (0 = fresh);
# spread_weight is uniform 1 here (libopus weights by fine-bit importance). Tapset omitted
# (no post-filter). Returns 0/1/2/3.
fn celt_spreading_decision(X, end, C, LM, avg_ptr, last_decision) {
    var M = 1 << LM;
    var N0 = M * 120;
    if (M * (load64(_celt_eBands + end * 8) - load64(_celt_eBands + (end - 1) * 8)) <= 8) { return 0; }
    var q4 = f64_div(F64_ONE, f64_from(4));
    var q16 = f64_div(F64_ONE, f64_from(16));
    var q64 = f64_div(F64_ONE, f64_from(64));
    var sum = 0;
    var nbBands = 0;
    var c = 0;
    while (c < C) {
        var i = 0;
        while (i < end) {
            var N = M * (load64(_celt_eBands + (i + 1) * 8) - load64(_celt_eBands + i * 8));
            if (N > 8) {
                var xb = X + (M * load64(_celt_eBands + i * 8) + c * N0) * 8;
                var t0 = 0; var t1 = 0; var t2 = 0;
                var j = 0;
                while (j < N) {
                    var xj = load64(xb + j * 8);
                    var x2N = f64_mul(f64_mul(xj, xj), f64_from(N));
                    if (f64_lt(x2N, q4) == 1) { t0 = t0 + 1; }
                    if (f64_lt(x2N, q16) == 1) { t1 = t1 + 1; }
                    if (f64_lt(x2N, q64) == 1) { t2 = t2 + 1; }
                    j = j + 1;
                }
                var tmp = 0;
                if (2 * t2 >= N) { tmp = tmp + 1; }
                if (2 * t1 >= N) { tmp = tmp + 1; }
                if (2 * t0 >= N) { tmp = tmp + 1; }
                sum = sum + tmp;
                nbBands = nbBands + 1;
            }
            i = i + 1;
        }
        c = c + 1;
    }
    if (nbBands == 0) { return 2; }
    sum = (sum << 8) / nbBands;
    sum = (sum + load64(avg_ptr)) >> 1;
    store64(avg_ptr, sum);
    sum = (3 * sum + (((3 - last_decision) << 7) + 64) + 2) >> 2;
    var decision = 0;
    if (sum < 80) { decision = 3; }
    else { if (sum < 256) { decision = 2; } else { if (sum < 384) { decision = 1; } } }
    return decision;
}

# celt_transient_analysis (celt_encoder.c:267, float path) — decides whether the frame
# needs short blocks (a sudden energy jump = transient) so the encoder avoids pre-echo.
# in_buf = preemphasized signal (C*len f64, per-channel stride len); returns is_transient
# (0/1) and stashes tf_estimate/tf_chan in globals for later tf/VBR use. A steady tone
# yields a low mask metric → long blocks (better frequency resolution). No weak-transient
# or tone detection (allow_weak_transients=0, toneishness=0) — those only bite at very low
# hybrid bitrate. The mask metric / threshold (>200) is integer, matching libopus exactly;
# the float shifts (SHR32/PSHR32/SROUND16) are all no-ops in the float build (arch.h).
fn celt_transient_analysis(in_buf, len, C) {
    if (_celt_inv_table == 0) { _celt_bands_tables_init(); }
    var len2 = len / 2;
    var forward_decay = f64_div(f64_from(1), f64_from(16));       # 0.0625 (6.7 dB/ms fwd mask)
    var one_m_fd = f64_div(f64_from(15), f64_from(16));           # 1 - forward_decay
    var c_875 = f64_div(f64_from(7), f64_from(8));                # 0.875 (backward mask)
    var c_125 = f64_div(f64_from(1), f64_from(8));                # 0.125
    var eps = f64_div(f64_from(1), f64_from(1000000000000000));   # EPSILON 1e-15
    var tmp = alloc(len * 8);
    var mask_metric = 0;
    var tf_chan = 0;
    var c = 0;
    while (c < C) {
        # High-pass filter (1 - 2z^-1 + z^-2)/(1 - z^-1 + .5z^-2) — modified dep-chain form
        var mem0 = f64_from(0);
        var mem1 = f64_from(0);
        var i = 0;
        while (i < len) {
            var x = load64(in_buf + (i + c * len) * 8);
            var y = f64_add(mem0, x);
            var mem00 = mem0;
            mem0 = f64_add(f64_sub(mem0, x), f64_mul(F64_HALF, mem1));
            mem1 = f64_sub(x, mem00);
            store64(tmp + i * 8, y);                              # SROUND16(y,2) = y (float no-op)
            i = i + 1;
        }
        i = 0;                                                    # first 12 = filter warm-up garbage
        while (i < 12) { store64(tmp + i * 8, f64_from(0)); i = i + 1; }
        # Forward pass: post-echo threshold (leaky integrator), grouping by two
        var mean = f64_from(0);
        mem0 = f64_from(0);
        i = 0;
        while (i < len2) {
            var t0 = load64(tmp + (2 * i) * 8);
            var t1 = load64(tmp + (2 * i + 1) * 8);
            var x2 = f64_add(f64_mul(t0, t0), f64_mul(t1, t1));
            mean = f64_add(mean, x2);
            mem0 = f64_add(x2, f64_mul(one_m_fd, mem0));
            store64(tmp + i * 8, f64_mul(forward_decay, mem0));
            i = i + 1;
        }
        # Backward pass: pre-echo threshold; track max envelope
        mem0 = f64_from(0);
        var maxE = f64_from(0);
        i = len2 - 1;
        while (i >= 0) {
            var ti = load64(tmp + i * 8);
            mem0 = f64_add(ti, f64_mul(c_875, mem0));
            var v = f64_mul(c_125, mem0);
            store64(tmp + i * 8, v);
            maxE = f64_max(maxE, v);
            i = i - 1;
        }
        # Frame energy = geometric mean of energy and half the max; norm = inverse mean
        var meanE = f64_sqrt(f64_mul(f64_mul(f64_mul(mean, maxE), F64_HALF), f64_from(len2)));
        var norm = f64_div(f64_from(len2), f64_add(eps, meanE));
        # Harmonic mean of the reliable interior, sampling 1/4 (integer accumulate)
        var unmask = 0;
        i = 12;
        while (i < len2 - 5) {
            var arg = f64_mul(f64_from(64), f64_mul(norm, f64_add(load64(tmp + i * 8), eps)));
            var id = f64_to(f64_floor(arg));
            if (id < 0) { id = 0; }
            if (id > 127) { id = 127; }
            unmask = unmask + load8(_celt_inv_table + id);
            i = i + 4;
        }
        # Normalize: compensate 1/4 sampling + factor 6 in inv_table (integer division)
        var um = (64 * unmask * 4) / (6 * (len2 - 17));
        if (um > mask_metric) { tf_chan = c; mask_metric = um; }
        c = c + 1;
    }
    var is_transient = 0;
    if (mask_metric > 200) { is_transient = 1; }
    # tf_estimate (tf/VBR hint): sqrt(max(0, 0.0069·min(163,tf_max) − 0.139)), tf_max=max(0,sqrt(27·mm)−42)
    var tf_max = f64_sub(f64_sqrt(f64_from(27 * mask_metric)), f64_from(42));
    if (f64_lt(tf_max, f64_from(0)) != 0) { tf_max = f64_from(0); }
    if (f64_gt(tf_max, f64_from(163)) != 0) { tf_max = f64_from(163); }
    var c_0069 = f64_div(f64_from(69), f64_from(10000));          # 0.0069
    var c_0139 = f64_div(f64_from(139), f64_from(1000));          # 0.139
    var tfe_arg = f64_sub(f64_mul(c_0069, tf_max), c_0139);
    if (f64_lt(tfe_arg, f64_from(0)) != 0) { tfe_arg = f64_from(0); }
    _celt_tf_estimate = f64_sqrt(tfe_arg);
    _celt_tf_chan = tf_chan;
    return is_transient;
}

# celt_preemphasis (celt_encoder.c): the exact inverse of the decoder's deemphasis IIR —
# pre[n] = 32768·pcm[n] − coef·(32768·pcm[n−1]), coef = CELT_DEEMPH. mem_ptr[c] holds the
# scaled previous sample (0 = fresh). Feeds the forward MDCT.
fn celt_preemphasis(pcm_in, pre, nsamp, C, mem_ptr) {
    var c = 0;
    while (c < C) {
        var mem = load64(mem_ptr + c * 8);
        var i = 0;
        while (i < nsamp) {
            var x = f64_mul(load64(pcm_in + (i * C + c) * 8), f64_from(32768));
            store64(pre + (i + c * nsamp) * 8, f64_sub(x, f64_mul(CELT_DEEMPH, mem)));
            mem = x;
            i = i + 1;
        }
        store64(mem_ptr + c * 8, mem);
        c = c + 1;
    }
    return 0;
}

# celt_compute_mdcts (celt_encoder.c): forward-MDCT the preemphasized frame — one long block
# (shift = maxLM−LM) or, if transient, M short blocks (shift = maxLM = 3), interleaved into freq.
# `nsamp` = per-channel input stride (N + overlap). Uses the verified clt_mdct_forward.
fn celt_compute_mdcts(pre, freq, C, LM, isTransient, nsamp) {
    var M = 1 << LM;
    var N = 120 << LM;
    var B = 1;
    var shift = 3 - LM;
    if (isTransient != 0) { B = M; shift = 3; }
    var nb = N / B;
    var c = 0;
    while (c < C) {
        var b = 0;
        while (b < B) {
            clt_mdct_forward(pre + (c * nsamp + b * nb) * 8, freq + (b + c * N) * 8, B, shift);
            b = b + 1;
        }
        c = c + 1;
    }
    return 0;
}

# celt_encode — the PCM-in front-end: preemphasize (mem_ptr persists across frames; 0 = fresh)
# → forward MDCT (long/short per isTransient) → celt_encode_frame_ec. pcm holds N+overlap
# interleaved samples per channel (the frame plus 120-sample lookahead). Returns the chosen intra.
# isTransient: 0/1 forces long/short blocks; a negative sentinel (−1) auto-detects via
# celt_transient_analysis on the preemphasized signal (the encoder's own short-block decision).
fn celt_encode(st, ec, pcm, C, LM, force_intra, isTransient, mem_ptr) {
    var N = 120 << LM;
    var nsamp = N + 120;
    var pre = alloc(C * nsamp * 8);
    celt_preemphasis(pcm, pre, nsamp, C, mem_ptr);
    var it = isTransient;
    if (it < 0) {                                    # sentinel: auto-detect from the signal
        it = 0;
        if (LM > 0) { it = celt_transient_analysis(pre, nsamp, C); }
    }
    var freq = alloc(C * N * 8);
    celt_compute_mdcts(pre, freq, C, LM, it, nsamp);
    return celt_encode_frame_ec(st, ec, freq, C, LM, 0, 21, force_intra, it);
}

# celt_encode_frame_ec — encode CELT bands [start,end) into a caller-owned range ENCODER.
# `freq` holds the C*N MDCT coefficients. Mono/stereo, with the real encoder-quality knobs:
# adaptive spread, 2-pass coarse-energy intra/inter race, per-band tf resolution (tf_analysis),
# and masking-driven dynalloc boosts (mono). Mirrors celt_decode_frame_ec's prefix bit-for-bit.
fn celt_encode_frame_ec(st, ec, freq, C, LM, start, end, force_intra, isTransient) {
    if (_celt_eMeans == 0) { _celt_bands_tables_init(); }
    var M = 1 << LM;
    var N = 120 << LM;
    var len = load64(ec + 8);
    var total_bits = len * 8;
    var oldBandE = load64(st + 0);
    # --- band energies -> log, normalize ---
    var bandE = alloc(C * 21 * 8);
    compute_band_energies(freq, bandE, end, C, LM);
    var bandLogE = alloc(C * 21 * 8);
    var c0 = 0;
    while (c0 < C) {
        var bi = 0;
        while (bi < end) {
            var e = load64(bandE + (bi + c0 * 21) * 8);
            store64(bandLogE + (bi + c0 * 21) * 8, f64_sub(f64_log2(e), load64(_celt_eMeans + bi * 8)));
            bi = bi + 1;
        }
        c0 = c0 + 1;
    }
    var X = alloc(C * N * 8);
    normalise_bands(freq, X, bandE, end, C, LM);
    # --- dynalloc analysis (offsets + tf importance) — mono; stereo keeps the flat fallback ---
    var offsets = alloc(21 * 8);
    var importance = alloc(21 * 8);
    var idf = 0; while (idf < 21) { store64(offsets + idf * 8, 0); store64(importance + idf * 8, 13); idf = idf + 1; }
    if (C == 1) { celt_dynalloc_analysis(bandLogE, end, LM, len, offsets, importance, isTransient); }
    # --- prefix ---
    var tell = ec_tell(ec);
    if (tell == 1) { ec_enc_bit_logp(ec, 0, 15); }                              # R1 silence=0
    tell = ec_tell(ec);
    if ((start == 0) & (tell + 16 <= total_bits)) { ec_enc_bit_logp(ec, 0, 1); }  # R2 postfilter=0
    tell = ec_tell(ec);
    if (tell + 3 <= total_bits) { ec_enc_bit_logp(ec, isTransient, 3); }         # R3 transient=0
    var error = alloc(C * 21 * 8);
    var chosen_intra = quant_coarse_energy(start, end, bandLogE, oldBandE, error, ec, C, LM, force_intra, len);  # R5 (writes intra+coarse)
    var tf = alloc(21 * 8);
    var ti = 0; while (ti < 21) { store64(tf + ti * 8, 0); ti = ti + 1; }
    var lambda = 20480 / len + 2; if (lambda < 80) { lambda = 80; }              # rate.c-style tf-change cost
    var tfc = _celt_tf_chan; if (tfc >= C) { tfc = 0; }
    var tf_select = celt_tf_analysis(X, N, end, isTransient, LM, _celt_tf_estimate, tfc, lambda, tf, importance);
    celt_tf_encode(tf, isTransient, tf_select, ec, start, end, LM);                  # R6 tf (real per-band)
    var spread_avg = alloc(8); store64(spread_avg, 0);
    var spread = celt_spreading_decision(X, end, C, LM, spread_avg, 2);   # R7 spread (adaptive)
    tell = ec_tell(ec);
    if (tell + 4 <= total_bits) { ec_enc_icdf(ec, spread, _celt_spreadIcdf, 5); }
    var cap = alloc(21 * 8);
    celt_init_caps(cap, LM, C);                                                  # R8 caps
    # R9 dynalloc — encode the per-band boosts computed above (offsets in 1/64-bit units)
    var dynalloc_logp = 6;
    var tb2 = total_bits << 3;
    tell = ec_tell_frac(ec);
    var i2 = start;
    while (i2 < end) {
        var width = (C * (load64(_celt_eBands + (i2 + 1) * 8) - load64(_celt_eBands + i2 * 8))) << LM;
        var q1 = width << 3;
        var q2m = 48; if (width > q2m) { q2m = width; }
        var quanta = q1; if (q2m < quanta) { quanta = q2m; }
        var dll = dynalloc_logp;
        var boost = 0;
        var loopc = 1;
        while (loopc == 1) {
            if ((tell + (dll << 3) < tb2) & (boost < load64(cap + i2 * 8))) {
                var flag = 0;
                if (boost < load64(offsets + i2 * 8)) { flag = 1; }
                ec_enc_bit_logp(ec, flag, dll);
                tell = ec_tell_frac(ec);
                if (flag == 0) { loopc = 0; }
                else { boost = boost + quanta; tb2 = tb2 - quanta; dll = 1; }
            } else { loopc = 0; }
        }
        store64(offsets + i2 * 8, boost);
        if (boost > 0) { dynalloc_logp = dynalloc_logp - 1; if (dynalloc_logp < 2) { dynalloc_logp = 2; } }
        i2 = i2 + 1;
    }
    var alloc_trim = 5;
    if (tell + 48 <= tb2) { ec_enc_icdf(ec, alloc_trim, _celt_trimIcdf, 7); }     # R10 alloc_trim
    var bits = (total_bits << 3) - ec_tell_frac(ec) - 1;                          # R11 budget
    var acr = 0;
    if ((isTransient != 0) & (LM >= 2) & (bits >= ((LM + 2) << 3))) { acr = 8; }
    bits = bits - acr;
    var pulses = alloc(21 * 8);
    var fine_quant = alloc(21 * 8);
    var fine_priority = alloc(21 * 8);
    var intensity = alloc(8);
    var dual = alloc(8);
    var balance = alloc(8);
    store64(intensity, 0); store64(dual, 0);
    if (C == 2) {                                                                # intensity from bitrate
        var eq_kbps = (len * 384) / (120 << LM);
        var it2 = _celt_hysteresis(eq_kbps, _celt_int_thr, _celt_int_hyst, 21, 0);
        if (it2 < start) { it2 = start; }
        if (it2 > end) { it2 = end; }
        store64(intensity, it2);
        if (LM != 0) { store64(dual, stereo_analysis(X, LM, N)); }                # joint vs dual stereo
        _celt_last_dual = load64(dual);
    }
    var codedBands = celt_compute_allocation(offsets, cap, alloc_trim, intensity, dual, bits, balance, pulses, fine_quant, fine_priority, C, LM, ec, start, end, 1, 0, end);  # R12
    quant_fine_energy(oldBandE, error, fine_quant, ec, C, start, end);            # R13 fine
    # --- bands ---
    var shortBlocks = 0;
    if (isTransient != 0) { shortBlocks = M; }
    var collapse = alloc(C * 21);
    var Y = 0;
    if (C == 2) { Y = X + N * 8; }
    store64(st + 48, 0);   # fold-noise seed (matches decode)
    _celt_enc_bandE = bandE;   # hand the band energies to quant_all_bands for stereo intensity/MIN_STEREO
    quant_all_bands(X, Y, collapse, pulses, shortBlocks, spread, load64(dual), load64(intensity), tf, len * 64 - acr, load64(balance), ec, LM, codedBands, st + 48, 0, C, start, end, 1);
    if (acr > 0) { ec_enc_bits(ec, 0, 1); }                                       # anti-collapse off
    quant_energy_finalise(oldBandE, error, fine_quant, fine_priority, len * 8 - ec_tell(ec), ec, C, start, end);
    return chosen_intra;
}

# ec-taking core: decode CELT bands [start,end) from a caller-owned range decoder,
# optionally accumulating onto pcm_out (hybrid: start=17, accum=1). Config-31 passes
# (start=0, end=21, accum=0) for bit-identical behaviour.
fn celt_decode_frame_ec(st, ec, len, C, start, end, accum, LM, pcm_out) {
    var oldBandE = load64(st + 0);
    var oldLogE = load64(st + 8);
    var oldLogE2 = load64(st + 16);
    var dm0 = load64(st + 24);
    var dm1 = load64(st + 32);
    var preemph = load64(st + 40);
    var N = 120 << LM;                # frame size: 480 (10ms) or 960 (20ms)
    var M = 1 << LM;
    var dmove = 2168 - N;             # decode_mem slide length (2168 = DECODE_BUFFER_SIZE+overlap)
    var osoff = 2048 - N;             # out_syn offset into decode_mem
    # R14 slide history: OPUS_MOVE(dm, dm+N, 2168-N)
    var c0 = 0;
    while (c0 < C) {
        var dm = dm0;
        if (c0 == 1) { dm = dm1; }
        var mi = 0;
        while (mi < dmove) { store64(dm + mi * 8, load64(dm + (mi + N) * 8)); mi = mi + 1; }
        c0 = c0 + 1;
    }
    var tf = alloc(21 * 8);
    var off = alloc(21 * 8);
    var pul = alloc(21 * 8);
    var fq = alloc(21 * 8);
    var fp = alloc(21 * 8);
    var cap = alloc(21 * 8);
    var scal = alloc(16 * 8);
    celt_decode_frame_prefix_ec(ec, len, C, LM, start, end, oldBandE, tf, off, pul, fq, fp, cap, scal);
    var silence = load64(scal + 0);
    var isTransient = load64(scal + 8);
    var acr = load64(scal + 40);
    var pf_pitch = load64(scal + 80);
    var pf_tapset = load64(scal + 88);
    var pf_gain = load64(scal + 96);
    var X = alloc(C * N * 8);
    var z = 0;
    while (z < C * N) { store64(X + z * 8, F64_ZERO); z = z + 1; }
    var Y = 0;
    if (C == 2) { Y = X + N * 8; }
    var collapse = alloc(C * 21);
    var shortBlocks = 0;
    if (isTransient != 0) { shortBlocks = M; }
    var total_bits = len * 64 - acr;
    quant_all_bands(X, Y, collapse, pul, shortBlocks, load64(scal + 24), load64(scal + 64), load64(scal + 56), tf, total_bits, load64(scal + 72), ec, LM, load64(scal + 48), st + 48, 0, C, start, end, 0);
    var anti_collapse_on = 0;
    if (acr > 0) { anti_collapse_on = ec_dec_bits(ec, 1); }
    celt_unquant_energy_finalise(oldBandE, fq, fp, len * 8 - ec_tell(ec), ec, C, start, end);
    if (anti_collapse_on != 0) {
        anti_collapse(X, collapse, C, N, oldBandE, oldLogE, oldLogE2, pul, st + 48, start, end, LM);
    }
    if (silence != 0) {
        var s = 0;
        while (s < C * 21) { store64(oldBandE + s * 8, f64_neg(f64_from(28))); s = s + 1; }
    }
    celt_synthesis(X, dm0, dm1, oldBandE, C, isTransient, silence, start, end, LM);
    # R22 postfilter (comb_filter) — in place on out_syn = dm+1088
    var pperiod = load64(st + 56);
    var pperiod_old = load64(st + 64);
    var pgain = load64(st + 72);
    var pgain_old = load64(st + 80);
    var ptap = load64(st + 88);
    var ptap_old = load64(st + 96);
    if (pperiod < 15) { pperiod = 15; }
    if (pperiod_old < 15) { pperiod_old = 15; }
    var c = 0;
    while (c < C) {
        var dm = dm0;
        if (c == 1) { dm = dm1; }
        var os = dm + osoff * 8;
        comb_filter(os, os, pperiod_old, pperiod, 120, pgain_old, pgain, ptap_old, ptap, 120);
        comb_filter(os + 120 * 8, os + 120 * 8, pperiod, pf_pitch, N - 120, pgain, pf_gain, ptap, pf_tapset, 120);
        c = c + 1;
    }
    # de-emphasis -> pcm (out_syn = dm+1088)
    c = 0;
    while (c < C) {
        var dm2 = dm0;
        if (c == 1) { dm2 = dm1; }
        celt_deemphasis(dm2 + osoff * 8, pcm_out, c, C, preemph, accum, LM);
        c = c + 1;
    }
    # R23 energy memory rotation
    if (C == 1) {
        var q = 0;
        while (q < 21) { store64(oldBandE + (21 + q) * 8, load64(oldBandE + q * 8)); q = q + 1; }
    }
    if (isTransient == 0) {
        var r = 0;
        while (r < 42) {
            store64(oldLogE2 + r * 8, load64(oldLogE + r * 8));
            store64(oldLogE + r * 8, load64(oldBandE + r * 8));
            r = r + 1;
        }
    } else {
        var r2 = 0;
        while (r2 < 42) {
            store64(oldLogE + r2 * 8, f64_min(load64(oldLogE + r2 * 8), load64(oldBandE + r2 * 8)));
            r2 = r2 + 1;
        }
    }
    # R24 persist rng
    store64(st + 48, load64(ec + 56));
    # postfilter state rotation
    store64(st + 64, pperiod);
    store64(st + 80, pgain);
    store64(st + 96, ptap);
    store64(st + 56, pf_pitch);
    store64(st + 72, pf_gain);
    store64(st + 88, pf_tapset);
    store64(st + 64, pf_pitch);
    store64(st + 80, pf_gain);
    store64(st + 96, pf_tapset);
    return 0;
}

fn test_opus_range_roundtrip() {
    test_group("opus: range coder roundtrip");
    var rc = opus_range_enc_init();
    opus_range_enc_uint(rc, 5, 10);
    opus_range_enc_uint(rc, 100, 128);
    opus_range_enc_uint(rc, 3, 7);
    opus_range_enc_uint(rc, 42, 256);
    opus_range_enc_bit(rc, 1);
    opus_range_enc_bit(rc, 0);
    opus_range_enc_uint(rc, 1000, 4096);
    opus_range_enc_uint(rc, 0, 3);
    opus_range_enc_uint(rc, 65535, 65536);
    var coded = opus_range_enc_flush(rc);
    assert(str_len(coded) > 0, "range coder produces output");

    var rd = opus_range_dec_init(str_data(coded), str_len(coded));
    assert_eq(opus_range_dec_uint(rd, 10), 5, "rc roundtrip uint 5/10");
    assert_eq(opus_range_dec_uint(rd, 128), 100, "rc roundtrip uint 100/128");
    assert_eq(opus_range_dec_uint(rd, 7), 3, "rc roundtrip uint 3/7");
    assert_eq(opus_range_dec_uint(rd, 256), 42, "rc roundtrip uint 42/256");
    assert_eq(opus_range_dec_bit(rd), 1, "rc roundtrip bit 1");
    assert_eq(opus_range_dec_bit(rd), 0, "rc roundtrip bit 0");
    assert_eq(opus_range_dec_uint(rd, 4096), 1000, "rc roundtrip uint 1000/4096");
    assert_eq(opus_range_dec_uint(rd, 3), 0, "rc roundtrip uint 0/3");
    assert_eq(opus_range_dec_uint(rd, 65536), 65535, "rc roundtrip uint 65535/65536");
    return 0;
}

# ================================================================
# CELT band structure (Bark-scale at 48 kHz, 20ms)
# ================================================================

# 21 bands, boundaries in MDCT bin indices (960 samples -> 480 bins)
var _celt_band_edges = 0;
var _CELT_NUM_BANDS = 21;

fn _opus_init_bands() {
    _celt_band_edges = alloc(22 * 8);
    store64(_celt_band_edges + 0 * 8, 0);
    store64(_celt_band_edges + 1 * 8, 1);
    store64(_celt_band_edges + 2 * 8, 2);
    store64(_celt_band_edges + 3 * 8, 3);
    store64(_celt_band_edges + 4 * 8, 4);
    store64(_celt_band_edges + 5 * 8, 5);
    store64(_celt_band_edges + 6 * 8, 6);
    store64(_celt_band_edges + 7 * 8, 7);
    store64(_celt_band_edges + 8 * 8, 8);
    store64(_celt_band_edges + 9 * 8, 10);
    store64(_celt_band_edges + 10 * 8, 12);
    store64(_celt_band_edges + 11 * 8, 14);
    store64(_celt_band_edges + 12 * 8, 17);
    store64(_celt_band_edges + 13 * 8, 21);
    store64(_celt_band_edges + 14 * 8, 26);
    store64(_celt_band_edges + 15 * 8, 32);
    store64(_celt_band_edges + 16 * 8, 40);
    store64(_celt_band_edges + 17 * 8, 50);
    store64(_celt_band_edges + 18 * 8, 62);
    store64(_celt_band_edges + 19 * 8, 78);
    store64(_celt_band_edges + 20 * 8, 100);
    store64(_celt_band_edges + 21 * 8, 480);
    return 0;
}

# ================================================================
# Opus decoder — header parsing + duration estimation
# ================================================================

fn _opus_find_last_granule(data, len) {
    if (len < 27) { return 0 - 1; }
    var pos = len - 27;
    while (pos >= 0) {
        if (load8(data + pos) == 0x4F) {
            if (load8(data + pos + 1) == 0x67) {
                if (load8(data + pos + 2) == 0x67) {
                    if (load8(data + pos + 3) == 0x53) {
                        if (load8(data + pos + 4) == 0) {
                            if (pos + 14 <= len) {
                                var granule = load8(data + pos + 6);
                                granule = granule | (load8(data + pos + 7) << 8);
                                granule = granule | (load8(data + pos + 8) << 16);
                                granule = granule | (load8(data + pos + 9) << 24);
                                granule = granule | (load8(data + pos + 10) << 32);
                                granule = granule | (load8(data + pos + 11) << 40);
                                granule = granule | (load8(data + pos + 12) << 48);
                                granule = granule | (load8(data + pos + 13) << 56);
                                return granule;
                            }
                        }
                    }
                }
            }
        }
        if (pos == 0) { return 0 - 1; }
        pos = pos - 1;
    }
    return 0 - 1;
}

# ---- RFC 6716 4.5.1: redundant CELT frames at mode transitions -----------------
# When an encoder switches between SILK-only/hybrid and CELT-only it embeds an
# extra 5 ms CELT frame so the transition does not click. shravan read the flag in
# the hybrid path but never decoded the frame, and never read it at all in
# SILK-only mode -- where the flag is IMPLICIT (opus_decoder.c:458-460). The
# visible cost was not a click: the CELT decoder entered the CELT run with stale
# state, so the first frames after every SILK->CELT switch were wrong and only
# converged over ~5 frames.

# Reset a CELT decoder state to its post-construction values (OPUS_RESET_STATE).
fn celt_dec_state_reset(st) {
    var obe = load64(st + 0);
    var ole = load64(st + 8);
    var ol2 = load64(st + 16);
    var neg28 = f64_neg(f64_from(28));
    var i = 0;
    while (i < 42) {
        store64(obe + i * 8, F64_ZERO);
        store64(ole + i * 8, neg28);
        store64(ol2 + i * 8, neg28);
        i = i + 1;
    }
    var dm0 = load64(st + 24);
    var dm1 = load64(st + 32);
    i = 0;
    while (i < 2168) { store64(dm0 + i * 8, F64_ZERO); store64(dm1 + i * 8, F64_ZERO); i = i + 1; }
    var pre = load64(st + 40);
    store64(pre + 0, F64_ZERO);
    store64(pre + 8, F64_ZERO);
    store64(st + 48, 0); store64(st + 56, 0); store64(st + 64, 0);
    store64(st + 72, F64_ZERO); store64(st + 80, F64_ZERO);
    store64(st + 88, 0); store64(st + 96, 0);
    return 0;
}

# smooth_fade (opus_decoder.c:205): out = w*in2 + (1-w)*in1 with w = window^2.
fn _opus_smooth_fade(in1, in2, out, overlap, C) {
    if (_celt_window == 0) { _celt_window_init(); }
    var c = 0;
    while (c < C) {
        var i = 0;
        while (i < overlap) {
            var wv = load64(_celt_window + i * 8);
            var w = f64_mul(wv, wv);
            var a = load64(in1 + (i * C + c) * 8);
            var b = load64(in2 + (i * C + c) * 8);
            store64(out + (i * C + c) * 8,
                    f64_add(f64_mul(w, b), f64_mul(f64_sub(F64_ONE, w), a)));
            i = i + 1;
        }
        c = c + 1;
    }
    return 0;
}

# Decode the redundant frame: always 5 ms (F5 = 240 samples => LM=1) and start
# band 0, from its OWN range decoder over the trailing `rb` bytes of the frame.
# For a SILK->CELT transition (celt_to_silk == 0) the CELT decoder is stale, so
# libopus resets it first and the decode doubles as priming for the CELT run that
# follows (opus_decoder.c:637). Returns the 240-frame, C-channel buffer.
fn _opus_redundancy_decode(cst, fdata, newlen, rb, celt_to_silk, endband, C) {
    var red = alloc(2 * 240 * 8);
    var zz = 0;
    while (zz < 2 * 240) { store64(red + zz * 8, F64_ZERO); zz = zz + 1; }
    if (celt_to_silk == 0) { celt_dec_state_reset(cst); }
    celt_decode_frame_ec(cst, ec_dec_new(fdata + newlen, rb), rb, C, 0, endband, 0, 1, red);
    return red;
}

# Mix a decoded redundant frame into `pcm`, which holds `fsamp` frames of C channels.
fn _opus_redundancy_mix(red, celt_to_silk, C, pcm, fsamp) {
    if (celt_to_silk == 0) {
        # SILK -> CELT: the redundant frame covers the END of this frame.
        if (fsamp >= 120) {
            _opus_smooth_fade(pcm + (fsamp - 120) * C * 8, red + 120 * C * 8,
                              pcm + (fsamp - 120) * C * 8, 120, C);
        }
    } else {
        # CELT -> SILK: it covers the START -- copied outright over the first
        # 2.5 ms, then cross-faded over the next 2.5 ms.
        var i = 0;
        while (i < 120) {
            var c2 = 0;
            while (c2 < C) {
                store64(pcm + (i * C + c2) * 8, load64(red + (i * C + c2) * 8));
                c2 = c2 + 1;
            }
            i = i + 1;
        }
        _opus_smooth_fade(red + 120 * C * 8, pcm + 120 * C * 8,
                          pcm + 120 * C * 8, 120, C);
    }
    return 0;
}

# Read the redundancy header off the tail of a SILK-mode frame, decode the 5 ms
# CELT frame it points at, and mix it into `pcm`. `pcm` holds `fsamp` interleaved
# frames of `C` channels. Returns 1 if a redundant frame was decoded.
#   is_hybrid: hybrid frames carry an explicit flag and an explicit size;
#              SILK-only frames have neither (flag implied, size = the rest).
# Must be called with `ec` positioned exactly where the SILK data ended.
fn _opus_decode_redundancy(cst, ec, fdata, flen, is_hybrid, endband, C, pcm, fsamp) {
    var need = 17;
    if (is_hybrid == 1) { need = 37; }          # +20 for hybrid (opus_decoder.c:454)
    if (ec_tell(ec) + need > 8 * flen) { return 0; }
    var redundancy = 1;
    if (is_hybrid == 1) { redundancy = ec_dec_bit_logp(ec, 12); }
    if (redundancy == 0) { return 0; }
    var celt_to_silk = ec_dec_bit_logp(ec, 1);
    var rb = 0;
    if (is_hybrid == 1) {
        rb = ec_dec_uint(ec, 256) + 2;
    } else {
        rb = flen - ((ec_tell(ec) + 7) >> 3);
    }
    var newlen = flen - rb;
    # Sanity check; a valid packet never trips it (opus_decoder.c:471).
    if (newlen < 0) { return 0; }
    if (newlen * 8 < ec_tell(ec)) { return 0; }
    if (rb < 2) { return 0; }
    store64(ec + 8, load64(ec + 8) - rb);       # shrink storage past the raw bytes

    var red = _opus_redundancy_decode(cst, fdata, newlen, rb, celt_to_silk, endband, C);
    _opus_redundancy_mix(red, celt_to_silk, C, pcm, fsamp);
    return 1;
}

# ---- RFC 6716 section 3.2: Opus packet framing -------------------------------
# A packet's TOC byte carries a 2-bit frame-count code, and until 2.7.3 shravan
# read that code but only ever acted on code 0. Everything else fell through to
# silence (SILK) or was handed to the CELT decoder whole, frame-count byte and
# padding included. That is not a corner case: libopus pads CBR SILK streams
# using code 3, so ordinary .opus files decoded to silence for most frames.

# Frame length field: one byte below 252, otherwise two, the second scaled by 4
# (RFC 6716 3.2.1). Writes the length to `out_ptr` and returns the bytes consumed,
# or -1 if the field runs past the end of the packet.
fn _opus_parse_size(data, pos, plen, out_ptr) {
    if (pos >= plen) { return 0 - 1; }
    var b1 = load8(data + pos);
    if (b1 < 252) { store64(out_ptr, b1); return 1; }
    if (pos + 1 >= plen) { return 0 - 1; }
    var b2 = load8(data + pos + 1);
    store64(out_ptr, b1 + 4 * b2);
    return 2;
}

# Samples at 48 kHz in ONE frame of the given config.
#   configs 0-11  SILK:   10 / 20 / 40 / 60 ms by (config & 3)
#   configs 12-15 hybrid: 10 ms (12,14) or 20 ms (13,15)
#   configs 16-31 CELT:   2.5 / 5 / 10 / 20 ms by (config & 3)
fn _opus_frame_samples(config) {
    if (config < 12) {
        var k = config & 3;
        if (k == 0) { return 480; }
        if (k == 1) { return 960; }
        if (k == 2) { return 1920; }
        return 2880;
    }
    if (config < 16) {
        if ((config & 1) == 0) { return 480; }
        return 960;
    }
    var c = config & 3;
    if (c == 0) { return 120; }
    if (c == 1) { return 240; }
    if (c == 2) { return 480; }
    return 960;
}

# Split a packet into its constituent Opus frames. `offs`/`lens` receive the byte
# offset and length of each frame relative to `data`. Returns the frame count, or
# a packed error. Mirrors libopus opus_packet_parse_impl, including its validity
# checks -- a packet may hold at most 48 frames and at most 120 ms of audio, and
# every length must lie inside the packet. Those bounds are what keep a hostile
# packet from walking off the end of the buffer.
fn _opus_split_frames(data, plen, offs, lens, maxf) {
    if (plen < 1) { return err(ERR_DECODE); }
    var toc = load8(data);
    var config = (toc >> 3) & 0x1F;
    var code = toc & 3;
    var fsz = _opus_frame_samples(config);
    var pos = 1;                       # past the TOC
    var rem = plen - 1;

    if (code == 0) {
        if (maxf < 1) { return err(ERR_DECODE); }
        store64(offs, pos); store64(lens, rem);
        return 1;
    }

    if (code == 1) {
        # Two frames, equal size -- so the remainder must be even.
        if ((rem & 1) != 0) { return err(ERR_DECODE); }
        if (maxf < 2) { return err(ERR_DECODE); }
        if (fsz * 2 > 5760) { return err(ERR_DECODE); }
        var half = rem >> 1;
        store64(offs, pos);            store64(lens, half);
        store64(offs + 8, pos + half); store64(lens + 8, half);
        return 2;
    }

    if (code == 2) {
        # Two frames, the first with an explicit length.
        if (maxf < 2) { return err(ERR_DECODE); }
        if (fsz * 2 > 5760) { return err(ERR_DECODE); }
        var n1 = alloc(8);
        var used = _opus_parse_size(data, pos, plen, n1);
        if (used < 0) { return err(ERR_DECODE); }
        pos = pos + used;
        rem = rem - used;
        var l0 = load64(n1);
        if (l0 > rem) { return err(ERR_DECODE); }
        store64(offs, pos);           store64(lens, l0);
        store64(offs + 8, pos + l0);  store64(lens + 8, rem - l0);
        return 2;
    }

    # code 3: an explicit frame count, optional padding, and either equal-sized
    # (CBR) or individually-sized (VBR) frames.
    if (rem < 1) { return err(ERR_DECODE); }
    var fc = load8(data + pos);
    pos = pos + 1;
    rem = rem - 1;
    var count = fc & 0x3F;
    if (count < 1) { return err(ERR_DECODE); }
    if (count > maxf) { return err(ERR_DECODE); }
    if (fsz * count > 5760) { return err(ERR_DECODE); }   # RFC caps a packet at 120 ms

    if ((fc & 0x40) != 0) {
        # Padding: each 255 byte means 254 bytes of padding and another length
        # byte follows; any other value ends the run. The length bytes count
        # against the remainder too.
        var more = 1;
        while (more == 1) {
            if (rem < 1) { return err(ERR_DECODE); }
            var pb = load8(data + pos);
            pos = pos + 1;
            rem = rem - 1;
            var padd = pb;
            more = 0;
            if (pb == 255) { padd = 254; more = 1; }
            if (padd > rem) { return err(ERR_DECODE); }
            rem = rem - padd;
        }
    }

    if ((fc & 0x80) != 0) {
        # VBR: count-1 explicit lengths, the last frame taking what is left.
        var i = 0;
        var used_total = 0;
        var tmp = alloc(8);
        while (i < count - 1) {
            var u = _opus_parse_size(data, pos, plen, tmp);
            if (u < 0) { return err(ERR_DECODE); }
            pos = pos + u;
            rem = rem - u;
            if (rem < 0) { return err(ERR_DECODE); }
            var li = load64(tmp);
            if (li > rem) { return err(ERR_DECODE); }
            store64(lens + i * 8, li);
            used_total = used_total + li;
            i = i + 1;
        }
        if (used_total > rem) { return err(ERR_DECODE); }
        store64(lens + (count - 1) * 8, rem - used_total);
    } else {
        # CBR: the remainder must divide exactly.
        var each = rem / count;
        if (each * count != rem) { return err(ERR_DECODE); }
        var j = 0;
        while (j < count) { store64(lens + j * 8, each); j = j + 1; }
    }

    var k2 = 0;
    var at = pos;
    while (k2 < count) {
        store64(offs + k2 * 8, at);
        var ln = load64(lens + k2 * 8);
        if (ln < 0) { return err(ERR_DECODE); }
        if (at + ln > plen) { return err(ERR_DECODE); }
        at = at + ln;
        k2 = k2 + 1;
    }
    return count;
}

fn opus_decode_from_packets(packets_vec, ogg_data, ogg_len) {
    if (vec_len(packets_vec) == 0) { return err(ERR_END_OF_STREAM); }

    var pkt0 = vec_get(packets_vec, 0);
    var pkt0_data = str_data(pkt0);
    var pkt0_len = str_len(pkt0);
    var head = opus_parse_head(pkt0_data, pkt0_len);
    if (is_err(head) == 1) { return head; }

    if (vec_len(packets_vec) >= 2) {
        var pkt1 = vec_get(packets_vec, 1);
        opus_parse_tags(str_data(pkt1), str_len(pkt1));
    }

    var duration_secs = F64_ZERO;
    var total_samples = 0;
    var F64_48000 = f64_from(48000);
    var granule = _opus_find_last_granule(ogg_data, ogg_len);
    if (granule > 0) {
        var pre_skip = opus_head_pre_skip(head);
        var effective = granule - pre_skip;
        if (effective > 0) {
            duration_secs = f64_div(f64_from(effective), F64_48000);
            total_samples = effective;
        }
    }

    var channels = opus_head_channels(head);
    var pre_skip = opus_head_pre_skip(head);
    if (_celt_band_edges == 0) { _opus_init_bands(); }

    var samples = vec_new();
    var npkts = vec_len(packets_vec);
    var num_frames = npkts - 2;
    if (num_frames < 0) { num_frames = 0; }

    # Decode audio with the real RFC-6716 CELT decoder (config 31, CELT-only fullband
    # 20ms). SILK-only 20ms mono packets (config 1 NB / 9 WB) are decoded to 48kHz via
    # the real RFC-6716 SILK decoder. Other configs (MB SILK, hybrid, multi-frame) emit
    # silence for their frame so the timeline stays aligned. Pre-skip trimmed, capped to granule.
    if (num_frames > 0) {
        var st = celt_dec_state_new();
        # One Opus FRAME is at most 60 ms = 2880 samples (was sized for 960, which
        # a 40/60 ms SILK frame would have overrun).
        var pcm = alloc(2 * 2880 * 8);
        # A packet holds up to 48 frames (RFC 6716 3.2.5).
        var offs = alloc(48 * 8);
        var lens = alloc(48 * 8);
        # Measure the stream before allocating: packet count times 960 was only
        # right when every packet held exactly one 20 ms frame. A code-3 packet of
        # 2.5 ms frames carries 48 of them, and a 60 ms frame is three times 960 --
        # either way the old size was a heap overrun waiting for the right file.
        var maxsamp = 0;
        var pf = 0;
        while (pf < num_frames) {
            var ppkt = vec_get(packets_vec, pf + 2);
            var ppd = str_data(ppkt);
            var ppl = str_len(ppkt);
            if (ppl >= 1) {
                var pcfg = (load8(ppd) >> 3) & 0x1F;
                var pn = _opus_split_frames(ppd, ppl, offs, lens, 48);
                if (res_ok(pn) == 1) {
                    maxsamp = maxsamp + pn * _opus_frame_samples(pcfg);
                } else {
                    maxsamp = maxsamp + _opus_frame_samples(pcfg);   # unparseable: one frame of silence
                }
            }
            pf = pf + 1;
        }
        if (maxsamp < 1) { maxsamp = 1; }
        var allpcm = alloc(maxsamp * channels * 8);
        # Persistent SILK decode state (created lazily on first SILK packet; the SILK
        # decoder, resampler and 1-sample mid history all carry across packets).
        var silk_st = 0;
        var silk_rst = 0;
        var silk_mid = 0;
        var silk_fs = 0;
        var silk_nsub = 0;   # nb_subfr the mono SILK state was inited with (2=10ms, 4=20ms)
        var silk_out = alloc(2880 * 8);
        # Persistent SILK stereo state (created lazily on the first stereo SILK packet).
        var sk_st0 = 0;
        var sk_st1 = 0;
        var sk_rstL = 0;
        var sk_rstR = 0;
        var sk_stereo = 0;
        var sk_sfs = 0;
        var sk_nsub = 0;
        var sk_outL = alloc(2880 * 8);
        var sk_outR = alloc(2880 * 8);
        var F64_32768 = f64_from(32768);
        var wpos = 0;
        var f = 0;
        while (f < num_frames) {
            var pkt = vec_get(packets_vec, f + 2);
            var pkt_data = str_data(pkt);
            var pkt_len = str_len(pkt);
            var config = 0;
            var stbit = 0;
            if (pkt_len >= 1) {
                var toc = load8(pkt_data);
                config = (toc >> 3) & 0x1F;
                stbit = (toc >> 2) & 1;
            }
            # Duration comes from the config alone, for every one of the 32.
            var fsamp = _opus_frame_samples(config);
            var Cf = 1;
            if (stbit != 0) { Cf = 2; }
            # Split the packet into frames. Every frame in a packet shares the TOC,
            # so config/stbit/fsamp are computed once, above.
            var nfr = _opus_split_frames(pkt_data, pkt_len, offs, lens, 48);
            if (res_ok(nfr) == 0) { nfr = 1; store64(offs, 1); store64(lens, 0); }
            var fr = 0;
            while (fr < nfr) {
            var pdata = pkt_data + load64(offs + fr * 8);
            var plen = load64(lens + fr * 8);
            var handled = 0;
            # CELT-only 10/20ms: configs 18/22/26/30 (LM=2, 10ms) + 19/23/27/31 (LM=3, 20ms).
            # LM = config&3 (2 or 3); bandwidth = (config>>2)&3 → end band NB13/WB17/SWB19/FB21.
            if ((config >= 16) & (config <= 31)) {
                if (plen >= 1) {
                    var clm = config & 3;
                    var cbw = (config >> 2) & 3;
                    var ceb = 21;
                    if (cbw == 0) { ceb = 13; }
                    if (cbw == 1) { ceb = 17; }
                    if (cbw == 2) { ceb = 19; }
                    celt_decode_frame_ec(st, ec_dec_new(pdata, plen), plen, Cf, 0, ceb, 0, clm, pcm);
                    handled = 1;
                }
            }
            # SILK-only mono: NB (8kHz internal) config 0 (10ms)/1 (20ms), WB (16kHz)
            # config 8 (10ms)/9 (20ms). code 0 (one frame/packet), mono. → 48kHz.
            # nb_subfr = 2 (10ms) or 4 (20ms); resampler emits fsamp (480/960) samples.
            if ((handled == 0) & (stbit == 0) & (plen >= 1)) {
                if (config < 12) {
                    # SILK internal rate from the config's bandwidth: NB 8, MB 12, WB 16.
                    var sfs = 8;
                    if ((config >= 4) & (config <= 7)) { sfs = 12; }
                    if (config >= 8) { sfs = 16; }
                    # 40 and 60 ms Opus frames are 2 and 3 sequential 20 ms SILK
                    # frames sharing one range coder; each is nb_subfr = 4.
                    var nsub = 4;
                    if ((config & 3) == 0) { nsub = 2; }
                    var nsf = 1;
                    if ((config & 3) == 2) { nsf = 2; }
                    if ((config & 3) == 3) { nsf = 3; }
                    if ((silk_fs != sfs) | (silk_nsub != nsub)) {
                        silk_st = silk_decoder_init(sfs, nsub);
                        silk_rst = silk_resampler_init(sfs);
                        silk_mid = alloc(2 * 8);
                        store64(silk_mid + 0, 0); store64(silk_mid + 8, 0);
                        silk_fs = sfs;
                        silk_nsub = nsub;
                    }
                    var mec = ec_dec_new(pdata, plen);
                    silk_decode_pcm_multi(silk_st, silk_rst, silk_mid, mec, nsf, silk_out);
                    var q = 0;
                    while (q < fsamp) {
                        store64(pcm + q * 8, f64_div(f64_from(load64(silk_out + q * 8)), F64_32768));
                        q = q + 1;
                    }
                    # Bandwidth -> CELT end band for the redundant frame: NB 13,
                    # MB/WB 17 (RFC 6716 4.5.1.4 puts MB on the WB band layout).
                    var reb = 13;
                    if (config >= 4) { reb = 17; }
                    _opus_decode_redundancy(st, mec, pdata, plen, 0, reb, 1, pcm, fsamp);
                    handled = 1;
                }
            }
            # SILK stereo: config 0/1 (NB) or 8/9 (WB), stereo bit set. 10ms = config 0/8
            # (nb_subfr=2), 20ms = config 1/9 (nb_subfr=4). Mid/side decoded from the shared
            # range coder, silk_stereo_MS_to_LR reconstruction, resample per channel → fsamp.
            if ((handled == 0) & (stbit == 1) & (plen >= 1) & (channels == 2)) {
                if (config < 12) {
                    var ssfs = 8;
                    if ((config >= 4) & (config <= 7)) { ssfs = 12; }
                    if (config >= 8) { ssfs = 16; }
                    var snsub = 4;
                    if ((config & 3) == 0) { snsub = 2; }
                    var snsf = 1;
                    if ((config & 3) == 2) { snsf = 2; }
                    if ((config & 3) == 3) { snsf = 3; }
                    if ((sk_sfs != ssfs) | (sk_nsub != snsub)) {
                        sk_st0 = silk_decoder_init(ssfs, snsub);
                        sk_st1 = silk_decoder_init(ssfs, snsub);
                        sk_rstL = silk_resampler_init(ssfs);
                        sk_rstR = silk_resampler_init(ssfs);
                        sk_stereo = alloc(6 * 8);
                        var sz = 0; while (sz < 6) { store64(sk_stereo + sz * 8, 0); sz = sz + 1; }
                        sk_sfs = ssfs;
                        sk_nsub = snsub;
                    }
                    var sec = ec_dec_new(pdata, plen);
                    silk_decode_stereo_multi(sk_st0, sk_st1, sk_rstL, sk_rstR, sk_stereo, sec, ssfs, snsf, sk_outL, sk_outR);
                    var sq = 0;
                    while (sq < fsamp) {
                        store64(pcm + (sq * 2 + 0) * 8, f64_div(f64_from(load64(sk_outL + sq * 8)), F64_32768));
                        store64(pcm + (sq * 2 + 1) * 8, f64_div(f64_from(load64(sk_outR + sq * 8)), F64_32768));
                        sq = sq + 1;
                    }
                    var sreb = 13;
                    if (config >= 4) { sreb = 17; }
                    _opus_decode_redundancy(st, sec, pdata, plen, 0, sreb, 2, pcm, fsamp);
                    handled = 1;
                }
            }
            # Hybrid 20ms mono: config 13 (SWB, CELT end=19) or 15 (FB, end=21). SILK
            # decodes the low band (WB 16kHz) from the front of the shared range coder;
            # CELT decodes the high band (start=17) from the same ec and accumulates.
            # Hybrid mono: SWB config 12 (10ms)/13 (20ms, CELT end=19), FB config 14 (10ms)/
            # 15 (20ms, end=21). SILK is always WB 16kHz; nb_subfr=2 (10ms)/4 (20ms), CELT
            # LM=2 (10ms)/3 (20ms). SILK low band + CELT high band (start=17, accumulate).
            if ((handled == 0) & (stbit == 0) & (plen >= 1)) {
                if ((config == 12) | (config == 13) | (config == 14) | (config == 15)) {
                    var hnsub = 4;
                    var hlm = 3;
                    if ((config == 12) | (config == 14)) { hnsub = 2; hlm = 2; }
                    if ((silk_fs != 16) | (silk_nsub != hnsub)) {
                        silk_st = silk_decoder_init(16, hnsub);
                        silk_rst = silk_resampler_init(16);
                        silk_mid = alloc(2 * 8);
                        store64(silk_mid + 0, 0); store64(silk_mid + 8, 0);
                        silk_fs = 16;
                        silk_nsub = hnsub;
                    }
                    var hb_end = 21;
                    if ((config == 12) | (config == 13)) { hb_end = 19; }
                    var hec = ec_dec_new(pdata, plen);
                    # SILK low band -> silk_out (int16 48k), normalized into pcm.
                    silk_decode_pcm_ec(silk_st, silk_rst, silk_mid, hec, silk_out);
                    var hq = 0;
                    while (hq < fsamp) {
                        store64(pcm + hq * 8, f64_div(f64_from(load64(silk_out + hq * 8)), F64_32768));
                        hq = hq + 1;
                    }
                    # Redundancy: hybrid signals it explicitly, with an explicit size.
                    var hlen = plen;
                    var hcts = 0;
                    var hrb = 0;
                    var hred = 0;
                    if (ec_tell(hec) + 17 + 20 <= 8 * hlen) {
                        if (ec_dec_bit_logp(hec, 12) != 0) {
                            hcts = ec_dec_bit_logp(hec, 1);
                            hrb = ec_dec_uint(hec, 256) + 2;
                            hlen = hlen - hrb;
                            if (hlen * 8 < ec_tell(hec)) { hlen = plen; hrb = 0; }
                            else { hred = 1; store64(hec + 8, load64(hec + 8) - hrb); }
                        }
                    }
                    var hredbuf = 0;
                    # A CELT->SILK redundant frame is decoded BEFORE the main CELT
                    # frame; a SILK->CELT one after, with a state reset in between
                    # (opus_decoder.c:578 vs 637). Getting the order wrong silently
                    # corrupts the CELT state the following frames depend on.
                    if ((hred == 1) & (hcts != 0)) {
                        hredbuf = _opus_redundancy_decode(st, pdata, hlen, hrb, hcts, hb_end, 1);
                    }
                    # CELT high band from the same ec, accumulated onto the SILK low band.
                    celt_decode_frame_ec(st, hec, hlen, 1, 17, hb_end, 1, hlm, pcm);
                    if ((hred == 1) & (hcts == 0)) {
                        hredbuf = _opus_redundancy_decode(st, pdata, hlen, hrb, hcts, hb_end, 1);
                    }
                    if (hred == 1) { _opus_redundancy_mix(hredbuf, hcts, 1, pcm, fsamp); }
                    handled = 1;
                }
            }
            # Hybrid STEREO: SWB config 12 (10ms)/13 (20ms), FB config 14 (10ms)/15 (20ms),
            # stereo bit set. SILK stereo (mid/side → L/R, WB) low band from the front of the
            # shared ec; CELT stereo (C=2, start=17) high band, accumulated onto interleaved L/R.
            # nb_subfr=2/CELT LM=2 (10ms) or nb_subfr=4/LM=3 (20ms).
            if ((handled == 0) & (stbit == 1) & (plen >= 1) & (channels == 2)) {
                if ((config == 12) | (config == 13) | (config == 14) | (config == 15)) {
                    var hsnsub = 4;
                    var hslm = 3;
                    if ((config == 12) | (config == 14)) { hsnsub = 2; hslm = 2; }
                    if ((sk_sfs != 16) | (sk_nsub != hsnsub)) {
                        sk_st0 = silk_decoder_init(16, hsnsub);
                        sk_st1 = silk_decoder_init(16, hsnsub);
                        sk_rstL = silk_resampler_init(16);
                        sk_rstR = silk_resampler_init(16);
                        sk_stereo = alloc(6 * 8);
                        var hsz = 0; while (hsz < 6) { store64(sk_stereo + hsz * 8, 0); hsz = hsz + 1; }
                        sk_sfs = 16;
                        sk_nsub = hsnsub;
                    }
                    var hsbe = 21;
                    if ((config == 12) | (config == 13)) { hsbe = 19; }
                    var hsec = ec_dec_new(pdata, plen);
                    silk_decode_stereo(sk_st0, sk_st1, sk_rstL, sk_rstR, sk_stereo, hsec, 16, sk_outL, sk_outR);
                    var hsq = 0;
                    while (hsq < fsamp) {
                        store64(pcm + (hsq * 2 + 0) * 8, f64_div(f64_from(load64(sk_outL + hsq * 8)), F64_32768));
                        store64(pcm + (hsq * 2 + 1) * 8, f64_div(f64_from(load64(sk_outR + hsq * 8)), F64_32768));
                        hsq = hsq + 1;
                    }
                    var hslen = plen;
                    var hscts = 0;
                    var hsrb = 0;
                    var hsred = 0;
                    if (ec_tell(hsec) + 17 + 20 <= 8 * hslen) {
                        if (ec_dec_bit_logp(hsec, 12) != 0) {
                            hscts = ec_dec_bit_logp(hsec, 1);
                            hsrb = ec_dec_uint(hsec, 256) + 2;
                            hslen = hslen - hsrb;
                            if (hslen * 8 < ec_tell(hsec)) { hslen = plen; hsrb = 0; }
                            else { hsred = 1; store64(hsec + 8, load64(hsec + 8) - hsrb); }
                        }
                    }
                    var hsredbuf = 0;
                    if ((hsred == 1) & (hscts != 0)) {
                        hsredbuf = _opus_redundancy_decode(st, pdata, hslen, hsrb, hscts, hsbe, 2);
                    }
                    # CELT stereo high band from the same ec, accumulated onto L/R.
                    celt_decode_frame_ec(st, hsec, hslen, 2, 17, hsbe, 1, hslm, pcm);
                    if ((hsred == 1) & (hscts == 0)) {
                        hsredbuf = _opus_redundancy_decode(st, pdata, hslen, hsrb, hscts, hsbe, 2);
                    }
                    if (hsred == 1) { _opus_redundancy_mix(hsredbuf, hscts, 2, pcm, fsamp); }
                    handled = 1;
                }
            }
            if (handled == 0) {
                var zz = 0;
                while (zz < 2 * fsamp) { store64(pcm + zz * 8, F64_ZERO); zz = zz + 1; }
            }
            var i = 0;
            while (i < fsamp) {
                if (wpos < maxsamp) {
                    var cc = 0;
                    while (cc < channels) {
                        var v = F64_ZERO;
                        if (cc < Cf) { v = load64(pcm + (i * Cf + cc) * 8); }
                        store64(allpcm + (wpos * channels + cc) * 8, v);
                        cc = cc + 1;
                    }
                    wpos = wpos + 1;
                }
                i = i + 1;
            }
            fr = fr + 1;
            }
            f = f + 1;
        }
        # Trim pre-skip and cap to the granule.
        var out_frames = wpos - pre_skip;
        if (granule > 0) {
            var eff = granule - pre_skip;
            if (eff < out_frames) { out_frames = eff; }
        }
        if (out_frames < 0) { out_frames = 0; }
        var si = 0;
        while (si < out_frames) {
            var cc2 = 0;
            while (cc2 < channels) {
                vec_push(samples, load64(allpcm + ((pre_skip + si) * channels + cc2) * 8));
                cc2 = cc2 + 1;
            }
            si = si + 1;
        }
        total_samples = out_frames;
        duration_secs = f64_div(f64_from(total_samples), F64_48000);
    }

    var fi = fmtinfo_new(FMT_OPUS, 48000, channels, 16, duration_secs, total_samples);
    return decode_result_new(fi, samples);
}

# --- silk.cyr ---

# ================================================================
# silk.cyr -- RFC 6716 SILK decoder (v2.6.1, in progress)
# ================================================================
# The low-bitrate/voice half of Opus. Fixed-point in libopus, so this is an exact
# integer port (int16/int32 widths, arithmetic shifts, saturation emulated in i64).
# Shares the verified ec_dec range coder + `sar`/`_i16` helpers from src/opus.cyr.
#
# Target configs: 1 (SILK NB, 8kHz internal, 20ms) and 9 (SILK WB, 16kHz, 20ms),
# mono, one SILK frame/packet, 4 subframes. Built stage-by-stage, each bit-exact
# vs libopus (silkref/opusdec reference). This file currently covers the LP-layer
# header + silk_decode_indices Steps A-C (signal type, gains, gains dequant, NLSF
# stage-1 index). NLSF stage-2/LPC, pitch/LTP, excitation, synthesis, resample
# are the following bites.

