# silk_DIV32_varQ: (a << Qres) / b, computed by normalise + reciprocal + one
# Newton refinement, exactly as libopus does it.
fn silk_div32_varq(a32, b32, Qres) {
    var aa = a32; if (aa < 0) { aa = 0 - aa; }
    var bb = b32; if (bb < 0) { bb = 0 - bb; }
    var a_headrm = silk_clz32(aa) - 1;
    var a32_nrm = silk_sx32(a32 << a_headrm);
    var b_headrm = silk_clz32(bb) - 1;
    var b32_nrm = silk_sx32(b32 << b_headrm);
    var b32_inv = silk_div_trunc(sar(2147483647, 2), sar(b32_nrm, 16));
    var result = silk_smulwb(a32_nrm, b32_inv);
    a32_nrm = silk_sx32(a32_nrm - silk_sx32(silk_smmul(b32_nrm, result) << 3));
    result = silk_smlawb(result, a32_nrm, b32_inv);
    var lshift = 29 + a_headrm - b_headrm - Qres;
    if (lshift < 0) { return silk_lshift_sat32(result, 0 - lshift); }
    if (lshift < 32) { return sar(result, lshift); }
    return 0;
}

# silk_insertion_sort_increasing: sorts `a` ascending and records where each
# sorted element came from, but only guarantees the first K positions.
fn silk_insertion_sort_increasing(a, idx, L, K) {
    var i = 0;
    while (i < K) { store64(idx + i * 8, i); i = i + 1; }
    i = 1;
    while (i < K) {
        var value = load64(a + i * 8);
        var j = i - 1;
        var placed = 0;
        while ((placed == 0) & (j >= 0)) {
            if (value < load64(a + j * 8)) {
                store64(a + (j + 1) * 8, load64(a + j * 8));
                store64(idx + (j + 1) * 8, load64(idx + j * 8));
                j = j - 1;
            } else { placed = 1; }
        }
        store64(a + (j + 1) * 8, value);
        store64(idx + (j + 1) * 8, i);
        i = i + 1;
    }
    # Beyond K, only the first K positions have to stay correct.
    i = K;
    while (i < L) {
        var v2 = load64(a + i * 8);
        if (v2 < load64(a + (K - 1) * 8)) {
            var j2 = K - 2;
            var placed2 = 0;
            while ((placed2 == 0) & (j2 >= 0)) {
                if (v2 < load64(a + j2 * 8)) {
                    store64(a + (j2 + 1) * 8, load64(a + j2 * 8));
                    store64(idx + (j2 + 1) * 8, load64(idx + j2 * 8));
                    j2 = j2 - 1;
                } else { placed2 = 1; }
            }
            store64(a + (j2 + 1) * 8, v2);
            store64(idx + (j2 + 1) * 8, i);
        }
        i = i + 1;
    }
    return 0;
}

# silk_NLSF_encode: stabilise, score every stage-1 codebook vector, keep the
# nSurvivors best, run the trellis on each, and take the lowest R/D path. Writes
# NLSFIndices[0..order] and replaces pNLSF_Q15 with the QUANTISED vector (the
# same one the decoder will reconstruct). Returns the R/D value in Q25.
fn silk_nlsf_encode(NLSFIndices, pNLSF_Q15, fs_kHz, pW_Q2, NLSF_mu_Q20, nSurvivors, signalType) {
    if (_silk_type_VAD == 0) { _silk_tables_init(); }       # _silk_cb1_nb/_wb (stage-1 iCDF)
    if (_silk_cb1nlsf_nb == 0) { _silk_tables3_init(); }
    if (_silk_ec_sel_nb == 0) { _silk_tables2_init(); }     # silk_nlsf_unpack needs these
    if (_silk_ec_rates_nb == 0) { _silk_nlsf_enc_tables_init(); }
    var order = 16;
    var cb1tab = _silk_cb1nlsf_wb;
    var wghttab = _silk_cb1wght_wb;
    var dmin = _silk_dmin_wb;
    var icdf = _silk_cb1_wb;
    var rates = _silk_ec_rates_wb;
    var qstep = 9830;
    var invqstep = 427;
    if (fs_kHz < 16) {
        order = 10; cb1tab = _silk_cb1nlsf_nb; wghttab = _silk_cb1wght_nb;
        dmin = _silk_dmin_nb; icdf = _silk_cb1_nb; rates = _silk_ec_rates_nb;
        qstep = 11796; invqstep = 356;
    }
    var nVectors = 32;

    silk_nlsf_stabilize(pNLSF_Q15, dmin, order);

    var err_Q24 = alloc(nVectors * 8);
    silk_nlsf_vq(err_Q24, pNLSF_Q15, cb1tab, wghttab, nVectors, order);
    var tempIndices1 = alloc(nVectors * 8);
    silk_insertion_sort_increasing(err_Q24, tempIndices1, nVectors, nSurvivors);

    var RD_Q25 = alloc(nSurvivors * 8);
    var tempIndices2 = alloc(nSurvivors * 16 * 8);
    var res_Q10 = alloc(16 * 8);
    var W_adj_Q5 = alloc(16 * 8);
    var ec_ix = alloc(16 * 8);
    var pred_Q8 = alloc(16);

    var sidx = 0;
    while (sidx < nSurvivors) {
        var ind1 = load64(tempIndices1 + sidx * 8);
        var i = 0;
        while (i < order) {
            var cbv = load8(cb1tab + ind1 * order + i) << 7;
            var W_tmp_Q9 = load64(wghttab + (ind1 * order + i) * 8);
            store64(res_Q10 + i * 8, _i16(sar(silk_smulbb(load64(pNLSF_Q15 + i * 8) - cbv, W_tmp_Q9), 14)));
            # W_adj_Q5[] is an opus_int16 array in libopus (NLSF_encode.c), so the
            # division result is truncated to 16 bits before it reaches the trellis.
            store64(W_adj_Q5 + i * 8, _i16(silk_div32_varq(load64(pW_Q2 + i * 8), silk_smulbb(W_tmp_Q9, W_tmp_Q9), 21)));
            i = i + 1;
        }
        silk_nlsf_unpack(ind1, fs_kHz, ec_ix, pred_Q8);
        var rd = silk_nlsf_del_dec_quant(tempIndices2 + sidx * 16 * 8, res_Q10, W_adj_Q5,
                                         pred_Q8, ec_ix, rates, qstep, invqstep, NLSF_mu_Q20, order);
        # add the stage-1 index's own rate
        var base = (signalType >> 1) * nVectors;
        var prob_Q8 = 0;
        if (ind1 == 0) { prob_Q8 = 256 - load8(icdf + base + ind1); }
        else { prob_Q8 = load8(icdf + base + ind1 - 1) - load8(icdf + base + ind1); }
        var bits_q7 = (8 << 7) - silk_lin2log(prob_Q8);
        store64(RD_Q25 + sidx * 8, silk_sx32(rd + silk_smulbb(bits_q7, sar(NLSF_mu_Q20, 2))));
        sidx = sidx + 1;
    }

    var bestIndex = alloc(8);
    silk_insertion_sort_increasing(RD_Q25, bestIndex, nSurvivors, 1);
    var bi = load64(bestIndex);
    store64(NLSFIndices + 0, load64(tempIndices1 + bi * 8));
    var j = 0;
    while (j < order) {
        store64(NLSFIndices + (j + 1) * 8, load64(tempIndices2 + (bi * 16 + j) * 8));
        j = j + 1;
    }
    silk_nlsf_decode(NLSFIndices, fs_kHz, pNLSF_Q15);
    return load64(RD_Q25 + 0);
}

