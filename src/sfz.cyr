# sfz.cyr -- SFZ text parser (v1 + v2 subset)
# Requires: alloc, vec, str (str_*), string, math (f64_*, f64_parse), byte ops (load8),
#           hashmap (map_new_str / map_get_or / map_set), sample, zone (n_zone_*),
#           instrument (n_instrument_*), envelope (n_adsr_config_from_seconds), loop_mode (LOOP_*)
#
# Ports rust-old/src/sfz.rs. Line-based, whitespace-tokenized, key=value opcodes. Unknown opcodes
# and malformed tokens are silently ignored. Strings are stdlib Str objects. Option<String> ->
# null pointer (0 = None); Option<u8> -> -1 sentinel. parse is infallible (always returns a file).
#
# Every string the parsed file KEEPS (sample, loop_mode, fil_type, cc param, default_path,
# includes) is an owned, NUL-terminated copy. They used to be views into the caller's input
# buffer: a host that reused its read buffer for the next file (the pattern the stdlib's
# file_read_whole_into recommends) found `sample=a.wav` reading back as the next file's bytes,
# and a filename handed to n_load_wav (a cstr API) ran on to the end of the SFZ text. The oracle
# copied every one of them into a String.

var SFZ_HDR_NONE    = 0 - 1;
var SFZ_HDR_CONTROL = 0;
var SFZ_HDR_GLOBAL  = 1;
var SFZ_HDR_GROUP   = 2;
var SFZ_HDR_REGION  = 3;
var SFZ_HDR_CURVE   = 4;

# Longest `default_path` honoured: Linux PATH_MAX. The prefix is joined onto the filename of
# every region, so its length multiplies into the heap: a 1.19 MB file carrying a 1 MB
# default_path and 8,000 one-letter regions asked for ~8 GB and segfaulted once alloc returned 0
# (5,000 regions: 4,055,809,968 bytes, 3,560 heap bytes per input byte). The oracle did the same
# join. A longer prefix cannot name an openable file anyway -- open(2) answers ENAMETOOLONG -- so
# an over-long `default_path=` is ignored like any other unusable value.
var N_SFZ_PATH_MAX = 4096;

# --- small helpers ---

# Byte length of the Unicode White_Space code point at p (n bytes readable), or 0.
#
# The oracle split with `str::split_whitespace` and trimmed with `str::trim`, and both use
# char::is_whitespace -- all 25 White_Space code points, not just space/tab/CR/LF. A form feed
# or an NBSP glued `<region>` to the next opcode here, and the region vanished. U+0009..U+000D, U+0020, U+0085, U+00A0, U+1680, U+2000..U+200A, U+2028, U+2029,
# U+202F, U+205F, U+3000. Every multi-byte form starts with a UTF-8 lead byte, which never occurs
# as a continuation byte, so a byte-wise scan of valid UTF-8 can only match on a char boundary.
# The oracle took &str, so it never saw invalid UTF-8; here such bytes are simply not whitespace.
fn n_sfz_ws_at(p, n) {
    if (n <= 0) { return 0; }
    var c = load8(p);
    if (c == 32) { return 1; }
    if (c >= 9) { if (c <= 13) { return 1; } }
    if (c == 194) {
        if (n < 2) { return 0; }
        var d = load8(p + 1);
        if (d == 133) { return 2; }
        if (d == 160) { return 2; }
        return 0;
    }
    if (c < 225) { return 0; }
    if (c > 227) { return 0; }
    if (n < 3) { return 0; }
    var b1 = load8(p + 1);
    var b2 = load8(p + 2);
    if (c == 225) {
        if (b1 == 154) { if (b2 == 128) { return 3; } }
        return 0;
    }
    if (c == 227) {
        if (b1 == 128) { if (b2 == 128) { return 3; } }
        return 0;
    }
    if (b1 == 128) {
        if (b2 >= 128) { if (b2 <= 138) { return 3; } }
        if (b2 == 168) { return 3; }
        if (b2 == 169) { return 3; }
        if (b2 == 175) { return 3; }
        return 0;
    }
    if (b1 == 129) { if (b2 == 159) { return 3; } }
    return 0;
}

# Byte length of a White_Space code point ENDING at p + n, or 0 (the right-hand half of trim).
fn n_sfz_ws_before(p, n) {
    if (n <= 0) { return 0; }
    if (n_sfz_ws_at(p + n - 1, 1) == 1) { return 1; }
    if (n >= 2) { if (n_sfz_ws_at(p + n - 2, 2) == 2) { return 2; } }
    if (n >= 3) { if (n_sfz_ws_at(p + n - 3, 3) == 3) { return 3; } }
    return 0;
}

# 1 if the n bytes at p spell exactly the NUL-terminated cstr.
fn n_sfz_span_eq(p, n, cstr) {
    if (n != strlen(cstr)) { return 0; }
    return memeq(p, cstr, n);
}

# 1 if the n bytes at p spell the lowercase cstr, ignoring ASCII case.
fn n_sfz_span_eq_nocase(p, n, cstr) {
    if (n != strlen(cstr)) { return 0; }
    var i = 0;
    while (i < n) {
        var c = load8(p + i);
        if (c >= 65) { if (c <= 90) { c = c + 32; } }
        if (c != load8(cstr + i)) { return 0; }
        i = i + 1;
    }
    return 1;
}

# An owned, NUL-terminated copy of n bytes at p, as a Str (0 on OOM).
fn n_sfz_own(p, n) {
    var buf = alloc(n + 1);
    if (buf == 0) { return 0; }
    memcpy(buf, p, n);
    store8(buf + n, 0);
    return str_new(buf, n);
}

# prefix + name as one owned, NUL-terminated Str (0 on OOM). str_cat does not terminate.
fn n_sfz_join(prefix, name) {
    var la = str_len(prefix);
    var lb = str_len(name);
    var buf = alloc(la + lb + 1);
    if (buf == 0) { return 0; }
    memcpy(buf, str_data(prefix), la);
    memcpy(buf + la, str_data(name), lb);
    store8(buf + la + lb, 0);
    return str_new(buf, la + lb);
}

# parse a signed decimal integer from a Str (Rust i32/i64 FromStr: optional leading +/-).
# Returns 1 + writes to out, or 0 (unparseable).
fn sfz_int(s, out) {
    var data = str_data(s);
    var len = str_len(s);
    if (len == 0) { return 0; }
    var i = 0;
    var neg = 0;
    var c0 = load8(data);
    if (c0 == 45) { neg = 1; i = 1; }
    if (c0 == 43) { i = 1; }
    var val = 0;
    var any = 0;
    while (i < len) {
        var c = load8(data + i);
        if (c < 48) { return 0; }
        if (c > 57) { return 0; }
        # Reject rather than wrap. Rust's parse::<i32>/<i64> returns Err on overflow; the
        # port accumulated into an i64 and silently wrapped, so `group=9223372036854775808`
        # became i64::MIN and reached vec_get as a negative index -> exit(1), and
        # `lovel=9223372036854775808` produced negative bounds that matched no note at all.
        if (val > 922337203685477580) { return 0; }
        val = val * 10 + (c - 48);
        if (val < 0) { return 0; }
        any = 1;
        i = i + 1;
    }
    if (any == 0) { return 0; }
    if (neg == 1) { val = 0 - val; }
    store64(out, val);
    return 1;
}

# parse an unsigned decimal integer with Rust's parse::<usize>() semantics on a 64-bit target:
# optional leading +, rejects -, accepts 0..=u64::MAX and rejects anything larger.
#
# Saturate, do not wrap. usize genuinely ACCEPTS values above i64::MAX (up to u64::MAX), so
# rejecting those would break parity in one direction; they clamp to i64::MAX, which every
# downstream range check then treats on its own terms. Values ABOVE u64::MAX are an Err in Rust
# and leave the field unchanged -- the port used to saturate those too, so
# `offset=99999999999999999999999` set an offset the oracle never set. The cut is decided on the
# digit string (more than 20 significant digits, or 20 that compare above "18446744073709551615"),
# because u64::MAX itself does not fit the i64 accumulator.
fn sfz_uint(s, out) {
    var data = str_data(s);
    var len = str_len(s);
    if (len == 0) { return 0; }
    var i = 0;
    if (load8(data) == 43) { i = 1; }
    var val = 0;
    var any = 0;
    var over = 0;
    var sig = 0;
    var sig_at = 0 - 1;
    while (i < len) {
        var c = load8(data + i);
        if (c < 48) { return 0; }
        if (c > 57) { return 0; }
        if (sig == 0) { if (c != 48) { sig_at = i; } }
        if (sig_at >= 0) { sig = sig + 1; }
        if (val > 922337203685477580) { over = 1; }
        if (over == 0) {
            val = val * 10 + (c - 48);
            if (val < 0) { over = 1; }
        }
        any = 1;
        i = i + 1;
    }
    if (any == 0) { return 0; }
    if (sig > 20) { return 0; }
    if (sig == 20) {
        var umax = "18446744073709551615";
        var k = 0;
        while (k < 20) {
            var dc = load8(data + sig_at + k);
            var mc = load8(umax + k);
            if (dc > mc) { return 0; }
            if (dc < mc) { k = 20; }
            k = k + 1;
        }
    }
    if (over == 1) { val = 9223372036854775807; }
    store64(out, val);
    return 1;
}

# parse a u8 (Rust parse::<u8>: unsigned, 0..=255). Returns 0 (unparseable) if out of range.
fn sfz_u8(s, out) {
    if (sfz_uint(s, out) == 0) { return 0; }
    # The `< 0` half was missing: sfz_uint used to wrap, so a huge token arrived negative
    # and sailed past a `> 255` test unchallenged.
    if (load64(out) < 0) { return 0; }
    if (load64(out) > 255) { return 0; }
    return 1;
}

# parse a u32 (Rust parse::<u32>: 0..=4294967295).
fn sfz_u32(s, out) {
    if (sfz_uint(s, out) == 0) { return 0; }
    if (load64(out) < 0) { return 0; }
    if (load64(out) > 4294967295) { return 0; }
    return 1;
}

# parse an i32 (Rust parse::<i32>: -2147483648..=2147483647).
fn sfz_i32(s, out) {
    if (sfz_int(s, out) == 0) { return 0; }
    if (load64(out) < (0 - 2147483648)) { return 0; }
    if (load64(out) > 2147483647) { return 0; }
    return 1;
}

# n_sfz_parse_span(p, n, out) -> 1 and the f64 bits of the validated token p[0..n) in out, or 0.
#
# The stdlib's span form, f64_parse_n, only arrived in cyrius 6.7.9, and nidhi's consumers may be
# on 6.7.5. f64_parse reads a NUL-terminated string with the same grammar and rounding (on 6.7.18
# it IS f64_parse_n over the span up to the NUL), and a validated token holds no NUL, so the bits
# are identical. The copy goes on the stack for an ordinary token. Only a token of 64 bytes or more,
# which takes a hostile file, copies to the heap.
fn n_sfz_parse_span(p, n, out) {
    var buf[64];
    if (n < 64) {
        memcpy(&buf, p, n);
        store8(&buf + n, 0);
        store64(out, f64_parse(&buf));
        return 1;
    }
    var h = alloc(n + 1);
    if (h == 0) { return 0; }
    memcpy(h, p, n);
    store8(h + n, 0);
    store64(out, f64_parse(h));
    return 1;
}

# parse a Str as f64. Returns 1 + writes bits to out, or 0.
#
# f64_parse_ok stops at the first character it cannot use and reports success on the
# prefix, so every float opcode used to accept trailing garbage that Rust's
# parse::<f32>() rejects outright. That is not cosmetic: `cutoff=1000Hz` low-passed
# every note at 1 kHz where the oracle disables the filter entirely, and
# `ampeg_attack=10ms` became attack_samples=441000 -- a TEN-SECOND fade-in on every
# note where the oracle applies no per-zone envelope at all.
#
# Validate the WHOLE token first: [+-]? ( digits [. digits?] | . digits ) ( [eE] [+-]? digits )?
# Rust also accepts inf / infinity / nan, case-insensitively, so those pass through.
fn sfz_f64(s, out) {
    var len = str_len(s);
    if (len == 0) { return 0; }
    var data = str_data(s);
    var i = 0;
    var c0 = load8(data);
    if (c0 == 43) { i = 1; }
    if (c0 == 45) { i = 1; }
    if (i >= len) { return 0; }

    # inf / infinity / nan (case-insensitive) -- Rust accepts all three. Compared in place and
    # parsed through n_sfz_parse_span: this path used to build three lowercased heap copies and a
    # heap NUL-terminated copy of every float token, all of it never reclaimed.
    var rp = data + i;
    var rn = len - i;
    if (n_sfz_span_eq_nocase(rp, rn, "inf") == 1) { return n_sfz_parse_span(data, len, out); }
    if (n_sfz_span_eq_nocase(rp, rn, "infinity") == 1) { return n_sfz_parse_span(data, len, out); }
    if (n_sfz_span_eq_nocase(rp, rn, "nan") == 1) { return n_sfz_parse_span(data, len, out); }

    var digits = 0;
    while (i < len) {
        var c = load8(data + i);
        if (c < 48) { break; }
        if (c > 57) { break; }
        digits = digits + 1;
        i = i + 1;
    }
    if (i < len) {
        if (load8(data + i) == 46) {
            i = i + 1;
            while (i < len) {
                var cf = load8(data + i);
                if (cf < 48) { break; }
                if (cf > 57) { break; }
                digits = digits + 1;
                i = i + 1;
            }
        }
    }
    if (digits == 0) { return 0; }
    if (i < len) {
        var ce = load8(data + i);
        if (ce != 101) { if (ce != 69) { return 0; } }
        i = i + 1;
        if (i < len) {
            var cs = load8(data + i);
            if (cs == 43) { i = i + 1; }
            if (cs == 45) { i = i + 1; }
        }
        var edig = 0;
        while (i < len) {
            var cx = load8(data + i);
            if (cx < 48) { return 0; }
            if (cx > 57) { return 0; }
            edig = edig + 1;
            i = i + 1;
        }
        if (edig == 0) { return 0; }
    }
    if (i != len) { return 0; }
    # The whole token has been validated, so parsing exactly this span returns what f64_parse_ok
    # on a heap NUL-terminated copy did, bit for bit.
    if (n_sfz_parse_span(data, len, out) == 0) { return 0; }
    # Normalise -0.0 to +0.0. sfz_inh decides "was this opcode explicitly set?" by comparing
    # the stored value against the default as a RAW BIT PATTERN, and -0.0 is 0x8000...0, which
    # is not bit-equal to +0.0. The oracle compared with `== 0.0`, where -0.0 IS equal -- so
    # `<global> volume=-6` + `<region> volume=-0` inherited -6.0 in Rust and stayed at -0.0
    # here. Same trap at the has_ampeg / has_fileg gates, where `ampeg_attack=-0` made the port
    # wire a 1-sample-release ADSR the oracle never wired at all.
    # Normalising is behaviour-preserving downstream: -0.0 and +0.0 give the same amplitude,
    # the same pan, and the same envelope.
    if (load64(out) == 0x8000000000000000) { store64(out, 0); }
    return 1;
}

# --- parse_note_or_number(s) -> MIDI 0..127, or -1 (None) ---
#
# Two parse widths, both the oracle's (rust-old/src/sfz.rs parse_note_or_number):
#   * the numeric attempt is `s.parse::<u8>()`. It was a SIGNED parse here, so "-0" came back as
#     note 0 where u8 rejects the '-' and the note-name path then answers None: `hikey=-0` set
#     hikey 0 (a zone that matches only note 0) instead of leaving 127.
#   * the octave is `parse::<i32>()`. It was an i64 parse, and `(octave + 1) * 12` wrapped, so
#     `c4611686018427387903` came back as note 0 and `e...` as note 4 -- nonsense accepted as a
#     key. With the octave held to i32 the product cannot overflow an i64, so the range test
#     below sees the true value. (The oracle computed in i32: in a release build an octave near
#     2^30 wrapped there instead, and a debug build panicked. Those inputs return None here.)
#must_use
fn n_sfz_note_or_num(value) {
    var o[8];
    if (sfz_u8(value, &o) == 1) { return load64(&o); }
    var data = str_data(value);
    var len = str_len(value);
    if (len == 0) { return 0 - 1; }
    var c0 = load8(data);
    if (c0 >= 65) { if (c0 <= 90) { c0 = c0 + 32; } }
    var base = 0 - 1;
    if (c0 == 99) { base = 0; }
    if (c0 == 100) { base = 2; }
    if (c0 == 101) { base = 4; }
    if (c0 == 102) { base = 5; }
    if (c0 == 103) { base = 7; }
    if (c0 == 97) { base = 9; }
    if (c0 == 98) { base = 11; }
    if (base < 0) { return 0 - 1; }
    var idx = 1;
    var accidental = 0;
    if (idx < len) {
        var c1 = load8(data + idx);
        if (c1 == 35) { accidental = 1; idx = idx + 1; }
        else {
            if (c1 == 115) { accidental = 1; idx = idx + 1; }
            else {
                if (c1 == 98) {
                    if (idx + 1 < len) {
                        var c2 = load8(data + idx + 1);
                        if (c2 >= 48) { if (c2 <= 57) { accidental = 0 - 1; idx = idx + 1; } }
                    }
                }
            }
        }
    }
    # A stack Str over the octave digits: nothing here outlives the call.
    var os[16];
    store64(&os, data + idx);
    store64(&os + 8, len - idx);
    if (sfz_i32(&os, &o) == 0) { return 0 - 1; }
    var octave = load64(&o);
    var midi = (octave + 1) * 12 + base + accidental;
    if (midi < 0) { return 0 - 1; }
    if (midi > 127) { return 0 - 1; }
    return midi;
}

# --- SfzRegion (39 fields: the oracle's 37, then 2.2.2's seq_length and seq_position) ---
#derive(accessors)
struct NSfzRegion {
    sample;
    lokey;
    hikey;
    lovel;
    hivel;
    pitch_keycenter;
    tune;
    volume;
    pan;
    loop_mode;
    loop_start;
    loop_end;
    group;
    ampeg_attack;
    ampeg_decay;
    ampeg_sustain;
    ampeg_release;
    cutoff;
    fil_veltrack;
    fileg_attack;
    fileg_decay;
    fileg_sustain;
    fileg_release;
    fileg_depth;
    transpose;
    offset;
    end;
    resonance;
    fil_type;
    key;
    pitchlfo_freq;
    pitchlfo_depth;
    fillfo_freq;
    fillfo_depth;
    fil_keytrack;
    output;
    cc_modulations;
    seq_length;
    seq_position;
}

# a cc modulation entry: (param Str, cc int, depth f64)
#derive(accessors)
struct NSfzCC { param; cc; depth; }

#must_use
fn n_sfz_region_new() {
    var r = alloc(sizeof(NSfzRegion));
    var f100 = f64_from(100);
    NSfzRegion_set_sample(r, 0);
    NSfzRegion_set_lokey(r, 0);
    NSfzRegion_set_hikey(r, 127);
    NSfzRegion_set_lovel(r, 1);
    NSfzRegion_set_hivel(r, 127);
    NSfzRegion_set_pitch_keycenter(r, 60);
    NSfzRegion_set_tune(r, 0);
    NSfzRegion_set_volume(r, 0);
    NSfzRegion_set_pan(r, 0);
    NSfzRegion_set_loop_mode(r, 0);
    NSfzRegion_set_loop_start(r, 0);
    NSfzRegion_set_loop_end(r, 0);
    NSfzRegion_set_group(r, 0);
    # 0 = unset, so <group>/<global> inheritance can tell; to_zones maps 0 to SFZ's default of 1.
    NSfzRegion_set_seq_length(r, 0);
    NSfzRegion_set_seq_position(r, 0);
    NSfzRegion_set_ampeg_attack(r, 0);
    NSfzRegion_set_ampeg_decay(r, 0);
    NSfzRegion_set_ampeg_sustain(r, f100);
    NSfzRegion_set_ampeg_release(r, 0);
    NSfzRegion_set_cutoff(r, 0);
    NSfzRegion_set_fil_veltrack(r, 0);
    NSfzRegion_set_fileg_attack(r, 0);
    NSfzRegion_set_fileg_decay(r, 0);
    NSfzRegion_set_fileg_sustain(r, f100);
    NSfzRegion_set_fileg_release(r, 0);
    NSfzRegion_set_fileg_depth(r, 0);
    NSfzRegion_set_transpose(r, 0);
    NSfzRegion_set_offset(r, 0);
    NSfzRegion_set_end(r, 0);
    NSfzRegion_set_resonance(r, 0);
    NSfzRegion_set_fil_type(r, 0);
    NSfzRegion_set_key(r, 0 - 1);
    NSfzRegion_set_pitchlfo_freq(r, 0);
    NSfzRegion_set_pitchlfo_depth(r, 0);
    NSfzRegion_set_fillfo_freq(r, 0);
    NSfzRegion_set_fillfo_depth(r, 0);
    NSfzRegion_set_fil_keytrack(r, 0);
    NSfzRegion_set_output(r, 0);
    NSfzRegion_set_cc_modulations(r, vec_new());
    return r;
}

# apply one opcode (key, value are Str). Numeric parse failure leaves the field unchanged.
# Neither key nor value is retained: the string-valued opcodes store an owned copy, so a caller
# may pass views into a buffer it later reuses (n_sfz_parse passes stack views into its input).
# The numeric scratch is a stack slot; it was an alloc(8) per opcode, never reclaimed.
# loop_start / loop_end / offset / end parse as usize, as the oracle does (sfz.rs:265-272,
# 345-354), not u32: a value in (u32::MAX, u64::MAX] is accepted there and was refused here.
fn n_sfz_apply_opcode(r, key, value) {
    var ob[8];
    var o = &ob;
    if (str_eq_cstr(key, "sample") == 1) { NSfzRegion_set_sample(r, n_sfz_own(str_data(value), str_len(value))); return 0; }
    if (str_eq_cstr(key, "lokey") == 1) { var n = n_sfz_note_or_num(value); if (n >= 0) { NSfzRegion_set_lokey(r, n); } return 0; }
    if (str_eq_cstr(key, "hikey") == 1) { var n = n_sfz_note_or_num(value); if (n >= 0) { NSfzRegion_set_hikey(r, n); } return 0; }
    if (str_eq_cstr(key, "key") == 1) { var n = n_sfz_note_or_num(value); if (n >= 0) { NSfzRegion_set_key(r, n); } return 0; }
    if (str_eq_cstr(key, "lovel") == 1) { if (sfz_u8(value, o) == 1) { NSfzRegion_set_lovel(r, load64(o)); } return 0; }
    if (str_eq_cstr(key, "hivel") == 1) { if (sfz_u8(value, o) == 1) { NSfzRegion_set_hivel(r, load64(o)); } return 0; }
    if (str_eq_cstr(key, "pitch_keycenter") == 1) { var n = n_sfz_note_or_num(value); if (n >= 0) { NSfzRegion_set_pitch_keycenter(r, n); } return 0; }
    if (str_eq_cstr(key, "tune") == 1) { if (sfz_i32(value, o) == 1) { NSfzRegion_set_tune(r, load64(o)); } return 0; }
    if (str_eq_cstr(key, "volume") == 1) { if (sfz_f64(value, o) == 1) { NSfzRegion_set_volume(r, load64(o)); } return 0; }
    if (str_eq_cstr(key, "pan") == 1) { if (sfz_f64(value, o) == 1) { NSfzRegion_set_pan(r, f64_min(f64_max(load64(o), f64_neg(f64_from(100))), f64_from(100))); } return 0; }
    if (str_eq_cstr(key, "loop_mode") == 1) { NSfzRegion_set_loop_mode(r, n_sfz_own(str_data(value), str_len(value))); return 0; }
    if (str_eq_cstr(key, "loopmode") == 1) { NSfzRegion_set_loop_mode(r, n_sfz_own(str_data(value), str_len(value))); return 0; }
    if (str_eq_cstr(key, "loop_start") == 1) { if (sfz_uint(value, o) == 1) { NSfzRegion_set_loop_start(r, load64(o)); } return 0; }
    if (str_eq_cstr(key, "loopstart") == 1) { if (sfz_uint(value, o) == 1) { NSfzRegion_set_loop_start(r, load64(o)); } return 0; }
    if (str_eq_cstr(key, "loop_end") == 1) { if (sfz_uint(value, o) == 1) { NSfzRegion_set_loop_end(r, load64(o)); } return 0; }
    if (str_eq_cstr(key, "loopend") == 1) { if (sfz_uint(value, o) == 1) { NSfzRegion_set_loop_end(r, load64(o)); } return 0; }
    # seq_length / seq_position are SFZ's round-robin. The oracle wrote seq_position into `group`,
    # which gave each region of a round-robin set its OWN group, so the set could never cycle.
    # See docs/adr/0012-round-robin-plays.md.
    if (str_eq_cstr(key, "seq_length") == 1) { if (sfz_u32(value, o) == 1) { NSfzRegion_set_seq_length(r, load64(o)); } return 0; }
    if (str_eq_cstr(key, "seq_position") == 1) { if (sfz_u32(value, o) == 1) { NSfzRegion_set_seq_position(r, load64(o)); } return 0; }
    if (str_eq_cstr(key, "group") == 1) { if (sfz_u32(value, o) == 1) { NSfzRegion_set_group(r, load64(o)); } return 0; }
    if (str_eq_cstr(key, "ampeg_attack") == 1) { if (sfz_f64(value, o) == 1) { NSfzRegion_set_ampeg_attack(r, f64_max(load64(o), 0)); } return 0; }
    if (str_eq_cstr(key, "ampeg_decay") == 1) { if (sfz_f64(value, o) == 1) { NSfzRegion_set_ampeg_decay(r, f64_max(load64(o), 0)); } return 0; }
    if (str_eq_cstr(key, "ampeg_sustain") == 1) { if (sfz_f64(value, o) == 1) { NSfzRegion_set_ampeg_sustain(r, f64_min(f64_max(load64(o), 0), f64_from(100))); } return 0; }
    if (str_eq_cstr(key, "ampeg_release") == 1) { if (sfz_f64(value, o) == 1) { NSfzRegion_set_ampeg_release(r, f64_max(load64(o), 0)); } return 0; }
    if (str_eq_cstr(key, "cutoff") == 1) { if (sfz_f64(value, o) == 1) { NSfzRegion_set_cutoff(r, f64_max(load64(o), 0)); } return 0; }
    if (str_eq_cstr(key, "fil_veltrack") == 1) { if (sfz_f64(value, o) == 1) { NSfzRegion_set_fil_veltrack(r, load64(o)); } return 0; }
    if (str_eq_cstr(key, "fileg_attack") == 1) { if (sfz_f64(value, o) == 1) { NSfzRegion_set_fileg_attack(r, f64_max(load64(o), 0)); } return 0; }
    if (str_eq_cstr(key, "fileg_decay") == 1) { if (sfz_f64(value, o) == 1) { NSfzRegion_set_fileg_decay(r, f64_max(load64(o), 0)); } return 0; }
    if (str_eq_cstr(key, "fileg_sustain") == 1) { if (sfz_f64(value, o) == 1) { NSfzRegion_set_fileg_sustain(r, f64_min(f64_max(load64(o), 0), f64_from(100))); } return 0; }
    if (str_eq_cstr(key, "fileg_release") == 1) { if (sfz_f64(value, o) == 1) { NSfzRegion_set_fileg_release(r, f64_max(load64(o), 0)); } return 0; }
    if (str_eq_cstr(key, "fileg_depth") == 1) { if (sfz_f64(value, o) == 1) { NSfzRegion_set_fileg_depth(r, f64_min(f64_max(load64(o), f64_neg(f64_from(9600))), f64_from(9600))); } return 0; }
    if (str_eq_cstr(key, "transpose") == 1) { if (sfz_i32(value, o) == 1) { NSfzRegion_set_transpose(r, load64(o)); } return 0; }
    if (str_eq_cstr(key, "offset") == 1) { if (sfz_uint(value, o) == 1) { NSfzRegion_set_offset(r, load64(o)); } return 0; }
    if (str_eq_cstr(key, "end") == 1) { if (sfz_uint(value, o) == 1) { NSfzRegion_set_end(r, load64(o)); } return 0; }
    if (str_eq_cstr(key, "resonance") == 1) { if (sfz_f64(value, o) == 1) { NSfzRegion_set_resonance(r, f64_max(load64(o), 0)); } return 0; }
    if (str_eq_cstr(key, "fil_resonance") == 1) { if (sfz_f64(value, o) == 1) { NSfzRegion_set_resonance(r, f64_max(load64(o), 0)); } return 0; }
    if (str_eq_cstr(key, "fil_type") == 1) { NSfzRegion_set_fil_type(r, n_sfz_own(str_data(value), str_len(value))); return 0; }
    if (str_eq_cstr(key, "filtype") == 1) { NSfzRegion_set_fil_type(r, n_sfz_own(str_data(value), str_len(value))); return 0; }
    if (str_eq_cstr(key, "pitchlfo_freq") == 1) { if (sfz_f64(value, o) == 1) { NSfzRegion_set_pitchlfo_freq(r, f64_max(load64(o), 0)); } return 0; }
    if (str_eq_cstr(key, "pitchlfo_depth") == 1) { if (sfz_f64(value, o) == 1) { NSfzRegion_set_pitchlfo_depth(r, load64(o)); } return 0; }
    if (str_eq_cstr(key, "fillfo_freq") == 1) { if (sfz_f64(value, o) == 1) { NSfzRegion_set_fillfo_freq(r, f64_max(load64(o), 0)); } return 0; }
    if (str_eq_cstr(key, "fillfo_depth") == 1) { if (sfz_f64(value, o) == 1) { NSfzRegion_set_fillfo_depth(r, load64(o)); } return 0; }
    if (str_eq_cstr(key, "fil_keytrack") == 1) { if (sfz_f64(value, o) == 1) { NSfzRegion_set_fil_keytrack(r, f64_min(f64_max(load64(o), 0), f64_from(1200))); } return 0; }
    if (str_eq_cstr(key, "output") == 1) { if (sfz_u8(value, o) == 1) { NSfzRegion_set_output(r, load64(o)); } return 0; }

    # CC modulation fallback: key contains "_oncc"
    var pos = str_index_of_cstr(key, "_oncc");
    if (pos >= 0) {
        var cs[16];
        store64(&cs, str_data(key) + pos + 5);
        store64(&cs + 8, str_len(key) - pos - 5);
        var cc_out[8];
        if (sfz_u8(&cs, &cc_out) == 1) {
            if (sfz_f64(value, o) == 1) {
                var m = alloc(sizeof(NSfzCC));
                NSfzCC_set_param(m, n_sfz_own(str_data(key), pos));
                NSfzCC_set_cc(m, load64(&cc_out));
                NSfzCC_set_depth(m, load64(o));
                vec_push(NSfzRegion_cc_modulations(r), m);
            }
        }
        return 0;
    }
    return 0;
}

# inherit a numeric field from parent when self is at `def` and parent differs.
fn sfz_inh(self_v, parent_v, def) {
    if (self_v == def) { if (parent_v != def) { return parent_v; } }
    return self_v;
}

# inherit_from(parent): global->group->region. Self keeps any non-default it already has.
fn n_sfz_inherit_from(self, parent) {
    var f100 = f64_from(100);
    # Option/pointer fields
    if (NSfzRegion_sample(self) == 0) { NSfzRegion_set_sample(self, NSfzRegion_sample(parent)); }
    if (NSfzRegion_loop_mode(self) == 0) { NSfzRegion_set_loop_mode(self, NSfzRegion_loop_mode(parent)); }
    if (NSfzRegion_fil_type(self) == 0) { NSfzRegion_set_fil_type(self, NSfzRegion_fil_type(parent)); }
    if (NSfzRegion_key(self) < 0) { NSfzRegion_set_key(self, NSfzRegion_key(parent)); }
    if (vec_len(NSfzRegion_cc_modulations(self)) == 0) {
        if (vec_len(NSfzRegion_cc_modulations(parent)) > 0) {
            NSfzRegion_set_cc_modulations(self, NSfzRegion_cc_modulations(parent));
        }
    }
    # numeric fields
    NSfzRegion_set_lokey(self, sfz_inh(NSfzRegion_lokey(self), NSfzRegion_lokey(parent), 0));
    NSfzRegion_set_hikey(self, sfz_inh(NSfzRegion_hikey(self), NSfzRegion_hikey(parent), 127));
    NSfzRegion_set_lovel(self, sfz_inh(NSfzRegion_lovel(self), NSfzRegion_lovel(parent), 1));
    NSfzRegion_set_hivel(self, sfz_inh(NSfzRegion_hivel(self), NSfzRegion_hivel(parent), 127));
    NSfzRegion_set_pitch_keycenter(self, sfz_inh(NSfzRegion_pitch_keycenter(self), NSfzRegion_pitch_keycenter(parent), 60));
    NSfzRegion_set_tune(self, sfz_inh(NSfzRegion_tune(self), NSfzRegion_tune(parent), 0));
    NSfzRegion_set_volume(self, sfz_inh(NSfzRegion_volume(self), NSfzRegion_volume(parent), 0));
    NSfzRegion_set_pan(self, sfz_inh(NSfzRegion_pan(self), NSfzRegion_pan(parent), 0));
    NSfzRegion_set_loop_start(self, sfz_inh(NSfzRegion_loop_start(self), NSfzRegion_loop_start(parent), 0));
    NSfzRegion_set_loop_end(self, sfz_inh(NSfzRegion_loop_end(self), NSfzRegion_loop_end(parent), 0));
    NSfzRegion_set_group(self, sfz_inh(NSfzRegion_group(self), NSfzRegion_group(parent), 0));
    NSfzRegion_set_seq_length(self, sfz_inh(NSfzRegion_seq_length(self), NSfzRegion_seq_length(parent), 0));
    NSfzRegion_set_seq_position(self, sfz_inh(NSfzRegion_seq_position(self), NSfzRegion_seq_position(parent), 0));
    NSfzRegion_set_ampeg_attack(self, sfz_inh(NSfzRegion_ampeg_attack(self), NSfzRegion_ampeg_attack(parent), 0));
    NSfzRegion_set_ampeg_decay(self, sfz_inh(NSfzRegion_ampeg_decay(self), NSfzRegion_ampeg_decay(parent), 0));
    NSfzRegion_set_ampeg_sustain(self, sfz_inh(NSfzRegion_ampeg_sustain(self), NSfzRegion_ampeg_sustain(parent), f100));
    NSfzRegion_set_ampeg_release(self, sfz_inh(NSfzRegion_ampeg_release(self), NSfzRegion_ampeg_release(parent), 0));
    NSfzRegion_set_cutoff(self, sfz_inh(NSfzRegion_cutoff(self), NSfzRegion_cutoff(parent), 0));
    NSfzRegion_set_fil_veltrack(self, sfz_inh(NSfzRegion_fil_veltrack(self), NSfzRegion_fil_veltrack(parent), 0));
    NSfzRegion_set_fileg_attack(self, sfz_inh(NSfzRegion_fileg_attack(self), NSfzRegion_fileg_attack(parent), 0));
    NSfzRegion_set_fileg_decay(self, sfz_inh(NSfzRegion_fileg_decay(self), NSfzRegion_fileg_decay(parent), 0));
    NSfzRegion_set_fileg_sustain(self, sfz_inh(NSfzRegion_fileg_sustain(self), NSfzRegion_fileg_sustain(parent), f100));
    NSfzRegion_set_fileg_release(self, sfz_inh(NSfzRegion_fileg_release(self), NSfzRegion_fileg_release(parent), 0));
    NSfzRegion_set_fileg_depth(self, sfz_inh(NSfzRegion_fileg_depth(self), NSfzRegion_fileg_depth(parent), 0));
    NSfzRegion_set_transpose(self, sfz_inh(NSfzRegion_transpose(self), NSfzRegion_transpose(parent), 0));
    NSfzRegion_set_offset(self, sfz_inh(NSfzRegion_offset(self), NSfzRegion_offset(parent), 0));
    NSfzRegion_set_end(self, sfz_inh(NSfzRegion_end(self), NSfzRegion_end(parent), 0));
    NSfzRegion_set_resonance(self, sfz_inh(NSfzRegion_resonance(self), NSfzRegion_resonance(parent), 0));
    NSfzRegion_set_pitchlfo_freq(self, sfz_inh(NSfzRegion_pitchlfo_freq(self), NSfzRegion_pitchlfo_freq(parent), 0));
    NSfzRegion_set_pitchlfo_depth(self, sfz_inh(NSfzRegion_pitchlfo_depth(self), NSfzRegion_pitchlfo_depth(parent), 0));
    NSfzRegion_set_fillfo_freq(self, sfz_inh(NSfzRegion_fillfo_freq(self), NSfzRegion_fillfo_freq(parent), 0));
    NSfzRegion_set_fillfo_depth(self, sfz_inh(NSfzRegion_fillfo_depth(self), NSfzRegion_fillfo_depth(parent), 0));
    NSfzRegion_set_fil_keytrack(self, sfz_inh(NSfzRegion_fil_keytrack(self), NSfzRegion_fil_keytrack(parent), 0));
    NSfzRegion_set_output(self, sfz_inh(NSfzRegion_output(self), NSfzRegion_output(parent), 0));
    return 0;
}

# --- SfzFile ---
#derive(accessors)
struct NSfzFile { global; groups; regions; group_indices; default_path; includes; }

fn n_sfz_parse_header(token) {
    var len = str_len(token);
    if (len < 2) { return SFZ_HDR_NONE; }
    var data = str_data(token);
    if (load8(data) != 60) { return SFZ_HDR_NONE; }
    if (load8(data + len - 1) != 62) { return SFZ_HDR_NONE; }
    var ip = data + 1;
    var il = len - 2;
    if (n_sfz_span_eq(ip, il, "control") == 1) { return SFZ_HDR_CONTROL; }
    if (n_sfz_span_eq(ip, il, "global") == 1) { return SFZ_HDR_GLOBAL; }
    if (n_sfz_span_eq(ip, il, "group") == 1) { return SFZ_HDR_GROUP; }
    if (n_sfz_span_eq(ip, il, "region") == 1) { return SFZ_HDR_REGION; }
    if (n_sfz_span_eq(ip, il, "curve") == 1) { return SFZ_HDR_CURVE; }
    return SFZ_HDR_NONE;
}

# parse(input_cstr) -> NSfzFile pointer (never fails).
#
# Lines, tokens, keys and values are SPANS over the input, carried in stack Str headers; only
# what the file keeps is allocated (n_sfz_apply_opcode copies it). This loop used to build a vec
# of every line, a trimmed Str per line, two str_from headers for the `//` / `#include` tests and
# a fresh 152-byte token vec per line -- none of it ever reclaimed. Measured on 1 MB of "x\n":
# 130,024,440 heap bytes (124 per input byte), so a 40 MB file exhausted a 4 GB address space
# and segfaulted once alloc returned 0. Now 1,104 bytes for that input (the empty file), and a
# realistic 1 MB instrument went from 13,875,928 to 6,331,968: heap tracks what is kept.
#
# Line handling follows the oracle (except that input ends at the first NUL -- this is a cstr
# API, and the oracle's &str could carry one): split on '\n' (`str::lines` also drops a trailing
# '\r', which trim removes anyway), `str::trim` with Unicode White_Space, `//` comments,
# `trim_start_matches("#include")` -- which strips EVERY repeat of the prefix -- then `trim`,
# then `trim_matches('"')`, which strips every leading and trailing quote, not one of each.
#must_use
fn n_sfz_parse(input_cstr) {
    var data = input_cstr;
    var len = strlen(input_cstr);
    var global = n_sfz_region_new();
    var groups = vec_new();
    var regions = vec_new();
    var group_indices = vec_new();
    var default_path = 0;
    var includes = vec_new();
    var current_header = SFZ_HDR_NONE;
    var current_group_idx = 0 - 1;
    var tk[16];
    var kk[16];
    var vv[16];

    var ls = 0;
    while (ls < len) {
        var le = ls;
        while (le < len) {
            if (load8(data + le) == 10) { break; }
            le = le + 1;
        }
        var next = le + 1;
        # trim
        var a = ls;
        var b = le;
        while (a < b) {
            var wa = n_sfz_ws_at(data + a, b - a);
            if (wa == 0) { break; }
            a = a + wa;
        }
        while (b > a) {
            var wb = n_sfz_ws_before(data + a, b - a);
            if (wb == 0) { break; }
            b = b - wb;
        }
        var p = data + a;
        var n = b - a;
        var skip = 0;
        if (n == 0) { skip = 1; }
        if (skip == 0) { if (n >= 2) { if (memeq(p, "//", 2) == 1) { skip = 1; } } }
        if (skip == 0) {
            if (n >= 8) {
                if (memeq(p, "#include", 8) == 1) {
                    skip = 1;
                    var ia = a;
                    while (b - ia >= 8) {
                        if (memeq(data + ia, "#include", 8) == 0) { break; }
                        ia = ia + 8;
                    }
                    var ib = b;
                    while (ia < ib) {
                        var wi = n_sfz_ws_at(data + ia, ib - ia);
                        if (wi == 0) { break; }
                        ia = ia + wi;
                    }
                    while (ib > ia) {
                        var wj = n_sfz_ws_before(data + ia, ib - ia);
                        if (wj == 0) { break; }
                        ib = ib - wj;
                    }
                    while (ia < ib) {
                        if (load8(data + ia) != 34) { break; }
                        ia = ia + 1;
                    }
                    while (ib > ia) {
                        if (load8(data + ib - 1) != 34) { break; }
                        ib = ib - 1;
                    }
                    if (ib > ia) { vec_push(includes, n_sfz_own(data + ia, ib - ia)); }
                }
            }
        }
        if (skip == 0) {
            var i = 0;
            while (i < n) {
                var w = n_sfz_ws_at(p + i, n - i);
                if (w > 0) {
                    i = i + w;
                } else {
                    var st = i;
                    while (i < n) {
                        if (n_sfz_ws_at(p + i, n - i) > 0) { break; }
                        i = i + 1;
                    }
                    var tp = p + st;
                    var tl = i - st;
                    store64(&tk, tp);
                    store64(&tk + 8, tl);
                    var hk = n_sfz_parse_header(&tk);
                    if (hk != SFZ_HDR_NONE) {
                        current_header = hk;
                        if (hk == SFZ_HDR_GROUP) {
                            vec_push(groups, n_sfz_region_new());
                            current_group_idx = vec_len(groups) - 1;
                        }
                        if (hk == SFZ_HDR_REGION) {
                            vec_push(regions, n_sfz_region_new());
                            vec_push(group_indices, current_group_idx);
                        }
                    } else {
                        var eq = str_index_of(&tk, 61);
                        # split_opcode: key and value must both be non-empty
                        if (eq > 0) {
                            if (eq + 1 < tl) {
                                store64(&kk, tp);
                                store64(&kk + 8, eq);
                                store64(&vv, tp + eq + 1);
                                store64(&vv + 8, tl - eq - 1);
                                if (current_header == SFZ_HDR_CONTROL) {
                                    if (str_eq_cstr(&kk, "default_path") == 1) {
                                        if (tl - eq - 1 <= N_SFZ_PATH_MAX) {
                                            default_path = n_sfz_own(tp + eq + 1, tl - eq - 1);
                                        }
                                    }
                                } elif (current_header == SFZ_HDR_GLOBAL) {
                                    n_sfz_apply_opcode(global, &kk, &vv);
                                } elif (current_header == SFZ_HDR_GROUP) {
                                    n_sfz_apply_opcode(vec_get(groups, vec_len(groups) - 1), &kk, &vv);
                                } elif (current_header == SFZ_HDR_REGION) {
                                    n_sfz_apply_opcode(vec_get(regions, vec_len(regions) - 1), &kk, &vv);
                                } elif (current_header == SFZ_HDR_NONE) {
                                    n_sfz_apply_opcode(global, &kk, &vv);
                                }
                            }
                        }
                    }
                }
            }
        }
        ls = next;
    }

    var f = alloc(sizeof(NSfzFile));
    NSfzFile_set_global(f, global);
    NSfzFile_set_groups(f, groups);
    NSfzFile_set_regions(f, regions);
    NSfzFile_set_group_indices(f, group_indices);
    NSfzFile_set_default_path(f, default_path);
    NSfzFile_set_includes(f, includes);
    return f;
}

# --- mapping helpers ---
#must_use
fn n_sfz_map_loop_mode(s) {
    if (s == 0) { return LOOP_ONESHOT; }
    if (str_eq_cstr(s, "loop_continuous") == 1) { return LOOP_FORWARD; }
    if (str_eq_cstr(s, "loop_sustain") == 1) { return LOOP_SUSTAIN; }
    return LOOP_ONESHOT;
}

#must_use
fn n_sfz_map_fil_type(s) {
    if (s == 0) { return FILTER_LOWPASS; }
    if (str_eq_cstr(s, "hpf_1p") == 1) { return FILTER_HIGHPASS; }
    if (str_eq_cstr(s, "hpf_2p") == 1) { return FILTER_HIGHPASS; }
    if (str_eq_cstr(s, "bpf_2p") == 1) { return FILTER_BANDPASS; }
    if (str_eq_cstr(s, "brf_2p") == 1) { return FILTER_NOTCH; }
    return FILTER_LOWPASS;
}

# map_fil_veltrack(cents) = clamp(cents / 9600, 0, 1)
#must_use
fn n_sfz_map_fil_veltrack(cents) {
    return f64_min(f64_max(f64_div(cents, f64_from(9600)), 0), F64_ONE);
}

# a (zone, filename) pair produced by to_zones
#derive(accessors)
struct NSfzZoneFile { zone; filename; }

# to_zones(sfzfile, sample_rate f64 bits) -> vec of NSfzZoneFile.
#
# The default_path join is memoized per distinct sample name (content-keyed). It used to be one
# fresh |default_path| + |sample| allocation PER REGION, so heap was |default_path| x regions --
# see N_SFZ_PATH_MAX for the 1.19 MB file that needed ~8 GB. With the path capped at PATH_MAX and
# the join shared, a region whose sample repeats costs nothing extra, and a distinct sample costs
# at most PATH_MAX more than the `sample=` token that introduced it. Regions that share a name now
# share one filename Str, which nothing in nidhi mutates.
#must_use
fn n_sfz_to_zones(f, sample_rate) {
    var out = vec_new();
    var regions = NSfzFile_regions(f);
    var groups = NSfzFile_groups(f);
    var group_indices = NSfzFile_group_indices(f);
    var global = NSfzFile_global(f);
    var default_path = NSfzFile_default_path(f);
    var joined = 0;
    if (default_path != 0) { joined = map_new_str(); }
    var nreg = vec_len(regions);
    var i = 0;
    while (i < nreg) {
        # merged = clone of region (shallow copy of the struct fields is enough here)
        var merged = n_sfz_clone_region(vec_get(regions, i));
        var gi = vec_get(group_indices, i);
        if (gi >= 0) {
            if (gi < vec_len(groups)) { n_sfz_inherit_from(merged, vec_get(groups, gi)); }
        }
        n_sfz_inherit_from(merged, global);

        # key shorthand
        var kk = NSfzRegion_key(merged);
        if (kk >= 0) {
            if (NSfzRegion_lokey(merged) == 0) { if (NSfzRegion_hikey(merged) == 127) { NSfzRegion_set_lokey(merged, kk); NSfzRegion_set_hikey(merged, kk); } }
            if (NSfzRegion_pitch_keycenter(merged) == 60) { NSfzRegion_set_pitch_keycenter(merged, kk); }
        }

        var samp = NSfzRegion_sample(merged);
        var filename = samp;
        if (samp != 0) {
            if (default_path != 0) {
                if (str_starts_with(samp, default_path) == 0) {
                    filename = map_get_or(joined, samp, 0);
                    if (filename == 0) {
                        filename = n_sfz_join(default_path, samp);
                        if (filename != 0) { map_set(joined, samp, filename); }
                    }
                }
            }
        }
        if (filename == 0) {
            # no sample -> skip region. Also reached when the joined name could not be
            # allocated: dropping the region beats handing back a null filename.
        } else {
            # tune_cents = tune + transpose * 100
            var tune_cents = f64_add(f64_from(NSfzRegion_tune(merged)), f64_mul(f64_from(NSfzRegion_transpose(merged)), f64_from(100)));
            var filter_type = n_sfz_map_fil_type(NSfzRegion_fil_type(merged));

            var zone = n_zone_new(i);
            zone = n_zone_with_key_range(zone, NSfzRegion_lokey(merged), NSfzRegion_hikey(merged));
            zone = n_zone_with_vel_range(zone, NSfzRegion_lovel(merged), NSfzRegion_hivel(merged));
            zone = n_zone_with_root_note(zone, NSfzRegion_pitch_keycenter(merged));
            zone = n_zone_with_tune(zone, tune_cents);
            zone = n_zone_with_volume(zone, NSfzRegion_volume(merged));
            zone = n_zone_with_pan(zone, f64_div(NSfzRegion_pan(merged), f64_from(100)));
            zone = n_zone_with_loop(zone, n_sfz_map_loop_mode(NSfzRegion_loop_mode(merged)), NSfzRegion_loop_start(merged), NSfzRegion_loop_end(merged));
            zone = n_zone_with_filter(zone, NSfzRegion_cutoff(merged), n_sfz_map_fil_veltrack(NSfzRegion_fil_veltrack(merged)));
            zone = n_zone_with_filter_type(zone, filter_type);
            zone = n_zone_with_group(zone, NSfzRegion_group(merged));
            zone = n_zone_with_seq(zone, NSfzRegion_seq_length(merged), NSfzRegion_seq_position(merged));

            if (f64_gt(NSfzRegion_resonance(merged), 0) == 1) { zone = n_zone_with_filter_resonance(zone, NSfzRegion_resonance(merged)); }
            if (NSfzRegion_offset(merged) > 0) { zone = n_zone_with_sample_offset(zone, NSfzRegion_offset(merged)); }
            if (NSfzRegion_end(merged) > 0) { zone = n_zone_with_sample_end(zone, NSfzRegion_end(merged)); }

            # ampeg
            var f100 = f64_from(100);
            var has_ampeg = 0;
            if (NSfzRegion_ampeg_attack(merged) != 0) { has_ampeg = 1; }
            if (NSfzRegion_ampeg_decay(merged) != 0) { has_ampeg = 1; }
            if (NSfzRegion_ampeg_sustain(merged) != f100) { has_ampeg = 1; }
            if (NSfzRegion_ampeg_release(merged) != 0) { has_ampeg = 1; }
            if (has_ampeg == 1) {
                var adsr = n_adsr_config_from_seconds(NSfzRegion_ampeg_attack(merged), NSfzRegion_ampeg_decay(merged), f64_div(NSfzRegion_ampeg_sustain(merged), f100), NSfzRegion_ampeg_release(merged), sample_rate);
                zone = n_zone_with_adsr(zone, adsr);
            }
            # fileg
            var has_fileg = 0;
            if (NSfzRegion_fileg_depth(merged) != 0) { has_fileg = 1; }
            if (NSfzRegion_fileg_attack(merged) != 0) { has_fileg = 1; }
            if (NSfzRegion_fileg_decay(merged) != 0) { has_fileg = 1; }
            if (NSfzRegion_fileg_sustain(merged) != f100) { has_fileg = 1; }
            if (NSfzRegion_fileg_release(merged) != 0) { has_fileg = 1; }
            if (has_fileg == 1) {
                var fileg = n_adsr_config_from_seconds(NSfzRegion_fileg_attack(merged), NSfzRegion_fileg_decay(merged), f64_div(NSfzRegion_fileg_sustain(merged), f100), NSfzRegion_fileg_release(merged), sample_rate);
                zone = n_zone_with_filter_envelope(zone, fileg, NSfzRegion_fileg_depth(merged));
            }
            # LFOs
            if (f64_gt(NSfzRegion_pitchlfo_freq(merged), 0) == 1) { if (NSfzRegion_pitchlfo_depth(merged) != 0) { zone = n_zone_with_pitch_lfo(zone, NSfzRegion_pitchlfo_freq(merged), NSfzRegion_pitchlfo_depth(merged)); } }
            if (f64_gt(NSfzRegion_fillfo_freq(merged), 0) == 1) { if (NSfzRegion_fillfo_depth(merged) != 0) { zone = n_zone_with_filter_lfo(zone, NSfzRegion_fillfo_freq(merged), NSfzRegion_fillfo_depth(merged)); } }
            if (f64_gt(NSfzRegion_fil_keytrack(merged), 0) == 1) { zone = n_zone_with_key_tracking(zone, f64_div(NSfzRegion_fil_keytrack(merged), f64_from(1200))); }
            if (NSfzRegion_output(merged) > 0) { zone = n_zone_with_output_bus(zone, NSfzRegion_output(merged)); }

            var pair = alloc(sizeof(NSfzZoneFile));
            NSfzZoneFile_set_zone(pair, zone);
            NSfzZoneFile_set_filename(pair, filename);
            vec_push(out, pair);
        }
        i = i + 1;
    }
    return out;
}

# shallow clone of a region (copy every slot; the cc_modulations vec is shared by reference,
# matching how to_zones only reads it).
#must_use
fn n_sfz_clone_region(src) {
    var r = alloc(sizeof(NSfzRegion));
    var n = sizeof(NSfzRegion) / 8;
    var i = 0;
    while (i < n) {
        store64(r + i * 8, load64(src + i * 8));
        i = i + 1;
    }
    return r;
}

# a (instrument, sample_files) result
#derive(accessors)
struct NSfzInstResult { instrument; sample_files; }

# to_instrument(name, sample_rate) -> NSfzInstResult. Dedups filenames -> sequential SampleIds.
#
# Dedup is a content-keyed hashmap lookup, in first-seen order exactly as the oracle's
# `sample_files.iter().position(..)` scan assigns ids. That scan was ported literally, and it is
# O(regions x files): 40,000 regions with distinct names (a 1.16 MB file) took 14,346 ms here,
# 37 ms through the map. The stdlib map's hash is seeded per process, so a file cannot be
# crafted to collide its way back to quadratic.
#must_use
fn n_sfz_to_instrument(f, name, sample_rate) {
    var pairs = n_sfz_to_zones(f, sample_rate);
    var inst = n_instrument_new(name);
    var sample_files = vec_new();
    var seen = map_new_str();
    var np = vec_len(pairs);
    var i = 0;
    while (i < np) {
        var pair = vec_get(pairs, i);
        var zone = NSfzZoneFile_zone(pair);
        var filename = NSfzZoneFile_filename(pair);
        var idx = map_get_or(seen, filename, 0 - 1);
        if (idx < 0) {
            vec_push(sample_files, filename);
            idx = vec_len(sample_files) - 1;
            map_set(seen, filename, idx);
        }
        NZone_set_sample_id(zone, idx);
        n_instrument_add_zone(inst, zone);
        i = i + 1;
    }
    var res = alloc(sizeof(NSfzInstResult));
    NSfzInstResult_set_instrument(res, inst);
    NSfzInstResult_set_sample_files(res, sample_files);
    return res;
}
