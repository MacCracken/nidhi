# sample.cyr -- Sample data, interpolation, onset detection, SampleBank
# Requires: alloc, vec (vec_new/push/get/set/len/truncate), math (f64_*), f64_util
#
# Ports rust-old/src/sample.rs. Sample buffers are stdlib vecs of f64 bit patterns
# (interleaved for stereo), matching how naad/shravan carry audio. SampleId is a bare
# i64 bank index (the Rust newtype wrapper is dropped). The SIMD cubic-hermite path is
# not ported (it was a bit-exact optimization of the scalar path). detect_onsets is
# nidhi's own energy-based REX slicer -- naad's detect_onsets is a different
# (spectral-flux) algorithm, so this is ported directly for feature parity.

# --- Sample ---
# Fields: data (vec of f64 bits, interleaved), channels (1 or 2), sample_rate (Hz),
# frames (samples per channel), name (Str ptr or 0), slices (vec of frame indices).
#derive(accessors)
struct NSample {
    data;
    channels;
    sample_rate;
    frames;
    name;
    slices;
}

#must_use
fn n_sample_from_mono(data, sample_rate) {
    if (data <= 0) { return 0; }
    var s = alloc(sizeof(NSample));
    if (s == 0) { return 0; }
    var slices = vec_new();
    if (slices == 0) { return 0; }
    NSample_set_data(s, data);
    NSample_set_channels(s, 1);
    NSample_set_sample_rate(s, sample_rate);
    NSample_set_frames(s, vec_len(data));
    NSample_set_name(s, 0);
    NSample_set_slices(s, slices);
    return s;
}

#must_use
fn n_sample_from_stereo(data, sample_rate) {
    if (data <= 0) { return 0; }
    var s = alloc(sizeof(NSample));
    if (s == 0) { return 0; }
    var slices = vec_new();
    if (slices == 0) { return 0; }
    NSample_set_data(s, data);
    NSample_set_channels(s, 2);
    NSample_set_sample_rate(s, sample_rate);
    NSample_set_frames(s, vec_len(data) / 2);
    NSample_set_name(s, 0);
    NSample_set_slices(s, slices);
    return s;
}

fn n_sample_with_name(s, name) {
    if (s <= 0) { return s; }
    NSample_set_name(s, name);
    return s;
}

fn n_sample_with_slices(s, slices) {
    if (s <= 0) { return s; }
    NSample_set_slices(s, slices);
    return s;
}

# --- Private frame readers (zero-pad out-of-range for the interpolator edges) ---
#
# Every element read is bounded by the data vec's LIVE length as well as by NSample_frames.
# frames is a snapshot taken at construction, and the oracle could rely on it because Sample's
# data/frames/channels were pub(crate); #derive(accessors) exports NSample_set_data,
# NSample_set_frames and NSample_set_channels, so a consumer can leave them disagreeing (swap in
# a shorter take, set channels on a mono buffer). The fast paths below then read past the
# buffer SILENTLY -- measured, a 10-element vec read at 60 returned 12345.0 from the next heap
# allocation -- and these helpers' vec_get ended the process. Both now read 0, the same
# zero-pad every other out-of-range tap gets. A consistent sample takes the same branches it
# always did: idx < frames already implies every element below is in range.

# read_mono_frame(idx) -> f64. Stereo folds to mono via (L+R)*0.5.
#must_use
fn n_sample_read_mono_frame(s, idx) {
    if (idx < 0) { return 0; }
    if (idx >= NSample_frames(s)) { return 0; }
    var data = NSample_data(s);
    var len = vec_len(data);
    var ch = NSample_channels(s);
    if (ch == 1) {
        if (idx >= len) { return 0; }
        return vec_get(data, idx);
    }
    var lo = idx * ch;
    if (lo < 0) { return 0; }
    if (lo + 1 >= len) { return 0; }
    var l = vec_get(data, lo);
    var r = vec_get(data, lo + 1);
    return f64_mul(f64_add(l, r), F64_HALF);
}

# read_stereo left/right lanes (mono duplicated to both). Zero-pad OOB.
#must_use
fn n_sample_read_stereo_l(s, idx) {
    if (idx < 0) { return 0; }
    if (idx >= NSample_frames(s)) { return 0; }
    var data = NSample_data(s);
    var len = vec_len(data);
    var ch = NSample_channels(s);
    if (ch == 1) {
        if (idx >= len) { return 0; }
        return vec_get(data, idx);
    }
    var lo = idx * ch;
    if (lo < 0) { return 0; }
    if (lo >= len) { return 0; }
    return vec_get(data, lo);
}

#must_use
fn n_sample_read_stereo_r(s, idx) {
    if (idx < 0) { return 0; }
    if (idx >= NSample_frames(s)) { return 0; }
    var data = NSample_data(s);
    var len = vec_len(data);
    var ch = NSample_channels(s);
    if (ch == 1) {
        if (idx >= len) { return 0; }
        return vec_get(data, idx);
    }
    var lo = idx * ch;
    if (lo < 0) { return 0; }
    if (lo + 1 >= len) { return 0; }
    return vec_get(data, lo + 1);
}

# --- Cubic Hermite (Catmull-Rom) interpolation -- the engine's correctness anchor ---
# a = -0.5*y0 + 1.5*y1 - 1.5*y2 + 0.5*y3
# b =  y0     - 2.5*y1 + 2.0*y2 - 0.5*y3
# c = -0.5*y0            + 0.5*y2
# return ((a*t + b)*t + c)*t + y1     (Horner)
#must_use
# The five coefficients are compile-time constants written as literal f64 bit patterns.
# They used to be rebuilt on EVERY call -- two f64 divides and three negations per
# interpolated sample, on the hottest path in the engine. The values are identical:
#   -0.5 = 0xBFE0000000000000   1.5 = 0x3FF8000000000000   -1.5 = 0xBFF8000000000000
#   -2.5 = 0xC004000000000000
fn n_cubic_hermite(y0, y1, y2, y3, t) {
    var neg_half = 0xBFE0000000000000;
    var c15 = 0x3FF8000000000000;
    var neg15 = 0xBFF8000000000000;
    var neg25 = 0xC004000000000000;
    var a = f64_add(f64_add(f64_add(f64_mul(neg_half, y0), f64_mul(c15, y1)),
        f64_mul(neg15, y2)), f64_mul(F64_HALF, y3));
    var b = f64_add(f64_add(f64_add(y0, f64_mul(neg25, y1)),
        f64_mul(F64_TWO, y2)), f64_mul(neg_half, y3));
    var c = f64_add(f64_mul(neg_half, y0), f64_mul(F64_HALF, y2));
    return f64_add(f64_mul(f64_add(f64_mul(f64_add(f64_mul(a, t), b), t), c), t), y1);
}

# read_cubic(position) -> f64. floor(position) (not trunc) for negative-edge padding.
#must_use
fn n_sample_read_cubic(s, position) {
    var frames = NSample_frames(s);
    if (frames == 0) { return 0; }
    # See the note in n_sample_read_stereo_interpolated.
    if (n_pos_in_range(position) == 0) { return 0; }
    var idx = f64_to(f64_floor(position));
    var frac = f64_sub(position, f64_from(idx));

    # Interior fast path. The four taps span idx-1 .. idx+2, so `idx-1 >= 0 && idx+2 < frames`
    # proves every one of them in range of the FRAMES the sample claims. The third test proves
    # them in range of the data vec it actually holds: the highest element touched is
    # (idx+2)*ch + ch-1, i.e. `(idx+3)*ch <= len` (len read straight from the vec header,
    # lib/vec.cyr {data, len, cap}). For a consistent sample it always holds; see the frame
    # readers above for the desync it closes. Measured cost, in-process best of 7: 0.3 ns of
    # 35 per mono read, 0.1 ns of 59 per stereo read.
    # With all three established, the per-tap helpers' bounds tests, accessor calls and vec_get's
    # own bounds test are redundant, so read the vec's buffer directly. These tests must stay
    # EXACTLY as written: an off-by-one here is a silent out-of-bounds read, not a crash.
    #
    # The mono Hermite is written out in place, the same expression tree as n_cubic_hermite and
    # therefore bit-identical (tests/sample.tcyr compares them bit for bit). A 5-argument call
    # is never inlined by cyrius, and this is the interpolation_cubic hot path: measured
    # 36.4 -> 35.3 ns per read, length test included (in-process best of 7, 3 runs). The stereo
    # fold-down keeps the call; nothing renders through it (the engine uses
    # n_sample_read_stereo_interpolated).
    var ch = NSample_channels(s);
    var data = NSample_data(s);
    if (idx - 1 >= 0) {
        if (idx + 2 < frames) {
            if ((idx + 3) * ch <= load64(data + 8)) {
                var base = load64(data);
                if (ch == 1) {
                    var p = base + (idx - 1) * 8;
                    var y0 = load64(p);
                    var y1 = load64(p + 8);
                    var y2 = load64(p + 16);
                    var y3 = load64(p + 24);
                    var a = f64_add(f64_add(f64_add(f64_mul(0xBFE0000000000000, y0), f64_mul(0x3FF8000000000000, y1)),
                        f64_mul(0xBFF8000000000000, y2)), f64_mul(F64_HALF, y3));
                    var b = f64_add(f64_add(f64_add(y0, f64_mul(0xC004000000000000, y1)),
                        f64_mul(F64_TWO, y2)), f64_mul(0xBFE0000000000000, y3));
                    var c = f64_add(f64_mul(0xBFE0000000000000, y0), f64_mul(F64_HALF, y2));
                    var mono = f64_add(f64_mul(f64_add(f64_mul(f64_add(f64_mul(a, frac), b), frac), c), frac), y1);
                    return mono;
                }
                if (ch == 2) {
                    var q = base + (idx - 1) * 16;
                    var m0 = f64_mul(f64_add(load64(q), load64(q + 8)), F64_HALF);
                    var m1 = f64_mul(f64_add(load64(q + 16), load64(q + 24)), F64_HALF);
                    var m2 = f64_mul(f64_add(load64(q + 32), load64(q + 40)), F64_HALF);
                    var m3 = f64_mul(f64_add(load64(q + 48), load64(q + 56)), F64_HALF);
                    return n_cubic_hermite(m0, m1, m2, m3, frac);
                }
            }
        }
    }

    # Edge path: keeps the zero-padding semantics for out-of-range taps.
    var e0 = n_sample_read_mono_frame(s, idx - 1);
    var e1 = n_sample_read_mono_frame(s, idx);
    var e2 = n_sample_read_mono_frame(s, idx + 1);
    var e3 = n_sample_read_mono_frame(s, idx + 2);
    return n_cubic_hermite(e0, e1, e2, e3, frac);
}

#inline
#must_use
fn n_sample_read_interpolated(s, position) {
    return n_sample_read_cubic(s, position);
}

# read_stereo_interpolated(position, out) -> writes out[0]=L, out[1]=R (f64 bits).
fn n_sample_read_stereo_interpolated(s, position, out) {
    if (NSample_frames(s) == 0) {
        store64(out, 0);
        store64(out + 8, 0);
        return 0;
    }
    # The guards below are integer tests on idx-1 and idx+2, so idx must be small enough that
    # neither WRAPS. Past 2^63 f64_to saturates, and at either end one of the two wraps, both
    # guards read as in-range, and the fast path loads from just before the buffer. So refuse
    # the position in f64 first: finite and absurd is silence, same as non-finite.
    if (n_pos_in_range(position) == 0) {
        store64(out, 0);
        store64(out + 8, 0);
        return 0;
    }
    var idx = f64_to(f64_floor(position));
    var frac = f64_sub(position, f64_from(idx));

    # Interior fast path -- see the note in n_sample_read_cubic, including the live-length
    # test. Eight per-tap helper calls, each with two bounds tests and three accessor calls,
    # collapse to eight raw loads, and both Hermite evaluations are written out in place (same
    # expression tree as n_cubic_hermite, bit-identical). This is the engine's render path:
    # measured 62.3 -> 58.8 ns per stereo read, 38.5 -> 37.6 for a mono sample, length test
    # included (in-process best of 7, 3 runs).
    var frames2 = NSample_frames(s);
    var ch = NSample_channels(s);
    var sdata = NSample_data(s);
    if (idx - 1 >= 0) {
        if (idx + 2 < frames2) {
            if ((idx + 3) * ch <= load64(sdata + 8)) {
                var base = load64(sdata);
                if (ch == 1) {
                    var p = base + (idx - 1) * 8;
                    var y0 = load64(p);
                    var y1 = load64(p + 8);
                    var y2 = load64(p + 16);
                    var y3 = load64(p + 24);
                    var a = f64_add(f64_add(f64_add(f64_mul(0xBFE0000000000000, y0), f64_mul(0x3FF8000000000000, y1)),
                        f64_mul(0xBFF8000000000000, y2)), f64_mul(F64_HALF, y3));
                    var b = f64_add(f64_add(f64_add(y0, f64_mul(0xC004000000000000, y1)),
                        f64_mul(F64_TWO, y2)), f64_mul(0xBFE0000000000000, y3));
                    var c = f64_add(f64_mul(0xBFE0000000000000, y0), f64_mul(F64_HALF, y2));
                    var mv = f64_add(f64_mul(f64_add(f64_mul(f64_add(f64_mul(a, frac), b), frac), c), frac), y1);
                    store64(out, mv);
                    store64(out + 8, mv);
                    return 0;
                }
                if (ch == 2) {
                    var q = base + (idx - 1) * 16;
                    var l0 = load64(q);
                    var l1 = load64(q + 16);
                    var l2 = load64(q + 32);
                    var l3 = load64(q + 48);
                    var a = f64_add(f64_add(f64_add(f64_mul(0xBFE0000000000000, l0), f64_mul(0x3FF8000000000000, l1)),
                        f64_mul(0xBFF8000000000000, l2)), f64_mul(F64_HALF, l3));
                    var b = f64_add(f64_add(f64_add(l0, f64_mul(0xC004000000000000, l1)),
                        f64_mul(F64_TWO, l2)), f64_mul(0xBFE0000000000000, l3));
                    var c = f64_add(f64_mul(0xBFE0000000000000, l0), f64_mul(F64_HALF, l2));
                    var lv = f64_add(f64_mul(f64_add(f64_mul(f64_add(f64_mul(a, frac), b), frac), c), frac), l1);
                    store64(out, lv);
                    var r0 = load64(q + 8);
                    var r1 = load64(q + 24);
                    var r2 = load64(q + 40);
                    var r3 = load64(q + 56);
                    a = f64_add(f64_add(f64_add(f64_mul(0xBFE0000000000000, r0), f64_mul(0x3FF8000000000000, r1)),
                        f64_mul(0xBFF8000000000000, r2)), f64_mul(F64_HALF, r3));
                    b = f64_add(f64_add(f64_add(r0, f64_mul(0xC004000000000000, r1)),
                        f64_mul(F64_TWO, r2)), f64_mul(0xBFE0000000000000, r3));
                    c = f64_add(f64_mul(0xBFE0000000000000, r0), f64_mul(F64_HALF, r2));
                    store64(out + 8, f64_add(f64_mul(f64_add(f64_mul(f64_add(f64_mul(a, frac), b), frac), c), frac), r1));
                    return 0;
                }
            }
        }
    }

    var left = n_cubic_hermite(
      n_sample_read_stereo_l(s, idx - 1), n_sample_read_stereo_l(s, idx),
      n_sample_read_stereo_l(s, idx + 1), n_sample_read_stereo_l(s, idx + 2), frac);
    var right = n_cubic_hermite(
      n_sample_read_stereo_r(s, idx - 1), n_sample_read_stereo_r(s, idx),
      n_sample_read_stereo_r(s, idx + 1), n_sample_read_stereo_r(s, idx + 2), frac);
    store64(out, left);
    store64(out + 8, right);
    return 0;
}

# --- detect_onsets: energy-based transient detection, rebuilds s.slices ---
# window = max(min(512, frames/2), 1); hop = max(window/2, 1) (guards vs infinite loop).
# Per-window MEAN energy (sum of squares / window), stereo mixed to mono via (L+R)*0.5.
# Onset when normalized positive energy jump (diff/max_energy) strictly exceeds the
# clamped [0.01,1.0] threshold AND >= min_slice_frames since the last slice.
fn n_sample_detect_onsets(s, threshold, min_slice_frames) {
    var slices = NSample_slices(s);
    vec_truncate(slices, 0);
    var frames = NSample_frames(s);
    if (frames < 2) { return 0; }
    var data = NSample_data(s);
    var ch = NSample_channels(s);

    var window = 512;
    var half_frames = frames / 2;
    if (half_frames < window) { window = half_frames; }
    if (window < 1) { window = 1; }
    var hop = window / 2;
    if (hop < 1) { hop = 1; }
    var thr = f64_min(f64_max(threshold, f64_div(F64_ONE, f64_from(100))), F64_ONE);

    var e_frames = vec_new();
    var e_vals = vec_new();
    var pos = 0;
    while (pos + window <= frames) {
        var energy = 0;
        var i = pos;
        var lim = pos + window;
        while (i < lim) {
            var sm = 0;
            if (ch == 1) {
                sm = vec_get(data, i);
            } else {
                sm = f64_mul(f64_add(vec_get(data, i * 2), vec_get(data, i * 2 + 1)), F64_HALF);
            }
            energy = f64_add(energy, f64_mul(sm, sm));
            i = i + 1;
        }
        vec_push(e_frames, pos);
        vec_push(e_vals, f64_div(energy, f64_from(window)));
        pos = pos + hop;
    }

    var n = vec_len(e_vals);
    if (n < 2) { return 0; }

    var max_e = 0;
    var k = 0;
    while (k < n) {
        var e = vec_get(e_vals, k);
        if (f64_gt(e, max_e) == 1) { max_e = e; }
        k = k + 1;
    }
    var eps = f64_div(F64_ONE, f64_from(10000000000));
    if (f64_lt(max_e, eps) == 1) { return 0; }

    var last_slice = 0;
    var idx = 1;
    while (idx < n) {
        var frame = vec_get(e_frames, idx);
        var energy2 = vec_get(e_vals, idx);
        var prev_energy = vec_get(e_vals, idx - 1);
        var diff = f64_div(f64_sub(energy2, prev_energy), max_e);
        if (f64_gt(diff, thr) == 1) {
            if (frame - last_slice >= min_slice_frames) {
                vec_push(slices, frame);
                last_slice = frame;
            }
        }
        idx = idx + 1;
    }
    return 0;
}

# --- SampleBank ---
#derive(accessors)
struct NSampleBank {
    samples;
}

#must_use
fn n_sample_bank_new() {
    var b = alloc(sizeof(NSampleBank));
    if (b == 0) { return 0; }
    var samples = vec_new();
    if (samples == 0) { return 0; }
    NSampleBank_set_samples(b, samples);
    return b;
}

# add(sample) -> id (= length BEFORE push), or NIDHI_ERR_INVALID_PARAMETER if `sample`
# is not a valid pointer. sample is a NSample pointer.
#
# The guard is the bank's trust boundary. n_load_wav returns NIDHI_ERR_IMPORT (-5) on
# failure, and a caller that forwards that straight in used to have it STORED as a
# sample: n_sample_bank_get would hand -5 back, engine.cyr's `== 0` guard would not
# fire, and NSample_frames(-5) is a wild load in the audio callback. Reject negatives
# and 0 here rather than trusting every call site to check first.
#must_use
fn n_sample_bank_add(bank, sample) {
    if (bank <= 0) { return NIDHI_ERR_INVALID_PARAMETER; }
    if (sample <= 0) { return NIDHI_ERR_INVALID_PARAMETER; }
    var samples = NSampleBank_samples(bank);
    var id = vec_len(samples);
    # vec_push_a reports a refused grow; vec_push would exit the host.
    if (vec_push_a(default_alloc(), samples, sample) < 0) { return NIDHI_ERR_PLAYBACK; }
    return id;
}

# get(id) -> NSample pointer, or 0 if out of range.
#must_use
fn n_sample_bank_get(bank, id) {
    var samples = NSampleBank_samples(bank);
    if (id < 0) { return 0; }
    if (id >= vec_len(samples)) { return 0; }
    return vec_get(samples, id);
}

#must_use
fn n_sample_bank_len(bank) {
    return vec_len(NSampleBank_samples(bank));
}

#must_use
fn n_sample_bank_is_empty(bank) {
    if (vec_len(NSampleBank_samples(bank)) == 0) { return 1; }
    return 0;
}
