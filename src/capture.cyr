# capture.cyr -- sample recording, silence trim, normalization, loop detection
# Requires: alloc, vec, math, sample (NSample_*), naad (naad_normalize, naad_rms)
#
# Ports rust-old/src/capture.rs. "Use naad fully": normalize_peak -> guarded peak scale (1e-10 floor)
# (scale peak to 1.0 in place), normalize_rms -> naad_rms(buffer) + scale. trim_silence and
# detect_loop_points are nidhi-specific and ported directly.

# --- SampleRecorder ---
#derive(accessors)
struct NSampleRecorder {
    buffer;
    sample_rate;
    channels;
}

#must_use
fn n_recorder_new(sample_rate, channels) {
    var ch = channels;
    if (ch < 1) { ch = 1; }
    if (ch > 2) { ch = 2; }
    var r = alloc(sizeof(NSampleRecorder));
    NSampleRecorder_set_buffer(r, vec_new());
    NSampleRecorder_set_sample_rate(r, sample_rate);
    NSampleRecorder_set_channels(r, ch);
    return r;
}

# write(data) -- append all f64 elements of the vec `data` (interleaved) to the buffer.
fn n_recorder_write(r, data) {
    var buffer = NSampleRecorder_buffer(r);
    var n = vec_len(data);
    var i = 0;
    while (i < n) {
        vec_push(buffer, vec_get(data, i));
        i = i + 1;
    }
    return 0;
}

#must_use
# n_recorder_new clamps channels to 1..2, but #derive(accessors) also generates a public
# NSampleRecorder_set_channels that bypasses it -- Rust kept the field private, so 0 was
# unrepresentable. A 0 here is an integer divide-by-zero, so treat it as mono.
fn n_recorder_frames(r) {
    var ch = NSampleRecorder_channels(r);
    if (ch < 1) { ch = 1; }
    return vec_len(NSampleRecorder_buffer(r)) / ch;
}

fn n_recorder_clear(r) {
    vec_truncate(NSampleRecorder_buffer(r), 0);
    return 0;
}

# finish() -> NSample owning the recorded buffer. CONSUMES the recording: the recorder
# is left with a fresh empty buffer, mirroring Rust's `fn finish(self)`.
#
# The hand-off is not cosmetic. Rust MOVED the buffer out; the port aliased it, so the
# returned Sample and the still-live recorder shared one vec while NSample_frames stayed
# a snapshot. finish() then clear() left the Sample claiming N frames over an empty vec
# -- `vec: index out of bounds`, exit(1), on the next read. The non-crashing shape is
# worse: clear() then a LONGER write() left the old Sample silently playing the NEW
# take's audio. It also stopped n_normalize_peak / n_trim_silence from rewriting the
# recorder's live buffer behind its back.
#must_use
fn n_recorder_finish(r) {
    var buffer = NSampleRecorder_buffer(r);
    NSampleRecorder_set_buffer(r, vec_new());
    var sr = NSampleRecorder_sample_rate(r);
    if (NSampleRecorder_channels(r) == 2) {
        return n_sample_from_stereo(buffer, sr);
    }
    return n_sample_from_mono(buffer, sr);
}

#must_use
fn n_recorder_finish_processed(r, silence_threshold) {
    var sample = n_recorder_finish(r);
    n_trim_silence(sample, silence_threshold);
    n_normalize_peak(sample);
    return sample;
}

# --- trim_silence: remove leading + trailing silence (strict > threshold) ---
fn n_trim_silence(sample, threshold) {
    var thr = f64_max(threshold, 0);
    var ch = NSample_channels(sample);
    var frames = NSample_frames(sample);
    if (frames == 0) { return 0; }
    var data = NSample_data(sample);

    # Both scans exit on the first hit. The flag-guarded form these replace kept walking
    # the whole buffer after finding its frame -- a port regression, since the oracle uses
    # .find() / .rev().find(), which short-circuit. Same result, O(silence) not O(buffer).
    var start = frames;
    var f = 0;
    while (f < frames) {
        var c = 0;
        var nonsilent = 0;
        while (c < ch) {
            if (f64_gt(f64_abs(vec_get(data, f * ch + c)), thr) == 1) { nonsilent = 1; }
            c = c + 1;
        }
        if (nonsilent == 1) {
            start = f;
            break;
        }
        f = f + 1;
    }

    var end = 0;
    var g = frames;
    while (g > 0) {
        g = g - 1;
        var c2 = 0;
        var ns2 = 0;
        while (c2 < ch) {
            if (f64_gt(f64_abs(vec_get(data, g * ch + c2)), thr) == 1) { ns2 = 1; }
            c2 = c2 + 1;
        }
        if (ns2 == 1) {
            end = g + 1;
            break;
        }
    }

    if (start >= end) {
        vec_truncate(data, 0);
        NSample_set_frames(sample, 0);
        return 0;
    }

    var sample_start = start * ch;
    var sample_end = end * ch;
    var nd = vec_new();
    var k = sample_start;
    while (k < sample_end) {
        vec_push(nd, vec_get(data, k));
        k = k + 1;
    }
    NSample_set_data(sample, nd);
    NSample_set_frames(sample, end - start);
    return 0;
}

# --- normalize_peak: scale so loudest |sample| -> 1.0, with a near-silence floor ---
#
# NOT naad_normalize. naad guards only `peak > 0`, which is too weak in two ways that
# both bite here. Rust (rust-old/src/capture.rs:116-125) scales only when peak > 1e-10:
#   (a) a peak of 1e-12 was being amplified x1e12 to full scale -- turning room tone
#       into a wall of noise where the oracle deliberately leaves the buffer alone;
#   (b) worse, a DENORMAL peak (4.94e-324) makes 1.0/peak overflow to +inf, writing
#       +/-inf straight into the sample data. That is a non-finite injection site inside
#       nidhi with no foreign decoder involved, and it reaches the SVF, which latches.
# The 1e-10 epsilon matches n_normalize_rms below, which has always had it.
fn n_normalize_peak(sample) {
    var data = NSample_data(sample);
    var n = vec_len(data);
    if (n == 0) { return 0; }
    var peak = naad_peak(data);
    var eps = f64_div(F64_ONE, f64_from(10000000000));
    if (f64_gt(peak, eps) == 1) {
        var gain = f64_div(F64_ONE, peak);
        var i = 0;
        while (i < n) {
            vec_set(data, i, f64_mul(vec_get(data, i), gain));
            i = i + 1;
        }
    }
    return 0;
}

# --- normalize_rms: scale to target RMS (naad_rms + manual gain) ---
fn n_normalize_rms(sample, target_rms) {
    var data = NSample_data(sample);
    if (vec_len(data) == 0) { return 0; }
    var r = naad_rms(data);
    var eps = f64_div(F64_ONE, f64_from(10000000000));
    if (f64_gt(r, eps) == 1) {
        var gain = f64_div(target_rms, r);
        var n = vec_len(data);
        var i = 0;
        while (i < n) {
            vec_set(data, i, f64_mul(vec_get(data, i), gain));
            i = i + 1;
        }
    }
    return 0;
}

# --- detect_loop_points: zero-crossing + normalized cross-correlation ---
# Returns a vec of pair pointers (each alloc(16): start at +0, end at +8), best score first,
# at most 10. Empty if frames < min_loop_frames*2 or < 2 positive zero crossings.
#must_use
fn n_detect_loop_points(sample, min_loop_frames) {
    var out = vec_new();
    var frames = NSample_frames(sample);
    if (frames < min_loop_frames * 2) { return out; }
    var data = NSample_data(sample);
    var ch = NSample_channels(sample);
    var eps = f64_div(F64_ONE, f64_from(10000000000));

    # 1. downmix to mono (mean over channels)
    var mono = vec_new();
    var f = 0;
    while (f < frames) {
        var s = 0;
        var c = 0;
        while (c < ch) {
            s = f64_add(s, vec_get(data, f * ch + c));
            c = c + 1;
        }
        vec_push(mono, f64_div(s, f64_from(ch)));
        f = f + 1;
    }

    # 2. positive-going zero crossings: mono[i-1] <= 0 && mono[i] > 0
    var crossings = vec_new();
    var i = 1;
    var mlen = vec_len(mono);
    while (i < mlen) {
        if (f64_le(vec_get(mono, i - 1), 0) == 1) {
            if (f64_gt(vec_get(mono, i), 0) == 1) { vec_push(crossings, i); }
        }
        i = i + 1;
    }
    if (vec_len(crossings) < 2) { return out; }

    # 3. score candidate pairs
    var compare_len = 64;
    if (frames / 4 < compare_len) { compare_len = frames / 4; }
    var c_starts = vec_new();
    var c_ends = vec_new();
    var c_scores = vec_new();
    var ncross = vec_len(crossings);
    var ci = 0;
    while (ci < ncross) {
        var start = vec_get(crossings, ci);
        var cj = ci + 1;
        while (cj < ncross) {
            var end = vec_get(crossings, cj);
            if (end - start >= min_loop_frames) {
                if (start + compare_len <= frames) {
                    if (end + compare_len <= frames) {
                        var dot = 0;
                        var na = 0;
                        var nb = 0;
                        var k = 0;
                        while (k < compare_len) {
                            var a = vec_get(mono, start + k);
                            var b = vec_get(mono, end + k);
                            dot = f64_add(dot, f64_mul(a, b));
                            na = f64_add(na, f64_mul(a, a));
                            nb = f64_add(nb, f64_mul(b, b));
                            k = k + 1;
                        }
                        var denom = f64_sqrt(f64_mul(na, nb));
                        var score = 0;
                        if (f64_gt(denom, eps) == 1) { score = f64_div(dot, denom); }
                        vec_push(c_starts, start);
                        vec_push(c_ends, end);
                        vec_push(c_scores, score);
                    }
                }
            }
            cj = cj + 1;
        }
        # 100-candidate cap: checked once per OUTER iteration
        if (vec_len(c_starts) > 100) { ci = ncross; } else { ci = ci + 1; }
    }

    # 4. STABLE insertion sort by score DESCENDING (ties keep insertion order, matching
    #    Rust's stable sort_by). Element a2 shifts left past strictly-smaller scores only.
    var ncand = vec_len(c_starts);
    var a2 = 1;
    while (a2 < ncand) {
        var ks = vec_get(c_starts, a2);
        var ke = vec_get(c_ends, a2);
        var ksc = vec_get(c_scores, a2);
        var b2 = a2 - 1;
        var shifting = 1;
        while (shifting == 1) {
            if (b2 < 0) {
                shifting = 0;
            } else {
                if (f64_lt(vec_get(c_scores, b2), ksc) == 1) {
                    vec_set(c_starts, b2 + 1, vec_get(c_starts, b2));
                    vec_set(c_ends, b2 + 1, vec_get(c_ends, b2));
                    vec_set(c_scores, b2 + 1, vec_get(c_scores, b2));
                    b2 = b2 - 1;
                } else {
                    shifting = 0;
                }
            }
        }
        vec_set(c_starts, b2 + 1, ks);
        vec_set(c_ends, b2 + 1, ke);
        vec_set(c_scores, b2 + 1, ksc);
        a2 = a2 + 1;
    }

    # 5. top 10 (start,end) pairs
    var take = ncand;
    if (take > 10) { take = 10; }
    var t = 0;
    while (t < take) {
        var pair = alloc(16);
        store64(pair, vec_get(c_starts, t));
        store64(pair + 8, vec_get(c_ends, t));
        vec_push(out, pair);
        t = t + 1;
    }
    return out;
}
