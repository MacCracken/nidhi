# capture.cyr -- sample recording, silence trim, normalization, loop detection
# Requires: alloc, vec, math, sample (NSample_*), naad (naad_normalize, naad_rms)
#
# Ports rust-old/src/capture.rs. "Use naad fully": normalize_peak -> guarded peak scale (1e-10 floor)
# (scale peak to 1.0 in place), normalize_rms -> naad_rms(buffer) + scale. trim_silence and
# detect_loop_points are nidhi-specific and ported directly.

# --- SampleRecorder ---
#derive(accessors)
struct NSampleRecorder {
    buffer;
    sample_rate;
    channels;
}

#must_use
fn n_recorder_new(sample_rate, channels) {
    var ch = channels;
    if (ch < 1) { ch = 1; }
    if (ch > 2) { ch = 2; }
    var r = alloc(sizeof(NSampleRecorder));
    if (r == 0) { return 0; }
    var buf = vec_new();
    if (buf == 0) { return 0; }
    NSampleRecorder_set_buffer(r, buf);
    NSampleRecorder_set_sample_rate(r, sample_rate);
    NSampleRecorder_set_channels(r, ch);
    return r;
}

# N_RECORDER_MAX_SAMPLES -- the most interleaved samples one take can hold: 2^28, VEC_CAP_MAX,
# which is also exactly ALLOC_MAX (2 GiB) of f64. That is 101.4 min mono / 50.7 min stereo at
# 44.1 kHz, 46.6 min stereo at 48 kHz, 23.3 min stereo at 96 kHz. On the bump allocator the
# buffer's abandoned grows add about as much again, so a full take costs ~4 GiB of heap.
var N_RECORDER_MAX_SAMPLES = 0x10000000;

# write(data) -> 0, or a negative code with NOTHING appended (a write is all or nothing):
#   NIDHI_ERR_INVALID_PARAMETER -- the take would pass N_RECORDER_MAX_SAMPLES, or `r` / `data`
#                                  is 0 or an error code.
#   NIDHI_ERR_PLAYBACK          -- the allocator refused to grow the buffer.
# Either way the samples already recorded are intact, and n_recorder_finish still works.
#
# This used to vec_push each sample, and vec_push ENDS THE PROCESS when it cannot grow: at
# VEC_CAP_MAX ("vec: capacity overflow"), or earlier when the heap runs out ("vec: alloc
# failed"). The oracle's Vec just kept growing, so a long take in the host (dhvani, shruti)
# killed it and lost the take. Measured under a 4 GB limit: stereo 48 kHz died at ~23 min.
# The buffer now grows here, once per write, by the same doubling vec_push used (so memory
# use is unchanged), and a refusal is a return code. Relies on the {data, len, cap} header
# lib/vec.cyr documents, as naad_vec_zeros does; tests/capture.tcyr pins it.
# #must_use since 2.3.0: an ignored refusal silently drops that block of audio from the take.
#must_use
fn n_recorder_write(r, data) {
    if (r <= 0) { return NIDHI_ERR_INVALID_PARAMETER; }
    if (data <= 0) { return NIDHI_ERR_INVALID_PARAMETER; }
    var buffer = NSampleRecorder_buffer(r);
    var n = vec_len(data);
    var len = vec_len(buffer);
    if (n > N_RECORDER_MAX_SAMPLES - len) { return NIDHI_ERR_INVALID_PARAMETER; }
    var need = len + n;
    var cap = vec_cap(buffer);
    if (need > cap) {
        var new_cap = cap;
        if (new_cap < 16) { new_cap = 16; }
        while (new_cap < need) { new_cap = new_cap * 2; }
        if (new_cap > N_RECORDER_MAX_SAMPLES) { new_cap = N_RECORDER_MAX_SAMPLES; }
        var grown = alloc(new_cap * 8);
        if (grown == 0) { return NIDHI_ERR_PLAYBACK; }
        var old = load64(buffer);
        var k = 0;
        while (k < len) {
            store64(grown + k * 8, load64(old + k * 8));
            k = k + 1;
        }
        store64(buffer, grown);
        store64(buffer + 16, new_cap);
    }
    # Read the source pointer only now: when `data` IS the buffer, the grow just moved it.
    var dst = load64(buffer) + len * 8;
    var src = load64(data);
    var i = 0;
    while (i < n) {
        store64(dst + i * 8, load64(src + i * 8));
        i = i + 1;
    }
    store64(buffer + 8, need);
    return 0;
}

#must_use
# n_recorder_new clamps channels to 1..2, but #derive(accessors) also generates a public
# NSampleRecorder_set_channels that bypasses it -- Rust kept the field private, so 0 was
# unrepresentable. A 0 here is an integer divide-by-zero, so treat it as mono.
fn n_recorder_frames(r) {
    var ch = NSampleRecorder_channels(r);
    if (ch < 1) { ch = 1; }
    return vec_len(NSampleRecorder_buffer(r)) / ch;
}

fn n_recorder_clear(r) {
    vec_truncate(NSampleRecorder_buffer(r), 0);
    return 0;
}

# finish() -> NSample owning the recorded buffer. CONSUMES the recording: the recorder
# is left with a fresh empty buffer, mirroring Rust's `fn finish(self)`.
#
# The hand-off is not cosmetic. Rust MOVED the buffer out; the port aliased it, so the
# returned Sample and the still-live recorder shared one vec while NSample_frames stayed
# a snapshot. finish() then clear() left the Sample claiming N frames over an empty vec
# -- `vec: index out of bounds`, exit(1), on the next read. The non-crashing shape is
# worse: clear() then a LONGER write() left the old Sample silently playing the NEW
# take's audio. It also stopped n_normalize_peak / n_trim_silence from rewriting the
# recorder's live buffer behind its back.
#
# -> the Sample, or 0 when an allocation is refused. In that case the recorder keeps the take:
# the fresh buffer and the Sample are both built BEFORE the hand-off, so a refusal loses nothing.
#must_use
fn n_recorder_finish(r) {
    var fresh = vec_new();
    if (fresh == 0) { return 0; }
    var buffer = NSampleRecorder_buffer(r);
    var sr = NSampleRecorder_sample_rate(r);
    var s = 0;
    if (NSampleRecorder_channels(r) == 2) { s = n_sample_from_stereo(buffer, sr); }
    else { s = n_sample_from_mono(buffer, sr); }
    if (s == 0) { return 0; }
    NSampleRecorder_set_buffer(r, fresh);
    return s;
}

#must_use
fn n_recorder_finish_processed(r, silence_threshold) {
    var sample = n_recorder_finish(r);
    if (sample == 0) { return 0; }
    n_trim_silence(sample, silence_threshold);
    n_normalize_peak(sample);
    return sample;
}

# --- trim_silence: remove leading + trailing silence (strict > threshold) ---
fn n_trim_silence(sample, threshold) {
    if (sample <= 0) { return 0; }
    var thr = f64_max(threshold, 0);
    var ch = NSample_channels(sample);
    var frames = NSample_frames(sample);
    if (frames == 0) { return 0; }
    var data = NSample_data(sample);

    # Both scans exit on the first hit. The flag-guarded form these replace kept walking
    # the whole buffer after finding its frame -- a port regression, since the oracle uses
    # .find() / .rev().find(), which short-circuit. Same result, O(silence) not O(buffer).
    var start = frames;
    var f = 0;
    while (f < frames) {
        var c = 0;
        var nonsilent = 0;
        while (c < ch) {
            if (f64_gt(f64_abs(vec_get(data, f * ch + c)), thr) == 1) { nonsilent = 1; }
            c = c + 1;
        }
        if (nonsilent == 1) {
            start = f;
            break;
        }
        f = f + 1;
    }

    var end = 0;
    var g = frames;
    while (g > 0) {
        g = g - 1;
        var c2 = 0;
        var ns2 = 0;
        while (c2 < ch) {
            if (f64_gt(f64_abs(vec_get(data, g * ch + c2)), thr) == 1) { ns2 = 1; }
            c2 = c2 + 1;
        }
        if (ns2 == 1) {
            end = g + 1;
            break;
        }
    }

    if (start >= end) {
        vec_truncate(data, 0);
        NSample_set_frames(sample, 0);
        return 0;
    }

    var sample_start = start * ch;
    var sample_end = end * ch;
    var nd = vec_new();
    var k = sample_start;
    while (k < sample_end) {
        vec_push(nd, vec_get(data, k));
        k = k + 1;
    }
    NSample_set_data(sample, nd);
    NSample_set_frames(sample, end - start);
    return 0;
}

# --- normalize_peak: scale so loudest |sample| -> 1.0, with a near-silence floor ---
#
# NOT naad_normalize. naad guards only `peak > 0`, which is too weak in two ways that
# both bite here. Rust (rust-old/src/capture.rs:116-125) scales only when peak > 1e-10:
#   (a) a peak of 1e-12 was being amplified x1e12 to full scale -- turning room tone
#       into a wall of noise where the oracle deliberately leaves the buffer alone;
#   (b) worse, a DENORMAL peak (4.94e-324) makes 1.0/peak overflow to +inf, writing
#       +/-inf straight into the sample data. That is a non-finite injection site inside
#       nidhi with no foreign decoder involved, and it reaches the SVF, which latches.
# The 1e-10 epsilon matches n_normalize_rms below, which has always had it.
fn n_normalize_peak(sample) {
    if (sample <= 0) { return 0; }
    var data = NSample_data(sample);
    var n = vec_len(data);
    if (n == 0) { return 0; }
    var peak = naad_peak(data);
    # A non-finite peak is a no-op, not a scale. One +inf sample makes the peak +inf and the gain
    # 1/inf = 0 -- a FINITE gain, so testing the gain would not catch it: every finite sample
    # became 0 and the inf became NaN (inf * 0). The take was erased and a NaN written into it,
    # measured. The oracle does the same; ADR 0002 (a NaN reaching the SVF latches the voice) is
    # why nidhi does not. Past this test, peak > 1e-10 bounds the gain below 1e10.
    if (n_is_finite(peak) == 0) { return 0; }
    var eps = f64_div(F64_ONE, f64_from(10000000000));
    if (f64_gt(peak, eps) == 1) {
        var gain = f64_div(F64_ONE, peak);
        var i = 0;
        while (i < n) {
            vec_set(data, i, f64_mul(vec_get(data, i), gain));
            i = i + 1;
        }
    }
    return 0;
}

# --- normalize_rms: scale to target RMS (naad_rms + manual gain) ---
fn n_normalize_rms(sample, target_rms) {
    if (sample <= 0) { return 0; }
    var data = NSample_data(sample);
    if (vec_len(data) == 0) { return 0; }
    var r = naad_rms(data);
    # Non-finite gain -> no-op. A NaN or +/-inf target_rms used to be written into EVERY sample:
    # measured, target NaN -> 100/100 samples NaN, target +inf -> 100/100 +inf. The oracle does
    # the same (gain = target / rms, unchecked); a non-finite parameter must not reach the audio
    # (ADR 0002). An rms of +inf (one inf sample) gives the finite gain 0 and the erase-plus-NaN
    # of n_normalize_peak, so it is refused first, for the same reason.
    if (n_is_finite(r) == 0) { return 0; }
    var eps = f64_div(F64_ONE, f64_from(10000000000));
    if (f64_gt(r, eps) == 1) {
        var gain = f64_div(target_rms, r);
        if (n_is_finite(gain) == 0) { return 0; }
        var n = vec_len(data);
        var i = 0;
        while (i < n) {
            vec_set(data, i, f64_mul(vec_get(data, i), gain));
            i = i + 1;
        }
    }
    return 0;
}

# n_loop_score_is_nan(x) -> 1 when the f64 bit pattern x is a NaN.
#must_use
fn n_loop_score_is_nan(x) {
    if ((x & 0x7FFFFFFFFFFFFFFF) > 0x7FF0000000000000) { return 1; }
    return 0;
}

# n_loop_top_insert -- insert (start, end, score) into the descending top-10 lists where a
# STABLE descending sort would put it: after the last kept entry that is not less than it.
# Past index 9 it is dropped. Returns 1 when kept, 0 when dropped. Three parallel vecs of at
# most 10, so this is O(10) per candidate.
fn n_loop_top_insert(top_s, top_e, top_sc, start, end, score) {
    var nt = vec_len(top_sc);
    var pos = nt;
    while (pos > 0) {
        if (f64_lt(vec_get(top_sc, pos - 1), score) == 1) {
            pos = pos - 1;
        } else {
            break;
        }
    }
    if (pos >= 10) { return 0; }
    vec_push(top_s, 0);
    vec_push(top_e, 0);
    vec_push(top_sc, 0);
    var m = nt;
    while (m > pos) {
        vec_set(top_s, m, vec_get(top_s, m - 1));
        vec_set(top_e, m, vec_get(top_e, m - 1));
        vec_set(top_sc, m, vec_get(top_sc, m - 1));
        m = m - 1;
    }
    vec_set(top_s, pos, start);
    vec_set(top_e, pos, end);
    vec_set(top_sc, pos, score);
    vec_truncate(top_s, 10);
    vec_truncate(top_e, 10);
    vec_truncate(top_sc, 10);
    return 1;
}

# --- detect_loop_points: zero-crossing + normalized cross-correlation ---
# Returns a vec of pair pointers (each alloc(16): start at +0, end at +8), best score first,
# at most 10. Empty if frames < min_loop_frames*2 or < 2 positive zero crossings.
#
# The length guard is `min_loop_frames > frames / 2`, the oracle's `frames < min * 2` without
# the multiply. That multiply overflowed for min >= 2^62 (2^63 wraps negative), the guard let
# it through, no pair could ever qualify, so the 100-candidate break never fired and every
# crossing pair was visited: measured, 3136 ms on 2 s of noise to return nothing. For min >= 0
# the two forms agree exactly (frames < 2m <=> m > floor(frames/2)).
#must_use
fn n_detect_loop_points(sample, min_loop_frames) {
    var out = vec_new();
    if (sample <= 0) { return out; }
    var frames = NSample_frames(sample);
    if (min_loop_frames > frames / 2) { return out; }
    var data = NSample_data(sample);
    var ch = NSample_channels(sample);
    var eps = f64_div(F64_ONE, f64_from(10000000000));

    # 1. downmix to mono (mean over channels)
    var mono = vec_new();
    var f = 0;
    while (f < frames) {
        var s = 0;
        var c = 0;
        while (c < ch) {
            s = f64_add(s, vec_get(data, f * ch + c));
            c = c + 1;
        }
        vec_push(mono, f64_div(s, f64_from(ch)));
        f = f + 1;
    }

    # 2. positive-going zero crossings: mono[i-1] <= 0 && mono[i] > 0
    var crossings = vec_new();
    var i = 1;
    var mlen = vec_len(mono);
    while (i < mlen) {
        if (f64_le(vec_get(mono, i - 1), 0) == 1) {
            if (f64_gt(vec_get(mono, i), 0) == 1) { vec_push(crossings, i); }
        }
        i = i + 1;
    }
    if (vec_len(crossings) < 2) { return out; }

    # 3. score candidate pairs, keeping only the 10 best.
    #
    # The oracle collects every candidate and stable-sorts them all (`sort_by`, O(n log n)). The
    # port's O(n^2) insertion sort over ALL of them was a regression, and n is large: the
    # 100-candidate break is checked once per OUTER pass, so on noise the first pass alone keeps
    # about one candidate per crossing (~frames/4). Measured, 1 s of noise took 1022 ms and 2 s
    # took 4087 ms -- quadratic, so a minute of cymbal would take an hour.
    #
    # Only the first 10 of the sorted order are returned, so keep exactly that prefix: each
    # candidate lands after the last kept entry whose score is NOT less than its own, which is
    # where a stable descending sort puts it (ties keep insertion order), and it falls off if
    # that is past index 9. Identical output, 111/111 cases against the full sort (tests pin it),
    # 2 s of noise 4193 -> 23 ms.
    #
    # NaN (only from an inf in the data: inf/inf) is not ordered against anything. In the full
    # insertion sort a NaN never moves left, and nothing moves left past it, so one parked at
    # index >= 10 kept every LATER candidate out of the top 10. `frozen` reproduces that.
    var compare_len = 64;
    if (frames / 4 < compare_len) { compare_len = frames / 4; }
    var top_s = vec_new();
    var top_e = vec_new();
    var top_sc = vec_new();
    var ncand = 0;
    var frozen = 0;
    var ncross = vec_len(crossings);
    var ci = 0;
    while (ci < ncross) {
        var start = vec_get(crossings, ci);
        var cj = ci + 1;
        while (cj < ncross) {
            var end = vec_get(crossings, cj);
            if (end - start >= min_loop_frames) {
                if (start + compare_len <= frames) {
                    if (end + compare_len <= frames) {
                        var dot = 0;
                        var na = 0;
                        var nb = 0;
                        var k = 0;
                        while (k < compare_len) {
                            var a = vec_get(mono, start + k);
                            var b = vec_get(mono, end + k);
                            dot = f64_add(dot, f64_mul(a, b));
                            na = f64_add(na, f64_mul(a, a));
                            nb = f64_add(nb, f64_mul(b, b));
                            k = k + 1;
                        }
                        var denom = f64_sqrt(f64_mul(na, nb));
                        var score = 0;
                        if (f64_gt(denom, eps) == 1) { score = f64_div(dot, denom); }
                        ncand = ncand + 1;
                        if (frozen == 0) {
                            if (n_loop_top_insert(top_s, top_e, top_sc, start, end, score) == 0) {
                                if (n_loop_score_is_nan(score) == 1) { frozen = 1; }
                            }
                        }
                    }
                }
            }
            cj = cj + 1;
        }
        # 100-candidate cap: checked once per OUTER iteration
        if (ncand > 100) { ci = ncross; } else { ci = ci + 1; }
    }

    # 4. the kept (start,end) pairs, best first
    var t = 0;
    while (t < vec_len(top_s)) {
        var pair = alloc(16);
        store64(pair, vec_get(top_s, t));
        store64(pair + 8, vec_get(top_e, t));
        vec_push(out, pair);
        t = t + 1;
    }
    return out;
}
