# io.cyr -- WAV loading + streaming (behind the Rust `io` feature; uses shravan)
# Requires: alloc, vec, string (strlen), str (str_new), syscalls/fs (file_open/read/write/close,
#           memcpy, load8/store8), sample (n_sample_from_mono/stereo/with_name), error (NIDHI_ERR_IMPORT),
#           shravan (wav_decode, decode_file, decode_result_info/samples, fmtinfo_channels/
#           sample_rate/total_samples, shravan_init_constants)
#
# 2.1.0 dropped the shravan streaming shim (wav_stream_new/feed/flush, stream_evt_*,
# STREAM_EVT_*): NStreamReader now decodes once and serves chunks from a cursor. Restore
# them only if shravan ever ships a genuinely incremental decoder -- the current one is
# buffer-then-decode-once, which is what made the shim decode every file twice.
#
# Ports rust-old/src/io.rs. Samples are f64 bit patterns end-to-end (shravan decodes to f64), so
# the Rust Vec<f32> boundary conversions are no-ops here. All failures collapse to NIDHI_ERR_IMPORT.
# Success returns a positive Sample pointer; failure returns the negative NIDHI_ERR_IMPORT code.

# --- MANDATORY one-time dependency initialisation ---
#
# shravan's PCM scale constants (F64_RCP_128 / F64_RCP_32768 / F64_RCP_8388608 /
# F64_RCP_2147483648 and 13 siblings) are declared as plain `0` and are only assigned by
# shravan_init_constants(). nidhi never called it, and 0 as an f64 bit pattern is +0.0,
# so ALL 17 were silently +0.0. Two live consequences, not one:
#   * the little-endian converters MULTIPLY by F64_RCP_*, so every 8/16/24/32-bit integer
#     PCM file decoded to pure silence -- and integer PCM is the common case for WAV;
#   * the big-endian converters DIVIDE by them, so an AIFF returned a SUCCESSFUL Sample
#     whose every frame was +/-inf or NaN, which then latches the SVF for the voice's life.
# tests/io.tcyr never caught either because every fixture encodes PCM_F32, the one format
# that needs no scale constant.
#
# Called from every public entry point rather than exported as a "remember to call this",
# because a consumer cannot be expected to know a transitive dependency needs waking up.
# shravan_init_constants only assigns globals that are currently 0, so it is idempotent;
# the flag just keeps it off the hot path.
#
# Checked and clear: shravan is the ONLY dependency with this pattern. naad's _DB_LUT and
# hisab's _PERM_TABLE / _grad3 self-initialise behind their own guards; goonj has none.
var N_INIT_DONE = 0;

fn n_init() {
    if (N_INIT_DONE == 1) { return 0; }
    shravan_init_constants();
    N_INIT_DONE = 1;
    return 0;
}

# n_read_file(path, out_len) -> heap byte buffer (or 0 on error); writes byte count to out_len.
# Mirrors shravan's decode_file read loop (grow-and-read).
#must_use
fn n_read_file(path, out_len) {
    var fd = file_open(path, 0, 0);
    if (fd < 0) { return 0; }
    var buf_cap = 1048576;
    var buf = alloc(buf_cap);
    var total = 0;
    var reading = 1;
    while (reading == 1) {
        var avail = buf_cap - total;
        if (avail <= 0) {
            var new_cap = buf_cap * 2;
            # lib/alloc.cyr's ALLOC_MAX is 0x80000000 and it rejects with `>`, not `>=`, so
            # the doubling chain succeeds all the way to 2^31 and the 2^32 request returns 0
            # -- then memcpy(0, buf, 2147483648) segfaults. No large file is needed to get
            # here: n_read_file("/dev/zero", slot) reaches it, and n_stream_reader_open is a
            # public entry point an SFZ `default_path` + `sample=` pair can steer.
            if (new_cap > 2147483648) {
                file_close(fd);
                store64(out_len, 0);
                return 0;
            }
            var new_buf = alloc(new_cap);
            if (new_buf == 0) {
                file_close(fd);
                store64(out_len, 0);
                return 0;
            }
            memcpy(new_buf, buf, total);
            buf = new_buf;
            buf_cap = new_cap;
            avail = buf_cap - total;
        }
        var n = file_read(fd, buf + total, avail);
        if (n <= 0) { reading = 0; } else { total = total + n; }
    }
    file_close(fd);
    store64(out_len, total);
    return buf;
}

# n_file_stem(path cstr) -> a new Str of the basename without extension (Rust Path::file_stem).
# A leading '.' is NOT treated as an extension separator (".bashrc" -> ".bashrc").
#must_use
fn n_file_stem(path) {
    var len = strlen(path);
    var slash = 0 - 1;
    var i = 0;
    while (i < len) {
        if (load8(path + i) == 47) { slash = i; }
        i = i + 1;
    }
    var start = slash + 1;
    var dot = 0 - 1;
    var j = start;
    while (j < len) {
        if (load8(path + j) == 46) { dot = j; }
        j = j + 1;
    }
    var end = len;
    if (dot > start) { end = dot; }
    return str_new(path + start, end - start);
}

# Build a Sample from a decode_result (mono if channels==1 else stereo).
#must_use
fn n_sample_from_decode(dr) {
    var info = decode_result_info(dr);
    var samples = decode_result_samples(dr);
    var channels = fmtinfo_channels(info);
    var sample_rate = fmtinfo_sample_rate(info);
    # Trust boundary for foreign audio data. A single non-finite frame is not a local
    # glitch: it propagates through the SVF state and latches the voice to NaN for its
    # whole life, and the mix buffer with it. O(n) once at load, zero cost per render.
    var nsm = vec_len(samples);
    var si = 0;
    while (si < nsm) {
        if (n_is_finite(vec_get(samples, si)) == 0) { vec_set(samples, si, 0); }
        si = si + 1;
    }
    if (channels == 1) { return n_sample_from_mono(samples, sample_rate); }
    return n_sample_from_stereo(samples, sample_rate);
}

# load_wav_from_memory(data, len) -> Sample pointer, or NIDHI_ERR_IMPORT.
#must_use
fn n_load_wav_from_memory(data, len) {
    n_init();
    var dr = wav_decode(data, len);
    if (dr < 0) { return NIDHI_ERR_IMPORT; }
    return n_sample_from_decode(dr);
}

# load_wav(path) -> Sample pointer (named from the file stem), or NIDHI_ERR_IMPORT.
#must_use
fn n_load_wav(path) {
    n_init();
    var dr = decode_file(path);
    if (dr < 0) { return NIDHI_ERR_IMPORT; }
    var sample = n_sample_from_decode(dr);
    return n_sample_with_name(sample, n_file_stem(path));
}

# --- StreamingWavReader ---
#
# 2.1.0: decodes the file ONCE. It used to decode twice -- n_stream_reader_open ran a full
# wav_decode purely to read the format header and threw the samples away, then read_chunk fed
# the entire file back through shravan's stream decoder to recover them. Measured 85.9 ms and
# 14.4 MB of never-reclaimed heap on a 10 s file BEFORE the first chunk was returned, which is
# the opposite of what a streaming reader is for. read_chunk also rebuilt `pending` into a
# fresh vec on every call, so read_all was two more full copies on top.
#
# The decoded buffer now lives on the reader and chunks are a cursor into it. That drops the
# shravan stream decoder, the pending buffer, and the file-data/offset bookkeeping entirely.
#
# NOTE: this is still not incremental -- open() holds the whole decoded file in memory. Making
# it genuinely streaming needs an incremental decoder from shravan; its current one is
# buffer-then-decode-once (the defect behind the 2.0.2 4 KB truncation bug). What this change
# buys is one decode instead of two and one copy instead of three, at strictly lower peak
# memory than before.
#derive(accessors)
struct NStreamReader {
    info;
    samples;
    channels;
    sample_rate;
    total_frames;
    frames_read;
}

# open(path) -> NStreamReader pointer, or NIDHI_ERR_IMPORT.
#must_use
fn n_stream_reader_open(path) {
    n_init();
    var lenslot = alloc(8);
    if (lenslot == 0) { return NIDHI_ERR_IMPORT; }
    var file_data = n_read_file(path, lenslot);
    if (file_data == 0) { return NIDHI_ERR_IMPORT; }
    var dr = wav_decode(file_data, load64(lenslot));
    if (dr < 0) { return NIDHI_ERR_IMPORT; }
    var info = decode_result_info(dr);
    var samples = decode_result_samples(dr);

    var ch = fmtinfo_channels(info);
    if (ch < 1) { ch = 1; }

    # Frame count comes from the DECODED data, not from the header's declared total. The two
    # disagreeing is exactly the 2.0.2 bug where total_frames stayed correct while the reader
    # returned 1013 frames; deriving it from what actually decoded makes that unrepresentable.
    var r = alloc(sizeof(NStreamReader));
    if (r == 0) { return NIDHI_ERR_IMPORT; }
    NStreamReader_set_info(r, info);
    NStreamReader_set_samples(r, samples);
    NStreamReader_set_channels(r, ch);
    NStreamReader_set_sample_rate(r, fmtinfo_sample_rate(info));
    NStreamReader_set_total_frames(r, vec_len(samples) / ch);
    NStreamReader_set_frames_read(r, 0);
    return r;
}

# read_chunk(chunk_frames) -> vec of interleaved f64 samples (empty when exhausted).
fn n_stream_reader_read_chunk(reader, chunk_frames) {
    var out = vec_new();
    if (chunk_frames <= 0) { return out; }
    var ch = NStreamReader_channels(reader);
    var read = NStreamReader_frames_read(reader);
    var remaining = NStreamReader_total_frames(reader) - read;
    if (remaining <= 0) { return out; }
    var n = chunk_frames;
    if (n > remaining) { n = remaining; }

    var samples = NStreamReader_samples(reader);
    var base = read * ch;
    var count = n * ch;
    var i = 0;
    while (i < count) {
        vec_push(out, vec_get(samples, base + i));
        i = i + 1;
    }
    NStreamReader_set_frames_read(reader, read + n);
    return out;
}

# read_all() -> a Sample holding every remaining frame.
fn n_stream_reader_read_all(reader) {
    var data = n_stream_reader_read_chunk(reader, NStreamReader_total_frames(reader));
    if (NStreamReader_channels(reader) == 1) {
        return n_sample_from_mono(data, NStreamReader_sample_rate(reader));
    }
    return n_sample_from_stereo(data, NStreamReader_sample_rate(reader));
}
