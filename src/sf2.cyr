# sf2.cyr -- SF2 / SoundFont-2 RIFF binary parser
# Requires: alloc, vec, str (str_from_buf), math (f64_*), byte ops (load8),
#           f64_util (n_vec_with_cap), sample (n_sample_*),
#           zone (n_zone_*), instrument (n_instrument_*), loop_mode (LOOP_*)
#
# Ports rust-old/src/sf2.rs. ALL multi-byte integers are little-endian. Parses an in-memory byte
# buffer (data ptr + len) into (presets, instruments, SampleBank). Success -> Sf2Result pointer;
# failure -> a negative error code. Lenient on bad content (skips), strict on structural errors.
# Every read is bounds-checked (returns 0 past end) so hostile input never reads OOB.

# --- FourCC constants (bytes packed little-endian, byte0 in the low 8 bits) ---
# RIFF/SoundFont chunk fourccs. N_-prefixed because these sit in exactly the namespace a codec
# dependency grows into -- shravan already parses RIFF, and Cyrius is SILENT on a duplicate
# `var`, so a future `CC_RIFF` there would resolve last-definition-wins with no diagnostic.
var N_CC_RIFF = 0x46464952;
var N_CC_SFBK = 0x6B626673;
var N_CC_LIST = 0x5453494C;
var N_CC_SDTA = 0x61746473;
var N_CC_SMPL = 0x6C706D73;
var N_CC_PDTA = 0x61746470;
var N_CC_PHDR = 0x72646870;
var N_CC_PBAG = 0x67616270;
var N_CC_PGEN = 0x6E656770;
var N_CC_INST = 0x74736E69;
var N_CC_IBAG = 0x67616269;
var N_CC_IGEN = 0x6E656769;
var N_CC_SHDR = 0x72646873;

# --- bounds-checked little-endian byte readers (0 past end) ---
fn sf2_u8(data, len, off) {
    if (off < 0) { return 0; }
    if (off >= len) { return 0; }
    return load8(data + off);
}

fn sf2_u16(data, len, off) {
    if (off < 0) { return 0; }
    if (off + 2 > len) { return 0; }
    return load8(data + off) | (load8(data + off + 1) << 8);
}

fn sf2_u32(data, len, off) {
    if (off < 0) { return 0; }
    if (off + 4 > len) { return 0; }
    return load8(data + off) | (load8(data + off + 1) << 8) | (load8(data + off + 2) << 16) | (load8(data + off + 3) << 24);
}

# Unchecked 16-bit little-endian reads for the walk's generator loops, whose index is already
# below the table's count -- so p + 2 is inside the chunk by construction. The checked readers
# cost the lazy walk 2x on a generator-heavy file (39.6 ms -> 77.2 ms); these keep it level.
# sf2_le16s sign-extends with (v ^ 0x8000) - 0x8000, which is v - 0x10000 exactly when bit 15 is
# set: one expression, so #inline applies.
#inline
fn sf2_le16(p) { return load8(p) | (load8(p + 1) << 8); }
#inline
fn sf2_le16s(p) { return ((load8(p) | (load8(p + 1) << 8)) ^ 0x8000) - 0x8000; }

# fourcc packed LE (same as u32); compares against CC_* constants.
fn sf2_fourcc(data, len, off) {
    return sf2_u32(data, len, off);
}

# sf2_name(data, dlen, off, flen) -> an OWNED Str of a fixed-width name field, cut at the first
# NUL (or the field width, or end of data); 0 when it cannot be allocated.
#
# Owned because every name built here leaves sf2_parse. They used to be Strs pointing INTO the
# caller's file buffer, so a caller that reused that buffer -- read the next .sf2 into it, the
# thing ADR 001's never-free allocator pushes a long-lived host towards -- silently renamed every
# preset it had already loaded (fixed in 2.2.2). Rust's parser returned owned Strings (sf2.rs
# read_fixed_string -> String::from_utf8_lossy(..).into()). Built only for what is returned:
# emitted presets (whose instrument shares the Str) and converted samples.
#must_use
fn sf2_name(data, dlen, off, flen) {
    var slen = 0;
    var scanning = 1;
    while (scanning == 1) {
        if (slen >= flen) {
            scanning = 0;
        } else {
            var idx = off + slen;
            if (idx >= dlen) {
                scanning = 0;
            } else {
                if (load8(data + idx) == 0) { scanning = 0; } else { slen = slen + 1; }
            }
        }
    }
    return str_from_buf(data + off, slen);
}

# range-generator amount: lo = low byte, hi = high byte of the 16-bit amount.
#inline
fn sf2_amt_lo(amount) { return amount & 0xFF; }
#inline
fn sf2_amt_hi(amount) { return ((amount & 0xFFFF) >> 8) & 0xFF; }

# public preset descriptor + the 3-list parse result
#derive(accessors)
struct Sf2Preset { name; bank; preset_number; }
#derive(accessors)
struct Sf2Result { presets; instruments; bank; }

# preset key/vel range passed down to the instrument-bag resolver
#derive(accessors)
struct Sf2PRange { pk_lo; pk_hi; have_pk; pv_lo; pv_hi; have_pv; }

# --- record tables: read in place, by index ---
#
# The seven pdta record arrays are read straight from the chunk bytes: record i of a chunk with
# record size SIZE starts at i * SIZE, and count = chunk length / SIZE (floor, as before). The
# field readers below go through the bounds-checked sf2_u16/sf2_u32/sf2_u8 against the chunk's
# own length; the two generator loops, whose index is below the count, read with sf2_le16.
#
# They used to be copied out first, one heap struct per record plus a vec slot and a borrowed
# name Str: 6x the file size in never-freed heap even after 2.2.2 sized the vecs, and the copies
# were then only ever read. Nothing is allocated per record now; names are built for what is
# returned. Measured on a 42 MB SF2 whose igen chunk holds 10.5M records: 251.7 MB of heap and
# ~380 ms before, 2,664 B and 0.1 ms now, the same result. On a generator-heavy valid file
# (60,000 zones, 2.4M generator visits) 39 ms -> 34 ms; across a 14-file corpus the parse
# output is byte-identical.
#
# Field layout (SF2 2.04 section 7, all little-endian):
#   phdr 38: name[20] preset@20 bank@22 bag@24        pbag/ibag 4: gen@0 (mod@2 unused)
#   inst 22: name[20] bag@20                           pgen/igen 4: oper@0 amount(i16)@2
#   shdr 46: name[20] start@20 end@24 loop_start@28 loop_end@32 rate@36 pitch(u8)@40 type@44
var N_SF2_PHDR_SIZE = 38;
var N_SF2_BAG_SIZE = 4;
var N_SF2_GEN_SIZE = 4;
var N_SF2_INST_SIZE = 22;
var N_SF2_SHDR_SIZE = 46;

# 2^-15 = 1/32768 as an f64 bit pattern (the PCM16 scale).
var N_F64_2_NEG_15 = 0x3F00000000000000;

# pcm16_to_f32: 16-bit LE PCM -> vec of f64 in [-1,1). Divisor 32768. Empty on bad range;
# 0 when the vec cannot be allocated.
#
# Written straight into a vec sized from the range. It was vec_push per sample from vec_new()
# plus an f64_div each: measured on 1M samples, 22.7 ms and 16.78 MB of heap (the doubling
# chain's outgrown buffers are never freed), now 3.9 ms and 8.00 MB. The output is
# bit-identical: 32768 is 2^15, so x / 32768 and x * 2^-15 are both exact for every 16-bit x,
# and the range check above the loop replaces the per-sample bounds check it used to make.
#must_use
fn sf2_pcm16_to_f32(data, dlen, start_sample, end_sample) {
    var byte_start = start_sample * 2;
    var byte_end = end_sample * 2;
    if (byte_end > dlen) { return vec_new(); }
    if (byte_start > byte_end) { return vec_new(); }
    var num = (byte_end - byte_start) / 2;
    var out = n_vec_with_cap(num);
    if (out == 0) { return 0; }
    if (num == 0) { return out; }
    var dst = load64(out);
    var src = data + byte_start;
    var i = 0;
    while (i < num) {
        var s = load8(src + i * 2) | (load8(src + i * 2 + 1) << 8);
        if (s >= 0x8000) { s = s - 0x10000; }
        store64(dst + i * 8, f64_mul(f64_from(s), N_F64_2_NEG_15));
        i = i + 1;
    }
    store64(out + 8, num);
    return out;
}

# --- resolve context: shdr memo + zone budget ---
#
# preset -> pbag -> ibag is a triple loop over three attacker-declared u16 index fields
# costing 38/4/4 bytes per step, and NOTHING was shared between iterations: every
# (preset, pbag, ibag) triple re-converted the SAME shdr's PCM into a fresh f64 vec and
# pushed another Sample into the bank. Memory therefore grew as the CUBE of file size --
# measured 229 MB from a 5,674-byte file, and ~7.5 KB was enough to reach `vec: alloc
# failed` -> syscall(60,1), an unconditional exit(1) of the HOST process (dhvani/shruti),
# with no error return to catch.
#
# Both halves below are load-bearing. The memo alone is not enough: with the PCM removed
# entirely, ~656 bytes of NZone plus zone-vec growth per triple still reaches ~1 GB from a
# 20 KB file. The budget alone is not enough either -- 65536 zones each re-converting a
# multi-megabyte shdr is still fatal. The cap stays well under VEC_CAP_MAX (2^28).
#
# Inherited from rust-old (sf2.rs:423-545 has the identical un-memoized walk), not a port
# regression -- but Rust's OOM is an abort of a process that can be supervised, whereas
# here it takes the audio host down mid-render.
var N_SF2_MAX_ZONES = 65536;

# --- work budget: every bag and generator the walk visits costs one unit ---
#
# The zone budget bounds what the walk BUILDS, not what it READS. A preset bag that names no
# instrument, or an instrument bag with no sampleID, costs nothing against N_SF2_MAX_ZONES, and
# bag ranges may overlap and point backwards. pbag gen_index alternating 0 / 65535 makes every
# other bag rescan all 65,535 pgens: 2.1e9 generator visits, 14.4 s, from ONE preset in a
# 525 KB file, and each further 76-byte phdr pair adds another 14 s (a 1000-pair file is about
# 4 hours) -- a parse that never returns, on the host's loader thread. Inherited from the oracle
# (sf2.rs has the same un-budgeted walk).
#
# 2^24 is above anything a file inside the zone budget can legitimately need. SF2 defines 61
# generator operators and a zone lists each at most once, so a zone is one ibag plus <= 61
# generators: 65,536 zones read at most 65,536 x 62 units. On top of that every preset bag reads
# itself, its own <= 61 generators and at most one global instrument zone of 62; phdr bag
# indices are u16 and the spec requires them to increase, so a conforming file visits at most
# 65,536 preset bags: 65,536 x (62 + 124) = 12.2M < 16.8M. Measured: the two bomb shapes now
# return NIDHI_ERR_IMPORT in 0.19 s and 0.69 s, and the valid fixtures parse unchanged.
var N_SF2_MAX_WORK = 16777216;

# Per-parse walk state: the shdr memo, both budgets, the preset-range record, the sample data,
# the bank, the seven record tables (pointer, byte length, record count) and a spare instrument.
#
# prange is reset per preset bag, so ONE record per parse is enough. It was alloc(48) per
# preset-bag visit, ahead of the instrument check and outside the zone budget: presets whose
# bag ranges all overlap one 65,536-bag pbag chunk made 3.15 GB of never-freed heap from a
# 338 KB file, and a 376 KB file ran out and SIGSEGV'd storing through the 0 alloc returned
# (measured, exit 139).
#
# The spare instrument is the one a preset with no zones leaves behind: it is still empty, so the
# next preset reuses it instead of allocating another 504 bytes. A phdr chunk of zone-less presets
# cost 504 B of heap per 38-byte record (13x) before; now it costs one instrument in all.
#derive(accessors)
struct Sf2Ctx {
    memo;
    zones_left;
    work_left;
    prange;
    smpl_ptr;
    smpl_len;
    bank;
    phdr_ptr;
    phdr_len;
    phdr_n;
    pbag_ptr;
    pbag_len;
    pbag_n;
    pgen_ptr;
    pgen_len;
    pgen_n;
    inst_ptr;
    inst_len;
    inst_n;
    ibag_ptr;
    ibag_len;
    ibag_n;
    igen_ptr;
    igen_len;
    igen_n;
    shdr_ptr;
    shdr_len;
    shdr_n;
    spare_inst;
}

# --- record field readers (index i, already checked against the table's count) ---
fn sf2_phdr_preset(ctx, i) {
    return sf2_u16(Sf2Ctx_phdr_ptr(ctx), Sf2Ctx_phdr_len(ctx),
        i * N_SF2_PHDR_SIZE + 20);
}
fn sf2_phdr_bank(ctx, i) {
    return sf2_u16(Sf2Ctx_phdr_ptr(ctx), Sf2Ctx_phdr_len(ctx),
        i * N_SF2_PHDR_SIZE + 22);
}
fn sf2_phdr_bag(ctx, i) {
    return sf2_u16(Sf2Ctx_phdr_ptr(ctx), Sf2Ctx_phdr_len(ctx),
        i * N_SF2_PHDR_SIZE + 24);
}
fn sf2_pbag_gen(ctx, i) {
    return sf2_u16(Sf2Ctx_pbag_ptr(ctx), Sf2Ctx_pbag_len(ctx),
        i * N_SF2_BAG_SIZE);
}
fn sf2_inst_bag(ctx, i) {
    return sf2_u16(Sf2Ctx_inst_ptr(ctx), Sf2Ctx_inst_len(ctx),
        i * N_SF2_INST_SIZE + 20);
}
fn sf2_ibag_gen(ctx, i) {
    return sf2_u16(Sf2Ctx_ibag_ptr(ctx), Sf2Ctx_ibag_len(ctx),
        i * N_SF2_BAG_SIZE);
}
# shdr u32 field at byte offset `field` (20 start, 24 end, 28 loop_start, 32 loop_end, 36 rate)
fn sf2_shdr_u32(ctx, i, field) {
    return sf2_u32(Sf2Ctx_shdr_ptr(ctx), Sf2Ctx_shdr_len(ctx),
        i * N_SF2_SHDR_SIZE + field);
}
fn sf2_shdr_pitch(ctx, i) {
    return sf2_u8(Sf2Ctx_shdr_ptr(ctx), Sf2Ctx_shdr_len(ctx),
        i * N_SF2_SHDR_SIZE + 40);
}
fn sf2_shdr_type(ctx, i) {
    return sf2_u16(Sf2Ctx_shdr_ptr(ctx), Sf2Ctx_shdr_len(ctx),
        i * N_SF2_SHDR_SIZE + 44);
}

# sf2_spend(ctx) -> 1 while the walk is inside its work budget, 0 once it is spent.
fn sf2_spend(ctx) {
    var w = Sf2Ctx_work_left(ctx) - 1;
    Sf2Ctx_set_work_left(ctx, w);
    if (w < 0) { return 0; }
    return 1;
}

# resolve one instrument bag: read igens, apply preset-range clamp, build a zone, add to inst_obj.
# Returns NIDHI_ERR_IMPORT once a budget is exhausted or an allocation is refused, which unwinds
# the whole walk.
fn sf2_do_ibag(ctx, inst_obj, ib) {
    var prange = Sf2Ctx_prange(ctx);
    var igen_n = Sf2Ctx_igen_n(ctx);
    var igen_start = sf2_ibag_gen(ctx, ib);
    var igen_end = igen_n;
    if (ib + 1 < Sf2Ctx_ibag_n(ctx)) { igen_end = sf2_ibag_gen(ctx, ib + 1); }

    var sample_id = 0 - 1;
    var kr_lo = 0;
    var kr_hi = 127;
    var vr_lo = 0;
    var vr_hi = 127;
    var root_override = 0 - 1;
    var sample_modes = 0;

    var iglim = igen_end;
    if (igen_n < iglim) { iglim = igen_n; }
    var gp = Sf2Ctx_igen_ptr(ctx);
    var ig = igen_start;
    while (ig < iglim) {
        if (sf2_spend(ctx) == 0) { return NIDHI_ERR_IMPORT; }
        var at = gp + ig * N_SF2_GEN_SIZE;
        var ioper = sf2_le16(at);
        var iamt = sf2_le16s(at + 2);
        if (ioper == 53) { sample_id = iamt & 0xFFFF; }
        if (ioper == 43) { kr_lo = sf2_amt_lo(iamt); kr_hi = sf2_amt_hi(iamt); }
        if (ioper == 44) { vr_lo = sf2_amt_lo(iamt); vr_hi = sf2_amt_hi(iamt); }
        if (ioper == 58) { var k = iamt & 0xFF; if (k <= 127) { root_override = k; } }
        if (ioper == 54) { sample_modes = iamt & 0xFFFF; }
        ig = ig + 1;
    }

    if (sample_id < 0) { return 0; }
    var shdr_lim = Sf2Ctx_shdr_n(ctx) - 1;
    if (shdr_lim < 0) { shdr_lim = 0; }
    if (sample_id >= shdr_lim) { return 0; }
    if ((sf2_shdr_type(ctx, sample_id) & 0x8000) != 0) { return 0; }

    var root_key = sf2_shdr_pitch(ctx, sample_id);
    if (root_override >= 0) { root_key = root_override; }

    var lm = sample_modes & 3;
    var loop_mode = LOOP_ONESHOT;
    if (lm == 1) { loop_mode = LOOP_FORWARD; }
    if (lm == 2) { loop_mode = LOOP_FORWARD; }
    if (lm == 3) { loop_mode = LOOP_SUSTAIN; }

    var fk_lo = kr_lo;
    var fk_hi = kr_hi;
    if (Sf2PRange_have_pk(prange) == 1) {
        if (Sf2PRange_pk_lo(prange) > fk_lo) { fk_lo = Sf2PRange_pk_lo(prange); }
        if (Sf2PRange_pk_hi(prange) < fk_hi) { fk_hi = Sf2PRange_pk_hi(prange); }
    }
    var fv_lo = vr_lo;
    var fv_hi = vr_hi;
    if (Sf2PRange_have_pv(prange) == 1) {
        if (Sf2PRange_pv_lo(prange) > fv_lo) { fv_lo = Sf2PRange_pv_lo(prange); }
        if (Sf2PRange_pv_hi(prange) < fv_hi) { fv_hi = Sf2PRange_pv_hi(prange); }
    }

    if (Sf2Ctx_zones_left(ctx) <= 0) { return NIDHI_ERR_IMPORT; }
    Sf2Ctx_set_zones_left(ctx, Sf2Ctx_zones_left(ctx) - 1);

    # One conversion per shdr, not one per (preset, pbag, ibag) triple. Sharing a SampleId
    # between zones is safe: nothing mutates a Sample after n_sample_bank_add, and
    # NZone_sample_id is only ever read.
    var start = sf2_shdr_u32(ctx, sample_id, 20);
    var memo = Sf2Ctx_memo(ctx);
    var sid = 0 - 1;
    if (sample_id < vec_len(memo)) { sid = vec_get(memo, sample_id); }
    if (sid < 0) {
        var end = sf2_shdr_u32(ctx, sample_id, 24);
        var pcm = sf2_pcm16_to_f32(Sf2Ctx_smpl_ptr(ctx), Sf2Ctx_smpl_len(ctx), start, end);
        if (pcm == 0) { return NIDHI_ERR_IMPORT; }
        var shoff = sample_id * N_SF2_SHDR_SIZE;
        var sname = sf2_name(Sf2Ctx_shdr_ptr(ctx), Sf2Ctx_shdr_len(ctx), shoff, 20);
        if (sname == 0) { return NIDHI_ERR_IMPORT; }
        # The constructors answer 0 on a refused allocation and bank_add a negative code; until
        # 2.3.0 nothing here could fail, so a refused NSample went on to NSample_set_name(0, ..).
        var sample = n_sample_from_mono(pcm, sf2_shdr_u32(ctx, sample_id, 36));
        if (sample <= 0) { return NIDHI_ERR_IMPORT; }
        sample = n_sample_with_name(sample, sname);
        sid = n_sample_bank_add(Sf2Ctx_bank(ctx), sample);
        if (sid < 0) { return NIDHI_ERR_IMPORT; }
        if (sample_id < vec_len(memo)) { vec_set(memo, sample_id, sid); }
    }

    # A refused zone or a refused zone-vec grow used to vanish: n_zone_new's 0 passed through the
    # builders, n_instrument_add_zone answered NIDHI_ERR_INVALID_PARAMETER / NIDHI_ERR_PLAYBACK,
    # and that result was discarded -- so the parse "succeeded" with the zone missing (a preset
    # whose only zone was refused disappeared from the result). Now the whole parse fails.
    var zone = n_zone_new(sid);
    zone = n_zone_with_key_range(zone, fk_lo, fk_hi);
    zone = n_zone_with_vel_range(zone, fv_lo, fv_hi);
    zone = n_zone_with_root_note(zone, root_key);
    if (loop_mode != LOOP_ONESHOT) {
        var ls = sf2_shdr_u32(ctx, sample_id, 28) - start;
        if (ls < 0) { ls = 0; }
        var le = sf2_shdr_u32(ctx, sample_id, 32) - start;
        if (le < 0) { le = 0; }
        zone = n_zone_with_loop(zone, loop_mode, ls, le);
    }
    if (zone <= 0) { return NIDHI_ERR_IMPORT; }
    if (n_instrument_add_zone(inst_obj, zone) < 0) { return NIDHI_ERR_IMPORT; }
    return 0;
}

# resolve one preset bag: find the referenced instrument + preset ranges, walk its ibags.
fn sf2_do_pbag(ctx, inst_obj, bi) {
    var pgen_n = Sf2Ctx_pgen_n(ctx);
    var gen_start = sf2_pbag_gen(ctx, bi);
    var gen_end = pgen_n;
    if (bi + 1 < Sf2Ctx_pbag_n(ctx)) { gen_end = sf2_pbag_gen(ctx, bi + 1); }

    var inst_index = 0 - 1;
    var prange = Sf2Ctx_prange(ctx);
    Sf2PRange_set_have_pk(prange, 0);
    Sf2PRange_set_have_pv(prange, 0);

    var glim = gen_end;
    if (pgen_n < glim) { glim = pgen_n; }
    var gp = Sf2Ctx_pgen_ptr(ctx);
    var g = gen_start;
    while (g < glim) {
        if (sf2_spend(ctx) == 0) { return NIDHI_ERR_IMPORT; }
        var at = gp + g * N_SF2_GEN_SIZE;
        var oper = sf2_le16(at);
        var amt = sf2_le16s(at + 2);
        if (oper == 41) { inst_index = amt & 0xFFFF; }
        if (oper == 43) {
            Sf2PRange_set_pk_lo(prange, sf2_amt_lo(amt));
            Sf2PRange_set_pk_hi(prange, sf2_amt_hi(amt));
            Sf2PRange_set_have_pk(prange, 1);
        }
        if (oper == 44) {
            Sf2PRange_set_pv_lo(prange, sf2_amt_lo(amt));
            Sf2PRange_set_pv_hi(prange, sf2_amt_hi(amt));
            Sf2PRange_set_have_pv(prange, 1);
        }
        g = g + 1;
    }

    if (inst_index < 0) { return 0; }
    var inst_lim = Sf2Ctx_inst_n(ctx) - 1;
    if (inst_lim < 0) { inst_lim = 0; }
    if (inst_index >= inst_lim) { return 0; }

    var ibag_start = sf2_inst_bag(ctx, inst_index);
    var ibag_end = sf2_inst_bag(ctx, inst_index + 1);
    var ib = ibag_start;
    while (ib < ibag_end) {
        if (ib >= Sf2Ctx_ibag_n(ctx)) { return 0; }
        if (sf2_spend(ctx) == 0) { return NIDHI_ERR_IMPORT; }
        var ir = sf2_do_ibag(ctx, inst_obj, ib);
        if (ir < 0) { return ir; }
        ib = ib + 1;
    }
    return 0;
}

# resolve all presets -> instruments -> zones. Fills the presets/instruments vecs + bank.
fn sf2_resolve(ctx, presets, instruments) {
    var ph_lim = Sf2Ctx_phdr_n(ctx) - 1;
    if (ph_lim < 0) { ph_lim = 0; }
    var pi = 0;
    while (pi < ph_lim) {
        var bag_start = sf2_phdr_bag(ctx, pi);
        var bag_end = sf2_phdr_bag(ctx, pi + 1);
        # A refused instrument returned 0, and n_instrument_zone_count(0) below read through it.
        var inst_obj = Sf2Ctx_spare_inst(ctx);
        if (inst_obj == 0) {
            inst_obj = n_instrument_new(0);
            if (inst_obj <= 0) { return NIDHI_ERR_IMPORT; }
            Sf2Ctx_set_spare_inst(ctx, inst_obj);
        }

        var bi = bag_start;
        var looping = 1;
        while (looping == 1) {
            if (bi >= bag_end) {
                looping = 0;
            } else {
                if (bi >= Sf2Ctx_pbag_n(ctx)) {
                    looping = 0;
                } else {
                    if (sf2_spend(ctx) == 0) { return NIDHI_ERR_IMPORT; }
                    var pr = sf2_do_pbag(ctx, inst_obj, bi);
                    if (pr < 0) { return pr; }
                    bi = bi + 1;
                }
            }
        }

        if (n_instrument_zone_count(inst_obj) > 0) {
            # One owned name, shared by the preset and its instrument (both immutable).
            var phoff = pi * N_SF2_PHDR_SIZE;
            var pname = sf2_name(Sf2Ctx_phdr_ptr(ctx), Sf2Ctx_phdr_len(ctx), phoff, 20);
            if (pname == 0) { return NIDHI_ERR_IMPORT; }
            NInstrument_set_name(inst_obj, pname);
            var preset = alloc(sizeof(Sf2Preset));
            if (preset == 0) { return NIDHI_ERR_IMPORT; }
            Sf2Preset_set_name(preset, pname);
            Sf2Preset_set_bank(preset, sf2_phdr_bank(ctx, pi));
            Sf2Preset_set_preset_number(preset, sf2_phdr_preset(ctx, pi));
            if (vec_push_a(default_alloc(), presets, preset) < 0) { return NIDHI_ERR_IMPORT; }
            if (vec_push_a(default_alloc(), instruments, inst_obj) < 0) { return NIDHI_ERR_IMPORT; }
            # This instrument is the preset's now; the next preset needs a fresh one.
            Sf2Ctx_set_spare_inst(ctx, 0);
        }
        pi = pi + 1;
    }
    return 0;
}

# parse(data, len) -> Sf2Result pointer, or a negative error code.
# All failures return NIDHI_ERR_IMPORT.
#
# These were 15 raw negative literals (-1..-3, -6..-15). Three of them were bit-identical
# to real codes from a DIFFERENT taxonomy -- -1 = NIDHI_ERR_SAMPLE_NOT_FOUND, -2 =
# NIDHI_ERR_INVALID_ZONE, -3 = NIDHI_ERR_INVALID_PARAMETER -- so handing a WAV to the SF2
# importer reported "invalid parameter" and a truncated file reported "sample not found".
# -6 meanwhile covered three unrelated conditions. rust-old returns NidhiError::ImportError
# for all 19 corresponding sites: ONE variant, so one code. NIDHI_ERR_IMPORT (-5) is
# precisely the value this parser never used.
#must_use
fn sf2_parse(data, len) {
    if (len < 12) { return NIDHI_ERR_IMPORT; }
    if (sf2_fourcc(data, len, 0) != N_CC_RIFF) { return NIDHI_ERR_IMPORT; }
    if (sf2_fourcc(data, len, 8) != N_CC_SFBK) { return NIDHI_ERR_IMPORT; }

    var smpl_ptr = 0;
    var smpl_len = 0;
    var smpl_found = 0;
    var pdta_ptr = 0;
    var pdta_len = 0;
    var pdta_found = 0;

    # top-level chunk scan over data[12..]
    var off = 12;
    while (off + 8 <= len) {
        var cid = sf2_fourcc(data, len, off);
        var csize = sf2_u32(data, len, off + 4);
        var cdata_start = off + 8;
        var cdata_end = cdata_start + csize;
        if (cdata_end > len) { return NIDHI_ERR_IMPORT; }
        if (cid == N_CC_LIST) {
            if (csize >= 4) {
                var list_type = sf2_fourcc(data, len, cdata_start);
                if (list_type == N_CC_SDTA) {
                    var soff = cdata_start + 4;
                    var subscan = 1;
                    while (subscan == 1) {
                        if (soff + 8 > cdata_end) {
                            subscan = 0;
                        } else {
                            var sid = sf2_fourcc(data, len, soff);
                            var ssize = sf2_u32(data, len, soff + 4);
                            var sdstart = soff + 8;
                            var sdend = sdstart + ssize;
                            if (sdend > cdata_end) {
                                return NIDHI_ERR_IMPORT;
                            } else {
                                if (sid == N_CC_SMPL) {
                                    smpl_ptr = data + sdstart;
                                    smpl_len = ssize;
                                    smpl_found = 1;
                                }
                                soff = sdend + (ssize & 1);
                            }
                        }
                    }
                }
                if (list_type == N_CC_PDTA) {
                    pdta_ptr = data + cdata_start + 4;
                    pdta_len = csize - 4;
                    pdta_found = 1;
                }
            }
        }
        off = cdata_end + (csize & 1);
    }

    if (smpl_found == 0) { return NIDHI_ERR_IMPORT; }
    if (pdta_found == 0) { return NIDHI_ERR_IMPORT; }

    # pdta sub-chunk scan
    var phdr_ptr = 0; var phdr_len = 0; var phdr_found = 0;
    var pbag_ptr = 0; var pbag_len = 0; var pbag_found = 0;
    var pgen_ptr = 0; var pgen_len = 0; var pgen_found = 0;
    var inst_ptr = 0; var inst_len = 0; var inst_found = 0;
    var ibag_ptr = 0; var ibag_len = 0; var ibag_found = 0;
    var igen_ptr = 0; var igen_len = 0; var igen_found = 0;
    var shdr_ptr = 0; var shdr_len = 0; var shdr_found = 0;

    var poff = 0;
    while (poff + 8 <= pdta_len) {
        var pid = sf2_fourcc(pdta_ptr, pdta_len, poff);
        var psize = sf2_u32(pdta_ptr, pdta_len, poff + 4);
        var pdstart = poff + 8;
        var pdend = pdstart + psize;
        if (pdend > pdta_len) {
            return NIDHI_ERR_IMPORT;
        } else {
            if (pid == N_CC_PHDR) { phdr_ptr = pdta_ptr + pdstart; phdr_len = psize; phdr_found = 1; }
            if (pid == N_CC_PBAG) { pbag_ptr = pdta_ptr + pdstart; pbag_len = psize; pbag_found = 1; }
            if (pid == N_CC_PGEN) { pgen_ptr = pdta_ptr + pdstart; pgen_len = psize; pgen_found = 1; }
            if (pid == N_CC_INST) { inst_ptr = pdta_ptr + pdstart; inst_len = psize; inst_found = 1; }
            if (pid == N_CC_IBAG) { ibag_ptr = pdta_ptr + pdstart; ibag_len = psize; ibag_found = 1; }
            if (pid == N_CC_IGEN) { igen_ptr = pdta_ptr + pdstart; igen_len = psize; igen_found = 1; }
            if (pid == N_CC_SHDR) { shdr_ptr = pdta_ptr + pdstart; shdr_len = psize; shdr_found = 1; }
            poff = pdend + (psize & 1);
        }
    }

    if (phdr_found == 0) { return NIDHI_ERR_IMPORT; }
    if (pbag_found == 0) { return NIDHI_ERR_IMPORT; }
    if (pgen_found == 0) { return NIDHI_ERR_IMPORT; }
    if (inst_found == 0) { return NIDHI_ERR_IMPORT; }
    if (ibag_found == 0) { return NIDHI_ERR_IMPORT; }
    if (igen_found == 0) { return NIDHI_ERR_IMPORT; }
    if (shdr_found == 0) { return NIDHI_ERR_IMPORT; }

    var presets = vec_new();
    if (presets == 0) { return NIDHI_ERR_IMPORT; }
    var instruments = vec_new();
    if (instruments == 0) { return NIDHI_ERR_IMPORT; }
    # n_sample_bank_new answers 0 on a refused allocation; a 0 bank reached the caller as the
    # result's bank when no zone was built, and n_sample_bank_add(0, ..) otherwise.
    var bank = n_sample_bank_new();
    if (bank <= 0) { return NIDHI_ERR_IMPORT; }

    var ctx = alloc(sizeof(Sf2Ctx));
    if (ctx == 0) { return NIDHI_ERR_IMPORT; }
    var prange = alloc(sizeof(Sf2PRange));
    if (prange == 0) { return NIDHI_ERR_IMPORT; }
    Sf2Ctx_set_zones_left(ctx, N_SF2_MAX_ZONES);
    Sf2Ctx_set_work_left(ctx, N_SF2_MAX_WORK);
    Sf2Ctx_set_prange(ctx, prange);
    Sf2Ctx_set_smpl_ptr(ctx, smpl_ptr);
    Sf2Ctx_set_smpl_len(ctx, smpl_len);
    Sf2Ctx_set_bank(ctx, bank);
    Sf2Ctx_set_phdr_ptr(ctx, phdr_ptr);
    Sf2Ctx_set_phdr_len(ctx, phdr_len);
    Sf2Ctx_set_phdr_n(ctx, phdr_len / N_SF2_PHDR_SIZE);
    Sf2Ctx_set_pbag_ptr(ctx, pbag_ptr);
    Sf2Ctx_set_pbag_len(ctx, pbag_len);
    Sf2Ctx_set_pbag_n(ctx, pbag_len / N_SF2_BAG_SIZE);
    Sf2Ctx_set_pgen_ptr(ctx, pgen_ptr);
    Sf2Ctx_set_pgen_len(ctx, pgen_len);
    Sf2Ctx_set_pgen_n(ctx, pgen_len / N_SF2_GEN_SIZE);
    Sf2Ctx_set_inst_ptr(ctx, inst_ptr);
    Sf2Ctx_set_inst_len(ctx, inst_len);
    Sf2Ctx_set_inst_n(ctx, inst_len / N_SF2_INST_SIZE);
    Sf2Ctx_set_ibag_ptr(ctx, ibag_ptr);
    Sf2Ctx_set_ibag_len(ctx, ibag_len);
    Sf2Ctx_set_ibag_n(ctx, ibag_len / N_SF2_BAG_SIZE);
    Sf2Ctx_set_igen_ptr(ctx, igen_ptr);
    Sf2Ctx_set_igen_len(ctx, igen_len);
    Sf2Ctx_set_igen_n(ctx, igen_len / N_SF2_GEN_SIZE);
    Sf2Ctx_set_shdr_ptr(ctx, shdr_ptr);
    Sf2Ctx_set_shdr_len(ctx, shdr_len);
    Sf2Ctx_set_shdr_n(ctx, shdr_len / N_SF2_SHDR_SIZE);
    Sf2Ctx_set_spare_inst(ctx, 0);

    # memo[shdr_index] = SampleId, -1 = not converted yet. A count past VEC_CAP_MAX is refused
    # by n_vec_with_cap (an error return), not by vec_push's capacity abort.
    var shdr_n = Sf2Ctx_shdr_n(ctx);
    var memo = n_vec_with_cap(shdr_n);
    if (memo == 0) { return NIDHI_ERR_IMPORT; }
    var mi = 0;
    while (mi < shdr_n) { vec_push(memo, 0 - 1); mi = mi + 1; }
    Sf2Ctx_set_memo(ctx, memo);

    var rr = sf2_resolve(ctx, presets, instruments);
    if (rr < 0) { return rr; }

    var result = alloc(sizeof(Sf2Result));
    if (result == 0) { return NIDHI_ERR_IMPORT; }
    Sf2Result_set_presets(result, presets);
    Sf2Result_set_instruments(result, instruments);
    Sf2Result_set_bank(result, bank);
    return result;
}
